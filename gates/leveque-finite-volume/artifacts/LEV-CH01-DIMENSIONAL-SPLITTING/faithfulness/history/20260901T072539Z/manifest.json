  "semantic_checks": [
    {
      "id": "C01",
      "name": "source-selection",
      "requirement": "The exact source version, passage, enclosing result, and inherited context are correctly selected."
    },
    {
      "id": "C02",
      "name": "binders-and-types",
      "requirement": "Every binder, mathematical type, structure, dimension, and index domain has the intended meaning."
    },
    {
      "id": "C03",
      "name": "quantifier-scope",
      "requirement": "Quantifier order, scope, witness dependence, and any Skolemization are preserved."
    },
    {
      "id": "C04",
      "name": "hypotheses-and-side-conditions",
      "requirement": "Explicit, inherited, and implicit hypotheses match, including positivity, nonzero, regularity, and membership conditions."
    },
    {
      "id": "C05",
      "name": "conclusion-completeness",
      "requirement": "Every conclusion, conjunct, case, witness, and stated dependency is represented."
    },
    {
      "id": "C06",
      "name": "operators-and-definitions",
      "requirement": "Every nontrivial operator, notation, coercion, and imported local definition has been interpreted from its declaration rather than its name."
    },
    {
      "id": "C07",
      "name": "relation-strength",
      "requirement": "Equality, inequality direction, strictness, logical connective, and conclusion strength match."
    },
    {
      "id": "C08",
      "name": "object-identity-and-roles",
      "requirement": "Distinct source objects, sequences, functions, witnesses, exact values, constructed values, and transformed values are not conflated."
    },
    {
      "id": "C09",
      "name": "constants-and-indexing",
      "requirement": "Constants, coefficients, exponents, index offsets, ranges, and parameter dependence match."
    },
    {
      "id": "C10",
      "name": "specialization-and-generalization",
      "requirement": "Any change of scalar field, finiteness, dimension, domain, or other specialization/generalization is identified and classified correctly."
    },
    {
      "id": "C11",
      "name": "exceptional-and-boundary-cases",
      "requirement": "Undefined operations, boundary values, degenerate cases, and source exclusions are handled consistently."
    },
    {
      "id": "C12",
      "name": "nonvacuity",
      "requirement": "The Lean hypotheses are satisfiable in the intended setting and the conclusion is not true only for an unintended trivial reason."
    },
    {
      "id": "N01",
      "name": "algorithm-or-process-linkage",
      "requirement": "When the source result concerns an algorithm, recurrence, discretization, or process, the formal statement remains linked to that same construction and execution semantics."
    },
    {
      "id": "N02",
      "name": "norm-metric-and-component-semantics",
      "requirement": "Norm, seminorm, metric, squared form, componentwise interpretation, and induced/operator conventions match."
    },
    {
      "id": "N03",
      "name": "error-and-stability-notion",
      "requirement": "Forward, backward, mixed, residual, truncation, discretization, conditioning, and stability notions are not substituted for one another."
    },
    {
      "id": "N04",
      "name": "exact-versus-computed-quantities",
      "requirement": "Exact, approximate, rounded, perturbed, iterated, and computed quantities retain their source roles."
    },
    {
      "id": "N05",
      "name": "asymptotic-and-higher-order-terms",
      "requirement": "Big-O terms, first-order simplifications, exact remainders, limits, and asymptotic regimes are represented with the same logical status."
    },
    {
      "id": "N06",
      "name": "existence-uniqueness-and-well-posedness",
      "requirement": "Existence, uniqueness, rank, invertibility, regularity, and well-posedness requirements used by the numerical claim are preserved."
    }
  ],
