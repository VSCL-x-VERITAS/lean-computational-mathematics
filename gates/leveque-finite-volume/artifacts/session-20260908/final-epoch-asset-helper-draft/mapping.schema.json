{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit input to the candidate asset preparation helper",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_sha256", "review_evidence", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview", "topology", "request", "status", "epoch_schema"],
      "properties": {
        "preview": {"$ref": "#/$defs/hash"},
        "topology": {"$ref": "#/$defs/hash"},
        "request": {"$ref": "#/$defs/hash"},
        "status": {"$ref": "#/$defs/hash"},
        "epoch_schema": {"$ref": "#/$defs/hash"}
      }
    },
    "review_evidence": {"$ref": "#/$defs/evidence"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preview_asset_id", "concept_id"],
        "properties": {
          "preview_asset_id": {"$ref": "#/$defs/id"},
          "concept_id": {"$ref": "#/$defs/id"},
          "declaration_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "declaration", "producer_payload", "policy_payload"],
            "properties": {
              "module": {"type": "string", "minLength": 1},
              "declaration": {"type": "string", "minLength": 1},
              "producer_payload": {"$ref": "#/$defs/evidence"},
              "policy_payload": {"$ref": "#/$defs/evidence"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
