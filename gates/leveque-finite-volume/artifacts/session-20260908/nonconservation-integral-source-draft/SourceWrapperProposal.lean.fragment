/- Scratch wrapper proposal, compiled after RectangleBalance.lean by the checker.
The rectangle convention is explicit; source-faithfulness is not claimed. -/
namespace NumStability.IntegralSourceDraft.SourceProposal

theorem nonconservation_requires_integrated_source
    (q production : ℝ → ℝ → ℝ) (speed : ℝ)
    (hbalance : IsRectangleBalanceLawSolution q (fun state => speed * state) production) :
    (IsRectangleConservationLawSolution q (fun state => speed * state) ↔
      ∀ a b s t, (∫ τ in s..t, ∫ x in a..b, production x τ) = 0) ∧
    (¬ IsRectangleConservationLawSolution q (fun state => speed * state) ↔
      ∃ a b s t, (∫ τ in s..t, ∫ x in a..b, production x τ) ≠ 0) ∧
    (∀ a b s t, (∫ τ in s..t, ∫ x in a..b, production x τ) =
      ((∫ x in a..b, q x t) - (∫ x in a..b, q x s)) -
        ∫ τ in s..t, speed * q a τ - speed * q b τ) :=
  ⟨hbalance.conservation_iff_source_integrals_zero,
    hbalance.not_conservation_iff_exists_nonzero_source_integral,
    hbalance.integrated_source_eq_mass_defect⟩

end NumStability.IntegralSourceDraft.SourceProposal
