{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leveque:blocked-gate-binding-preparation:inputs:1",
  "title": "Proposed blocked binder input transport schema; no terminal assertion",
  "$comment": "The helper enforces duplicate-key rejection, byte hashes, exact row identities/status counts, file safety, current context, released meaningful strings and cross-document semantics directly. References are Lean-repository-relative POSIX paths. No network schema loading is needed. This file documents inputs, not an operational gate change. The referenced base/check-input/native receipts retain their original released schemas.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/sourceManifest"
    },
    {
      "$ref": "#/$defs/questionProjection"
    },
    {
      "$ref": "#/$defs/routeManifest"
    },
    {
      "$ref": "#/$defs/proposedRows"
    }
  ],
  "$defs": {
    "fileReference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "contextBindings": {
      "type": "object",
      "properties": {
        "module_profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unit_index_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unit_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unit_audit_epoch": {
          "type": "string",
          "minLength": 1
        },
        "gate_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lean_git_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "lean_worktree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "module_profile_sha256",
        "unit_index_sha256",
        "unit_record_sha256",
        "unit_audit_epoch",
        "gate_policy_sha256",
        "lean_git_head",
        "lean_worktree_sha256"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "blocked-gate-binding-request"
        },
        "base_gate": {
          "$ref": "#/$defs/fileReference"
        },
        "proposed_rows": {
          "$ref": "#/$defs/fileReference"
        },
        "check_inputs": {
          "$ref": "#/$defs/fileReference"
        },
        "source_manifest": {
          "$ref": "#/$defs/fileReference"
        },
        "question_projection": {
          "$ref": "#/$defs/fileReference"
        },
        "route_manifest": {
          "$ref": "#/$defs/fileReference"
        },
        "receipts": {
          "type": "object",
          "properties": {
            "source-inventory": {
              "type": "object",
              "properties": {
                "exit": {
                  "$ref": "#/$defs/fileReference"
                },
                "output": {
                  "$ref": "#/$defs/fileReference"
                }
              },
              "required": [
                "exit",
                "output"
              ],
              "additionalProperties": false
            },
            "layout": {
              "type": "object",
              "properties": {
                "exit": {
                  "$ref": "#/$defs/fileReference"
                },
                "output": {
                  "$ref": "#/$defs/fileReference"
                }
              },
              "required": [
                "exit",
                "output"
              ],
              "additionalProperties": false
            },
            "tiers": {
              "type": "object",
              "properties": {
                "exit": {
                  "$ref": "#/$defs/fileReference"
                },
                "output": {
                  "$ref": "#/$defs/fileReference"
                }
              },
              "required": [
                "exit",
                "output"
              ],
              "additionalProperties": false
            },
            "compatibility": {
              "type": "object",
              "properties": {
                "exit": {
                  "$ref": "#/$defs/fileReference"
                },
                "output": {
                  "$ref": "#/$defs/fileReference"
                }
              },
              "required": [
                "exit",
                "output"
              ],
              "additionalProperties": false
            },
            "hygiene": {
              "type": "object",
              "properties": {
                "exit": {
                  "$ref": "#/$defs/fileReference"
                },
                "output": {
                  "$ref": "#/$defs/fileReference"
                }
              },
              "required": [
                "exit",
                "output"
              ],
              "additionalProperties": false
            },
            "audits": {
              "type": "object",
              "properties": {
                "exit": {
                  "$ref": "#/$defs/fileReference"
                },
                "output": {
                  "$ref": "#/$defs/fileReference"
                }
              },
              "required": [
                "exit",
                "output"
              ],
              "additionalProperties": false
            },
            "declarations": {
              "type": "object",
              "properties": {
                "exit": {
                  "$ref": "#/$defs/fileReference"
                },
                "output": {
                  "$ref": "#/$defs/fileReference"
                }
              },
              "required": [
                "exit",
                "output"
              ],
              "additionalProperties": false
            },
            "focused-build": {
              "type": "object",
              "properties": {
                "exit": {
                  "$ref": "#/$defs/fileReference"
                },
                "output": {
                  "$ref": "#/$defs/fileReference"
                }
              },
              "required": [
                "exit",
                "output"
              ],
              "additionalProperties": false
            },
            "full-build": {
              "type": "object",
              "properties": {
                "exit": {
                  "$ref": "#/$defs/fileReference"
                },
                "output": {
                  "$ref": "#/$defs/fileReference"
                }
              },
              "required": [
                "exit",
                "output"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "source-inventory",
            "layout",
            "tiers",
            "compatibility",
            "hygiene",
            "audits",
            "declarations",
            "focused-build",
            "full-build"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "kind",
        "base_gate",
        "proposed_rows",
        "check_inputs",
        "source_manifest",
        "question_projection",
        "route_manifest",
        "receipts"
      ],
      "additionalProperties": false
    },
    "sourceManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "material-choice-source-boundaries"
        },
        "source": {
          "$ref": "#/$defs/fileReference"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "row_id": {
                "enum": [
                  "LEV-CH01-ACOUSTICS-LEFT-MODE",
                  "LEV-CH01-DIMENSIONAL-SPLITTING",
                  "LEV-CH01-EIGENVALUES-WAVE-SPEEDS",
                  "LEV-CH01-FINITE-VOLUME-FLUX-UPDATE",
                  "LEV-CH01-HETEROGENEOUS-CELL-AVERAGING",
                  "LEV-CH01-MATERIAL-INTERFACE-RIEMANN-DATA",
                  "LEV-CH01-NONCONSERVATION-SOURCE-TERMS",
                  "LEV-CH01-RIEMANN-INITIAL-VALUE-DEFINITION",
                  "LEV-CH01-RIEMANN-INTERFACE-FLUX"
                ]
              },
              "source_locator": {
                "$ref": "#/$defs/fileReference"
              },
              "frozen_audits": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/fileReference"
                },
                "minItems": 1
              },
              "boundary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "row_id",
              "source_locator",
              "frozen_audits",
              "boundary"
            ],
            "additionalProperties": false
          },
          "minItems": 9,
          "maxItems": 9
        }
      },
      "required": [
        "schema_version",
        "kind",
        "source",
        "rows"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "row_ids": {
          "type": "array",
          "items": {
            "enum": [
              "LEV-CH01-ACOUSTICS-LEFT-MODE",
              "LEV-CH01-DIMENSIONAL-SPLITTING",
              "LEV-CH01-EIGENVALUES-WAVE-SPEEDS",
              "LEV-CH01-FINITE-VOLUME-FLUX-UPDATE",
              "LEV-CH01-HETEROGENEOUS-CELL-AVERAGING",
              "LEV-CH01-MATERIAL-INTERFACE-RIEMANN-DATA",
              "LEV-CH01-NONCONSERVATION-SOURCE-TERMS",
              "LEV-CH01-RIEMANN-INITIAL-VALUE-DEFINITION",
              "LEV-CH01-RIEMANN-INTERFACE-FLUX"
            ]
          },
          "uniqueItems": true
        },
        "exact_text": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "$ref": "#/$defs/fileReference"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "status": {
          "enum": [
            "pending",
            "answered"
          ]
        },
        "mapping_review": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question_id",
        "row_ids",
        "exact_text",
        "record",
        "record_sha256",
        "timestamp",
        "status",
        "mapping_review"
      ],
      "additionalProperties": false
    },
    "reply": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "exact_text": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "$ref": "#/$defs/fileReference"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "question_id",
        "exact_text",
        "record",
        "record_sha256",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "questionProjection": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "current-material-choice-projection"
        },
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "projection_review": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/fileReference"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          },
          "minItems": 1
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reply"
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "thread_id",
        "as_of_utc",
        "projection_review",
        "provenance",
        "questions",
        "replies"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "source-review",
            "canonical-reuse",
            "mathematical-alternatives",
            "native-checks",
            "organization",
            "consumer-checks",
            "review"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "const": "completed"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileReference"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "description",
        "outcome",
        "evidence"
      ],
      "additionalProperties": false
    },
    "routeRow": {
      "type": "object",
      "properties": {
        "row_id": {
          "enum": [
            "LEV-CH01-ACOUSTICS-LEFT-MODE",
            "LEV-CH01-DIMENSIONAL-SPLITTING",
            "LEV-CH01-EIGENVALUES-WAVE-SPEEDS",
            "LEV-CH01-FINITE-VOLUME-FLUX-UPDATE",
            "LEV-CH01-HETEROGENEOUS-CELL-AVERAGING",
            "LEV-CH01-MATERIAL-INTERFACE-RIEMANN-DATA",
            "LEV-CH01-NONCONSERVATION-SOURCE-TERMS",
            "LEV-CH01-RIEMANN-INITIAL-VALUE-DEFINITION",
            "LEV-CH01-RIEMANN-INTERFACE-FLUX"
          ]
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "all_local_work_complete": {
          "const": true
        },
        "remaining_local_actions": {
          "type": "array",
          "maxItems": 0
        },
        "obstruction": {
          "type": "string",
          "minLength": 1
        },
        "attempted_routes": {
          "type": "string",
          "minLength": 1
        },
        "resume_condition": {
          "type": "string",
          "minLength": 1
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          },
          "minItems": 7
        }
      },
      "required": [
        "row_id",
        "question_id",
        "all_local_work_complete",
        "remaining_local_actions",
        "obstruction",
        "attempted_routes",
        "resume_condition",
        "routes"
      ],
      "additionalProperties": false
    },
    "routeManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "reviewed-local-work-exhaustion"
        },
        "input_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "bindings": {
          "$ref": "#/$defs/contextBindings"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "question_projection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/routeRow"
          },
          "minItems": 9,
          "maxItems": 9
        }
      },
      "required": [
        "schema_version",
        "kind",
        "input_commit",
        "bindings",
        "source_manifest_sha256",
        "question_projection_sha256",
        "reviewer",
        "reviewed_at_utc",
        "rows"
      ],
      "additionalProperties": false
    },
    "proposedRow": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "LEV-CH01-EQ-1.1-CONSTANT-LINEAR-SYSTEM",
            "LEV-CH01-SCALAR-HYPERBOLICITY",
            "LEV-CH01-EQ-1.2-ADVECTION",
            "LEV-CH01-EQ-1.3-ADVECTED-PROFILE",
            "LEV-CH01-EQ-1.4-ONE-WAY-WAVE",
            "LEV-CH01-ADVECTION-WAVE-IDENTITY",
            "LEV-CH01-EQ-1.5-LINEAR-ACOUSTICS",
            "LEV-CH01-EQ-1.6-ACOUSTICS-MATRIX",
            "LEV-CH01-ACOUSTICS-RIGHT-MODE",
            "LEV-CH01-ACOUSTICS-TWO-WAVE-DECOMPOSITION",
            "LEV-CH01-HYPERBOLIC-MATRIX-DEFINITION",
            "LEV-CH01-EIGENBASIS-UNIQUE-DECOMPOSITION",
            "LEV-CH01-ACOUSTICS-EIGENVALUES",
            "LEV-CH01-EQ-1.7-WAVE-EQUATION",
            "LEV-CH01-EQ-1.8-CONSERVATION-LAW",
            "LEV-CH01-EQ-1.9-QUASILINEAR-FORM",
            "LEV-CH01-FLUX-JACOBIAN-HYPERBOLICITY",
            "LEV-CH01-LINEAR-FLUX-SPECIALIZATION",
            "LEV-CH01-EQ-1.10-INTEGRAL-CONSERVATION",
            "LEV-CH01-ADVECTION-LINEAR-FLUX",
            "LEV-CH01-INTEGRAL-TO-DIFFERENTIAL-SMOOTH",
            "LEV-CH01-NONLINEAR-SHOCK-FORMATION",
            "LEV-CH01-DISCONTINUITY-INTEGRAL-LAW",
            "LEV-CH01-FINITE-VOLUME-CELL-AVERAGE",
            "LEV-CH01-EQ-1.11-RIEMANN-DATA",
            "LEV-CH01-LINEAR-RIEMANN-EIGENSOLUTION",
            "LEV-CH01-RIEMANN-RAY-ZERO-VALUE",
            "LEV-CH01-ACOUSTICS-CONSERVATION-FORM",
            "LEV-CH01-SECOND-ORDER-WAVE-HYPERBOLICITY",
            "LEV-CH01-ONE-STEP-METHOD-DEFINITION",
            "LEV-CH01-VARIABLE-COEFFICIENT-NONCONSERVATION",
            "LEV-CH01-HYPERBOLIC-SYSTEM-SCALAR-DECOUPLING",
            "LEV-CH01-ACOUSTICS-CONSERVATION-CAVEAT",
            "LEV-CH01-MATERIAL-INTERFACE-RIEMANN",
            "LEV-CH01-MULTIDIMENSIONAL-NORMAL-RIEMANN-FLUX",
            "LEV-CH01-NONLINEAR-RIEMANN-CONSTRUCTION",
            "LEV-CH01-NOTATION-EIGENPAIR-INDEX",
            "LEV-CH01-NOTATION-INITIAL-DATA",
            "LEV-CH01-NOTATION-NUMERICAL-APPROXIMATION",
            "LEV-CH01-NOTATION-OVERLOADED-SYMBOLS",
            "LEV-CH01-NOTATION-SOLUTION-VELOCITY",
            "LEV-CH01-NOTATION-VECTOR-COMPONENTS",
            "LEV-CH01-RIEMANN-SIMILARITY-WAVES",
            "LEV-CH01-SHOCK-CAPTURING",
            "LEV-CH01-SHOCK-TRACKING",
            "LEV-CH01-SHOCKS-AND-NONLINEARITY",
            "LEV-CH01-TYPICAL-SECOND-ORDER-ACCURACY",
            "LEV-CH01-WAVE-PROPAGATION-FRAMEWORK",
            "LEV-CH01-ACOUSTICS-LEFT-MODE",
            "LEV-CH01-DIMENSIONAL-SPLITTING",
            "LEV-CH01-EIGENVALUES-WAVE-SPEEDS",
            "LEV-CH01-FINITE-VOLUME-FLUX-UPDATE",
            "LEV-CH01-HETEROGENEOUS-CELL-AVERAGING",
            "LEV-CH01-MATERIAL-INTERFACE-RIEMANN-DATA",
            "LEV-CH01-NONCONSERVATION-SOURCE-TERMS",
            "LEV-CH01-RIEMANN-INITIAL-VALUE-DEFINITION",
            "LEV-CH01-RIEMANN-INTERFACE-FLUX"
          ]
        },
        "status": {
          "enum": [
            "PROVED",
            "REUSED",
            "SKIPPED",
            "HARD_BLOCKED"
          ]
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": true,
      "$comment": "These are complete released gate row objects, not patches. The unchanged gate.py row schema, exact transition guard, accepted/skipped object equality, and per-row artifact validation apply in addition to this transport schema."
    },
    "proposedRows": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposedRow"
          },
          "minItems": 57,
          "maxItems": 57
        }
      },
      "required": [
        "rows"
      ],
      "additionalProperties": false
    }
  }
}
