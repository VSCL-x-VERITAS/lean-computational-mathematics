{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actual stronger applicability and native nonvacuity support",
  "type": "object",
  "required": [
    "schema",
    "row",
    "task_id",
    "decision",
    "manifest",
    "applicability_audit",
    "genuine_strengthening",
    "remaining_source_uncertainties",
    "native",
    "formal_nonvacuity_declaration",
    "formal_nonvacuity_scope",
    "witness_review",
    "target_application_review"
  ],
  "properties": {
    "schema": {
      "const": 1,
      "type": "integer"
    },
    "row": {
      "enum": [
        "LEV-CH01-ACOUSTICS-LEFT-MODE",
        "LEV-CH01-DIMENSIONAL-SPLITTING",
        "LEV-CH01-EIGENVALUES-WAVE-SPEEDS",
        "LEV-CH01-FINITE-VOLUME-FLUX-UPDATE",
        "LEV-CH01-HETEROGENEOUS-CELL-AVERAGING",
        "LEV-CH01-MATERIAL-INTERFACE-RIEMANN-DATA",
        "LEV-CH01-NONCONSERVATION-SOURCE-TERMS",
        "LEV-CH01-RIEMANN-INITIAL-VALUE-DEFINITION",
        "LEV-CH01-RIEMANN-INTERFACE-FLUX"
      ]
    },
    "decision": {
      "$ref": "#/$defs/File"
    },
    "manifest": {
      "$ref": "#/$defs/File"
    },
    "witness_review": {
      "$ref": "#/$defs/File"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "applicability_audit": {
      "type": "string",
      "minLength": 1
    },
    "genuine_strengthening": {
      "type": "string",
      "minLength": 1
    },
    "formal_nonvacuity_declaration": {
      "type": "string",
      "minLength": 1
    },
    "formal_nonvacuity_scope": {
      "type": "string",
      "minLength": 1
    },
    "target_application_review": {
      "type": "string",
      "minLength": 1
    },
    "remaining_source_uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "native": {
      "$ref": "#/$defs/Native"
    }
  },
  "$defs": {
    "File": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Native": {
      "type": "object",
      "required": [
        "receipt_kind",
        "check",
        "output",
        "receipt",
        "proof_manifest",
        "declarations"
      ],
      "properties": {
        "receipt_kind": {
          "enum": [
            "snapshots",
            "argv"
          ]
        },
        "check": {
          "$ref": "#/$defs/File"
        },
        "output": {
          "$ref": "#/$defs/File"
        },
        "receipt": {
          "$ref": "#/$defs/File"
        },
        "proof_manifest": {
          "$ref": "#/$defs/File"
        },
        "declarations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
