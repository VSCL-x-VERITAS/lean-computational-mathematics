{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nine-row qualified binding request (not an audit decision)",
  "type": "object",
  "required": [
    "schema",
    "row",
    "status",
    "task",
    "manifest",
    "decision",
    "interpretation_packet",
    "current_bindings",
    "native"
  ],
  "properties": {
    "schema": {
      "const": 1,
      "type": "integer"
    },
    "row": {
      "enum": [
        "LEV-CH01-ACOUSTICS-LEFT-MODE",
        "LEV-CH01-DIMENSIONAL-SPLITTING",
        "LEV-CH01-EIGENVALUES-WAVE-SPEEDS",
        "LEV-CH01-FINITE-VOLUME-FLUX-UPDATE",
        "LEV-CH01-HETEROGENEOUS-CELL-AVERAGING",
        "LEV-CH01-MATERIAL-INTERFACE-RIEMANN-DATA",
        "LEV-CH01-NONCONSERVATION-SOURCE-TERMS",
        "LEV-CH01-RIEMANN-INITIAL-VALUE-DEFINITION",
        "LEV-CH01-RIEMANN-INTERFACE-FLUX"
      ]
    },
    "status": {
      "enum": [
        "PROVED",
        "REUSED"
      ]
    },
    "task": {
      "$ref": "#/$defs/File"
    },
    "manifest": {
      "$ref": "#/$defs/File"
    },
    "decision": {
      "$ref": "#/$defs/File"
    },
    "interpretation_packet": {
      "$ref": "#/$defs/File"
    },
    "strengthening_evidence": {
      "$ref": "#/$defs/File"
    },
    "current_bindings": {
      "type": "object",
      "minProperties": 7
    },
    "native": {
      "$ref": "#/$defs/Native"
    }
  },
  "$defs": {
    "File": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Native": {
      "type": "object",
      "required": [
        "receipt_kind",
        "check",
        "output",
        "receipt",
        "proof_manifest",
        "declarations"
      ],
      "properties": {
        "receipt_kind": {
          "enum": [
            "snapshots",
            "argv"
          ]
        },
        "check": {
          "$ref": "#/$defs/File"
        },
        "output": {
          "$ref": "#/$defs/File"
        },
        "receipt": {
          "$ref": "#/$defs/File"
        },
        "proof_manifest": {
          "$ref": "#/$defs/File"
        },
        "declarations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
