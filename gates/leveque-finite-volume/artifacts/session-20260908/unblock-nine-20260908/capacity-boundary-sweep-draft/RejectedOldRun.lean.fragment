/- Expected native rejection: the original run has a single coordinate parameter,
whereas withGhost carries each stage's supplied ghost function in its type. -/
namespace RejectedOldRun
open MeasureTheory NumStability NumStability.FiniteCoordinate CapacityCoordinate
variable {D Cell Face Point FacePoint Line : Type*}
variable [MeasurableSpace Point] [TopologicalSpace Point] [MeasurableSpace FacePoint] {m : ℕ}
variable {data : PhysicalData D Cell Face Point FacePoint m}
local notation "State" => Fin m → ℝ
example (base : LineCoordinates (m := m) D Cell Face Line)
    (method : ℕ → Method data base) (ghost : ℕ → D → Line → ℤ → State)
    (direction : ℕ → D) (duration : ℕ → ℝ) (initial : Cell → State) : ℕ → Cell → State :=
  CapacityCoordinate.run (fun k => (method k).withGhost (ghost k)) direction duration initial
end RejectedOldRun
