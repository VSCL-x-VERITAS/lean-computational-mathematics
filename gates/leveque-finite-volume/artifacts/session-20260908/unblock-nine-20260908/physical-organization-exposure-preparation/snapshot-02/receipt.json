    "rationales": {
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.CapacityCoordinateMethod": "Supplied time-step-dependent conservative line methods, actual admission and optional same-step stability with explicit boundary inputs.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.CapacityCoordinateSweep": "Generic successive coordinate execution with stage-dependent boundaries, physical mass balance, locality and conditional net-error propagation.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.CoordinateLineVariation": "Once-per-edge coordinate variation and actual missing-neighbor boundary counts, shared by refining physical quality.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.Examples.RefiningCartesianBoundary": "Reusable concrete Cartesian boundary regions and sound finite lookup, preserving actual neighboring cells.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.Examples.RefiningCartesianGeometry": "Reusable concrete growing Cartesian geometry with actual measured volumes, refining metric mesh and fixed target coverage.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.Examples.ZeroFluxCartesianRefinement": "Concrete complete physical quality family with zero physical/numerical flux and a genuine nonconstant stationary smooth reference; a mathematical example independent of the book wrapper.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.FiniteLineCoordinates": "Generic finite coordinate lookup, supplied boundary data and extraction bounds; unchanged existing lookup names move out of the specialized interval-method owner.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.FinitePhysicalFluxError": "General measured-reference weighted net-flux error identity and bound, plus zero physical face-flux mean invariance.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.PhysicalCellMesh": "Finite maximum of actual metric cell diameters, independent of cell measure and capacity.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.PhysicalHighResolutionSweep": "Generic execution and conditional specifications for supplied high-resolution physical coordinate methods with positive admitted substeps; no book-specific contract.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.PhysicalLineCapacity": "Actual measured physical capacities and incidence-linked integrated numerical face fluxes, without a common-area or averaged-hyperbolicity premise.",
      "ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.PhysicalRefinementQuality": "General refining measured-geometry method quality using genuine C-infinity physical references, actual cell/boundary averages, uniform order and oscillation; perturbation stability remains separate."
    },
    "purpose": "Proposal only for root-adopted exact twelve reusable modules; no source-faithfulness or operational acceptance."
