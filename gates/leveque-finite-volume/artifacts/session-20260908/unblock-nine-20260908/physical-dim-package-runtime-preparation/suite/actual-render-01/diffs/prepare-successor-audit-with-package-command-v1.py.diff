+def package_json(raw):
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            package_require(key not in result, 'duplicate compiler-extension JSON key: ' + key)
+            result[key] = value
+        return result
+    return json.loads(raw, object_pairs_hook=unique)
