"""Materialize reviewed payloads or emit a converter input, never a candidate/epoch.

Review content must be supplied externally. All emitted paths are fresh. Mapping
emission requires final origin metadata and an actual supplied CANDIDATE status;
the unchanged two-lane converter remains responsible for actual Git verification.
"""
import argparse
from pathlib import Path
import re
import prepare_mapping_catalogue as p


def semantics(catalogue):
    """Commit-independent review surface avoids a candidate/review hash cycle.

    Exact origin heads/content are separately bound by final inventories and the
    converter. This surface covers semantic identity, every origin occurrence's
    disposition and every declaration's producer/policy selection.
    """
    fields = ['lane_id', 'kind', 'stable_key', 'concept_id', 'proposed_disposition',
              'producer_payload_id', 'policy_payload_id']
    return sorted([{key: a[key] for key in fields if key in a} for a in catalogue['assets']],
                  key=lambda a: (a['lane_id'], a['kind'], a['stable_key']))


def reviewed(root, spec):
    cat = p.read(p.bound(root, spec['catalogue']))
    review = p.read(p.bound(root, spec['review']))
    p.require(cat.get('artifact_kind') == 'origin-mapping-review-catalogue'
              and cat.get('source_acceptance') is False and cat.get('candidate') is None, 'wrong catalogue')
    p.require(review.get('schema') == 1 and review.get('status') == 'reviewed-for-structural-preparation', 'missing explicit structural review')
    p.require(review.get('source_acceptance') is False and isinstance(review.get('review'), str)
              and review['review'].strip(), 'structural review must not claim source acceptance')
    p.require(review.get('mapping_semantics_sha256') == p.sha(p.canonical(semantics(cat))), 'review does not bind exact concept/policy/disposition map')
    p.require(isinstance(review.get('evidence'), list) and review['evidence'], 'missing actual review evidence')
    for ref in review['evidence']:
        p.bound(root, ref)
    payloads = {item['canonical_sha256']: item for item in cat['payloads']}
    p.require(len(payloads) == len(cat['payloads']), 'duplicate payload')
    for digest, item in payloads.items():
        p.require(p.sha(p.canonical(item['content'])) == digest, 'payload content changed')
    return cat, payloads


def materialize(root, spec, output):
    cat, payloads = reviewed(root, spec)
    output.mkdir()
    records = []
    for digest, item in sorted(payloads.items()):
        path = output/(item['kind'] + '-' + digest + '.json')
        p.create(path, item['content'])
        records.append({'canonical_sha256': digest, 'kind': item['kind'], 'file': p.reference(root, path)})
    p.create(output/'payload-files.json', {'schema': 1, 'catalogue': spec['catalogue'], 'review': spec['review'],
                                         'payloads': records, 'source_acceptance': False})
    return {'mode': 'REVIEWED_PAYLOAD_FILES_ONLY', 'payloads': len(records), 'source_acceptance': False}


def mapping(root, spec):
    cat, payloads = reviewed(root, spec)
    p.require(cat['stage'] == 'final-origin-review-draft' and re.fullmatch('[0-9a-f]{40}', cat.get('final_committed_head') or ''),
              'baseline draft cannot become a candidate mapping')
    inputs = {key: p.read(p.bound(root, spec[key])) for key in ('topology', 'request', 'status', 'epoch_schema', 'payload_files')}
    topology, request, status = (inputs[key] for key in ('topology', 'request', 'status'))
    p.require(status.get('current_state') == 'CANDIDATE' and status.get('result_kind') == 'candidate', 'actual candidate status required')
    p.require(request.get('task') == 'prepare' and request.get('remote_write_policy') == 'forbid'
              and request.get('admission_backend') == 'none', 'wrong operation policy')
    p.require(status.get('request_id') == request.get('request_id')
              and status.get('request_sha256') == spec['request']['sha256'], 'status/request mismatch')
    p.require(request.get('topology', {}).get('sha256') == spec['topology']['sha256'], 'request/topology mismatch')
    lanes = {entry['lane_id']: entry for entry in cat['lanes']}
    frozen = {entry['instance_id']: entry for entry in request['inputs']}
    p.require(set(frozen) == set(lanes) and len(frozen) == len(request['inputs']), 'request lane mismatch')
    for lane, item in lanes.items():
        inv = p.read(p.bound(root, item['inventory']))
        p.require(inv['head'] == item['head'] == frozen[lane]['commit']
                  and inv['topology_sha256'] == spec['topology']['sha256'], 'stale final inventory')
        p.require(frozen[lane]['mode'] == ('merge' if lane == cat['merge_lane'] else 'inspect'), 'wrong lane mode')
        if lane == cat['merge_lane']:
            p.require(inv['head'] == cat['final_committed_head'] and inv['require_closed'] is True
                      and inv['open_source_rows'] == [], 'merge is not exact closed final origin')
    refs = {entry['canonical_sha256']: entry['file'] for entry in inputs['payload_files']['payloads']}
    p.require(len(refs) == len(inputs['payload_files']['payloads']), 'duplicate materialized payload identity')
    p.require(set(payloads) <= set(refs), 'required reviewed payloads must exist before candidate construction')
    for digest, item in payloads.items():
        p.require(p.read(p.bound(root, refs[digest])) == item['content'], 'materialized payload changed')
    entries = []
    for asset in cat['assets']:
        entry = {'lane_id': asset['lane_id'], 'preview_asset_id': asset['preview_asset_id'],
                 'concept_id': asset['concept_id'], 'disposition': asset['proposed_disposition']}
        if asset['kind'] == 'declaration':
            entry['declaration_identity'] = {'module': asset['module'], 'declaration': asset['declaration'],
                'producer_payload': refs[asset['producer_payload_id']], 'policy_payload': refs[asset['policy_payload_id']]}
        entries.append(entry)
    return {'schema_version': 2,
            'input_sha256': {**{key: spec[key]['sha256'] for key in ('topology', 'request', 'status', 'epoch_schema')},
                            'previews': {lane: item['inventory']['sha256'] for lane, item in lanes.items()}},
            'review_evidence': spec['review'], 'assets': entries}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=['payloads', 'mapping'])
    parser.add_argument('--root', type=Path, required=True)
    parser.add_argument('--spec', type=Path, required=True)
    parser.add_argument('--spec-sha256', required=True)
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    root = args.root.resolve()
    p.require(args.output.resolve().is_relative_to(root) and not args.output.exists(), 'fresh repository output required')
    p.require(p.sha(args.spec.read_bytes()) == args.spec_sha256, 'spec hash mismatch')
    spec = p.read(args.spec)
    result = materialize(root, spec, args.output) if args.mode == 'payloads' else mapping(root, spec)
    if args.mode == 'mapping':
        p.create(args.output, result)
    print('Prepared ' + args.mode + ' only; no Git/candidate/epoch/source acceptance. Existing converter must validate all final Git bindings.')


if __name__ == '__main__':
    main()
