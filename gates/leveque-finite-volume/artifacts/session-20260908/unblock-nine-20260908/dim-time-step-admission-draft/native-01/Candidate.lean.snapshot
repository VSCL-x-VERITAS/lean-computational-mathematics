import ComputationalMathematics.Analysis.PartialDifferentialEquations.FiniteVolume.Examples.HighResolutionAdvectionLine

/-! Artifact-only inputwise time-step availability. This is not a complete
high-resolution family, a convergence result, or a source interpretation.
The mesh is the actual largest supplied input-cell width. Boundary input
cells have supplied grid geometry; dummy missing-lookup capacities are absent. -/

namespace TimeStepAdmissionDraft
open NumStability NumStability.DirectionalLine Filter
open scoped Topology BigOperators

/-- Admission may depend on both the actual supplied step and the input.
Availability does not assert one common step for all arrays or downward closure. -/
structure Domain (State : Type*) where
  states : Set State
  grid : ℕ → OneDimensionalFiniteVolumeGrid
  inputStart : ℕ → ℤ
  inputCount : ℕ → ℕ
  mesh : ℕ → ℝ
  mesh_pos : ∀ n, 0 < mesh n
  mesh_is_max : ∀ n,
    (∀ j ∈ Finset.Ico (inputStart n) (inputStart n + inputCount n),
      (grid n).cellVolume j ≤ mesh n) ∧
    ∃ j ∈ Finset.Ico (inputStart n) (inputStart n + inputCount n),
      (grid n).cellVolume j = mesh n
  admitted : ℕ → ℝ → (ℤ → State) → Prop
  admitted_local : ∀ n dt values other,
    (∀ j ∈ Finset.Ico (inputStart n) (inputStart n + inputCount n), values j = other j) →
    (admitted n dt values ↔ admitted n dt other)
  available : ∀ n values,
    (∀ j ∈ Finset.Ico (inputStart n) (inputStart n + inputCount n), values j ∈ states) →
    ∃ dt : ℝ, 0 < dt ∧ dt ≤ mesh n ∧ admitted n dt values

def Domain.InputStates {State : Type*} (domain : Domain State) (n : ℕ)
    (values : ℤ → State) : Prop :=
  ∀ j ∈ Finset.Ico (domain.inputStart n) (domain.inputStart n + domain.inputCount n),
    values j ∈ domain.states

/-- A two-state array uses the existing Riemann-data definition, with the
right state at the integer cut. No third state is silently introduced. -/
noncomputable def jump {State : Type*} (left right : State) (cut : ℤ) (j : ℤ) : State :=
  riemannData left right right ((j : ℝ) - (cut : ℝ))

theorem jump_eq {State : Type*} (left right : State) (cut j : ℤ) :
    jump left right cut j = if j < cut then left else right := by
  simp only [jump, riemannData, ite_self]
  congr 1
  exact sub_neg.trans Int.cast_lt

theorem jump_mem {State : Type*} {states : Set State} {left right : State}
    (hl : left ∈ states) (hr : right ∈ states) (cut j : ℤ) :
    jump left right cut j ∈ states := by
  rw [jump_eq]
  split <;> assumption

theorem Domain.jump_input {State : Type*} (domain : Domain State) (n : ℕ)
    {left right : State} (hl : left ∈ domain.states) (hr : right ∈ domain.states) (cut : ℤ) :
    domain.InputStates n (jump left right cut) :=
  fun j _ => jump_mem hl hr cut j

theorem Domain.jump_available {State : Type*} (domain : Domain State) (n : ℕ)
    {left right : State} (hl : left ∈ domain.states) (hr : right ∈ domain.states) (cut : ℤ) :
    ∃ dt : ℝ, 0 < dt ∧ dt ≤ domain.mesh n ∧
      domain.admitted n dt (jump left right cut) :=
  domain.available n _ (domain.jump_input n hl hr cut)

variable {m : ℕ}
local notation "State" => Fin m → ℝ

/-- A separate analysis condition: both arrays are advanced at one and the
same positive dt. Inputwise availability alone cannot supply their common dt. -/
def SameStepStability (domain : Domain State)
    (advance : ℕ → ℝ → (ℤ → State) → ℤ → State)
    (activeStart : ℕ → ℤ) (activeCount : ℕ → ℕ) (L : ℝ) : Prop :=
  0 ≤ L ∧ ∀ n dt, 0 < dt → ∀ values other,
    domain.admitted n dt values → domain.admitted n dt other →
    ∀ E : ℝ, 0 ≤ E →
    (∀ j ∈ Finset.Ico (domain.inputStart n) (domain.inputStart n + domain.inputCount n),
      ‖values j - other j‖ ≤ E) →
    ∀ j ∈ Finset.Ico (activeStart n) (activeStart n + activeCount n),
      ‖advance n dt values j - advance n dt other j‖ ≤ (1 + L * dt) * E

/-- Uniform finite-window oscillation control at every actually admitted
positive dt, with vanishing additive rate. It is separate from stability. -/
def OscillationControl (domain : Domain State)
    (advance : ℕ → ℝ → (ℤ → State) → ℤ → State)
    (activeStart : ℕ → ℤ) (activeCount : ℕ → ℕ) (K : ℝ) (noise : ℕ → ℝ) : Prop :=
  0 ≤ K ∧ (∀ n, 0 ≤ noise n) ∧ Tendsto noise atTop (𝓝 0) ∧
    ∀ n dt, 0 < dt → ∀ values, domain.admitted n dt values →
      windowVariation (activeStart n) (activeCount n - 1) (advance n dt values) ≤
        (1 + K * dt) *
          windowVariation (domain.inputStart n) (domain.inputCount n - 1) values + dt * noise n

theorem jump_available_with_oscillation (domain : Domain State)
    (advance : ℕ → ℝ → (ℤ → State) → ℤ → State)
    (activeStart : ℕ → ℤ) (activeCount : ℕ → ℕ) (K : ℝ) (noise : ℕ → ℝ)
    (control : OscillationControl domain advance activeStart activeCount K noise)
    (n : ℕ) {left right : State} (hl : left ∈ domain.states) (hr : right ∈ domain.states)
    (cut : ℤ) :
    ∃ dt : ℝ, 0 < dt ∧ dt ≤ domain.mesh n ∧ domain.admitted n dt (jump left right cut) ∧
      windowVariation (activeStart n) (activeCount n - 1) (advance n dt (jump left right cut)) ≤
        (1 + K * dt) * windowVariation (domain.inputStart n) (domain.inputCount n - 1)
          (jump left right cut) + dt * noise n := by
  obtain ⟨dt, hdt, hmesh, hadmit⟩ := domain.jump_available n hl hr cut
  exact ⟨dt, hdt, hmesh, hadmit, control.2.2.2 n dt hdt _ hadmit⟩

namespace CFL1
open NumStability.HighResolutionAdvectionLine

/-- A scalar witness using actual canonical widths h n. Admission is exactly
dt=h n; its stronger data-independent availability is not imposed generically. -/
noncomputable def domain : Domain (Fin 1 → ℝ) where
  states := Set.univ
  grid := (family 1).grid
  inputStart := (family 1).inputStart
  inputCount := (family 1).inputCount
  mesh := h
  mesh_pos := h_pos
  mesh_is_max := by
    intro n
    constructor
    · intro j _
      exact (CFLUnitShift.grid_volume (h n) (h_pos n) j).le
    · refine ⟨0, ?_, CFLUnitShift.grid_volume (h n) (h_pos n) 0⟩
      simp only [family, Finset.mem_Ico, Nat.cast_add, Nat.cast_ofNat]
      omega
  admitted := fun n dt _ => dt = h n
  admitted_local := by intros; rfl
  available := by
    intro n values _
    exact ⟨h n, h_pos n, le_rfl, rfl⟩

noncomputable def advance (n : ℕ) (dt : ℝ) (values : ℤ → Fin 1 → ℝ) : ℤ → Fin 1 → ℝ :=
  riemannFiniteVolumeUpdate ((family 1).grid n) dt values (fun j => values (j - 1))

theorem advance_at_h (n : ℕ) (values : ℤ → Fin 1 → ℝ) :
    advance n (h n) values = (family 1).advance n values := rfl

theorem advance_admitted (n : ℕ) (dt : ℝ) (values : ℤ → Fin 1 → ℝ)
    (hadmit : domain.admitted n dt values) (j : ℤ) :
    advance n dt values j = values (j - 1) := by
  change dt = h n at hadmit
  rw [hadmit, advance_at_h, family_advance]

theorem same_step_stability :
    SameStepStability domain advance (family 1).activeStart (family 1).activeCount 0 := by
  refine ⟨le_rfl, ?_⟩
  intro n dt hdt values other hv ho E hE herr j hj
  rw [advance_admitted n dt values hv, advance_admitted n dt other ho]
  simp only [zero_mul, add_zero, one_mul]
  apply herr
  simp only [family, domain, Finset.mem_Ico, Nat.cast_add, Nat.cast_ofNat] at hj ⊢
  omega

/-- Reuse the existing canonical finite-window bound without any analytic
reference or old quality-order clause in the statement. -/
theorem oscillation_control : ∃ K noise,
    OscillationControl domain advance (family 1).activeStart (family 1).activeCount K noise := by
  obtain ⟨K, hK, noise, hnoise, hlimit, bound⟩ := (family_quality 1).oscillation
  refine ⟨K, noise, hK, hnoise, hlimit, ?_⟩
  intro n dt hdt values hadmit
  change dt = h n at hadmit
  subst dt
  exact bound n values True.intro

theorem every_jump_available (n : ℕ) (left right : Fin 1 → ℝ) (cut : ℤ) :
    domain.admitted n (h n) (jump left right cut) ∧ 0 < h n ∧ h n ≤ domain.mesh n :=
  ⟨rfl, h_pos n, le_rfl⟩

theorem jump_moves (n : ℕ) (left right : Fin 1 → ℝ) (cut j : ℤ) :
    advance n (h n) (jump left right cut) j = jump left right (cut + 1) j := by
  rw [advance_admitted n (h n) _ rfl, jump_eq, jump_eq]
  congr 1
  omega

theorem nonconstant_jump (n : ℕ) :
    jump (0 : Fin 1 → ℝ) 1 0 (-1) ≠ jump (0 : Fin 1 → ℝ) 1 0 0 ∧
      advance n (h n) (jump (0 : Fin 1 → ℝ) 1 0) 0 = 0 ∧
      advance n (h n) (jump (0 : Fin 1 → ℝ) 1 0) 1 = 1 := by
  simp only [jump_moves, jump_eq]
  norm_num

end CFL1
end TimeStepAdmissionDraft
