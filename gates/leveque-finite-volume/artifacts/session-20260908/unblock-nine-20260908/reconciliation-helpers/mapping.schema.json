{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit reviewed two-lane candidate asset mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_sha256",
    "review_evidence",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology",
        "request",
        "status",
        "epoch_schema",
        "previews"
      ],
      "properties": {
        "topology": {
          "$ref": "#/$defs/hash"
        },
        "request": {
          "$ref": "#/$defs/hash"
        },
        "status": {
          "$ref": "#/$defs/hash"
        },
        "epoch_schema": {
          "$ref": "#/$defs/hash"
        },
        "previews": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "review_evidence": {
      "$ref": "#/$defs/evidence"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "preview_asset_id",
          "concept_id",
          "lane_id",
          "disposition"
        ],
        "properties": {
          "preview_asset_id": {
            "$ref": "#/$defs/id"
          },
          "concept_id": {
            "$ref": "#/$defs/id"
          },
          "declaration_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "declaration",
              "producer_payload",
              "policy_payload"
            ],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "declaration": {
                "type": "string",
                "minLength": 1
              },
              "producer_payload": {
                "$ref": "#/$defs/evidence"
              },
              "policy_payload": {
                "$ref": "#/$defs/evidence"
              }
            }
          },
          "lane_id": {
            "$ref": "#/$defs/id"
          },
          "disposition": {
            "enum": [
              "selected",
              "retained-unresolved"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
