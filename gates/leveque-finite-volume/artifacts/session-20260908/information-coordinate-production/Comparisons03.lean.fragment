namespace NumStability.InformationCoordinatePlacementChecks

open NumStability

universe u v w

theorem core_FaceAdmitted : @NumStability.InformationCoordinateSweepDraft.FaceAdmitted = @NumStability.RiemannInformationCoordinate.FaceAdmitted := rfl

theorem core_StageAdmitted : @NumStability.InformationCoordinateSweepDraft.StageAdmitted = @NumStability.RiemannInformationCoordinate.StageAdmitted := rfl

theorem core_selectedFaceFlux : @NumStability.InformationCoordinateSweepDraft.selectedFaceFlux = @NumStability.RiemannInformationCoordinate.selectedFaceFlux := rfl

theorem core_guardedRule : @NumStability.InformationCoordinateSweepDraft.guardedRule = @NumStability.RiemannInformationCoordinate.guardedRule := rfl

theorem core_normalFaceFlux_of_admitted : @NumStability.InformationCoordinateSweepDraft.normalFaceFlux_of_admitted = @NumStability.RiemannInformationCoordinate.normalFaceFlux_of_admitted := rfl

theorem core_admitted_face_observation : @NumStability.InformationCoordinateSweepDraft.admitted_face_observation = @NumStability.RiemannInformationCoordinate.admitted_face_observation := rfl

theorem core_normalFaceFlux_fallback_independent : @NumStability.InformationCoordinateSweepDraft.normalFaceFlux_fallback_independent = @NumStability.RiemannInformationCoordinate.normalFaceFlux_fallback_independent := rfl

theorem core_advance_fallback_independent : @NumStability.InformationCoordinateSweepDraft.advance_fallback_independent = @NumStability.RiemannInformationCoordinate.advance_fallback_independent := rfl

theorem core_admitted_cell_mass_balance : @NumStability.InformationCoordinateSweepDraft.admitted_cell_mass_balance = @NumStability.RiemannInformationCoordinate.admitted_cell_mass_balance := rfl

theorem core_admitted_finite_line_mass_balance : @NumStability.InformationCoordinateSweepDraft.admitted_finite_line_mass_balance = @NumStability.RiemannInformationCoordinate.admitted_finite_line_mass_balance := rfl

theorem core_SweepAdmitted : @NumStability.InformationCoordinateSweepDraft.SweepAdmitted = @NumStability.RiemannInformationCoordinate.SweepAdmitted := by
  funext D inst m laws Result Information methods volume area fallback stages state
  induction stages generalizing state with
  | nil => rfl
  | cons step stages ih =>
    rcases step with ⟨d, dt⟩
    simpa only [NumStability.InformationCoordinateSweepDraft.SweepAdmitted, NumStability.RiemannInformationCoordinate.SweepAdmitted] using
      congrArg (fun p : Prop => NumStability.RiemannInformationCoordinate.StageAdmitted methods d dt state ∧ p) (ih _)

theorem proof_transport {p q : Prop} (h : p = q) (hp : p) (hq : q) : HEq hp hq := by
  cases h
  rfl

theorem core_sweepAdmitted_fallback_independent : HEq (@NumStability.InformationCoordinateSweepDraft.sweepAdmitted_fallback_independent.{u, v, w}) (@NumStability.RiemannInformationCoordinate.sweepAdmitted_fallback_independent.{u, v, w}) := by
  apply proof_transport
  rw [core_SweepAdmitted] <;> rfl

theorem core_sweep_fallback_independent : HEq (@NumStability.InformationCoordinateSweepDraft.sweep_fallback_independent.{u, v, w}) (@NumStability.RiemannInformationCoordinate.sweep_fallback_independent.{u, v, w}) := by
  apply proof_transport
  rw [core_SweepAdmitted] <;> rfl

theorem core_admission_at_prefix : HEq (@NumStability.InformationCoordinateSweepDraft.admission_at_prefix.{u, v, w}) (@NumStability.RiemannInformationCoordinate.admission_at_prefix.{u, v, w}) := by
  apply proof_transport
  rw [core_SweepAdmitted] <;> rfl

theorem core_executed_face_uses_selected_solve : HEq (@NumStability.InformationCoordinateSweepDraft.executed_face_uses_selected_solve.{u, v, w}) (@NumStability.RiemannInformationCoordinate.executed_face_uses_selected_solve.{u, v, w}) := by
  apply proof_transport
  rw [core_SweepAdmitted] <;> rfl

theorem core_admitted_two_stage_balance : @NumStability.InformationCoordinateSweepDraft.admitted_two_stage_balance = @NumStability.RiemannInformationCoordinate.admitted_two_stage_balance := rfl

theorem geometry_cellBox {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.cellBox grid.axis = NumStability.TensorLinesDraft.TensorGrid.cellBox grid := rfl

theorem geometry_cellVolume {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.cellVolume grid.axis = NumStability.TensorLinesDraft.TensorGrid.cellVolume grid := rfl

theorem geometry_faceArea {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.faceArea grid.axis = NumStability.TensorLinesDraft.TensorGrid.faceArea grid := rfl

theorem geometry_cellVolume_pos {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.cellVolume_pos grid.axis = NumStability.TensorLinesDraft.TensorGrid.cellVolume_pos grid := rfl

theorem geometry_cellVolume_eq_width_mul_area {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.cellVolume_eq_width_mul_area grid.axis = NumStability.TensorLinesDraft.TensorGrid.cellVolume_eq_width_mul_area grid := rfl

theorem geometry_cellBox_volume {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.cellBox_volume grid.axis = NumStability.TensorLinesDraft.TensorGrid.cellBox_volume grid := rfl

theorem geometry_faceArea_update {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.faceArea_update grid.axis = NumStability.CartesianLineCompositionDraft.faceArea_update grid := rfl

theorem geometry_tangentialFaceBox {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.tangentialFaceBox grid.axis = NumStability.CartesianLineCompositionDraft.tangentialFaceBox grid := rfl

theorem geometry_tangentialFaceBox_volume {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.tangentialFaceBox_volume grid.axis = NumStability.CartesianLineCompositionDraft.tangentialFaceBox_volume grid := rfl

theorem geometry_tangentialFaceBox_update {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.tangentialFaceBox_update grid.axis = NumStability.CartesianLineCompositionDraft.tangentialFaceBox_update grid := rfl

theorem geometry_facePoint {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.facePoint grid.axis = NumStability.CartesianLineCompositionDraft.facePoint grid := rfl

theorem geometry_facePoint_normal {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.facePoint_normal grid.axis = NumStability.CartesianLineCompositionDraft.facePoint_normal grid := rfl

theorem geometry_facePoint_transverse {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.facePoint_transverse grid.axis = NumStability.CartesianLineCompositionDraft.facePoint_transverse grid := rfl

theorem geometry_shared_face_position {D : Type*} [Fintype D] [DecidableEq D] (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianGrid.shared_face_position grid.axis = NumStability.CartesianLineCompositionDraft.shared_face_position grid := rfl

theorem consumer_areaWeightedRule {D : Type*} [Fintype D] [DecidableEq D] {m : ℕ} (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianCoordinateUpdate.areaWeightedRule (m := m) grid.axis = NumStability.InformationCoordinateSweepDraft.areaWeightedRule (m := m) grid := rfl

theorem consumer_cartesian_full_line_update {D : Type*} [Fintype D] [DecidableEq D] {m : ℕ} (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianCoordinateUpdate.cartesian_full_line_update (m := m) grid.axis = NumStability.InformationCoordinateSweepDraft.cartesian_full_line_update (m := m) grid := rfl

theorem consumer_line_admission : @NumStability.CartesianCoordinateUpdate.line_admission = @NumStability.InformationCoordinateSweepDraft.line_admission := rfl

theorem consumer_selectedFaceFlux_on_line : @NumStability.CartesianCoordinateUpdate.selectedFaceFlux_on_line = @NumStability.InformationCoordinateSweepDraft.selectedFaceFlux_on_line := rfl

theorem consumer_guardedRule_eq_areaWeightedRule {D : Type*} [Fintype D] [DecidableEq D] {m : ℕ}
    {laws : D → OneDimensionalHyperbolicConservationLaw (Fin m)}
    {Result : (d : D) → HyperbolicRiemannProblem (laws d) → Type*}
    {Information : D → Type*}
    (methods : (d : D) → ℝ → RiemannInformationFluxMethod (laws d) (Result d) (Information d))
    (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianCoordinateUpdate.guardedRule_eq_areaWeightedRule methods grid.axis = NumStability.InformationCoordinateSweepDraft.guardedRule_eq_areaWeightedRule methods grid := rfl

theorem consumer_cartesian_line_update {D : Type*} [Fintype D] [DecidableEq D] {m : ℕ}
    {laws : D → OneDimensionalHyperbolicConservationLaw (Fin m)}
    {Result : (d : D) → HyperbolicRiemannProblem (laws d) → Type*}
    {Information : D → Type*}
    (methods : (d : D) → ℝ → RiemannInformationFluxMethod (laws d) (Result d) (Information d))
    (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianCoordinateUpdate.cartesian_line_update methods grid.axis = NumStability.InformationCoordinateSweepDraft.cartesian_line_update methods grid := rfl

theorem consumer_cartesian_measured_balance {D : Type*} [Fintype D] [DecidableEq D] {m : ℕ}
    {laws : D → OneDimensionalHyperbolicConservationLaw (Fin m)}
    {Result : (d : D) → HyperbolicRiemannProblem (laws d) → Type*}
    {Information : D → Type*}
    (methods : (d : D) → ℝ → RiemannInformationFluxMethod (laws d) (Result d) (Information d))
    (grid : TensorLinesDraft.TensorGrid D) :
    NumStability.CartesianCoordinateUpdate.cartesian_measured_balance methods grid.axis = NumStability.InformationCoordinateSweepDraft.cartesian_measured_balance methods grid := rfl

theorem example_left_rule : @NumStability.LeftStateCoordinateSweep.left_rule = @NumStability.InformationCoordinateSweepDraft.left_rule := rfl

theorem example_left_sweep_admitted : HEq (@NumStability.LeftStateCoordinateSweep.left_sweep_admitted) (@NumStability.InformationCoordinateSweepDraft.left_sweep_admitted) := by
  apply proof_transport
  rw [core_SweepAdmitted] <;> rfl

theorem example_left_unit_update : @NumStability.LeftStateCoordinateSweep.left_unit_update = @NumStability.InformationCoordinateSweepDraft.left_unit_update := rfl

theorem example_left_two_stage_nonvacuity : @NumStability.LeftStateCoordinateSweep.left_two_stage_nonvacuity = @NumStability.InformationCoordinateSweepDraft.left_two_stage_nonvacuity := rfl

end NumStability.InformationCoordinatePlacementChecks

