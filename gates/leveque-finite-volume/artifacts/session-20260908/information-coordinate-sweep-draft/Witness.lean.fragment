namespace NumStability.InformationCoordinateSweepDraft

open TensorLinesDraft

/-- This routine returns only an ordered state pair with its input equalities. -/
noncomputable def leftMethods (_d : Fin 2) (_dt : ℝ) :
    RiemannInformationFluxMethod (StationaryRiemannField.transportLaw (m := 1))
      LeftStateInformationFlux.OrderedResult ((Fin 1 → ℝ) × (Fin 1 → ℝ)) :=
  LeftStateInformationFlux.method StationaryRiemannField.transportLaw

theorem left_rule (area : Fin 2 → Cell (Fin 2) → ℝ)
    (fallback : Fin 2 → Cell (Fin 2) → ℝ → (ℤ → Fin 1 → ℝ) → Fin 1 → ℝ)
    (d : Fin 2) (cell : Cell (Fin 2)) (dt : ℝ) (old : ℤ → Fin 1 → ℝ) :
    guardedRule leftMethods area fallback d cell dt old = area d cell • old (cell d - 1) := by
  simp [guardedRule, leftMethods, LeftStateInformationFlux.method,
    adjacentCellRiemannProblem, StationaryRiemannField.physicalFlux]

theorem left_sweep_admitted (volume : Cell (Fin 2) → ℝ)
    (area : Fin 2 → Cell (Fin 2) → ℝ)
    (fallback : Fin 2 → Cell (Fin 2) → ℝ → (ℤ → Fin 1 → ℝ) → Fin 1 → ℝ)
    (stages : List (Fin 2 × ℝ)) (state : Cell (Fin 2) → Fin 1 → ℝ) :
    SweepAdmitted leftMethods volume area fallback stages state := by
  induction stages generalizing state with
  | nil => trivial
  | cons step stages ih => exact ⟨fun _ => trivial, ih _⟩

/-- A positive unit step is the actual upwind shift for this particular unit-speed law. -/
theorem left_unit_update
    (fallback : Fin 2 → Cell (Fin 2) → ℝ → (ℤ → Fin 1 → ℝ) → Fin 1 → ℝ)
    (d : Fin 2) (state : Cell (Fin 2) → Fin 1 → ℝ) (cell : Cell (Fin 2)) :
    CoordinateLineBalance.advance (fun _ => 1)
      (guardedRule leftMethods (fun _ _ => 1) fallback) d 1 state cell =
        state (Function.update cell d (cell d - 1)) := by
  simp [CoordinateLineBalance.advance, finiteVolumeCellAverageUpdate,
    CoordinateLineBalance.netOutwardFlux, CoordinateLineBalance.normalFaceFlux, left_rule]

/-- Two positive directional steps act on the actual intermediate state and have
distinct outputs. The selected routine returns state pairs, without a field premise. -/
theorem left_two_stage_nonvacuity
    (fallback : Fin 2 → Cell (Fin 2) → ℝ → (ℤ → Fin 1 → ℝ) → Fin 1 → ℝ) :
    SweepAdmitted leftMethods (fun _ => 1) (fun _ _ => 1) fallback [(0, 1), (1, 1)]
      TensorLinesDraft.Witness.stripeState ∧
    CoordinateLineBalance.sweep (fun _ => 1)
      (guardedRule leftMethods (fun _ _ => 1) fallback) [(0, 1), (1, 1)]
      TensorLinesDraft.Witness.stripeState ![0, 1] = 0 ∧
    CoordinateLineBalance.sweep (fun _ => 1)
      (guardedRule leftMethods (fun _ _ => 1) fallback) [(0, 1), (1, 1)]
      TensorLinesDraft.Witness.stripeState ![0, 2] = 1 := by
  refine ⟨left_sweep_admitted _ _ _ _ _, ?_, ?_⟩
  · rw [CoordinateLineBalance.sweep_two, left_unit_update, left_unit_update]
    simp [TensorLinesDraft.Witness.stripeState]
  · rw [CoordinateLineBalance.sweep_two, left_unit_update, left_unit_update]
    simp [TensorLinesDraft.Witness.stripeState]

end NumStability.InformationCoordinateSweepDraft
