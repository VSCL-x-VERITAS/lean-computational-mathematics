audits/**/faithfulness/orchestration/
gates/**/faithfulness/history/
audits/**/faithfulness/history/
*.bin
*.pstats

# Formalization working state. The campaign's gates, issue ledgers and audit
# evidence are local runtime files: the workflow reads and writes them in the
# checkout, and they are never committed to main or to a work lane.
/gates/
/ledgers/
/audits/
/.faithfulness-audit/
/.formalization/
