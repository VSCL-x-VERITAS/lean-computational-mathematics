      kolmogorovDistance
          (Measure.map (X (N + 1)) mu ∗
            Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu)
          (NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ∗
            Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu) +
        kolmogorovDistance
          (Measure.map
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
            mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  let Sprev : Omega → ℝ := ∑ i ∈ Finset.range (N + 1), X i
  have hSprev : AEMeasurable Sprev mu := by
    dsimp only [Sprev]
    fun_prop
  letI : IsProbabilityMeasure (Measure.map Sprev mu) :=
    Measure.isProbabilityMeasure_map hSprev
  letI : IsProbabilityMeasure (Measure.map (X (N + 1)) mu) :=
    Measure.isProbabilityMeasure_map (hX (N + 1))
  have hc : 0 < (Real.sqrt (N + 2 : ℝ))⁻¹ := by positivity
  calc
    kolmogorovDistance
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
            X (N + 1)) mu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      kolmogorovDistance
          (Measure.map
            (fun y : ℝ => (Real.sqrt (N + 2 : ℝ))⁻¹ * y)
            (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu ∗
              Measure.map (X (N + 1)) mu))
          (Measure.map
            (fun y : ℝ => (Real.sqrt (N + 2 : ℝ))⁻¹ * y)
            (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu ∗
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)) +
        kolmogorovDistance
          (Measure.map
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
            mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw :=
      kolmogorovDistance_normalizedCenteredIidSum_succ_le_replacement
        X hX hIndep N
    _ = _ := by
      rw [kolmogorovDistance_map_mul_conv_eq
        (Measure.map Sprev mu) (Measure.map (X (N + 1)) mu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hc]

/-- Adding an independent convolution factor cannot increase interval mass
beyond the concentration function of the right factor. -/
theorem measureReal_Ioc_conv_le_concentrationFunction_right
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {h : ℝ} (hh : 0 ≤ h) (x : ℝ) :
    (mu ∗ nu).real (Ioc x (x + h)) ≤ concentrationFunction nu h := by
  have hUpper := integrable_cdf_translate nu mu (x + h)
  have hLower := integrable_cdf_translate nu mu x
  rw [measureReal_Ioc_eq_cdf_sub (mu ∗ nu) (by linarith)]
  rw [← smoothedCDF_eq_cdf_conv nu mu (x + h),
    ← smoothedCDF_eq_cdf_conv nu mu x]
  unfold smoothedCDF
  rw [← integral_sub hUpper hLower]
  calc
    (∫ y, cdf nu (x + h - y) - cdf nu (x - y) ∂mu) ≤
        ∫ _y, concentrationFunction nu h ∂mu := by
      apply integral_mono (hUpper.sub hLower) (integrable_const _)
      intro y
      calc
        cdf nu (x + h - y) - cdf nu (x - y) =
            nu.real (Ioc (x - y) ((x - y) + h)) := by
          rw [measureReal_Ioc_eq_cdf_sub nu (by linarith)]
          congr 2
          ring
        _ ≤ concentrationFunction nu h :=
          measureReal_Ioc_le_concentrationFunction nu h (x - y)
    _ = concentrationFunction nu h := by simp

/-- Convolution cannot increase the concentration function beyond that of
its right factor. -/
theorem concentrationFunction_conv_le_right
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {h : ℝ} (hh : 0 ≤ h) :
    concentrationFunction (mu ∗ nu) h ≤ concentrationFunction nu h := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  exact measureReal_Ioc_conv_le_concentrationFunction_right mu nu hh x

/-- Convolution cannot increase the concentration function beyond that of
its left factor. -/
theorem concentrationFunction_conv_le_left
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {h : ℝ} (hh : 0 ≤ h) :
    concentrationFunction (mu ∗ nu) h ≤ concentrationFunction mu h := by
  rw [Measure.conv_comm]
  exact concentrationFunction_conv_le_right nu mu hh

/-- Leave-one-out concentration recurrence for normalized independent sums.
The new summand disappears through convolution domination; the interval
length is rescaled to the preceding normalization. -/
theorem concentrationFunction_normalizedCenteredIidSum_succ_le
    {Ω : Type*} [MeasurableSpace Ω]
    {mu : Measure Ω} [IsProbabilityMeasure mu]
    (X : ℕ → Ω → ℝ) (hX : ∀ i, AEMeasurable (X i) mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (N : ℕ) {h : ℝ} (hh : 0 ≤ h) :
    concentrationFunction
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X (N + 1)) mu) h ≤
      concentrationFunction
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N) mu)
        ((Real.sqrt (N + 1 : ℝ))⁻¹ *
          (h * Real.sqrt (N + 2 : ℝ))) := by
  let Sfull : Ω → ℝ := ∑ i ∈ Finset.range (N + 2), X i
  let Sprev : Ω → ℝ := ∑ i ∈ Finset.range (N + 1), X i
  have hSfull : AEMeasurable Sfull mu := by
    dsimp only [Sfull]
    fun_prop
  have hSprev : AEMeasurable Sprev mu := by
    dsimp only [Sprev]
    fun_prop
  letI : IsProbabilityMeasure (Measure.map Sfull mu) :=
    Measure.isProbabilityMeasure_map hSfull
  letI : IsProbabilityMeasure (Measure.map Sprev mu) :=
    Measure.isProbabilityMeasure_map hSprev
  letI : IsProbabilityMeasure (Measure.map (X (N + 1)) mu) :=
    Measure.isProbabilityMeasure_map (hX (N + 1))
  have hcfull : 0 < (Real.sqrt (N + 2 : ℝ))⁻¹ := by positivity
  have hcprev : 0 < (Real.sqrt (N + 1 : ℝ))⁻¹ := by positivity
  rw [map_normalizedCenteredIidSum_eq_map_mul_sum_range X hX (N + 1)]
  norm_num [Nat.cast_add, Nat.add_assoc]
  rw [show (N : ℝ) + 1 + 1 = (N : ℝ) + 2 by ring]
  rw [concentrationFunction_map_mul_eq
      (Measure.map (∑ i ∈ Finset.range (N + 2), X i) mu) hcfull]
  calc
    concentrationFunction
        (Measure.map (∑ i ∈ Finset.range (N + 2), X i) mu)
        (h / (Real.sqrt (N + 2 : ℝ))⁻¹) ≤
      concentrationFunction
        (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu)
        (h / (Real.sqrt (N + 2 : ℝ))⁻¹) := by
      rw [map_sum_range_succ_eq_conv X hX hIndep (N + 1)]
      exact concentrationFunction_conv_le_left _ _
        (div_nonneg hh hcfull.le)
    _ = concentrationFunction
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N) mu)
        ((Real.sqrt (N + 1 : ℝ))⁻¹ *
          (h * Real.sqrt (N + 2 : ℝ))) := by
      rw [map_normalizedCenteredIidSum_eq_map_mul_sum_range X hX N,
        concentrationFunction_map_mul_eq
          (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu) hcprev]
      field_simp

/-- The leave-one-out recurrence combined with the standard-normal interval
bound for the preceding normalized sum. -/
theorem concentrationFunction_normalizedCenteredIidSum_succ_le_gaussian_previous
    {Ω : Type*} [MeasurableSpace Ω]
    {mu : Measure Ω} [IsProbabilityMeasure mu]
    (X : ℕ → Ω → ℝ) (hX : ∀ i, AEMeasurable (X i) mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (N : ℕ) {h : ℝ} (hh : 0 ≤ h) :
    concentrationFunction
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X (N + 1)) mu) h ≤
      (Real.sqrt (2 * Real.pi))⁻¹ *
          ((Real.sqrt (N + 1 : ℝ))⁻¹ *
            (h * Real.sqrt (N + 2 : ℝ))) +
        2 * kolmogorovDistance
          (Measure.map
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N) mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  have hnorm : AEMeasurable
      (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N) mu := by
    unfold NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
    fun_prop
  letI : IsProbabilityMeasure
      (Measure.map
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N) mu) :=
    Measure.isProbabilityMeasure_map hnorm
  calc
    concentrationFunction
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X (N + 1)) mu) h ≤
      concentrationFunction
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N) mu)
        ((Real.sqrt (N + 1 : ℝ))⁻¹ *
          (h * Real.sqrt (N + 2 : ℝ))) :=
      concentrationFunction_normalizedCenteredIidSum_succ_le
        X hX hIndep N hh
    _ ≤ _ :=
      concentrationFunction_le_standardNormal_length_add_kolmogorov _
        (mul_nonneg (by positivity) (mul_nonneg hh (Real.sqrt_nonneg _)))

/-- A probability CDF is continuous at every point carrying no atom. -/
theorem continuousAt_cdf_of_measure_singleton_eq_zero
    (μ : Measure ℝ) [IsProbabilityMeasure μ] {x : ℝ}
    (hx : μ {x} = 0) : ContinuousAt (cdf μ) x := by
  rw [(ProbabilityTheory.monotone_cdf μ).continuousAt_iff_leftLim_eq_rightLim,
    (cdf μ).rightLim_eq]
  have hm : (cdf μ).measure {x} = 0 := by
    rw [ProbabilityTheory.measure_cdf μ]
    exact hx
  rw [StieltjesFunction.measure_singleton] at hm
  have hle : cdf μ x - Function.leftLim (cdf μ) x ≤ 0 :=
    ENNReal.ofReal_eq_zero.mp hm
  have hge : 0 ≤ cdf μ x - Function.leftLim (cdf μ) x :=
    sub_nonneg.mpr ((cdf μ).mono.leftLim_le le_rfl)
  linarith

/-- Absolute continuity with respect to Lebesgue measure removes every CDF
jump. -/
theorem continuous_cdf_of_absolutelyContinuous
    (μ : Measure ℝ) [IsProbabilityMeasure μ] (hμ : μ ≪ volume) :
    Continuous (cdf μ) := by
  rw [continuous_iff_continuousAt]
  intro x
  exact continuousAt_cdf_of_measure_singleton_eq_zero μ (hμ (by simp))

/-- The normalized uniform smoothing kernel has a Lebesgue density. -/
theorem uniformSmoothingKernel_absolutelyContinuous (δ : ℝ) :
    uniformSmoothingKernel δ ≪ volume := by
  unfold uniformSmoothingKernel
  exact Measure.smul_absolutelyContinuous.trans
    Measure.restrict_le_self.absolutelyContinuous

/-- Convolution with the uniform kernel has a Lebesgue density, even when
the other probability measure is singular. -/
theorem uniformSmoothingKernel_conv_absolutelyContinuous
    (μ : Measure ℝ) [IsProbabilityMeasure μ] {δ : ℝ} (hδ : 0 < δ) :
    uniformSmoothingKernel δ ∗ μ ≪ volume := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel δ) :=
    uniformSmoothingKernel_isProbabilityMeasure hδ
  rw [Measure.conv_comm]
  exact Measure.conv_absolutelyContinuous
    (uniformSmoothingKernel_absolutelyContinuous δ)

/-- Uniform smoothing makes every probability CDF continuous. -/
theorem continuous_cdf_uniformSmoothingKernel_conv
    (μ : Measure ℝ) [IsProbabilityMeasure μ] {δ : ℝ} (hδ : 0 < δ) :
    Continuous (cdf (uniformSmoothingKernel δ ∗ μ)) := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel δ) :=
    uniformSmoothingKernel_isProbabilityMeasure hδ
  exact continuous_cdf_of_absolutelyContinuous _
    (uniformSmoothingKernel_conv_absolutelyContinuous μ hδ)

/-- A finite first absolute moment makes the radial real-valued tail
integrable on the positive half-line.  This is the layer-cake input for the
integrability of a difference of two CDFs. -/
theorem integrableOn_measureReal_abs_ge
    (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ1 : Integrable (fun x : ℝ => |x|) μ) :
    IntegrableOn (fun t : ℝ => μ.real {x : ℝ | t ≤ |x|}) (Ioi 0) := by
  have hanti : Antitone (fun t : ℝ => μ.real {x : ℝ | t ≤ |x|}) := by
    intro s t hst
    exact measureReal_mono fun x hx => hst.trans hx
  have htail :
      ∫⁻ t in Ioi (0 : ℝ), μ {x : ℝ | t ≤ |x|} < ∞ := by
    rw [← lintegral_eq_lintegral_meas_le μ
      (f := fun x : ℝ => |x|)
      (ae_of_all μ fun x => abs_nonneg x) hμ1.aemeasurable]
    exact hμ1.lintegral_lt_top
  refine ⟨hanti.measurable.aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_ofReal
    (ae_of_all (volume.restrict (Ioi (0 : ℝ))) fun t => measureReal_nonneg)]
  rw [show (∫⁻ t in Ioi (0 : ℝ),
      ENNReal.ofReal (μ.real {x : ℝ | t ≤ |x|})) =
      ∫⁻ t in Ioi (0 : ℝ), μ {x : ℝ | t ≤ |x|} by
    apply lintegral_congr
    intro t
    exact ofReal_measureReal]
  exact htail

/-- The difference of two probability CDFs is integrable when both measures
have a finite first absolute moment. -/
theorem integrable_cdf_sub_cdf_of_firstMoments
    (μ ν : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμ1 : Integrable (fun x : ℝ => |x|) μ)
    (hν1 : Integrable (fun x : ℝ => |x|) ν) :
    Integrable (fun x : ℝ => cdf μ x - cdf ν x) := by
  let qμ : ℝ → ℝ := fun t => μ.real {x : ℝ | t ≤ |x|}
  let qν : ℝ → ℝ := fun t => ν.real {x : ℝ | t ≤ |x|}
  have hqμ : IntegrableOn qμ (Ioi 0) := by
    simpa only [qμ] using integrableOn_measureReal_abs_ge μ hμ1
  have hqν : IntegrableOn qν (Ioi 0) := by
    simpa only [qν] using integrableOn_measureReal_abs_ge ν hν1
  have hmeas : Measurable (fun x : ℝ => cdf μ x - cdf ν x) :=
    (ProbabilityTheory.monotone_cdf μ).measurable.sub
      (ProbabilityTheory.monotone_cdf ν).measurable
  have hpos : IntegrableOn (fun x : ℝ => cdf μ x - cdf ν x) (Ioi 0) := by
    apply (hqμ.add hqν).mono' hmeas.aestronglyMeasurable
    refine ae_restrict_of_forall_mem measurableSet_Ioi fun x hx => ?_
    rw [Real.norm_eq_abs]
    have htailμ : 1 - cdf μ x = μ.real (Ioi x) := by
      rw [cdf_eq_real, ← probReal_compl_eq_one_sub measurableSet_Iic, compl_Iic]
    have htailν : 1 - cdf ν x = ν.real (Ioi x) := by
      rw [cdf_eq_real, ← probReal_compl_eq_one_sub measurableSet_Iic, compl_Iic]
    have hμ_le : μ.real (Ioi x) ≤ qμ x := by
      exact measureReal_mono fun a ha =>
        (le_of_lt ha).trans (le_abs_self a)
    have hν_le : ν.real (Ioi x) ≤ qν x := by
      exact measureReal_mono fun a ha =>
        (le_of_lt ha).trans (le_abs_self a)
    calc
      |cdf μ x - cdf ν x| =
          |(1 - cdf ν x) - (1 - cdf μ x)| := by congr 1; ring
      _ ≤ |1 - cdf ν x| + |1 - cdf μ x| := abs_sub _ _
      _ = (1 - cdf ν x) + (1 - cdf μ x) := by
        rw [abs_of_nonneg (sub_nonneg.mpr (cdf_le_one ν x)),
          abs_of_nonneg (sub_nonneg.mpr (cdf_le_one μ x))]
      _ = μ.real (Ioi x) + ν.real (Ioi x) := by rw [htailμ, htailν]; ring
      _ ≤ qμ x + qν x := add_le_add hμ_le hν_le
  have hqμ_neg : IntegrableOn (fun x : ℝ => qμ (-x)) (Iic 0) := by
    rw [← Measure.map_neg_eq_self (volume : Measure ℝ)]
    let m : MeasurableEmbedding fun x : ℝ => -x :=
      (Homeomorph.neg ℝ).measurableEmbedding
    rw [m.integrableOn_map_iff]
    simp_rw [Function.comp_def, neg_preimage, neg_Iic, neg_zero]
    apply Iff.mpr integrableOn_Ici_iff_integrableOn_Ioi
    simpa only [neg_neg] using hqμ
  have hqν_neg : IntegrableOn (fun x : ℝ => qν (-x)) (Iic 0) := by
    rw [← Measure.map_neg_eq_self (volume : Measure ℝ)]
    let m : MeasurableEmbedding fun x : ℝ => -x :=
      (Homeomorph.neg ℝ).measurableEmbedding
    rw [m.integrableOn_map_iff]
    simp_rw [Function.comp_def, neg_preimage, neg_Iic, neg_zero]
    apply Iff.mpr integrableOn_Ici_iff_integrableOn_Ioi
    simpa only [neg_neg] using hqν
  have hneg : IntegrableOn (fun x : ℝ => cdf μ x - cdf ν x) (Iic 0) := by
    apply (hqμ_neg.add hqν_neg).mono' hmeas.aestronglyMeasurable
    refine ae_restrict_of_forall_mem measurableSet_Iic fun x hx => ?_
    rw [Real.norm_eq_abs]
    have hμ_le : cdf μ x ≤ qμ (-x) := by
      rw [cdf_eq_real]
      exact measureReal_mono fun a ha => by
        have ha0 : a ≤ 0 := ha.trans hx
        change -x ≤ |a|
        rw [abs_of_nonpos ha0]
        exact neg_le_neg ha
    have hν_le : cdf ν x ≤ qν (-x) := by
      rw [cdf_eq_real]
      exact measureReal_mono fun a ha => by
        have ha0 : a ≤ 0 := ha.trans hx
        change -x ≤ |a|
        rw [abs_of_nonpos ha0]
        exact neg_le_neg ha
    calc
      |cdf μ x - cdf ν x| ≤ |cdf μ x| + |cdf ν x| := abs_sub _ _
      _ = cdf μ x + cdf ν x := by
        rw [abs_of_nonneg (cdf_nonneg μ x), abs_of_nonneg (cdf_nonneg ν x)]
      _ ≤ qμ (-x) + qν (-x) := add_le_add hμ_le hν_le
  rw [← integrableOn_univ, ← Iic_union_Ioi]
  exact hneg.union hpos

/-- Pointwise `L¹ -> L∞` control of the upper signed error after one exact
normalized Gaussian keep/innovation step.  The two displayed factors are the
exact Gaussian density peak and the positive keep-coordinate Jacobian. -/
theorem IsStandardizedThirdMomentLaw.abs_cdfUpperError_normalizedGaussianStepLaw_le_integral
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (N : ℕ) (x : ℝ) :
    |cdfUpperError
      (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| ≤
      (Real.sqrt (2 * Real.pi *
        normalizedGaussianInnovationCoefficient N ^ 2))⁻¹ *
        (normalizedGaussianKeepCoefficient N *
          ∫ z, |cdfUpperError nu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z|) := by
  let gamma := NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let a := normalizedGaussianKeepCoefficient N
  let b := normalizedGaussianInnovationCoefficient N
  let v : ℝ≥0 := ⟨b ^ 2, sq_nonneg b⟩
  letI : IsProbabilityMeasure nu := h.probability
  letI : IsProbabilityMeasure
      (Measure.map (fun z : ℝ => a * z) nu) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure
      (Measure.map (fun z : ℝ => a * z) gamma) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  have ha : 0 < a := normalizedGaussianKeepCoefficient_pos N
  have hb : 0 < b := normalizedGaussianInnovationCoefficient_pos N
  have hv : v ≠ 0 := by
    rw [Ne, ← NNReal.coe_inj]
    simp only [v, NNReal.coe_mk, NNReal.coe_zero]
    exact (sq_pos_of_pos hb).ne'
  have hkappa : Measure.map (fun z : ℝ => b * z) gamma =
      ProbabilityTheory.gaussianReal 0 v := by
    dsimp only [gamma]
    rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw,
      ProbabilityTheory.gaussianReal_map_const_mul]
    simp only [mul_zero, mul_one, v]
  have hnuMapId : Integrable (fun z : ℝ => z)
      (Measure.map (fun z : ℝ => a * z) nu) :=
    integrable_id_map_mul_real nu a h.integrable_id
  have hgammaMapId : Integrable (fun z : ℝ => z)
      (Measure.map (fun z : ℝ => a * z) gamma) :=
    integrable_id_map_mul_real gamma a integrable_standardNormal_id
  have hscaled : Integrable (cdfUpperError
      (Measure.map (fun z : ℝ => a * z) nu)
      (Measure.map (fun z : ℝ => a * z) gamma)) := by
    have hnuAbs : Integrable (fun z : ℝ => |z|)
        (Measure.map (fun z : ℝ => a * z) nu) := by
      simpa only [Real.norm_eq_abs] using hnuMapId.norm
    have hgammaAbs : Integrable (fun z : ℝ => |z|)
        (Measure.map (fun z : ℝ => a * z) gamma) := by
      simpa only [Real.norm_eq_abs] using hgammaMapId.norm
    simpa only [cdfUpperError] using
      integrable_cdf_sub_cdf_of_firstMoments _ _ hnuAbs hgammaAbs
  have hgauss := abs_cdfUpperError_gaussianReal_conv_le_integral
    (Measure.map (fun z : ℝ => a * z) nu)
    (Measure.map (fun z : ℝ => a * z) gamma) hv hscaled x
  nth_rewrite 1 [← standardNormalLaw_normalizedGaussian_step N]
  change |cdfUpperError
      (Measure.map (fun z : ℝ => b * z) gamma ∗
        Measure.map (fun z : ℝ => a * z) nu)
      (Measure.map (fun z : ℝ => b * z) gamma ∗
        Measure.map (fun z : ℝ => a * z) gamma) x| ≤ _
  rw [hkappa]
  calc
    |cdfUpperError
        (ProbabilityTheory.gaussianReal 0 v ∗
          Measure.map (fun z : ℝ => a * z) nu)
        (ProbabilityTheory.gaussianReal 0 v ∗
          Measure.map (fun z : ℝ => a * z) gamma) x| ≤
        (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ *
          ∫ z, |cdfUpperError
            (Measure.map (fun w : ℝ => a * w) nu)
            (Measure.map (fun w : ℝ => a * w) gamma) z| := hgauss
    _ = (Real.sqrt (2 * Real.pi * b ^ 2))⁻¹ *
        (a * ∫ z, |cdfUpperError nu gamma z|) := by
      rw [integral_abs_cdfUpperError_map_mul_eq nu gamma ha]
      rfl

/-- Lower signed-error companion to the normalized Gaussian `L¹ -> L∞`
estimate. -/
theorem IsStandardizedThirdMomentLaw.abs_cdfLowerError_normalizedGaussianStepLaw_le_integral
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (N : ℕ) (x : ℝ) :
    |cdfLowerError
      (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| ≤
      (Real.sqrt (2 * Real.pi *
        normalizedGaussianInnovationCoefficient N ^ 2))⁻¹ *
        (normalizedGaussianKeepCoefficient N *
          ∫ z, |cdfLowerError nu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z|) := by
  simpa only [cdfLowerError_eq_neg_upper, abs_neg] using
    h.abs_cdfUpperError_normalizedGaussianStepLaw_le_integral N x

/-- Closed-form upper pointwise smoothing estimate. -/
theorem IsStandardizedThirdMomentLaw.abs_cdfUpperError_normalizedGaussianStepLaw_le_integral_explicit
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (N : ℕ) (x : ℝ) :
    |cdfUpperError
      (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| ≤
      (Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹) *
        ∫ z, |cdfUpperError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z| := by
  calc
    |cdfUpperError
        (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| ≤
        (Real.sqrt (2 * Real.pi *
          normalizedGaussianInnovationCoefficient N ^ 2))⁻¹ *
          (normalizedGaussianKeepCoefficient N *
            ∫ z, |cdfUpperError nu
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z|) :=
      h.abs_cdfUpperError_normalizedGaussianStepLaw_le_integral N x
    _ = (Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹) *
        ∫ z, |cdfUpperError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z| := by
      rw [← mul_assoc, normalizedGaussianDensityPeak_mul_keep]

/-- Closed-form lower pointwise smoothing estimate. -/
theorem IsStandardizedThirdMomentLaw.abs_cdfLowerError_normalizedGaussianStepLaw_le_integral_explicit
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (N : ℕ) (x : ℝ) :
    |cdfLowerError
      (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| ≤
      (Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹) *
        ∫ z, |cdfLowerError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z| := by
  simpa only [cdfLowerError_eq_neg_upper, abs_neg] using
    h.abs_cdfUpperError_normalizedGaussianStepLaw_le_integral_explicit N x

/-- The closed-form `L¹ -> L∞` estimate lifted to the upper one-sided CDF
distance. -/
theorem IsStandardizedThirdMomentLaw.upperCDFDistance_normalizedGaussianStepLaw_le_integral
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (N : ℕ) :
    upperCDFDistance
      (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      (Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹) *
        ∫ z, |cdfUpperError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z| := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  calc
    cdfUpperError
        (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x ≤
        |cdfUpperError
          (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| :=
      le_abs_self _
    _ ≤ _ := h.abs_cdfUpperError_normalizedGaussianStepLaw_le_integral_explicit N x

/-- Lower one-sided distance companion to the closed-form smoothing bound. -/
theorem IsStandardizedThirdMomentLaw.lowerCDFDistance_normalizedGaussianStepLaw_le_integral
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (N : ℕ) :
    lowerCDFDistance
      (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      (Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹) *
        ∫ z, |cdfLowerError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z| := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  calc
    cdfLowerError
        (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x ≤
        |cdfLowerError
          (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| :=
      le_abs_self _
    _ ≤ _ := h.abs_cdfLowerError_normalizedGaussianStepLaw_le_integral_explicit N x

/-- The closed-form smoothing estimate for the full Kolmogorov distance. -/
theorem IsStandardizedThirdMomentLaw.kolmogorovDistance_normalizedGaussianStepLaw_le_integral
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (N : ℕ) :
    kolmogorovDistance
      (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      (Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹) *
        ∫ z, |cdfUpperError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z| := by
  rw [kolmogorovDistance_eq_max_signed]
  apply max_le
  · exact h.upperCDFDistance_normalizedGaussianStepLaw_le_integral N
  · simpa only [cdfLowerError_eq_neg_upper, abs_neg] using
      h.lowerCDFDistance_normalizedGaussianStepLaw_le_integral N

/-- The compactly supported uniform smoothing kernel has a finite first
absolute moment. -/
theorem integrable_abs_uniformSmoothingKernel {δ : ℝ} (hδ : 0 < δ) :
    Integrable (fun x : ℝ => |x|) (uniformSmoothingKernel δ) := by
  unfold uniformSmoothingKernel
  exact continuous_abs.integrableOn_Icc.integrable.smul_measure <| by
    exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr (by positivity))

/-- Convolution preserves finiteness of the first absolute moment. -/
theorem integrable_abs_conv_of_firstMoments
    (κ μ : Measure ℝ) [IsProbabilityMeasure κ] [IsProbabilityMeasure μ]
    (hκ1 : Integrable (fun x : ℝ => |x|) κ)
    (hμ1 : Integrable (fun x : ℝ => |x|) μ) :
    Integrable (fun x : ℝ => |x|) (κ ∗ μ) := by
  rw [Measure.conv]
  apply (integrable_map_measure (by fun_prop) (by fun_prop)).mpr
  change Integrable (fun p : ℝ × ℝ => |p.1 + p.2|) (κ.prod μ)
  have hmajor : Integrable
      (fun p : ℝ × ℝ => |p.1| + |p.2|) (κ.prod μ) :=
    (hκ1.comp_fst μ).add (hμ1.comp_snd κ)
  apply hmajor.mono' (by fun_prop)
  exact ae_of_all (κ.prod μ) fun p => by
    rw [Real.norm_eq_abs, abs_abs]
    exact abs_add_le p.1 p.2

/-- Both uniformly smoothed laws have finite first moments, so their CDF
difference is integrable. -/
theorem integrable_cdf_uniformSmoothingKernel_conv_sub
    (μ ν : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμ1 : Integrable (fun x : ℝ => |x|) μ)
    (hν1 : Integrable (fun x : ℝ => |x|) ν)
    {δ : ℝ} (hδ : 0 < δ) :
    Integrable (fun x : ℝ =>
      cdf (uniformSmoothingKernel δ ∗ μ) x -
        cdf (uniformSmoothingKernel δ ∗ ν) x) := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel δ) :=
    uniformSmoothingKernel_isProbabilityMeasure hδ
  exact integrable_cdf_sub_cdf_of_firstMoments _ _
    (integrable_abs_conv_of_firstMoments _ _
      (integrable_abs_uniformSmoothingKernel hδ) hμ1)
    (integrable_abs_conv_of_firstMoments _ _
      (integrable_abs_uniformSmoothingKernel hδ) hν1)

/-- A CDF centered against the atom at zero.  Unlike a single probability
CDF, this function decays at both ends and is integrable under a first-moment
hypothesis. -/
noncomputable def centeredCDF (μ : Measure ℝ) (x : ℝ) : ℝ :=
  cdf μ x - cdf (Measure.dirac 0) x

/-- Pointwise kernel whose expectation is `centeredCDF`. -/
def centeredCDFKernel (y x : ℝ) : ℝ :=
  (Ici y).indicator (fun _ : ℝ => (1 : ℝ)) x -
    (Ici (0 : ℝ)).indicator (fun _ : ℝ => (1 : ℝ)) x

@[simp] theorem cdf_dirac_zero (x : ℝ) :
    cdf (Measure.dirac (0 : ℝ)) x =
      (Ici (0 : ℝ)).indicator (fun _ : ℝ => (1 : ℝ)) x := by
  rw [cdf_eq_real, Measure.real_def]
  by_cases hx : 0 ≤ x <;> simp [hx]

/-- The centered CDF is the expectation of the centered half-line kernel. -/
theorem centeredCDF_eq_integral_kernel
    (μ : Measure ℝ) [IsProbabilityMeasure μ] (x : ℝ) :
    centeredCDF μ x = ∫ y, centeredCDFKernel y x ∂μ := by
  change cdf μ x - cdf (Measure.dirac 0) x =
    ∫ y, ((Ici y).indicator (fun _ : ℝ => (1 : ℝ)) x -
      (Ici (0 : ℝ)).indicator (fun _ : ℝ => (1 : ℝ)) x) ∂μ
  have hfirst :
      (fun y : ℝ => (Ici y).indicator (fun _ : ℝ => (1 : ℝ)) x) =
        (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) := by
    funext y
    simp [Set.indicator_apply]
  have hIntFirst : Integrable
      (fun y : ℝ => (Ici y).indicator (fun _ : ℝ => (1 : ℝ)) x) μ := by
    rw [hfirst]
    exact (integrable_const (1 : ℝ)).indicator measurableSet_Iic
  have hIntSecond : Integrable
      (fun _y : ℝ =>
        (Ici (0 : ℝ)).indicator (fun _ : ℝ => (1 : ℝ)) x) μ :=
    integrable_const _
  rw [integral_sub hIntFirst hIntSecond, hfirst]
  congr 1
  · rw [cdf_eq_real]
    exact (integral_indicator_one measurableSet_Iic).symm
  · rw [cdf_dirac_zero, integral_const, probReal_univ, one_smul]

/-- A centered probability CDF is integrable under a finite first absolute
moment. -/
theorem integrable_centeredCDF
    (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ1 : Integrable (fun x : ℝ => |x|) μ) :
    Integrable (centeredCDF μ) := by
  have hdirac : Integrable (fun x : ℝ => |x|) (Measure.dirac 0) :=
    integrable_dirac (by simp)
  exact integrable_cdf_sub_cdf_of_firstMoments μ (Measure.dirac 0) hμ1 hdirac

theorem centeredCDFKernel_eq_indicator_of_nonpos
    {y : ℝ} (hy : y ≤ 0) :
    centeredCDFKernel y = (Ico y 0).indicator (fun _ : ℝ => (1 : ℝ)) := by
  funext x
  simp only [centeredCDFKernel, Set.indicator_apply, mem_Ici, mem_Ico]
  split_ifs <;> simp_all <;> linarith

theorem centeredCDFKernel_eq_neg_indicator_of_pos
    {y : ℝ} (hy : 0 < y) :
    centeredCDFKernel y = -(Ico 0 y).indicator (fun _ : ℝ => (1 : ℝ)) := by
  funext x
  simp only [centeredCDFKernel, Set.indicator_apply, mem_Ici, mem_Ico,
    Pi.neg_apply]
  split_ifs <;> simp_all <;> linarith

/-- For fixed `y`, the centered half-line kernel is integrable in `x`. -/
theorem integrable_centeredCDFKernel (y : ℝ) :
    Integrable (centeredCDFKernel y) := by
  by_cases hy : y ≤ 0
  · rw [centeredCDFKernel_eq_indicator_of_nonpos hy]
    exact (integrableOn_const (s := Ico y 0) (C := (1 : ℝ)) (by simp)).integrable_indicator
      measurableSet_Ico
  · rw [centeredCDFKernel_eq_neg_indicator_of_pos (lt_of_not_ge hy)]
    exact ((integrableOn_const (s := Ico 0 y) (C := (1 : ℝ)) (by simp)).integrable_indicator
      measurableSet_Ico).neg

/-- The exact `L¹` norm of the centered half-line kernel is the displacement
from its centering point. -/
theorem integral_norm_centeredCDFKernel (y : ℝ) :
    ∫ x, ‖centeredCDFKernel y x‖ = |y| := by
  by_cases hy : y ≤ 0
  · rw [centeredCDFKernel_eq_indicator_of_nonpos hy]
    calc
      (∫ x : ℝ, ‖(Ico y 0).indicator (fun _ : ℝ => (1 : ℝ)) x‖) =
          ∫ x : ℝ, (Ico y 0).indicator (fun _ : ℝ => (1 : ℝ)) x := by
        apply integral_congr_ae
        exact ae_of_all volume fun x => by
          by_cases hx : x ∈ Ico y 0 <;> simp [hx]
      _ = volume.real (Ico y 0) := integral_indicator_one measurableSet_Ico
      _ = |y| := by rw [Real.volume_real_Ico_of_le hy, abs_of_nonpos hy]; ring
  · have hy' : 0 < y := lt_of_not_ge hy
    rw [centeredCDFKernel_eq_neg_indicator_of_pos hy']
    calc
      (∫ x : ℝ, ‖(-(Ico 0 y).indicator (fun _ : ℝ => (1 : ℝ))) x‖) =
          ∫ x : ℝ, (Ico 0 y).indicator (fun _ : ℝ => (1 : ℝ)) x := by
        apply integral_congr_ae
        exact ae_of_all volume fun x => by
          by_cases hx : x ∈ Ico 0 y <;> simp [hx]
      _ = volume.real (Ico 0 y) := integral_indicator_one measurableSet_Ico
      _ = |y| := by
        rw [Real.volume_real_Ico_of_le hy'.le, abs_of_pos hy']
        ring

/-- The signed spatial mass of one centered half-line kernel is its negative
displacement. -/
theorem integral_centeredCDFKernel_eq_neg (y : ℝ) :
    (∫ x, centeredCDFKernel y x) = -y := by
  by_cases hy : y ≤ 0
  · rw [centeredCDFKernel_eq_indicator_of_nonpos hy]
    calc
      (∫ x : ℝ, (Ico y 0).indicator (fun _ : ℝ => (1 : ℝ)) x) =
          volume.real (Ico y 0) := integral_indicator_one measurableSet_Ico
      _ = -y := by rw [Real.volume_real_Ico_of_le hy]; ring
  · have hy' : 0 < y := lt_of_not_ge hy
    rw [centeredCDFKernel_eq_neg_indicator_of_pos hy']
    change (∫ x : ℝ,
      -((Ico 0 y).indicator (fun _ : ℝ => (1 : ℝ)) x)) = -y
    calc
      (∫ x : ℝ, -((Ico 0 y).indicator (fun _ : ℝ => (1 : ℝ)) x)) =
          -(∫ x : ℝ, (Ico 0 y).indicator (fun _ : ℝ => (1 : ℝ)) x) :=
        integral_neg _
      _ = -(volume.real (Ico 0 y)) := by
        exact congrArg Neg.neg (integral_indicator_one measurableSet_Ico)
      _ = -y := by rw [Real.volume_real_Ico_of_le hy'.le]; ring

/-- The first spatial moment of one centered half-line kernel is negative
one half of the squared displacement. -/
theorem integral_id_mul_centeredCDFKernel (y : ℝ) :
    (∫ x, x * centeredCDFKernel y x) = -(y ^ 2) / 2 := by
  by_cases hy : y ≤ 0
  · rw [centeredCDFKernel_eq_indicator_of_nonpos hy]
    have hind :
        (fun x : ℝ => x * (Ico y 0).indicator (fun _ : ℝ => (1 : ℝ)) x) =
          (Ico y 0).indicator (fun x : ℝ => x) := by
      funext x
      by_cases hx : x ∈ Ico y 0 <;> simp [hx]
    calc
      (∫ x : ℝ, x * (Ico y 0).indicator (fun _ : ℝ => (1 : ℝ)) x) =
          ∫ x in Ico y 0, x := by
        rw [hind, integral_indicator measurableSet_Ico]
      _ = ∫ x in Ioc y 0, x := by rw [restrict_Ico_eq_restrict_Ioc]
      _ = ∫ x in y..0, x := (intervalIntegral.integral_of_le hy).symm
      _ = -(y ^ 2) / 2 := by rw [integral_id]; ring
  · have hy' : 0 < y := lt_of_not_ge hy
    rw [centeredCDFKernel_eq_neg_indicator_of_pos hy']
    have hind :
        (fun x : ℝ => x * (-(Ico 0 y).indicator (fun _ : ℝ => (1 : ℝ))) x) =
          (fun x : ℝ => -((Ico 0 y).indicator (fun x : ℝ => x) x)) := by
      funext x
      by_cases hx : x ∈ Ico 0 y <;> simp [hx]
    calc
      (∫ x : ℝ, x * (-(Ico 0 y).indicator (fun _ : ℝ => (1 : ℝ))) x) =
          -(∫ x in Ico 0 y, x) := by
        rw [hind, integral_neg, integral_indicator measurableSet_Ico]
      _ = -(∫ x in Ioc 0 y, x) := by rw [restrict_Ico_eq_restrict_Ioc]
      _ = -(∫ x in 0..y, x) := by rw [intervalIntegral.integral_of_le hy'.le]
      _ = -(y ^ 2) / 2 := by rw [integral_id]; ring

/-- The product of the spatial coordinate with a centered half-line kernel
is always nonpositive. -/
theorem id_mul_centeredCDFKernel_nonpos (y x : ℝ) :
    x * centeredCDFKernel y x ≤ 0 := by
  by_cases hy : y ≤ 0
  · rw [centeredCDFKernel_eq_indicator_of_nonpos hy]
    by_cases hx : x ∈ Ico y 0
    · simp only [Set.indicator_of_mem hx, mul_one]
      exact hx.2.le
    · simp [hx]
  · have hy' : 0 < y := lt_of_not_ge hy
    rw [centeredCDFKernel_eq_neg_indicator_of_pos hy']
    by_cases hx : x ∈ Ico 0 y
    · simpa [hx] using (neg_nonpos.mpr hx.1)
    · simp [hx]

/-- Exact absolute first spatial moment of one centered half-line kernel. -/
theorem integral_norm_id_mul_centeredCDFKernel (y : ℝ) :
    (∫ x, ‖x * centeredCDFKernel y x‖) = y ^ 2 / 2 := by
  have hpoint (x : ℝ) : ‖x * centeredCDFKernel y x‖ =
      -(x * centeredCDFKernel y x) := by
    rw [Real.norm_eq_abs, abs_of_nonpos (id_mul_centeredCDFKernel_nonpos y x)]
  simp_rw [hpoint, integral_neg, integral_id_mul_centeredCDFKernel]
  ring

/-- Multiplying a centered half-line kernel by the spatial coordinate
preserves integrability. -/
theorem integrable_id_mul_centeredCDFKernel (y : ℝ) :
    Integrable (fun x => x * centeredCDFKernel y x) := by
  by_cases hy : y ≤ 0
  · rw [centeredCDFKernel_eq_indicator_of_nonpos hy]
    have hIco : IntegrableOn (fun x : ℝ => x) (Ico y 0) :=
      (integrableOn_Icc_iff_integrableOn_Ico).mp continuous_id.integrableOn_Icc
    have hInd := hIco.integrable_indicator measurableSet_Ico
    convert hInd using 1
    funext x
    by_cases hx : x ∈ Ico y 0 <;> simp [hx]
  · have hy' : 0 < y := lt_of_not_ge hy
    rw [centeredCDFKernel_eq_neg_indicator_of_pos hy']
    have hIco : IntegrableOn (fun x : ℝ => x) (Ico 0 y) :=
      (integrableOn_Icc_iff_integrableOn_Ico).mp continuous_id.integrableOn_Icc
    have hInd := (hIco.integrable_indicator measurableSet_Ico).neg
    convert hInd using 1
    funext x
    by_cases hx : x ∈ Ico 0 y <;> simp [hx]

/-- The exact squared-spatial-weight mass of one centered half-line kernel
is one third of the cubed displacement. -/
theorem integral_abs_sq_mul_norm_centeredCDFKernel (y : ℝ) :
    (∫ x, |x| ^ 2 * ‖centeredCDFKernel y x‖) = |y| ^ 3 / 3 := by
  by_cases hy : y ≤ 0
  · rw [centeredCDFKernel_eq_indicator_of_nonpos hy]
    have hind :
        (fun x : ℝ => |x| ^ 2 *
          ‖(Ico y 0).indicator (fun _ : ℝ => (1 : ℝ)) x‖) =
          (Ico y 0).indicator (fun x : ℝ => x ^ 2) := by
      funext x
      by_cases hx : x ∈ Ico y 0 <;> simp [hx, sq_abs]
    rw [hind, integral_indicator measurableSet_Ico,
      restrict_Ico_eq_restrict_Ioc,
      ← intervalIntegral.integral_of_le hy, integral_pow]
    rw [abs_of_nonpos hy]
    ring
  · have hy' : 0 < y := lt_of_not_ge hy
    rw [centeredCDFKernel_eq_neg_indicator_of_pos hy']
    have hind :
        (fun x : ℝ => |x| ^ 2 *
          ‖(-(Ico 0 y).indicator (fun _ : ℝ => (1 : ℝ))) x‖) =
          (Ico 0 y).indicator (fun x : ℝ => x ^ 2) := by
      funext x
      by_cases hx : x ∈ Ico 0 y <;> simp [hx, sq_abs]
    rw [hind, integral_indicator measurableSet_Ico,
      restrict_Ico_eq_restrict_Ioc,
      ← intervalIntegral.integral_of_le hy'.le, integral_pow,
      abs_of_pos hy']
    ring

/-- The squared-spatial-weight norm of a centered half-line kernel is
integrable. -/
theorem integrable_abs_sq_mul_norm_centeredCDFKernel (y : ℝ) :
    Integrable (fun x => |x| ^ 2 * ‖centeredCDFKernel y x‖) := by
  by_cases hy : y ≤ 0
  · rw [centeredCDFKernel_eq_indicator_of_nonpos hy]
    have hIco : IntegrableOn (fun x : ℝ => x ^ 2) (Ico y 0) :=
      (integrableOn_Icc_iff_integrableOn_Ico).mp
        ((continuous_id.pow 2).integrableOn_Icc)
    have hInd := hIco.integrable_indicator measurableSet_Ico
    convert hInd using 1
    funext x
    by_cases hx : x ∈ Ico y 0 <;> simp [hx, sq_abs]
  · have hy' : 0 < y := lt_of_not_ge hy
    rw [centeredCDFKernel_eq_neg_indicator_of_pos hy']
    have hIco : IntegrableOn (fun x : ℝ => x ^ 2) (Ico 0 y) :=
      (integrableOn_Icc_iff_integrableOn_Ico).mp
        ((continuous_id.pow 2).integrableOn_Icc)
    have hInd := hIco.integrable_indicator measurableSet_Ico
    convert hInd using 1
    funext x
    by_cases hx : x ∈ Ico 0 y <;> simp [hx, sq_abs]

/-- The oscillatory factor in Mathlib's normalized real Fourier transform. -/
noncomputable def normalizedFourierPhase (w x : ℝ) : ℂ :=
  Complex.exp (((-2 * Real.pi * x * w : ℝ) : ℂ) * Complex.I)

theorem continuous_normalizedFourierPhase (w : ℝ) :
    Continuous (normalizedFourierPhase w) := by
  apply Complex.continuous_exp.comp
  change Continuous (fun x : ℝ => (((-2 * Real.pi * x * w : ℝ) : ℂ) * Complex.I))
  fun_prop

/-- The Fourier integral of one centered half-line kernel, away from frequency
zero. This is the elementary interval calculation behind the CDF/characteristic-
function transform identity. -/
theorem integral_normalizedFourierPhase_mul_centeredCDFKernel
    {w : ℝ} (hw : w ≠ 0) (y : ℝ) :
    (∫ x, normalizedFourierPhase w x * (centeredCDFKernel y x : ℂ)) =
      (normalizedFourierPhase w y - 1) /
        (((2 * Real.pi * w : ℝ) : ℂ) * Complex.I) := by
  let c : ℂ := (((-2 * Real.pi * w : ℝ) : ℂ) * Complex.I)
  have hc : c ≠ 0 := by
    apply mul_ne_zero
    · exact Complex.ofReal_ne_zero.mpr (mul_ne_zero (mul_ne_zero (by norm_num) Real.pi_ne_zero) hw)
    · exact Complex.I_ne_zero
  have hphase (x : ℝ) : normalizedFourierPhase w x = Complex.exp (c * x) := by
    simp only [normalizedFourierPhase, c]
    congr 1
    push_cast
    ring
  by_cases hy : y ≤ 0
  · rw [centeredCDFKernel_eq_indicator_of_nonpos hy]
    have hind :
        (fun x : ℝ => normalizedFourierPhase w x *
          (((Ico y 0).indicator (fun _ : ℝ => (1 : ℝ)) x : ℝ) : ℂ)) =
          (Ico y 0).indicator (fun x : ℝ => normalizedFourierPhase w x) := by
      funext x
      by_cases hx : x ∈ Ico y 0 <;> simp [hx]
    rw [hind, integral_indicator measurableSet_Ico]
    rw [restrict_Ico_eq_restrict_Ioc,
      ← intervalIntegral.integral_of_le hy]
    simp_rw [hphase]
    rw [integral_exp_mul_complex hc]
    have hd : (((2 * Real.pi * w : ℝ) : ℂ) * Complex.I) = -c := by
      dsimp [c]
      push_cast
      ring
    rw [show Complex.exp (c * (0 : ℝ)) = 1 by simp, ← hphase y, hd]
    field_simp
    ring
  · have hy' : 0 < y := lt_of_not_ge hy
    rw [centeredCDFKernel_eq_neg_indicator_of_pos hy']
    have hind :
        (fun x : ℝ => normalizedFourierPhase w x *
          (((-(Ico 0 y).indicator (fun _ : ℝ => (1 : ℝ))) x : ℝ) : ℂ)) =
          (fun x : ℝ => -((Ico 0 y).indicator
            (fun x : ℝ => normalizedFourierPhase w x) x)) := by
      funext x
      by_cases hx : x ∈ Ico 0 y <;> simp [hx]
    rw [hind, integral_neg, integral_indicator measurableSet_Ico]
    rw [restrict_Ico_eq_restrict_Ioc,
      ← intervalIntegral.integral_of_le hy'.le]
    simp_rw [hphase]
    rw [integral_exp_mul_complex hc]
    have hd : (((2 * Real.pi * w : ℝ) : ℂ) * Complex.I) = -c := by
      dsimp [c]
      push_cast
      ring
    rw [show Complex.exp (c * (0 : ℝ)) = 1 by simp, ← hphase y, hd]
    field_simp

/-- Joint measurability of the centered half-line kernel in displacement and
evaluation point. -/
theorem measurable_centeredCDFKernel_uncurry :
    Measurable (fun p : ℝ × ℝ => centeredCDFKernel p.1 p.2) := by
  simp only [centeredCDFKernel, Set.indicator_apply, mem_Ici]
  apply Measurable.sub
  · exact Measurable.ite (measurableSet_le measurable_fst measurable_snd)
      measurable_const measurable_const
  · exact Measurable.ite (measurableSet_le measurable_const measurable_snd)
      measurable_const measurable_const

/-- Multiplication by the normalized Fourier phase preserves integrability of
each centered half-line kernel section. -/
theorem integrable_normalizedFourierPhase_mul_centeredCDFKernel
    (w y : ℝ) :
    Integrable (fun x => normalizedFourierPhase w x *
      (centeredCDFKernel y x : ℂ)) := by
  apply (integrable_centeredCDFKernel y).ofReal.bdd_mul (c := 1)
  · exact (continuous_normalizedFourierPhase w).aestronglyMeasurable
  · exact ae_of_all volume fun x => by
      change ‖Complex.exp (((-2 * Real.pi * x * w : ℝ) : ℂ) * Complex.I)‖ ≤ 1
      rw [Complex.norm_exp_ofReal_mul_I]

/-- The normalized Fourier phase has unit norm, so the oscillatory kernel has
the same exact `L¹` norm as the underlying centered half-line kernel. -/
theorem integral_norm_normalizedFourierPhase_mul_centeredCDFKernel
    (w y : ℝ) :
    (∫ x, ‖normalizedFourierPhase w x * (centeredCDFKernel y x : ℂ)‖) = |y| := by
  simp_rw [norm_mul, normalizedFourierPhase,
    Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real]
  exact integral_norm_centeredCDFKernel y

/-- Exact first-moment domination makes the centered-CDF Fourier kernel
integrable on the product space, which licenses Fubini. -/
theorem integrable_prod_normalizedFourierPhase_mul_centeredCDFKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu) (w : ℝ) :
    Integrable (fun p : ℝ × ℝ => normalizedFourierPhase w p.2 *
      (centeredCDFKernel p.1 p.2 : ℂ)) (mu.prod volume) := by
  have hmeas : Measurable (fun p : ℝ × ℝ => normalizedFourierPhase w p.2 *
      (centeredCDFKernel p.1 p.2 : ℂ)) := by
    exact ((continuous_normalizedFourierPhase w).measurable.comp measurable_snd).mul
      (Complex.continuous_ofReal.measurable.comp measurable_centeredCDFKernel_uncurry)
  rw [integrable_prod_iff hmeas.aestronglyMeasurable]
  constructor
  · exact ae_of_all mu fun y =>
      integrable_normalizedFourierPhase_mul_centeredCDFKernel w y
  · convert hmu1 using 1
    funext y
    exact integral_norm_normalizedFourierPhase_mul_centeredCDFKernel w y

/-- Exact first-moment domination makes the real centered-CDF kernel
integrable on the product space. -/
theorem integrable_prod_centeredCDFKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu) :
    Integrable (fun p : ℝ × ℝ => centeredCDFKernel p.1 p.2)
      (mu.prod volume) := by
  have h :=
    (integrable_prod_normalizedFourierPhase_mul_centeredCDFKernel mu hmu1 0).re
  simpa [normalizedFourierPhase] using h

/-- A finite second moment makes the coordinate-weighted centered-CDF
kernel integrable on the product space. -/
theorem integrable_prod_id_mul_centeredCDFKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu) :
    Integrable (fun p : ℝ × ℝ =>
      p.2 * centeredCDFKernel p.1 p.2) (mu.prod volume) := by
  have hmeas : Measurable (fun p : ℝ × ℝ =>
      p.2 * centeredCDFKernel p.1 p.2) :=
    measurable_snd.mul measurable_centeredCDFKernel_uncurry
  rw [integrable_prod_iff hmeas.aestronglyMeasurable]
  constructor
  · exact ae_of_all mu fun y => integrable_id_mul_centeredCDFKernel y
  · have hhalf : Integrable (fun y : ℝ => y ^ 2 / 2) mu := by
      convert hmu2.const_mul (1 / 2 : ℝ) using 1
      funext y
      ring
    convert hhalf using 1
    funext y
    exact integral_norm_id_mul_centeredCDFKernel y

/-- A finite third absolute moment makes the squared-spatial-weight kernel
norm integrable on the product space. -/
theorem integrable_prod_abs_sq_mul_norm_centeredCDFKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu) :
    Integrable (fun p : ℝ × ℝ =>
      |p.2| ^ 2 * ‖centeredCDFKernel p.1 p.2‖) (mu.prod volume) := by
  have hmeas : Measurable (fun p : ℝ × ℝ =>
      |p.2| ^ 2 * ‖centeredCDFKernel p.1 p.2‖) :=
    ((continuous_abs.measurable.comp measurable_snd).pow_const 2).mul
      measurable_centeredCDFKernel_uncurry.norm
  rw [integrable_prod_iff hmeas.aestronglyMeasurable]
  constructor
  · exact ae_of_all mu fun y =>
      integrable_abs_sq_mul_norm_centeredCDFKernel y
  · have hthird : Integrable (fun y : ℝ => |y| ^ 3 / 3) mu := by
      convert hmu3.const_mul (1 / 3 : ℝ) using 1
      funext y
      ring
    convert hthird using 1
    funext y
    simpa only [Prod.snd, Prod.fst, Real.norm_eq_abs, abs_mul, abs_pow,
      abs_abs] using integral_abs_sq_mul_norm_centeredCDFKernel y

/-- Signed squared-spatial-weight kernel integrability, obtained from its
exact norm majorant. -/
theorem integrable_prod_sq_mul_centeredCDFKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu) :
    Integrable (fun p : ℝ × ℝ =>
      p.2 ^ 2 * centeredCDFKernel p.1 p.2) (mu.prod volume) := by
  apply (integrable_prod_abs_sq_mul_norm_centeredCDFKernel mu hmu3).mono'
  · exact ((measurable_snd.pow_const 2).mul
      measurable_centeredCDFKernel_uncurry).aestronglyMeasurable
  · exact ae_of_all _ fun p => by
      rw [Real.norm_eq_abs, abs_mul, abs_pow, Real.norm_eq_abs]

/-- The spatial integral of a centered probability CDF is the negative
first moment of the law. -/
theorem integral_centeredCDF_eq_neg_integral_id
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu) :
    (∫ x, centeredCDF mu x) = -(∫ y, y ∂mu) := by
  simp_rw [centeredCDF_eq_integral_kernel]
  have hprod := integrable_prod_centeredCDFKernel mu hmu1
  have hswap : Integrable
      (Function.uncurry (fun x y : ℝ => centeredCDFKernel y x))
        (volume.prod mu) := by
    simpa only [Function.uncurry_apply_pair, Function.comp_apply] using hprod.swap
  rw [integral_integral_swap hswap]
  simpa only [integral_centeredCDFKernel_eq_neg] using
    (integral_neg (μ := mu) (f := fun y : ℝ => y))

/-- A centered probability CDF has an integrable coordinate-weighted form
under a finite second moment. -/
theorem integrable_id_mul_centeredCDF
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu) :
    Integrable (fun x => x * centeredCDF mu x) := by
  have hprod := integrable_prod_id_mul_centeredCDFKernel mu hmu2
  have hout := hprod.swap.integral_prod_left
  convert hout using 1
  funext x
  change x * centeredCDF mu x =
    ∫ y, x * centeredCDFKernel y x ∂mu
  rw [centeredCDF_eq_integral_kernel, integral_const_mul]

/-- The first spatial moment of a centered probability CDF is negative one
half of the law's second moment. -/
theorem integral_id_mul_centeredCDF_eq_neg_half_secondMoment
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu) :
    (∫ x, x * centeredCDF mu x) =
      -(∫ y, y ^ 2 ∂mu) / 2 := by
  rw [show (fun x => x * centeredCDF mu x) =
      (fun x => ∫ y, x * centeredCDFKernel y x ∂mu) by
    funext x
    rw [centeredCDF_eq_integral_kernel, integral_const_mul]]
  have hprod := integrable_prod_id_mul_centeredCDFKernel mu hmu2
  have hswap : Integrable
      (Function.uncurry (fun x y : ℝ =>
        x * centeredCDFKernel y x)) (volume.prod mu) := by
    simpa only [Function.uncurry_apply_pair, Function.comp_apply] using hprod.swap
  rw [integral_integral_swap hswap]
  simp_rw [integral_id_mul_centeredCDFKernel, integral_div, integral_neg]

/-- A centered probability CDF becomes integrable after multiplication by
the squared spatial coordinate under a finite third absolute moment. -/
theorem integrable_sq_mul_centeredCDF
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu) :
    Integrable (fun x => x ^ 2 * centeredCDF mu x) := by
  have hprod := integrable_prod_sq_mul_centeredCDFKernel mu hmu3
  have hout := hprod.swap.integral_prod_left
  convert hout using 1
  funext x
  change x ^ 2 * centeredCDF mu x =
    ∫ y, x ^ 2 * centeredCDFKernel y x ∂mu
  rw [centeredCDF_eq_integral_kernel, integral_const_mul]

/-- The squared-spatial-weight `L¹` norm of a centered CDF is bounded by one
third of the law's third absolute moment. -/
theorem integral_abs_sq_mul_abs_centeredCDF_le
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu) :
    (∫ x, |x| ^ 2 * |centeredCDF mu x|) ≤
      ∫ y, |y| ^ 3 / 3 ∂mu := by
  have hsigned := integrable_sq_mul_centeredCDF mu hmu3
  have hleft : Integrable (fun x => |x| ^ 2 * |centeredCDF mu x|) := by
    simpa only [Real.norm_eq_abs, abs_mul, abs_pow] using hsigned.norm
  have habsprod :=
    integrable_prod_abs_sq_mul_norm_centeredCDFKernel mu hmu3
  have hswap : Integrable
      (Function.uncurry (fun x y : ℝ =>
        |x| ^ 2 * ‖centeredCDFKernel y x‖)) (volume.prod mu) := by
    simpa only [Function.uncurry_apply_pair, Function.comp_apply] using
      habsprod.swap
  have hright : Integrable (fun x =>
      ∫ y, |x| ^ 2 * ‖centeredCDFKernel y x‖ ∂mu) :=
    hswap.integral_prod_left
  calc
    (∫ x, |x| ^ 2 * |centeredCDF mu x|) ≤
        ∫ x, (∫ y, |x| ^ 2 * ‖centeredCDFKernel y x‖ ∂mu) := by
      apply integral_mono hleft hright
      intro x
      change |x| ^ 2 * |centeredCDF mu x| ≤
        ∫ y, |x| ^ 2 * ‖centeredCDFKernel y x‖ ∂mu
      rw [centeredCDF_eq_integral_kernel]
      have hnorm : |∫ y, centeredCDFKernel y x ∂mu| ≤
          ∫ y, ‖centeredCDFKernel y x‖ ∂mu := by
        simpa only [Real.norm_eq_abs] using
          (norm_integral_le_integral_norm
            (fun y => centeredCDFKernel y x) (μ := mu))
      calc
        |x| ^ 2 * |∫ y, centeredCDFKernel y x ∂mu| ≤
            |x| ^ 2 * ∫ y, ‖centeredCDFKernel y x‖ ∂mu :=
          mul_le_mul_of_nonneg_left hnorm (sq_nonneg |x|)
        _ = ∫ y, |x| ^ 2 * ‖centeredCDFKernel y x‖ ∂mu := by
          rw [integral_const_mul]
    _ = ∫ y, (∫ x, |x| ^ 2 * ‖centeredCDFKernel y x‖) ∂mu :=
      integral_integral_swap hswap
    _ = ∫ y, |y| ^ 3 / 3 ∂mu := by
      apply integral_congr_ae
      exact ae_of_all _ fun y =>
        integral_abs_sq_mul_norm_centeredCDFKernel y

/-- The spatial integral of a difference of probability CDFs is the reverse
difference of their first moments. -/
theorem integral_cdf_sub_cdf_eq_integral_id_sub
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu) :
    (∫ x, cdf mu x - cdf nu x) =
      (∫ y, y ∂nu) - ∫ y, y ∂mu := by
  have hmuC := integrable_centeredCDF mu hmu1
  have hnuC := integrable_centeredCDF nu hnu1
  calc
    (∫ x, cdf mu x - cdf nu x) =
        ∫ x, centeredCDF mu x - centeredCDF nu x := by
      apply integral_congr_ae
      exact ae_of_all _ fun x => by unfold centeredCDF; ring
    _ = (∫ x, centeredCDF mu x) - ∫ x, centeredCDF nu x :=
      integral_sub hmuC hnuC
    _ = (∫ y, y ∂nu) - ∫ y, y ∂mu := by
      rw [integral_centeredCDF_eq_neg_integral_id mu hmu1,
        integral_centeredCDF_eq_neg_integral_id nu hnu1]
      ring

/-- The first spatial moment of a probability-CDF difference is one half
of the reverse difference of the laws' second moments. -/
theorem integral_id_mul_cdf_sub_cdf_eq_secondMoment_sub
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu)
    (hnu2 : Integrable (fun y : ℝ => y ^ 2) nu) :
    (∫ x, x * (cdf mu x - cdf nu x)) =
      ((∫ y, y ^ 2 ∂nu) - ∫ y, y ^ 2 ∂mu) / 2 := by
  have hmuC := integrable_id_mul_centeredCDF mu hmu2
  have hnuC := integrable_id_mul_centeredCDF nu hnu2
  calc
    (∫ x, x * (cdf mu x - cdf nu x)) =
        ∫ x, x * centeredCDF mu x - x * centeredCDF nu x := by
      apply integral_congr_ae
      exact ae_of_all _ fun x => by unfold centeredCDF; ring
    _ = (∫ x, x * centeredCDF mu x) -
        ∫ x, x * centeredCDF nu x := integral_sub hmuC hnuC
    _ = ((∫ y, y ^ 2 ∂nu) - ∫ y, y ^ 2 ∂mu) / 2 := by
      rw [integral_id_mul_centeredCDF_eq_neg_half_secondMoment mu hmu2,
        integral_id_mul_centeredCDF_eq_neg_half_secondMoment nu hnu2]
      ring

/-- A third absolute moment controls the squared-spatial-weight `L¹` norm
of the difference of two probability CDFs. -/
theorem integral_abs_sq_mul_abs_cdf_sub_cdf_le
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu)
    (hnu3 : Integrable (fun y : ℝ => |y| ^ 3) nu) :
    (∫ x, |x| ^ 2 * |cdf mu x - cdf nu x|) ≤
      (∫ y, |y| ^ 3 / 3 ∂mu) + ∫ y, |y| ^ 3 / 3 ∂nu := by
  have hmuSigned := integrable_sq_mul_centeredCDF mu hmu3
  have hnuSigned := integrable_sq_mul_centeredCDF nu hnu3
  have hmuW : Integrable (fun x => |x| ^ 2 * |centeredCDF mu x|) := by
    simpa only [Real.norm_eq_abs, abs_mul, abs_pow] using hmuSigned.norm
  have hnuW : Integrable (fun x => |x| ^ 2 * |centeredCDF nu x|) := by
    simpa only [Real.norm_eq_abs, abs_mul, abs_pow] using hnuSigned.norm
  have hpoint (x : ℝ) :
      |x| ^ 2 * |cdf mu x - cdf nu x| ≤
        |x| ^ 2 * |centeredCDF mu x| +
          |x| ^ 2 * |centeredCDF nu x| := by
    have heq : cdf mu x - cdf nu x =
        centeredCDF mu x - centeredCDF nu x := by
      unfold centeredCDF
      ring
    rw [heq, ← mul_add]
    exact mul_le_mul_of_nonneg_left (abs_sub _ _)
      (sq_nonneg |x|)
  have hgapMeas : AEStronglyMeasurable
      (fun x => |x| ^ 2 * |cdf mu x - cdf nu x|) :=
    (((measurable_id.abs.pow_const 2).mul
      (((monotone_cdf mu).measurable.sub
        (monotone_cdf nu).measurable).abs))).aestronglyMeasurable
  have hgap : Integrable
      (fun x => |x| ^ 2 * |cdf mu x - cdf nu x|) := by
    apply (hmuW.add hnuW).mono' hgapMeas
    exact ae_of_all _ fun x => by
      rw [Real.norm_eq_abs, abs_of_nonneg
        (mul_nonneg (sq_nonneg |x|) (abs_nonneg _))]
      exact hpoint x
  calc
    (∫ x, |x| ^ 2 * |cdf mu x - cdf nu x|) ≤
        ∫ x, (|x| ^ 2 * |centeredCDF mu x| +
          |x| ^ 2 * |centeredCDF nu x|) := by
      apply integral_mono hgap (hmuW.add hnuW)
      exact hpoint
    _ = (∫ x, |x| ^ 2 * |centeredCDF mu x|) +
        ∫ x, |x| ^ 2 * |centeredCDF nu x| :=
      integral_add hmuW hnuW
    _ ≤ (∫ y, |y| ^ 3 / 3 ∂mu) + ∫ y, |y| ^ 3 / 3 ∂nu :=
      add_le_add
        (integral_abs_sq_mul_abs_centeredCDF_le mu hmu3)
        (integral_abs_sq_mul_abs_centeredCDF_le nu hnu3)

/-- The weighted CDF difference appearing in the third-moment estimate is
itself integrable. -/
theorem integrable_abs_sq_mul_abs_cdf_sub_cdf
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu)
    (hnu3 : Integrable (fun y : ℝ => |y| ^ 3) nu) :
    Integrable (fun x => |x| ^ 2 * |cdf mu x - cdf nu x|) := by
  have hmuSigned := integrable_sq_mul_centeredCDF mu hmu3
  have hnuSigned := integrable_sq_mul_centeredCDF nu hnu3
  have hmuW : Integrable (fun x => |x| ^ 2 * |centeredCDF mu x|) := by
    simpa only [Real.norm_eq_abs, abs_mul, abs_pow] using hmuSigned.norm
  have hnuW : Integrable (fun x => |x| ^ 2 * |centeredCDF nu x|) := by
    simpa only [Real.norm_eq_abs, abs_mul, abs_pow] using hnuSigned.norm
  apply (hmuW.add hnuW).mono'
  · exact (((measurable_id.abs.pow_const 2).mul
      (((monotone_cdf mu).measurable.sub
        (monotone_cdf nu).measurable).abs))).aestronglyMeasurable
  · exact ae_of_all _ fun x => by
      rw [Real.norm_eq_abs, abs_of_nonneg
        (mul_nonneg (sq_nonneg |x|) (abs_nonneg _))]
      have heq : cdf mu x - cdf nu x =
          centeredCDF mu x - centeredCDF nu x := by
        unfold centeredCDF
        ring
      change |x| ^ 2 * |cdf mu x - cdf nu x| ≤
        |x| ^ 2 * |centeredCDF mu x| +
          |x| ^ 2 * |centeredCDF nu x|
      rw [heq, ← mul_add]
      exact mul_le_mul_of_nonneg_left (abs_sub _ _)
        (sq_nonneg |x|)

/-- Weighted Markov estimate for the spatial tail of an integrable real
function. -/
theorem integral_abs_restrict_abs_ge_le_inv_sq_mul
    (f : ℝ → ℝ) (hf : Measurable f)
    (hweighted : Integrable (fun x => |x| ^ 2 * |f x|))
    {R : ℝ} (hR : 0 < R) :
    (∫ x in {x : ℝ | R ≤ |x|}, |f x|) ≤
      (R ^ 2)⁻¹ * ∫ x, |x| ^ 2 * |f x| := by
  let s : Set ℝ := {x : ℝ | R ≤ |x|}
  have hs : MeasurableSet s :=
    measurableSet_le measurable_const continuous_abs.measurable
  have hInv : 0 ≤ (R ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg R)
  have hpoint {x : ℝ} (hx : x ∈ s) :
      |f x| ≤ (R ^ 2)⁻¹ * (|x| ^ 2 * |f x|) := by
    have hxR : R ≤ |x| := hx
    have hsq : R ^ 2 ≤ |x| ^ 2 := by nlinarith [abs_nonneg x]
    calc
      |f x| = (R ^ 2)⁻¹ * (R ^ 2 * |f x|) := by
        field_simp
      _ ≤ (R ^ 2)⁻¹ * (|x| ^ 2 * |f x|) := by
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right hsq (abs_nonneg (f x))) hInv
  have hmajor : Integrable
      (fun x => (R ^ 2)⁻¹ * (|x| ^ 2 * |f x|)) :=
    hweighted.const_mul _
  have hleft : IntegrableOn (fun x => |f x|) s := by
    apply hmajor.integrableOn.mono' hf.abs.aestronglyMeasurable
    refine ae_restrict_of_forall_mem hs fun x hx => ?_
    simpa only [Real.norm_eq_abs, abs_abs] using hpoint hx
  calc
    (∫ x in {x : ℝ | R ≤ |x|}, |f x|) = ∫ x in s, |f x| := rfl
    _ ≤ ∫ x in s, (R ^ 2)⁻¹ * (|x| ^ 2 * |f x|) := by
      apply integral_mono_ae hleft hmajor.integrableOn
      exact ae_restrict_of_forall_mem hs fun x hx => hpoint hx
    _ = (R ^ 2)⁻¹ * ∫ x in s, |x| ^ 2 * |f x| := by
      rw [integral_const_mul]
    _ ≤ (R ^ 2)⁻¹ * ∫ x, |x| ^ 2 * |f x| := by
      apply mul_le_mul_of_nonneg_left _ hInv
      exact setIntegral_le_integral hweighted
        (ae_of_all _ fun x =>
          mul_nonneg (sq_nonneg |x|) (abs_nonneg (f x)))

/-- On a central interval, the absolute upper signed CDF error integrates to
at most the interval length times Kolmogorov distance. -/
theorem integral_abs_cdfUpperError_restrict_abs_lt_le
    (mu nu : Measure ℝ) {R : ℝ} (hR : 0 ≤ R) :
    (∫ x in {x : ℝ | |x| < R}, |cdfUpperError mu nu x|) ≤
      2 * R * kolmogorovDistance mu nu := by
  have hset : {x : ℝ | |x| < R} = Ioo (-R) R := by
    ext x
    simp only [mem_setOf_eq, mem_Ioo]
    exact abs_lt
  have hleft : IntegrableOn (fun x => |cdfUpperError mu nu x|)
      (Ioo (-R) R) := by
    have hmu : Integrable (fun x => cdf mu x)
        (volume.restrict (Ioo (-R) R)) :=
      integrable_cdf_comp mu _ measurable_id
    have hnu : Integrable (fun x => cdf nu x)
        (volume.restrict (Ioo (-R) R)) :=
      integrable_cdf_comp nu _ measurable_id
    simpa only [cdfUpperError, Real.norm_eq_abs] using (hmu.sub hnu).norm
  have hright : IntegrableOn
      (fun _x : ℝ => kolmogorovDistance mu nu) (Ioo (-R) R) :=
    integrableOn_const (by simp)
  rw [hset]
  calc
    (∫ x in Ioo (-R) R, |cdfUpperError mu nu x|) ≤
        ∫ _x in Ioo (-R) R, kolmogorovDistance mu nu := by
      apply integral_mono hleft hright
      intro x
      simpa only [cdfGap, cdfUpperError] using
        cdfGap_le_kolmogorovDistance mu nu x
    _ = 2 * R * kolmogorovDistance mu nu := by
      rw [setIntegral_const,
        Real.volume_real_Ioo_of_le (by linarith)]
      simp only [smul_eq_mul]
      ring

/-- Central-interval companion for the lower signed CDF error. -/
theorem integral_abs_cdfLowerError_restrict_abs_lt_le
    (mu nu : Measure ℝ) {R : ℝ} (hR : 0 ≤ R) :
    (∫ x in {x : ℝ | |x| < R}, |cdfLowerError mu nu x|) ≤
      2 * R * kolmogorovDistance mu nu := by
  simpa only [cdfLowerError_eq_neg_upper, abs_neg] using
    integral_abs_cdfUpperError_restrict_abs_lt_le mu nu hR

/-- The signed upper CDF error of every standardized law has zero spatial
mass against the standard normal. -/
theorem IsStandardizedThirdMomentLaw.integral_cdfUpperError_standardNormal
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B) :
    (∫ x, cdfUpperError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x) = 0 := by
  letI : IsProbabilityMeasure nu := h.probability
  have hnuAbs : Integrable (fun y : ℝ => |y|) nu := by
    simpa only [Real.norm_eq_abs] using h.integrable_id.norm
  have hgaussAbs : Integrable (fun y : ℝ => |y|)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
    simpa only [Real.norm_eq_abs] using integrable_standardNormal_id.norm
  unfold cdfUpperError
  rw [integral_cdf_sub_cdf_eq_integral_id_sub _ _ hnuAbs hgaussAbs,
    h.centered, integral_standardNormal_id]
  ring

/-- The signed upper CDF error of every standardized law also has zero first
spatial moment against the standard normal. -/
theorem IsStandardizedThirdMomentLaw.integral_id_mul_cdfUpperError_standardNormal
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B) :
    (∫ x, x * cdfUpperError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x) = 0 := by
  letI : IsProbabilityMeasure nu := h.probability
  unfold cdfUpperError
  rw [integral_id_mul_cdf_sub_cdf_eq_secondMoment_sub _ _
      h.integrable_sq integrable_standardNormal_sq,
    h.unit_second_moment, integral_standardNormal_sq]
  ring

/-- Lower signed-error companion to
`IsStandardizedThirdMomentLaw.integral_cdfUpperError_standardNormal`. -/
theorem IsStandardizedThirdMomentLaw.integral_cdfLowerError_standardNormal
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B) :
    (∫ x, cdfLowerError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x) = 0 := by
  simp only [cdfLowerError_eq_neg_upper, integral_neg,
    h.integral_cdfUpperError_standardNormal, neg_zero]

/-- First-spatial-moment companion for the lower signed CDF error. -/
theorem IsStandardizedThirdMomentLaw.integral_id_mul_cdfLowerError_standardNormal
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B) :
    (∫ x, x * cdfLowerError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x) = 0 := by
  simp only [cdfLowerError_eq_neg_upper, mul_neg, integral_neg,
    h.integral_id_mul_cdfUpperError_standardNormal, neg_zero]

/-- Third-moment weighted `L¹` control of the standardized upper signed CDF
error against the standard normal. -/
theorem IsStandardizedThirdMomentLaw.integral_abs_sq_mul_abs_cdfUpperError_le
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B) :
    (∫ x, |x| ^ 2 * |cdfUpperError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) ≤
      ((∫ y, |y| ^ 3 ∂nu) +
        ∫ y, |y| ^ 3
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) / 3 := by
  letI : IsProbabilityMeasure nu := h.probability
  unfold cdfUpperError
  calc
    (∫ x, |x| ^ 2 * |cdf nu x - cdf
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) ≤
        (∫ y, |y| ^ 3 / 3 ∂nu) +
          ∫ y, |y| ^ 3 / 3
            ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw :=
      integral_abs_sq_mul_abs_cdf_sub_cdf_le _ _
        h.integrable_abs_cube integrable_standardNormal_abs_cube
    _ = ((∫ y, |y| ^ 3 ∂nu) +
        ∫ y, |y| ^ 3
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) / 3 := by
      rw [integral_div, integral_div]
      ring

/-- The same weighted control for the lower signed CDF error. -/
theorem IsStandardizedThirdMomentLaw.integral_abs_sq_mul_abs_cdfLowerError_le
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B) :
    (∫ x, |x| ^ 2 * |cdfLowerError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) ≤
      ((∫ y, |y| ^ 3 ∂nu) +
        ∫ y, |y| ^ 3
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) / 3 := by
  simpa only [cdfLowerError_eq_neg_upper, abs_neg] using
    h.integral_abs_sq_mul_abs_cdfUpperError_le

/-- Outside-radius `L¹` tail bound for the upper standardized signed CDF
error. -/
theorem IsStandardizedThirdMomentLaw.integral_abs_cdfUpperError_restrict_abs_ge_le
    {nu : Measure ℝ} {B R : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (hR : 0 < R) :
    (∫ x in {x : ℝ | R ≤ |x|}, |cdfUpperError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) ≤
      (R ^ 2)⁻¹ * (((∫ y, |y| ^ 3 ∂nu) +
        ∫ y, |y| ^ 3
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) / 3) := by
  letI : IsProbabilityMeasure nu := h.probability
  have hmeas : Measurable (cdfUpperError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) :=
    (monotone_cdf nu).measurable.sub
      (monotone_cdf
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw).measurable
  have hweighted : Integrable (fun x => |x| ^ 2 * |cdfUpperError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) := by
    unfold cdfUpperError
    exact integrable_abs_sq_mul_abs_cdf_sub_cdf _ _
      h.integrable_abs_cube integrable_standardNormal_abs_cube
  calc
    (∫ x in {x : ℝ | R ≤ |x|}, |cdfUpperError nu
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) ≤
        (R ^ 2)⁻¹ * ∫ x, |x| ^ 2 * |cdfUpperError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| :=
      integral_abs_restrict_abs_ge_le_inv_sq_mul _ hmeas hweighted hR
    _ ≤ (R ^ 2)⁻¹ * (((∫ y, |y| ^ 3 ∂nu) +
        ∫ y, |y| ^ 3
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) / 3) :=
      mul_le_mul_of_nonneg_left h.integral_abs_sq_mul_abs_cdfUpperError_le
        (inv_nonneg.mpr (sq_nonneg R))

/-- Outside-radius companion for the lower standardized signed CDF error. -/
theorem IsStandardizedThirdMomentLaw.integral_abs_cdfLowerError_restrict_abs_ge_le
    {nu : Measure ℝ} {B R : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (hR : 0 < R) :
    (∫ x in {x : ℝ | R ≤ |x|}, |cdfLowerError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) ≤
      (R ^ 2)⁻¹ * (((∫ y, |y| ^ 3 ∂nu) +
        ∫ y, |y| ^ 3
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) / 3) := by
  simpa only [cdfLowerError_eq_neg_upper, abs_neg] using
    h.integral_abs_cdfUpperError_restrict_abs_ge_le hR

/-- Combined central/tail `L¹` estimate for the upper standardized signed
CDF error. -/
theorem IsStandardizedThirdMomentLaw.integral_abs_cdfUpperError_le_central_tail
    {nu : Measure ℝ} {B R : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (hR : 0 < R) :
    (∫ x, |cdfUpperError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) ≤
      2 * R * kolmogorovDistance nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
        (R ^ 2)⁻¹ * (((∫ y, |y| ^ 3 ∂nu) +
          ∫ y, |y| ^ 3
            ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) / 3) := by
  letI : IsProbabilityMeasure nu := h.probability
  let s : Set ℝ := {x : ℝ | |x| < R}
  have hs : MeasurableSet s :=
    measurableSet_lt continuous_abs.measurable measurable_const
  have hcompl : sᶜ = {x : ℝ | R ≤ |x|} := by
    ext x
    simp only [s, mem_compl_iff, mem_setOf_eq]
    exact not_lt
  have hnuAbs : Integrable (fun y : ℝ => |y|) nu := by
    simpa only [Real.norm_eq_abs] using h.integrable_id.norm
  have hgaussAbs : Integrable (fun y : ℝ => |y|)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
    simpa only [Real.norm_eq_abs] using integrable_standardNormal_id.norm
  have herr : Integrable (fun x => |cdfUpperError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) := by
    unfold cdfUpperError
    simpa only [Real.norm_eq_abs] using
      (integrable_cdf_sub_cdf_of_firstMoments _ _ hnuAbs hgaussAbs).norm
  calc
    (∫ x, |cdfUpperError nu
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) =
        (∫ x in s, |cdfUpperError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) +
        ∫ x in sᶜ, |cdfUpperError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| :=
      (integral_add_compl hs herr).symm
    _ = (∫ x in {x : ℝ | |x| < R}, |cdfUpperError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) +
        ∫ x in {x : ℝ | R ≤ |x|}, |cdfUpperError nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| := by
      rw [hcompl]
    _ ≤ 2 * R * kolmogorovDistance nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
        (R ^ 2)⁻¹ * (((∫ y, |y| ^ 3 ∂nu) +
          ∫ y, |y| ^ 3
            ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) / 3) :=
      add_le_add
        (integral_abs_cdfUpperError_restrict_abs_lt_le _ _ hR.le)
        (h.integral_abs_cdfUpperError_restrict_abs_ge_le hR)

/-- Combined central/tail companion for the lower standardized signed CDF
error. -/
theorem IsStandardizedThirdMomentLaw.integral_abs_cdfLowerError_le_central_tail
    {nu : Measure ℝ} {B R : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (hR : 0 < R) :
    (∫ x, |cdfLowerError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x|) ≤
      2 * R * kolmogorovDistance nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
        (R ^ 2)⁻¹ * (((∫ y, |y| ^ 3 ∂nu) +
          ∫ y, |y| ^ 3
            ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) / 3) := by
  simpa only [cdfLowerError_eq_neg_upper, abs_neg] using
    h.integral_abs_cdfUpperError_le_central_tail hR

/-- Away from frequency zero, the normalized Fourier transform of a centered
probability CDF is its characteristic-function increment divided by `2πwi`. -/
theorem fourier_centeredCDF
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {w : ℝ} (hw : w ≠ 0) :
    𝓕 (fun x : ℝ => (centeredCDF mu x : ℂ)) w =
      (MeasureTheory.charFun mu (-2 * Real.pi * w) - 1) /
        (((2 * Real.pi * w : ℝ) : ℂ) * Complex.I) := by
  rw [Real.fourier_real_eq_integral_exp_smul]
  change (∫ x, normalizedFourierPhase w x * (centeredCDF mu x : ℂ)) = _
  have hcenter (x : ℝ) :
      (centeredCDF mu x : ℂ) = ∫ y, (centeredCDFKernel y x : ℂ) ∂mu := by
    rw [centeredCDF_eq_integral_kernel]
    exact (integral_complex_ofReal (μ := mu)
      (f := fun y => centeredCDFKernel y x)).symm
  have hmul (x : ℝ) :
      normalizedFourierPhase w x *
          (∫ y, (centeredCDFKernel y x : ℂ) ∂mu) =
        ∫ y, normalizedFourierPhase w x * (centeredCDFKernel y x : ℂ) ∂mu := by
    exact (integral_const_mul (μ := mu) (normalizedFourierPhase w x)
      (fun y => (centeredCDFKernel y x : ℂ))).symm
  simp_rw [hcenter, hmul]
  have hprod :=
    integrable_prod_normalizedFourierPhase_mul_centeredCDFKernel mu hmu1 w
  have hswap : Integrable
      (Function.uncurry (fun x y : ℝ => normalizedFourierPhase w x *
        (centeredCDFKernel y x : ℂ))) (volume.prod mu) := by
    simpa only [Function.uncurry_apply_pair, Function.comp_apply] using hprod.swap
  rw [integral_integral_swap hswap]
  simp_rw [integral_normalizedFourierPhase_mul_centeredCDFKernel hw]
  have hphaseInt : Integrable (normalizedFourierPhase w) mu := by
    have hone : Integrable (fun _ : ℝ => (1 : ℂ)) mu := integrable_const (1 : ℂ)
    simpa only [mul_one] using hone.bdd_mul (c := 1)
      (continuous_normalizedFourierPhase w).aestronglyMeasurable
      (ae_of_all mu fun x => by
        change ‖Complex.exp (((-2 * Real.pi * x * w : ℝ) : ℂ) * Complex.I)‖ ≤ 1
        rw [Complex.norm_exp_ofReal_mul_I])
  have hchar :
      (∫ y, normalizedFourierPhase w y ∂mu) =
        MeasureTheory.charFun mu (-2 * Real.pi * w) := by
    rw [MeasureTheory.charFun_apply_real]
    apply integral_congr_ae
    exact ae_of_all mu fun y => by
      simp only [normalizedFourierPhase]
      congr 1
      push_cast
      ring
  let d : ℂ := (((2 * Real.pi * w : ℝ) : ℂ) * Complex.I)
  calc
    (∫ y, (normalizedFourierPhase w y - 1) / d ∂mu) =
        (∫ y, normalizedFourierPhase w y - 1 ∂mu) / d :=
      integral_div d (fun y => normalizedFourierPhase w y - 1)
    _ = ((∫ y, normalizedFourierPhase w y ∂mu) -
          ∫ _y : ℝ, (1 : ℂ) ∂mu) / d := by
      rw [integral_sub hphaseInt (integrable_const (1 : ℂ))]
    _ = (MeasureTheory.charFun mu (-2 * Real.pi * w) - 1) / d := by
      rw [hchar, integral_const, probReal_univ, one_smul]

/-- The normalized Fourier phase preserves integrability of a centered CDF. -/
theorem integrable_normalizedFourierPhase_mul_centeredCDF
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu) (w : ℝ) :
    Integrable (fun x => normalizedFourierPhase w x *
      (centeredCDF mu x : ℂ)) := by
  apply (integrable_centeredCDF mu hmu1).ofReal.bdd_mul (c := 1)
  · exact (continuous_normalizedFourierPhase w).aestronglyMeasurable
  · exact ae_of_all volume fun x => by
      change ‖Complex.exp (((-2 * Real.pi * x * w : ℝ) : ℂ) * Complex.I)‖ ≤ 1
      rw [Complex.norm_exp_ofReal_mul_I]

/-- Subtracting two centered-CDF identities cancels the common Dirac term and
gives the Fourier transform of the ordinary CDF difference. -/
theorem fourier_cdf_sub_cdf
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {w : ℝ} (hw : w ≠ 0) :
    𝓕 (fun x : ℝ => ((cdf mu x - cdf nu x : ℝ) : ℂ)) w =
      (MeasureTheory.charFun mu (-2 * Real.pi * w) -
        MeasureTheory.charFun nu (-2 * Real.pi * w)) /
          (((2 * Real.pi * w : ℝ) : ℂ) * Complex.I) := by
  rw [Real.fourier_real_eq_integral_exp_smul]
  change (∫ x, normalizedFourierPhase w x *
    ((cdf mu x - cdf nu x : ℝ) : ℂ)) = _
  have hfun :
      (fun x : ℝ => normalizedFourierPhase w x *
        ((cdf mu x - cdf nu x : ℝ) : ℂ)) =
        (fun x : ℝ => normalizedFourierPhase w x *
          (centeredCDF mu x : ℂ) - normalizedFourierPhase w x *
            (centeredCDF nu x : ℂ)) := by
    funext x
    simp only [centeredCDF]
    push_cast
    ring
  rw [hfun]
  rw [integral_sub
    (integrable_normalizedFourierPhase_mul_centeredCDF mu hmu1 w)
    (integrable_normalizedFourierPhase_mul_centeredCDF nu hnu1 w)]
  have hmuFormula :
      (∫ x, normalizedFourierPhase w x * (centeredCDF mu x : ℂ)) =
        (MeasureTheory.charFun mu (-2 * Real.pi * w) - 1) /
          (((2 * Real.pi * w : ℝ) : ℂ) * Complex.I) := by
    simpa only [Real.fourier_real_eq_integral_exp_smul, smul_eq_mul,
      normalizedFourierPhase] using fourier_centeredCDF mu hmu1 hw
  have hnuFormula :
      (∫ x, normalizedFourierPhase w x * (centeredCDF nu x : ℂ)) =
        (MeasureTheory.charFun nu (-2 * Real.pi * w) - 1) /
          (((2 * Real.pi * w : ℝ) : ℂ) * Complex.I) := by
    simpa only [Real.fourier_real_eq_integral_exp_smul, smul_eq_mul,
      normalizedFourierPhase] using fourier_centeredCDF nu hnu1 hw
  rw [hmuFormula, hnuFormula]
  have hd : (((2 * Real.pi * w : ℝ) : ℂ) * Complex.I) ≠ 0 := by
    apply mul_ne_zero
    · exact Complex.ofReal_ne_zero.mpr
        (mul_ne_zero (mul_ne_zero (by norm_num) Real.pi_ne_zero) hw)
    · exact Complex.I_ne_zero
  field_simp [hd]
  ring

/-- The norm of the transformed CDF difference is exactly the characteristic-
function discrepancy quotient at the normalized frequency. -/
theorem norm_fourier_cdf_sub_cdf_eq_charFunDiscrepancyQuotient
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {w : ℝ} (hw : w ≠ 0) :
    ‖𝓕 (fun x : ℝ => ((cdf mu x - cdf nu x : ℝ) : ℂ)) w‖ =
      charFunDiscrepancyQuotient mu nu (-2 * Real.pi * w) := by
  have ht : -2 * Real.pi * w ≠ 0 :=
    mul_ne_zero (mul_ne_zero (by norm_num) Real.pi_ne_zero) hw
  rw [fourier_cdf_sub_cdf mu nu hmu1 hnu1 hw,
    charFunDiscrepancyQuotient, if_neg ht, norm_div, norm_mul,
    Complex.norm_real, Complex.norm_I, mul_one, Real.norm_eq_abs]
  congr 1
  rw [show -2 * Real.pi * w = -(2 * Real.pi * w) by ring, abs_neg]

/-- Any globally integrable characteristic-function discrepancy quotient makes
the Fourier transform of the corresponding CDF difference integrable. -/
theorem integrable_fourier_cdf_sub_cdf_of_integrable_discrepancy
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    (hquot : Integrable (charFunDiscrepancyQuotient mu nu)) :
    Integrable (𝓕 (fun x : ℝ => ((cdf mu x - cdf nu x : ℝ) : ℂ))) := by
  let f : ℝ → ℂ := fun x => ((cdf mu x - cdf nu x : ℝ) : ℂ)
  have hf : Integrable f :=
    (integrable_cdf_sub_cdf_of_firstMoments mu nu hmu1 hnu1).ofReal
  have hFourierCont : Continuous (𝓕 f) := by
    exact VectorFourier.fourierIntegral_continuous
      Real.continuous_fourierChar continuous_inner hf
  have hscale : Integrable (fun w : ℝ =>
      charFunDiscrepancyQuotient mu nu ((-2 * Real.pi) * w)) :=
    hquot.comp_mul_left' (mul_ne_zero (by norm_num) Real.pi_ne_zero)
  have hnorm : Integrable (fun w : ℝ => ‖𝓕 f w‖) := by
    apply hscale.congr
    filter_upwards [volume.ae_ne (0 : ℝ)] with w hw
    dsimp only [f]
    convert (norm_fourier_cdf_sub_cdf_eq_charFunDiscrepancyQuotient
      mu nu hmu1 hnu1 hw).symm using 1
  exact (integrable_norm_iff hFourierCont.aestronglyMeasurable).mp hnorm

/-- Convolution by a common probability smoothing measure cannot increase
the pointwise characteristic-function discrepancy. -/
theorem norm_charFun_conv_sub_charFun_conv_le
    (μ ν κ : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] [IsProbabilityMeasure κ] (t : ℝ) :
    ‖MeasureTheory.charFun (κ ∗ μ) t -
        MeasureTheory.charFun (κ ∗ ν) t‖ ≤
      ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ := by
  rw [MeasureTheory.charFun_conv, MeasureTheory.charFun_conv, ← mul_sub,
    norm_mul]
  calc
    ‖MeasureTheory.charFun κ t‖ *
        ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ ≤
        1 * ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ :=
      mul_le_mul_of_nonneg_right (MeasureTheory.norm_charFun_le_one t)
        (norm_nonneg _)
    _ = _ := one_mul _

/-- Exact characteristic-function damping supplied by the normalized uniform
kernel. -/
theorem norm_charFun_uniformSmoothingKernel_conv_sub
    (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] {δ : ℝ} (hδ : 0 < δ) (t : ℝ) :
    ‖MeasureTheory.charFun (uniformSmoothingKernel δ ∗ μ) t -
        MeasureTheory.charFun (uniformSmoothingKernel δ ∗ ν) t‖ =
      |Real.sinc (t * δ)| *
        ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel δ) :=
    uniformSmoothingKernel_isProbabilityMeasure hδ
  rw [MeasureTheory.charFun_conv, MeasureTheory.charFun_conv,
    charFun_uniformSmoothingKernel hδ, ← mul_sub, norm_mul]
  simp only [Complex.norm_real, Real.norm_eq_abs]

/-- Away from the origin, uniform smoothing upgrades the discrepancy quotient
to inverse-square decay. -/
theorem charFunDiscrepancyQuotient_uniformSmoothingKernel_conv_le
    (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] {δ : ℝ} (hδ : 0 < δ)
    {t : ℝ} (ht : t ≠ 0) :
    charFunDiscrepancyQuotient
        (uniformSmoothingKernel δ ∗ μ) (uniformSmoothingKernel δ ∗ ν) t ≤
      2 * δ⁻¹ * (|t| ^ 2)⁻¹ := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel δ) :=
    uniformSmoothingKernel_isProbabilityMeasure hδ
  rw [charFunDiscrepancyQuotient, if_neg ht,
    norm_charFun_uniformSmoothingKernel_conv_sub μ ν hδ]
  have htd : t * δ ≠ 0 := mul_ne_zero ht hδ.ne'
  have hsinc := abs_sinc_le_inv_abs htd
  have hdiff :
      ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ ≤ 2 := by
    calc
      ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ ≤
          ‖MeasureTheory.charFun μ t‖ + ‖MeasureTheory.charFun ν t‖ :=
        norm_sub_le _ _
      _ ≤ 1 + 1 := add_le_add
        (MeasureTheory.norm_charFun_le_one t)
        (MeasureTheory.norm_charFun_le_one t)
      _ = 2 := by norm_num
  calc
    |Real.sinc (t * δ)| *
          ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ / |t| ≤
        |t * δ|⁻¹ * 2 / |t| := by
      exact div_le_div_of_nonneg_right
        (mul_le_mul hsinc hdiff (norm_nonneg _)
          (inv_nonneg.mpr (abs_nonneg _))) (abs_nonneg t)
    _ = 2 * δ⁻¹ * (|t| ^ 2)⁻¹ := by
      rw [abs_mul, abs_of_pos hδ]
      field_simp [abs_ne_zero.mpr ht, hδ.ne']

theorem charFunDiscrepancyQuotient_conv_le
    (μ ν κ : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] [IsProbabilityMeasure κ] (t : ℝ) :
    charFunDiscrepancyQuotient (κ ∗ μ) (κ ∗ ν) t ≤
      charFunDiscrepancyQuotient μ ν t := by
  unfold charFunDiscrepancyQuotient
  split_ifs with ht
  · exact le_rfl
  · exact div_le_div_of_nonneg_right
      (norm_charFun_conv_sub_charFun_conv_le μ ν κ t) (abs_nonneg t)

/-- Uniform convolution makes the characteristic-function discrepancy
quotient globally integrable: first moments control the removable singularity
and the sinc multiplier supplies inverse-square decay at infinity. -/
theorem integrable_charFunDiscrepancyQuotient_uniformSmoothingKernel_conv
    {μ ν : Measure ℝ} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμ1 : Integrable (fun x : ℝ => |x|) μ)
    (hν1 : Integrable (fun x : ℝ => |x|) ν)
    {δ : ℝ} (hδ : 0 < δ) :
    Integrable (charFunDiscrepancyQuotient
      (uniformSmoothingKernel δ ∗ μ) (uniformSmoothingKernel δ ∗ ν)) volume := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel δ) :=
    uniformSmoothingKernel_isProbabilityMeasure hδ
  let M : ℝ := (∫ x, |x| ∂μ) + ∫ x, |x| ∂ν
  let C : ℝ := 2 * M + 4 * δ⁻¹
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact add_nonneg (integral_nonneg fun _ => abs_nonneg _)
      (integral_nonneg fun _ => abs_nonneg _)
  have hδinv : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδ.le
  have hC : 0 ≤ C := by
    dsimp only [C]
    positivity
  have hMajorant : Integrable (fun t : ℝ => C * (1 + t ^ 2)⁻¹) volume :=
    integrable_inv_one_add_sq.const_mul C
  refine hMajorant.mono'
    (stronglyMeasurable_charFunDiscrepancyQuotient
      (uniformSmoothingKernel δ ∗ μ) (uniformSmoothingKernel δ ∗ ν)).aestronglyMeasurable
    (ae_of_all volume fun t => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg
    (charFunDiscrepancyQuotient_nonneg _ _ t)]
  have hlocal :
      charFunDiscrepancyQuotient
          (uniformSmoothingKernel δ ∗ μ) (uniformSmoothingKernel δ ∗ ν) t ≤ M :=
    (charFunDiscrepancyQuotient_conv_le μ ν (uniformSmoothingKernel δ) t).trans <| by
      simpa only [M] using charFunDiscrepancyQuotient_le_firstMoments hμ1 hν1 t
  have hden : 0 < 1 + t ^ 2 := by positivity
  by_cases htSmall : |t| ≤ 1
  · have htSq : t ^ 2 ≤ 1 := by
      have hsq : |t| ^ 2 ≤ 1 := by
        nlinarith [mul_nonneg (abs_nonneg t) (sub_nonneg.mpr htSmall)]
      simpa only [sq_abs] using hsq
    have hMmajor : M ≤ (2 * M) * (1 + t ^ 2)⁻¹ := by
      rw [← div_eq_mul_inv, le_div_iff₀ hden]
      nlinarith [mul_nonneg hM (sub_nonneg.mpr htSq)]
    calc
      charFunDiscrepancyQuotient
          (uniformSmoothingKernel δ ∗ μ) (uniformSmoothingKernel δ ∗ ν) t ≤ M := hlocal
      _ ≤ (2 * M) * (1 + t ^ 2)⁻¹ := hMmajor
      _ ≤ C * (1 + t ^ 2)⁻¹ := by
        apply mul_le_mul_of_nonneg_right _ (inv_nonneg.mpr hden.le)
        dsimp only [C]
        nlinarith
  · have htLarge : 1 < |t| := lt_of_not_ge htSmall
    have ht : t ≠ 0 := by
      intro ht0
      subst t
      norm_num at htLarge
    have habsSq : 0 < |t| ^ 2 := sq_pos_of_pos (abs_pos.mpr ht)
    have hdenle : 1 + t ^ 2 ≤ 2 * (|t| ^ 2) := by
      have hone : 1 ≤ |t| := htLarge.le
      have hsquare : 1 ≤ |t| ^ 2 := by
        nlinarith [mul_nonneg (abs_nonneg t) (sub_nonneg.mpr hone)]
      rw [sq_abs] at hsquare ⊢
      nlinarith
    have htail :=
      charFunDiscrepancyQuotient_uniformSmoothingKernel_conv_le μ ν hδ ht
    have htailMajor :
        2 * δ⁻¹ * (|t| ^ 2)⁻¹ ≤
          (4 * δ⁻¹) * (1 + t ^ 2)⁻¹ := by
      change (2 * δ⁻¹) / (|t| ^ 2) ≤
        (4 * δ⁻¹) / (1 + t ^ 2)
      rw [div_le_div_iff₀ habsSq hden]
      calc
        (2 * δ⁻¹) * (1 + t ^ 2) ≤
            (2 * δ⁻¹) * (2 * |t| ^ 2) :=
          mul_le_mul_of_nonneg_left hdenle
            (mul_nonneg (by norm_num) hδinv)
        _ = (4 * δ⁻¹) * |t| ^ 2 := by ring
    calc
      charFunDiscrepancyQuotient
          (uniformSmoothingKernel δ ∗ μ) (uniformSmoothingKernel δ ∗ ν) t ≤
          2 * δ⁻¹ * (|t| ^ 2)⁻¹ := htail
      _ ≤ (4 * δ⁻¹) * (1 + t ^ 2)⁻¹ := htailMajor
      _ ≤ C * (1 + t ^ 2)⁻¹ := by
        apply mul_le_mul_of_nonneg_right _ (inv_nonneg.mpr hden.le)
        dsimp only [C]
        nlinarith

/-- A pointwise Fourier-inversion estimate in Mathlib's normalized Fourier
convention.  It packages the analytic conclusion needed after identifying the
Fourier transform of a smoothed CDF difference. -/
theorem norm_le_integral_norm_fourier
    (f : ℝ → ℂ) (hf : Integrable f) (hFourier : Integrable (𝓕 f))
    {x : ℝ} (hcont : ContinuousAt f x) :
    ‖f x‖ ≤ ∫ t : ℝ, ‖𝓕 f t‖ := by
  rw [← hf.fourierInv_fourier_eq hFourier hcont, Real.fourierInv_eq]
  exact (norm_integral_le_integral_norm
    (μ := volume) (fun t : ℝ => 𝐞 (inner ℝ t x) • (𝓕 f) t)).trans_eq <| by
      apply integral_congr_ae
      exact ae_of_all volume fun t => Circle.norm_smul _ _

/-- Fourier inversion bounds the pointwise CDF gap between two uniformly
smoothed laws by the globally integrable, normalized characteristic-function
discrepancy quotient. -/
theorem cdfGap_uniformSmoothingKernel_conv_le_integral_discrepancy
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun x : ℝ => |x|) mu)
    (hnu1 : Integrable (fun x : ℝ => |x|) nu)
    {delta : ℝ} (hdelta : 0 < delta) (x : ℝ) :
    cdfGap (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗ nu) x ≤
      ∫ w : ℝ, charFunDiscrepancyQuotient
        (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗ nu) ((-2 * Real.pi) * w) := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel delta) :=
    uniformSmoothingKernel_isProbabilityMeasure hdelta
  have hkappa1 := integrable_abs_uniformSmoothingKernel hdelta
  have hmuConv1 := integrable_abs_conv_of_firstMoments
    (uniformSmoothingKernel delta) mu hkappa1 hmu1
  have hnuConv1 := integrable_abs_conv_of_firstMoments
    (uniformSmoothingKernel delta) nu hkappa1 hnu1
  let f : ℝ → ℂ := fun y =>
    ((cdf (uniformSmoothingKernel delta ∗ mu) y -
      cdf (uniformSmoothingKernel delta ∗ nu) y : ℝ) : ℂ)
  have hf : Integrable f :=
    (integrable_cdf_uniformSmoothingKernel_conv_sub mu nu hmu1 hnu1 hdelta).ofReal
  have hquot :=
    integrable_charFunDiscrepancyQuotient_uniformSmoothingKernel_conv
      hmu1 hnu1 hdelta
  have hFourier : Integrable (𝓕 f) := by
    exact integrable_fourier_cdf_sub_cdf_of_integrable_discrepancy
      (uniformSmoothingKernel delta ∗ mu)
      (uniformSmoothingKernel delta ∗ nu) hmuConv1 hnuConv1 hquot
  have hcont : Continuous f := by
    apply Complex.continuous_ofReal.comp
    exact (continuous_cdf_uniformSmoothingKernel_conv mu hdelta).sub
      (continuous_cdf_uniformSmoothingKernel_conv nu hdelta)
  have hinv : ‖f x‖ ≤ ∫ w : ℝ, ‖𝓕 f w‖ :=
    norm_le_integral_norm_fourier f hf hFourier (x := x) hcont.continuousAt
  calc
    cdfGap (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗ nu) x = ‖f x‖ := by
      simp only [cdfGap, f, Complex.norm_real, Real.norm_eq_abs]
    _ ≤ ∫ w : ℝ, ‖𝓕 f w‖ := hinv
    _ = ∫ w : ℝ, charFunDiscrepancyQuotient
        (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗ nu) ((-2 * Real.pi) * w) := by
      apply integral_congr_ae
      filter_upwards [volume.ae_ne (0 : ℝ)] with w hw
      dsimp only [f]
      convert norm_fourier_cdf_sub_cdf_eq_charFunDiscrepancyQuotient
        (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗ nu) hmuConv1 hnuConv1 hw using 1

/-- The same inversion estimate after the exact `-2π` change of variables. -/
theorem cdfGap_uniformSmoothingKernel_conv_le_integral_discrepancy_scaled
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun x : ℝ => |x|) mu)
    (hnu1 : Integrable (fun x : ℝ => |x|) nu)
    {delta : ℝ} (hdelta : 0 < delta) (x : ℝ) :
    cdfGap (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗ nu) x ≤
      (2 * Real.pi)⁻¹ * ∫ t : ℝ, charFunDiscrepancyQuotient
        (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗ nu) t := by
  calc
    cdfGap (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗ nu) x ≤
      ∫ w : ℝ, charFunDiscrepancyQuotient
        (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗ nu) ((-2 * Real.pi) * w) :=
      cdfGap_uniformSmoothingKernel_conv_le_integral_discrepancy
        mu nu hmu1 hnu1 hdelta x
    _ = (2 * Real.pi)⁻¹ * ∫ t : ℝ, charFunDiscrepancyQuotient
        (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗ nu) t := by
      rw [Measure.integral_comp_mul_left]
      have hpi : 0 < 2 * Real.pi := mul_pos (by norm_num) Real.pi_pos
      rw [show |(-2 * Real.pi)⁻¹| = (2 * Real.pi)⁻¹ by
        rw [abs_inv, show -2 * Real.pi = -(2 * Real.pi) by ring,
          abs_neg, abs_of_pos hpi]]
      rfl

/-- Uniform comparison of two smoothed CDFs gives a shifted sandwich for the
underlying CDFs.  This is the deterministic interface between a compact
smoothing kernel and the Fourier estimate of the smoothed functions. -/
theorem cdf_shift_bounds_of_smoothing_approximation
    (μ ν : Measure ℝ) {Hμ Hν : ℝ → ℝ} {δ ε : ℝ}
    (hμ : CDFSmoothingApproximation μ Hμ δ)
    (hν : CDFSmoothingApproximation ν Hν δ)
    (hdiff : ∀ x, |Hμ x - Hν x| ≤ ε) :
    (∀ x, cdf ν (x - 2 * δ) - ε ≤ cdf μ x) ∧
      (∀ x, cdf μ x ≤ cdf ν (x + 2 * δ) + ε) := by
  constructor
  · intro x
    have hνLeft := (hν (x - δ)).1
    have hμRight := (hμ (x - δ)).2
    have hcompare := (abs_le.mp (hdiff (x - δ))).1
    have hνLeft' : cdf ν (x - 2 * δ) ≤ Hν (x - δ) := by
      convert hνLeft using 1; ring
    have hμRight' : Hμ (x - δ) ≤ cdf μ x := by
      convert hμRight using 1; ring
    linarith
  · intro x
    have hμLeft := (hμ (x + δ)).1
    have hνRight := (hν (x + δ)).2
    have hcompare := (abs_le.mp (hdiff (x + δ))).2
    have hμLeft' : cdf μ x ≤ Hμ (x + δ) := by
      convert hμLeft using 1; ring
    have hνRight' : Hν (x + δ) ≤ cdf ν (x + 2 * δ) := by
      convert hνRight using 1; ring
    linarith

/-- Standard-normal Kolmogorov consequence of comparing two smoothed CDFs.
The remaining Berry--Esseen Fourier step can therefore target only the
uniform error `ε` between the smoothed functions. -/
theorem kolmogorovDistance_standardNormal_le_of_smoothing_approximation
    (μ : Measure ℝ) {Hμ Hγ : ℝ → ℝ} {δ ε : ℝ} (hδ : 0 ≤ δ)
    (hμ : CDFSmoothingApproximation μ Hμ δ)
    (hγ : CDFSmoothingApproximation
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw Hγ δ)
    (hdiff : ∀ x, |Hμ x - Hγ x| ≤ ε) :
    kolmogorovDistance μ
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      ε + (Real.sqrt (2 * Real.pi))⁻¹ * (2 * δ) := by
  rcases cdf_shift_bounds_of_smoothing_approximation
      μ NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      hμ hγ hdiff with ⟨hlower, hupper⟩
  exact kolmogorovDistance_standardNormal_le_of_shift_bounds μ
    (mul_nonneg (by norm_num) hδ) hlower hupper

/-- The Chapter 1 standard-normal law has a finite first absolute moment. -/
theorem integrable_abs_standardNormalLaw :
    Integrable (fun x : ℝ => |x|)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  have hid : Integrable (fun x : ℝ => x)
      (ProbabilityTheory.gaussianReal 0 1) := by
    apply ProbabilityTheory.integrable_of_mem_interior_integrableExpSet
    simp
  simpa only [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw,
    Real.norm_eq_abs] using hid.norm

/-- Exact first absolute moment of the standard normal law. -/
theorem integral_standardNormal_abs :
    (∫ x : ℝ, |x|
      ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) =
      2 * (Real.sqrt (2 * Real.pi))⁻¹ := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw,
    integral_gaussianReal_eq_integral_smul (by norm_num : (1 : ℝ≥0) ≠ 0)]
  simp only [smul_eq_mul,
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_pdf]
  rw [show (fun x : ℝ =>
      (Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-(x ^ 2) / 2) * |x|) =
      fun x => (Real.sqrt (2 * Real.pi))⁻¹ *
        (|x| * Real.exp (-(x ^ 2) / 2)) by
      funext x; ring,
    integral_const_mul]
  have hEven :
      (∫ x : ℝ, |x| * Real.exp (-(x ^ 2) / 2)) =
        2 * ∫ x in Ioi (0 : ℝ), x * Real.exp (-(x ^ 2) / 2) := by
    calc
      (∫ x : ℝ, |x| * Real.exp (-(x ^ 2) / 2)) =
          ∫ x : ℝ, (fun z : ℝ => z * Real.exp (-(z ^ 2) / 2)) |x| := by
        apply integral_congr_ae
        filter_upwards [] with x
        rw [sq_abs]
      _ = 2 * ∫ x in Ioi (0 : ℝ), x * Real.exp (-(x ^ 2) / 2) :=
        integral_comp_abs (f := fun z : ℝ => z * Real.exp (-(z ^ 2) / 2))
  rw [hEven,
    NumStability.HDP.Scalar.GaussianTails.integral_Ioi_mul_exp_neg_sq_div_two]
  simp
  ring

/-- Exact third absolute moment of the standard normal law. -/
theorem integral_standardNormal_abs_cube :
    (∫ x : ℝ, |x| ^ 3
      ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) =
      4 * (Real.sqrt (2 * Real.pi))⁻¹ := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw,
    integral_gaussianReal_eq_integral_smul (by norm_num : (1 : ℝ≥0) ≠ 0)]
  simp only [smul_eq_mul,
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_pdf]
  rw [show (fun x : ℝ =>
      (Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-(x ^ 2) / 2) * |x| ^ 3) =
      fun x => (Real.sqrt (2 * Real.pi))⁻¹ *
        (|x| ^ 3 * Real.exp (-(x ^ 2) / 2)) by
      funext x
      ring,
    integral_const_mul]
  have hHalf :
      (∫ x in Ioi (0 : ℝ), x ^ 3 * Real.exp (-(x ^ 2) / 2)) = 2 := by
    convert (integral_rpow_mul_exp_neg_mul_rpow
      (p := (2 : ℝ)) (q := (3 : ℝ)) (b := (1 / 2 : ℝ))
      (by norm_num) (by norm_num) (by norm_num)) using 1
    · apply setIntegral_congr_fun measurableSet_Ioi
      intro x hx
      simp only [Real.rpow_ofNat]
      congr 1
      ring
    · rw [show ((3 : ℝ) + 1) / 2 = 1 + 1 by norm_num,
        Real.Gamma_add_one one_ne_zero, Real.Gamma_one]
      norm_num
  have hEven :
      (∫ x : ℝ, |x| ^ 3 * Real.exp (-(x ^ 2) / 2)) =
        2 * ∫ x in Ioi (0 : ℝ), x ^ 3 * Real.exp (-(x ^ 2) / 2) := by
    calc
      (∫ x : ℝ, |x| ^ 3 * Real.exp (-(x ^ 2) / 2)) =
          ∫ x : ℝ, (fun z : ℝ => z ^ 3 * Real.exp (-(z ^ 2) / 2)) |x| := by
        apply integral_congr_ae
        filter_upwards [] with x
        rw [sq_abs]
      _ = 2 * ∫ x in Ioi (0 : ℝ), x ^ 3 * Real.exp (-(x ^ 2) / 2) :=
        integral_comp_abs (f := fun z : ℝ => z ^ 3 * Real.exp (-(z ^ 2) / 2))
  rw [hEven, hHalf]
  ring

/-- The real Fourier transform of the unnormalized standard Gaussian. -/
theorem integral_rexp_neg_sq_div_two_mul_cos (x : ℝ) :
    (∫ t : ℝ, Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)) =
      Real.sqrt (2 * Real.pi) * Real.exp (-(x ^ 2) / 2) := by
  let h : ℝ → ℂ := fun t =>
    (ProbabilityTheory.gaussianPDFReal 0 1 t : ℂ) *
      Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I)
  have hh : Integrable h := by
    have hpdfCont : Continuous
        (ProbabilityTheory.gaussianPDFReal 0 1) := by
      rw [ProbabilityTheory.gaussianPDFReal_def]
      fun_prop
    have hcont : Continuous h :=
      (Complex.continuous_ofReal.comp hpdfCont).mul (by fun_prop)
    rw [← integrable_norm_iff hcont.aestronglyMeasurable]
    convert ProbabilityTheory.integrable_gaussianPDFReal 0 1 using 1
    funext t
    dsimp only [h]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (ProbabilityTheory.gaussianPDFReal_nonneg 0 1 t),
      Complex.norm_exp_ofReal_mul_I, mul_one]
  have hcf :=
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_charFun x
  rw [MeasureTheory.charFun_apply_real,
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw,
    ProbabilityTheory.integral_gaussianReal_eq_integral_smul
      (by norm_num : (1 : ℝ≥0) ≠ 0)] at hcf
  have hcf' : (∫ t : ℝ, h t) =
      Complex.exp (-(x : ℂ) ^ 2 / 2) := by
    simpa only [h, Complex.real_smul, Complex.ofReal_mul] using hcf
  have hreal := congrArg Complex.re hcf'
  have hreal' : (∫ t : ℝ, (h t).re) =
      (Complex.exp (-(x : ℂ) ^ 2 / 2)).re :=
    (integral_re hh).trans hreal
  have hrhs : (Complex.exp (-(x : ℂ) ^ 2 / 2)).re =
      Real.exp (-(x ^ 2) / 2) := by
    rw [show -(x : ℂ) ^ 2 / 2 = ((-(x ^ 2) / 2 : ℝ) : ℂ) by
      push_cast
      ring,
      Complex.exp_ofReal_re]
  have hnormalized :
      (∫ t : ℝ,
          (Real.sqrt (2 * Real.pi))⁻¹ *
            (Real.exp (-(t ^ 2) / 2) * Real.cos (x * t))) =
        Real.exp (-(x ^ 2) / 2) := by
    rw [hrhs] at hreal'
    calc
      (∫ t : ℝ, (Real.sqrt (2 * Real.pi))⁻¹ *
          (Real.exp (-(t ^ 2) / 2) * Real.cos (x * t))) =
          ∫ t : ℝ, ((Real.sqrt (2 * Real.pi))⁻¹ *
            Real.exp (-(t ^ 2) / 2)) * Real.cos (x * t) := by
        apply integral_congr_ae
        exact ae_of_all _ fun t => by ring
      _ = Real.exp (-(x ^ 2) / 2) := by
        simpa only [h, Complex.real_smul,
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_pdf,
          Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
          Complex.exp_ofReal_mul_I_re, zero_mul, sub_zero] using hreal'
  rw [integral_const_mul] at hnormalized
  have hR : 0 < Real.sqrt (2 * Real.pi) := by positivity
  calc
    (∫ t : ℝ, Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)) =
        Real.sqrt (2 * Real.pi) *
          ((Real.sqrt (2 * Real.pi))⁻¹ *
            ∫ t : ℝ, Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)) := by
      field_simp [hR.ne']
      apply integral_congr_ae
      exact ae_of_all _ fun t => by
        dsimp only
        rw [mul_comm t x]
    _ = Real.sqrt (2 * Real.pi) * Real.exp (-(x ^ 2) / 2) := by
      rw [hnormalized]

/-- The exact positive-frequency half of the Gaussian cosine transform. -/
theorem integral_Ioi_rexp_neg_sq_div_two_mul_cos (x : ℝ) :
    (∫ t in Ioi (0 : ℝ),
        Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)) =
      (Real.sqrt (2 * Real.pi) / 2) * Real.exp (-(x ^ 2) / 2) := by
  let f : ℝ → ℝ := fun t =>
    Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)
  have hEven : (∫ t : ℝ, f t) =
      2 * ∫ t in Ioi (0 : ℝ), f t := by
    calc
      (∫ t : ℝ, f t) = ∫ t : ℝ, f |t| := by
        apply integral_congr_ae
        exact ae_of_all _ fun t => by
          dsimp only [f]
          by_cases ht : 0 ≤ t
          · rw [abs_of_nonneg ht]
          · have ht' : t ≤ 0 := le_of_not_ge ht
            rw [abs_of_nonpos ht']
            rw [show (-t) ^ 2 = t ^ 2 by ring,
              show x * -t = -(x * t) by ring, Real.cos_neg]
      _ = 2 * ∫ t in Ioi (0 : ℝ), f t := integral_comp_abs
  have hfull := integral_rexp_neg_sq_div_two_mul_cos x
  change (∫ t in Ioi (0 : ℝ), f t) = _
  change (∫ t : ℝ, f t) = _ at hfull
  rw [hEven] at hfull
  linarith

/-- Exact first Gaussian moment on a finite positive frequency window. -/
theorem integral_Icc_mul_rexp_neg_sq_div_two
    {T : ℝ} (hT : 0 < T) :
    (∫ t in Icc (0 : ℝ) T, t * Real.exp (-(t ^ 2) / 2)) =
      1 - Real.exp (-(T ^ 2) / 2) := by
  let f : ℝ → ℝ := fun t => t * Real.exp (-(t ^ 2) / 2)
  have hf : Integrable f := by
    have h := integrable_mul_exp_neg_mul_sq
      (by norm_num : (0 : ℝ) < 1 / 2)
    apply h.congr
    exact ae_of_all _ fun t => by
      dsimp only [f]
      congr 1
      ring
  have hsubset : Ici T ⊆ Ioi (0 : ℝ) := by
    intro t ht
    exact lt_of_lt_of_le hT ht
  have hdiff := integral_diff measurableSet_Ici hf.integrableOn hsubset
  have hset : Ioi (0 : ℝ) \ Ici T = Ioo (0 : ℝ) T := by
    ext t
    simp only [mem_diff, mem_Ioi, mem_Ici, mem_Ioo]
    constructor
    · intro ht
      exact ⟨ht.1, lt_of_not_ge ht.2⟩
    · intro ht
      exact ⟨ht.1, not_le.mpr ht.2⟩
  rw [hset, integral_Ici_eq_integral_Ioi] at hdiff
  rw [integral_Icc_eq_integral_Ioo, hdiff]
  rw [show (∫ t in Ioi (0 : ℝ), f t) = 1 by
    have h0 :=
      NumStability.HDP.Scalar.GaussianTails.integral_Ioi_mul_exp_neg_sq_div_two 0
    have hzeroArg : -((0 : ℝ) ^ 2) / 2 = 0 := by norm_num
    rw [hzeroArg, Real.exp_zero] at h0
    simpa only [f] using h0,
    show (∫ t in Ioi T, f t) = Real.exp (-(T ^ 2) / 2) by
      simpa only [f] using
        NumStability.HDP.Scalar.GaussianTails.integral_Ioi_mul_exp_neg_sq_div_two T]

