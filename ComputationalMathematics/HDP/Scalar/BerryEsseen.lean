namespace NumStability.HDP.Scalar.BerryEsseen

/-- The pointwise gap between the cumulative distribution functions of two
real measures. -/
noncomputable def cdfGap (μ ν : Measure ℝ) (x : ℝ) : ℝ :=
  |cdf μ x - cdf ν x|

/-- Signed upper CDF error.  Unlike `cdfGap`, this keeps cancellations under
averaging and convolution. -/
noncomputable def cdfUpperError (mu nu : Measure ℝ) (x : ℝ) : ℝ :=
  cdf mu x - cdf nu x

/-- Signed lower CDF error. -/
noncomputable def cdfLowerError (mu nu : Measure ℝ) (x : ℝ) : ℝ :=
  cdf nu x - cdf mu x

theorem cdfLowerError_eq_upper_swap (mu nu : Measure ℝ) (x : ℝ) :
    cdfLowerError mu nu x = cdfUpperError nu mu x := rfl

theorem cdfLowerError_eq_neg_upper (mu nu : Measure ℝ) (x : ℝ) :
    cdfLowerError mu nu x = -cdfUpperError mu nu x := by
  unfold cdfLowerError cdfUpperError
  ring

theorem abs_cdfLowerError_eq_abs_cdfUpperError
    (mu nu : Measure ℝ) (x : ℝ) :
    |cdfLowerError mu nu x| = |cdfUpperError mu nu x| := by
  rw [cdfLowerError_eq_neg_upper, abs_neg]

/-- Algebraic telescoping of a signed CDF error through an intermediate
convolution law. -/
theorem cdfUpperError_conv_telescope
    (mu nu kappa lambda : Measure ℝ) (x : ℝ) :
    cdfUpperError (kappa ∗ mu) (lambda ∗ nu) x =
      cdfUpperError (kappa ∗ mu) (kappa ∗ nu) x +
        cdfUpperError (kappa ∗ nu) (lambda ∗ nu) x := by
  unfold cdfUpperError
  ring

/-- Algebraic telescoping of a signed lower CDF error through an intermediate
convolution law. -/
theorem cdfLowerError_conv_telescope
    (mu nu kappa lambda : Measure ℝ) (x : ℝ) :
    cdfLowerError (kappa ∗ mu) (lambda ∗ nu) x =
      cdfLowerError (kappa ∗ mu) (kappa ∗ nu) x +
        cdfLowerError (kappa ∗ nu) (lambda ∗ nu) x := by
  unfold cdfLowerError
  ring

/-- Kolmogorov distance, presented as the supremum of pointwise CDF gaps. -/
noncomputable def kolmogorovDistance (μ ν : Measure ℝ) : ℝ :=
  sSup (Set.range (cdfGap μ ν))

/-- Supremum of the signed upper CDF error.  Keeping this direction separate
prevents the two-endpoint loss caused by taking an absolute value before
averaging. -/
noncomputable def upperCDFDistance (mu nu : Measure ℝ) : ℝ :=
  sSup (Set.range (cdfUpperError mu nu))

/-- Supremum of the signed lower CDF error. -/
noncomputable def lowerCDFDistance (mu nu : Measure ℝ) : ℝ :=
  sSup (Set.range (cdfLowerError mu nu))

/-- A pointwise CDF bound. Keeping this predicate alongside the supremum form
makes later smoothing estimates convenient to apply. -/
def CDFBound (μ ν : Measure ℝ) (ε : ℝ) : Prop :=
  ∀ x, cdfGap μ ν x ≤ ε

theorem cdfGap_nonneg (μ ν : Measure ℝ) (x : ℝ) :
    0 ≤ cdfGap μ ν x :=
  abs_nonneg _

theorem cdfGap_le_one (μ ν : Measure ℝ) (x : ℝ) :
    cdfGap μ ν x ≤ 1 := by
  rw [cdfGap, abs_le]
  constructor
  · linarith [cdf_nonneg μ x, cdf_le_one ν x]
  · linarith [cdf_nonneg ν x, cdf_le_one μ x]

theorem cdfUpperError_le_one (mu nu : Measure ℝ) (x : ℝ) :
    cdfUpperError mu nu x ≤ 1 := by
  unfold cdfUpperError
  linarith [cdf_nonneg nu x, cdf_le_one mu x]

theorem cdfLowerError_le_one (mu nu : Measure ℝ) (x : ℝ) :
    cdfLowerError mu nu x ≤ 1 := by
  unfold cdfLowerError
  linarith [cdf_nonneg mu x, cdf_le_one nu x]

theorem bddAbove_range_cdfGap (μ ν : Measure ℝ) :
    BddAbove (Set.range (cdfGap μ ν)) := by
  exact ⟨1, by rintro _ ⟨x, rfl⟩; exact cdfGap_le_one μ ν x⟩

theorem bddAbove_range_cdfUpperError (mu nu : Measure ℝ) :
    BddAbove (Set.range (cdfUpperError mu nu)) := by
  exact ⟨1, by rintro _ ⟨x, rfl⟩; exact cdfUpperError_le_one mu nu x⟩

theorem bddAbove_range_cdfLowerError (mu nu : Measure ℝ) :
    BddAbove (Set.range (cdfLowerError mu nu)) := by
  exact ⟨1, by rintro _ ⟨x, rfl⟩; exact cdfLowerError_le_one mu nu x⟩

theorem cdfGap_le_kolmogorovDistance (μ ν : Measure ℝ) (x : ℝ) :
    cdfGap μ ν x ≤ kolmogorovDistance μ ν :=
  le_csSup (bddAbove_range_cdfGap μ ν) ⟨x, rfl⟩

theorem cdfUpperError_le_upperCDFDistance
    (mu nu : Measure ℝ) (x : ℝ) :
    cdfUpperError mu nu x ≤ upperCDFDistance mu nu :=
  le_csSup (bddAbove_range_cdfUpperError mu nu) ⟨x, rfl⟩

theorem cdfLowerError_le_lowerCDFDistance
    (mu nu : Measure ℝ) (x : ℝ) :
    cdfLowerError mu nu x ≤ lowerCDFDistance mu nu :=
  le_csSup (bddAbove_range_cdfLowerError mu nu) ⟨x, rfl⟩

theorem upperCDFDistance_le_kolmogorovDistance (mu nu : Measure ℝ) :
    upperCDFDistance mu nu ≤ kolmogorovDistance mu nu := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  calc
    cdfUpperError mu nu x ≤ cdfGap mu nu x := by
      unfold cdfUpperError cdfGap
      exact le_abs_self _
    _ ≤ kolmogorovDistance mu nu := cdfGap_le_kolmogorovDistance mu nu x

theorem lowerCDFDistance_le_kolmogorovDistance (mu nu : Measure ℝ) :
    lowerCDFDistance mu nu ≤ kolmogorovDistance mu nu := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  calc
    cdfLowerError mu nu x ≤ cdfGap mu nu x := by
      unfold cdfLowerError cdfGap
      simpa only [neg_sub] using neg_le_abs (cdf mu x - cdf nu x)
    _ ≤ kolmogorovDistance mu nu := cdfGap_le_kolmogorovDistance mu nu x

theorem cdfGap_eq_max_signed (mu nu : Measure ℝ) (x : ℝ) :
    cdfGap mu nu x =
      max (cdfUpperError mu nu x) (cdfLowerError mu nu x) := by
  unfold cdfGap cdfUpperError cdfLowerError
  rw [abs_eq_max_neg]
  congr 1
  ring

/-- The maximum of two real numbers, expressed through their sum and signed
difference. -/
theorem max_eq_add_add_abs_sub_div_two (a b : ℝ) :
    max a b = (a + b + |a - b|) / 2 := by
  rcases le_total a b with hab | hba
  · rw [max_eq_right hab, abs_of_nonpos (sub_nonpos.mpr hab)]
    ring
  · rw [max_eq_left hba, abs_of_nonneg (sub_nonneg.mpr hba)]
    ring

/-- Kolmogorov distance is exactly the maximum of its two signed one-sided
CDF distances. -/
theorem kolmogorovDistance_eq_max_signed (mu nu : Measure ℝ) :
    kolmogorovDistance mu nu =
      max (upperCDFDistance mu nu) (lowerCDFDistance mu nu) := by
  apply le_antisymm
  · apply csSup_le (Set.range_nonempty _)
    rintro _ ⟨x, rfl⟩
    rw [cdfGap_eq_max_signed]
    exact max_le_max
      (cdfUpperError_le_upperCDFDistance mu nu x)
      (cdfLowerError_le_lowerCDFDistance mu nu x)
  · exact max_le
      (upperCDFDistance_le_kolmogorovDistance mu nu)
      (lowerCDFDistance_le_kolmogorovDistance mu nu)

/-- Probability laws with matching first and second moments integrate every
quadratic polynomial equally. -/
theorem integral_quadratic_eq_of_moments
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => y) mu)
    (hnu1 : Integrable (fun y : ℝ => y) nu)
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu)
    (hnu2 : Integrable (fun y : ℝ => y ^ 2) nu)
    (hmean : (∫ y, y ∂mu) = ∫ y, y ∂nu)
    (hsecond : (∫ y, y ^ 2 ∂mu) = ∫ y, y ^ 2 ∂nu)
    (a0 a1 a2 : ℝ) :
    (∫ y, a0 + a1 * y + a2 * y ^ 2 ∂mu) =
      ∫ y, a0 + a1 * y + a2 * y ^ 2 ∂nu := by
  have hmuLin : Integrable (fun y : ℝ => a0 + a1 * y) mu :=
    (integrable_const a0).add (hmu1.const_mul a1)
  have hnuLin : Integrable (fun y : ℝ => a0 + a1 * y) nu :=
    (integrable_const a0).add (hnu1.const_mul a1)
  have hmuCalc :
      (∫ y, a0 + a1 * y + a2 * y ^ 2 ∂mu) =
        a0 + a1 * (∫ y, y ∂mu) + a2 * (∫ y, y ^ 2 ∂mu) := by
    calc
      (∫ y, a0 + a1 * y + a2 * y ^ 2 ∂mu) =
          (∫ y, a0 + a1 * y ∂mu) + ∫ y, a2 * y ^ 2 ∂mu :=
        integral_add hmuLin (hmu2.const_mul a2)
      _ = ((∫ _y : ℝ, a0 ∂mu) + ∫ y, a1 * y ∂mu) +
          ∫ y, a2 * y ^ 2 ∂mu := by
        rw [integral_add (integrable_const a0) (hmu1.const_mul a1)]
      _ = _ := by rw [integral_const, integral_const_mul, integral_const_mul]; simp
  have hnuCalc :
      (∫ y, a0 + a1 * y + a2 * y ^ 2 ∂nu) =
        a0 + a1 * (∫ y, y ∂nu) + a2 * (∫ y, y ^ 2 ∂nu) := by
    calc
      (∫ y, a0 + a1 * y + a2 * y ^ 2 ∂nu) =
          (∫ y, a0 + a1 * y ∂nu) + ∫ y, a2 * y ^ 2 ∂nu :=
        integral_add hnuLin (hnu2.const_mul a2)
      _ = ((∫ _y : ℝ, a0 ∂nu) + ∫ y, a1 * y ∂nu) +
          ∫ y, a2 * y ^ 2 ∂nu := by
        rw [integral_add (integrable_const a0) (hnu1.const_mul a1)]
      _ = _ := by rw [integral_const, integral_const_mul, integral_const_mul]; simp
  calc
    (∫ y, a0 + a1 * y + a2 * y ^ 2 ∂mu) =
        a0 + a1 * (∫ y, y ∂mu) + a2 * (∫ y, y ^ 2 ∂mu) := hmuCalc
    _ = a0 + a1 * (∫ y, y ∂nu) + a2 * (∫ y, y ^ 2 ∂nu) := by
      rw [hmean, hsecond]
    _ = ∫ y, a0 + a1 * y + a2 * y ^ 2 ∂nu := hnuCalc.symm

/-- If a common integrable approximation has the same integral under two
laws, a cubic pointwise remainder controls the difference of the target
integrals. -/
theorem abs_integral_sub_integral_le_of_common_approximation
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (f p : ℝ → ℝ)
    (hfmu : Integrable f mu) (hfnu : Integrable f nu)
    (hpmu : Integrable p mu) (hpnu : Integrable p nu)
    (hpEq : (∫ y, p y ∂mu) = ∫ y, p y ∂nu)
    {C : ℝ}
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu)
    (hnu3 : Integrable (fun y : ℝ => |y| ^ 3) nu)
    (hrem : ∀ y, |f y - p y| ≤ C * |y| ^ 3) :
    |(∫ y, f y ∂mu) - ∫ y, f y ∂nu| ≤
      C * ((∫ y, |y| ^ 3 ∂mu) + ∫ y, |y| ^ 3 ∂nu) := by
  have hrmu : Integrable (fun y => f y - p y) mu := hfmu.sub hpmu
  have hrnu : Integrable (fun y => f y - p y) nu := hfnu.sub hpnu
  calc
    |(∫ y, f y ∂mu) - ∫ y, f y ∂nu| =
        |(∫ y, f y - p y ∂mu) - ∫ y, f y - p y ∂nu| := by
      rw [integral_sub hfmu hpmu, integral_sub hfnu hpnu, hpEq]
      ring
    _ ≤ |∫ y, f y - p y ∂mu| + |∫ y, f y - p y ∂nu| :=
      abs_sub _ _
    _ ≤ (∫ y, |f y - p y| ∂mu) + ∫ y, |f y - p y| ∂nu :=
      add_le_add abs_integral_le_integral_abs abs_integral_le_integral_abs
    _ ≤ (∫ y, C * |y| ^ 3 ∂mu) + ∫ y, C * |y| ^ 3 ∂nu := by
      exact add_le_add
        (integral_mono hrmu.abs (hmu3.const_mul C) hrem)
        (integral_mono hrnu.abs (hnu3.const_mul C) hrem)
    _ = C * ((∫ y, |y| ^ 3 ∂mu) + ∫ y, |y| ^ 3 ∂nu) := by
      rw [integral_const_mul, integral_const_mul]
      ring

/-- Equal first and second moments cancel every quadratic Taylor term, so a
third-order remainder is the only contribution to the integral comparison. -/
theorem abs_integral_sub_integral_le_of_quadratic_moment_match
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (f : ℝ → ℝ)
    (hfmu : Integrable f mu) (hfnu : Integrable f nu)
    (hmu1 : Integrable (fun y : ℝ => y) mu)
    (hnu1 : Integrable (fun y : ℝ => y) nu)
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu)
    (hnu2 : Integrable (fun y : ℝ => y ^ 2) nu)
    (hmean : (∫ y, y ∂mu) = ∫ y, y ∂nu)
    (hsecond : (∫ y, y ^ 2 ∂mu) = ∫ y, y ^ 2 ∂nu)
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu)
    (hnu3 : Integrable (fun y : ℝ => |y| ^ 3) nu)
    (a0 a1 a2 M : ℝ)
    (hrem : ∀ y,
      |f y - (a0 + a1 * y + a2 * y ^ 2)| ≤ (M / 6) * |y| ^ 3) :
    |(∫ y, f y ∂mu) - ∫ y, f y ∂nu| ≤
      (M / 6) * ((∫ y, |y| ^ 3 ∂mu) + ∫ y, |y| ^ 3 ∂nu) := by
  let p : ℝ → ℝ := fun y => a0 + a1 * y + a2 * y ^ 2
  have hpmu : Integrable p mu :=
    ((integrable_const a0).add (hmu1.const_mul a1)).add (hmu2.const_mul a2)
  have hpnu : Integrable p nu :=
    ((integrable_const a0).add (hnu1.const_mul a1)).add (hnu2.const_mul a2)
  apply abs_integral_sub_integral_le_of_common_approximation
    mu nu f p hfmu hfnu hpmu hpnu
  · exact integral_quadratic_eq_of_moments
      mu nu hmu1 hnu1 hmu2 hnu2 hmean hsecond a0 a1 a2
  · exact hmu3
  · exact hnu3
  · exact hrem

theorem integrable_standardNormal_id :
    Integrable (fun y : ℝ => y)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw]
  simpa only [id_eq] using
    ((ProbabilityTheory.memLp_id_gaussianReal
      (μ := (0 : ℝ)) (v := (1 : ℝ≥0)) 1).integrable (by norm_num))

theorem integrable_standardNormal_sq :
    Integrable (fun y : ℝ => y ^ 2)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw]
  simpa only [id_eq] using
    (ProbabilityTheory.memLp_id_gaussianReal
      (μ := (0 : ℝ)) (v := (1 : ℝ≥0)) 2).integrable_sq

theorem integrable_standardNormal_abs_cube :
    Integrable (fun y : ℝ => |y| ^ 3)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw]
  simpa only [id_eq, Real.norm_eq_abs] using
    (ProbabilityTheory.memLp_id_gaussianReal
      (μ := (0 : ℝ)) (v := (1 : ℝ≥0)) 3).integrable_norm_pow (by norm_num)

theorem integral_standardNormal_id :
    (∫ y : ℝ, y
      ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) = 0 := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw]
  exact ProbabilityTheory.integral_id_gaussianReal

theorem integral_standardNormal_sq :
    (∫ y : ℝ, y ^ 2
      ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) = 1 := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw]
  have hv := @ProbabilityTheory.variance_id_gaussianReal (0 : ℝ) (1 : ℝ≥0)
  change Var[(fun y : ℝ => y); ProbabilityTheory.gaussianReal 0 1] =
    (1 : ℝ≥0) at hv
  rw [variance_of_integral_eq_zero measurable_id'.aemeasurable (by simp)] at hv
  norm_num at hv ⊢
  exact hv

/-- Standard-normal specialization of quadratic moment cancellation. -/
theorem abs_integral_sub_standardNormal_le_of_quadratic_remainder
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (f : ℝ → ℝ)
    (hfmu : Integrable f mu)
    (hfGaussian : Integrable f
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
    (hmu1 : Integrable (fun y : ℝ => y) mu)
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu)
    (hmean : (∫ y, y ∂mu) = 0)
    (hsecond : (∫ y, y ^ 2 ∂mu) = 1)
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu)
    (a0 a1 a2 M : ℝ)
    (hrem : ∀ y,
      |f y - (a0 + a1 * y + a2 * y ^ 2)| ≤ (M / 6) * |y| ^ 3) :
    |(∫ y, f y ∂mu) -
        ∫ y, f y
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw| ≤
      (M / 6) * ((∫ y, |y| ^ 3 ∂mu) +
        ∫ y, |y| ^ 3
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
  apply abs_integral_sub_integral_le_of_quadratic_moment_match
    mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw f
    hfmu hfGaussian hmu1 integrable_standardNormal_id hmu2
    integrable_standardNormal_sq
  · rw [hmean, integral_standardNormal_id]
  · rw [hsecond, integral_standardNormal_sq]
  · exact hmu3
  · exact integrable_standardNormal_abs_cube
  · exact hrem

theorem kolmogorovDistance_nonneg (μ ν : Measure ℝ) :
    0 ≤ kolmogorovDistance μ ν :=
  (cdfGap_nonneg μ ν 0).trans (cdfGap_le_kolmogorovDistance μ ν 0)

theorem kolmogorovDistance_le_one (μ ν : Measure ℝ) :
    kolmogorovDistance μ ν ≤ 1 := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  exact cdfGap_le_one μ ν x

theorem kolmogorovDistance_le_iff (μ ν : Measure ℝ) (ε : ℝ) :
    kolmogorovDistance μ ν ≤ ε ↔ CDFBound μ ν ε := by
  constructor
  · intro h x
    exact (cdfGap_le_kolmogorovDistance μ ν x).trans h
  · intro h
    apply csSup_le (Set.range_nonempty _)
    rintro _ ⟨x, rfl⟩
    exact h x

theorem kolmogorovDistance_comm (μ ν : Measure ℝ) :
    kolmogorovDistance μ ν = kolmogorovDistance ν μ := by
  apply le_antisymm
  · apply (kolmogorovDistance_le_iff μ ν _).2
    intro x
    simpa only [cdfGap, abs_sub_comm] using
      cdfGap_le_kolmogorovDistance ν μ x
  · apply (kolmogorovDistance_le_iff ν μ _).2
    intro x
    simpa only [cdfGap, abs_sub_comm] using
      cdfGap_le_kolmogorovDistance μ ν x

theorem kolmogorovDistance_triangle (μ ν ρ : Measure ℝ) :
    kolmogorovDistance μ ρ ≤
      kolmogorovDistance μ ν + kolmogorovDistance ν ρ := by
  apply (kolmogorovDistance_le_iff μ ρ _).2
  intro x
  change |cdf μ x - cdf ρ x| ≤ _
  calc
    |cdf μ x - cdf ρ x| =
        |(cdf μ x - cdf ν x) + (cdf ν x - cdf ρ x)| := by
      congr 1
      ring
    _ ≤ |cdf μ x - cdf ν x| + |cdf ν x - cdf ρ x| :=
      abs_add_le _ _
    _ ≤ kolmogorovDistance μ ν + kolmogorovDistance ν ρ := by
      exact add_le_add
        (cdfGap_le_kolmogorovDistance μ ν x)
        (cdfGap_le_kolmogorovDistance ν ρ x)

@[simp] theorem kolmogorovDistance_self (μ : Measure ℝ) :
    kolmogorovDistance μ μ = 0 := by
  apply le_antisymm
  · apply (kolmogorovDistance_le_iff μ μ 0).2
    intro x
    simp [cdfGap]
  · exact kolmogorovDistance_nonneg μ μ

theorem kolmogorovDistance_eq_zero_iff
    (μ ν : Measure ℝ)
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ν] :
    kolmogorovDistance μ ν = 0 ↔ μ = ν := by
  constructor
  · intro h
    apply MeasureTheory.Measure.eq_of_cdf μ ν
    ext x
    have hx : cdfGap μ ν x ≤ 0 := by
      rw [← h]
      exact cdfGap_le_kolmogorovDistance μ ν x
    have habs : |cdf μ x - cdf ν x| = 0 :=
      le_antisymm hx (abs_nonneg _)
    exact sub_eq_zero.mp (abs_eq_zero.mp habs)
  · rintro rfl
    exact kolmogorovDistance_self μ

theorem cdf_map_eq_real_preimage
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → ℝ) (hX : Measurable X) (x : ℝ) :
    cdf (μ.map X) x = μ.real (X ⁻¹' Iic x) := by
  letI : IsProbabilityMeasure (μ.map X) :=
    Measure.isProbabilityMeasure_map hX.aemeasurable
  rw [cdf_eq_real, map_measureReal_apply hX measurableSet_Iic]

/-- The CDF of a positive scalar pushforward is evaluated at the inversely
scaled argument. -/
theorem cdf_map_mul
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {c : ℝ} (hc : 0 < c) (x : ℝ) :
    cdf (Measure.map (fun y : ℝ => c * y) mu) x = cdf mu (x / c) := by
  letI : IsProbabilityMeasure (Measure.map (fun y : ℝ => c * y) mu) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  rw [cdf_eq_real, map_measureReal_apply (by fun_prop) measurableSet_Iic,
    cdf_eq_real]
  congr 1
  ext y
  simp only [Set.mem_preimage, mem_Iic]
  rw [le_div_iff₀ hc]
  simp only [mul_comm]

theorem cdfGap_map_mul
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {c : ℝ} (hc : 0 < c) (x : ℝ) :
    cdfGap
        (Measure.map (fun y : ℝ => c * y) mu)
        (Measure.map (fun y : ℝ => c * y) nu) x =
      cdfGap mu nu (x / c) := by
  unfold cdfGap
  rw [cdf_map_mul mu hc, cdf_map_mul nu hc]

/-- Kolmogorov distance is invariant under a common positive scalar
pushforward. -/
theorem kolmogorovDistance_map_mul_eq
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {c : ℝ} (hc : 0 < c) :
    kolmogorovDistance
        (Measure.map (fun y : ℝ => c * y) mu)
        (Measure.map (fun y : ℝ => c * y) nu) =
      kolmogorovDistance mu nu := by
  letI : IsProbabilityMeasure (Measure.map (fun y : ℝ => c * y) mu) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure (Measure.map (fun y : ℝ => c * y) nu) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  apply le_antisymm
  · apply (kolmogorovDistance_le_iff _ _ _).2
    intro x
    rw [cdfGap_map_mul mu nu hc]
    exact cdfGap_le_kolmogorovDistance mu nu (x / c)
  · apply (kolmogorovDistance_le_iff _ _ _).2
    intro x
    calc
      cdfGap mu nu x = cdfGap
          (Measure.map (fun y : ℝ => c * y) mu)
          (Measure.map (fun y : ℝ => c * y) nu) (c * x) := by
        rw [cdfGap_map_mul mu nu hc]
        field_simp
      _ ≤ kolmogorovDistance
          (Measure.map (fun y : ℝ => c * y) mu)
          (Measure.map (fun y : ℝ => c * y) nu) :=
        cdfGap_le_kolmogorovDistance _ _ (c * x)

/-- Scaling a common-convolution replacement by the same positive factor
does not change its Kolmogorov distance; the conclusion is oriented for the
Gaussian replacement bounds below. -/
theorem kolmogorovDistance_map_mul_conv_eq
    (kappa mu nu : Measure ℝ)
    [IsProbabilityMeasure kappa] [IsProbabilityMeasure mu]
    [IsProbabilityMeasure nu]
    {c : ℝ} (hc : 0 < c) :
    kolmogorovDistance
        (Measure.map (fun y : ℝ => c * y) (kappa ∗ mu))
        (Measure.map (fun y : ℝ => c * y) (kappa ∗ nu)) =
      kolmogorovDistance (mu ∗ kappa) (nu ∗ kappa) := by
  rw [kolmogorovDistance_map_mul_eq (kappa ∗ mu) (kappa ∗ nu) hc,
    Measure.conv_comm kappa mu, Measure.conv_comm kappa nu]

theorem cdfUpperError_map_mul
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {c : ℝ} (hc : 0 < c) (x : ℝ) :
    cdfUpperError
        (Measure.map (fun y : ℝ => c * y) mu)
        (Measure.map (fun y : ℝ => c * y) nu) x =
      cdfUpperError mu nu (x / c) := by
  unfold cdfUpperError
  rw [cdf_map_mul mu hc, cdf_map_mul nu hc]

theorem cdfLowerError_map_mul
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {c : ℝ} (hc : 0 < c) (x : ℝ) :
    cdfLowerError
        (Measure.map (fun y : ℝ => c * y) mu)
        (Measure.map (fun y : ℝ => c * y) nu) x =
      cdfLowerError mu nu (x / c) := by
  simpa only [cdfLowerError_eq_upper_swap] using
    cdfUpperError_map_mul nu mu hc x

/-- The spatial `L¹` norm of the upper signed CDF error scales linearly under
a common positive scalar pushforward. -/
theorem integral_abs_cdfUpperError_map_mul_eq
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {c : ℝ} (hc : 0 < c) :
    (∫ x, |cdfUpperError
      (Measure.map (fun y : ℝ => c * y) mu)
      (Measure.map (fun y : ℝ => c * y) nu) x|) =
      c * ∫ x, |cdfUpperError mu nu x| := by
  calc
    (∫ x, |cdfUpperError
        (Measure.map (fun y : ℝ => c * y) mu)
        (Measure.map (fun y : ℝ => c * y) nu) x|) =
        ∫ x, |cdfUpperError mu nu (c⁻¹ * x)| := by
      apply integral_congr_ae
      exact ae_of_all _ fun x => by
        change |cdfUpperError
          (Measure.map (fun y : ℝ => c * y) mu)
          (Measure.map (fun y : ℝ => c * y) nu) x| =
            |cdfUpperError mu nu (c⁻¹ * x)|
        rw [cdfUpperError_map_mul mu nu hc]
        congr 2
        field_simp
    _ = |(c⁻¹)⁻¹| * ∫ x, |cdfUpperError mu nu x| := by
      simpa only [smul_eq_mul] using
        (Measure.integral_comp_mul_left
          (fun x => |cdfUpperError mu nu x|) c⁻¹)
    _ = c * ∫ x, |cdfUpperError mu nu x| := by
      rw [inv_inv, abs_of_pos hc]

/-- Lower signed-error companion to
`integral_abs_cdfUpperError_map_mul_eq`. -/
theorem integral_abs_cdfLowerError_map_mul_eq
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {c : ℝ} (hc : 0 < c) :
    (∫ x, |cdfLowerError
      (Measure.map (fun y : ℝ => c * y) mu)
      (Measure.map (fun y : ℝ => c * y) nu) x|) =
      c * ∫ x, |cdfLowerError mu nu x| := by
  simpa only [cdfLowerError_eq_upper_swap] using
    integral_abs_cdfUpperError_map_mul_eq nu mu hc

/-- The second spatially weighted `L¹` norm of the upper signed CDF error
scales cubically under a common positive scalar pushforward. -/
theorem integral_abs_sq_mul_abs_cdfUpperError_map_mul_eq
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {c : ℝ} (hc : 0 < c) :
    (∫ x, |x| ^ 2 * |cdfUpperError
      (Measure.map (fun y : ℝ => c * y) mu)
      (Measure.map (fun y : ℝ => c * y) nu) x|) =
      c ^ 3 * ∫ x, |x| ^ 2 * |cdfUpperError mu nu x| := by
  calc
    (∫ x, |x| ^ 2 * |cdfUpperError
        (Measure.map (fun y : ℝ => c * y) mu)
        (Measure.map (fun y : ℝ => c * y) nu) x|) =
        ∫ x, |x| ^ 2 * |cdfUpperError mu nu (c⁻¹ * x)| := by
      apply integral_congr_ae
      exact ae_of_all _ fun x => by
        change |x| ^ 2 * |cdfUpperError
          (Measure.map (fun y : ℝ => c * y) mu)
          (Measure.map (fun y : ℝ => c * y) nu) x| =
            |x| ^ 2 * |cdfUpperError mu nu (c⁻¹ * x)|
        rw [cdfUpperError_map_mul mu nu hc]
        congr 3
        field_simp
    _ = |(c⁻¹)⁻¹| *
        ∫ x, |c * x| ^ 2 * |cdfUpperError mu nu x| := by
      convert (Measure.integral_comp_mul_left
        (fun x => |c * x| ^ 2 * |cdfUpperError mu nu x|) c⁻¹) using 1
      apply integral_congr_ae
      exact ae_of_all _ fun x => by
        field_simp
    _ = c ^ 3 * ∫ x, |x| ^ 2 * |cdfUpperError mu nu x| := by
      rw [inv_inv, abs_of_pos hc]
      simp_rw [abs_mul, abs_of_pos hc, mul_pow]
      rw [show (fun x => c ^ 2 * |x| ^ 2 * |cdfUpperError mu nu x|) =
          fun x => c ^ 2 * (|x| ^ 2 * |cdfUpperError mu nu x|) by
        funext x
        ring]
      rw [integral_const_mul]
      ring

/-- Lower signed-error companion to the cubic weighted scaling identity. -/
theorem integral_abs_sq_mul_abs_cdfLowerError_map_mul_eq
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {c : ℝ} (hc : 0 < c) :
    (∫ x, |x| ^ 2 * |cdfLowerError
      (Measure.map (fun y : ℝ => c * y) mu)
      (Measure.map (fun y : ℝ => c * y) nu) x|) =
      c ^ 3 * ∫ x, |x| ^ 2 * |cdfLowerError mu nu x| := by
  simpa only [cdfLowerError_eq_upper_swap] using
    integral_abs_sq_mul_abs_cdfUpperError_map_mul_eq nu mu hc

/-- Centered Gaussian variances add under convolution, specialized to the
successive natural variances used by the leave-one-out recurrence. -/
theorem gaussianReal_nat_succ_conv_standardNormalLaw (N : ℕ) :
    ProbabilityTheory.gaussianReal 0 (N + 1 : ℝ≥0) ∗
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw =
      ProbabilityTheory.gaussianReal 0 (N + 2 : ℝ≥0) := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw]
  convert (ProbabilityTheory.gaussianReal_conv_gaussianReal
      (m₁ := 0) (m₂ := 0)
      (v₁ := (N + 1 : ℝ≥0)) (v₂ := (1 : ℝ≥0))) using 1
  norm_num [Nat.cast_add, add_assoc]

/-- Scaling a centered Gaussian of natural variance `N + 1` by
`1 / sqrt(N + 1)` gives the standard normal law. -/
theorem map_gaussianReal_nat_succ_eq_standardNormalLaw (N : ℕ) :
    Measure.map (fun y : ℝ => (Real.sqrt (N + 1 : ℝ))⁻¹ * y)
        (ProbabilityTheory.gaussianReal 0 (N + 1 : ℝ≥0)) =
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  rw [ProbabilityTheory.gaussianReal_map_const_mul,
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw]
  congr 2
  · simp
  · rw [← NNReal.coe_inj]
    simp only [NNReal.coe_mul, NNReal.coe_mk, NNReal.coe_one]
    have hs : Real.sqrt (N + 1 : ℝ) ≠ 0 := by positivity
    rw [inv_pow, Real.sq_sqrt (by positivity)]
    field_simp
    norm_cast

/-- The measure of the strict lower ray is the left limit of the CDF. -/
theorem measureReal_Iio_eq_leftLim_cdf
    (mu : Measure ℝ) [IsProbabilityMeasure mu] (t : ℝ) :
    mu.real (Iio t) = leftLim (cdf mu) t := by
  calc
    mu.real (Iio t) = (cdf mu).measure.real (Iio t) := by
      rw [measure_cdf mu]
    _ = leftLim (cdf mu) t := by
      rw [Measure.real, (cdf mu).measure_Iio (tendsto_cdf_atBot mu)]
      simp only [sub_zero]
      rw [ENNReal.toReal_ofReal]
      exact (cdf_nonneg mu (t - 1)).trans
        ((monotone_cdf mu).le_leftLim (sub_lt_self t zero_lt_one))

/-- Kolmogorov distance controls strict lower-tail probabilities as well as
the closed lower-tail probabilities used to define the CDF. -/
theorem measureReal_Iio_gap_le_kolmogorovDistance
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (t : ℝ) :
    |mu.real (Iio t) - nu.real (Iio t)| ≤ kolmogorovDistance mu nu := by
  rw [measureReal_Iio_eq_leftLim_cdf mu t,
    measureReal_Iio_eq_leftLim_cdf nu t]
  have hlim : Tendsto (fun x : ℝ => |cdf mu x - cdf nu x|)
      (nhdsWithin t (Iio t))
      (nhds |leftLim (cdf mu) t - leftLim (cdf nu) t|) :=
    ((monotone_cdf mu).tendsto_leftLim t |>.sub
      ((monotone_cdf nu).tendsto_leftLim t)).abs
  exact le_of_tendsto hlim (Eventually.of_forall fun x =>
    cdfGap_le_kolmogorovDistance mu nu x)

/-- The midpoint CDF averages the closed lower-tail probability with its
strict-lower counterpart.  It is the atom-symmetric coordinate naturally
exposed by the off-diagonal Prawitz imbalance. -/
noncomputable def midpointCDF (mu : Measure ℝ) (x : ℝ) : ℝ :=
  (cdf mu x + mu.real (Iio x)) / 2

/-- Signed two-law difference in the midpoint-CDF coordinate. -/
noncomputable def midpointCDFDifference
    (mu nu : Measure ℝ) (x : ℝ) : ℝ :=
  midpointCDF mu x - midpointCDF nu x

theorem midpointCDFDifference_eq
    (mu nu : Measure ℝ) (x : ℝ) :
    midpointCDFDifference mu nu x =
      ((cdf mu x - cdf nu x) +
        (mu.real (Iio x) - nu.real (Iio x))) / 2 := by
  unfold midpointCDFDifference midpointCDF
  ring

/-- Kolmogorov distance controls the atom-symmetric midpoint-CDF coordinate
with coefficient one. -/
theorem abs_midpointCDFDifference_le_kolmogorovDistance
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (x : ℝ) :
    |midpointCDFDifference mu nu x| ≤ kolmogorovDistance mu nu := by
  rw [midpointCDFDifference_eq, abs_div,
    abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
  have hClosed : |cdf mu x - cdf nu x| ≤
      kolmogorovDistance mu nu := by
    simpa only [cdfGap] using cdfGap_le_kolmogorovDistance mu nu x
  have hOpen : |mu.real (Iio x) - nu.real (Iio x)| ≤
      kolmogorovDistance mu nu :=
    measureReal_Iio_gap_le_kolmogorovDistance mu nu x
  have hAdd := abs_add_le
    (cdf mu x - cdf nu x)
    (mu.real (Iio x) - nu.real (Iio x))
  linarith

/-- A singleton mass is the jump between the closed CDF and its strict
lower-tail value. -/
theorem measureReal_singleton_eq_cdf_sub_Iio
    (mu : Measure ℝ) [IsProbabilityMeasure mu] (x : ℝ) :
    mu.real {x} = cdf mu x - mu.real (Iio x) := by
  rw [cdf_eq_real]
  have hsubset : Iio x ⊆ Iic x := Iio_subset_Iic_self
  have hdiff : Iic x \ Iio x = {x} := by
    ext y
    simp only [mem_diff, mem_Iic, mem_Iio, mem_singleton_iff]
    constructor
    · rintro ⟨hyx, hnlt⟩
      exact le_antisymm hyx (not_lt.mp hnlt)
    · rintro rfl
      exact ⟨le_rfl, lt_irrefl _⟩
  rw [← measureReal_diff hsubset measurableSet_Iio, hdiff]

/-- The signed difference of two atom masses separates into the closed-CDF
difference minus the strict-lower-tail difference. -/
theorem measureReal_singleton_sub_eq_cdf_sub_sub_Iio
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (x : ℝ) :
    mu.real {x} - nu.real {x} =
      (cdf mu x - cdf nu x) -
        (mu.real (Iio x) - nu.real (Iio x)) := by
  rw [measureReal_singleton_eq_cdf_sub_Iio mu x,
    measureReal_singleton_eq_cdf_sub_Iio nu x]
  ring

/-- The atom-mass difference is bounded by one closed-CDF gap and one
strict-lower-tail gap. -/
theorem abs_measureReal_singleton_sub_le_cdfGap_add_IioGap
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (x : ℝ) :
    |mu.real {x} - nu.real {x}| ≤
      cdfGap mu nu x +
        |mu.real (Iio x) - nu.real (Iio x)| := by
  rw [measureReal_singleton_sub_eq_cdf_sub_sub_Iio mu nu x, cdfGap]
  exact abs_sub _ _

/-- Consequently Kolmogorov distance controls atom-mass differences with the
sharp coefficient supplied by the two CDF sides. -/
theorem abs_measureReal_singleton_sub_le_two_mul_kolmogorovDistance
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (x : ℝ) :
    |mu.real {x} - nu.real {x}| ≤
      2 * kolmogorovDistance mu nu := by
  have hAtom :=
    abs_measureReal_singleton_sub_le_cdfGap_add_IioGap mu nu x
  have hClosed := cdfGap_le_kolmogorovDistance mu nu x
  have hOpen := measureReal_Iio_gap_le_kolmogorovDistance mu nu x
  linarith

/-- Kolmogorov distance controls the closed upper-tail probabilities printed
in the source, without any atomlessness assumption on the first measure. -/
theorem measureReal_Ici_gap_le_kolmogorovDistance
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (t : ℝ) :
    |mu.real (Ici t) - nu.real (Ici t)| ≤ kolmogorovDistance mu nu := by
  have hmu : mu.real (Ici t) = 1 - mu.real (Iio t) := by
    rw [← compl_Iio, measureReal_compl measurableSet_Iio, probReal_univ]
  have hnu : nu.real (Ici t) = 1 - nu.real (Iio t) := by
    rw [← compl_Iio, measureReal_compl measurableSet_Iio, probReal_univ]
  rw [hmu, hnu]
  simpa only [sub_sub_sub_cancel_left, abs_sub_comm] using
    measureReal_Iio_gap_le_kolmogorovDistance mu nu t

/-- A first absolute moment gives the characteristic function a quantitative
modulus at the origin. This removes the apparent `1 / |t|` singularity in the
truncated integral occurring in Esseen smoothing. -/
theorem norm_charFun_sub_one_le_firstMoment
    {μ : Measure ℝ} [IsProbabilityMeasure μ]
    (hμ1 : Integrable (fun x : ℝ => |x|) μ) (t : ℝ) :
    ‖MeasureTheory.charFun μ t - 1‖ ≤
      |t| * ∫ x, |x| ∂μ := by
  have hExp : Integrable
      (fun x : ℝ => Complex.exp (((t * x : ℝ) : ℂ) * Complex.I)) μ := by
    refine Integrable.of_bound (by fun_prop) 1 ?_
    exact ae_of_all μ fun x => by
      simp only [Complex.norm_exp_ofReal_mul_I]
      norm_num
  have hOne : Integrable (fun _ : ℝ => (1 : ℂ)) μ := integrable_const 1
  have hSub :
      (∫ x : ℝ, Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) - 1 ∂μ) =
        (∫ x : ℝ, Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) ∂μ) - 1 := by
    rw [integral_sub hExp hOne]
    simp [integral_const]
  rw [MeasureTheory.charFun_apply_real]
  simp_rw [← Complex.ofReal_mul]
  rw [← hSub]
  calc
    ‖∫ x : ℝ, Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) - 1 ∂μ‖ ≤
        ∫ x : ℝ, |t| * |x| ∂μ :=
      norm_integral_le_of_norm_le (hμ1.const_mul |t|) <|
        ae_of_all μ fun x => by
          simpa only [mul_comm ((t * x : ℝ) : ℂ), Real.norm_eq_abs,
            abs_mul] using
            (Real.norm_exp_I_mul_ofReal_sub_one_le (x := t * x))
    _ = |t| * ∫ x : ℝ, |x| ∂μ := by rw [integral_const_mul]

/-- The characteristic functions of two laws with finite first moments differ
by `O(|t|)` at the origin. -/
theorem norm_charFun_sub_charFun_le_firstMoments
    {μ ν : Measure ℝ} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμ1 : Integrable (fun x : ℝ => |x|) μ)
    (hν1 : Integrable (fun x : ℝ => |x|) ν) (t : ℝ) :
    ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ ≤
      |t| * ((∫ x, |x| ∂μ) + ∫ x, |x| ∂ν) := by
  calc
    ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ =
        ‖(MeasureTheory.charFun μ t - 1) +
          (1 - MeasureTheory.charFun ν t)‖ := by
      congr 1
      ring
    _ ≤ ‖MeasureTheory.charFun μ t - 1‖ +
        ‖1 - MeasureTheory.charFun ν t‖ := norm_add_le _ _
    _ = ‖MeasureTheory.charFun μ t - 1‖ +
        ‖MeasureTheory.charFun ν t - 1‖ := by
      rw [← norm_neg (1 - MeasureTheory.charFun ν t)]
      congr 2
      ring
    _ ≤ |t| * (∫ x, |x| ∂μ) + |t| * ∫ x, |x| ∂ν :=
      add_le_add
        (norm_charFun_sub_one_le_firstMoment hμ1 t)
        (norm_charFun_sub_one_le_firstMoment hν1 t)
    _ = |t| * ((∫ x, |x| ∂μ) + ∫ x, |x| ∂ν) := by ring

/-- The discrepancy quotient used in Esseen's truncated Fourier integral,
defined to be zero at the removable singularity. -/
noncomputable def charFunDiscrepancyQuotient
    (μ ν : Measure ℝ) (t : ℝ) : ℝ :=
  if t = 0 then 0
  else ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ / |t|

theorem charFunDiscrepancyQuotient_nonneg (μ ν : Measure ℝ) (t : ℝ) :
    0 ≤ charFunDiscrepancyQuotient μ ν t := by
  rw [charFunDiscrepancyQuotient]
  split_ifs
  · exact le_rfl
  · positivity

theorem norm_charFun_sub_eq_abs_mul_charFunDiscrepancyQuotient
    (mu nu : Measure ℝ) {t : ℝ} (ht : t ≠ 0) :
    ‖MeasureTheory.charFun mu t - MeasureTheory.charFun nu t‖ =
      |t| * charFunDiscrepancyQuotient mu nu t := by
  rw [charFunDiscrepancyQuotient, if_neg ht]
  field_simp [abs_ne_zero.mpr ht]

/-- Universal large-frequency bound obtained only from the unit norm of
probability characteristic functions. -/
theorem charFunDiscrepancyQuotient_le_two_div_abs
    (μ ν : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (t : ℝ) :
    charFunDiscrepancyQuotient μ ν t ≤ 2 / |t| := by
  by_cases ht : t = 0
  · subst t
    simp [charFunDiscrepancyQuotient]
  · rw [charFunDiscrepancyQuotient, if_neg ht]
    apply div_le_div_of_nonneg_right _ (abs_nonneg t)
    calc
      ‖MeasureTheory.charFun μ t - MeasureTheory.charFun ν t‖ ≤
          ‖MeasureTheory.charFun μ t‖ + ‖MeasureTheory.charFun ν t‖ :=
        norm_sub_le _ _
      _ ≤ 1 + 1 := add_le_add
        (MeasureTheory.norm_charFun_le_one t)
        (MeasureTheory.norm_charFun_le_one t)
      _ = 2 := by norm_num

theorem stronglyMeasurable_charFunDiscrepancyQuotient
    (μ ν : Measure ℝ) [IsFiniteMeasure μ] [IsFiniteMeasure ν] :
    StronglyMeasurable (charFunDiscrepancyQuotient μ ν) := by
  unfold charFunDiscrepancyQuotient
  exact (Measurable.ite (measurableSet_singleton 0) measurable_const
    (by fun_prop)).stronglyMeasurable

theorem charFunDiscrepancyQuotient_le_firstMoments
    {μ ν : Measure ℝ} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμ1 : Integrable (fun x : ℝ => |x|) μ)
    (hν1 : Integrable (fun x : ℝ => |x|) ν) (t : ℝ) :
    charFunDiscrepancyQuotient μ ν t ≤
      (∫ x, |x| ∂μ) + ∫ x, |x| ∂ν := by
  rw [charFunDiscrepancyQuotient]
  split_ifs with ht
  · exact add_nonneg (integral_nonneg fun _ => abs_nonneg _)
      (integral_nonneg fun _ => abs_nonneg _)
  · rw [div_le_iff₀ (abs_pos.mpr ht)]
    simpa only [mul_comm] using
      norm_charFun_sub_charFun_le_firstMoments hμ1 hν1 t

/-- Under finite first moments the discrepancy quotient is integrable on
every bounded interval, so the truncated Esseen integral is well-defined. -/
theorem intervalIntegrable_charFunDiscrepancyQuotient
    {μ ν : Measure ℝ} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμ1 : Integrable (fun x : ℝ => |x|) μ)
    (hν1 : Integrable (fun x : ℝ => |x|) ν) (a b : ℝ) :
    IntervalIntegrable (charFunDiscrepancyQuotient μ ν) volume a b := by
  let M : ℝ := (∫ x, |x| ∂μ) + ∫ x, |x| ∂ν
  have hM : IntervalIntegrable (fun _ : ℝ => M) volume a b :=
    intervalIntegrable_const
  refine hM.mono_fun' ?_ ?_
  · exact (stronglyMeasurable_charFunDiscrepancyQuotient μ ν).aestronglyMeasurable
  · exact ae_of_all (volume.restrict (uIoc a b)) fun t => by
      change |charFunDiscrepancyQuotient μ ν t| ≤ M
      rw [abs_of_nonneg (charFunDiscrepancyQuotient_nonneg μ ν t)]
      simpa only [M] using
        charFunDiscrepancyQuotient_le_firstMoments hμ1 hν1 t

/-- Exact standard-normal CDF increment as an interval integral of its
density. -/
theorem standardNormalCDF_sub_eq_integral
    {a b : ℝ} (hab : a ≤ b) :
    cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw b -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw a =
      ∫ x in a..b, ProbabilityTheory.gaussianPDFReal 0 1 x := by
  open NumStability.HDP.Scalar.LimitTheorems in
  rw [cdf_eq_real, cdf_eq_real]
  have hsubset : Iic a ⊆ Iic b := Iic_subset_Iic.mpr hab
  rw [← measureReal_diff hsubset measurableSet_Iic]
  have hdiff : Iic b \ Iic a = Ioc a b := by
    ext x
    simp only [mem_diff, mem_Iic, mem_Ioc, not_le]
    tauto
  rw [hdiff, standardNormalLaw, Measure.real_def,
    gaussianReal_apply_eq_integral 0 (by norm_num : (1 : NNReal) ≠ 0) (Ioc a b)]
  rw [ENNReal.toReal_ofReal
    (integral_nonneg fun x => gaussianPDFReal_nonneg 0 1 x)]
  exact (intervalIntegral.integral_of_le hab).symm

theorem standardNormalCDF_eq_add_integral (a b : ℝ) :
    cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw b =
      cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw a +
        ∫ x in a..b, ProbabilityTheory.gaussianPDFReal 0 1 x := by
  rcases le_total a b with hab | hba
  · have h := standardNormalCDF_sub_eq_integral hab
    linarith
  · have h := standardNormalCDF_sub_eq_integral hba
    rw [intervalIntegral.integral_symm]
    linarith

theorem hasDerivAt_standardNormalCDF (x : ℝ) :
    HasDerivAt
      (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
      (ProbabilityTheory.gaussianPDFReal 0 1 x) x := by
  have hfun :
      cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw =
        fun u => cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x +
          ∫ t in x..u, ProbabilityTheory.gaussianPDFReal 0 1 t := by
    funext u
    exact standardNormalCDF_eq_add_integral x u
  rw [hfun]
  convert (hasDerivAt_const x
    (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x)).add
      (intervalIntegral.integral_hasDerivAt_right
        (ProbabilityTheory.integrable_gaussianPDFReal 0 1).intervalIntegrable
        (ProbabilityTheory.stronglyMeasurable_gaussianPDFReal 0 1).stronglyMeasurableAtFilter
        (by rw [ProbabilityTheory.gaussianPDFReal_def]; fun_prop)) using 1; simp

/-- The standard-normal density exactly cancels the integrating factor in
the Stein equation. -/
theorem sqrt_two_pi_mul_exp_half_sq_mul_standardNormalPDF (z : ℝ) :
    Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
        ProbabilityTheory.gaussianPDFReal 0 1 z = 1 := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_pdf]
  have hsqrt : Real.sqrt (2 * Real.pi) ≠ 0 := by positivity
  calc
    Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
        ((Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-(z ^ 2) / 2)) =
      (Real.sqrt (2 * Real.pi) * (Real.sqrt (2 * Real.pi))⁻¹) *
        (Real.exp (z ^ 2 / 2) * Real.exp (-(z ^ 2) / 2)) := by ring
    _ = 1 := by
      rw [mul_inv_cancel₀ hsqrt, ← Real.exp_add,
        show z ^ 2 / 2 + -(z ^ 2) / 2 = 0 by ring, Real.exp_zero]
      norm_num

/-- Lower branch of the standard-normal Stein solution for the half-line
test at threshold `x`. -/
noncomputable def standardNormalSteinLower (x z : ℝ) : ℝ :=
  Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
    cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z *
    (1 - cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x)

/-- Upper branch of the standard-normal Stein solution for the half-line
test at threshold `x`. -/
noncomputable def standardNormalSteinUpper (x z : ℝ) : ℝ :=
  Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
    cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x *
    (1 - cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z)

theorem standardNormalSteinLower_eq_upper (x : ℝ) :
    standardNormalSteinLower x x = standardNormalSteinUpper x x := by
  unfold standardNormalSteinLower standardNormalSteinUpper
  ring

/-- The lower branch solves the half-line Stein equation. -/
theorem hasDerivAt_standardNormalSteinLower (x z : ℝ) :
    HasDerivAt (standardNormalSteinLower x)
      (z * standardNormalSteinLower x z +
        (1 - cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x)) z := by
  have hinner : HasDerivAt (fun y : ℝ => y ^ 2 / 2) z z := by
    convert ((hasDerivAt_id z).pow 2).div_const 2 using 1; simp
  have hexp : HasDerivAt (fun y : ℝ => Real.exp (y ^ 2 / 2))
      (Real.exp (z ^ 2 / 2) * z) z := by
    convert (Real.hasDerivAt_exp (z ^ 2 / 2)).comp z hinner using 1
  have h :=
    (((hexp.const_mul (Real.sqrt (2 * Real.pi))).mul
      (hasDerivAt_standardNormalCDF z)).mul_const
        (1 - cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x))
  convert h using 1
  · rw [sqrt_two_pi_mul_exp_half_sq_mul_standardNormalPDF]
    unfold standardNormalSteinLower
    ring

/-- The upper branch solves the complementary half-line Stein equation. -/
theorem hasDerivAt_standardNormalSteinUpper (x z : ℝ) :
    HasDerivAt (standardNormalSteinUpper x)
      (z * standardNormalSteinUpper x z -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x) z := by
  have hinner : HasDerivAt (fun y : ℝ => y ^ 2 / 2) z z := by
    convert ((hasDerivAt_id z).pow 2).div_const 2 using 1; simp
  have hexp : HasDerivAt (fun y : ℝ => Real.exp (y ^ 2 / 2))
      (Real.exp (z ^ 2 / 2) * z) z := by
    convert (Real.hasDerivAt_exp (z ^ 2 / 2)).comp z hinner using 1
  have honeSub := (hasDerivAt_const z 1).sub (hasDerivAt_standardNormalCDF z)
  have h :=
    (((hexp.const_mul (Real.sqrt (2 * Real.pi))).mul_const
      (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x)).mul honeSub)
  convert h using 1
  unfold standardNormalSteinUpper
  have hcancel := sqrt_two_pi_mul_exp_half_sq_mul_standardNormalPDF z
  calc
    z * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x *
          (1 - cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z)) -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x =
      z * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x *
          (1 - cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z)) -
        (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          ProbabilityTheory.gaussianPDFReal 0 1 z) *
          cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x := by
        rw [hcancel]
        ring
    _ = _ := by
      simp only [Pi.sub_apply]
      ring

theorem continuous_standardNormalCDF :
    Continuous
      (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
  rw [continuous_iff_continuousAt]
  exact fun z => (hasDerivAt_standardNormalCDF z).continuousAt

/-- The continuous half-line Stein solution, obtained by joining the two
closed-form branches at the threshold. -/
noncomputable def standardNormalSteinSolution (x z : ℝ) : ℝ :=
  if z ≤ x then standardNormalSteinLower x z else standardNormalSteinUpper x z

theorem standardNormalSteinSolution_of_le {x z : ℝ} (hz : z ≤ x) :
    standardNormalSteinSolution x z = standardNormalSteinLower x z := by
  simp only [standardNormalSteinSolution, if_pos hz]

theorem standardNormalSteinSolution_of_lt {x z : ℝ} (hz : x < z) :
    standardNormalSteinSolution x z = standardNormalSteinUpper x z := by
  simp only [standardNormalSteinSolution, if_neg (not_le.mpr hz)]

theorem continuous_standardNormalSteinSolution (x : ℝ) :
    Continuous (standardNormalSteinSolution x) := by
  have hlower : Continuous (standardNormalSteinLower x) := by
    unfold standardNormalSteinLower
    exact (((continuous_const.mul (by fun_prop : Continuous
      (fun z : ℝ => Real.exp (z ^ 2 / 2)))).mul
        continuous_standardNormalCDF).mul continuous_const)
  have hupper : Continuous (standardNormalSteinUpper x) := by
    unfold standardNormalSteinUpper
    exact (((continuous_const.mul (by fun_prop : Continuous
      (fun z : ℝ => Real.exp (z ^ 2 / 2)))).mul continuous_const).mul
        (continuous_const.sub continuous_standardNormalCDF))
  unfold standardNormalSteinSolution
  apply continuous_if_le continuous_id continuous_const
    hlower.continuousOn hupper.continuousOn
  intro z hz
  have hzx : z = x := by simpa using hz
  subst z
  exact standardNormalSteinLower_eq_upper x

/-- Away from the threshold, the joined solution satisfies the lower branch
of the half-line Stein equation. -/
theorem hasDerivAt_standardNormalSteinSolution_of_lt
    {x z : ℝ} (hz : z < x) :
    HasDerivAt (standardNormalSteinSolution x)
      (z * standardNormalSteinSolution x z +
        (1 - cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x)) z := by
  have heq : standardNormalSteinSolution x =ᶠ[𝓝 z]
      standardNormalSteinLower x := by
    filter_upwards [eventually_le_nhds hz] with y hy
    exact standardNormalSteinSolution_of_le hy
  have h := (hasDerivAt_standardNormalSteinLower x z).congr_of_eventuallyEq heq
  simpa only [standardNormalSteinSolution_of_le hz.le] using h

/-- Away from the threshold, the joined solution satisfies the upper branch
of the half-line Stein equation. -/
theorem hasDerivAt_standardNormalSteinSolution_of_gt
    {x z : ℝ} (hz : x < z) :
    HasDerivAt (standardNormalSteinSolution x)
      (z * standardNormalSteinSolution x z -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x) z := by
  have heq : standardNormalSteinSolution x =ᶠ[𝓝 z]
      standardNormalSteinUpper x := by
    filter_upwards [eventually_gt_nhds hz] with y hy
    exact standardNormalSteinSolution_of_lt hy
  have h := (hasDerivAt_standardNormalSteinUpper x z).congr_of_eventuallyEq heq
  simpa only [standardNormalSteinSolution_of_lt hz] using h

/-- Centered half-line test appearing on the right side of the standard-normal
Stein equation. -/
noncomputable def standardNormalHalfLineSteinTarget (x z : ℝ) : ℝ :=
  if z ≤ x then
    1 - cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x
  else
    -cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x

theorem measurable_standardNormalHalfLineSteinTarget (x : ℝ) :
    Measurable (standardNormalHalfLineSteinTarget x) := by
  unfold standardNormalHalfLineSteinTarget
  exact Measurable.ite measurableSet_Iic measurable_const measurable_const

theorem abs_standardNormalHalfLineSteinTarget_le_one (x z : ℝ) :
    |standardNormalHalfLineSteinTarget x z| ≤ 1 := by
  unfold standardNormalHalfLineSteinTarget
  split_ifs
  · rw [abs_of_nonneg (sub_nonneg.mpr
      (cdf_le_one NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x))]
    linarith [cdf_nonneg
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x]
  · rw [abs_neg, abs_of_nonneg (cdf_nonneg
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x)]
    exact cdf_le_one NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x

theorem standardNormalSteinSolution_nonneg (x z : ℝ) :
    0 ≤ standardNormalSteinSolution x z := by
  unfold standardNormalSteinSolution
  split_ifs
  · unfold standardNormalSteinLower
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (Real.sqrt_nonneg _) (Real.exp_pos _).le)
        (cdf_nonneg NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z))
      (sub_nonneg.mpr
        (cdf_le_one NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x))
  · unfold standardNormalSteinUpper
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (Real.sqrt_nonneg _) (Real.exp_pos _).le)
        (cdf_nonneg NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x))
      (sub_nonneg.mpr
        (cdf_le_one NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw z))

/-- Pointwise Stein identity away from the half-line threshold. -/
theorem deriv_standardNormalSteinSolution_sub_mul
    {x z : ℝ} (hz : z ≠ x) :
    deriv (standardNormalSteinSolution x) z -
        z * standardNormalSteinSolution x z =
      standardNormalHalfLineSteinTarget x z := by
  rcases lt_or_gt_of_ne hz with hzx | hxz
  · rw [(hasDerivAt_standardNormalSteinSolution_of_lt hzx).deriv]
    simp only [standardNormalHalfLineSteinTarget, if_pos hzx.le]
    ring
  · rw [(hasDerivAt_standardNormalSteinSolution_of_gt hxz).deriv]
    simp only [standardNormalHalfLineSteinTarget, if_neg (not_le.mpr hxz)]
    ring

/-- Almost-everywhere Stein identity in the Lebesgue form used for integration
and leave-one-out arguments. -/
theorem ae_deriv_standardNormalSteinSolution_sub_mul (x : ℝ) :
    ∀ᵐ z ∂volume,
      deriv (standardNormalSteinSolution x) z -
          z * standardNormalSteinSolution x z =
        standardNormalHalfLineSteinTarget x z := by
  filter_upwards [(volume : Measure ℝ).ae_ne x] with z hz
  exact deriv_standardNormalSteinSolution_sub_mul hz

/-- Total derivative representative for Stein expectations.  Unlike the
analytic derivative, this definition also fixes the value at the threshold,
where an arbitrary comparison law may have an atom. -/
noncomputable def standardNormalSteinDerivative (x z : ℝ) : ℝ :=
  z * standardNormalSteinSolution x z + standardNormalHalfLineSteinTarget x z

theorem standardNormalSteinDerivative_eq_deriv
    {x z : ℝ} (hz : z ≠ x) :
    standardNormalSteinDerivative x z =
      deriv (standardNormalSteinSolution x) z := by
  have h := deriv_standardNormalSteinSolution_sub_mul hz
  unfold standardNormalSteinDerivative
  linarith

theorem standardNormalHalfLineSteinTarget_eq_derivative_sub_mul (x z : ℝ) :
    standardNormalHalfLineSteinTarget x z =
      standardNormalSteinDerivative x z -
        z * standardNormalSteinSolution x z := by
  unfold standardNormalSteinDerivative
  ring

theorem integrable_standardNormalHalfLineSteinTarget
    (nu : Measure ℝ) [IsProbabilityMeasure nu] (x : ℝ) :
    Integrable (standardNormalHalfLineSteinTarget x) nu := by
  apply Integrable.of_bound
    (measurable_standardNormalHalfLineSteinTarget x).aestronglyMeasurable 1
  exact ae_of_all nu fun z => by
    rw [Real.norm_eq_abs]
    exact abs_standardNormalHalfLineSteinTarget_le_one x z

/-- The expectation of the centered half-line Stein target under an arbitrary
probability law is exactly its CDF gap from the standard normal. -/
theorem integral_standardNormalHalfLineSteinTarget_eq_cdf_sub
    (nu : Measure ℝ) [IsProbabilityMeasure nu] (x : ℝ) :
    (∫ z, standardNormalHalfLineSteinTarget x z ∂nu) =
      cdf nu x -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x := by
  have hInd : Integrable
      ((Iic x).indicator (fun _ : ℝ => (1 : ℝ))) nu :=
    (integrable_const (1 : ℝ)).indicator measurableSet_Iic
  have hfun : standardNormalHalfLineSteinTarget x = fun z =>
      (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) z -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x := by
    funext z
    unfold standardNormalHalfLineSteinTarget
    simp only [Set.indicator_apply, mem_Iic]
    by_cases hz : z ≤ x <;> simp [hz]
  have hIntInd :
      (∫ z, (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) z ∂nu) =
        nu.real (Iic x) := integral_indicator_one measurableSet_Iic
  have hCDFnu : cdf nu x = nu.real (Iic x) := cdf_eq_real nu x
  have hCDFnormal :
      cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x =
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw.real (Iic x) :=
    cdf_eq_real NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x
  rw [hfun, integral_sub hInd (integrable_const _),
    hIntInd, integral_const,
    probReal_univ, one_smul, hCDFnu, hCDFnormal]

section SteinBounds

open NumStability.HDP.Scalar.LimitTheorems

/-- Standard-normal reflection identifies its lower CDF with the opposite
closed upper tail. -/
theorem standardNormalCDF_eq_tail_neg (z : ℝ) :
    cdf standardNormalLaw z = standardNormalLaw.real (Ici (-z)) := by
  rw [cdf_eq_real]
  have hmap : standardNormalLaw.map (fun y : ℝ => -y) = standardNormalLaw := by
    simpa [standardNormalLaw] using
      (ProbabilityTheory.gaussianReal_map_neg (μ := (0 : ℝ)) (v := (1 : ℝ≥0)))
  calc
    standardNormalLaw.real (Iic z) =
        (standardNormalLaw.map (fun y : ℝ => -y)).real (Iic z) := by rw [hmap]
    _ = standardNormalLaw.real (Ici (-z)) := by
      simp only [Measure.real_def,
        Measure.map_apply (by fun_prop : Measurable (fun y : ℝ => -y)) measurableSet_Iic,
        neg_preimage, neg_Iic]

/-- The upper Mills-ratio estimate cancels the standard-normal integrating
factor outside the unit interval. -/
theorem sqrt_two_pi_mul_exp_mul_standardNormalTail_le_one
    (t : ℝ) (ht : 1 ≤ t) :
    Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        standardNormalLaw.real (Ici t) ≤ 1 := by
  have htail :=
    NumStability.HDP.Scalar.GaussianTails.standardNormalTail_le_density t ht
  have hfactor : 0 ≤ Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) := by
    positivity
  calc
    Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        standardNormalLaw.real (Ici t) ≤
      Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        ((Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-(t ^ 2) / 2)) :=
      mul_le_mul_of_nonneg_left htail hfactor
    _ = 1 := by
      have hsqrt : Real.sqrt (2 * Real.pi) ≠ 0 := by positivity
      rw [mul_mul_mul_comm, mul_inv_cancel₀ hsqrt, one_mul, ← Real.exp_add]
      have hzero : t ^ 2 / 2 + -(t ^ 2) / 2 = 0 := by ring
      rw [hzero, Real.exp_zero]

/-- CDF-complement version of the upper Mills-ratio cancellation bound. -/
theorem sqrt_two_pi_mul_exp_mul_one_sub_standardNormalCDF_le_one
    (t : ℝ) (ht : 1 ≤ t) :
    Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        (1 - cdf standardNormalLaw t) ≤ 1 := by
  have hopen : 1 - cdf standardNormalLaw t =
      standardNormalLaw.real (Ioi t) := by
    rw [cdf_eq_real, ← probReal_compl_eq_one_sub measurableSet_Iic, compl_Iic]
  rw [hopen]
  calc
    Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        standardNormalLaw.real (Ioi t) ≤
      Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        standardNormalLaw.real (Ici t) := by
      apply mul_le_mul_of_nonneg_left
      · exact measureReal_mono Ioi_subset_Ici_self
      · positivity
    _ ≤ 1 := sqrt_two_pi_mul_exp_mul_standardNormalTail_le_one t ht

/-- Reflected lower-tail version of the Mills-ratio cancellation bound. -/
theorem sqrt_two_pi_mul_exp_mul_standardNormalCDF_le_one
    (t : ℝ) (ht : t ≤ -1) :
    Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        cdf standardNormalLaw t ≤ 1 := by
  rw [standardNormalCDF_eq_tail_neg]
  simpa only [neg_sq] using
    sqrt_two_pi_mul_exp_mul_standardNormalTail_le_one (-t) (by linarith)

/-- The sharp Mills-ratio cancellation with the extra positive location
factor.  Unlike the coarser tail bound above, this holds all the way down to
zero. -/
theorem mul_sqrt_two_pi_mul_exp_mul_standardNormalTail_le_one
    (t : ℝ) (ht : 0 < t) :
    t * (Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        standardNormalLaw.real (Ici t)) ≤ 1 := by
  have htail :=
    (NumStability.HDP.Scalar.GaussianTails.standardNormalTail_bounds t ht).2
  have hsqrt : Real.sqrt (2 * Real.pi) ≠ 0 := by positivity
  have ht0 : t ≠ 0 := ne_of_gt ht
  have hfactor : 0 ≤ t *
      (Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2)) := by positivity
  calc
    t * (Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        standardNormalLaw.real (Ici t)) =
      (t * (Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2))) *
        standardNormalLaw.real (Ici t) := by ring
    _ ≤ (t * (Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2))) *
        ((Real.sqrt (2 * Real.pi))⁻¹ *
          ((1 / t) * Real.exp (-(t ^ 2) / 2))) :=
      mul_le_mul_of_nonneg_left htail hfactor
    _ = 1 := by
      rw [one_div]
      calc
        (t * (Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2))) *
            ((Real.sqrt (2 * Real.pi))⁻¹ *
              (t⁻¹ * Real.exp (-(t ^ 2) / 2))) =
          (t * t⁻¹) *
            (Real.sqrt (2 * Real.pi) * (Real.sqrt (2 * Real.pi))⁻¹) *
            (Real.exp (t ^ 2 / 2) * Real.exp (-(t ^ 2) / 2)) := by ring
        _ = 1 := by
          rw [mul_inv_cancel₀ ht0, mul_inv_cancel₀ hsqrt, ← Real.exp_add]
          rw [show t ^ 2 / 2 + -(t ^ 2) / 2 = 0 by ring, Real.exp_zero]
          norm_num

/-- CDF-complement form of the sharp positive-location cancellation. -/
theorem mul_sqrt_two_pi_mul_exp_mul_one_sub_standardNormalCDF_le_one
    (t : ℝ) (ht : 0 < t) :
    t * (Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        (1 - cdf standardNormalLaw t)) ≤ 1 := by
  have hopen : 1 - cdf standardNormalLaw t =
      standardNormalLaw.real (Ioi t) := by
    rw [cdf_eq_real, ← probReal_compl_eq_one_sub measurableSet_Iic, compl_Iic]
  rw [hopen]
  calc
    t * (Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        standardNormalLaw.real (Ioi t)) ≤
      t * (Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        standardNormalLaw.real (Ici t)) := by
      apply mul_le_mul_of_nonneg_left
      · apply mul_le_mul_of_nonneg_left
        · exact measureReal_mono Ioi_subset_Ici_self
        · positivity
      · exact ht.le
    _ ≤ 1 := mul_sqrt_two_pi_mul_exp_mul_standardNormalTail_le_one t ht

/-- Reflected sharp Mills-ratio cancellation for a negative location. -/
theorem neg_mul_sqrt_two_pi_mul_exp_mul_standardNormalCDF_le_one
    (t : ℝ) (ht : t < 0) :
    (-t) * (Real.sqrt (2 * Real.pi) * Real.exp (t ^ 2 / 2) *
        cdf standardNormalLaw t) ≤ 1 := by
  rw [standardNormalCDF_eq_tail_neg]
  simpa only [neg_sq] using
    mul_sqrt_two_pi_mul_exp_mul_standardNormalTail_le_one (-t) (by linarith)

/-- At a negative location, the magnitude of the linear part of the Stein
solution is controlled by the upper tail at the test threshold. -/
theorem neg_mul_standardNormalSteinSolution_le_one_sub_cdf
    (x z : ℝ) (hz : z < 0) :
    (-z) * standardNormalSteinSolution x z ≤
      1 - cdf standardNormalLaw x := by
  have hcancel :=
    neg_mul_sqrt_two_pi_mul_exp_mul_standardNormalCDF_le_one z hz
  unfold standardNormalSteinSolution
  split_ifs with hzx
  · unfold standardNormalSteinLower
    calc
      (-z) * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf standardNormalLaw z * (1 - cdf standardNormalLaw x)) =
        ((-z) * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf standardNormalLaw z)) * (1 - cdf standardNormalLaw x) := by ring
      _ ≤ 1 * (1 - cdf standardNormalLaw x) :=
        mul_le_mul_of_nonneg_right hcancel
          (sub_nonneg.mpr (cdf_le_one standardNormalLaw x))
      _ = 1 - cdf standardNormalLaw x := one_mul _
  · have hxz : x < z := lt_of_not_ge hzx
    have hmono : cdf standardNormalLaw x ≤ cdf standardNormalLaw z :=
      monotone_cdf standardNormalLaw hxz.le
    have hfactor : 0 ≤ (-z) *
        (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2)) :=
      mul_nonneg (neg_nonneg.mpr hz.le) (by positivity)
    have hcancel' :
        ((-z) * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2))) *
          cdf standardNormalLaw z ≤ 1 := by
      simpa only [mul_assoc] using hcancel
    have htail : 0 ≤ 1 - cdf standardNormalLaw z :=
      sub_nonneg.mpr (cdf_le_one standardNormalLaw z)
    unfold standardNormalSteinUpper
    calc
      (-z) * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf standardNormalLaw x * (1 - cdf standardNormalLaw z)) =
        (((-z) * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2))) *
          cdf standardNormalLaw x) * (1 - cdf standardNormalLaw z) := by ring
      _ ≤ (((-z) * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2))) *
          cdf standardNormalLaw z) * (1 - cdf standardNormalLaw z) := by
        exact mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hmono hfactor) htail
      _ ≤ 1 * (1 - cdf standardNormalLaw z) :=
        mul_le_mul_of_nonneg_right hcancel' htail
      _ ≤ 1 * (1 - cdf standardNormalLaw x) := by linarith
      _ = 1 - cdf standardNormalLaw x := one_mul _

/-- At a positive location, the linear part of the Stein solution is
controlled by the lower probability at the test threshold. -/
theorem mul_standardNormalSteinSolution_le_cdf
    (x z : ℝ) (hz : 0 < z) :
    z * standardNormalSteinSolution x z ≤ cdf standardNormalLaw x := by
  have hcancel :=
    mul_sqrt_two_pi_mul_exp_mul_one_sub_standardNormalCDF_le_one z hz
  unfold standardNormalSteinSolution
  split_ifs with hzx
  · have hmono : cdf standardNormalLaw z ≤ cdf standardNormalLaw x :=
      monotone_cdf standardNormalLaw hzx
    have hfactor : 0 ≤ z *
        (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2)) := by positivity
    have hp : 0 ≤ cdf standardNormalLaw z := cdf_nonneg standardNormalLaw z
    have hcancel' :
        (z * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2))) *
          (1 - cdf standardNormalLaw z) ≤ 1 := by
      simpa only [mul_assoc] using hcancel
    have htail : 1 - cdf standardNormalLaw x ≤
        1 - cdf standardNormalLaw z := by linarith
    unfold standardNormalSteinLower
    calc
      z * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf standardNormalLaw z * (1 - cdf standardNormalLaw x)) =
        cdf standardNormalLaw z *
          ((z * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2))) *
            (1 - cdf standardNormalLaw x)) := by ring
      _ ≤ cdf standardNormalLaw z *
          ((z * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2))) *
            (1 - cdf standardNormalLaw z)) := by
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left htail hfactor) hp
      _ ≤ cdf standardNormalLaw z * 1 :=
        mul_le_mul_of_nonneg_left hcancel' hp
      _ ≤ cdf standardNormalLaw x := by simpa using hmono
  · have hp : 0 ≤ cdf standardNormalLaw x := cdf_nonneg standardNormalLaw x
    unfold standardNormalSteinUpper
    calc
      z * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf standardNormalLaw x * (1 - cdf standardNormalLaw z)) =
        cdf standardNormalLaw x *
          (z * (Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
            (1 - cdf standardNormalLaw z))) := by ring
      _ ≤ cdf standardNormalLaw x * 1 :=
        mul_le_mul_of_nonneg_left hcancel hp
      _ = cdf standardNormalLaw x := mul_one _

/-- The total half-line Stein derivative has the classical sharp uniform
bound, including at the threshold where its value was fixed explicitly. -/
theorem abs_standardNormalSteinDerivative_le_one (x z : ℝ) :
    |standardNormalSteinDerivative x z| ≤ 1 := by
  unfold standardNormalSteinDerivative standardNormalHalfLineSteinTarget
  by_cases hzx : z ≤ x
  · simp only [if_pos hzx]
    by_cases hz0 : z = 0
    · subst z
      simp only [zero_mul, zero_add]
      rw [abs_of_nonneg (sub_nonneg.mpr (cdf_le_one standardNormalLaw x))]
      linarith [cdf_nonneg standardNormalLaw x]
    · rcases lt_or_gt_of_ne hz0 with hz | hz
      · have hlin := neg_mul_standardNormalSteinSolution_le_one_sub_cdf x z hz
        have hf := standardNormalSteinSolution_nonneg x z
        have hnonneg : 0 ≤ z * standardNormalSteinSolution x z +
            (1 - cdf standardNormalLaw x) := by
          nlinarith
        rw [abs_of_nonneg hnonneg]
        have hmul : z * standardNormalSteinSolution x z ≤ 0 :=
          mul_nonpos_of_nonpos_of_nonneg hz.le hf
        linarith [cdf_nonneg standardNormalLaw x]
      · have hlin := mul_standardNormalSteinSolution_le_cdf x z hz
        have hf := standardNormalSteinSolution_nonneg x z
        have hnonneg : 0 ≤ z * standardNormalSteinSolution x z +
            (1 - cdf standardNormalLaw x) :=
          add_nonneg (mul_nonneg hz.le hf)
            (sub_nonneg.mpr (cdf_le_one standardNormalLaw x))
        rw [abs_of_nonneg hnonneg]
        linarith
  · simp only [if_neg hzx]
    by_cases hz0 : z = 0
    · subst z
      simp only [zero_mul, zero_add, abs_neg]
      rw [abs_of_nonneg (cdf_nonneg standardNormalLaw x)]
      exact cdf_le_one standardNormalLaw x
    · rcases lt_or_gt_of_ne hz0 with hz | hz
      · have hlin := neg_mul_standardNormalSteinSolution_le_one_sub_cdf x z hz
        have hf := standardNormalSteinSolution_nonneg x z
        have hnonpos : z * standardNormalSteinSolution x z +
            -cdf standardNormalLaw x ≤ 0 := by
          have hmul : z * standardNormalSteinSolution x z ≤ 0 :=
            mul_nonpos_of_nonpos_of_nonneg hz.le hf
          linarith [cdf_nonneg standardNormalLaw x]
        rw [abs_of_nonpos hnonpos]
        nlinarith
      · have hlin := mul_standardNormalSteinSolution_le_cdf x z hz
        have hf := standardNormalSteinSolution_nonneg x z
        have hnonpos : z * standardNormalSteinSolution x z +
            -cdf standardNormalLaw x ≤ 0 := by linarith
        rw [abs_of_nonpos hnonpos]
        have hmul : 0 ≤ z * standardNormalSteinSolution x z :=
          mul_nonneg hz.le hf
        linarith [cdf_le_one standardNormalLaw x]

/-- A coarse universal bound for the half-line Stein solution.  Sharpness is
not needed here; this bound is chosen to make first-moment integrability
immediate. -/
theorem standardNormalSteinSolution_le (x z : ℝ) :
    standardNormalSteinSolution x z ≤
      Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) := by
  let C : ℝ := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
  have hC : 1 ≤ C := by
    dsimp [C]
    have hsqrt : 1 ≤ Real.sqrt (2 * Real.pi) := by
      rw [Real.one_le_sqrt]
      nlinarith [Real.two_le_pi]
    have hexp : 1 ≤ Real.exp (1 / 2 : ℝ) := Real.one_le_exp (by norm_num)
    nlinarith [mul_le_mul hsqrt hexp (by norm_num : (0 : ℝ) ≤ 1)
      (Real.sqrt_nonneg (2 * Real.pi))]
  have hsolution : standardNormalSteinSolution x z ≤
      Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
        cdf standardNormalLaw z * (1 - cdf standardNormalLaw z) := by
    unfold standardNormalSteinSolution
    split_ifs with hzx
    · unfold standardNormalSteinLower
      have hmono := monotone_cdf standardNormalLaw hzx
      have hpref : 0 ≤ Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf standardNormalLaw z :=
        mul_nonneg (mul_nonneg (Real.sqrt_nonneg _) (Real.exp_pos _).le)
          (cdf_nonneg _ _)
      exact mul_le_mul_of_nonneg_left (by linarith) hpref
    · unfold standardNormalSteinUpper
      have hmono := monotone_cdf standardNormalLaw (le_of_not_ge hzx)
      have hfactor : 0 ≤ Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) := by
        positivity
      have hprefix := mul_le_mul_of_nonneg_left hmono hfactor
      exact mul_le_mul_of_nonneg_right hprefix
        (sub_nonneg.mpr (cdf_le_one standardNormalLaw z))
  apply hsolution.trans
  by_cases hzlo : z ≤ -1
  · calc
      Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf standardNormalLaw z * (1 - cdf standardNormalLaw z) ≤
        Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf standardNormalLaw z * 1 := by
        apply mul_le_mul_of_nonneg_left
        · linarith [cdf_nonneg standardNormalLaw z]
        · exact mul_nonneg
            (mul_nonneg (Real.sqrt_nonneg _) (Real.exp_pos _).le)
            (cdf_nonneg _ _)
      _ = Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf standardNormalLaw z := by ring
      _ ≤ 1 := sqrt_two_pi_mul_exp_mul_standardNormalCDF_le_one z hzlo
      _ ≤ C := hC
  · by_cases hzhi : 1 ≤ z
    · calc
        Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
            cdf standardNormalLaw z * (1 - cdf standardNormalLaw z) ≤
          Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
            1 * (1 - cdf standardNormalLaw z) := by
          apply mul_le_mul_of_nonneg_right
          · apply mul_le_mul_of_nonneg_left
            exact cdf_le_one standardNormalLaw z
            positivity
          · exact sub_nonneg.mpr (cdf_le_one standardNormalLaw z)
        _ = Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
            (1 - cdf standardNormalLaw z) := by ring
        _ ≤ 1 :=
          sqrt_two_pi_mul_exp_mul_one_sub_standardNormalCDF_le_one z hzhi
        _ ≤ C := hC
    · have hzlower : -1 ≤ z := by linarith
      have hzupper : z ≤ 1 := by linarith
      have hzsq : z ^ 2 ≤ 1 := by
        nlinarith [mul_nonneg (by linarith : 0 ≤ z + 1) (by linarith : 0 ≤ 1 - z)]
      have hexp : Real.exp (z ^ 2 / 2) ≤ Real.exp (1 / 2 : ℝ) :=
        Real.exp_le_exp.mpr (by linarith)
      have hA : 0 ≤ Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) := by
        positivity
      have hPnonneg : 0 ≤ cdf standardNormalLaw z := cdf_nonneg _ _
      have hQnonneg : 0 ≤ 1 - cdf standardNormalLaw z :=
        sub_nonneg.mpr (cdf_le_one _ _)
      have hPle : cdf standardNormalLaw z ≤ 1 := cdf_le_one _ _
      have hQle : 1 - cdf standardNormalLaw z ≤ 1 := by
        linarith [cdf_nonneg standardNormalLaw z]
      have hAP : Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
          cdf standardNormalLaw z ≤
          Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) * 1 :=
        mul_le_mul_of_nonneg_left hPle hA
      calc
        Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) *
            cdf standardNormalLaw z * (1 - cdf standardNormalLaw z) ≤
          Real.sqrt (2 * Real.pi) * Real.exp (z ^ 2 / 2) * 1 * 1 :=
            mul_le_mul hAP hQle hQnonneg (mul_nonneg hA zero_le_one)
        _ ≤ Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) * 1 * 1 := by
          gcongr
        _ = C := by simp [C]

theorem integrable_standardNormalSteinSolution
    (nu : Measure ℝ) [IsProbabilityMeasure nu] (x : ℝ) :
    Integrable (standardNormalSteinSolution x) nu := by
  let C : ℝ := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
  apply Integrable.of_bound
    (continuous_standardNormalSteinSolution x).aestronglyMeasurable C
  exact ae_of_all nu fun z => by
    rw [Real.norm_eq_abs, abs_of_nonneg (standardNormalSteinSolution_nonneg x z)]
    exact standardNormalSteinSolution_le x z

theorem measurable_standardNormalSteinDerivative (x : ℝ) :
    Measurable (standardNormalSteinDerivative x) := by
  unfold standardNormalSteinDerivative
  exact (measurable_id.mul
    (continuous_standardNormalSteinSolution x).measurable).add
      (measurable_standardNormalHalfLineSteinTarget x)

theorem integrable_mul_standardNormalSteinSolution
    (nu : Measure ℝ) (x : ℝ)
    (hfirst : Integrable (fun z : ℝ => |z|) nu) :
    Integrable (fun z => z * standardNormalSteinSolution x z) nu := by
  let C : ℝ := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
  have hmajor : Integrable (fun z : ℝ => C * |z|) nu := hfirst.const_mul C
  apply hmajor.mono'
    (measurable_id.mul
      (continuous_standardNormalSteinSolution x).measurable).aestronglyMeasurable
  exact ae_of_all nu fun z => by
    rw [Real.norm_eq_abs, abs_mul,
      abs_of_nonneg (standardNormalSteinSolution_nonneg x z)]
    dsimp [C]
    nlinarith [mul_le_mul_of_nonneg_left
      (standardNormalSteinSolution_le x z) (abs_nonneg z)]

theorem integrable_standardNormalSteinDerivative
    (nu : Measure ℝ) [IsProbabilityMeasure nu] (x : ℝ)
    (hfirst : Integrable (fun z : ℝ => |z|) nu) :
    Integrable (standardNormalSteinDerivative x) nu := by
  unfold standardNormalSteinDerivative
  exact (integrable_mul_standardNormalSteinSolution nu x hfirst).add
    (integrable_standardNormalHalfLineSteinTarget nu x)

/-- The sharp derivative bound makes every measurable pullback integrable on
a probability space, without a moment hypothesis. -/
theorem integrable_standardNormalSteinDerivative_comp
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (Y : Omega → ℝ) (hY : AEMeasurable Y mu) (x : ℝ) :
    Integrable (fun omega => standardNormalSteinDerivative x (Y omega)) mu := by
  apply Integrable.of_bound
    ((measurable_standardNormalSteinDerivative x).comp_aemeasurable hY
      |>.aestronglyMeasurable) 1
  exact ae_of_all mu fun omega => by
    rw [Real.norm_eq_abs]
    exact abs_standardNormalSteinDerivative_le_one x (Y omega)

/-- Integrated Stein identity for an arbitrary probability law with finite
first absolute moment.  The total derivative representative makes the formula
valid even when the law has an atom at the threshold. -/
theorem integral_standardNormalSteinDerivative_sub_mul_eq_cdf_sub
    (nu : Measure ℝ) [IsProbabilityMeasure nu] (x : ℝ)
    (hfirst : Integrable (fun z : ℝ => |z|) nu) :
    (∫ z, standardNormalSteinDerivative x z ∂nu) -
        ∫ z, z * standardNormalSteinSolution x z ∂nu =
      cdf nu x - cdf standardNormalLaw x := by
  have hDeriv := integrable_standardNormalSteinDerivative nu x hfirst
  have hMul := integrable_mul_standardNormalSteinSolution nu x hfirst
  calc
    (∫ z, standardNormalSteinDerivative x z ∂nu) -
        ∫ z, z * standardNormalSteinSolution x z ∂nu =
      ∫ z, standardNormalSteinDerivative x z -
        z * standardNormalSteinSolution x z ∂nu :=
      (integral_sub hDeriv hMul).symm
    _ = ∫ z, standardNormalHalfLineSteinTarget x z ∂nu := by
      apply integral_congr_ae
      exact ae_of_all nu fun z =>
        (standardNormalHalfLineSteinTarget_eq_derivative_sub_mul x z).symm
    _ = cdf nu x - cdf standardNormalLaw x :=
      integral_standardNormalHalfLineSteinTarget_eq_cdf_sub nu x

/-- Pull the integrated Stein identity for the law of a random variable back
to its original probability space. -/
theorem integral_comp_standardNormalSteinDerivative_sub_mul_eq_cdf_sub
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (Y : Omega → ℝ) (hY : AEMeasurable Y mu)
    (hfirst : Integrable (fun omega => |Y omega|) mu) (x : ℝ) :
    (∫ omega, standardNormalSteinDerivative x (Y omega) ∂mu) -
        ∫ omega, Y omega * standardNormalSteinSolution x (Y omega) ∂mu =
      cdf (probabilityLaw Y hY) x - cdf standardNormalLaw x := by
  let law : Measure ℝ := probabilityLaw Y hY
  letI : IsProbabilityMeasure law := inferInstance
  have hLawFirst : Integrable (fun z : ℝ => |z|) law := by
    change Integrable (fun z : ℝ => |z|) (Measure.map Y mu)
    rw [integrable_map_measure (by fun_prop) hY]
    simpa only [Function.comp_apply] using hfirst
  have h := integral_standardNormalSteinDerivative_sub_mul_eq_cdf_sub
    law x hLawFirst
  have hDerivMeas := measurable_standardNormalSteinDerivative x
  have hMulMeas : Measurable
      (fun z : ℝ => z * standardNormalSteinSolution x z) :=
    measurable_id.mul (continuous_standardNormalSteinSolution x).measurable
  change (∫ z, standardNormalSteinDerivative x z ∂Measure.map Y mu) -
      ∫ z, z * standardNormalSteinSolution x z ∂Measure.map Y mu =
    cdf (Measure.map Y mu) x - cdf standardNormalLaw x at h
  change (∫ omega, standardNormalSteinDerivative x (Y omega) ∂mu) -
      ∫ omega, Y omega * standardNormalSteinSolution x (Y omega) ∂mu =
    cdf (Measure.map Y mu) x - cdf standardNormalLaw x
  rw [integral_map hY hDerivMeas.aestronglyMeasurable,
    integral_map hY hMulMeas.aestronglyMeasurable] at h
  simpa only [Function.comp_apply] using h

/-- Exact Stein expectation representation for a normalized centered iid sum.
This is the entry point for the summand-by-summand leave-one-out expansion. -/
theorem integral_normalizedCenteredIidSum_standardNormalStein_eq_cdf_sub
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (N : ℕ) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    (∫ omega, standardNormalSteinDerivative x (W omega) ∂mu) -
        ∫ omega, W omega * standardNormalSteinSolution x (W omega) ∂mu =
      cdf (probabilityLaw W
          (normalizedCenteredIidSum_memLp X hX N).aemeasurable) x -
        cdf standardNormalLaw x := by
  let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
  have hW : MemLp W 2 mu := normalizedCenteredIidSum_memLp X hX N
  have hfirst : Integrable (fun omega => |W omega|) mu := by
    simpa only [Real.norm_eq_abs] using (hW.integrable (by norm_num)).norm
  exact integral_comp_standardNormalSteinDerivative_sub_mul_eq_cdf_sub
    W hW.aemeasurable hfirst x

/-- The normalized iid sum with one indexed summand removed. -/
noncomputable def normalizedCenteredIidLeaveOneOut
    {Omega : Type*} (X : ℕ → Omega → ℝ) (N : ℕ) (i : Fin (N + 1)) :
    Omega → ℝ :=
  fun omega => (Real.sqrt (N + 1 : ℝ))⁻¹ *
    ∑ j ∈ (Finset.range (N + 1)).erase i.1, X j omega

theorem normalizedCenteredIidSum_eq_leaveOneOut_add
    {Omega : Type*} (X : ℕ → Omega → ℝ) (N : ℕ) (i : Fin (N + 1))
    (omega : Omega) :
    normalizedCenteredIidSum X N omega =
      normalizedCenteredIidLeaveOneOut X N i omega +
        (Real.sqrt (N + 1 : ℝ))⁻¹ * X i.1 omega := by
  unfold normalizedCenteredIidSum normalizedCenteredIidLeaveOneOut
  have hsum : (∑ j : Fin (N + 1), X j.1 omega) =
      ∑ j ∈ Finset.range (N + 1), X j omega := by
    simpa only [Finset.sum_apply] using
      (Fin.sum_univ_eq_sum_range (fun j => X j omega) (N + 1))
  rw [hsum, ← Finset.sum_erase_add _ _ (Finset.mem_range.2 i.isLt)]
  ring

theorem normalizedCenteredIidLeaveOneOut_memLp
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (N : ℕ) (i : Fin (N + 1)) :
    MemLp (normalizedCenteredIidLeaveOneOut X N i) 2 mu := by
  have hs : MemLp
      (fun omega => ∑ j ∈ (Finset.range (N + 1)).erase i.1, X j omega) 2 mu :=
    memLp_finset_sum ((Finset.range (N + 1)).erase i.1) (fun j _ => hX j)
  exact hs.const_mul (Real.sqrt (N + 1 : ℝ))⁻¹

theorem indepFun_normalizedCenteredIidLeaveOneOut
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega}
    (X : ℕ → Omega → ℝ) (hX : ∀ j, AEMeasurable (X j) mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) :
    IndepFun (X i.1) (normalizedCenteredIidLeaveOneOut X N i) mu := by
  have hi : i.1 ∉ (Finset.range (N + 1)).erase i.1 := by simp
  have hind :=
    (hIndep.indepFun_finset_sum_of_notMem₀ hX hi).symm
  have hcomp := hind.comp measurable_id
    (show Measurable (fun y : ℝ => (Real.sqrt (N + 1 : ℝ))⁻¹ * y) by fun_prop)
  change IndepFun (X i.1)
    (fun omega => (Real.sqrt (N + 1 : ℝ))⁻¹ *
      ∑ j ∈ (Finset.range (N + 1)).erase i.1, X j omega) mu
  simpa [Function.comp_def, Finset.sum_apply] using hcomp

/-- On a probability space, a unit second moment bounds the first absolute
moment by one. -/
theorem integral_abs_le_one_of_secondMoment_eq_one
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    {Y : Omega → ℝ} (hY : MemLp Y 2 mu)
    (hSecond : ∫ omega, (Y omega) ^ 2 ∂mu = 1) :
    ∫ omega, |Y omega| ∂mu ≤ 1 := by
  have h := expectedAbs_le_sqrt_secondMoment hY
  rw [hSecond] at h
  simpa using h

/-- Identically distributed real random variables have the same third
absolute moment. -/
theorem integral_abs_cube_eq_of_identDistrib
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} {Y Z : Omega → ℝ}
    (hIdent : IdentDistrib Y Z mu mu) :
    (∫ omega, |Y omega| ^ 3 ∂mu) = ∫ omega, |Z omega| ^ 3 ∂mu := by
  have h := hIdent.comp
    (by fun_prop : Measurable fun y : ℝ => |y| ^ 3)
  simpa only [Function.comp_apply] using h.integral_eq

/-- The exact second moment of a normalized iid sum with one summand
removed.  There are `N` surviving unit-variance terms but the normalization
still uses `sqrt (N + 1)`. -/
theorem integral_sq_normalizedCenteredIidLeaveOneOut_eq
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu)
    (hMean : ∀ j, ∫ omega, X j omega ∂mu = 0)
    (hSecond : ∀ j, ∫ omega, (X j omega) ^ 2 ∂mu = 1)
    (N : ℕ) (i : Fin (N + 1)) :
    (∫ omega, (normalizedCenteredIidLeaveOneOut X N i omega) ^ 2 ∂mu) =
      (N : ℝ) / (N + 1 : ℝ) := by
  let s : Finset ℕ := (Finset.range (N + 1)).erase i.1
  let S : Omega → ℝ := fun omega => ∑ j ∈ s, X j omega
  have hS : MemLp S 2 mu := by
    dsimp only [S]
    exact memLp_finset_sum s (fun j _ => hX j)
  have hSMean : ∫ omega, S omega ∂mu = 0 := by
    dsimp only [S]
    rw [integral_finset_sum]
    · simp only [hMean, Finset.sum_const_zero]
    · intro j _
      exact (hX j).integrable (by norm_num)
  have hPair : Set.Pairwise (↑s : Set ℕ)
      (fun j k => IndepFun (X j) (X k) mu) := by
    intro j hj k hk hjk
    exact hIndep.indepFun hjk
  have hVarSum : Var[S; mu] = ∑ j ∈ s, Var[X j; mu] := by
    have h := ProbabilityTheory.IndepFun.variance_sum
      (s := s) (X := X) (fun j _ => hX j) hPair
    have hfun : S = ∑ j ∈ s, X j := by
      funext omega
      simp only [S, Finset.sum_apply]
    rw [hfun]
    exact h
  have hVarEach : ∀ j, Var[X j; mu] = 1 := by
    intro j
    rw [variance_of_integral_eq_zero (hX j).aemeasurable (hMean j)]
    exact hSecond j
  have hCard : s.card = N := by
    dsimp only [s]
    rw [Finset.card_erase_of_mem (Finset.mem_range.2 i.isLt), Finset.card_range]
    omega
  have hVarS : Var[S; mu] = (N : ℝ) := by
    rw [hVarSum]
    simp_rw [hVarEach]
    simp [hCard]
  have hWMean :
      ∫ omega, normalizedCenteredIidLeaveOneOut X N i omega ∂mu = 0 := by
    unfold normalizedCenteredIidLeaveOneOut
    change ∫ omega, (Real.sqrt (N + 1 : ℝ))⁻¹ * S omega ∂mu = 0
    rw [integral_const_mul, hSMean, mul_zero]
  have hVarW : Var[normalizedCenteredIidLeaveOneOut X N i; mu] =
      (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * (N : ℝ) := by
    unfold normalizedCenteredIidLeaveOneOut
    rw [variance_const_mul]
    change (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * Var[S; mu] = _
    rw [hVarS]
  calc
    (∫ omega, (normalizedCenteredIidLeaveOneOut X N i omega) ^ 2 ∂mu) =
        Var[normalizedCenteredIidLeaveOneOut X N i; mu] :=
      (variance_of_integral_eq_zero
        (normalizedCenteredIidLeaveOneOut_memLp X hX N i).aemeasurable
        hWMean).symm
    _ = (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * (N : ℝ) := hVarW
    _ = (N : ℝ) / (N + 1 : ℝ) := by
      have hsqrt : Real.sqrt (N + 1 : ℝ) ^ 2 = (N + 1 : ℝ) :=
        Real.sq_sqrt (by positivity)
      rw [inv_pow, hsqrt]
      ring

/-- The normalized leave-one-out sum has first absolute moment at most one. -/
theorem integral_abs_normalizedCenteredIidLeaveOneOut_le_one
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu)
    (hMean : ∀ j, ∫ omega, X j omega ∂mu = 0)
    (hSecond : ∀ j, ∫ omega, (X j omega) ^ 2 ∂mu = 1)
    (N : ℕ) (i : Fin (N + 1)) :
    ∫ omega, |normalizedCenteredIidLeaveOneOut X N i omega| ∂mu ≤ 1 := by
  have h := expectedAbs_le_sqrt_secondMoment
    (normalizedCenteredIidLeaveOneOut_memLp X hX N i)
  rw [integral_sq_normalizedCenteredIidLeaveOneOut_eq
    X hX hIndep hMean hSecond N i] at h
  exact h.trans (by
    rw [Real.sqrt_le_one]
    exact (div_le_one (by positivity : (0 : ℝ) < N + 1)).2 (by norm_num))

/-- Adding a deterministic nonnegative Stein-envelope constant preserves the
unit first-moment bound for the leave-one-out sum. -/
theorem integral_abs_normalizedCenteredIidLeaveOneOut_add_const_le
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu)
    (hMean : ∀ j, ∫ omega, X j omega ∂mu = 0)
    (hSecond : ∀ j, ∫ omega, (X j omega) ^ 2 ∂mu = 1)
    (N : ℕ) (i : Fin (N + 1)) (C : ℝ) :
    (∫ omega,
        |normalizedCenteredIidLeaveOneOut X N i omega| + C ∂mu) ≤ 1 + C := by
  have hWi := normalizedCenteredIidLeaveOneOut_memLp X hX N i
  have hAbs : Integrable
      (fun omega => |normalizedCenteredIidLeaveOneOut X N i omega|) mu := by
    simpa only [Real.norm_eq_abs] using
      (hWi.integrable (by norm_num)).norm
  rw [integral_add hAbs (integrable_const C)]
  simpa using add_le_add_right
    (integral_abs_normalizedCenteredIidLeaveOneOut_le_one
      X hX hIndep hMean hSecond N i) C

/-- `Fin.succAbove i` enumerates the finite range with `i` erased, so the two
forms of a leave-one-out sum agree exactly. -/
theorem sum_range_erase_eq_sum_succAbove
    {Omega : Type*} (X : ℕ → Omega → ℝ)
    (N : ℕ) (i : Fin (N + 1)) (omega : Omega) :
    (∑ j ∈ (Finset.range (N + 1)).erase i.1, X j omega) =
      ∑ j : Fin N, X (i.succAbove j).1 omega := by
  have hRange : (∑ j : Fin (N + 1), X j.1 omega) =
      ∑ j ∈ Finset.range (N + 1), X j omega := by
    simpa only [Finset.sum_apply] using
      (Fin.sum_univ_eq_sum_range (fun j => X j omega) (N + 1))
  calc
    (∑ j ∈ (Finset.range (N + 1)).erase i.1, X j omega) =
        (∑ j ∈ Finset.range (N + 1), X j omega) - X i.1 omega := by
      rw [← Finset.sum_erase_add _ _ (Finset.mem_range.2 i.isLt)]
      ring
    _ = (∑ j : Fin (N + 1), X j.1 omega) - X i.1 omega := by
      rw [hRange]
    _ = ∑ j : Fin N, X (i.succAbove j).1 omega := by
      rw [Fin.sum_univ_succAbove (fun j : Fin (N + 1) => X j.1 omega) i]
      ring

/-- Any `N`-element subfamily selected from an iid sequence has the same sum
law as the first `N` variables. -/
theorem map_sum_succAbove_eq_map_sum_fin
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, AEMeasurable (X j) mu)
    (hIndep : iIndepFun X mu)
    (hIdent : ∀ j, IdentDistrib (X j) (X 0) mu mu)
    (N : ℕ) (i : Fin (N + 1)) :
    Measure.map (∑ j : Fin N, X (i.succAbove j).1) mu =
      Measure.map (∑ j : Fin N, X j.1) mu := by
  cases N with
  | zero => simp
  | succ N =>
      let j0 : Fin (N + 1) := ⟨0, Nat.succ_pos N⟩
      let Y : Fin (N + 1) → Omega → ℝ :=
        fun j => X (i.succAbove j).1
      let Z : Fin (N + 1) → Omega → ℝ := fun j => X j.1
      have hY : ∀ j, AEMeasurable (Y j) mu := fun j => hX _
      have hZ : ∀ j, AEMeasurable (Z j) mu := fun j => hX _
      have hYIndep : iIndepFun Y mu := by
        exact hIndep.precomp
          (Fin.val_injective.comp i.succAbove_right_injective)
      have hZIndep : iIndepFun Z mu := hIndep.precomp Fin.val_injective
      have hYIdent : ∀ j, IdentDistrib (Y j) (Y j0) mu mu := by
        intro j
        exact (hIdent (i.succAbove j).1).trans
          (hIdent (i.succAbove j0).1).symm
      have hZIdent : ∀ j, IdentDistrib (Z j) (Z j0) mu mu := by
        intro j
        exact (hIdent j.1).trans (hIdent j0.1).symm
      have hYZ : IdentDistrib (Y j0) (Z j0) mu mu :=
        (hIdent (i.succAbove j0).1).trans (hIdent j0.1).symm
      apply Measure.ext_of_charFun
      funext t
      calc
        MeasureTheory.charFun (Measure.map (∑ j, Y j) mu) t =
            MeasureTheory.charFun (Measure.map (Y j0) mu) t ^ (N + 1) :=
          by simpa using charFun_map_iid_sum_eq_pow Y j0 hY hYIndep hYIdent t
        _ = MeasureTheory.charFun (Measure.map (Z j0) mu) t ^ (N + 1) := by
          rw [hYZ.map_eq]
        _ = MeasureTheory.charFun (Measure.map (∑ j, Z j) mu) t :=
          by simpa using
            (charFun_map_iid_sum_eq_pow Z j0 hZ hZIndep hZIdent t).symm

/-- For `N > 0`, every leave-one-out law is the common `N`-summand
standardized iid law, contracted by `sqrt N / sqrt (N + 1)`. -/
theorem map_normalizedCenteredIidLeaveOneOut_eq_map_mul_normalizedPrefix
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, AEMeasurable (X j) mu)
    (hIndep : iIndepFun X mu)
    (hIdent : ∀ j, IdentDistrib (X j) (X 0) mu mu)
    {N : ℕ} (hN : 0 < N) (i : Fin (N + 1)) :
    Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu =
      Measure.map
        (fun y : ℝ => Real.sqrt (N : ℝ) / Real.sqrt (N + 1 : ℝ) * y)
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
            X (N - 1)) mu) := by
  let U : Omega → ℝ := fun omega =>
    ∑ j : Fin N, X (i.succAbove j).1 omega
  let V : Omega → ℝ := fun omega => ∑ j : Fin N, X j.1 omega
  let P := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
    X (N - 1)
  let a : ℝ := (Real.sqrt (N + 1 : ℝ))⁻¹
  let c : ℝ := Real.sqrt (N : ℝ) / Real.sqrt (N + 1 : ℝ)
  have hU : AEMeasurable U mu := by
    dsimp only [U]
    fun_prop
  have hV : AEMeasurable V mu := by
    dsimp only [V]
    fun_prop
  have hP : AEMeasurable P mu := by
    dsimp only [P]
    unfold NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
    fun_prop
  have hMapUV : Measure.map U mu = Measure.map V mu := by
    have hUFun : U = ∑ j : Fin N, X (i.succAbove j).1 := by
      funext omega
      simp only [U, Finset.sum_apply]
    have hVFun : V = ∑ j : Fin N, X j.1 := by
      funext omega
      simp only [V, Finset.sum_apply]
    rw [hUFun, hVFun]
    exact map_sum_succAbove_eq_map_sum_fin X hX hIndep hIdent N i
  have haMeas : AEMeasurable (fun y : ℝ => a * y) (Measure.map U mu) := by
    fun_prop
  have haMeasV : AEMeasurable (fun y : ℝ => a * y) (Measure.map V mu) := by
    fun_prop
  have hcMeas : AEMeasurable (fun y : ℝ => c * y) (Measure.map P mu) := by
    fun_prop
  have hCoeff : c * (Real.sqrt (N : ℝ))⁻¹ = a := by
    dsimp only [c, a]
    field_simp [show Real.sqrt (N : ℝ) ≠ 0 by positivity,
      show Real.sqrt (N + 1 : ℝ) ≠ 0 by positivity]
  have hWiFun : normalizedCenteredIidLeaveOneOut X N i =
      fun omega => a * U omega := by
    funext omega
    unfold normalizedCenteredIidLeaveOneOut
    dsimp only [a, U]
    rw [sum_range_erase_eq_sum_succAbove X N i omega]
  have hPPoint : ∀ omega, P omega =
      (Real.sqrt (N : ℝ))⁻¹ * V omega := by
    intro omega
    dsimp only [P, V]
    unfold NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
    rw [show N - 1 + 1 = N by omega]
    rw [show ((N - 1 : ℕ) : ℝ) + 1 = (N : ℝ) by
      norm_cast
      omega]
  have hPFun : (fun omega => a * V omega) = fun omega => c * P omega := by
    funext omega
    rw [hPPoint]
    rw [← hCoeff]
    ring
  calc
    Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu =
        Measure.map (fun omega => a * U omega) mu := by rw [hWiFun]
    _ = Measure.map (fun y : ℝ => a * y) (Measure.map U mu) := by
      simpa only [Function.comp_apply] using
        (haMeas.map_map_of_aemeasurable hU).symm
    _ = Measure.map (fun y : ℝ => a * y) (Measure.map V mu) := by
      rw [hMapUV]
    _ = Measure.map (fun omega => a * V omega) mu := by
      simpa only [Function.comp_apply] using
        haMeasV.map_map_of_aemeasurable hV
    _ = Measure.map (fun omega => c * P omega) mu := by rw [hPFun]
    _ = Measure.map (fun y : ℝ => c * y) (Measure.map P mu) := by
      simpa only [Function.comp_apply] using
        (hcMeas.map_map_of_aemeasurable hP).symm

/-- The leave-one-out Kolmogorov error is bounded by the preceding normalized
iid error plus the standard-normal defect caused by the exact contraction. -/
theorem kolmogorovDistance_normalizedCenteredIidLeaveOneOut_le_prefix_add_scalingDefect
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, AEMeasurable (X j) mu)
    (hIndep : iIndepFun X mu)
    (hIdent : ∀ j, IdentDistrib (X j) (X 0) mu mu)
    {N : ℕ} (hN : 0 < N) (i : Fin (N + 1)) :
    kolmogorovDistance
        (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      kolmogorovDistance
          (Measure.map
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
              X (N - 1)) mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
        kolmogorovDistance
          (Measure.map
            (fun y : ℝ =>
              Real.sqrt (N : ℝ) / Real.sqrt (N + 1 : ℝ) * y)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  let P := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
    X (N - 1)
  let c : ℝ := Real.sqrt (N : ℝ) / Real.sqrt (N + 1 : ℝ)
  let nu : Measure ℝ := Measure.map P mu
  let gamma := NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  have hP : AEMeasurable P mu := by
    dsimp only [P]
    unfold NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
    fun_prop
  letI : IsProbabilityMeasure nu := Measure.isProbabilityMeasure_map hP
  letI : IsProbabilityMeasure gamma := inferInstance
  have hc : 0 < c := by
    dsimp only [c]
    positivity
  have hLaw :=
    map_normalizedCenteredIidLeaveOneOut_eq_map_mul_normalizedPrefix
      X hX hIndep hIdent hN i
  change kolmogorovDistance
      (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu) gamma ≤
    kolmogorovDistance nu gamma +
      kolmogorovDistance (Measure.map (fun y : ℝ => c * y) gamma) gamma
  rw [hLaw]
  calc
    kolmogorovDistance (Measure.map (fun y : ℝ => c * y) nu) gamma ≤
        kolmogorovDistance
            (Measure.map (fun y : ℝ => c * y) nu)
            (Measure.map (fun y : ℝ => c * y) gamma) +
          kolmogorovDistance (Measure.map (fun y : ℝ => c * y) gamma) gamma :=
      kolmogorovDistance_triangle _ _ _
    _ = kolmogorovDistance nu gamma +
          kolmogorovDistance (Measure.map (fun y : ℝ => c * y) gamma) gamma := by
      rw [kolmogorovDistance_map_mul_eq nu gamma hc]

/-- Fubini formula for an arbitrary integrable real function of two
independent random variables.  This complements the product-only integration
lemmas in Mathlib and is the interface needed for random interval endpoints. -/
theorem integral_comp_pair_eq_integral_integral_of_indepFun
    {Omega A B : Type*} [MeasurableSpace Omega]
    [MeasurableSpace A] [MeasurableSpace B]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (Y : Omega → A) (X : Omega → B)
    (hY : AEMeasurable Y mu) (hX : AEMeasurable X mu)
    (hIndep : IndepFun Y X mu) (F : A × B → ℝ)
    (hF : Integrable F ((Measure.map Y mu).prod (Measure.map X mu))) :
    (∫ omega, F (Y omega, X omega) ∂mu) =
      ∫ y, ∫ x, F (y, x) ∂Measure.map X mu ∂Measure.map Y mu := by
  have hmap : Measure.map (fun omega => (Y omega, X omega)) mu =
      (Measure.map Y mu).prod (Measure.map X mu) :=
    (indepFun_iff_map_prod_eq_prod_map_map hY hX).mp hIndep
  have hFmap : AEStronglyMeasurable F
      (Measure.map (fun omega => (Y omega, X omega)) mu) := by
    rw [hmap]
    exact hF.aestronglyMeasurable
  calc
    (∫ omega, F (Y omega, X omega) ∂mu) =
        ∫ p, F p ∂Measure.map (fun omega => (Y omega, X omega)) mu :=
      (integral_map (hY.prodMk hX) hFmap).symm
    _ = ∫ p, F p ∂(Measure.map Y mu).prod (Measure.map X mu) := by rw [hmap]
    _ = ∫ y, ∫ x, F (y, x) ∂Measure.map X mu ∂Measure.map Y mu :=
      integral_prod F hF

/-- Independence and centering cancel the contribution in which the removed
summand is multiplied by the Stein solution evaluated at the leave-one-out
sum. -/
theorem integral_mul_standardNormalSteinSolution_leaveOneOut_eq_zero
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ)
    (hMean : ∫ omega, X i.1 omega ∂mu = 0) :
    (∫ omega, X i.1 omega *
        standardNormalSteinSolution x
          (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu) = 0 := by
  have hLeave := normalizedCenteredIidLeaveOneOut_memLp X hX N i
  have hind := indepFun_normalizedCenteredIidLeaveOneOut
    X (fun j => (hX j).aemeasurable) hIndep N i
  have hfact := hind.integral_comp_mul_comp
    (hX i.1).aemeasurable hLeave.aemeasurable
    aestronglyMeasurable_id
    (continuous_standardNormalSteinSolution x).aestronglyMeasurable
  simpa [Function.comp_def, hMean] using hfact

theorem integrable_mul_standardNormalSteinSolution_comp
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega}
    (Y Z : Omega → ℝ) (hY : Integrable Y mu) (hZ : AEMeasurable Z mu)
    (x : ℝ) :
    Integrable (fun omega =>
      Y omega * standardNormalSteinSolution x (Z omega)) mu := by
  let C : ℝ := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
  have hmajor : Integrable (fun omega => C * |Y omega|) mu := by
    simpa only [Real.norm_eq_abs] using hY.norm.const_mul C
  apply hmajor.mono'
    (hY.aestronglyMeasurable.mul
      ((continuous_standardNormalSteinSolution x).measurable.comp_aemeasurable hZ
        |>.aestronglyMeasurable))
  exact ae_of_all mu fun omega => by
    change |Y omega * standardNormalSteinSolution x (Z omega)| ≤ C * |Y omega|
    rw [abs_mul,
      abs_of_nonneg (standardNormalSteinSolution_nonneg x (Z omega))]
    dsimp [C]
    nlinarith [mul_le_mul_of_nonneg_left
      (standardNormalSteinSolution_le x (Z omega)) (abs_nonneg (Y omega))]

/-- Exact leave-one-out expansion of the drift term in the normalized-sum
Stein identity. -/
theorem integral_normalizedCenteredIidSum_mul_steinSolution_eq_leaveOneOut
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (hMean : ∀ j, ∫ omega, X j omega ∂mu = 0)
    (N : ℕ) (x : ℝ) :
    let W := normalizedCenteredIidSum X N
    (∫ omega, W omega * standardNormalSteinSolution x (W omega) ∂mu) =
      (Real.sqrt (N + 1 : ℝ))⁻¹ *
        ∑ i : Fin (N + 1), ∫ omega,
          X i.1 omega *
            (standardNormalSteinSolution x (W omega) -
              standardNormalSteinSolution x
                (normalizedCenteredIidLeaveOneOut X N i omega)) ∂mu := by
  let W := normalizedCenteredIidSum X N
  change (∫ omega, W omega * standardNormalSteinSolution x (W omega) ∂mu) =
    (Real.sqrt (N + 1 : ℝ))⁻¹ *
      ∑ i : Fin (N + 1), ∫ omega,
        X i.1 omega *
          (standardNormalSteinSolution x (W omega) -
            standardNormalSteinSolution x
              (normalizedCenteredIidLeaveOneOut X N i omega)) ∂mu
  have hW : MemLp W 2 mu := normalizedCenteredIidSum_memLp X hX N
  have hXiW : ∀ i : Fin (N + 1), Integrable (fun omega =>
      X i.1 omega * standardNormalSteinSolution x (W omega)) mu := by
    intro i
    exact integrable_mul_standardNormalSteinSolution_comp
      (X i.1) W ((hX i.1).integrable (by norm_num)) hW.aemeasurable x
  have hXiLeave : ∀ i : Fin (N + 1), Integrable (fun omega =>
      X i.1 omega * standardNormalSteinSolution x
        (normalizedCenteredIidLeaveOneOut X N i omega)) mu := by
    intro i
    exact integrable_mul_standardNormalSteinSolution_comp
      (X i.1) (normalizedCenteredIidLeaveOneOut X N i)
      ((hX i.1).integrable (by norm_num))
      (normalizedCenteredIidLeaveOneOut_memLp X hX N i).aemeasurable x
  have hterm : ∀ i : Fin (N + 1),
      (∫ omega, X i.1 omega * standardNormalSteinSolution x (W omega) ∂mu) =
        ∫ omega, X i.1 omega *
          (standardNormalSteinSolution x (W omega) -
            standardNormalSteinSolution x
              (normalizedCenteredIidLeaveOneOut X N i omega)) ∂mu := by
    intro i
    have hzero :=
      integral_mul_standardNormalSteinSolution_leaveOneOut_eq_zero
        X hX hIndep N i x (hMean i.1)
    calc
      (∫ omega, X i.1 omega * standardNormalSteinSolution x (W omega) ∂mu) =
          (∫ omega, X i.1 omega * standardNormalSteinSolution x (W omega) ∂mu) -
            ∫ omega, X i.1 omega * standardNormalSteinSolution x
              (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu := by rw [hzero, sub_zero]
      _ = ∫ omega,
          X i.1 omega * standardNormalSteinSolution x (W omega) -
            X i.1 omega * standardNormalSteinSolution x
              (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu :=
        (integral_sub (hXiW i) (hXiLeave i)).symm
      _ = ∫ omega, X i.1 omega *
          (standardNormalSteinSolution x (W omega) -
            standardNormalSteinSolution x
              (normalizedCenteredIidLeaveOneOut X N i omega)) ∂mu := by
        apply integral_congr_ae
        exact ae_of_all mu fun omega => by ring
  have hpoint : (fun omega =>
      W omega * standardNormalSteinSolution x (W omega)) =
      fun omega => (Real.sqrt (N + 1 : ℝ))⁻¹ *
        ∑ i : Fin (N + 1),
          X i.1 omega * standardNormalSteinSolution x (W omega) := by
    funext omega
    dsimp only [W, normalizedCenteredIidSum]
    rw [mul_assoc, Finset.sum_mul]
  rw [hpoint, integral_const_mul, integral_finset_sum]
  · congr 1
    apply Finset.sum_congr rfl
    intro i _
    exact hterm i
  · intro i _
    exact hXiW i

/-- The normalized-sum Stein identity after the drift term has been expanded
summand by summand around the corresponding leave-one-out sums. -/
theorem integral_normalizedCenteredIidSum_stein_eq_leaveOneOut
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (hMean : ∀ j, ∫ omega, X j omega ∂mu = 0)
    (N : ℕ) (x : ℝ) :
    let W := normalizedCenteredIidSum X N
    (∫ omega, standardNormalSteinDerivative x (W omega) ∂mu) -
        (Real.sqrt (N + 1 : ℝ))⁻¹ *
          ∑ i : Fin (N + 1), ∫ omega,
            X i.1 omega *
              (standardNormalSteinSolution x (W omega) -
                standardNormalSteinSolution x
                  (normalizedCenteredIidLeaveOneOut X N i omega)) ∂mu =
      cdf (probabilityLaw W
          (normalizedCenteredIidSum_memLp X hX N).aemeasurable) x -
        cdf standardNormalLaw x := by
  have h := integral_normalizedCenteredIidSum_standardNormalStein_eq_cdf_sub
    X hX N x
  have hDrift :=
    integral_normalizedCenteredIidSum_mul_steinSolution_eq_leaveOneOut
      X hX hIndep hMean N x
  dsimp only at h hDrift ⊢
  rw [hDrift] at h
  exact h

theorem antitone_standardNormalHalfLineSteinTarget (x : ℝ) :
    Antitone (standardNormalHalfLineSteinTarget x) := by
  intro a b hab
  unfold standardNormalHalfLineSteinTarget
  by_cases ha : a ≤ x
  · by_cases hb : b ≤ x
    · simp [ha, hb]
    · simp [ha, hb]
  · have hb : ¬b ≤ x := fun hbx => ha (hab.trans hbx)
    simp [ha, hb]

/-- The discontinuous part of the Stein derivative changes only when the
unoriented interval between the two arguments contains the threshold. -/
theorem abs_standardNormalHalfLineSteinTarget_sub_le_crossing
    (x a b : ℝ) :
    |standardNormalHalfLineSteinTarget x b -
        standardNormalHalfLineSteinTarget x a| ≤
      (uIcc a b).indicator (fun _ : ℝ => (1 : ℝ)) x := by
  classical
  unfold standardNormalHalfLineSteinTarget
  by_cases ha : a ≤ x
  · by_cases hb : b ≤ x
    · simp only [if_pos ha, if_pos hb, sub_self, abs_zero]
      exact Set.indicator_nonneg (fun _ _ => zero_le_one) x
    · have hmem : x ∈ uIcc a b :=
        Set.mem_uIcc.mpr (Or.inl ⟨ha, (le_of_not_ge hb)⟩)
      rw [if_neg hb, if_pos ha, Set.indicator_of_mem hmem]
      rw [show -cdf standardNormalLaw x -
          (1 - cdf standardNormalLaw x) = (-1 : ℝ) by ring]
      norm_num
  · by_cases hb : b ≤ x
    · have hmem : x ∈ uIcc a b :=
        Set.mem_uIcc.mpr (Or.inr ⟨hb, (le_of_not_ge ha)⟩)
      rw [if_pos hb, if_neg ha, Set.indicator_of_mem hmem]
      rw [show (1 - cdf standardNormalLaw x) -
          -cdf standardNormalLaw x = (1 : ℝ) by ring]
      norm_num
    · simp only [if_neg ha, if_neg hb, sub_self, abs_zero]
      exact Set.indicator_nonneg (fun _ _ => zero_le_one) x

/-- If adding `y` crosses the threshold `x`, then the starting point lies in
the symmetric interval of radius `|y|` around that threshold. -/
theorem mem_Icc_sub_abs_add_abs_of_mem_uIcc_add
    {x w y : ℝ} (h : x ∈ uIcc w (w + y)) :
    w ∈ Icc (x - |y|) (x + |y|) := by
  rcases Set.mem_uIcc.mp h with h | h
  · constructor <;> nlinarith [le_abs_self y, neg_le_abs y]
  · constructor <;> nlinarith [le_abs_self y, neg_le_abs y]

/-- Indicator form of the deterministic crossing containment. -/
theorem indicator_uIcc_add_le_indicator_Icc_sub_abs_add_abs
    (x w y : ℝ) :
    (uIcc w (w + y)).indicator (fun _ : ℝ => (1 : ℝ)) x ≤
      (Icc (x - |y|) (x + |y|)).indicator
        (fun _ : ℝ => (1 : ℝ)) w := by
  classical
  by_cases h : x ∈ uIcc w (w + y)
  · rw [Set.indicator_of_mem h,
      Set.indicator_of_mem (mem_Icc_sub_abs_add_abs_of_mem_uIcc_add h)]
  · rw [Set.indicator_of_notMem h]
    exact Set.indicator_nonneg (fun _ _ => zero_le_one) w

/-- For a nonnegative increment, a change in the half-line target forces the
starting point into the half-open interval `(x - y, x]`. -/
theorem abs_standardNormalHalfLineSteinTarget_add_sub_le_indicator_Ioc_of_nonneg
    (x w y : ℝ) (hy : 0 ≤ y) :
    |standardNormalHalfLineSteinTarget x (w + y) -
        standardNormalHalfLineSteinTarget x w| ≤
      (Ioc (x - y) x).indicator (fun _ : ℝ => (1 : ℝ)) w := by
  classical
  unfold standardNormalHalfLineSteinTarget
  by_cases hw : w ≤ x
  · by_cases hwy : w + y ≤ x
    · simp only [if_pos hw, if_pos hwy, sub_self, abs_zero]
      exact Set.indicator_nonneg (fun _ _ => zero_le_one) w
    · have hmem : w ∈ Ioc (x - y) x := ⟨by linarith, hw⟩
      rw [if_neg hwy, if_pos hw, Set.indicator_of_mem hmem]
      rw [show -cdf standardNormalLaw x -
          (1 - cdf standardNormalLaw x) = (-1 : ℝ) by ring]
      norm_num
  · have hwy : ¬w + y ≤ x := by
      intro h
      exact hw (by linarith)
    simp only [if_neg hw, if_neg hwy, sub_self, abs_zero]
    exact Set.indicator_nonneg (fun _ _ => zero_le_one) w

/-- For a nonpositive increment, a change in the half-line target forces the
starting point into the half-open interval `(x, x - y]`. -/
theorem abs_standardNormalHalfLineSteinTarget_add_sub_le_indicator_Ioc_of_nonpos
    (x w y : ℝ) (hy : y ≤ 0) :
    |standardNormalHalfLineSteinTarget x (w + y) -
        standardNormalHalfLineSteinTarget x w| ≤
      (Ioc x (x - y)).indicator (fun _ : ℝ => (1 : ℝ)) w := by
  classical
  unfold standardNormalHalfLineSteinTarget
  by_cases hw : w ≤ x
  · have hwy : w + y ≤ x := by linarith
    simp only [if_pos hw, if_pos hwy, sub_self, abs_zero]
    exact Set.indicator_nonneg (fun _ _ => zero_le_one) w
  · by_cases hwy : w + y ≤ x
    · have hmem : w ∈ Ioc x (x - y) := ⟨lt_of_not_ge hw, by linarith⟩
      rw [if_pos hwy, if_neg hw, Set.indicator_of_mem hmem]
      rw [show (1 - cdf standardNormalLaw x) -
          -cdf standardNormalLaw x = (1 : ℝ) by ring]
      norm_num
    · simp only [if_neg hw, if_neg hwy, sub_self, abs_zero]
      exact Set.indicator_nonneg (fun _ _ => zero_le_one) w

theorem indicator_Ioc_sub_le_of_nonneg
    (x w s y : ℝ) (hs : 0 ≤ s) (hsy : s ≤ y) :
    (Ioc (x - s) x).indicator (fun _ : ℝ => (1 : ℝ)) w ≤
      (Ioc (x - y) x).indicator (fun _ : ℝ => (1 : ℝ)) w := by
  classical
  by_cases hmem : w ∈ Ioc (x - s) x
  · have hmem' : w ∈ Ioc (x - y) x := ⟨by linarith [hmem.1], hmem.2⟩
    rw [Set.indicator_of_mem hmem, Set.indicator_of_mem hmem']
  · rw [Set.indicator_of_notMem hmem]
    exact Set.indicator_nonneg (fun _ _ => zero_le_one) w

theorem indicator_Ioc_sub_le_of_nonpos
    (x w y s : ℝ) (hys : y ≤ s) (hs : s ≤ 0) :
    (Ioc x (x - s)).indicator (fun _ : ℝ => (1 : ℝ)) w ≤
      (Ioc x (x - y)).indicator (fun _ : ℝ => (1 : ℝ)) w := by
  classical
  by_cases hmem : w ∈ Ioc x (x - s)
  · have hmem' : w ∈ Ioc x (x - y) := ⟨hmem.1, by linarith [hmem.2]⟩
    rw [Set.indicator_of_mem hmem, Set.indicator_of_mem hmem']
  · rw [Set.indicator_of_notMem hmem]
    exact Set.indicator_nonneg (fun _ _ => zero_le_one) w

/-- Measurable two-variable event encoding the direction-sensitive half-open
interval crossed by an additive displacement `scale * v`. -/
def standardNormalSteinCrossingSet (x scale : ℝ) : Set (ℝ × ℝ) :=
  {p | (0 ≤ p.2 ∧ p.1 ∈ Ioc (x - scale * p.2) x) ∨
    (p.2 ≤ 0 ∧ p.1 ∈ Ioc x (x - scale * p.2))}

theorem measurableSet_standardNormalSteinCrossingSet (x scale : ℝ) :
    MeasurableSet (standardNormalSteinCrossingSet x scale) := by
  unfold standardNormalSteinCrossingSet
  measurability

theorem intervalIntegrable_standardNormalSteinDerivative
    (x a b : ℝ) :
    IntervalIntegrable (standardNormalSteinDerivative x) volume a b := by
  unfold standardNormalSteinDerivative
  exact ((continuous_id.mul (continuous_standardNormalSteinSolution x)).intervalIntegrable a b).add
    ((antitone_standardNormalHalfLineSteinTarget x).intervalIntegrable)

/-- Right derivative of the joined solution, using the upper branch at the
threshold. -/
noncomputable def standardNormalSteinRightDerivative (x z : ℝ) : ℝ :=
  if z < x then
    z * standardNormalSteinSolution x z + (1 - cdf standardNormalLaw x)
  else
    z * standardNormalSteinSolution x z - cdf standardNormalLaw x

theorem standardNormalSteinRightDerivative_eq_total
    {x z : ℝ} (hz : z ≠ x) :
    standardNormalSteinRightDerivative x z =
      standardNormalSteinDerivative x z := by
  rcases lt_or_gt_of_ne hz with hzx | hxz
  · unfold standardNormalSteinRightDerivative standardNormalSteinDerivative
    simp [standardNormalHalfLineSteinTarget, hzx, hzx.le]
  · unfold standardNormalSteinRightDerivative standardNormalSteinDerivative
    simp [standardNormalHalfLineSteinTarget, not_lt_of_ge hxz.le,
      not_le.mpr hxz, sub_eq_add_neg]

theorem intervalIntegrable_standardNormalSteinRightDerivative
    (x a b : ℝ) :
    IntervalIntegrable (standardNormalSteinRightDerivative x) volume a b := by
  apply (intervalIntegrable_standardNormalSteinDerivative x a b).congr_ae
  filter_upwards [(volume.restrict (uIoc a b)).ae_ne x] with z hz
  exact (standardNormalSteinRightDerivative_eq_total hz).symm

theorem hasDerivWithinAt_standardNormalSteinSolution_right
    (x z : ℝ) :
    HasDerivWithinAt (standardNormalSteinSolution x)
      (standardNormalSteinRightDerivative x z) (Ioi z) z := by
  rcases lt_trichotomy z x with hzx | hzx | hxz
  · simpa [standardNormalSteinRightDerivative, hzx] using
      (hasDerivAt_standardNormalSteinSolution_of_lt hzx).hasDerivWithinAt
  · subst z
    have hu : HasDerivWithinAt (standardNormalSteinUpper x)
        (x * standardNormalSteinUpper x x - cdf standardNormalLaw x)
        (Ioi x) x :=
      (hasDerivAt_standardNormalSteinUpper x x).hasDerivWithinAt
    have hj := hu.congr
      (fun y hy => standardNormalSteinSolution_of_lt hy)
      (by rw [standardNormalSteinSolution_of_le le_rfl,
        standardNormalSteinLower_eq_upper])
    have hjoin : standardNormalSteinSolution x x = standardNormalSteinUpper x x := by
      rw [standardNormalSteinSolution_of_le le_rfl,
        standardNormalSteinLower_eq_upper]
    simpa [standardNormalSteinRightDerivative, hjoin] using hj
  · simpa [standardNormalSteinRightDerivative, not_lt_of_ge hxz.le] using
      (hasDerivAt_standardNormalSteinSolution_of_gt hxz).hasDerivWithinAt

theorem intervalIntegral_standardNormalSteinRightDerivative_eq_sub
    (x a b : ℝ) :
    (∫ z in a..b, standardNormalSteinRightDerivative x z) =
      standardNormalSteinSolution x b - standardNormalSteinSolution x a := by
  apply intervalIntegral.integral_eq_sub_of_hasDeriv_right
  · exact (continuous_standardNormalSteinSolution x).continuousOn
  · intro z _
    exact hasDerivWithinAt_standardNormalSteinSolution_right x z
  · exact intervalIntegrable_standardNormalSteinRightDerivative x a b

/-- Exact increment formula for the joined Stein solution.  The total
representative differs from the one-sided analytic derivative only at the
threshold, which has Lebesgue measure zero. -/
theorem intervalIntegral_standardNormalSteinDerivative_eq_sub
    (x a b : ℝ) :
    (∫ z in a..b, standardNormalSteinDerivative x z) =
      standardNormalSteinSolution x b - standardNormalSteinSolution x a := by
  calc
    (∫ z in a..b, standardNormalSteinDerivative x z) =
        ∫ z in a..b, standardNormalSteinRightDerivative x z := by
      apply intervalIntegral.integral_congr_ae
      filter_upwards [(volume : Measure ℝ).ae_ne x] with z hz _
      exact (standardNormalSteinRightDerivative_eq_total hz).symm
    _ = standardNormalSteinSolution x b - standardNormalSteinSolution x a :=
      intervalIntegral_standardNormalSteinRightDerivative_eq_sub x a b

/-- The first-order interval remainder is bounded by the integral of the
derivative increment from the starting point. -/
theorem abs_mul_standardNormalSteinDerivative_sub_intervalIntegral_le
    (x a b : ℝ) :
    |(b - a) * standardNormalSteinDerivative x a -
        (∫ z in a..b, standardNormalSteinDerivative x z)| ≤
      ∫ z in uIoc a b,
        |standardNormalSteinDerivative x z -
          standardNormalSteinDerivative x a| := by
  have hD := intervalIntegrable_standardNormalSteinDerivative x a b
  have hconst : IntervalIntegrable
      (fun _ : ℝ => standardNormalSteinDerivative x a) volume a b :=
    intervalIntegrable_const
  calc
    |(b - a) * standardNormalSteinDerivative x a -
        (∫ z in a..b, standardNormalSteinDerivative x z)| =
      ‖∫ z in a..b, (standardNormalSteinDerivative x a -
        standardNormalSteinDerivative x z)‖ := by
      rw [intervalIntegral.integral_sub hconst hD,
        intervalIntegral.integral_const, Real.norm_eq_abs]
      congr 1
    _ = ‖∫ z in uIoc a b, (standardNormalSteinDerivative x a -
        standardNormalSteinDerivative x z)‖ :=
      intervalIntegral.norm_intervalIntegral_eq
        (fun z => standardNormalSteinDerivative x a -
          standardNormalSteinDerivative x z) a b volume
    _ ≤ ∫ z in uIoc a b,
        ‖standardNormalSteinDerivative x a -
          standardNormalSteinDerivative x z‖ :=
      norm_integral_le_integral_norm _
    _ = ∫ z in uIoc a b,
        |standardNormalSteinDerivative x z -
          standardNormalSteinDerivative x a| := by
      apply integral_congr_ae
      exact ae_of_all _ fun z => by
        change |standardNormalSteinDerivative x a -
          standardNormalSteinDerivative x z| =
            |standardNormalSteinDerivative x z -
              standardNormalSteinDerivative x a|
        exact abs_sub_comm _ _

theorem abs_standardNormalSteinSolution_sub_le_integral_abs_derivative
    (x a b : ℝ) :
    |standardNormalSteinSolution x b - standardNormalSteinSolution x a| ≤
      ∫ z in uIoc a b, |standardNormalSteinDerivative x z| := by
  calc
    |standardNormalSteinSolution x b - standardNormalSteinSolution x a| =
        ‖∫ z in a..b, standardNormalSteinDerivative x z‖ := by
      rw [intervalIntegral_standardNormalSteinDerivative_eq_sub,
        Real.norm_eq_abs]
    _ = ‖∫ z in uIoc a b, standardNormalSteinDerivative x z‖ :=
      intervalIntegral.norm_intervalIntegral_eq
        (standardNormalSteinDerivative x) a b volume
    _ ≤ ∫ z in uIoc a b, ‖standardNormalSteinDerivative x z‖ :=
      norm_integral_le_integral_norm _
    _ = ∫ z in uIoc a b, |standardNormalSteinDerivative x z| := by
      simp only [Real.norm_eq_abs]

/-- The sharp global Lipschitz estimate for the half-line Stein solution. -/
theorem abs_standardNormalSteinSolution_sub_le (x a b : ℝ) :
    |standardNormalSteinSolution x b - standardNormalSteinSolution x a| ≤
      |b - a| := by
  have hbound : ∀ z ∈ uIoc a b,
      ‖standardNormalSteinDerivative x z‖ ≤ 1 := by
    intro z _
    simpa only [Real.norm_eq_abs] using
      abs_standardNormalSteinDerivative_le_one x z
  have hnorm := intervalIntegral.norm_integral_le_of_norm_le_const hbound
  rw [intervalIntegral_standardNormalSteinDerivative_eq_sub,
    Real.norm_eq_abs] at hnorm
  simpa using hnorm

/-- The continuous drift part of the total Stein derivative has a local
increment bound in terms of the starting point. -/
theorem abs_mul_standardNormalSteinSolution_sub_le
    (x a b : ℝ) :
    |b * standardNormalSteinSolution x b -
        a * standardNormalSteinSolution x a| ≤
      (|a| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) * |b - a| := by
  have hsplit :
      b * standardNormalSteinSolution x b -
          a * standardNormalSteinSolution x a =
        a * (standardNormalSteinSolution x b -
            standardNormalSteinSolution x a) +
          (b - a) * standardNormalSteinSolution x b := by ring
  rw [hsplit]
  apply (abs_add_le _ _).trans
  calc
    |a * (standardNormalSteinSolution x b -
          standardNormalSteinSolution x a)| +
        |(b - a) * standardNormalSteinSolution x b| =
      |a| * |standardNormalSteinSolution x b -
          standardNormalSteinSolution x a| +
        |b - a| * standardNormalSteinSolution x b := by
      rw [abs_mul, abs_mul,
        abs_of_nonneg (standardNormalSteinSolution_nonneg x b)]
    _ ≤ |a| * |b - a| +
        |b - a| *
          (Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) := by
      exact add_le_add
        (mul_le_mul_of_nonneg_left
          (abs_standardNormalSteinSolution_sub_le x a b) (abs_nonneg a))
        (mul_le_mul_of_nonneg_left
          (standardNormalSteinSolution_le x b) (abs_nonneg (b - a)))
    _ = (|a| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
        |b - a| := by ring

/-- Increment bound for the total Stein derivative.  Its continuous drift
part is controlled by the one-Lipschitz solution, while the only discontinuous
contribution is the explicit threshold-crossing indicator. -/
theorem abs_standardNormalSteinDerivative_sub_le_crossing
    (x a b : ℝ) :
    |standardNormalSteinDerivative x b -
        standardNormalSteinDerivative x a| ≤
      (|a| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) * |b - a| +
        (uIcc a b).indicator (fun _ : ℝ => (1 : ℝ)) x := by
  have hsplit :
      standardNormalSteinDerivative x b -
          standardNormalSteinDerivative x a =
        (a * (standardNormalSteinSolution x b -
            standardNormalSteinSolution x a) +
          (b - a) * standardNormalSteinSolution x b) +
        (standardNormalHalfLineSteinTarget x b -
          standardNormalHalfLineSteinTarget x a) := by
    unfold standardNormalSteinDerivative
    ring
  rw [hsplit]
  apply (abs_add_le _ _).trans
  apply add_le_add
  · calc
      |a * (standardNormalSteinSolution x b -
            standardNormalSteinSolution x a) +
          (b - a) * standardNormalSteinSolution x b| ≤
        |a * (standardNormalSteinSolution x b -
            standardNormalSteinSolution x a)| +
          |(b - a) * standardNormalSteinSolution x b| := abs_add_le _ _
      _ = |a| * |standardNormalSteinSolution x b -
            standardNormalSteinSolution x a| +
          |b - a| * standardNormalSteinSolution x b := by
        rw [abs_mul, abs_mul,
          abs_of_nonneg (standardNormalSteinSolution_nonneg x b)]
      _ ≤ |a| * |b - a| +
          |b - a| *
            (Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) := by
        exact add_le_add
          (mul_le_mul_of_nonneg_left
            (abs_standardNormalSteinSolution_sub_le x a b) (abs_nonneg a))
          (mul_le_mul_of_nonneg_left
            (standardNormalSteinSolution_le x b) (abs_nonneg (b - a)))
      _ = (|a| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          |b - a| := by ring
  · exact abs_standardNormalHalfLineSteinTarget_sub_le_crossing x a b

/-- Directional derivative-increment bound for a nonnegative displacement;
the atomic crossing term is a half-open interval of length exactly `y`. -/
theorem abs_standardNormalSteinDerivative_add_sub_le_indicator_Ioc_of_nonneg
    (x w y : ℝ) (hy : 0 ≤ y) :
    |standardNormalSteinDerivative x (w + y) -
        standardNormalSteinDerivative x w| ≤
      (|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) * |y| +
        (Ioc (x - y) x).indicator (fun _ : ℝ => (1 : ℝ)) w := by
  have hsplit :
      standardNormalSteinDerivative x (w + y) -
          standardNormalSteinDerivative x w =
        ((w + y) * standardNormalSteinSolution x (w + y) -
          w * standardNormalSteinSolution x w) +
        (standardNormalHalfLineSteinTarget x (w + y) -
          standardNormalHalfLineSteinTarget x w) := by
    unfold standardNormalSteinDerivative
    ring
  rw [hsplit]
  exact (abs_add_le _ _).trans (add_le_add
    (by simpa only [add_sub_cancel_left] using
      abs_mul_standardNormalSteinSolution_sub_le x w (w + y))
    (abs_standardNormalHalfLineSteinTarget_add_sub_le_indicator_Ioc_of_nonneg
      x w y hy))

/-- Directional derivative-increment bound for a nonpositive displacement;
the atomic crossing term is again a half-open interval of length `|y|`. -/
theorem abs_standardNormalSteinDerivative_add_sub_le_indicator_Ioc_of_nonpos
    (x w y : ℝ) (hy : y ≤ 0) :
    |standardNormalSteinDerivative x (w + y) -
        standardNormalSteinDerivative x w| ≤
      (|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) * |y| +
        (Ioc x (x - y)).indicator (fun _ : ℝ => (1 : ℝ)) w := by
  have hsplit :
      standardNormalSteinDerivative x (w + y) -
          standardNormalSteinDerivative x w =
        ((w + y) * standardNormalSteinSolution x (w + y) -
          w * standardNormalSteinSolution x w) +
        (standardNormalHalfLineSteinTarget x (w + y) -
          standardNormalHalfLineSteinTarget x w) := by
    unfold standardNormalSteinDerivative
    ring
  rw [hsplit]
  exact (abs_add_le _ _).trans (add_le_add
    (by simpa only [add_sub_cancel_left] using
      abs_mul_standardNormalSteinSolution_sub_le x w (w + y))
    (abs_standardNormalHalfLineSteinTarget_add_sub_le_indicator_Ioc_of_nonpos
      x w y hy))

/-- Positive-displacement integral of the derivative increment.  The smooth
part is quadratic in the displacement and all intermediate jumps are absorbed
by the single endpoint crossing event. -/
theorem integral_abs_standardNormalSteinDerivative_sub_le_of_nonneg
    (x w y : ℝ) (hy : 0 ≤ y) :
    (∫ z in uIoc w (w + y),
      |standardNormalSteinDerivative x z -
        standardNormalSteinDerivative x w|) ≤
      (|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (y ^ 2 / 2) +
        y * (Ioc (x - y) x).indicator (fun _ : ℝ => (1 : ℝ)) w := by
  let A : ℝ := |w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
  let K : ℝ := (Ioc (x - y) x).indicator (fun _ : ℝ => (1 : ℝ)) w
  have hDiffII : IntervalIntegrable (fun z =>
      standardNormalSteinDerivative x z - standardNormalSteinDerivative x w)
      volume w (w + y) :=
    (intervalIntegrable_standardNormalSteinDerivative x w (w + y)).sub
      intervalIntegrable_const
  have hLeft : IntegrableOn (fun z =>
      |standardNormalSteinDerivative x z - standardNormalSteinDerivative x w|)
      (uIoc w (w + y)) volume := by
    simpa only [Real.norm_eq_abs] using hDiffII.norm.def'
  have hContII : IntervalIntegrable (fun z : ℝ => A * |z - w|)
      volume w (w + y) := by
    exact ((continuous_const : Continuous (fun _ : ℝ => A)).mul
      ((continuous_id.sub continuous_const).abs)).intervalIntegrable w (w + y)
  have hConstII : IntervalIntegrable (fun _ : ℝ => K) volume w (w + y) :=
    intervalIntegrable_const
  have hCont := hContII.def'
  have hConst := hConstII.def'
  have hMajor := hCont.add hConst
  have hpoint : ∀ z ∈ uIoc w (w + y),
      |standardNormalSteinDerivative x z - standardNormalSteinDerivative x w| ≤
        A * |z - w| + K := by
    intro z hz
    have hwy : w ≤ w + y := by linarith
    rw [uIoc_of_le hwy] at hz
    have hs : 0 ≤ z - w := sub_nonneg.mpr hz.1.le
    have hsy : z - w ≤ y := by linarith [hz.2]
    have hD :=
      abs_standardNormalSteinDerivative_add_sub_le_indicator_Ioc_of_nonneg
        x w (z - w) hs
    rw [show w + (z - w) = z by ring] at hD
    exact hD.trans (by
      simpa only [A, K] using add_le_add_right
        (indicator_Ioc_sub_le_of_nonneg x w (z - w) y hs hsy)
        ((|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          |z - w|))
  have hmono := setIntegral_mono_on hLeft hMajor measurableSet_uIoc hpoint
  have hpow : (∫ z in uIoc w (w + y), |z - w|) = y ^ 2 / 2 := by
    have h := integral_pow_abs_sub_uIoc (a := w) (b := w + y) (n := 1)
    norm_num [abs_of_nonneg hy] at h
    simpa using h
  have hconst : (∫ _z in uIoc w (w + y), K) = y * K := by
    have hvol : volume.real (uIoc w (w + y)) = y := by
      simp [MeasureTheory.measureReal_def, hy]
    rw [setIntegral_const, hvol, smul_eq_mul]
  calc
    (∫ z in uIoc w (w + y),
      |standardNormalSteinDerivative x z -
        standardNormalSteinDerivative x w|) ≤
      ∫ z in uIoc w (w + y), (A * |z - w| + K) := hmono
    _ = A * (∫ z in uIoc w (w + y), |z - w|) +
        ∫ _z in uIoc w (w + y), K := by
      rw [integral_add hCont hConst, integral_const_mul]
    _ = A * (y ^ 2 / 2) + y * K := by rw [hpow, hconst]
    _ = _ := by rfl

/-- Negative-displacement integral of the derivative increment.  Reversing the
interval changes only the directional crossing event and replaces its length
by `-y = |y|`. -/
theorem integral_abs_standardNormalSteinDerivative_sub_le_of_nonpos
    (x w y : ℝ) (hy : y ≤ 0) :
    (∫ z in uIoc w (w + y),
      |standardNormalSteinDerivative x z -
        standardNormalSteinDerivative x w|) ≤
      (|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (y ^ 2 / 2) +
        (-y) * (Ioc x (x - y)).indicator (fun _ : ℝ => (1 : ℝ)) w := by
  let A : ℝ := |w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
  let K : ℝ := (Ioc x (x - y)).indicator (fun _ : ℝ => (1 : ℝ)) w
  have hDiffII : IntervalIntegrable (fun z =>
      standardNormalSteinDerivative x z - standardNormalSteinDerivative x w)
      volume w (w + y) :=
    (intervalIntegrable_standardNormalSteinDerivative x w (w + y)).sub
      intervalIntegrable_const
  have hLeft : IntegrableOn (fun z =>
      |standardNormalSteinDerivative x z - standardNormalSteinDerivative x w|)
      (uIoc w (w + y)) volume := by
    simpa only [Real.norm_eq_abs] using hDiffII.norm.def'
  have hContII : IntervalIntegrable (fun z : ℝ => A * |z - w|)
      volume w (w + y) := by
    exact ((continuous_const : Continuous (fun _ : ℝ => A)).mul
      ((continuous_id.sub continuous_const).abs)).intervalIntegrable w (w + y)
  have hConstII : IntervalIntegrable (fun _ : ℝ => K) volume w (w + y) :=
    intervalIntegrable_const
  have hCont := hContII.def'
  have hConst := hConstII.def'
  have hMajor := hCont.add hConst
  have hpoint : ∀ z ∈ uIoc w (w + y),
      |standardNormalSteinDerivative x z - standardNormalSteinDerivative x w| ≤
        A * |z - w| + K := by
    intro z hz
    have hwy : w + y ≤ w := by linarith
    rw [uIoc_of_ge hwy] at hz
    have hys : y ≤ z - w := by linarith [hz.1]
    have hs : z - w ≤ 0 := sub_nonpos.mpr hz.2
    have hD :=
      abs_standardNormalSteinDerivative_add_sub_le_indicator_Ioc_of_nonpos
        x w (z - w) hs
    rw [show w + (z - w) = z by ring] at hD
    exact hD.trans (by
      simpa only [A, K] using add_le_add_right
        (indicator_Ioc_sub_le_of_nonpos x w y (z - w) hys hs)
        ((|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          |z - w|))
  have hmono := setIntegral_mono_on hLeft hMajor measurableSet_uIoc hpoint
  have hpow : (∫ z in uIoc w (w + y), |z - w|) = y ^ 2 / 2 := by
    have h := integral_pow_abs_sub_uIoc (a := w) (b := w + y) (n := 1)
    norm_num [abs_of_nonpos hy] at h
    convert h using 1
  have hconst : (∫ _z in uIoc w (w + y), K) = (-y) * K := by
    have hvol : volume.real (uIoc w (w + y)) = -y := by
      simp [MeasureTheory.measureReal_def, hy]
    rw [setIntegral_const, hvol, smul_eq_mul]
  calc
    (∫ z in uIoc w (w + y),
      |standardNormalSteinDerivative x z -
        standardNormalSteinDerivative x w|) ≤
      ∫ z in uIoc w (w + y), (A * |z - w| + K) := hmono
    _ = A * (∫ z in uIoc w (w + y), |z - w|) +
        ∫ _z in uIoc w (w + y), K := by
      rw [integral_add hCont hConst, integral_const_mul]
    _ = A * (y ^ 2 / 2) + (-y) * K := by rw [hpow, hconst]
    _ = _ := by rfl

/-- Sign-free derivative-increment integral bound, with the directional atomic
term represented by the measurable crossing set. -/
theorem integral_abs_standardNormalSteinDerivative_sub_le_crossingSet
    (x w y : ℝ) :
    (∫ z in uIoc w (w + y),
      |standardNormalSteinDerivative x z -
        standardNormalSteinDerivative x w|) ≤
      (|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (y ^ 2 / 2) +
        |y| * (standardNormalSteinCrossingSet x 1).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ)) (w, y) := by
  by_cases hy : 0 ≤ y
  · rcases eq_or_lt_of_le hy with hzero | hpos
    · subst y
      simp [standardNormalSteinCrossingSet]
    · have hnpos : ¬ y ≤ 0 := not_le_of_gt hpos
      simpa [standardNormalSteinCrossingSet, Set.indicator_apply, hy,
        hnpos, abs_of_pos hpos] using
        integral_abs_standardNormalSteinDerivative_sub_le_of_nonneg x w y hy
  · have hneg : y < 0 := lt_of_not_ge hy
    have hy' : y ≤ 0 := hneg.le
    simpa [standardNormalSteinCrossingSet, Set.indicator_apply, hy,
      hy', abs_of_neg hneg] using
      integral_abs_standardNormalSteinDerivative_sub_le_of_nonpos x w y hy'

/-- First-order interval remainder bound with a quadratic continuous term and
the direction-sensitive threshold-crossing term exposed explicitly. -/
theorem abs_mul_standardNormalSteinDerivative_sub_intervalIntegral_le_crossingSet
    (x w y : ℝ) :
    |y * standardNormalSteinDerivative x w -
        (∫ z in w..w + y, standardNormalSteinDerivative x z)| ≤
      (|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (y ^ 2 / 2) +
        |y| * (standardNormalSteinCrossingSet x 1).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ)) (w, y) := by
  have h := abs_mul_standardNormalSteinDerivative_sub_intervalIntegral_le
    x w (w + y)
  have h' :
      |y * standardNormalSteinDerivative x w -
          (∫ z in w..w + y, standardNormalSteinDerivative x z)| ≤
        ∫ z in uIoc w (w + y),
          |standardNormalSteinDerivative x z -
            standardNormalSteinDerivative x w| := by
    convert h using 1; ring
  exact h'.trans
    (integral_abs_standardNormalSteinDerivative_sub_le_crossingSet x w y)

/-- After multiplying the first-order remainder by the displacement, the
continuous term is cubic and the crossing term carries the squared
displacement. -/
theorem abs_sq_mul_standardNormalSteinDerivative_sub_mul_intervalIntegral_le_crossingSet
    (x w y : ℝ) :
    |y ^ 2 * standardNormalSteinDerivative x w -
        y * (∫ z in w..w + y, standardNormalSteinDerivative x z)| ≤
      (|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (|y| ^ 3 / 2) +
        y ^ 2 * (standardNormalSteinCrossingSet x 1).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ)) (w, y) := by
  have h :=
    abs_mul_standardNormalSteinDerivative_sub_intervalIntegral_le_crossingSet
      x w y
  have hmul := mul_le_mul_of_nonneg_left h (abs_nonneg y)
  calc
    |y ^ 2 * standardNormalSteinDerivative x w -
        y * (∫ z in w..w + y, standardNormalSteinDerivative x z)| =
      |y| * |y * standardNormalSteinDerivative x w -
        (∫ z in w..w + y, standardNormalSteinDerivative x z)| := by
          rw [← abs_mul]
          congr 1
          ring
    _ ≤ |y| *
        ((|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
            (y ^ 2 / 2) +
          |y| * (standardNormalSteinCrossingSet x 1).indicator
            (fun _ : ℝ × ℝ => (1 : ℝ)) (w, y)) := hmul
    _ = (|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (|y| ^ 3 / 2) +
        y ^ 2 * (standardNormalSteinCrossingSet x 1).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ)) (w, y) := by
      rw [← sq_abs y]
      ring

/-- A nonnegative scale can be moved from the displacement coordinate into the
scale parameter of the crossing set. -/
theorem mem_standardNormalSteinCrossingSet_one_mul_iff
    (x scale w v : ℝ) (hscale : 0 ≤ scale) :
    (w, scale * v) ∈ standardNormalSteinCrossingSet x 1 ↔
      (w, v) ∈ standardNormalSteinCrossingSet x scale := by
  by_cases hzero : scale = 0
  · subst scale
    simp [standardNormalSteinCrossingSet]
  · have hpos : 0 < scale := lt_of_le_of_ne hscale (Ne.symm hzero)
    have hnonneg : 0 ≤ scale * v ↔ 0 ≤ v :=
      mul_nonneg_iff_of_pos_left hpos
    have hnonpos : scale * v ≤ 0 ↔ v ≤ 0 := by
      simpa using
        (mul_le_mul_iff_right₀ hpos : scale * v ≤ scale * 0 ↔ v ≤ 0)
    simp [standardNormalSteinCrossingSet, hnonneg, hnonpos]

theorem standardNormalSteinCrossingSet_indicator_one_mul_eq
    (x scale w v : ℝ) (hscale : 0 ≤ scale) :
    (standardNormalSteinCrossingSet x 1).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (w, scale * v) =
      (standardNormalSteinCrossingSet x scale).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (w, v) := by
  classical
  have hmem := mem_standardNormalSteinCrossingSet_one_mul_iff
    x scale w v hscale
  by_cases h : (w, scale * v) ∈ standardNormalSteinCrossingSet x 1
  · rw [Set.indicator_of_mem h, Set.indicator_of_mem (hmem.mp h)]
  · have h' : (w, v) ∉ standardNormalSteinCrossingSet x scale :=
      fun hv => h (hmem.mpr hv)
    rw [Set.indicator_of_notMem h, Set.indicator_of_notMem h']

/-- Scaled version of the cubic interval-remainder bound, arranged in the
normalization used by the leave-one-out sum. -/
theorem abs_scale_sq_mul_standardNormalSteinDerivative_sub_scale_mul_intervalIntegral_le
    (x w scale v : ℝ) (hscale : 0 ≤ scale) :
    |scale ^ 2 * v ^ 2 * standardNormalSteinDerivative x w -
        scale * v *
          (∫ z in w..w + scale * v, standardNormalSteinDerivative x z)| ≤
      (|w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (scale ^ 3 * |v| ^ 3 / 2) +
        scale ^ 2 * v ^ 2 *
          (standardNormalSteinCrossingSet x scale).indicator
            (fun _ : ℝ × ℝ => (1 : ℝ)) (w, v) := by
  have h :=
    abs_sq_mul_standardNormalSteinDerivative_sub_mul_intervalIntegral_le_crossingSet
      x w (scale * v)
  rw [standardNormalSteinCrossingSet_indicator_one_mul_eq
    x scale w v hscale] at h
  simpa [mul_pow, abs_mul, abs_of_nonneg hscale, mul_assoc] using h

/-- Pointwise interval-remainder estimate for one normalized summand in the
leave-one-out decomposition. -/
theorem abs_normalizedSummand_steinIntervalRemainder_le
    {Omega : Type*} (X : ℕ → Omega → ℝ) (N : ℕ) (i : Fin (N + 1))
    (x : ℝ) (omega : Omega) :
    let W := normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    |scale ^ 2 * (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) -
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z)| ≤
      (|Wi omega| +
          Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (scale ^ 3 * |X i.1 omega| ^ 3 / 2) +
        scale ^ 2 * (X i.1 omega) ^ 2 *
          (standardNormalSteinCrossingSet x scale).indicator
            (fun _ : ℝ × ℝ => (1 : ℝ))
            (Wi omega, X i.1 omega) := by
  dsimp only
  rw [normalizedCenteredIidSum_eq_leaveOneOut_add]
  exact
    abs_scale_sq_mul_standardNormalSteinDerivative_sub_scale_mul_intervalIntegral_le
      x (normalizedCenteredIidLeaveOneOut X N i omega)
        (Real.sqrt (N + 1 : ℝ))⁻¹ (X i.1 omega)
        (inv_nonneg.mpr (Real.sqrt_nonneg _))

/-- Pointwise leave-one-out specialization of the derivative-increment
bound, with the normalized removed summand exposed explicitly. -/
theorem abs_standardNormalSteinDerivative_sum_sub_leaveOneOut_le_crossing
    {Omega : Type*} (X : ℕ → Omega → ℝ) (N : ℕ) (i : Fin (N + 1))
    (x : ℝ) (omega : Omega) :
    let W := normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    |standardNormalSteinDerivative x (W omega) -
        standardNormalSteinDerivative x (Wi omega)| ≤
      (|Wi omega| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (scale * |X i.1 omega|) +
        (uIcc (Wi omega) (W omega)).indicator
          (fun _ : ℝ => (1 : ℝ)) x := by
  dsimp only
  have h := abs_standardNormalSteinDerivative_sub_le_crossing x
    (normalizedCenteredIidLeaveOneOut X N i omega)
    (normalizedCenteredIidSum X N omega)
  have hscale : 0 ≤ (Real.sqrt (N + 1 : ℝ))⁻¹ :=
    inv_nonneg.mpr (Real.sqrt_nonneg _)
  have hdiff :
      |normalizedCenteredIidSum X N omega -
          normalizedCenteredIidLeaveOneOut X N i omega| =
        (Real.sqrt (N + 1 : ℝ))⁻¹ * |X i.1 omega| := by
    rw [normalizedCenteredIidSum_eq_leaveOneOut_add,
      add_sub_cancel_left, abs_mul, abs_of_nonneg hscale]
  rw [hdiff] at h
  exact h

/-- Positive removed-summand specialization with a half-open crossing
interval of the exact normalized summand length. -/
theorem abs_standardNormalSteinDerivative_sum_sub_leaveOneOut_le_of_nonneg
    {Omega : Type*} (X : ℕ → Omega → ℝ) (N : ℕ) (i : Fin (N + 1))
    (x : ℝ) (omega : Omega) (hXi : 0 ≤ X i.1 omega) :
    let W := normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    |standardNormalSteinDerivative x (W omega) -
        standardNormalSteinDerivative x (Wi omega)| ≤
      (|Wi omega| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (scale * |X i.1 omega|) +
        (Ioc (x - scale * X i.1 omega) x).indicator
          (fun _ : ℝ => (1 : ℝ)) (Wi omega) := by
  dsimp only
  rw [normalizedCenteredIidSum_eq_leaveOneOut_add]
  have hscale : 0 ≤ (Real.sqrt (N + 1 : ℝ))⁻¹ :=
    inv_nonneg.mpr (Real.sqrt_nonneg _)
  have h := abs_standardNormalSteinDerivative_add_sub_le_indicator_Ioc_of_nonneg
    x (normalizedCenteredIidLeaveOneOut X N i omega)
      ((Real.sqrt (N + 1 : ℝ))⁻¹ * X i.1 omega)
      (mul_nonneg hscale hXi)
  rw [abs_mul, abs_of_nonneg hscale] at h
  exact h

/-- Negative removed-summand specialization with a half-open crossing
interval of the exact normalized summand length. -/
theorem abs_standardNormalSteinDerivative_sum_sub_leaveOneOut_le_of_nonpos
    {Omega : Type*} (X : ℕ → Omega → ℝ) (N : ℕ) (i : Fin (N + 1))
    (x : ℝ) (omega : Omega) (hXi : X i.1 omega ≤ 0) :
    let W := normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    |standardNormalSteinDerivative x (W omega) -
        standardNormalSteinDerivative x (Wi omega)| ≤
      (|Wi omega| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (scale * |X i.1 omega|) +
        (Ioc x (x - scale * X i.1 omega)).indicator
          (fun _ : ℝ => (1 : ℝ)) (Wi omega) := by
  dsimp only
  rw [normalizedCenteredIidSum_eq_leaveOneOut_add]
  have hscale : 0 ≤ (Real.sqrt (N + 1 : ℝ))⁻¹ :=
    inv_nonneg.mpr (Real.sqrt_nonneg _)
  have h := abs_standardNormalSteinDerivative_add_sub_le_indicator_Ioc_of_nonpos
    x (normalizedCenteredIidLeaveOneOut X N i omega)
      ((Real.sqrt (N + 1 : ℝ))⁻¹ * X i.1 omega)
      (mul_nonpos_of_nonneg_of_nonpos hscale hXi)
  rw [abs_mul, abs_of_nonneg hscale] at h
  exact h

/-- Unified pointwise leave-one-out increment bound.  The measurable crossing
set records the sign split without placing a decidable conditional in the
statement. -/
theorem abs_standardNormalSteinDerivative_sum_sub_leaveOneOut_le_crossingSet
    {Omega : Type*} (X : ℕ → Omega → ℝ) (N : ℕ) (i : Fin (N + 1))
    (x : ℝ) (omega : Omega) :
    let W := normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    |standardNormalSteinDerivative x (W omega) -
        standardNormalSteinDerivative x (Wi omega)| ≤
      (|Wi omega| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
          (scale * |X i.1 omega|) +
        (standardNormalSteinCrossingSet x scale).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega) := by
  dsimp only
  rw [normalizedCenteredIidSum_eq_leaveOneOut_add]
  have hscale : 0 ≤ (Real.sqrt (N + 1 : ℝ))⁻¹ :=
    inv_nonneg.mpr (Real.sqrt_nonneg _)
  by_cases hzero : X i.1 omega = 0
  · rw [hzero]
    simp [standardNormalSteinCrossingSet]
  · rcases lt_or_gt_of_ne hzero with hneg | hpos
    · have h :=
        abs_standardNormalSteinDerivative_add_sub_le_indicator_Ioc_of_nonpos
          x (normalizedCenteredIidLeaveOneOut X N i omega)
          ((Real.sqrt (N + 1 : ℝ))⁻¹ * X i.1 omega)
          (mul_nonpos_of_nonneg_of_nonpos hscale hneg.le)
      rw [abs_mul, abs_of_nonneg hscale] at h
      simpa [standardNormalSteinCrossingSet, Set.indicator_apply,
        hneg.le, not_le_of_gt hneg] using h
    · have h :=
        abs_standardNormalSteinDerivative_add_sub_le_indicator_Ioc_of_nonneg
          x (normalizedCenteredIidLeaveOneOut X N i omega)
          ((Real.sqrt (N + 1 : ℝ))⁻¹ * X i.1 omega)
          (mul_nonneg hscale hpos.le)
      rw [abs_mul, abs_of_nonneg hscale] at h
      simpa [standardNormalSteinCrossingSet, Set.indicator_apply,
        hpos.le, not_le_of_gt hpos] using h

theorem abs_standardNormalSteinDerivative_le_linear (x z : ℝ) :
    |standardNormalSteinDerivative x z| ≤
      Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) * |z| + 1 := by
  unfold standardNormalSteinDerivative
  calc
    |z * standardNormalSteinSolution x z +
        standardNormalHalfLineSteinTarget x z| ≤
      |z * standardNormalSteinSolution x z| +
        |standardNormalHalfLineSteinTarget x z| := abs_add_le _ _
    _ = |z| * standardNormalSteinSolution x z +
        |standardNormalHalfLineSteinTarget x z| := by
      rw [abs_mul, abs_of_nonneg (standardNormalSteinSolution_nonneg x z)]
    _ ≤ |z| * (Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) + 1 :=
      add_le_add
        (mul_le_mul_of_nonneg_left (standardNormalSteinSolution_le x z) (abs_nonneg z))
        (abs_standardNormalHalfLineSteinTarget_le_one x z)
    _ = Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) * |z| + 1 := by ring

/-- A location-dependent Lipschitz bound obtained from the exact increment
formula and the coarse linear bound for the total Stein derivative. -/
theorem abs_standardNormalSteinSolution_sub_le_linear
    (x a b : ℝ) :
    |standardNormalSteinSolution x b - standardNormalSteinSolution x a| ≤
      (Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) *
          max |a| |b| + 1) * |b - a| := by
  have hC : 0 ≤ Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) := by
    positivity
  have hbound : ∀ z ∈ uIoc a b,
      ‖standardNormalSteinDerivative x z‖ ≤
        Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) *
          max |a| |b| + 1 := by
    intro z hz
    have hzabs : |z| ≤ max |a| |b| := by
      rcases le_total a b with hab | hba
      · rw [uIoc_of_le hab] at hz
        exact abs_le_max_abs_abs (le_of_lt hz.1) hz.2
      · rw [uIoc_of_ge hba] at hz
        simpa only [max_comm] using abs_le_max_abs_abs (le_of_lt hz.1) hz.2
    rw [Real.norm_eq_abs]
    exact (abs_standardNormalSteinDerivative_le_linear x z).trans
      (by linarith [mul_le_mul_of_nonneg_left hzabs hC])
  have hnorm := intervalIntegral.norm_integral_le_of_norm_le_const hbound
  rw [intervalIntegral_standardNormalSteinDerivative_eq_sub,
    Real.norm_eq_abs] at hnorm
  exact hnorm

/-- Exact normalized-sum leave-one-out identity with every Stein-solution
increment rewritten as an oriented integral of the total derivative. -/
theorem integral_normalizedCenteredIidSum_stein_eq_leaveOneOutInterval
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (hMean : ∀ j, ∫ omega, X j omega ∂mu = 0)
    (N : ℕ) (x : ℝ) :
    let W := normalizedCenteredIidSum X N
    (∫ omega, standardNormalSteinDerivative x (W omega) ∂mu) -
        (Real.sqrt (N + 1 : ℝ))⁻¹ *
          ∑ i : Fin (N + 1), ∫ omega,
            X i.1 omega *
              (∫ z in normalizedCenteredIidLeaveOneOut X N i omega..W omega,
                standardNormalSteinDerivative x z) ∂mu =
      cdf (probabilityLaw W
          (normalizedCenteredIidSum_memLp X hX N).aemeasurable) x -
        cdf standardNormalLaw x := by
  have h := integral_normalizedCenteredIidSum_stein_eq_leaveOneOut
    X hX hIndep hMean N x
  dsimp only at h ⊢
  simpa only [intervalIntegral_standardNormalSteinDerivative_eq_sub] using h

/-- Independence and unit variance identify the quadratic summand factor with
the derivative expectation at the corresponding leave-one-out sum. -/
theorem integral_sq_mul_standardNormalSteinDerivative_leaveOneOut_eq
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ)
    (hSecond : ∫ omega, (X i.1 omega) ^ 2 ∂mu = 1) :
    (∫ omega, (X i.1 omega) ^ 2 * standardNormalSteinDerivative x
        (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu) =
      ∫ omega, standardNormalSteinDerivative x
        (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu := by
  have hLeave := normalizedCenteredIidLeaveOneOut_memLp X hX N i
  have hind := indepFun_normalizedCenteredIidLeaveOneOut
    X (fun j => (hX j).aemeasurable) hIndep N i
  have hfact := hind.integral_comp_mul_comp
    (hX i.1).aemeasurable hLeave.aemeasurable
    (show AEStronglyMeasurable (fun y : ℝ => y ^ 2)
        (Measure.map (X i.1) mu) by fun_prop)
    (measurable_standardNormalSteinDerivative x).aestronglyMeasurable
  simpa [Function.comp_def, hSecond] using hfact

/-- Exact variance-cancellation decomposition of the normalized-sum Stein
identity.  The first bracket compares derivative expectations, while the
second is the summandwise interval remainder before any estimate. -/
theorem integral_normalizedCenteredIidSum_stein_varianceCancellation
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (hMean : ∀ j, ∫ omega, X j omega ∂mu = 0)
    (hSecond : ∀ j, ∫ omega, (X j omega) ^ 2 ∂mu = 1)
    (N : ℕ) (x : ℝ) :
    let W := normalizedCenteredIidSum X N
    let a := (Real.sqrt (N + 1 : ℝ))⁻¹
    ((∫ omega, standardNormalSteinDerivative x (W omega) ∂mu) -
        a ^ 2 * ∑ i : Fin (N + 1), ∫ omega,
          standardNormalSteinDerivative x
            (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu) +
      (a ^ 2 * ∑ i : Fin (N + 1), ∫ omega,
          (X i.1 omega) ^ 2 * standardNormalSteinDerivative x
            (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu -
        a * ∑ i : Fin (N + 1), ∫ omega,
          X i.1 omega *
            (∫ z in normalizedCenteredIidLeaveOneOut X N i omega..W omega,
              standardNormalSteinDerivative x z) ∂mu) =
      cdf (probabilityLaw W
          (normalizedCenteredIidSum_memLp X hX N).aemeasurable) x -
        cdf standardNormalLaw x := by
  have h := integral_normalizedCenteredIidSum_stein_eq_leaveOneOutInterval
    X hX hIndep hMean N x
  have hVar :
      (∑ i : Fin (N + 1), ∫ omega,
          (X i.1 omega) ^ 2 * standardNormalSteinDerivative x
            (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu) =
        ∑ i : Fin (N + 1), ∫ omega,
          standardNormalSteinDerivative x
            (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu := by
    apply Finset.sum_congr rfl
    intro i _
    exact integral_sq_mul_standardNormalSteinDerivative_leaveOneOut_eq
      X hX hIndep N i x (hSecond i.1)
  dsimp only at h ⊢
  rw [hVar]
  linarith

end SteinBounds

theorem hasDerivAt_standardNormalPDF (x : ℝ) :
    HasDerivAt (ProbabilityTheory.gaussianPDFReal 0 1)
      (-x * ProbabilityTheory.gaussianPDFReal 0 1 x) x := by
  have hinner : HasDerivAt (fun y : ℝ => -(y - 0) ^ 2 / (2 * (1 : ℝ))) (-x) x := by
    convert (((hasDerivAt_id x).sub_const 0).pow 2).neg.div_const (2 * 1) using 1
    simp; ring
  have hexp : HasDerivAt
      (fun y : ℝ => Real.exp (-(y - 0) ^ 2 / (2 * (1 : ℝ))))
      (Real.exp (-(x - 0) ^ 2 / (2 * (1 : ℝ))) * (-x)) x :=
    (Real.hasDerivAt_exp _).comp x hinner
  have hmul := hexp.const_mul (Real.sqrt (2 * Real.pi * (1 : ℝ)))⁻¹
  simpa only [ProbabilityTheory.gaussianPDFReal_def, NNReal.coe_one,
    mul_one, sub_zero, neg_mul, mul_neg, mul_comm, mul_left_comm, mul_assoc] using hmul

theorem hasDerivAt_standardNormalPDF_deriv (x : ℝ) :
    HasDerivAt
      (fun y => -y * ProbabilityTheory.gaussianPDFReal 0 1 y)
      ((x ^ 2 - 1) * ProbabilityTheory.gaussianPDFReal 0 1 x) x := by
  convert (hasDerivAt_id x).neg.mul (hasDerivAt_standardNormalPDF x) using 1
  simp; ring

theorem contDiff_three_standardNormalCDF :
    ContDiff ℝ 3
      (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
  rw [show (3 : WithTop ℕ∞) = 2 + 1 by norm_num, contDiff_succ_iff_deriv]
  refine ⟨fun x => (hasDerivAt_standardNormalCDF x).differentiableAt, by norm_num, ?_⟩
  have hderiv :
      deriv (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) =
        ProbabilityTheory.gaussianPDFReal 0 1 := by
    funext x
    exact (hasDerivAt_standardNormalCDF x).deriv
  rw [hderiv, ProbabilityTheory.gaussianPDFReal_def]
  fun_prop

theorem iteratedDeriv_three_standardNormalCDF (x : ℝ) :
    iteratedDeriv 3
        (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) x =
      (x ^ 2 - 1) * ProbabilityTheory.gaussianPDFReal 0 1 x := by
  rw [show 3 = 2 + 1 by norm_num, iteratedDeriv_succ']
  rw [show 2 = 1 + 1 by norm_num, iteratedDeriv_succ]
  rw [show 1 = 0 + 1 by norm_num, iteratedDeriv_succ']
  simp only [iteratedDeriv_zero]
  have hderivCDF :
      deriv (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) =
        ProbabilityTheory.gaussianPDFReal 0 1 := by
    funext y
    exact (hasDerivAt_standardNormalCDF y).deriv
  rw [hderivCDF]
  have hderivPDF :
      deriv (ProbabilityTheory.gaussianPDFReal 0 1) =
        fun y => -y * ProbabilityTheory.gaussianPDFReal 0 1 y := by
    funext y
    exact (hasDerivAt_standardNormalPDF y).deriv
  rw [hderivPDF]
  exact (hasDerivAt_standardNormalPDF_deriv x).deriv

theorem sq_mul_exp_neg_half_le_two (x : ℝ) :
    x ^ 2 * Real.exp (-(x ^ 2) / 2) ≤ 2 := by
  have hmain := Real.mul_exp_neg_le_exp_neg_one (x ^ 2 / 2)
  have hone : Real.exp (-1) ≤ 1 := Real.exp_le_one_iff.mpr (by norm_num)
  have h := hmain.trans hone
  have hexp : Real.exp (-(x ^ 2) / 2) = Real.exp (-(x ^ 2 / 2)) := by
    congr 1
    ring
  rw [hexp]
  nlinarith

theorem abs_iteratedDeriv_three_standardNormalCDF_le (x : ℝ) :
    |iteratedDeriv 3
        (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) x| ≤
      3 * (Real.sqrt (2 * Real.pi))⁻¹ := by
  rw [iteratedDeriv_three_standardNormalCDF,
    ProbabilityTheory.gaussianPDFReal_def]
  simp only [NNReal.coe_one, mul_one, sub_zero]
  have hC : 0 ≤ (Real.sqrt (2 * Real.pi))⁻¹ :=
    inv_nonneg.mpr (Real.sqrt_nonneg _)
  have habs : |x ^ 2 - 1| ≤ x ^ 2 + 1 := by
    rw [abs_le]
    constructor <;> nlinarith [sq_nonneg x]
  have hexp : Real.exp (-(x ^ 2) / 2) ≤ 1 :=
    Real.exp_le_one_iff.mpr (by nlinarith [sq_nonneg x])
  have hpoly :
      |x ^ 2 - 1| * Real.exp (-(x ^ 2) / 2) ≤ 3 := by
    calc
      |x ^ 2 - 1| * Real.exp (-(x ^ 2) / 2) ≤
          (x ^ 2 + 1) * Real.exp (-(x ^ 2) / 2) :=
        mul_le_mul_of_nonneg_right habs (Real.exp_pos _).le
      _ = x ^ 2 * Real.exp (-(x ^ 2) / 2) +
          Real.exp (-(x ^ 2) / 2) := by ring
      _ ≤ 2 + 1 := add_le_add (sq_mul_exp_neg_half_le_two x) hexp
      _ = 3 := by norm_num
  rw [abs_mul, abs_mul, abs_of_nonneg hC, abs_of_pos (Real.exp_pos _)]
  nlinarith [mul_le_mul_of_nonneg_left hpoly hC]

/-- The standard-normal density is twice continuously differentiable. -/
theorem contDiff_two_standardNormalPDF :
    ContDiff ℝ 2 (ProbabilityTheory.gaussianPDFReal 0 1) := by
  rw [ProbabilityTheory.gaussianPDFReal_def]
  fun_prop

theorem iteratedDeriv_one_affine_standardNormalPDF (a y t : ℝ) :
    iteratedDeriv 1
        (fun u => ProbabilityTheory.gaussianPDFReal 0 1 (a + y * u)) t =
      y * (-(a + y * t) *
        ProbabilityTheory.gaussianPDFReal 0 1 (a + y * t)) := by
  rw [show 1 = 0 + 1 by norm_num, iteratedDeriv_succ', iteratedDeriv_zero]
  have hinner : HasDerivAt (fun u : ℝ => a + y * u) y t := by
    convert (hasDerivAt_const t a).add ((hasDerivAt_id t).const_mul y) using 1
    simp
  convert ((hasDerivAt_standardNormalPDF (a + y * t)).comp t hinner).deriv using 1
  ring

theorem iteratedDeriv_two_affine_standardNormalPDF (a y t : ℝ) :
    iteratedDeriv 2
        (fun u => ProbabilityTheory.gaussianPDFReal 0 1 (a + y * u)) t =
      y ^ 2 * (((a + y * t) ^ 2 - 1) *
        ProbabilityTheory.gaussianPDFReal 0 1 (a + y * t)) := by
  rw [show 2 = 1 + 1 by norm_num, iteratedDeriv_succ]
  have hfirst :
      iteratedDeriv 1
          (fun u => ProbabilityTheory.gaussianPDFReal 0 1 (a + y * u)) =
        fun u => y * (-(a + y * u) *
          ProbabilityTheory.gaussianPDFReal 0 1 (a + y * u)) := by
    funext u
    exact iteratedDeriv_one_affine_standardNormalPDF a y u
  rw [hfirst]
  have hinner : HasDerivAt (fun u : ℝ => a + y * u) y t := by
    convert (hasDerivAt_const t a).add ((hasDerivAt_id t).const_mul y) using 1
    simp
  have hpdf :=
    (hasDerivAt_standardNormalPDF_deriv (a + y * t)).comp t hinner
  convert hpdf.const_mul y |>.deriv using 1; ring

theorem abs_iteratedDeriv_two_affine_standardNormalPDF_le (a y t : ℝ) :
    |iteratedDeriv 2
        (fun u => ProbabilityTheory.gaussianPDFReal 0 1 (a + y * u)) t| ≤
      (3 * (Real.sqrt (2 * Real.pi))⁻¹) * |y| ^ 2 := by
  rw [iteratedDeriv_two_affine_standardNormalPDF, abs_mul, abs_pow]
  have h := abs_iteratedDeriv_three_standardNormalCDF_le (a + y * t)
  rw [iteratedDeriv_three_standardNormalCDF] at h
  nlinarith [mul_le_mul_of_nonneg_left h (pow_nonneg (abs_nonneg y) 2)]

theorem taylorWithinEval_one_affine_standardNormalPDF (a y : ℝ) :
    taylorWithinEval
        (fun t => ProbabilityTheory.gaussianPDFReal 0 1 (a + y * t))
        1 (Icc 0 1) 0 1 =
      ProbabilityTheory.gaussianPDFReal 0 1 a +
        y * (-a * ProbabilityTheory.gaussianPDFReal 0 1 a) := by
  let g : ℝ → ℝ := fun t =>
    ProbabilityTheory.gaussianPDFReal 0 1 (a + y * t)
  have hg : ContDiff ℝ 2 g := contDiff_two_standardNormalPDF.comp (by fun_prop)
  have hu : UniqueDiffOn ℝ (Icc (0 : ℝ) 1) := uniqueDiffOn_Icc zero_lt_one
  have hzero : (0 : ℝ) ∈ Icc (0 : ℝ) 1 := by norm_num
  have hwithin0 : iteratedDerivWithin 0 g (Icc 0 1) 0 = iteratedDeriv 0 g 0 :=
    iteratedDerivWithin_eq_iteratedDeriv hu (hg.of_le (by norm_num)).contDiffAt hzero
  have hwithin1 : iteratedDerivWithin 1 g (Icc 0 1) 0 = iteratedDeriv 1 g 0 :=
    iteratedDerivWithin_eq_iteratedDeriv hu (hg.of_le (by norm_num)).contDiffAt hzero
  change taylorWithinEval g 1 (Icc 0 1) 0 1 = _
  rw [taylor_within_apply]
  simp [Finset.sum_range_succ, hwithin0, hwithin1, iteratedDeriv_zero,
    g, iteratedDeriv_one_affine_standardNormalPDF, Nat.factorial]

/-- The standard-normal density admits a linear Taylor polynomial with the
uniform second-order remainder needed to exploit two signed spatial
cancellations. -/
theorem standardNormalPDF_linear_remainder (a y : ℝ) :
    |ProbabilityTheory.gaussianPDFReal 0 1 (a + y) -
        (ProbabilityTheory.gaussianPDFReal 0 1 a +
          y * (-a * ProbabilityTheory.gaussianPDFReal 0 1 a))| ≤
      ((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) * |y| ^ 2 := by
  let g : ℝ → ℝ := fun t =>
    ProbabilityTheory.gaussianPDFReal 0 1 (a + y * t)
  have hg : ContDiff ℝ 2 g := contDiff_two_standardNormalPDF.comp (by fun_prop)
  obtain ⟨t, _ht, hrem⟩ :=
    taylor_mean_remainder_lagrange_iteratedDeriv
      (f := g) (n := 1) (x₀ := 0) (x := 1) zero_lt_one hg.contDiffOn
  have hpoly := taylorWithinEval_one_affine_standardNormalPDF a y
  have hbound := abs_iteratedDeriv_two_affine_standardNormalPDF_le a y t
  have hdiv : |iteratedDeriv 2 g t| / 2 ≤
      ((3 * (Real.sqrt (2 * Real.pi))⁻¹) * |y| ^ 2) / 2 :=
    div_le_div_of_nonneg_right hbound (by norm_num)
  calc
    |ProbabilityTheory.gaussianPDFReal 0 1 (a + y) -
        (ProbabilityTheory.gaussianPDFReal 0 1 a +
          y * (-a * ProbabilityTheory.gaussianPDFReal 0 1 a))| =
        |g 1 - taylorWithinEval g 1 (Icc 0 1) 0 1| := by
      rw [hpoly]
      simp only [g, mul_one]
    _ = |iteratedDeriv 2 g t| / 2 := by
      rw [hrem]
      norm_num [Nat.factorial]
      rw [abs_div, abs_mul]
      change |iteratedDeriv 2 g t| * |(1 : ℝ)| / |(2 : ℝ)| =
        |iteratedDeriv 2 g t| / 2
      simp
    _ ≤ ((3 * (Real.sqrt (2 * Real.pi))⁻¹) * |y| ^ 2) / 2 := hdiv
    _ = ((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) * |y| ^ 2 := by ring

/-- The linear density remainder after scaling the standard normal by a
positive standard deviation.  The second-order coefficient scales exactly
as the inverse cube of the standard deviation. -/
theorem scaledStandardNormalPDF_linear_remainder
    {σ : ℝ} (hσ : 0 < σ) (a y : ℝ) :
    |σ⁻¹ *
      (ProbabilityTheory.gaussianPDFReal 0 1 ((a + y) / σ) -
        (ProbabilityTheory.gaussianPDFReal 0 1 (a / σ) +
          (y / σ) * (-(a / σ) *
            ProbabilityTheory.gaussianPDFReal 0 1 (a / σ))))| ≤
      (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) / σ ^ 3) * |y| ^ 2 := by
  have hrem := standardNormalPDF_linear_remainder (a / σ) (y / σ)
  rw [show a / σ + y / σ = (a + y) / σ by ring] at hrem
  rw [abs_mul, abs_of_pos (inv_pos.mpr hσ)]
  calc
    σ⁻¹ *
        |ProbabilityTheory.gaussianPDFReal 0 1 ((a + y) / σ) -
          (ProbabilityTheory.gaussianPDFReal 0 1 (a / σ) +
            (y / σ) * (-(a / σ) *
              ProbabilityTheory.gaussianPDFReal 0 1 (a / σ)))| ≤
        σ⁻¹ * (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) *
          |y / σ| ^ 2) :=
      mul_le_mul_of_nonneg_left hrem (inv_nonneg.mpr hσ.le)
    _ = (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) / σ ^ 3) *
        |y| ^ 2 := by
      rw [abs_div, abs_of_pos hσ]
      field_simp

/-- A positive scaled-normal density converts two exact spatial
cancellations into a second-order weighted `L¹ -> L∞` estimate. -/
theorem abs_integral_scaledStandardNormalPDF_mul_le_of_cancellations
    (e : ℝ → ℝ) (he : Integrable e)
    (he1 : Integrable (fun z => z * e z))
    (he2 : Integrable (fun z => |z| ^ 2 * |e z|))
    (hzero : (∫ z, e z) = 0)
    (hone : (∫ z, z * e z) = 0)
    {σ : ℝ} (hσ : 0 < σ) (x : ℝ) :
    |∫ z, σ⁻¹ * ProbabilityTheory.gaussianPDFReal 0 1 ((x - z) / σ) * e z| ≤
      (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) / σ ^ 3) *
        ∫ z, |z| ^ 2 * |e z| := by
  let K : ℝ → ℝ := fun z =>
    σ⁻¹ * ProbabilityTheory.gaussianPDFReal 0 1 ((x - z) / σ)
  let Q : ℝ → ℝ := fun z => σ⁻¹ *
    (ProbabilityTheory.gaussianPDFReal 0 1 (x / σ) +
      (-z / σ) * (-(x / σ) *
        ProbabilityTheory.gaussianPDFReal 0 1 (x / σ)))
  let C : ℝ := ((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) / σ ^ 3
  let A : ℝ := σ⁻¹ * ProbabilityTheory.gaussianPDFReal 0 1 (x / σ)
  let D : ℝ := σ⁻¹ * σ⁻¹ * (x / σ) *
    ProbabilityTheory.gaussianPDFReal 0 1 (x / σ)
  have hC : 0 ≤ C := by
    dsimp only [C]
    positivity
  have hrem (z : ℝ) : |K z - Q z| ≤ C * |z| ^ 2 := by
    have h := scaledStandardNormalPDF_linear_remainder hσ x (-z)
    dsimp only [K, Q, C]
    calc
      |σ⁻¹ * ProbabilityTheory.gaussianPDFReal 0 1 ((x - z) / σ) -
          σ⁻¹ * (ProbabilityTheory.gaussianPDFReal 0 1 (x / σ) +
            (-z / σ) * (-(x / σ) *
              ProbabilityTheory.gaussianPDFReal 0 1 (x / σ)))| =
          |σ⁻¹ *
            (ProbabilityTheory.gaussianPDFReal 0 1 ((x - z) / σ) -
              (ProbabilityTheory.gaussianPDFReal 0 1 (x / σ) +
                (-z / σ) * (-(x / σ) *
                  ProbabilityTheory.gaussianPDFReal 0 1 (x / σ))))| := by
        congr 1
        ring
      _ ≤ (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) / σ ^ 3) *
          |z| ^ 2 := by
        simpa only [sub_eq_add_neg, add_neg_cancel_right, neg_div,
          abs_neg] using h
  have hQfun : (fun z => Q z * e z) =
      fun z => A * e z + D * (z * e z) := by
    funext z
    dsimp only [Q, A, D]
    ring
  have hQProd : Integrable (fun z => Q z * e z) := by
    rw [hQfun]
    exact (he.const_mul A).add (he1.const_mul D)
  have hQInt : (∫ z, Q z * e z) = 0 := by
    rw [hQfun, integral_add (he.const_mul A) (he1.const_mul D),
      integral_const_mul, integral_const_mul, hzero, hone]
    ring
  have hmajor : Integrable (fun z => C * (|z| ^ 2 * |e z|)) :=
    he2.const_mul C
  have hRProd : Integrable (fun z => (K z - Q z) * e z) := by
    apply hmajor.mono' (by fun_prop)
    exact ae_of_all _ fun z => by
      change ‖(K z - Q z) * e z‖ ≤ C * (|z| ^ 2 * |e z|)
      rw [Real.norm_eq_abs, abs_mul]
      simpa only [mul_assoc] using
        mul_le_mul_of_nonneg_right (hrem z) (abs_nonneg (e z))
  have hKfun : (fun z => K z * e z) =
      fun z => (K z - Q z) * e z + Q z * e z := by
    funext z
    ring
  calc
    |∫ z, σ⁻¹ * ProbabilityTheory.gaussianPDFReal 0 1 ((x - z) / σ) * e z| =
        |∫ z, K z * e z| := by rfl
    _ = |(∫ z, (K z - Q z) * e z) + ∫ z, Q z * e z| := by
      rw [hKfun, integral_add hRProd hQProd]
    _ = |∫ z, (K z - Q z) * e z| := by rw [hQInt, add_zero]
    _ ≤ ∫ z, |(K z - Q z) * e z| := by
      simpa only [Real.norm_eq_abs] using
        (norm_integral_le_integral_norm (fun z => (K z - Q z) * e z))
    _ ≤ ∫ z, C * (|z| ^ 2 * |e z|) := by
      apply integral_mono hRProd.norm hmajor
      intro z
      change ‖(K z - Q z) * e z‖ ≤ C * (|z| ^ 2 * |e z|)
      rw [Real.norm_eq_abs, abs_mul]
      simpa only [mul_assoc] using
        mul_le_mul_of_nonneg_right (hrem z) (abs_nonneg (e z))
    _ = C * ∫ z, |z| ^ 2 * |e z| := by rw [integral_const_mul]

/-- Change of variables from averaging against a positively scaled standard
normal law to the corresponding translated scaled-density convolution. -/
theorem integral_comp_sub_map_mul_standardNormalLaw_eq_integral_scaledPDF
    (e : ℝ → ℝ) (he : Measurable e) {σ : ℝ} (hσ : 0 < σ) (x : ℝ) :
    (∫ y, e (x - y) ∂Measure.map (fun z : ℝ => σ * z)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) =
      ∫ z, σ⁻¹ * ProbabilityTheory.gaussianPDFReal 0 1 ((x - z) / σ) * e z := by
  have hfm : AEStronglyMeasurable (fun y : ℝ => e (x - y))
      (Measure.map (fun z : ℝ => σ * z)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) :=
    (he.comp (measurable_const.sub measurable_id)).aestronglyMeasurable
  have hmap := MeasureTheory.integral_map
    (μ := NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
    (φ := fun z : ℝ => σ * z) (f := fun y : ℝ => e (x - y))
    (by fun_prop) hfm
  rw [hmap,
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw,
    ProbabilityTheory.integral_gaussianReal_eq_integral_smul
      (by norm_num : (1 : ℝ≥0) ≠ 0)]
  simp only [smul_eq_mul]
  let F : ℝ → ℝ := fun z =>
    σ⁻¹ * ProbabilityTheory.gaussianPDFReal 0 1 ((x - z) / σ) * e z
  let G : ℝ → ℝ := fun y =>
    σ⁻¹ * ProbabilityTheory.gaussianPDFReal 0 1 (y / σ) * e (x - y)
  have htranslate : (∫ z, F z) = ∫ y, G y := by
    calc
      (∫ z, F z) = ∫ z, F (z + x) :=
        (MeasureTheory.integral_add_right_eq_self F x).symm
      _ = ∫ z, F (-z + x) := by
        rw [MeasureTheory.integral_neg_eq_self (fun z => F (z + x)) volume]
      _ = ∫ y, G y := by
        apply integral_congr_ae
        exact ae_of_all _ fun y => by
          dsimp only [F, G]
          rw [show x - (-y + x) = y by ring,
            show -y + x = x - y by ring]
  have hscale : (∫ y, G y) =
      ∫ y, ProbabilityTheory.gaussianPDFReal 0 1 y * e (x - σ * y) := by
    have hcomp := Measure.integral_comp_mul_left G σ
    have habs : |σ⁻¹| = σ⁻¹ := abs_of_pos (inv_pos.mpr hσ)
    rw [habs, smul_eq_mul] at hcomp
    calc
      (∫ y, G y) = σ * (σ⁻¹ * ∫ y, G y) := by
        field_simp
      _ = σ * ∫ y, G (σ * y) := by rw [hcomp]
      _ = ∫ y, σ * G (σ * y) := by rw [integral_const_mul]
      _ = ∫ y, ProbabilityTheory.gaussianPDFReal 0 1 y *
          e (x - σ * y) := by
        apply integral_congr_ae
        exact ae_of_all _ fun y => by
          dsimp only [G]
          field_simp
  exact hscale.symm.trans htranslate.symm

theorem iteratedDeriv_one_affine_standardNormalCDF (a y t : ℝ) :
    iteratedDeriv 1
        (fun u => cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y * u)) t =
      y * ProbabilityTheory.gaussianPDFReal 0 1 (a + y * t) := by
  rw [show 1 = 0 + 1 by norm_num, iteratedDeriv_succ', iteratedDeriv_zero]
  have hinner : HasDerivAt (fun u : ℝ => a + y * u) y t := by
    convert (hasDerivAt_const t a).add ((hasDerivAt_id t).const_mul y) using 1
    simp
  convert ((hasDerivAt_standardNormalCDF (a + y * t)).comp t hinner).deriv using 1
  ring

theorem iteratedDeriv_two_affine_standardNormalCDF (a y t : ℝ) :
    iteratedDeriv 2
        (fun u => cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y * u)) t =
      y ^ 2 * (-(a + y * t) *
        ProbabilityTheory.gaussianPDFReal 0 1 (a + y * t)) := by
  rw [show 2 = 1 + 1 by norm_num, iteratedDeriv_succ]
  have hfirst :
      iteratedDeriv 1
          (fun u => cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y * u)) =
        fun u => y * ProbabilityTheory.gaussianPDFReal 0 1 (a + y * u) := by
    funext u
    exact iteratedDeriv_one_affine_standardNormalCDF a y u
  rw [hfirst]
  have hinner : HasDerivAt (fun u : ℝ => a + y * u) y t := by
    convert (hasDerivAt_const t a).add ((hasDerivAt_id t).const_mul y) using 1
    simp
  have hpdf := (hasDerivAt_standardNormalPDF (a + y * t)).comp t hinner
  convert hpdf.const_mul y |>.deriv using 1; ring

theorem iteratedDeriv_three_affine_standardNormalCDF (a y t : ℝ) :
    iteratedDeriv 3
        (fun u => cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y * u)) t =
      y ^ 3 * (((a + y * t) ^ 2 - 1) *
        ProbabilityTheory.gaussianPDFReal 0 1 (a + y * t)) := by
  rw [show 3 = 2 + 1 by norm_num, iteratedDeriv_succ]
  have hsecond :
      iteratedDeriv 2
          (fun u => cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y * u)) =
        fun u => y ^ 2 * (-(a + y * u) *
          ProbabilityTheory.gaussianPDFReal 0 1 (a + y * u)) := by
    funext u
    exact iteratedDeriv_two_affine_standardNormalCDF a y u
  rw [hsecond]
  have hinner : HasDerivAt (fun u : ℝ => a + y * u) y t := by
    convert (hasDerivAt_const t a).add ((hasDerivAt_id t).const_mul y) using 1
    simp
  have hpdf :=
    (hasDerivAt_standardNormalPDF_deriv (a + y * t)).comp t hinner
  convert hpdf.const_mul (y ^ 2) |>.deriv using 1; ring

theorem abs_iteratedDeriv_three_affine_standardNormalCDF_le (a y t : ℝ) :
    |iteratedDeriv 3
        (fun u => cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y * u)) t| ≤
      (3 * (Real.sqrt (2 * Real.pi))⁻¹) * |y| ^ 3 := by
  rw [iteratedDeriv_three_affine_standardNormalCDF, abs_mul, abs_pow]
  have h := abs_iteratedDeriv_three_standardNormalCDF_le (a + y * t)
  rw [iteratedDeriv_three_standardNormalCDF] at h
  nlinarith [mul_le_mul_of_nonneg_left h (pow_nonneg (abs_nonneg y) 3)]

theorem taylorWithinEval_two_affine_standardNormalCDF (a y : ℝ) :
    taylorWithinEval
        (fun t => cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y * t))
        2 (Icc 0 1) 0 1 =
      cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw a +
        y * ProbabilityTheory.gaussianPDFReal 0 1 a +
        (y ^ 2 / 2) * (-a * ProbabilityTheory.gaussianPDFReal 0 1 a) := by
  let g : ℝ → ℝ := fun t =>
    cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y * t)
  have hg : ContDiff ℝ 3 g :=
    contDiff_three_standardNormalCDF.comp
      (by fun_prop)
  have hu : UniqueDiffOn ℝ (Icc (0 : ℝ) 1) := uniqueDiffOn_Icc zero_lt_one
  have hzero : (0 : ℝ) ∈ Icc (0 : ℝ) 1 := by norm_num
  have hwithin0 : iteratedDerivWithin 0 g (Icc 0 1) 0 = iteratedDeriv 0 g 0 :=
    iteratedDerivWithin_eq_iteratedDeriv hu (hg.of_le (by norm_num)).contDiffAt hzero
  have hwithin1 : iteratedDerivWithin 1 g (Icc 0 1) 0 = iteratedDeriv 1 g 0 :=
    iteratedDerivWithin_eq_iteratedDeriv hu (hg.of_le (by norm_num)).contDiffAt hzero
  have hwithin2 : iteratedDerivWithin 2 g (Icc 0 1) 0 = iteratedDeriv 2 g 0 :=
    iteratedDerivWithin_eq_iteratedDeriv hu (hg.of_le (by norm_num)).contDiffAt hzero
  change taylorWithinEval g 2 (Icc 0 1) 0 1 = _
  rw [taylor_within_apply]
  simp [Finset.sum_range_succ, hwithin0, hwithin1, hwithin2, iteratedDeriv_zero,
    g, iteratedDeriv_one_affine_standardNormalCDF,
    iteratedDeriv_two_affine_standardNormalCDF, Nat.factorial]
  ring_nf

/-- The standard-normal CDF admits a quadratic Taylor polynomial with a
uniform cubic remainder.  Parameterizing the displacement on `[0,1]` makes
the estimate valid for positive and negative `y` without separate endpoint
arguments. -/
theorem standardNormalCDF_quadratic_remainder (a y : ℝ) :
    |cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y) -
        (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw a +
          y * ProbabilityTheory.gaussianPDFReal 0 1 a +
          (y ^ 2 / 2) * (-a * ProbabilityTheory.gaussianPDFReal 0 1 a))| ≤
      ((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 6) * |y| ^ 3 := by
  let g : ℝ → ℝ := fun t =>
    cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y * t)
  have hg : ContDiff ℝ 3 g :=
    contDiff_three_standardNormalCDF.comp (by fun_prop)
  obtain ⟨t, _ht, hrem⟩ :=
    taylor_mean_remainder_lagrange_iteratedDeriv
      (f := g) (n := 2) (x₀ := 0) (x := 1) zero_lt_one hg.contDiffOn
  have hpoly := taylorWithinEval_two_affine_standardNormalCDF a y
  have hbound := abs_iteratedDeriv_three_affine_standardNormalCDF_le a y t
  have hdiv : |iteratedDeriv 3 g t| / 6 ≤
      ((3 * (Real.sqrt (2 * Real.pi))⁻¹) * |y| ^ 3) / 6 :=
    div_le_div_of_nonneg_right hbound (by norm_num)
  calc
    |cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (a + y) -
        (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw a +
          y * ProbabilityTheory.gaussianPDFReal 0 1 a +
          (y ^ 2 / 2) * (-a * ProbabilityTheory.gaussianPDFReal 0 1 a))| =
        |g 1 - taylorWithinEval g 2 (Icc 0 1) 0 1| := by
      rw [hpoly]
      simp only [g, mul_one]
    _ = |iteratedDeriv 3 g t| / 6 := by
      rw [hrem]
      norm_num [Nat.factorial]
      rw [abs_div, abs_mul]
      change |iteratedDeriv 3 g t| * |(1 : ℝ)| / |(6 : ℝ)| =
        |iteratedDeriv 3 g t| / 6
      simp
    _ ≤ ((3 * (Real.sqrt (2 * Real.pi))⁻¹) * |y| ^ 3) / 6 := hdiv
    _ = ((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 6) * |y| ^ 3 := by ring

/-- The standard-normal CDF remainder transported through a positive scalar
pushforward. -/
theorem scaledStandardNormalCDF_quadratic_remainder
    {σ : ℝ} (hσ : 0 < σ) (a y : ℝ) :
    |cdf (Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) (a + y) -
        (cdf (Measure.map (fun z : ℝ => σ * z)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) a +
          (y / σ) * ProbabilityTheory.gaussianPDFReal 0 1 (a / σ) +
          ((y / σ) ^ 2 / 2) *
            (-(a / σ) * ProbabilityTheory.gaussianPDFReal 0 1 (a / σ)))| ≤
      ((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 6) * |y / σ| ^ 3 := by
  rw [cdf_map_mul NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hσ,
    cdf_map_mul NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hσ]
  convert standardNormalCDF_quadratic_remainder (a / σ) (y / σ) using 1
  field_simp [hσ.ne']

/-- Canonical-polynomial form of the scaled standard-normal CDF remainder.
The cubic constant scales as the inverse cube of the smoothing standard
deviation. -/
theorem scaledStandardNormalCDF_quadratic_remainder_canonical
    {σ : ℝ} (hσ : 0 < σ) (a y : ℝ) :
    |cdf (Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) (a + y) -
        (cdf (Measure.map (fun z : ℝ => σ * z)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) a +
          (ProbabilityTheory.gaussianPDFReal 0 1 (a / σ) / σ) * y +
          ((-(a / σ) * ProbabilityTheory.gaussianPDFReal 0 1 (a / σ)) /
            (2 * σ ^ 2)) * y ^ 2)| ≤
      (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6) * |y| ^ 3 := by
  have h := scaledStandardNormalCDF_quadratic_remainder hσ a y
  convert h using 1
  · field_simp [hσ.ne']
  · rw [abs_div, abs_of_pos hσ]
    field_simp [hσ.ne']

theorem standardNormalPDF_le (x : ℝ) :
    ProbabilityTheory.gaussianPDFReal 0 1 x ≤
      (Real.sqrt (2 * Real.pi))⁻¹ := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_pdf]
  change (Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-(x ^ 2) / 2) ≤
    (Real.sqrt (2 * Real.pi))⁻¹
  have hexp : Real.exp (-(x ^ 2) / 2) ≤ 1 :=
    Real.exp_le_one_iff.mpr
      (div_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr (sq_nonneg x)) (by norm_num))
  simpa only [mul_one] using mul_le_mul_of_nonneg_left hexp
    (inv_nonneg.mpr (Real.sqrt_nonneg (2 * Real.pi)))

theorem abs_standardNormalPDF_deriv_le (x : ℝ) :
    |-x * ProbabilityTheory.gaussianPDFReal 0 1 x| ≤
      2 * (Real.sqrt (2 * Real.pi))⁻¹ := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_pdf]
  have hC : 0 ≤ (Real.sqrt (2 * Real.pi))⁻¹ :=
    inv_nonneg.mpr (Real.sqrt_nonneg _)
  have hexp : Real.exp (-(x ^ 2) / 2) ≤ 1 :=
    Real.exp_le_one_iff.mpr (by nlinarith [sq_nonneg x])
  have hxexp : |x| * Real.exp (-(x ^ 2) / 2) ≤ 2 := by
    by_cases hx : |x| ≤ 1
    · nlinarith [Real.exp_pos (-(x ^ 2) / 2)]
    · have hxle : |x| ≤ x ^ 2 := by
        rw [← sq_abs]
        nlinarith [abs_nonneg x]
      calc
        |x| * Real.exp (-(x ^ 2) / 2) ≤
            x ^ 2 * Real.exp (-(x ^ 2) / 2) :=
          mul_le_mul_of_nonneg_right hxle (Real.exp_pos _).le
        _ ≤ 2 := sq_mul_exp_neg_half_le_two x
  rw [abs_mul, abs_mul, abs_of_nonneg hC, abs_of_pos (Real.exp_pos _), abs_neg]
  nlinarith [mul_le_mul_of_nonneg_left hxexp hC]

/-- The standard-normal CDF has the sharp global density Lipschitz constant.
This is the target regularity term used by Esseen smoothing. -/
theorem standardNormalCDF_sub_le
    {a b : ℝ} (hab : a ≤ b) :
    cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw b -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw a ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * (b - a) := by
  open NumStability.HDP.Scalar.LimitTheorems in
  rw [cdf_eq_real, cdf_eq_real]
  have hsubset : Iic a ⊆ Iic b := Iic_subset_Iic.mpr hab
  rw [← measureReal_diff hsubset measurableSet_Iic]
  have hdiff : Iic b \ Iic a = Ioc a b := by
    ext x
    simp only [mem_diff, mem_Iic, mem_Ioc, not_le]
    tauto
  rw [hdiff, standardNormalLaw, Measure.real_def,
    gaussianReal_apply_eq_integral 0 (by norm_num : (1 : NNReal) ≠ 0) (Ioc a b)]
  rw [ENNReal.toReal_ofReal
    (integral_nonneg fun x => gaussianPDFReal_nonneg 0 1 x)]
  rw [standardNormalLaw_pdf]
  have hpdf : Integrable (fun x : ℝ =>
      (Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-(x ^ 2) / 2)) volume := by
    rw [← standardNormalLaw_pdf]
    exact ProbabilityTheory.integrable_gaussianPDFReal 0 1
  calc
    (∫ x in Ioc a b,
        (Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-(x ^ 2) / 2)) ≤
        ∫ _x in Ioc a b, (Real.sqrt (2 * Real.pi))⁻¹ := by
      apply setIntegral_mono_on
        hpdf.integrableOn (integrableOn_const measure_Ioc_lt_top.ne) measurableSet_Ioc
      intro x _
      have hexp : Real.exp (-(x ^ 2) / 2) ≤ 1 :=
        Real.exp_le_one_iff.mpr (by nlinarith [sq_nonneg x])
      simpa only [mul_one] using mul_le_mul_of_nonneg_left hexp
        (inv_nonneg.mpr (Real.sqrt_nonneg (2 * Real.pi)))
    _ = (Real.sqrt (2 * Real.pi))⁻¹ * (b - a) := by
      simp [MeasureTheory.integral_const, hab]
      ring

theorem standardNormalCDF_lipschitz (a b : ℝ) :
    |cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw b -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw a| ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * |b - a| := by
  rcases le_total a b with hab | hba
  · rw [abs_of_nonneg (sub_nonneg.mpr <|
      monotone_cdf
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hab),
      abs_of_nonneg (sub_nonneg.mpr hab)]
    exact standardNormalCDF_sub_le hab
  · rw [abs_of_nonpos (sub_nonpos.mpr <|
      monotone_cdf
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hba),
      abs_of_nonpos (sub_nonpos.mpr hba)]
    simpa only [neg_sub] using standardNormalCDF_sub_le hba

/-- Probability of a half-open interval as a CDF increment. -/
theorem measureReal_Ioc_eq_cdf_sub
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {a b : ℝ} (hab : a ≤ b) :
    mu.real (Ioc a b) = cdf mu b - cdf mu a := by
  conv_lhs => rw [← ProbabilityTheory.measure_cdf mu]
  rw [Measure.real_def,
    StieltjesFunction.measure_Ioc, ENNReal.toReal_ofReal]
  exact sub_nonneg.mpr (monotone_cdf mu hab)

/-- Every interval probability is bounded by its standard-normal length term
plus twice the Kolmogorov discrepancy. -/
theorem measureReal_Ioc_le_standardNormal_length_add_kolmogorov
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {a b : ℝ} (hab : a ≤ b) :
    mu.real (Ioc a b) ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * (b - a) +
        2 * kolmogorovDistance mu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  let normal : Measure ℝ :=
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let D : ℝ := kolmogorovDistance mu normal
  have ha := cdfGap_le_kolmogorovDistance mu normal a
  have hb := cdfGap_le_kolmogorovDistance mu normal b
  have hnormal := standardNormalCDF_lipschitz a b
  rw [cdfGap] at ha hb
  have ha' : cdf normal a - cdf mu a ≤ D := by
    calc
      cdf normal a - cdf mu a ≤ |cdf normal a - cdf mu a| := le_abs_self _
      _ = |cdf mu a - cdf normal a| := abs_sub_comm _ _
      _ ≤ D := by simpa only [normal, D] using ha
  have hb' : cdf mu b - cdf normal b ≤ D := by
    calc
      cdf mu b - cdf normal b ≤ |cdf mu b - cdf normal b| := le_abs_self _
      _ ≤ D := by simpa only [normal, D] using hb
  have hnormal' : cdf normal b - cdf normal a ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * (b - a) :=
    (le_abs_self _).trans (by
      simpa only [normal, abs_of_nonneg (sub_nonneg.mpr hab)] using hnormal)
  rw [measureReal_Ioc_eq_cdf_sub mu hab]
  dsimp only [normal, D] at ha' hb' hnormal' ⊢
  linarith

/-- Lévy concentration function, using half-open intervals of length `h`. -/
noncomputable def concentrationFunction (mu : Measure ℝ) (h : ℝ) : ℝ :=
  sSup (Set.range fun x : ℝ => mu.real (Ioc x (x + h)))

theorem bddAbove_range_concentrationInterval
    (mu : Measure ℝ) [IsProbabilityMeasure mu] (h : ℝ) :
    BddAbove (Set.range fun x : ℝ => mu.real (Ioc x (x + h))) := by
  refine ⟨1, ?_⟩
  rintro _ ⟨x, rfl⟩
  calc
    mu.real (Ioc x (x + h)) ≤ mu.real Set.univ :=
      measureReal_mono (subset_univ _)
    _ = 1 := by simp

theorem measureReal_Ioc_le_concentrationFunction
    (mu : Measure ℝ) [IsProbabilityMeasure mu] (h x : ℝ) :
    mu.real (Ioc x (x + h)) ≤ concentrationFunction mu h := by
  apply le_csSup (bddAbove_range_concentrationInterval mu h)
  exact ⟨x, rfl⟩

/-- Interval mass under multiplication by a positive scalar, with the
endpoints divided by that scalar. -/
theorem measureReal_map_mul_Ioc
    (mu : Measure ℝ) {c : ℝ} (hc : 0 < c) (x h : ℝ) :
    (Measure.map (fun y : ℝ => c * y) mu).real (Ioc x (x + h)) =
      mu.real (Ioc (x / c) (x / c + h / c)) := by
  rw [map_measureReal_apply (by fun_prop) measurableSet_Ioc]
  congr 1
  ext y
  simp only [Set.mem_preimage, mem_Ioc]
  rw [← add_div]
  constructor
  · rintro ⟨hy₁, hy₂⟩
    constructor
    · rw [div_lt_iff₀ hc]
      simpa [mul_comm] using hy₁
    · rw [le_div_iff₀ hc]
      simpa [mul_comm] using hy₂
  · rintro ⟨hy₁, hy₂⟩
    constructor
    · rw [div_lt_iff₀ hc] at hy₁
      simpa [mul_comm] using hy₁
    · rw [le_div_iff₀ hc] at hy₂
      simpa [mul_comm] using hy₂

/-- Positive scaling transports the concentration function by dividing the
interval length by the scale.  The inequality direction is the one needed
for normalized partial sums. -/
theorem concentrationFunction_map_mul_le
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {c : ℝ} (hc : 0 < c) (h : ℝ) :
    concentrationFunction (Measure.map (fun y : ℝ => c * y) mu) h ≤
      concentrationFunction mu (h / c) := by
  letI : IsProbabilityMeasure (Measure.map (fun y : ℝ => c * y) mu) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  change (Measure.map (fun y : ℝ => c * y) mu).real (Ioc x (x + h)) ≤ _
  rw [measureReal_map_mul_Ioc mu hc]
  exact measureReal_Ioc_le_concentrationFunction mu (h / c) (x / c)

/-- The concentration function transforms exactly under a positive scalar
map. -/
theorem concentrationFunction_map_mul_eq
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {c : ℝ} (hc : 0 < c) (h : ℝ) :
    concentrationFunction (Measure.map (fun y : ℝ => c * y) mu) h =
      concentrationFunction mu (h / c) := by
  apply le_antisymm (concentrationFunction_map_mul_le mu hc h)
  letI : IsProbabilityMeasure (Measure.map (fun y : ℝ => c * y) mu) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  calc
    mu.real (Ioc x (x + h / c)) =
        (Measure.map (fun y : ℝ => c * y) mu).real
          (Ioc (c * x) (c * x + h)) := by
      rw [measureReal_map_mul_Ioc mu hc]
      simp [hc.ne']
    _ ≤ concentrationFunction (Measure.map (fun y : ℝ => c * y) mu) h :=
      measureReal_Ioc_le_concentrationFunction
        (Measure.map (fun y : ℝ => c * y) mu) h (c * x)

/-- The law of the first `N + 1` independent summands is the convolution of
the first `N`-summand law with the law of the last summand. -/
theorem map_sum_range_succ_eq_conv
    {Ω : Type*} [MeasurableSpace Ω]
    {mu : Measure Ω} [IsProbabilityMeasure mu]
    (X : ℕ → Ω → ℝ) (hX : ∀ i, AEMeasurable (X i) mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu) (N : ℕ) :
    Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu =
      Measure.map (∑ i ∈ Finset.range N, X i) mu ∗
        Measure.map (X N) mu := by
  have hi := hIndep.indepFun_sum_range_succ₀ hX N
  have hs : AEMeasurable (∑ i ∈ Finset.range N, X i) mu := by
    fun_prop
  have hm := hi.map_add_eq_map_conv_map₀ hs (hX N)
  rw [Finset.sum_range_succ]
  exact hm

/-- The normalized centered iid law is the positive scalar pushforward of
the corresponding unnormalized range-sum law. -/
theorem map_normalizedCenteredIidSum_eq_map_mul_sum_range
    {Ω : Type*} [MeasurableSpace Ω]
    {mu : Measure Ω} [IsProbabilityMeasure mu]
    (X : ℕ → Ω → ℝ) (hX : ∀ i, AEMeasurable (X i) mu) (N : ℕ) :
    Measure.map
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N) mu =
      Measure.map (fun y : ℝ => (Real.sqrt (N + 1 : ℝ))⁻¹ * y)
        (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu) := by
  have hs : AEMeasurable (∑ i ∈ Finset.range (N + 1), X i) mu := by
    fun_prop
  have hc : AEMeasurable
      (fun y : ℝ => (Real.sqrt (N + 1 : ℝ))⁻¹ * y)
      (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu) := by
    fun_prop
  rw [hc.map_map_of_aemeasurable hs]
  congr 1
  funext ω
  simp only [NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum,
    Function.comp_apply]
  congr 1
  simpa only [Finset.sum_apply] using
    (Fin.sum_univ_eq_sum_range (fun i => X i ω) (N + 1))

/-- Standard-normal comparison bound for the Lévy concentration function. -/
theorem concentrationFunction_le_standardNormal_length_add_kolmogorov
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {h : ℝ} (hh : 0 ≤ h) :
    concentrationFunction mu h ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * h +
        2 * kolmogorovDistance mu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  simpa only [add_sub_cancel_left] using
    measureReal_Ioc_le_standardNormal_length_add_kolmogorov
      mu (show x ≤ x + h by linarith)

/-- Each fixed-displacement section of the Stein crossing set has mass at
most the concentration function at the exact displacement length. -/
theorem integral_standardNormalSteinCrossingSet_section_le_concentrationFunction
    (nu : Measure ℝ) [IsProbabilityMeasure nu]
    (x scale v : ℝ) (hscale : 0 ≤ scale) :
    (∫ w, (standardNormalSteinCrossingSet x scale).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (w, v) ∂nu) ≤
      concentrationFunction nu (scale * |v|) := by
  by_cases hv0 : v = 0
  · subst v
    have h := measureReal_Ioc_le_concentrationFunction nu 0 x
    simpa [standardNormalSteinCrossingSet] using h
  · rcases lt_or_gt_of_ne hv0 with hv | hv
    · have hfun :
        (fun w => (standardNormalSteinCrossingSet x scale).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ)) (w, v)) =
        (Ioc x (x - scale * v)).indicator (fun _ : ℝ => (1 : ℝ)) := by
        funext w
        simp [standardNormalSteinCrossingSet, Set.indicator_apply,
          hv.le, not_le_of_gt hv]
      rw [hfun]
      have hint :
          (∫ w, (Ioc x (x - scale * v)).indicator
            (fun _ : ℝ => (1 : ℝ)) w ∂nu) =
            nu.real (Ioc x (x - scale * v)) :=
        integral_indicator_one measurableSet_Ioc
      rw [hint]
      have h := measureReal_Ioc_le_concentrationFunction nu
        (scale * (-v)) x
      simpa [abs_of_neg hv] using h
    · have hfun :
        (fun w => (standardNormalSteinCrossingSet x scale).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ)) (w, v)) =
        (Ioc (x - scale * v) x).indicator (fun _ : ℝ => (1 : ℝ)) := by
        funext w
        simp [standardNormalSteinCrossingSet, Set.indicator_apply,
          hv.le, not_le_of_gt hv]
      rw [hfun]
      have hint :
          (∫ w, (Ioc (x - scale * v) x).indicator
            (fun _ : ℝ => (1 : ℝ)) w ∂nu) =
            nu.real (Ioc (x - scale * v) x) :=
        integral_indicator_one measurableSet_Ioc
      rw [hint]
      have h := measureReal_Ioc_le_concentrationFunction nu
        (scale * v) (x - scale * v)
      simpa [abs_of_pos hv] using h

/-- Independence turns the random Stein crossing event into fixed interval
sections.  Standard-normal comparison then bounds its expectation by the
scaled first absolute moment plus twice the leave-one-out Kolmogorov gap. -/
theorem integral_standardNormalSteinCrossingSet_comp_le
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (Y X : Omega → ℝ) (hY : AEMeasurable Y mu) (hX : AEMeasurable X mu)
    (hIndep : IndepFun Y X mu)
    (hXfirst : Integrable (fun v : ℝ => |v|) (Measure.map X mu))
    (x scale : ℝ) (hscale : 0 ≤ scale) :
    (∫ omega, (standardNormalSteinCrossingSet x scale).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (Y omega, X omega) ∂mu) ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * scale *
          (∫ v, |v| ∂Measure.map X mu) +
        2 * kolmogorovDistance (Measure.map Y mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  let nuY : Measure ℝ := Measure.map Y mu
  let nuX : Measure ℝ := Measure.map X mu
  let D : ℝ := kolmogorovDistance nuY
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let F : ℝ × ℝ → ℝ := fun p =>
    (standardNormalSteinCrossingSet x scale).indicator
      (fun _ : ℝ × ℝ => (1 : ℝ)) (p.2, p.1)
  letI : IsProbabilityMeasure nuY := Measure.isProbabilityMeasure_map hY
  letI : IsProbabilityMeasure nuX := Measure.isProbabilityMeasure_map hX
  have hFmeas : Measurable F := by
    dsimp only [F]
    exact (measurable_const.indicator
      (measurableSet_standardNormalSteinCrossingSet x scale)).comp measurable_swap
  have hFint : Integrable F (nuX.prod nuY) := by
    apply Integrable.of_bound hFmeas.aestronglyMeasurable 1
    exact ae_of_all _ fun p => by
      dsimp only [F]
      by_cases hp : (p.2, p.1) ∈ standardNormalSteinCrossingSet x scale <;>
        simp [hp]
  have heq := integral_comp_pair_eq_integral_integral_of_indepFun
    X Y hX hY hIndep.symm F hFint
  have hleft : Integrable (fun v => ∫ w, F (v, w) ∂nuY) nuX :=
    hFint.integral_prod_left
  have hscaled : Integrable
      (fun v : ℝ => (Real.sqrt (2 * Real.pi))⁻¹ * (scale * |v|)) nuX :=
    hXfirst.const_mul scale |>.const_mul (Real.sqrt (2 * Real.pi))⁻¹
  have hmajor : Integrable
      (fun v : ℝ => (Real.sqrt (2 * Real.pi))⁻¹ * (scale * |v|) + 2 * D) nuX :=
    hscaled.add (integrable_const (2 * D))
  change (∫ omega, F (X omega, Y omega) ∂mu) ≤ _
  rw [heq]
  calc
    (∫ v, ∫ w, F (v, w) ∂nuY ∂nuX) ≤
        ∫ v, ((Real.sqrt (2 * Real.pi))⁻¹ * (scale * |v|) + 2 * D) ∂nuX := by
      apply integral_mono hleft hmajor
      intro v
      exact (integral_standardNormalSteinCrossingSet_section_le_concentrationFunction
        nuY x scale v hscale).trans
          (concentrationFunction_le_standardNormal_length_add_kolmogorov
            nuY (mul_nonneg hscale (abs_nonneg v)))
    _ = (Real.sqrt (2 * Real.pi))⁻¹ * scale *
          (∫ v, |v| ∂nuX) + 2 * D := by
      rw [integral_add hscaled (integrable_const _),
        integral_const_mul, integral_const_mul, integral_const,
        probReal_univ, one_smul]
      ring
    _ = _ := by rfl

/-- Weighted independent-pair crossing estimate.  The quadratic weight turns
the interval-length contribution into a third absolute moment and retains a
second-moment factor on the Kolmogorov term. -/
theorem integral_sq_mul_standardNormalSteinCrossingSet_comp_le
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (Y X : Omega → ℝ) (hY : AEMeasurable Y mu) (hX : AEMeasurable X mu)
    (hIndep : IndepFun Y X mu)
    (hXsecond : Integrable (fun v : ℝ => v ^ 2) (Measure.map X mu))
    (hXthird : Integrable (fun v : ℝ => |v| ^ 3) (Measure.map X mu))
    (x scale : ℝ) (hscale : 0 ≤ scale) :
    (∫ omega, (X omega) ^ 2 *
        (standardNormalSteinCrossingSet x scale).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ)) (Y omega, X omega) ∂mu) ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * scale *
          (∫ v, |v| ^ 3 ∂Measure.map X mu) +
        2 * kolmogorovDistance (Measure.map Y mu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw *
          (∫ v, v ^ 2 ∂Measure.map X mu) := by
  let nuY : Measure ℝ := Measure.map Y mu
  let nuX : Measure ℝ := Measure.map X mu
  let D : ℝ := kolmogorovDistance nuY
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let F : ℝ × ℝ → ℝ := fun p => p.1 ^ 2 *
    (standardNormalSteinCrossingSet x scale).indicator
      (fun _ : ℝ × ℝ => (1 : ℝ)) (p.2, p.1)
  letI : IsProbabilityMeasure nuY := Measure.isProbabilityMeasure_map hY
  letI : IsProbabilityMeasure nuX := Measure.isProbabilityMeasure_map hX
  have hFmeas : Measurable F := by
    dsimp only [F]
    exact (measurable_fst.pow_const 2).mul
      ((measurable_const.indicator
        (measurableSet_standardNormalSteinCrossingSet x scale)).comp measurable_swap)
  have hFint : Integrable F (nuX.prod nuY) := by
    apply (hXsecond.comp_fst nuY).mono' hFmeas.aestronglyMeasurable
    exact ae_of_all _ fun p => by
      dsimp only [F]
      by_cases hp : (p.2, p.1) ∈ standardNormalSteinCrossingSet x scale <;>
        simp [hp, sq_nonneg]
  have heq := integral_comp_pair_eq_integral_integral_of_indepFun
    X Y hX hY hIndep.symm F hFint
  have hleft : Integrable (fun v => ∫ w, F (v, w) ∂nuY) nuX :=
    hFint.integral_prod_left
  have hcubic : Integrable
      (fun v : ℝ => ((Real.sqrt (2 * Real.pi))⁻¹ * scale) * |v| ^ 3) nuX :=
    hXthird.const_mul ((Real.sqrt (2 * Real.pi))⁻¹ * scale)
  have hquadratic : Integrable (fun v : ℝ => (2 * D) * v ^ 2) nuX :=
    hXsecond.const_mul (2 * D)
  have hmajor : Integrable (fun v : ℝ =>
      ((Real.sqrt (2 * Real.pi))⁻¹ * scale) * |v| ^ 3 +
        (2 * D) * v ^ 2) nuX :=
    hcubic.add hquadratic
  change (∫ omega, F (X omega, Y omega) ∂mu) ≤ _
  rw [heq]
  calc
    (∫ v, ∫ w, F (v, w) ∂nuY ∂nuX) ≤
        ∫ v, (((Real.sqrt (2 * Real.pi))⁻¹ * scale) * |v| ^ 3 +
          (2 * D) * v ^ 2) ∂nuX := by
      apply integral_mono hleft hmajor
      intro v
      have hsection :=
        (integral_standardNormalSteinCrossingSet_section_le_concentrationFunction
          nuY x scale v hscale).trans
          (concentrationFunction_le_standardNormal_length_add_kolmogorov
            nuY (mul_nonneg hscale (abs_nonneg v)))
      calc
        (∫ w, F (v, w) ∂nuY) =
            v ^ 2 * ∫ w,
              (standardNormalSteinCrossingSet x scale).indicator
                (fun _ : ℝ × ℝ => (1 : ℝ)) (w, v) ∂nuY := by
          dsimp only [F]
          rw [integral_const_mul]
        _ ≤ v ^ 2 *
            ((Real.sqrt (2 * Real.pi))⁻¹ * (scale * |v|) + 2 * D) :=
          mul_le_mul_of_nonneg_left hsection (sq_nonneg v)
        _ = ((Real.sqrt (2 * Real.pi))⁻¹ * scale) * |v| ^ 3 +
            (2 * D) * v ^ 2 := by
          rw [← sq_abs v]
          ring
    _ = (Real.sqrt (2 * Real.pi))⁻¹ * scale *
          (∫ v, |v| ^ 3 ∂nuX) +
        2 * D * (∫ v, v ^ 2 ∂nuX) := by
      rw [integral_add hcubic hquadratic, integral_const_mul,
        integral_const_mul]
    _ = _ := by rfl

/-- Leave-one-out specialization of the weighted crossing estimate under the
third-moment hypothesis used by Berry--Esseen. -/
theorem integral_sq_mul_standardNormalSteinCrossingSet_leaveOneOut_le
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ) :
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    (∫ omega, (X i.1 omega) ^ 2 *
        (standardNormalSteinCrossingSet x scale).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ))
          (Wi omega, X i.1 omega) ∂mu) ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * scale *
          (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
        2 * kolmogorovDistance (Measure.map Wi mu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw *
          (∫ omega, (X i.1 omega) ^ 2 ∂mu) := by
  dsimp only
  let hX2 : ∀ j, MemLp (X j) 2 mu := fun j =>
    (hX j).mono_exponent (by norm_num)
  have hLeave := normalizedCenteredIidLeaveOneOut_memLp X hX2 N i
  have hind := indepFun_normalizedCenteredIidLeaveOneOut
    X (fun j => (hX j).aemeasurable) hIndep N i
  have hbase2 : Integrable (fun omega => (X i.1 omega) ^ 2) mu :=
    ((hX i.1).mono_exponent (by norm_num : (2 : ENNReal) ≤ 3)).integrable_sq
  have hbase3 : Integrable (fun omega => |X i.1 omega| ^ 3) mu := by
    simpa only [Real.norm_eq_abs] using
      (hX i.1).integrable_norm_pow (by norm_num)
  have hlaw2 : Integrable (fun v : ℝ => v ^ 2)
      (Measure.map (X i.1) mu) := by
    rw [integrable_map_measure (by fun_prop) (hX i.1).aemeasurable]
    simpa only [Function.comp_apply] using hbase2
  have hlaw3 : Integrable (fun v : ℝ => |v| ^ 3)
      (Measure.map (X i.1) mu) := by
    rw [integrable_map_measure (by fun_prop) (hX i.1).aemeasurable]
    simpa only [Function.comp_apply] using hbase3
  have h := integral_sq_mul_standardNormalSteinCrossingSet_comp_le
    (normalizedCenteredIidLeaveOneOut X N i) (X i.1)
    hLeave.aemeasurable (hX i.1).aemeasurable hind.symm hlaw2 hlaw3 x
    (Real.sqrt (N + 1 : ℝ))⁻¹ (inv_nonneg.mpr (Real.sqrt_nonneg _))
  rw [integral_map (hX i.1).aemeasurable
    (show AEStronglyMeasurable (fun v : ℝ => v ^ 2)
      (Measure.map (X i.1) mu) by fun_prop)] at h
  rw [integral_map (hX i.1).aemeasurable
    (show AEStronglyMeasurable (fun v : ℝ => |v| ^ 3)
      (Measure.map (X i.1) mu) by fun_prop)] at h
  simpa only [Function.comp_apply] using h

/-- Independence factors the continuous cubic part of the normalized
summand interval remainder. -/
theorem integral_leaveOneOut_cubicDriftMajorant_eq
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) :
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    (∫ omega, (|Wi omega| + C) *
        (scale ^ 3 * |X i.1 omega| ^ 3 / 2) ∂mu) =
      (scale ^ 3 / 2) * (∫ omega, |Wi omega| + C ∂mu) *
        (∫ omega, |X i.1 omega| ^ 3 ∂mu) := by
  dsimp only
  let hX2 : ∀ j, MemLp (X j) 2 mu := fun j =>
    (hX j).mono_exponent (by norm_num)
  have hLeave := normalizedCenteredIidLeaveOneOut_memLp X hX2 N i
  have hind := indepFun_normalizedCenteredIidLeaveOneOut
    X (fun j => (hX j).aemeasurable) hIndep N i
  have hfact := hind.integral_comp_mul_comp
    (hX i.1).aemeasurable hLeave.aemeasurable
    (show AEStronglyMeasurable (fun v : ℝ => |v| ^ 3)
      (Measure.map (X i.1) mu) by fun_prop)
    (show AEStronglyMeasurable (fun w : ℝ =>
        |w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ))
      (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu) by fun_prop)
  have hfact' :
      (∫ omega, |X i.1 omega| ^ 3 *
        (|normalizedCenteredIidLeaveOneOut X N i omega| +
          Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) ∂mu) =
        (∫ omega, |X i.1 omega| ^ 3 ∂mu) *
          ∫ omega, |normalizedCenteredIidLeaveOneOut X N i omega| +
            Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) ∂mu := by
    simpa only [Function.comp_apply, Pi.mul_apply] using hfact
  calc
    (∫ omega, (|normalizedCenteredIidLeaveOneOut X N i omega| +
          Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
        ((Real.sqrt (N + 1 : ℝ))⁻¹ ^ 3 * |X i.1 omega| ^ 3 / 2) ∂mu) =
      ((Real.sqrt (N + 1 : ℝ))⁻¹ ^ 3 / 2) *
        (∫ omega, |X i.1 omega| ^ 3 *
          (|normalizedCenteredIidLeaveOneOut X N i omega| +
            Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) ∂mu) := by
      rw [← integral_const_mul]
      apply integral_congr_ae
      exact ae_of_all mu fun omega => by ring
    _ = ((Real.sqrt (N + 1 : ℝ))⁻¹ ^ 3 / 2) *
        ((∫ omega, |X i.1 omega| ^ 3 ∂mu) *
          ∫ omega, |normalizedCenteredIidLeaveOneOut X N i omega| +
            Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) ∂mu) := by
      rw [hfact']
    _ = _ := by ring

/-- Leave-one-out specialization of the integrated crossing estimate. -/
theorem integral_standardNormalSteinCrossingSet_leaveOneOut_le
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ) :
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    (∫ omega, (standardNormalSteinCrossingSet x scale).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega) ∂mu) ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * scale *
          (∫ omega, |X i.1 omega| ∂mu) +
        2 * kolmogorovDistance (Measure.map Wi mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  dsimp only
  have hLeave := normalizedCenteredIidLeaveOneOut_memLp X hX N i
  have hind := indepFun_normalizedCenteredIidLeaveOneOut
    X (fun j => (hX j).aemeasurable) hIndep N i
  have hbase : Integrable (fun omega => |X i.1 omega|) mu := by
    simpa only [Real.norm_eq_abs] using
      ((hX i.1).integrable (by norm_num)).norm
  have hlaw : Integrable (fun v : ℝ => |v|) (Measure.map (X i.1) mu) := by
    rw [integrable_map_measure (by fun_prop) (hX i.1).aemeasurable]
    simpa only [Function.comp_apply] using hbase
  have h := integral_standardNormalSteinCrossingSet_comp_le
    (normalizedCenteredIidLeaveOneOut X N i) (X i.1)
    hLeave.aemeasurable (hX i.1).aemeasurable hind.symm hlaw x
    (Real.sqrt (N + 1 : ℝ))⁻¹ (inv_nonneg.mpr (Real.sqrt_nonneg _))
  rw [integral_map (hX i.1).aemeasurable
    (show AEStronglyMeasurable (fun v : ℝ => |v|)
      (Measure.map (X i.1) mu) by fun_prop)] at h
  simpa only [Function.comp_apply] using h

/-- Independence factors the continuous part of the pointwise leave-one-out
derivative majorant. -/
theorem integral_leaveOneOut_driftMajorant_eq
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) :
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    (∫ omega, (|Wi omega| + C) * (scale * |X i.1 omega|) ∂mu) =
      scale * (∫ omega, |Wi omega| + C ∂mu) *
        (∫ omega, |X i.1 omega| ∂mu) := by
  dsimp only
  have hLeave := normalizedCenteredIidLeaveOneOut_memLp X hX N i
  have hind := indepFun_normalizedCenteredIidLeaveOneOut
    X (fun j => (hX j).aemeasurable) hIndep N i
  have hfact := hind.integral_comp_mul_comp
    (hX i.1).aemeasurable hLeave.aemeasurable
    (show AEStronglyMeasurable (fun v : ℝ => |v|)
      (Measure.map (X i.1) mu) by fun_prop)
    (show AEStronglyMeasurable (fun w : ℝ =>
        |w| + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ))
      (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu) by fun_prop)
  have hfact' :
      (∫ omega, |X i.1 omega| *
        (|normalizedCenteredIidLeaveOneOut X N i omega| +
          Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) ∂mu) =
        (∫ omega, |X i.1 omega| ∂mu) *
          ∫ omega, |normalizedCenteredIidLeaveOneOut X N i omega| +
            Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) ∂mu := by
    simpa only [Function.comp_apply, Pi.mul_apply] using hfact
  calc
    (∫ omega, (|normalizedCenteredIidLeaveOneOut X N i omega| +
          Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
        ((Real.sqrt (N + 1 : ℝ))⁻¹ * |X i.1 omega|) ∂mu) =
      (Real.sqrt (N + 1 : ℝ))⁻¹ *
        (∫ omega, |X i.1 omega| *
          (|normalizedCenteredIidLeaveOneOut X N i omega| +
            Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) ∂mu) := by
      rw [← integral_const_mul]
      apply integral_congr_ae
      exact ae_of_all mu fun omega => by ring
    _ = (Real.sqrt (N + 1 : ℝ))⁻¹ *
        ((∫ omega, |X i.1 omega| ∂mu) *
          ∫ omega, |normalizedCenteredIidLeaveOneOut X N i omega| +
            Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) ∂mu) := by
      rw [hfact']
    _ = _ := by ring

/-- Integrated leave-one-out derivative increment.  The continuous term is
factored by independence and the atomic term is controlled by the
leave-one-out Kolmogorov distance. -/
theorem integral_abs_standardNormalSteinDerivative_sum_sub_leaveOneOut_le
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    (∫ omega, |standardNormalSteinDerivative x (W omega) -
        standardNormalSteinDerivative x (Wi omega)| ∂mu) ≤
      scale * (∫ omega, |Wi omega| + C ∂mu) *
          (∫ omega, |X i.1 omega| ∂mu) +
        (Real.sqrt (2 * Real.pi))⁻¹ * scale *
          (∫ omega, |X i.1 omega| ∂mu) +
        2 * kolmogorovDistance (Measure.map Wi mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  dsimp only
  let Wi := normalizedCenteredIidLeaveOneOut X N i
  let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
  let scale : ℝ := (Real.sqrt (N + 1 : ℝ))⁻¹
  let C : ℝ := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
  have hLeave := normalizedCenteredIidLeaveOneOut_memLp X hX N i
  have hW :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp X hX N
  have hind := indepFun_normalizedCenteredIidLeaveOneOut
    X (fun j => (hX j).aemeasurable) hIndep N i
  have hWiAbs : Integrable (fun omega => |Wi omega|) mu := by
    simpa only [Wi, Real.norm_eq_abs] using
      ((hLeave.integrable (by norm_num)).norm)
  have hXiAbs : Integrable (fun omega => |X i.1 omega|) mu := by
    simpa only [Real.norm_eq_abs] using
      (((hX i.1).integrable (by norm_num)).norm)
  have hA : Integrable (fun omega => |Wi omega| + C) mu :=
    hWiAbs.add (integrable_const C)
  have hindAbs0 := hind.symm.comp
    (show Measurable (fun w : ℝ => |w| + C) by fun_prop)
    (show Measurable (fun v : ℝ => |v|) by fun_prop)
  have hindAbs : IndepFun (fun omega => |Wi omega| + C)
      (fun omega => |X i.1 omega|) mu := by
    simpa only [Wi, Function.comp_apply] using hindAbs0
  have hprod : Integrable
      ((fun omega => |Wi omega| + C) * fun omega => |X i.1 omega|) mu :=
    hindAbs.integrable_mul hA hXiAbs
  have hDrift : Integrable (fun omega =>
      (|Wi omega| + C) * (scale * |X i.1 omega|)) mu := by
    exact (hprod.const_mul scale).congr (ae_of_all mu fun omega => by
      simp only [Pi.mul_apply]
      ring)
  have hCrossMeas : AEStronglyMeasurable (fun omega =>
      (standardNormalSteinCrossingSet x scale).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega)) mu :=
    ((measurable_const.indicator
      (measurableSet_standardNormalSteinCrossingSet x scale)).comp_aemeasurable
        (hLeave.aemeasurable.prodMk (hX i.1).aemeasurable)).aestronglyMeasurable
  have hCross : Integrable (fun omega =>
      (standardNormalSteinCrossingSet x scale).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega)) mu := by
    apply Integrable.of_bound hCrossMeas 1
    exact ae_of_all mu fun omega => by
      by_cases hp : (Wi omega, X i.1 omega) ∈
          standardNormalSteinCrossingSet x scale <;>
        simp [hp]
  have hLeft : Integrable (fun omega =>
      |standardNormalSteinDerivative x (W omega) -
        standardNormalSteinDerivative x (Wi omega)|) mu := by
    simpa only [Real.norm_eq_abs] using
      ((integrable_standardNormalSteinDerivative_comp W hW.aemeasurable x).sub
        (integrable_standardNormalSteinDerivative_comp Wi hLeave.aemeasurable x)).norm
  have hPoint : ∀ omega,
      |standardNormalSteinDerivative x (W omega) -
          standardNormalSteinDerivative x (Wi omega)| ≤
        (|Wi omega| + C) * (scale * |X i.1 omega|) +
          (standardNormalSteinCrossingSet x scale).indicator
            (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega) := by
    intro omega
    simpa only [W, Wi, scale, C] using
      abs_standardNormalSteinDerivative_sum_sub_leaveOneOut_le_crossingSet
        X N i x omega
  have hMono := integral_mono hLeft (hDrift.add hCross) hPoint
  have hDriftEq := integral_leaveOneOut_driftMajorant_eq X hX hIndep N i
  have hCrossLe := integral_standardNormalSteinCrossingSet_leaveOneOut_le
    X hX hIndep N i x
  have hDriftEq' :
      (∫ omega, (|Wi omega| + C) * (scale * |X i.1 omega|) ∂mu) =
        scale * (∫ omega, |Wi omega| + C ∂mu) *
          (∫ omega, |X i.1 omega| ∂mu) := by
    simpa only [Wi, scale, C] using hDriftEq
  have hCrossLe' :
      (∫ omega, (standardNormalSteinCrossingSet x scale).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega) ∂mu) ≤
        (Real.sqrt (2 * Real.pi))⁻¹ * scale *
          (∫ omega, |X i.1 omega| ∂mu) +
        2 * kolmogorovDistance (Measure.map Wi mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
    simpa only [Wi, scale] using hCrossLe
  calc
    (∫ omega, |standardNormalSteinDerivative x (W omega) -
        standardNormalSteinDerivative x (Wi omega)| ∂mu) ≤
      ∫ omega, ((|Wi omega| + C) * (scale * |X i.1 omega|) +
        (standardNormalSteinCrossingSet x scale).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega)) ∂mu := hMono
    _ = (∫ omega, (|Wi omega| + C) * (scale * |X i.1 omega|) ∂mu) +
        ∫ omega, (standardNormalSteinCrossingSet x scale).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega) ∂mu :=
      integral_add hDrift hCross
    _ ≤ scale * (∫ omega, |Wi omega| + C ∂mu) *
          (∫ omega, |X i.1 omega| ∂mu) +
        ((Real.sqrt (2 * Real.pi))⁻¹ * scale *
          (∫ omega, |X i.1 omega| ∂mu) +
        2 * kolmogorovDistance (Measure.map Wi mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
      rw [hDriftEq']
      exact add_le_add_right hCrossLe' _
    _ = _ := by ring

/-- Integrability of both terms in one normalized-summand interval remainder.
This is the linearity side condition needed to collect the
variance-cancellation bracket into a finite sum. -/
theorem integrable_normalizedSummand_steinIntervalRemainder_components
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    Integrable (fun omega => scale ^ 2 * (X i.1 omega) ^ 2 *
      standardNormalSteinDerivative x (Wi omega)) mu ∧
    Integrable (fun omega =>
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z)) mu := by
  dsimp only
  let Wi := normalizedCenteredIidLeaveOneOut X N i
  let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
  let scale : ℝ := (Real.sqrt (N + 1 : ℝ))⁻¹
  let C : ℝ := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
  let hX2 : ∀ j, MemLp (X j) 2 mu := fun j =>
    (hX j).mono_exponent (by norm_num)
  have hLeave := normalizedCenteredIidLeaveOneOut_memLp X hX2 N i
  have hW :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp X hX2 N
  have hind := indepFun_normalizedCenteredIidLeaveOneOut
    X (fun j => (hX j).aemeasurable) hIndep N i
  have hXiSq : Integrable (fun omega => (X i.1 omega) ^ 2) mu :=
    (hX2 i.1).integrable_sq
  have hDWi : Integrable
      (fun omega => standardNormalSteinDerivative x (Wi omega)) mu := by
    simpa only [Wi] using
      integrable_standardNormalSteinDerivative_comp Wi hLeave.aemeasurable x
  have hindA0 := hind.comp
    (show Measurable (fun v : ℝ => v ^ 2) by fun_prop)
    (measurable_standardNormalSteinDerivative x)
  have hindA : IndepFun (fun omega => (X i.1 omega) ^ 2)
      (fun omega => standardNormalSteinDerivative x (Wi omega)) mu := by
    simpa only [Wi, Function.comp_apply] using hindA0
  have hA0 : Integrable (fun omega => (X i.1 omega) ^ 2 *
      standardNormalSteinDerivative x (Wi omega)) mu :=
    hindA.integrable_mul hXiSq hDWi
  have hA : Integrable (fun omega => scale ^ 2 * (X i.1 omega) ^ 2 *
      standardNormalSteinDerivative x (Wi omega)) mu := by
    exact (hA0.const_mul (scale ^ 2)).congr
      (ae_of_all mu fun omega => by ring)
  have hXi : Integrable (X i.1) mu := (hX i.1).integrable (by norm_num)
  have hfW : AEMeasurable
      (fun omega => standardNormalSteinSolution x (W omega)) mu :=
    (continuous_standardNormalSteinSolution x).measurable.comp_aemeasurable
      hW.aemeasurable
  have hfWi : AEMeasurable
      (fun omega => standardNormalSteinSolution x (Wi omega)) mu :=
    (continuous_standardNormalSteinSolution x).measurable.comp_aemeasurable
      hLeave.aemeasurable
  have hDiffMeas : AEStronglyMeasurable (fun omega =>
      standardNormalSteinSolution x (W omega) -
        standardNormalSteinSolution x (Wi omega)) mu :=
    (hfW.sub hfWi).aestronglyMeasurable
  have hDiffBound : ∀ᵐ omega ∂mu,
      ‖standardNormalSteinSolution x (W omega) -
        standardNormalSteinSolution x (Wi omega)‖ ≤ 2 * C :=
    ae_of_all mu fun omega => by
      rw [Real.norm_eq_abs]
      calc
        |standardNormalSteinSolution x (W omega) -
            standardNormalSteinSolution x (Wi omega)| ≤
          |standardNormalSteinSolution x (W omega)| +
            |standardNormalSteinSolution x (Wi omega)| := abs_sub _ _
        _ = standardNormalSteinSolution x (W omega) +
            standardNormalSteinSolution x (Wi omega) := by
          rw [abs_of_nonneg (standardNormalSteinSolution_nonneg x _),
            abs_of_nonneg (standardNormalSteinSolution_nonneg x _)]
        _ ≤ C + C := add_le_add
          (by simpa only [C] using standardNormalSteinSolution_le x (W omega))
          (by simpa only [C] using standardNormalSteinSolution_le x (Wi omega))
        _ = 2 * C := by ring
  have hB0 : Integrable (fun omega => X i.1 omega *
      (standardNormalSteinSolution x (W omega) -
        standardNormalSteinSolution x (Wi omega))) mu :=
    hXi.mul_bdd hDiffMeas hDiffBound
  have hB : Integrable (fun omega => scale * X i.1 omega *
      (∫ z in Wi omega..W omega,
        standardNormalSteinDerivative x z)) mu := by
    exact (hB0.const_mul scale).congr (ae_of_all mu fun omega => by
      have hInt := intervalIntegral_standardNormalSteinDerivative_eq_sub
        x (Wi omega) (W omega)
      calc
        scale * (X i.1 omega *
            (standardNormalSteinSolution x (W omega) -
              standardNormalSteinSolution x (Wi omega))) =
          scale * X i.1 omega *
            (standardNormalSteinSolution x (W omega) -
              standardNormalSteinSolution x (Wi omega)) := by ring
        _ = scale * X i.1 omega *
            (∫ z in Wi omega..W omega,
              standardNormalSteinDerivative x z) :=
          congrArg (fun q : ℝ => scale * X i.1 omega * q) hInt.symm)
  exact ⟨hA, hB⟩

/-- Integrability of one normalized-summand interval remainder. -/
theorem integrable_normalizedSummand_steinIntervalRemainder
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    Integrable (fun omega =>
      scale ^ 2 * (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) -
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z)) mu := by
  have hComponents :=
    integrable_normalizedSummand_steinIntervalRemainder_components
      X hX hIndep N i x
  exact hComponents.1.sub hComponents.2

/-- The integral of one normalized-summand remainder is exactly the
corresponding difference of the two terms in the variance-cancellation
bracket. -/
theorem integral_normalizedSummand_steinIntervalRemainder_eq
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    (∫ omega, scale ^ 2 * (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) -
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z) ∂mu) =
      scale ^ 2 * (∫ omega, (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) ∂mu) -
        scale * (∫ omega, X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z) ∂mu) := by
  dsimp only
  have hComponents :=
    integrable_normalizedSummand_steinIntervalRemainder_components
      X hX hIndep N i x
  rw [integral_sub hComponents.1 hComponents.2]
  congr 1
  · rw [← integral_const_mul]
    apply integral_congr_ae
    exact ae_of_all mu fun omega => by ring
  · rw [← integral_const_mul]
    apply integral_congr_ae
    exact ae_of_all mu fun omega => by ring

/-- The complete second variance-cancellation bracket is the finite sum of
the one-summand interval remainders. -/
theorem varianceCancellation_secondBracket_eq_sum_integral_remainders
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    scale ^ 2 * ∑ i : Fin (N + 1), ∫ omega,
        (X i.1 omega) ^ 2 * standardNormalSteinDerivative x
          (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu -
      scale * ∑ i : Fin (N + 1), ∫ omega,
        X i.1 omega *
          (∫ z in normalizedCenteredIidLeaveOneOut X N i omega..W omega,
            standardNormalSteinDerivative x z) ∂mu =
      ∑ i : Fin (N + 1), ∫ omega,
        scale ^ 2 * (X i.1 omega) ^ 2 * standardNormalSteinDerivative x
            (normalizedCenteredIidLeaveOneOut X N i omega) -
          scale * X i.1 omega *
            (∫ z in normalizedCenteredIidLeaveOneOut X N i omega..W omega,
              standardNormalSteinDerivative x z) ∂mu := by
  dsimp only
  rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro i _
  exact (integral_normalizedSummand_steinIntervalRemainder_eq
    X hX hIndep N i x).symm

/-- Integrated second-bracket remainder for one normalized summand.  The
continuous contribution factors into a leave-one-out first moment and the
third absolute summand moment; the atomic contribution is controlled by the
weighted crossing estimate. -/
theorem integral_abs_normalizedSummand_steinIntervalRemainder_le
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    (∫ omega, |scale ^ 2 * (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) -
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z)| ∂mu) ≤
      (scale ^ 3 / 2) * (∫ omega, |Wi omega| + C ∂mu) *
          (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
        scale ^ 2 *
          ((Real.sqrt (2 * Real.pi))⁻¹ * scale *
              (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
            2 * kolmogorovDistance (Measure.map Wi mu)
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw *
              (∫ omega, (X i.1 omega) ^ 2 ∂mu)) := by
  dsimp only
  let Wi := normalizedCenteredIidLeaveOneOut X N i
  let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
  let scale : ℝ := (Real.sqrt (N + 1 : ℝ))⁻¹
  let C : ℝ := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
  let hX2 : ∀ j, MemLp (X j) 2 mu := fun j =>
    (hX j).mono_exponent (by norm_num)
  have hLeave := normalizedCenteredIidLeaveOneOut_memLp X hX2 N i
  have hW :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp X hX2 N
  have hind := indepFun_normalizedCenteredIidLeaveOneOut
    X (fun j => (hX j).aemeasurable) hIndep N i
  have hWiAbs : Integrable (fun omega => |Wi omega|) mu := by
    simpa only [Wi, Real.norm_eq_abs] using
      ((hLeave.integrable (by norm_num)).norm)
  have hXiCube : Integrable (fun omega => |X i.1 omega| ^ 3) mu := by
    simpa only [Real.norm_eq_abs] using
      (hX i.1).integrable_norm_pow (by norm_num)
  have hXiSq : Integrable (fun omega => (X i.1 omega) ^ 2) mu :=
    (hX2 i.1).integrable_sq
  have hA : Integrable (fun omega => |Wi omega| + C) mu :=
    hWiAbs.add (integrable_const C)
  have hindCube0 := hind.symm.comp
    (show Measurable (fun w : ℝ => |w| + C) by fun_prop)
    (show Measurable (fun v : ℝ => |v| ^ 3) by fun_prop)
  have hindCube : IndepFun (fun omega => |Wi omega| + C)
      (fun omega => |X i.1 omega| ^ 3) mu := by
    simpa only [Wi, Function.comp_apply] using hindCube0
  have hprod : Integrable
      ((fun omega => |Wi omega| + C) *
        fun omega => |X i.1 omega| ^ 3) mu :=
    hindCube.integrable_mul hA hXiCube
  have hDrift : Integrable (fun omega =>
      (|Wi omega| + C) *
        (scale ^ 3 * |X i.1 omega| ^ 3 / 2)) mu := by
    exact (hprod.const_mul (scale ^ 3 / 2)).congr
      (ae_of_all mu fun omega => by
        simp only [Pi.mul_apply]
        ring)
  have hIndicatorMeas : AEStronglyMeasurable (fun omega =>
      (standardNormalSteinCrossingSet x scale).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega)) mu :=
    ((measurable_const.indicator
      (measurableSet_standardNormalSteinCrossingSet x scale)).comp_aemeasurable
        (hLeave.aemeasurable.prodMk (hX i.1).aemeasurable)).aestronglyMeasurable
  have hCross0 : Integrable (fun omega => (X i.1 omega) ^ 2 *
      (standardNormalSteinCrossingSet x scale).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega)) mu := by
    apply hXiSq.mono'
      (((hX i.1).aemeasurable.pow_const 2).aestronglyMeasurable.mul
        hIndicatorMeas)
    exact ae_of_all mu fun omega => by
      by_cases hp : (Wi omega, X i.1 omega) ∈
          standardNormalSteinCrossingSet x scale <;>
        simp [hp, sq_nonneg]
  have hCross : Integrable (fun omega => scale ^ 2 * (X i.1 omega) ^ 2 *
      (standardNormalSteinCrossingSet x scale).indicator
        (fun _ : ℝ × ℝ => (1 : ℝ)) (Wi omega, X i.1 omega)) mu := by
    exact (hCross0.const_mul (scale ^ 2)).congr
      (ae_of_all mu fun omega => by ring)
  have hMajor := hDrift.add hCross
  have hPoint : ∀ omega,
      |scale ^ 2 * (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) -
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z)| ≤
        (|Wi omega| + C) *
            (scale ^ 3 * |X i.1 omega| ^ 3 / 2) +
          scale ^ 2 * (X i.1 omega) ^ 2 *
            (standardNormalSteinCrossingSet x scale).indicator
              (fun _ : ℝ × ℝ => (1 : ℝ))
              (Wi omega, X i.1 omega) := by
    intro omega
    simpa only [W, Wi, scale, C] using
      abs_normalizedSummand_steinIntervalRemainder_le X N i x omega
  have hLeftMeas : AEStronglyMeasurable (fun omega =>
      |scale ^ 2 * (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) -
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z)|) mu := by
    simp_rw [intervalIntegral_standardNormalSteinDerivative_eq_sub]
    have hXiMeas : AEMeasurable (X i.1) mu := (hX i.1).aemeasurable
    have hDWi : AEMeasurable
        (fun omega => standardNormalSteinDerivative x (Wi omega)) mu :=
      (measurable_standardNormalSteinDerivative x).comp_aemeasurable
        hLeave.aemeasurable
    have hfW : AEMeasurable
        (fun omega => standardNormalSteinSolution x (W omega)) mu :=
      (continuous_standardNormalSteinSolution x).measurable.comp_aemeasurable
        hW.aemeasurable
    have hfWi : AEMeasurable
        (fun omega => standardNormalSteinSolution x (Wi omega)) mu :=
      (continuous_standardNormalSteinSolution x).measurable.comp_aemeasurable
        hLeave.aemeasurable
    have hInner : AEMeasurable (fun omega =>
        scale ^ 2 * (X i.1 omega) ^ 2 *
            standardNormalSteinDerivative x (Wi omega) -
          scale * X i.1 omega *
            (standardNormalSteinSolution x (W omega) -
              standardNormalSteinSolution x (Wi omega))) mu :=
      (((hXiMeas.pow_const 2).const_mul (scale ^ 2)).mul hDWi).sub
        ((hXiMeas.const_mul scale).mul (hfW.sub hfWi))
    exact (continuous_abs.measurable.comp_aemeasurable hInner).aestronglyMeasurable
  have hLeft : Integrable (fun omega =>
      |scale ^ 2 * (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) -
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z)|) mu := by
    apply hMajor.mono' hLeftMeas
    exact ae_of_all mu fun omega => by
      rw [Real.norm_eq_abs, abs_of_nonneg (abs_nonneg _)]
      exact hPoint omega
  have hMono := integral_mono hLeft hMajor hPoint
  have hDriftEq := integral_leaveOneOut_cubicDriftMajorant_eq
    X hX hIndep N i
  have hCrossLe :=
    integral_sq_mul_standardNormalSteinCrossingSet_leaveOneOut_le
      X hX hIndep N i x
  have hDriftEq' :
      (∫ omega, (|Wi omega| + C) *
        (scale ^ 3 * |X i.1 omega| ^ 3 / 2) ∂mu) =
        (scale ^ 3 / 2) * (∫ omega, |Wi omega| + C ∂mu) *
          (∫ omega, |X i.1 omega| ^ 3 ∂mu) := by
    simpa only [Wi, scale, C] using hDriftEq
  have hCrossLe' :
      (∫ omega, (X i.1 omega) ^ 2 *
        (standardNormalSteinCrossingSet x scale).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ))
          (Wi omega, X i.1 omega) ∂mu) ≤
        (Real.sqrt (2 * Real.pi))⁻¹ * scale *
            (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
          2 * kolmogorovDistance (Measure.map Wi mu)
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw *
            (∫ omega, (X i.1 omega) ^ 2 ∂mu) := by
    simpa only [Wi, scale] using hCrossLe
  have hCrossScaledLe :
      (∫ omega, scale ^ 2 * (X i.1 omega) ^ 2 *
        (standardNormalSteinCrossingSet x scale).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ))
          (Wi omega, X i.1 omega) ∂mu) ≤
        scale ^ 2 *
          ((Real.sqrt (2 * Real.pi))⁻¹ * scale *
              (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
            2 * kolmogorovDistance (Measure.map Wi mu)
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw *
              (∫ omega, (X i.1 omega) ^ 2 ∂mu)) := by
    calc
      (∫ omega, scale ^ 2 * (X i.1 omega) ^ 2 *
        (standardNormalSteinCrossingSet x scale).indicator
          (fun _ : ℝ × ℝ => (1 : ℝ))
          (Wi omega, X i.1 omega) ∂mu) =
        scale ^ 2 * ∫ omega, (X i.1 omega) ^ 2 *
          (standardNormalSteinCrossingSet x scale).indicator
            (fun _ : ℝ × ℝ => (1 : ℝ))
            (Wi omega, X i.1 omega) ∂mu := by
          rw [← integral_const_mul]
          apply integral_congr_ae
          exact ae_of_all mu fun omega => by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hCrossLe' (sq_nonneg scale)
  calc
    (∫ omega, |scale ^ 2 * (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) -
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z)| ∂mu) ≤
      ∫ omega, ((|Wi omega| + C) *
          (scale ^ 3 * |X i.1 omega| ^ 3 / 2) +
        scale ^ 2 * (X i.1 omega) ^ 2 *
          (standardNormalSteinCrossingSet x scale).indicator
            (fun _ : ℝ × ℝ => (1 : ℝ))
            (Wi omega, X i.1 omega)) ∂mu := hMono
    _ = (∫ omega, (|Wi omega| + C) *
          (scale ^ 3 * |X i.1 omega| ^ 3 / 2) ∂mu) +
        ∫ omega, scale ^ 2 * (X i.1 omega) ^ 2 *
          (standardNormalSteinCrossingSet x scale).indicator
            (fun _ : ℝ × ℝ => (1 : ℝ))
            (Wi omega, X i.1 omega) ∂mu :=
      integral_add hDrift hCross
    _ ≤ (scale ^ 3 / 2) * (∫ omega, |Wi omega| + C ∂mu) *
          (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
        scale ^ 2 *
          ((Real.sqrt (2 * Real.pi))⁻¹ * scale *
              (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
            2 * kolmogorovDistance (Measure.map Wi mu)
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw *
              (∫ omega, (X i.1 omega) ^ 2 ∂mu)) :=
      add_le_add hDriftEq'.le hCrossScaledLe

/-- Expectation form of the one-summand second-bracket estimate. -/
theorem abs_integral_normalizedSummand_steinIntervalRemainder_le
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    |∫ omega, scale ^ 2 * (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) -
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z) ∂mu| ≤
      (scale ^ 3 / 2) * (∫ omega, |Wi omega| + C ∂mu) *
          (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
        scale ^ 2 *
          ((Real.sqrt (2 * Real.pi))⁻¹ * scale *
              (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
            2 * kolmogorovDistance (Measure.map Wi mu)
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw *
              (∫ omega, (X i.1 omega) ^ 2 ∂mu)) := by
  dsimp only
  exact abs_integral_le_integral_abs.trans
    (integral_abs_normalizedSummand_steinIntervalRemainder_le
      X hX hIndep N i x)

/-- Unit-variance specialization of the one-summand second-bracket estimate. -/
theorem abs_integral_normalizedSummand_steinIntervalRemainder_le_unitSecond
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu)
    (hSecond : ∀ j, ∫ omega, (X j omega) ^ 2 ∂mu = 1)
    (N : ℕ) (i : Fin (N + 1)) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    |∫ omega, scale ^ 2 * (X i.1 omega) ^ 2 *
          standardNormalSteinDerivative x (Wi omega) -
        scale * X i.1 omega *
          (∫ z in Wi omega..W omega,
            standardNormalSteinDerivative x z) ∂mu| ≤
      (scale ^ 3 / 2) * (∫ omega, |Wi omega| + C ∂mu) *
          (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
        scale ^ 2 *
          ((Real.sqrt (2 * Real.pi))⁻¹ * scale *
              (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
            2 * kolmogorovDistance (Measure.map Wi mu)
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
  have h := abs_integral_normalizedSummand_steinIntervalRemainder_le
    X hX hIndep N i x
  simpa only [hSecond i.1, mul_one] using h

/-- The entire unit-variance second variance-cancellation bracket is bounded
by the sum of the explicit one-summand remainder estimates. -/
theorem abs_varianceCancellation_secondBracket_le_sum_unitSecond
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu)
    (hSecond : ∀ j, ∫ omega, (X j omega) ^ 2 ∂mu = 1)
    (N : ℕ) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    |scale ^ 2 * ∑ i : Fin (N + 1), ∫ omega,
        (X i.1 omega) ^ 2 * standardNormalSteinDerivative x
          (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu -
      scale * ∑ i : Fin (N + 1), ∫ omega,
        X i.1 omega *
          (∫ z in normalizedCenteredIidLeaveOneOut X N i omega..W omega,
            standardNormalSteinDerivative x z) ∂mu| ≤
      ∑ i : Fin (N + 1), (
        (scale ^ 3 / 2) *
            (∫ omega,
              |normalizedCenteredIidLeaveOneOut X N i omega| + C ∂mu) *
            (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
          scale ^ 2 *
            ((Real.sqrt (2 * Real.pi))⁻¹ * scale *
                (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
              2 * kolmogorovDistance
                (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)) := by
  dsimp only
  calc
    |(Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
          ∑ i : Fin (N + 1), ∫ omega,
            (X i.1 omega) ^ 2 * standardNormalSteinDerivative x
              (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu -
        (Real.sqrt (N + 1 : ℝ))⁻¹ *
          ∑ i : Fin (N + 1), ∫ omega,
            X i.1 omega *
              (∫ z in normalizedCenteredIidLeaveOneOut X N i omega..
                  NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                    X N omega,
                standardNormalSteinDerivative x z) ∂mu| =
      |∑ i : Fin (N + 1), ∫ omega,
        (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * (X i.1 omega) ^ 2 *
            standardNormalSteinDerivative x
              (normalizedCenteredIidLeaveOneOut X N i omega) -
          (Real.sqrt (N + 1 : ℝ))⁻¹ * X i.1 omega *
            (∫ z in normalizedCenteredIidLeaveOneOut X N i omega..
                NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                  X N omega,
              standardNormalSteinDerivative x z) ∂mu| :=
        congrArg abs
          (varianceCancellation_secondBracket_eq_sum_integral_remainders
            X hX hIndep N x)
    _ ≤ ∑ i : Fin (N + 1),
        |∫ omega,
          (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * (X i.1 omega) ^ 2 *
              standardNormalSteinDerivative x
                (normalizedCenteredIidLeaveOneOut X N i omega) -
            (Real.sqrt (N + 1 : ℝ))⁻¹ * X i.1 omega *
              (∫ z in normalizedCenteredIidLeaveOneOut X N i omega..
                  NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                    X N omega,
                standardNormalSteinDerivative x z) ∂mu| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ _ := by
      apply Finset.sum_le_sum
      intro i _
      exact abs_integral_normalizedSummand_steinIntervalRemainder_le_unitSecond
        X hX hIndep hSecond N i x

/-- The first variance-cancellation bracket is the normalized average of the
leave-one-out derivative-expectation differences. -/
theorem varianceCancellation_firstBracket_eq_scaled_sum_differences
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega}
    (X : ℕ → Omega → ℝ) (N : ℕ) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    (∫ omega, standardNormalSteinDerivative x (W omega) ∂mu) -
        scale ^ 2 * ∑ i : Fin (N + 1), ∫ omega,
          standardNormalSteinDerivative x
            (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu =
      scale ^ 2 * ∑ i : Fin (N + 1),
        ((∫ omega, standardNormalSteinDerivative x (W omega) ∂mu) -
          ∫ omega, standardNormalSteinDerivative x
            (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu) := by
  dsimp only
  have hsqrtPos : 0 < Real.sqrt (N + 1 : ℝ) := by positivity
  have hscale : (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * (N + 1 : ℝ) = 1 := by
    rw [inv_pow]
    field_simp [hsqrtPos.ne']
    exact (Real.sq_sqrt (by positivity : (0 : ℝ) ≤ N + 1)).symm
  symm
  calc
    (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
        ∑ i : Fin (N + 1),
          ((∫ omega, standardNormalSteinDerivative x
              (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                X N omega) ∂mu) -
            ∫ omega, standardNormalSteinDerivative x
              (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu) =
      (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
        ((N + 1 : ℝ) *
            (∫ omega, standardNormalSteinDerivative x
              (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                X N omega) ∂mu) -
          ∑ i : Fin (N + 1), ∫ omega, standardNormalSteinDerivative x
            (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu) := by
        rw [Finset.sum_sub_distrib]
        simp
    _ = (∫ omega, standardNormalSteinDerivative x
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
              X N omega) ∂mu) -
          (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
            ∑ i : Fin (N + 1), ∫ omega, standardNormalSteinDerivative x
              (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu := by
      rw [mul_sub, ← mul_assoc, hscale, one_mul]

/-- Expectation form of the integrated leave-one-out derivative estimate. -/
theorem abs_integral_standardNormalSteinDerivative_sum_sub_leaveOneOut_le
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (i : Fin (N + 1)) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let Wi := normalizedCenteredIidLeaveOneOut X N i
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    |(∫ omega, standardNormalSteinDerivative x (W omega) ∂mu) -
        ∫ omega, standardNormalSteinDerivative x (Wi omega) ∂mu| ≤
      scale * (∫ omega, |Wi omega| + C ∂mu) *
          (∫ omega, |X i.1 omega| ∂mu) +
        (Real.sqrt (2 * Real.pi))⁻¹ * scale *
          (∫ omega, |X i.1 omega| ∂mu) +
        2 * kolmogorovDistance (Measure.map Wi mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  dsimp only
  let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
  let Wi := normalizedCenteredIidLeaveOneOut X N i
  have hW :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp X hX N
  have hWi := normalizedCenteredIidLeaveOneOut_memLp X hX N i
  have hDW := integrable_standardNormalSteinDerivative_comp W hW.aemeasurable x
  have hDWi := integrable_standardNormalSteinDerivative_comp Wi hWi.aemeasurable x
  have hAbs := integral_abs_standardNormalSteinDerivative_sum_sub_leaveOneOut_le
    X hX hIndep N i x
  dsimp only at hAbs
  calc
    |(∫ omega, standardNormalSteinDerivative x (W omega) ∂mu) -
        ∫ omega, standardNormalSteinDerivative x (Wi omega) ∂mu| =
      |∫ omega, (standardNormalSteinDerivative x (W omega) -
        standardNormalSteinDerivative x (Wi omega)) ∂mu| := by
      rw [integral_sub hDW hDWi]
    _ ≤ ∫ omega, |standardNormalSteinDerivative x (W omega) -
        standardNormalSteinDerivative x (Wi omega)| ∂mu := by
      simpa only [Real.norm_eq_abs] using
        norm_integral_le_integral_norm (fun omega =>
          standardNormalSteinDerivative x (W omega) -
            standardNormalSteinDerivative x (Wi omega))
    _ ≤ _ := by simpa only [W, Wi] using hAbs

/-- The complete first variance-cancellation bracket is bounded by the
normalized sum of its explicit leave-one-out derivative estimates. -/
theorem abs_varianceCancellation_firstBracket_le_sum
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 2 mu)
    (hIndep : iIndepFun X mu) (N : ℕ) (x : ℝ) :
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    |(∫ omega, standardNormalSteinDerivative x (W omega) ∂mu) -
        scale ^ 2 * ∑ i : Fin (N + 1), ∫ omega,
          standardNormalSteinDerivative x
            (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu| ≤
      scale ^ 2 * ∑ i : Fin (N + 1), (
        scale *
            (∫ omega,
              |normalizedCenteredIidLeaveOneOut X N i omega| + C ∂mu) *
            (∫ omega, |X i.1 omega| ∂mu) +
          (Real.sqrt (2 * Real.pi))⁻¹ * scale *
            (∫ omega, |X i.1 omega| ∂mu) +
          2 * kolmogorovDistance
            (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
  dsimp only
  have hEq := varianceCancellation_firstBracket_eq_scaled_sum_differences
    (mu := mu) X N x
  dsimp only at hEq
  calc
    |(∫ omega, standardNormalSteinDerivative x
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
            X N omega) ∂mu) -
        (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * ∑ i : Fin (N + 1),
          ∫ omega, standardNormalSteinDerivative x
            (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu| =
      |(Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
        ∑ i : Fin (N + 1),
          ((∫ omega, standardNormalSteinDerivative x
              (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                X N omega) ∂mu) -
            ∫ omega, standardNormalSteinDerivative x
              (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu)| :=
        congrArg abs hEq
    _ = (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
        |∑ i : Fin (N + 1),
          ((∫ omega, standardNormalSteinDerivative x
              (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                X N omega) ∂mu) -
            ∫ omega, standardNormalSteinDerivative x
              (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu)| := by
      rw [abs_mul, abs_of_nonneg (sq_nonneg _)]
    _ ≤ (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
        ∑ i : Fin (N + 1),
          |(∫ omega, standardNormalSteinDerivative x
              (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                X N omega) ∂mu) -
            ∫ omega, standardNormalSteinDerivative x
              (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu| :=
      mul_le_mul_of_nonneg_left (Finset.abs_sum_le_sum_abs _ _)
        (sq_nonneg _)
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
      apply Finset.sum_le_sum
      intro i _
      exact abs_integral_standardNormalSteinDerivative_sum_sub_leaveOneOut_le
        X hX hIndep N i x

/-- Pointwise standard-normal CDF error obtained by combining both complete
variance-cancellation bracket estimates. -/
theorem abs_cdf_normalizedCenteredIidSum_sub_standardNormal_le_steinSums
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu)
    (hMean : ∀ j, ∫ omega, X j omega ∂mu = 0)
    (hSecond : ∀ j, ∫ omega, (X j omega) ^ 2 ∂mu = 1)
    (N : ℕ) (x : ℝ) :
    let hX2 : ∀ j, MemLp (X j) 2 mu := fun j =>
      (hX j).mono_exponent (by norm_num)
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    |cdf (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw W
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
            X hX2 N).aemeasurable) x -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| ≤
      scale ^ 2 * ∑ i : Fin (N + 1), (
        scale *
            (∫ omega,
              |normalizedCenteredIidLeaveOneOut X N i omega| + C ∂mu) *
            (∫ omega, |X i.1 omega| ∂mu) +
          (Real.sqrt (2 * Real.pi))⁻¹ * scale *
            (∫ omega, |X i.1 omega| ∂mu) +
          2 * kolmogorovDistance
            (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) +
        ∑ i : Fin (N + 1), (
          (scale ^ 3 / 2) *
              (∫ omega,
                |normalizedCenteredIidLeaveOneOut X N i omega| + C ∂mu) *
              (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
            scale ^ 2 *
              ((Real.sqrt (2 * Real.pi))⁻¹ * scale *
                  (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
                2 * kolmogorovDistance
                  (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)) := by
  dsimp only
  let hX2 : ∀ j, MemLp (X j) 2 mu := fun j =>
    (hX j).mono_exponent (by norm_num)
  have hIdentity :=
    integral_normalizedCenteredIidSum_stein_varianceCancellation
      X hX2 hIndep hMean hSecond N x
  have hFirst := abs_varianceCancellation_firstBracket_le_sum
    X hX2 hIndep N x
  have hSecondBound :=
    abs_varianceCancellation_secondBracket_le_sum_unitSecond
      X hX hIndep hSecond N x
  dsimp only at hIdentity hFirst hSecondBound
  calc
    |cdf (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
            X hX2 N).aemeasurable) x -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| =
      |((∫ omega, standardNormalSteinDerivative x
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
              X N omega) ∂mu) -
          (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * ∑ i : Fin (N + 1),
            ∫ omega, standardNormalSteinDerivative x
              (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu) +
        ((Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * ∑ i : Fin (N + 1),
            ∫ omega, (X i.1 omega) ^ 2 *
              standardNormalSteinDerivative x
                (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu -
          (Real.sqrt (N + 1 : ℝ))⁻¹ * ∑ i : Fin (N + 1),
            ∫ omega, X i.1 omega *
              (∫ z in normalizedCenteredIidLeaveOneOut X N i omega..
                  NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                    X N omega,
                standardNormalSteinDerivative x z) ∂mu)| :=
        congrArg abs hIdentity.symm
    _ ≤
      |(∫ omega, standardNormalSteinDerivative x
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
              X N omega) ∂mu) -
          (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * ∑ i : Fin (N + 1),
            ∫ omega, standardNormalSteinDerivative x
              (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu| +
        |(Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * ∑ i : Fin (N + 1),
            ∫ omega, (X i.1 omega) ^ 2 *
              standardNormalSteinDerivative x
                (normalizedCenteredIidLeaveOneOut X N i omega) ∂mu -
          (Real.sqrt (N + 1 : ℝ))⁻¹ * ∑ i : Fin (N + 1),
            ∫ omega, X i.1 omega *
              (∫ z in normalizedCenteredIidLeaveOneOut X N i omega..
                  NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                    X N omega,
                standardNormalSteinDerivative x z) ∂mu| := abs_add_le _ _
    _ ≤ _ := add_le_add hFirst hSecondBound

/-- Under the iid unit-variance hypotheses, the two explicit Stein sums
collapse to one deterministic `1 / sqrt (N + 1)` term and a recursive sum of
leave-one-out Kolmogorov distances.  The coefficient `4` records the two
distance contributions from each variance-cancellation bracket. -/
theorem abs_cdf_normalizedCenteredIidSum_sub_standardNormal_le_collapsedStein
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu)
    (hIdent : ∀ j, IdentDistrib (X j) (X 0) mu mu)
    (hMean : ∀ j, ∫ omega, X j omega ∂mu = 0)
    (hSecond : ∀ j, ∫ omega, (X j omega) ^ 2 ∂mu = 1)
    (N : ℕ) (x : ℝ) :
    let hX2 : ∀ j, MemLp (X j) 2 mu := fun j =>
      (hX j).mono_exponent (by norm_num)
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    let rho := ∫ omega, |X 0 omega| ^ 3 ∂mu
    |cdf (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw W
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
            X hX2 N).aemeasurable) x -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| ≤
      scale *
          ((1 + C) + (Real.sqrt (2 * Real.pi))⁻¹ +
            rho * ((1 + C) / 2 + (Real.sqrt (2 * Real.pi))⁻¹)) +
        4 * scale ^ 2 * ∑ i : Fin (N + 1),
          kolmogorovDistance
            (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  dsimp only
  let hX2 : ∀ j, MemLp (X j) 2 mu := fun j =>
    (hX j).mono_exponent (by norm_num)
  have hBase :=
    abs_cdf_normalizedCenteredIidSum_sub_standardNormal_le_steinSums
      X hX hIndep hMean hSecond N x
  dsimp only at hBase
  refine hBase.trans ?_
  have hscale : 0 ≤ (Real.sqrt (N + 1 : ℝ))⁻¹ := by positivity
  have hnormal : 0 ≤ (Real.sqrt (2 * Real.pi))⁻¹ := by positivity
  have hrho : 0 ≤ ∫ omega, |X 0 omega| ^ 3 ∂mu :=
    integral_nonneg fun _ => by positivity
  have hscaleSq :
      (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * (N + 1 : ℝ) = 1 := by
    rw [inv_pow]
    field_simp [show Real.sqrt (N + 1 : ℝ) ≠ 0 by positivity]
    exact (Real.sq_sqrt (by positivity : (0 : ℝ) ≤ N + 1)).symm
  calc
    (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * ∑ i : Fin (N + 1), (
        (Real.sqrt (N + 1 : ℝ))⁻¹ *
            (∫ omega,
              |normalizedCenteredIidLeaveOneOut X N i omega| +
                Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) ∂mu) *
            (∫ omega, |X i.1 omega| ∂mu) +
          (Real.sqrt (2 * Real.pi))⁻¹ *
              (Real.sqrt (N + 1 : ℝ))⁻¹ *
            (∫ omega, |X i.1 omega| ∂mu) +
          2 * kolmogorovDistance
            (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) +
        ∑ i : Fin (N + 1), (
          ((Real.sqrt (N + 1 : ℝ))⁻¹ ^ 3 / 2) *
              (∫ omega,
                |normalizedCenteredIidLeaveOneOut X N i omega| +
                  Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) ∂mu) *
              (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
            (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
              ((Real.sqrt (2 * Real.pi))⁻¹ *
                    (Real.sqrt (N + 1 : ℝ))⁻¹ *
                  (∫ omega, |X i.1 omega| ^ 3 ∂mu) +
                2 * kolmogorovDistance
                  (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)) ≤
      (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * ∑ i : Fin (N + 1), (
        (Real.sqrt (N + 1 : ℝ))⁻¹ *
            (1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) +
          (Real.sqrt (2 * Real.pi))⁻¹ *
            (Real.sqrt (N + 1 : ℝ))⁻¹ +
          2 * kolmogorovDistance
            (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) +
        ∑ i : Fin (N + 1), (
          ((Real.sqrt (N + 1 : ℝ))⁻¹ ^ 3 / 2) *
              (1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) *
              (∫ omega, |X 0 omega| ^ 3 ∂mu) +
            (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
              ((Real.sqrt (2 * Real.pi))⁻¹ *
                    (Real.sqrt (N + 1 : ℝ))⁻¹ *
                  (∫ omega, |X 0 omega| ^ 3 ∂mu) +
                2 * kolmogorovDistance
                  (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)) := by
      apply add_le_add
      · apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
        apply Finset.sum_le_sum
        intro i _
        have hXi := integral_abs_le_one_of_secondMoment_eq_one
          (hX2 i.1) (hSecond i.1)
        have hWi :=
          integral_abs_normalizedCenteredIidLeaveOneOut_add_const_le
            X hX2 hIndep hMean hSecond N i
              (Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ))
        have hXiNonneg : 0 ≤ ∫ omega, |X i.1 omega| ∂mu :=
          integral_nonneg fun _ => abs_nonneg _
        have hCNonneg :
            0 ≤ 1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) := by
          positivity
        apply add_le_add
        · apply add_le_add
          · calc
              (Real.sqrt (N + 1 : ℝ))⁻¹ *
                    (∫ omega,
                      |normalizedCenteredIidLeaveOneOut X N i omega| +
                        Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) ∂mu) *
                    (∫ omega, |X i.1 omega| ∂mu) ≤
                  (Real.sqrt (N + 1 : ℝ))⁻¹ *
                    (1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) * 1 := by
                      rw [mul_one, mul_assoc]
                      apply mul_le_mul_of_nonneg_left _ hscale
                      simpa using mul_le_mul hWi hXi hXiNonneg hCNonneg
              _ = _ := by ring
          · simpa using
              mul_le_mul_of_nonneg_left hXi (mul_nonneg hnormal hscale)
        · rfl
      · apply Finset.sum_le_sum
        intro i _
        have hWi :=
          integral_abs_normalizedCenteredIidLeaveOneOut_add_const_le
            X hX2 hIndep hMean hSecond N i
              (Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ))
        have hXi3 := integral_abs_cube_eq_of_identDistrib (hIdent i.1)
        rw [hXi3]
        apply add_le_add
        · exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hWi (by positivity)) hrho
        · rfl
    _ = (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * (N + 1 : ℝ) *
          ((Real.sqrt (N + 1 : ℝ))⁻¹ *
            ((1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) +
              (Real.sqrt (2 * Real.pi))⁻¹ +
              (∫ omega, |X 0 omega| ^ 3 ∂mu) *
                ((1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) / 2 +
                  (Real.sqrt (2 * Real.pi))⁻¹))) +
        4 * (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
          ∑ i : Fin (N + 1),
            kolmogorovDistance
              (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
      simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_fin,
        nsmul_eq_mul, ← Finset.mul_sum, Nat.cast_add, Nat.cast_one]
      ring
    _ = _ := by rw [hscaleSq, one_mul]

/-- Substituting the exact leave-one-out law transport into the collapsed
Stein estimate yields an explicit recurrence.  Its inherited-error
coefficient is exactly `4`. -/
theorem abs_cdf_normalizedCenteredIidSum_sub_standardNormal_le_steinRecurrence
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ j, MemLp (X j) 3 mu)
    (hIndep : iIndepFun X mu)
    (hIdent : ∀ j, IdentDistrib (X j) (X 0) mu mu)
    (hMean : ∀ j, ∫ omega, X j omega ∂mu = 0)
    (hSecond : ∀ j, ∫ omega, (X j omega) ^ 2 ∂mu = 1)
    {N : ℕ} (hN : 0 < N) (x : ℝ) :
    let hX2 : ∀ j, MemLp (X j) 2 mu := fun j =>
      (hX j).mono_exponent (by norm_num)
    let W := NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
    let scale := (Real.sqrt (N + 1 : ℝ))⁻¹
    let C := Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)
    let rho := ∫ omega, |X 0 omega| ^ 3 ∂mu
    let previousLaw := Measure.map
      (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
        X (N - 1)) mu
    let contractedNormal := Measure.map
      (fun y : ℝ => Real.sqrt (N : ℝ) / Real.sqrt (N + 1 : ℝ) * y)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
    |cdf (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw W
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
            X hX2 N).aemeasurable) x -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x| ≤
      scale *
          ((1 + C) + (Real.sqrt (2 * Real.pi))⁻¹ +
            rho * ((1 + C) / 2 + (Real.sqrt (2 * Real.pi))⁻¹)) +
        4 * (kolmogorovDistance previousLaw
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
            kolmogorovDistance contractedNormal
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
  dsimp only
  let hX2 : ∀ j, MemLp (X j) 2 mu := fun j =>
    (hX j).mono_exponent (by norm_num)
  have hBase :=
    abs_cdf_normalizedCenteredIidSum_sub_standardNormal_le_collapsedStein
      X hX hIndep hIdent hMean hSecond N x
  dsimp only at hBase
  refine hBase.trans ?_
  refine add_le_add le_rfl ?_
  have hEach : ∀ i : Fin (N + 1),
      kolmogorovDistance
          (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
        kolmogorovDistance
            (Measure.map
              (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                X (N - 1)) mu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
          kolmogorovDistance
            (Measure.map
              (fun y : ℝ =>
                Real.sqrt (N : ℝ) / Real.sqrt (N + 1 : ℝ) * y)
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
    intro i
    exact
      kolmogorovDistance_normalizedCenteredIidLeaveOneOut_le_prefix_add_scalingDefect
        X (fun j => (hX j).aemeasurable) hIndep hIdent hN i
  have hSum := Finset.sum_le_sum
    (s := Finset.univ) (fun i _ => hEach i)
  have hscaleSq :
      (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 * (N + 1 : ℝ) = 1 := by
    rw [inv_pow]
    field_simp [show Real.sqrt (N + 1 : ℝ) ≠ 0 by positivity]
    exact (Real.sq_sqrt (by positivity : (0 : ℝ) ≤ N + 1)).symm
  calc
    4 * (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
        ∑ i : Fin (N + 1),
          kolmogorovDistance
            (Measure.map (normalizedCenteredIidLeaveOneOut X N i) mu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      4 * (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
        ∑ _i : Fin (N + 1),
          (kolmogorovDistance
              (Measure.map
                (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                  X (N - 1)) mu)
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
            kolmogorovDistance
              (Measure.map
                (fun y : ℝ =>
                  Real.sqrt (N : ℝ) / Real.sqrt (N + 1 : ℝ) * y)
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) :=
      mul_le_mul_of_nonneg_left hSum (by positivity)
    _ = 4 *
        (kolmogorovDistance
            (Measure.map
              (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                X (N - 1)) mu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
          kolmogorovDistance
            (Measure.map
              (fun y : ℝ =>
                Real.sqrt (N : ℝ) / Real.sqrt (N + 1 : ℝ) * y)
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
      rw [Finset.sum_const, Finset.card_fin]
      simp only [nsmul_eq_mul, Nat.cast_add, Nat.cast_one]
      calc
        4 * (Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
            ((N + 1 : ℝ) *
              (kolmogorovDistance
                  (Measure.map
                    (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                      X (N - 1)) mu)
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
                kolmogorovDistance
                  (Measure.map
                    (fun y : ℝ =>
                      Real.sqrt (N : ℝ) / Real.sqrt (N + 1 : ℝ) * y)
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)) =
            4 * ((Real.sqrt (N + 1 : ℝ))⁻¹ ^ 2 *
              (N + 1 : ℝ)) *
              (kolmogorovDistance
                  (Measure.map
                    (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
                      X (N - 1)) mu)
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
                kolmogorovDistance
                  (Measure.map
                    (fun y : ℝ =>
                      Real.sqrt (N : ℝ) / Real.sqrt (N + 1 : ℝ) * y)
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by ring
        _ = _ := by rw [hscaleSq, mul_one]

/-- The exact inherited-error coefficient exposed by the completed Stein
recurrence is noncontractive. -/
theorem one_lt_steinRecurrenceInheritedCoefficient : (1 : ℝ) < 4 := by
  norm_num

/-- Even the coefficient multiplying the standardized third moment in the
deterministic part of the collapsed Stein majorant exceeds one. -/
theorem one_lt_collapsedSteinRhoCoefficient :
    (1 : ℝ) <
      (1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) / 2 +
        (Real.sqrt (2 * Real.pi))⁻¹ := by
  have harg : (1 : ℝ) < 2 * Real.pi := by
    nlinarith [Real.pi_gt_three]
  have hsqrt : (1 : ℝ) < Real.sqrt (2 * Real.pi) := by
    simpa only [Real.sqrt_one] using
      Real.sqrt_lt_sqrt (by norm_num : (0 : ℝ) ≤ 1) harg
  have hexp : (1 : ℝ) < Real.exp (1 / 2 : ℝ) :=
    Real.one_lt_exp_iff.mpr (by norm_num)
  have hC : (1 : ℝ) <
      Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ) :=
    one_lt_mul_of_lt_of_le hsqrt hexp.le
  have hinv : (0 : ℝ) < (Real.sqrt (2 * Real.pi))⁻¹ := by positivity
  nlinarith

/-- Consequently, for every standardized third moment `rho ≥ 1`, the
deterministic coefficient in the completed Stein estimate already lies
strictly above the source budget `rho`, before either recursive distance term
is added. -/
theorem rho_lt_collapsedSteinDeterministicMajorant
    {rho : ℝ} (hrho : 1 ≤ rho) :
    rho <
      (1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) +
        (Real.sqrt (2 * Real.pi))⁻¹ +
        rho * ((1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) / 2 +
          (Real.sqrt (2 * Real.pi))⁻¹) := by
  have hrhoPos : 0 < rho := zero_lt_one.trans_le hrho
  have hCoeff := one_lt_collapsedSteinRhoCoefficient
  have hmul : 0 < rho *
      (((1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) / 2 +
        (Real.sqrt (2 * Real.pi))⁻¹) - 1) :=
    mul_pos hrhoPos (sub_pos.mpr hCoeff)
  have hadd : 0 <
      (1 + Real.sqrt (2 * Real.pi) * Real.exp (1 / 2 : ℝ)) +
        (Real.sqrt (2 * Real.pi))⁻¹ := by positivity
  nlinarith

/-- A shifted CDF sandwich converts to an ordinary pointwise CDF bound when
the comparison law has a Lipschitz CDF.  This is the order-theoretic step in
Esseen smoothing: the later Fourier argument only has to produce the two
shifted inequalities. -/
theorem cdfBound_of_shift_bounds
    (μ ν : Measure ℝ) {L δ ε : ℝ} (hδ : 0 ≤ δ)
    (hν : ∀ a b,
      |cdf ν b - cdf ν a| ≤ L * |b - a|)
    (hlower : ∀ x, cdf ν (x - δ) - ε ≤ cdf μ x)
    (hupper : ∀ x, cdf μ x ≤ cdf ν (x + δ) + ε) :
    CDFBound μ ν (ε + L * δ) := by
  intro x
  rw [cdfGap, abs_le]
  have hleft := hν (x - δ) x
  have hright := hν x (x + δ)
  have hleft' : cdf ν x - cdf ν (x - δ) ≤ L * δ := by
    calc
      cdf ν x - cdf ν (x - δ) ≤
          |cdf ν x - cdf ν (x - δ)| := le_abs_self _
      _ ≤ L * |x - (x - δ)| := hleft
      _ = L * δ := by
        rw [show x - (x - δ) = δ by ring, abs_of_nonneg hδ]
  have hright' : cdf ν (x + δ) - cdf ν x ≤ L * δ := by
    calc
      cdf ν (x + δ) - cdf ν x ≤
          |cdf ν (x + δ) - cdf ν x| := le_abs_self _
      _ ≤ L * |(x + δ) - x| := hright
      _ = L * δ := by
        rw [show (x + δ) - x = δ by ring, abs_of_nonneg hδ]
  constructor
  · linarith [hlower x]
  · linarith [hupper x]

/-- The shifted-sandwich reduction specialized to the standard-normal target.
It isolates the remaining Fourier-analytic part of the Berry--Esseen proof
from the already certified Gaussian-density regularity. -/
theorem standardNormalCDFBound_of_shift_bounds
    (μ : Measure ℝ) {δ ε : ℝ} (hδ : 0 ≤ δ)
    (hlower : ∀ x,
      cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (x - δ) - ε ≤
        cdf μ x)
    (hupper : ∀ x,
      cdf μ x ≤
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (x + δ) + ε) :
    CDFBound μ NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      (ε + (Real.sqrt (2 * Real.pi))⁻¹ * δ) :=
  cdfBound_of_shift_bounds μ
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hδ
    standardNormalCDF_lipschitz hlower hupper

/-- Supremum-form consequence of `standardNormalCDFBound_of_shift_bounds`. -/
theorem kolmogorovDistance_standardNormal_le_of_shift_bounds
    (μ : Measure ℝ) {δ ε : ℝ} (hδ : 0 ≤ δ)
    (hlower : ∀ x,
      cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (x - δ) - ε ≤
        cdf μ x)
    (hupper : ∀ x,
      cdf μ x ≤
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (x + δ) + ε) :
    kolmogorovDistance μ
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      ε + (Real.sqrt (2 * Real.pi))⁻¹ * δ :=
  (kolmogorovDistance_le_iff _ _ _).2 <|
    standardNormalCDFBound_of_shift_bounds μ hδ hlower hupper

/-- A function `H` is a `δ`-smoothing of the CDF of `μ` when its value at
`x` lies between the CDF values at the two endpoints of the `δ`-window about
`x`.  Compactly supported convolution kernels will supply this property. -/
def CDFSmoothingApproximation
    (μ : Measure ℝ) (H : ℝ → ℝ) (δ : ℝ) : Prop :=
  ∀ x, cdf μ (x - δ) ≤ H x ∧ H x ≤ cdf μ (x + δ)

/-- Average the translates of a CDF against a smoothing measure. -/
noncomputable def smoothedCDF
    (μ κ : Measure ℝ) (x : ℝ) : ℝ :=
  ∫ y, cdf μ (x - y) ∂κ

/-- A measure is supported in the closed smoothing window `[-δ, δ]`, stated
in the almost-everywhere form used directly by integration. -/
def IsSupportedInSmoothingWindow (κ : Measure ℝ) (δ : ℝ) : Prop :=
  ∀ᵐ y ∂κ, y ∈ Icc (-δ) δ

/-- The normalized Lebesgue probability measure on `[-δ, δ]`.  It is used
as a concrete compact smoothing kernel when `δ > 0`. -/
noncomputable def uniformSmoothingKernel (δ : ℝ) : Measure ℝ :=
  (ENNReal.ofReal (2 * δ))⁻¹ • volume.restrict (Icc (-δ) δ)

theorem uniformSmoothingKernel_isProbabilityMeasure
    {δ : ℝ} (hδ : 0 < δ) :
    IsProbabilityMeasure (uniformSmoothingKernel δ) := by
  constructor
  rw [uniformSmoothingKernel, Measure.smul_apply, Measure.restrict_apply
    MeasurableSet.univ, univ_inter, Real.volume_Icc]
  have htwo : 0 < 2 * δ := mul_pos (by norm_num) hδ
  rw [show δ - -δ = 2 * δ by ring, smul_eq_mul,
    ENNReal.inv_mul_cancel]
  · exact (ENNReal.ofReal_pos.mpr htwo).ne'
  · exact ENNReal.ofReal_ne_top

theorem uniformSmoothingKernel_supported
    (δ : ℝ) :
    IsSupportedInSmoothingWindow (uniformSmoothingKernel δ) δ := by
  unfold IsSupportedInSmoothingWindow uniformSmoothingKernel
  exact Measure.ae_smul_measure
    (ae_restrict_mem measurableSet_Icc) _

/-- The characteristic function of the normalized uniform kernel is `sinc`.
This is the explicit Fourier multiplier used by the smoothing construction. -/
theorem charFun_uniformSmoothingKernel
    {δ : ℝ} (hδ : 0 < δ) (t : ℝ) :
    MeasureTheory.charFun (uniformSmoothingKernel δ) t =
      Real.sinc (t * δ) := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel δ) :=
    uniformSmoothingKernel_isProbabilityMeasure hδ
  by_cases ht : t = 0
  · subst t
    simp
  rw [MeasureTheory.charFun_apply_real, uniformSmoothingKernel,
    integral_smul_measure, ENNReal.toReal_inv]
  have htwo : 0 < 2 * δ := mul_pos (by norm_num) hδ
  rw [ENNReal.toReal_ofReal htwo.le]
  have hscale :
      (∫ x in -δ..δ,
          Complex.exp ((t : ℂ) * (x : ℂ) * Complex.I)) =
        t⁻¹ •
          ∫ u in -(t * δ)..t * δ, Complex.exp (u * Complex.I) := by
    simpa only [Complex.ofReal_mul, mul_neg] using
      (intervalIntegral.integral_comp_mul_left
        (f := fun u : ℝ => Complex.exp ((u : ℂ) * Complex.I))
        (a := -δ) (b := δ) ht)
  have hset :
      (∫ x in Icc (-δ) δ,
          Complex.exp ((t : ℂ) * (x : ℂ) * Complex.I)) =
        ∫ x in -δ..δ, Complex.exp ((t : ℂ) * (x : ℂ) * Complex.I) := by
    rw [integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le (neg_le_self hδ.le)]
  rw [hset, hscale, integral_exp_mul_I_eq_sinc]
  simp only [Algebra.smul_def]
  change (((2 * δ)⁻¹ : ℝ) : ℂ) *
      (((t⁻¹ : ℝ) : ℂ) *
        (2 * (((t * δ : ℝ) : ℂ)) * ((Real.sinc (t * δ) : ℝ) : ℂ))) =
    ((Real.sinc (t * δ) : ℝ) : ℂ)
  norm_cast
  field_simp

theorem abs_sinc_le_inv_abs {x : ℝ} (hx : x ≠ 0) :
    |Real.sinc x| ≤ |x|⁻¹ := by
  rw [Real.sinc_of_ne_zero hx, abs_div]
  simpa only [one_div] using
    div_le_div_of_nonneg_right (Real.abs_sin_le_one x) (abs_nonneg x)

/-- A CDF composed with a measurable real function is integrable against
every finite measure, by the universal bound `0 ≤ cdf ≤ 1`. -/
theorem integrable_cdf_comp
    (mu kappa : Measure ℝ) [IsFiniteMeasure kappa]
    {f : ℝ → ℝ} (hf : Measurable f) :
    Integrable (fun y => cdf mu (f y)) kappa := by
  refine Integrable.of_bound
    (((monotone_cdf mu).measurable.comp hf).aestronglyMeasurable) 1 ?_
  exact ae_of_all kappa fun y => by
    rw [Real.norm_eq_abs, abs_of_nonneg (cdf_nonneg mu (f y))]
    exact cdf_le_one mu (f y)

theorem integrable_cdf_translate
    (μ κ : Measure ℝ) [IsFiniteMeasure κ] (x : ℝ) :
    Integrable (fun y => cdf μ (x - y)) κ := by
  refine Integrable.of_bound
    (((monotone_cdf μ).measurable.comp
      (measurable_const.sub measurable_id)).aestronglyMeasurable) 1 ?_
  exact ae_of_all κ fun y => by
    rw [Real.norm_eq_abs, abs_of_nonneg (cdf_nonneg μ (x - y))]
    exact cdf_le_one μ (x - y)

/-- Averaging an upper signed CDF error against a probability law costs no
constant: the integral is bounded by the same one-sided supremum. -/
theorem integral_cdfUpperError_comp_le
    (mu nu kappa : Measure ℝ) [IsProbabilityMeasure kappa]
    {f : ℝ → ℝ} (hf : Measurable f) :
    (∫ y, cdfUpperError mu nu (f y) ∂kappa) ≤
      upperCDFDistance mu nu := by
  have hmu := integrable_cdf_comp mu kappa hf
  have hnu := integrable_cdf_comp nu kappa hf
  calc
    (∫ y, cdfUpperError mu nu (f y) ∂kappa) ≤
        ∫ _y, upperCDFDistance mu nu ∂kappa := by
      apply integral_mono (hmu.sub hnu) (integrable_const _)
      intro y
      exact cdfUpperError_le_upperCDFDistance mu nu (f y)
    _ = upperCDFDistance mu nu := by simp

/-- Lower signed-error companion to `integral_cdfUpperError_comp_le`. -/
theorem integral_cdfLowerError_comp_le
    (mu nu kappa : Measure ℝ) [IsProbabilityMeasure kappa]
    {f : ℝ → ℝ} (hf : Measurable f) :
    (∫ y, cdfLowerError mu nu (f y) ∂kappa) ≤
      lowerCDFDistance mu nu := by
  have hmu := integrable_cdf_comp mu kappa hf
  have hnu := integrable_cdf_comp nu kappa hf
  calc
    (∫ y, cdfLowerError mu nu (f y) ∂kappa) ≤
        ∫ _y, lowerCDFDistance mu nu ∂kappa := by
      apply integral_mono (hnu.sub hmu) (integrable_const _)
      intro y
      exact cdfLowerError_le_lowerCDFDistance mu nu (f y)
    _ = lowerCDFDistance mu nu := by simp

/-- Averaging against a probability measure supported in `[-δ, δ]` gives
the promised CDF smoothing approximation.  This supplies the compact-support
half of the smoothing method independently of any Fourier representation. -/
theorem smoothedCDF_isSmoothingApproximation
    (μ κ : Measure ℝ) [IsProbabilityMeasure κ] {δ : ℝ}
    (hκ : IsSupportedInSmoothingWindow κ δ) :
    CDFSmoothingApproximation μ (smoothedCDF μ κ) δ := by
  intro x
  have hInt : Integrable (fun y => cdf μ (x - y)) κ :=
    integrable_cdf_translate μ κ x
  constructor
  · rw [smoothedCDF]
    calc
      cdf μ (x - δ) = ∫ _ : ℝ, cdf μ (x - δ) ∂κ := by simp
      _ ≤ ∫ y, cdf μ (x - y) ∂κ :=
        integral_mono_ae (integrable_const _) hInt <|
          hκ.mono fun y hy =>
            monotone_cdf μ (by linarith [hy.2])
  · rw [smoothedCDF]
    calc
      (∫ y, cdf μ (x - y) ∂κ) ≤
          ∫ _ : ℝ, cdf μ (x + δ) ∂κ :=
        integral_mono_ae hInt (integrable_const _) <|
          hκ.mono fun y hy =>
            monotone_cdf μ (by linarith [hy.1])
      _ = cdf μ (x + δ) := by simp

/-- The concrete normalized-uniform kernel realizes the abstract smoothing
interface at every positive window radius. -/
theorem uniformSmoothedCDF_isSmoothingApproximation
    (μ : Measure ℝ) {δ : ℝ} (hδ : 0 < δ) :
    CDFSmoothingApproximation μ
      (smoothedCDF μ (uniformSmoothingKernel δ)) δ := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel δ) :=
    uniformSmoothingKernel_isProbabilityMeasure hδ
  exact smoothedCDF_isSmoothingApproximation μ
    (uniformSmoothingKernel δ) (uniformSmoothingKernel_supported δ)

/-- Averaging CDF translates is exactly the CDF of convolution by the
smoothing measure.  This bridge exposes `MeasureTheory.charFun_conv` to the
remaining Fourier comparison. -/
theorem smoothedCDF_eq_cdf_conv
    (μ κ : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure κ]
    (x : ℝ) :
    smoothedCDF μ κ x = cdf (κ ∗ μ) x := by
  have hInt : Integrable
      ((Iic x).indicator (fun _ : ℝ => (1 : ℝ))) (κ ∗ μ) :=
    (integrable_const (1 : ℝ)).indicator measurableSet_Iic
  rw [smoothedCDF]
  calc
    (∫ y, cdf μ (x - y) ∂κ) =
        ∫ y, ∫ z, (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) (y + z) ∂μ ∂κ := by
      apply integral_congr_ae
      exact ae_of_all κ fun y => by
        change cdf μ (x - y) = _
        rw [cdf_eq_real]
        calc
          μ.real (Iic (x - y)) =
              ∫ z, (Iic (x - y)).indicator (fun _ : ℝ => (1 : ℝ)) z ∂μ :=
            (integral_indicator_one (s := Iic (x - y)) measurableSet_Iic).symm
          _ = ∫ z, (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) (y + z) ∂μ := by
            apply integral_congr_ae
            exact ae_of_all μ fun z => by
              simp only [Set.indicator_apply, mem_Iic]
              by_cases hz : z ≤ x - y
              · have hyz : y + z ≤ x := by linarith
                simp [hz, hyz]
              · have hyz : ¬ y + z ≤ x := by intro h; apply hz; linarith
                simp [hz, hyz]
    _ = ∫ z, (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) z ∂(κ ∗ μ) :=
      (integral_conv hInt).symm
    _ = cdf (κ ∗ μ) x := by
      calc
        (∫ z, (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) z ∂(κ ∗ μ)) =
            (κ ∗ μ).real (Iic x) :=
          integral_indicator_one (s := Iic x) measurableSet_Iic
        _ = cdf (κ ∗ μ) x := (cdf_eq_real (κ ∗ μ) x).symm

/-- Convolution by an arbitrary probability law preserves the global
Lipschitz constant of the standard-normal CDF. -/
theorem standardNormalCDF_lipschitz_conv
    (kappa : Measure ℝ) [IsProbabilityMeasure kappa] (u v : ℝ) :
    |cdf (kappa ∗
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) u -
        cdf (kappa ∗
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) v| ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * |u - v| := by
  rw [← smoothedCDF_eq_cdf_conv
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw kappa u,
    ← smoothedCDF_eq_cdf_conv
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw kappa v]
  unfold smoothedCDF
  rw [← integral_sub
    (integrable_cdf_translate
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw kappa u)
    (integrable_cdf_translate
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw kappa v)]
  calc
    |∫ y, (cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (u - y) -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (v - y)) ∂kappa| ≤
        ∫ y, |cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (u - y) -
          cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (v - y)| ∂kappa :=
      abs_integral_le_integral_abs
    _ ≤ ∫ _y : ℝ, (Real.sqrt (2 * Real.pi))⁻¹ * |u - v| ∂kappa := by
      apply integral_mono
      · exact (integrable_cdf_translate
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw kappa u).sub
          (integrable_cdf_translate
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw kappa v) |>.abs
      · exact integrable_const _
      · intro y
        simpa only [sub_sub_sub_cancel_right] using
          standardNormalCDF_lipschitz (v - y) (u - y)
    _ = (Real.sqrt (2 * Real.pi))⁻¹ * |u - v| := by simp

/-- Convolution by an arbitrary probability law preserves the uniform
quadratic remainder of a positive Gaussian-smoothed CDF section.  The three
polynomial coefficients are obtained by averaging their pointwise Gaussian
counterparts. -/
theorem exists_quadratic_remainder_cdf_conv_scaledStandardNormal
    (kappa : Measure ℝ) [IsProbabilityMeasure kappa]
    {σ : ℝ} (hσ : 0 < σ) (a : ℝ) :
    ∃ a0 a1 a2 : ℝ, ∀ y : ℝ,
      |cdf (kappa ∗ Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) (a + y) -
          (a0 + a1 * y + a2 * y ^ 2)| ≤
        (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6) * |y| ^ 3 := by
  let gamma : Measure ℝ := Measure.map (fun z : ℝ => σ * z)
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  letI : IsProbabilityMeasure gamma := Measure.isProbabilityMeasure_map (by fun_prop)
  let c0 : ℝ → ℝ := fun z => cdf gamma (a - z)
  let c1 : ℝ → ℝ := fun z =>
    ProbabilityTheory.gaussianPDFReal 0 1 ((a - z) / σ) / σ
  let c2 : ℝ → ℝ := fun z =>
    (-((a - z) / σ) *
      ProbabilityTheory.gaussianPDFReal 0 1 ((a - z) / σ)) / (2 * σ ^ 2)
  have hc0 : Integrable c0 kappa := by
    simpa only [c0] using integrable_cdf_translate gamma kappa a
  have hc1 : Integrable c1 kappa := by
    have harg : Measurable (fun z : ℝ => (a - z) / σ) := by fun_prop
    have hmeas := (ProbabilityTheory.measurable_gaussianPDFReal 0 1).comp harg
    refine Integrable.of_bound (by
      simpa only [c1] using (hmeas.div_const σ).aestronglyMeasurable)
      ((Real.sqrt (2 * Real.pi))⁻¹ / σ) ?_
    exact ae_of_all kappa fun z => by
      rw [Real.norm_eq_abs, abs_div, abs_of_pos hσ,
        abs_of_nonneg (ProbabilityTheory.gaussianPDFReal_nonneg 0 1 _)]
      exact div_le_div_of_nonneg_right (standardNormalPDF_le _) hσ.le
  have hc2 : Integrable c2 kappa := by
    have harg : Measurable (fun z : ℝ => (a - z) / σ) := by fun_prop
    have hpdf := (ProbabilityTheory.measurable_gaussianPDFReal 0 1).comp harg
    refine Integrable.of_bound (by
      simpa only [c2] using
        ((harg.neg.mul hpdf).div_const (2 * σ ^ 2)).aestronglyMeasurable)
      ((2 * (Real.sqrt (2 * Real.pi))⁻¹) / |2 * σ ^ 2|) ?_
    exact ae_of_all kappa fun z => by
      rw [Real.norm_eq_abs, abs_div]
      exact div_le_div_of_nonneg_right
        (abs_standardNormalPDF_deriv_le _) (abs_nonneg _)
  refine ⟨∫ z, c0 z ∂kappa, ∫ z, c1 z ∂kappa, ∫ z, c2 z ∂kappa, ?_⟩
  intro y
  have hf : Integrable (fun z => cdf gamma (a + y - z)) kappa :=
    integrable_cdf_translate gamma kappa (a + y)
  have hc1y : Integrable (fun z => c1 z * y) kappa := by
    simpa only [mul_comm] using hc1.const_mul y
  have hc2y : Integrable (fun z => c2 z * y ^ 2) kappa := by
    simpa only [mul_comm] using hc2.const_mul (y ^ 2)
  have hp : Integrable (fun z => c0 z + c1 z * y + c2 z * y ^ 2) kappa :=
    (hc0.add hc1y).add hc2y
  have hpoint : ∀ z,
      |cdf gamma (a + y - z) - (c0 z + c1 z * y + c2 z * y ^ 2)| ≤
        (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6) * |y| ^ 3 := by
    intro z
    simpa only [gamma, c0, c1, c2] using
      (show |cdf (Measure.map (fun z : ℝ => σ * z)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) (a + y - z) -
          (cdf (Measure.map (fun z : ℝ => σ * z)
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) (a - z) +
            (ProbabilityTheory.gaussianPDFReal 0 1 ((a - z) / σ) / σ) * y +
            ((-((a - z) / σ) *
                ProbabilityTheory.gaussianPDFReal 0 1 ((a - z) / σ)) /
              (2 * σ ^ 2)) * y ^ 2)| ≤
            (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6) * |y| ^ 3 by
        convert scaledStandardNormalCDF_quadratic_remainder_canonical hσ (a - z) y using 1
        ring)
  rw [← smoothedCDF_eq_cdf_conv gamma kappa (a + y)]
  unfold smoothedCDF
  have hpoly :
      (∫ z, c0 z + c1 z * y + c2 z * y ^ 2 ∂kappa) =
        (∫ z, c0 z ∂kappa) + (∫ z, c1 z ∂kappa) * y +
          (∫ z, c2 z ∂kappa) * y ^ 2 := by
    calc
      (∫ z, c0 z + c1 z * y + c2 z * y ^ 2 ∂kappa) =
          (∫ z, c0 z + c1 z * y ∂kappa) +
            ∫ z, c2 z * y ^ 2 ∂kappa :=
        integral_add (hc0.add hc1y) hc2y
      _ = ((∫ z, c0 z ∂kappa) + ∫ z, c1 z * y ∂kappa) +
          ∫ z, c2 z * y ^ 2 ∂kappa := by
        rw [integral_add hc0 hc1y]
      _ = _ := by rw [integral_mul_const, integral_mul_const]
  rw [← hpoly, ← integral_sub hf hp]
  calc
    |∫ z, cdf gamma (a + y - z) -
        (c0 z + c1 z * y + c2 z * y ^ 2) ∂kappa| ≤
        ∫ z, |cdf gamma (a + y - z) -
          (c0 z + c1 z * y + c2 z * y ^ 2)| ∂kappa :=
      abs_integral_le_integral_abs
    _ ≤ ∫ _z : ℝ,
        (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6) * |y| ^ 3 ∂kappa := by
      apply integral_mono (hf.sub hp).abs (integrable_const _)
      exact hpoint
    _ = (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6) * |y| ^ 3 := by
      simp

/-- Gaussian smoothing makes the one-summand replacement section smooth
enough for exact first/second-moment cancellation. -/
theorem abs_integral_cdf_conv_scaledStandardNormal_sub_standardNormal_le
    (kappa mu : Measure ℝ)
    [IsProbabilityMeasure kappa] [IsProbabilityMeasure mu]
    {σ : ℝ} (hσ : 0 < σ) (a : ℝ)
    (hmu1 : Integrable (fun y : ℝ => y) mu)
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu)
    (hmean : (∫ y, y ∂mu) = 0)
    (hsecond : (∫ y, y ^ 2 ∂mu) = 1)
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu) :
    |(∫ y, cdf (kappa ∗ Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) (a + y) ∂mu) -
        ∫ y, cdf (kappa ∗ Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) (a + y)
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw| ≤
      (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6) *
        ((∫ y, |y| ^ 3 ∂mu) +
          ∫ y, |y| ^ 3
            ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
  let gamma : Measure ℝ := Measure.map (fun z : ℝ => σ * z)
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  letI : IsProbabilityMeasure gamma := Measure.isProbabilityMeasure_map (by fun_prop)
  let f : ℝ → ℝ := fun y => cdf (kappa ∗ gamma) (a + y)
  have hfmu : Integrable f mu := by
    exact integrable_cdf_comp (kappa ∗ gamma) mu
      (f := fun y : ℝ => a + y) (by fun_prop)
  have hfGaussian : Integrable f
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
    exact integrable_cdf_comp (kappa ∗ gamma)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      (f := fun y : ℝ => a + y) (by fun_prop)
  obtain ⟨a0, a1, a2, hrem⟩ :=
    exists_quadratic_remainder_cdf_conv_scaledStandardNormal kappa hσ a
  simpa only [gamma, f] using
    abs_integral_sub_standardNormal_le_of_quadratic_remainder
      mu f hfmu hfGaussian hmu1 hmu2 hmean hsecond hmu3
      a0 a1 a2 ((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) hrem

/-- Subtraction-oriented form of the convolved Gaussian Taylor remainder,
matching the `x - y` convention in convolution CDF formulas. -/
theorem exists_quadratic_remainder_cdf_conv_scaledStandardNormal_sub
    (kappa : Measure ℝ) [IsProbabilityMeasure kappa]
    {σ : ℝ} (hσ : 0 < σ) (a : ℝ) :
    ∃ a0 a1 a2 : ℝ, ∀ y : ℝ,
      |cdf (kappa ∗ Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) (a - y) -
          (a0 + a1 * y + a2 * y ^ 2)| ≤
        (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6) * |y| ^ 3 := by
  obtain ⟨a0, a1, a2, hrem⟩ :=
    exists_quadratic_remainder_cdf_conv_scaledStandardNormal kappa hσ a
  refine ⟨a0, -a1, a2, fun y => ?_⟩
  convert hrem (-y) using 1 <;> simp only [abs_neg, neg_sq]; ring

theorem abs_integral_cdf_conv_scaledStandardNormal_sub_standardNormal_le_sub
    (kappa mu : Measure ℝ)
    [IsProbabilityMeasure kappa] [IsProbabilityMeasure mu]
    {σ : ℝ} (hσ : 0 < σ) (a : ℝ)
    (hmu1 : Integrable (fun y : ℝ => y) mu)
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu)
    (hmean : (∫ y, y ∂mu) = 0)
    (hsecond : (∫ y, y ^ 2 ∂mu) = 1)
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu) :
    |(∫ y, cdf (kappa ∗ Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) (a - y) ∂mu) -
        ∫ y, cdf (kappa ∗ Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) (a - y)
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw| ≤
      (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6) *
        ((∫ y, |y| ^ 3 ∂mu) +
          ∫ y, |y| ^ 3
            ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
  let gamma : Measure ℝ := Measure.map (fun z : ℝ => σ * z)
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  letI : IsProbabilityMeasure gamma := Measure.isProbabilityMeasure_map (by fun_prop)
  let f : ℝ → ℝ := fun y => cdf (kappa ∗ gamma) (a - y)
  have hfmu : Integrable f mu := by
    exact integrable_cdf_comp (kappa ∗ gamma) mu
      (f := fun y : ℝ => a - y) (by fun_prop)
  have hfGaussian : Integrable f
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
    exact integrable_cdf_comp (kappa ∗ gamma)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      (f := fun y : ℝ => a - y) (by fun_prop)
  obtain ⟨a0, a1, a2, hrem⟩ :=
    exists_quadratic_remainder_cdf_conv_scaledStandardNormal_sub kappa hσ a
  simpa only [gamma, f] using
    abs_integral_sub_standardNormal_le_of_quadratic_remainder
      mu f hfmu hfGaussian hmu1 hmu2 hmean hsecond hmu3
      a0 a1 a2 ((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) hrem

/-- Pointwise signed one-summand replacement after a common arbitrary-law
and positive-Gaussian smoothing factor. -/
theorem abs_cdfUpperError_gaussianSmoothedReplacement_le
    (kappa mu : Measure ℝ)
    [IsProbabilityMeasure kappa] [IsProbabilityMeasure mu]
    {σ : ℝ} (hσ : 0 < σ) (x : ℝ)
    (hmu1 : Integrable (fun y : ℝ => y) mu)
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu)
    (hmean : (∫ y, y ∂mu) = 0)
    (hsecond : (∫ y, y ^ 2 ∂mu) = 1)
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu) :
    |cdfUpperError
        (mu ∗ (kappa ∗ Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw))
        (NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ∗
          (kappa ∗ Measure.map (fun z : ℝ => σ * z)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)) x| ≤
      (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6) *
        ((∫ y, |y| ^ 3 ∂mu) +
          ∫ y, |y| ^ 3
            ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
  let gamma : Measure ℝ := Measure.map (fun z : ℝ => σ * z)
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  letI : IsProbabilityMeasure gamma := Measure.isProbabilityMeasure_map (by fun_prop)
  have h := abs_integral_cdf_conv_scaledStandardNormal_sub_standardNormal_le_sub
    kappa mu hσ x hmu1 hmu2 hmean hsecond hmu3
  rw [cdfUpperError, ← smoothedCDF_eq_cdf_conv (kappa ∗ gamma) mu x,
    ← smoothedCDF_eq_cdf_conv (kappa ∗ gamma)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x]
  simpa only [smoothedCDF, gamma] using h

/-- A common convolution factor averages the signed upper CDF error exactly.
This identity retains cancellations that are lost after taking absolute
values or a concentration supremum. -/
theorem cdfUpperError_conv_left_eq_integral
    (mu nu kappa : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    [IsProbabilityMeasure kappa] (x : ℝ) :
    cdfUpperError (kappa ∗ mu) (kappa ∗ nu) x =
      ∫ y, cdfUpperError mu nu (x - y) ∂kappa := by
  rw [cdfUpperError, ← smoothedCDF_eq_cdf_conv mu kappa x,
    ← smoothedCDF_eq_cdf_conv nu kappa x]
  unfold smoothedCDF cdfUpperError
  rw [integral_sub (integrable_cdf_translate mu kappa x)
    (integrable_cdf_translate nu kappa x)]

/-- The corresponding exact averaging identity for the signed lower CDF
error. -/
theorem cdfLowerError_conv_left_eq_integral
    (mu nu kappa : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    [IsProbabilityMeasure kappa] (x : ℝ) :
    cdfLowerError (kappa ∗ mu) (kappa ∗ nu) x =
      ∫ y, cdfLowerError mu nu (x - y) ∂kappa := by
  simpa only [cdfLowerError_eq_upper_swap] using
    cdfUpperError_conv_left_eq_integral nu mu kappa x

/-- Two spatial cancellations turn convolution by a positively scaled
standard normal into a second-order weighted pointwise bound for the upper
signed CDF error. -/
theorem abs_cdfUpperError_map_mul_standardNormal_conv_le_of_cancellations
    (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {σ : ℝ} (hσ : 0 < σ)
    (he : Integrable (cdfUpperError mu nu))
    (he1 : Integrable (fun z => z * cdfUpperError mu nu z))
    (he2 : Integrable (fun z => |z| ^ 2 * |cdfUpperError mu nu z|))
    (hzero : (∫ z, cdfUpperError mu nu z) = 0)
    (hone : (∫ z, z * cdfUpperError mu nu z) = 0)
    (x : ℝ) :
    |cdfUpperError
      (Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ∗ mu)
      (Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ∗ nu) x| ≤
      (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) / σ ^ 3) *
        ∫ z, |z| ^ 2 * |cdfUpperError mu nu z| := by
  let kappa := Measure.map (fun z : ℝ => σ * z)
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  letI : IsProbabilityMeasure kappa :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  have hmeas : Measurable (cdfUpperError mu nu) :=
    (monotone_cdf mu).measurable.sub (monotone_cdf nu).measurable
  rw [cdfUpperError_conv_left_eq_integral]
  rw [integral_comp_sub_map_mul_standardNormalLaw_eq_integral_scaledPDF
    (cdfUpperError mu nu) hmeas hσ x]
  exact abs_integral_scaledStandardNormalPDF_mul_le_of_cancellations
    (cdfUpperError mu nu) he he1 he2 hzero hone hσ x

/-- Lower signed-error companion to the scaled-normal cancellation bound. -/
theorem abs_cdfLowerError_map_mul_standardNormal_conv_le_of_cancellations
    (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {σ : ℝ} (hσ : 0 < σ)
    (he : Integrable (cdfLowerError mu nu))
    (he1 : Integrable (fun z => z * cdfLowerError mu nu z))
    (he2 : Integrable (fun z => |z| ^ 2 * |cdfLowerError mu nu z|))
    (hzero : (∫ z, cdfLowerError mu nu z) = 0)
    (hone : (∫ z, z * cdfLowerError mu nu z) = 0)
    (x : ℝ) :
    |cdfLowerError
      (Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ∗ mu)
      (Measure.map (fun z : ℝ => σ * z)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ∗ nu) x| ≤
      (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) / σ ^ 3) *
        ∫ z, |z| ^ 2 * |cdfLowerError mu nu z| := by
  simpa only [cdfLowerError_eq_upper_swap] using
    abs_cdfUpperError_map_mul_standardNormal_conv_le_of_cancellations
      nu mu hσ
      (by simpa only [cdfLowerError_eq_upper_swap] using he)
      (by simpa only [cdfLowerError_eq_upper_swap] using he1)
      (by simpa only [cdfLowerError_eq_upper_swap] using he2)
      (by simpa only [cdfLowerError_eq_upper_swap] using hzero)
      (by simpa only [cdfLowerError_eq_upper_swap] using hone) x

/-- A centered Gaussian density is bounded by its value at the mean. -/
theorem gaussianPDFReal_zero_le_peak
    {v : ℝ≥0} (hv : v ≠ 0) (y : ℝ) :
    ProbabilityTheory.gaussianPDFReal 0 v y ≤
      (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ := by
  rw [ProbabilityTheory.gaussianPDFReal]
  calc
    (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ *
        Real.exp (-(y - 0) ^ 2 / (2 * (v : ℝ))) ≤
        (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ * 1 := by
      apply mul_le_mul_of_nonneg_left _
        (inv_nonneg.mpr (Real.sqrt_nonneg _))
      rw [Real.exp_le_one_iff]
      exact div_nonpos_of_nonpos_of_nonneg
        (neg_nonpos.mpr (sq_nonneg (y - 0))) (by positivity)
    _ = (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ := mul_one _

/-- Convolution by a centered nondegenerate Gaussian maps the spatial `L¹`
norm of an upper signed CDF error to a pointwise bound using the exact peak
of the Gaussian density. -/
theorem abs_cdfUpperError_gaussianReal_conv_le_integral
    (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {v : ℝ≥0} (hv : v ≠ 0)
    (he : Integrable (cdfUpperError mu nu)) (x : ℝ) :
    |cdfUpperError
        (ProbabilityTheory.gaussianReal 0 v ∗ mu)
        (ProbabilityTheory.gaussianReal 0 v ∗ nu) x| ≤
      (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ *
        ∫ z, |cdfUpperError mu nu z| := by
  let kappa := ProbabilityTheory.gaussianReal 0 v
  letI : IsProbabilityMeasure kappa := inferInstance
  let C : ℝ := (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹
  let e : ℝ → ℝ := cdfUpperError mu nu
  have heTrans : Integrable (fun y => |e (x - y)|) := by
    have h := (he.norm.comp_add_right x).comp_neg
    simpa only [e, sub_eq_add_neg, add_comm, Real.norm_eq_abs] using h
  have htrans : (∫ y, |e (x - y)|) = ∫ z, |e z| := by
    calc
      (∫ y, |e (x - y)|) = ∫ y, |e (-y + x)| := by
        congr 1
        funext y
        congr 2
        ring
      _ = ∫ y, |e (y + x)| :=
        MeasureTheory.integral_neg_eq_self (fun y => |e (y + x)|) volume
      _ = ∫ z, |e z| :=
        MeasureTheory.integral_add_right_eq_self (fun z => |e z|) x
  have hpdfProd : Integrable (fun y =>
      ProbabilityTheory.gaussianPDFReal 0 v y * |e (x - y)|) := by
    apply heTrans.bdd_mul
    · exact (ProbabilityTheory.measurable_gaussianPDFReal 0 v).aestronglyMeasurable
    · exact ae_of_all _ fun y => by
        rw [Real.norm_eq_abs, abs_of_nonneg
          (ProbabilityTheory.gaussianPDFReal_nonneg 0 v y)]
        exact gaussianPDFReal_zero_le_peak hv y
  have hCTrans : Integrable (fun y => C * |e (x - y)|) :=
    heTrans.const_mul C
  rw [cdfUpperError_conv_left_eq_integral]
  calc
    |∫ y, e (x - y) ∂kappa| ≤ ∫ y, |e (x - y)| ∂kappa := by
      simpa only [Real.norm_eq_abs] using
        (norm_integral_le_integral_norm (fun y => e (x - y)) (μ := kappa))
    _ = ∫ y, ProbabilityTheory.gaussianPDFReal 0 v y *
        |e (x - y)| := by
      rw [ProbabilityTheory.integral_gaussianReal_eq_integral_smul hv]
      simp only [smul_eq_mul]
    _ ≤ ∫ y, C * |e (x - y)| := by
      apply integral_mono hpdfProd hCTrans
      intro y
      exact mul_le_mul_of_nonneg_right
        (gaussianPDFReal_zero_le_peak hv y) (abs_nonneg _)
    _ = C * ∫ z, |e z| := by rw [integral_const_mul, htrans]

/-- Lower signed-error companion to the Gaussian `L¹ -> L∞` estimate. -/
theorem abs_cdfLowerError_gaussianReal_conv_le_integral
    (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {v : ℝ≥0} (hv : v ≠ 0)
    (he : Integrable (cdfLowerError mu nu)) (x : ℝ) :
    |cdfLowerError
        (ProbabilityTheory.gaussianReal 0 v ∗ mu)
        (ProbabilityTheory.gaussianReal 0 v ∗ nu) x| ≤
      (Real.sqrt (2 * Real.pi * (v : ℝ)))⁻¹ *
        ∫ z, |cdfLowerError mu nu z| := by
  simpa only [cdfLowerError_eq_upper_swap] using
    abs_cdfUpperError_gaussianReal_conv_le_integral nu mu hv
      (by simpa only [cdfLowerError_eq_upper_swap] using he) x

/-- Coefficient of the preceding normalized sum in one Gaussian replacement
step. -/
noncomputable def normalizedGaussianKeepCoefficient (N : ℕ) : ℝ :=
  Real.sqrt (N + 1 : ℝ) * (Real.sqrt (N + 2 : ℝ))⁻¹

/-- Coefficient of the fresh standard Gaussian in one normalized replacement
step. -/
noncomputable def normalizedGaussianInnovationCoefficient (N : ℕ) : ℝ :=
  (Real.sqrt (N + 2 : ℝ))⁻¹

/-- One Gaussian-stationary keep/innovation step applied to a real
probability law. -/
noncomputable def normalizedGaussianStepLaw (N : ℕ) (nu : Measure ℝ) : Measure ℝ :=
  Measure.map
      (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ∗
    Measure.map (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu

theorem normalizedGaussianKeepCoefficient_pos (N : ℕ) :
    0 < normalizedGaussianKeepCoefficient N := by
  unfold normalizedGaussianKeepCoefficient
  positivity

theorem normalizedGaussianInnovationCoefficient_pos (N : ℕ) :
    0 < normalizedGaussianInnovationCoefficient N := by
  unfold normalizedGaussianInnovationCoefficient
  positivity

/-- The Gaussian density peak and keep-coordinate Jacobian simplify to the
closed coefficient used by the normalized smoothing estimate. -/
theorem normalizedGaussianDensityPeak_mul_keep (N : ℕ) :
    (Real.sqrt (2 * Real.pi *
      normalizedGaussianInnovationCoefficient N ^ 2))⁻¹ *
        normalizedGaussianKeepCoefficient N =
      Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹ := by
  rw [show 2 * Real.pi * normalizedGaussianInnovationCoefficient N ^ 2 =
      (2 * Real.pi) * normalizedGaussianInnovationCoefficient N ^ 2 by ring,
    Real.sqrt_mul (by positivity : (0 : ℝ) ≤ 2 * Real.pi),
    Real.sqrt_sq_eq_abs,
    abs_of_pos (normalizedGaussianInnovationCoefficient_pos N)]
  unfold normalizedGaussianKeepCoefficient normalizedGaussianInnovationCoefficient
  field_simp

/-- Exact simplification of the second-order cancellation coefficient: the
cubic keep Jacobian cancels the cubic innovation denominator, leaving the
three-halves power of the preceding sample count. -/
theorem normalizedGaussianCancellationCoefficient (N : ℕ) :
    (((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) /
        normalizedGaussianInnovationCoefficient N ^ 3) *
      normalizedGaussianKeepCoefficient N ^ 3 =
    ((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) *
      (Real.sqrt (N + 1 : ℝ)) ^ 3 := by
  unfold normalizedGaussianKeepCoefficient normalizedGaussianInnovationCoefficient
  field_simp

theorem normalizedGaussianCoefficients_sq_add (N : ℕ) :
    normalizedGaussianKeepCoefficient N ^ 2 +
        normalizedGaussianInnovationCoefficient N ^ 2 = 1 := by
  unfold normalizedGaussianKeepCoefficient normalizedGaussianInnovationCoefficient
  rw [mul_pow, inv_pow,
    Real.sq_sqrt (by positivity : (0 : ℝ) ≤ N + 1),
    Real.sq_sqrt (by positivity : (0 : ℝ) ≤ N + 2)]
  field_simp
  ring

/-- Integrability of the identity is preserved by scalar pushforward. -/
theorem integrable_id_map_mul_real (mu : Measure ℝ) (c : ℝ)
    (hmu1 : Integrable (fun y : ℝ => y) mu) :
    Integrable (fun y : ℝ => y) (Measure.map (fun z : ℝ => c * z) mu) := by
  rw [integrable_map_measure (by fun_prop) (by fun_prop)]
  simpa only [Function.comp_apply] using hmu1.const_mul c

/-- The first moment of a scalar pushforward. -/
theorem integral_id_map_mul_real (mu : Measure ℝ) (c : ℝ) :
    (∫ y : ℝ, y ∂Measure.map (fun z : ℝ => c * z) mu) = c * ∫ y, y ∂mu := by
  rw [integral_map (by fun_prop) (by fun_prop), integral_const_mul]

/-- Integrability of the square is preserved by scalar pushforward. -/
theorem integrable_sq_map_mul_real (mu : Measure ℝ) (c : ℝ)
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu) :
    Integrable (fun y : ℝ => y ^ 2) (Measure.map (fun z : ℝ => c * z) mu) := by
  rw [integrable_map_measure (by fun_prop) (by fun_prop)]
  change Integrable (fun z : ℝ => (c * z) ^ 2) mu
  simpa only [mul_pow] using hmu2.const_mul (c ^ 2)

/-- The second moment of a scalar pushforward. -/
theorem integral_sq_map_mul_real (mu : Measure ℝ) (c : ℝ) :
    (∫ y : ℝ, y ^ 2 ∂Measure.map (fun z : ℝ => c * z) mu) =
      c ^ 2 * ∫ y, y ^ 2 ∂mu := by
  rw [integral_map (by fun_prop) (by fun_prop)]
  simp only [mul_pow]
  rw [integral_const_mul]

/-- Integrability of the third absolute moment is preserved by scalar
pushforward. -/
theorem integrable_abs_cube_map_mul_real (mu : Measure ℝ) (c : ℝ)
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu) :
    Integrable (fun y : ℝ => |y| ^ 3) (Measure.map (fun z : ℝ => c * z) mu) := by
  rw [integrable_map_measure (by fun_prop) (by fun_prop)]
  change Integrable (fun z : ℝ => |c * z| ^ 3) mu
  simpa only [abs_mul, mul_pow] using hmu3.const_mul (|c| ^ 3)

/-- Convolution preserves finite first moments. -/
theorem integrable_id_conv (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => y) mu)
    (hnu1 : Integrable (fun y : ℝ => y) nu) :
    Integrable (fun y : ℝ => y) (mu ∗ nu) := by
  unfold Measure.conv
  rw [integrable_map_measure (by fun_prop) (by fun_prop)]
  exact (hmu1.comp_fst nu).add (hnu1.comp_snd mu)

/-- First moments add under convolution of probability laws. -/
theorem integral_id_conv (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => y) mu)
    (hnu1 : Integrable (fun y : ℝ => y) nu) :
    (∫ y : ℝ, y ∂(mu ∗ nu)) = (∫ y, y ∂mu) + ∫ y, y ∂nu := by
  unfold Measure.conv
  rw [integral_map (by fun_prop) (by fun_prop)]
  rw [integral_add (hmu1.comp_fst nu) (hnu1.comp_snd mu)]
  rw [integral_fun_fst (μ := mu) (ν := nu) (fun x : ℝ => x),
    integral_fun_snd (μ := mu) (ν := nu) (fun x : ℝ => x)]
  simp

/-- Convolution preserves finite second moments when both first moments are
finite. -/
theorem integrable_sq_conv (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => y) mu)
    (hnu1 : Integrable (fun y : ℝ => y) nu)
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu)
    (hnu2 : Integrable (fun y : ℝ => y ^ 2) nu) :
    Integrable (fun y : ℝ => y ^ 2) (mu ∗ nu) := by
  unfold Measure.conv
  rw [integrable_map_measure (by fun_prop) (by fun_prop)]
  have hmu2p := hmu2.comp_fst nu
  have hnu2p := hnu2.comp_snd mu
  have hcross := hmu1.mul_prod hnu1
  apply Integrable.congr ((hmu2p.add (hcross.const_mul 2)).add hnu2p)
  filter_upwards [] with z
  simp only [Pi.add_apply, Function.comp_apply]
  ring

/-- The second moment of a convolution, including its mean cross term. -/
theorem integral_sq_conv (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => y) mu)
    (hnu1 : Integrable (fun y : ℝ => y) nu)
    (hmu2 : Integrable (fun y : ℝ => y ^ 2) mu)
    (hnu2 : Integrable (fun y : ℝ => y ^ 2) nu) :
    (∫ y : ℝ, y ^ 2 ∂(mu ∗ nu)) =
      (∫ y, y ^ 2 ∂mu) + 2 * (∫ y, y ∂mu) * (∫ y, y ∂nu) +
        ∫ y, y ^ 2 ∂nu := by
  unfold Measure.conv
  rw [integral_map (by fun_prop) (by fun_prop)]
  have hmu2p := hmu2.comp_fst nu
  have hnu2p := hnu2.comp_snd mu
  have hcross := hmu1.mul_prod hnu1
  have hmiddle : Integrable (fun z : ℝ × ℝ => 2 * (z.1 * z.2)) (mu.prod nu) :=
    hcross.const_mul 2
  calc
    (∫ z : ℝ × ℝ, (z.1 + z.2) ^ 2 ∂mu.prod nu) =
        ∫ z : ℝ × ℝ, z.1 ^ 2 + 2 * (z.1 * z.2) + z.2 ^ 2 ∂mu.prod nu := by
      apply integral_congr_ae
      filter_upwards [] with z
      ring
    _ = (∫ z : ℝ × ℝ, z.1 ^ 2 + 2 * (z.1 * z.2) ∂mu.prod nu) +
        ∫ z : ℝ × ℝ, z.2 ^ 2 ∂mu.prod nu := by
      convert integral_add (hmu2p.add hmiddle) hnu2p using 1
    _ = ((∫ z : ℝ × ℝ, z.1 ^ 2 ∂mu.prod nu) +
        ∫ z : ℝ × ℝ, 2 * (z.1 * z.2) ∂mu.prod nu) +
        ∫ z : ℝ × ℝ, z.2 ^ 2 ∂mu.prod nu := by
      rw [integral_add hmu2p hmiddle]
    _ = _ := by
      rw [integral_fun_fst (μ := mu) (ν := nu) (fun x : ℝ => x ^ 2),
        integral_fun_snd (μ := mu) (ν := nu) (fun x : ℝ => x ^ 2),
        integral_const_mul,
        integral_prod_mul (μ := mu) (ν := nu) (fun x : ℝ => x) (fun x : ℝ => x)]
      simp only [probReal_univ, one_smul]
      ring

/-- Convolution preserves finite third absolute moments. -/
theorem integrable_abs_cube_conv (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu3 : Integrable (fun y : ℝ => |y| ^ 3) mu)
    (hnu3 : Integrable (fun y : ℝ => |y| ^ 3) nu) :
    Integrable (fun y : ℝ => |y| ^ 3) (mu ∗ nu) := by
  have hmuLp : MemLp (fun y : ℝ => y) 3 mu := by
    rw [← integrable_norm_rpow_iff (p := (3 : ℝ≥0∞)) (by fun_prop)
      (by norm_num) (by norm_num)]
    norm_num
    simpa only [Real.norm_eq_abs] using hmu3
  have hnuLp : MemLp (fun y : ℝ => y) 3 nu := by
    rw [← integrable_norm_rpow_iff (p := (3 : ℝ≥0∞)) (by fun_prop)
      (by norm_num) (by norm_num)]
    norm_num
    simpa only [Real.norm_eq_abs] using hnu3
  have hconv : MemLp (fun y : ℝ => y) 3 (mu ∗ nu) := by
    unfold Measure.conv
    rw [memLp_map_measure_iff (by fun_prop) (by fun_prop)]
    exact (hmuLp.comp_fst nu).add (hnuLp.comp_snd mu)
  simpa only [Real.norm_eq_abs] using hconv.integrable_norm_pow (by norm_num)

instance normalizedGaussianStepLaw_isProbabilityMeasure
    (N : ℕ) (nu : Measure ℝ) [IsProbabilityMeasure nu] :
    IsProbabilityMeasure (normalizedGaussianStepLaw N nu) := by
  unfold normalizedGaussianStepLaw
  letI : IsProbabilityMeasure
      (Measure.map (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure
      (Measure.map (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  infer_instance

/-- The Gaussian keep/innovation step preserves finite first moments. -/
theorem integrable_normalizedGaussianStepLaw_id
    (N : ℕ) (nu : Measure ℝ) [IsProbabilityMeasure nu]
    (hnu1 : Integrable (fun y : ℝ => y) nu) :
    Integrable (fun y : ℝ => y) (normalizedGaussianStepLaw N nu) := by
  let gamma := NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let gammaScaled := Measure.map
    (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma
  let nuScaled := Measure.map
    (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu
  letI : IsProbabilityMeasure gammaScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure nuScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  change Integrable (fun y : ℝ => y) (gammaScaled ∗ nuScaled)
  apply integrable_id_conv gammaScaled nuScaled
  · exact integrable_id_map_mul_real gamma _ integrable_standardNormal_id
  · exact integrable_id_map_mul_real nu _ hnu1

/-- The Gaussian keep/innovation step preserves centering. -/
theorem integral_normalizedGaussianStepLaw_id
    (N : ℕ) (nu : Measure ℝ) [IsProbabilityMeasure nu]
    (hnu1 : Integrable (fun y : ℝ => y) nu)
    (hmean : (∫ y : ℝ, y ∂nu) = 0) :
    (∫ y : ℝ, y ∂normalizedGaussianStepLaw N nu) = 0 := by
  let gamma := NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let gammaScaled := Measure.map
    (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma
  let nuScaled := Measure.map
    (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu
  letI : IsProbabilityMeasure gammaScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure nuScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  change (∫ y : ℝ, y ∂(gammaScaled ∗ nuScaled)) = 0
  rw [integral_id_conv gammaScaled nuScaled
      (integrable_id_map_mul_real gamma _ integrable_standardNormal_id)
      (integrable_id_map_mul_real nu _ hnu1),
    integral_id_map_mul_real, integral_id_map_mul_real,
    integral_standardNormal_id, hmean]
  ring

/-- The Gaussian keep/innovation step preserves finite second moments. -/
theorem integrable_normalizedGaussianStepLaw_sq
    (N : ℕ) (nu : Measure ℝ) [IsProbabilityMeasure nu]
    (hnu1 : Integrable (fun y : ℝ => y) nu)
    (hnu2 : Integrable (fun y : ℝ => y ^ 2) nu) :
    Integrable (fun y : ℝ => y ^ 2) (normalizedGaussianStepLaw N nu) := by
  let gamma := NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let gammaScaled := Measure.map
    (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma
  let nuScaled := Measure.map
    (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu
  letI : IsProbabilityMeasure gammaScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure nuScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  change Integrable (fun y : ℝ => y ^ 2) (gammaScaled ∗ nuScaled)
  exact integrable_sq_conv gammaScaled nuScaled
    (integrable_id_map_mul_real gamma _ integrable_standardNormal_id)
    (integrable_id_map_mul_real nu _ hnu1)
    (integrable_sq_map_mul_real gamma _ integrable_standardNormal_sq)
    (integrable_sq_map_mul_real nu _ hnu2)

/-- The Gaussian keep/innovation step preserves unit second moment on
centered input laws. -/
theorem integral_normalizedGaussianStepLaw_sq
    (N : ℕ) (nu : Measure ℝ) [IsProbabilityMeasure nu]
    (hnu1 : Integrable (fun y : ℝ => y) nu)
    (hnu2 : Integrable (fun y : ℝ => y ^ 2) nu)
    (hmean : (∫ y : ℝ, y ∂nu) = 0)
    (hsecond : (∫ y : ℝ, y ^ 2 ∂nu) = 1) :
    (∫ y : ℝ, y ^ 2 ∂normalizedGaussianStepLaw N nu) = 1 := by
  let gamma := NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let gammaScaled := Measure.map
    (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma
  let nuScaled := Measure.map
    (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu
  letI : IsProbabilityMeasure gammaScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure nuScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  change (∫ y : ℝ, y ^ 2 ∂(gammaScaled ∗ nuScaled)) = 1
  rw [integral_sq_conv gammaScaled nuScaled
      (integrable_id_map_mul_real gamma _ integrable_standardNormal_id)
      (integrable_id_map_mul_real nu _ hnu1)
      (integrable_sq_map_mul_real gamma _ integrable_standardNormal_sq)
      (integrable_sq_map_mul_real nu _ hnu2),
    integral_sq_map_mul_real, integral_sq_map_mul_real,
    integral_id_map_mul_real, integral_id_map_mul_real,
    integral_standardNormal_id, integral_standardNormal_sq, hmean, hsecond]
  rw [show normalizedGaussianInnovationCoefficient N ^ 2 * 1 +
      2 * (normalizedGaussianInnovationCoefficient N * 0) *
        (normalizedGaussianKeepCoefficient N * 0) +
      normalizedGaussianKeepCoefficient N ^ 2 * 1 =
      normalizedGaussianKeepCoefficient N ^ 2 +
        normalizedGaussianInnovationCoefficient N ^ 2 by ring]
  exact normalizedGaussianCoefficients_sq_add N

/-- The Gaussian keep/innovation step preserves finiteness of the third
absolute moment. -/
theorem integrable_normalizedGaussianStepLaw_abs_cube
    (N : ℕ) (nu : Measure ℝ) [IsProbabilityMeasure nu]
    (hnu3 : Integrable (fun y : ℝ => |y| ^ 3) nu) :
    Integrable (fun y : ℝ => |y| ^ 3) (normalizedGaussianStepLaw N nu) := by
  let gamma := NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let gammaScaled := Measure.map
    (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma
  let nuScaled := Measure.map
    (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu
  letI : IsProbabilityMeasure gammaScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure nuScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  change Integrable (fun y : ℝ => |y| ^ 3) (gammaScaled ∗ nuScaled)
  exact integrable_abs_cube_conv gammaScaled nuScaled
    (integrable_abs_cube_map_mul_real gamma _ integrable_standardNormal_abs_cube)
    (integrable_abs_cube_map_mul_real nu _ hnu3)

/-- For a real law, the `L³` condition on the identity is exactly finiteness
of the third absolute moment. -/
theorem memLp_id_three_iff_integrable_abs_cube (mu : Measure ℝ) :
    MemLp (fun y : ℝ => y) 3 mu ↔ Integrable (fun y : ℝ => |y| ^ 3) mu := by
  rw [← integrable_norm_rpow_iff (p := (3 : ℝ≥0∞)) (by fun_prop)
    (by norm_num) (by norm_num)]
  norm_num [Real.norm_eq_abs]

/-- Minkowski's inequality for the identity under convolution of real
probability laws. -/
theorem eLpNorm_id_conv_le (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu] :
    eLpNorm (fun y : ℝ => y) 3 (mu ∗ nu) ≤
      eLpNorm (fun y : ℝ => y) 3 mu + eLpNorm (fun y : ℝ => y) 3 nu := by
  unfold Measure.conv
  rw [eLpNorm_map_measure (by fun_prop) (by fun_prop)]
  calc
    eLpNorm ((fun z : ℝ × ℝ => z.1) + fun z => z.2) 3 (mu.prod nu) ≤
        eLpNorm (fun z : ℝ × ℝ => z.1) 3 (mu.prod nu) +
          eLpNorm (fun z : ℝ × ℝ => z.2) 3 (mu.prod nu) := by
      exact eLpNorm_add_le (by fun_prop) (by fun_prop) (by norm_num)
    _ = _ := by
      rw [show (fun z : ℝ × ℝ => z.1) = (fun y : ℝ => y) ∘ Prod.fst by rfl,
        show (fun z : ℝ × ℝ => z.2) = (fun y : ℝ => y) ∘ Prod.snd by rfl,
        eLpNorm_comp_measurePreserving (by fun_prop)
          (measurePreserving_fst (μ := mu) (ν := nu)),
        eLpNorm_comp_measurePreserving (by fun_prop)
          (measurePreserving_snd (μ := mu) (ν := nu))]

/-- Real-valued `L³` Minkowski inequality for convolution. -/
theorem lpNorm_id_conv_le (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu3 : MemLp (fun y : ℝ => y) 3 mu)
    (hnu3 : MemLp (fun y : ℝ => y) 3 nu) :
    lpNorm (fun y : ℝ => y) 3 (mu ∗ nu) ≤
      lpNorm (fun y : ℝ => y) 3 mu + lpNorm (fun y : ℝ => y) 3 nu := by
  have hconv : MemLp (fun y : ℝ => y) 3 (mu ∗ nu) := by
    unfold Measure.conv
    rw [memLp_map_measure_iff (by fun_prop) (by fun_prop)]
    exact (hmu3.comp_fst nu).add (hnu3.comp_snd mu)
  rw [← toReal_eLpNorm hconv.aestronglyMeasurable,
    ← toReal_eLpNorm hmu3.aestronglyMeasurable,
    ← toReal_eLpNorm hnu3.aestronglyMeasurable,
    ← ENNReal.toReal_add hmu3.eLpNorm_ne_top hnu3.eLpNorm_ne_top]
  exact ENNReal.toReal_mono (ENNReal.add_ne_top.2
    ⟨hmu3.eLpNorm_ne_top, hnu3.eLpNorm_ne_top⟩)
    (eLpNorm_id_conv_le mu nu)

/-- The real `L³` norm of the identity scales by the absolute value of a
scalar pushforward. -/
theorem lpNorm_id_map_mul_real (mu : Measure ℝ) (c : ℝ) :
    lpNorm (fun y : ℝ => y) 3 (Measure.map (fun z : ℝ => c * z) mu) =
      |c| * lpNorm (fun y : ℝ => y) 3 mu := by
  rw [← toReal_eLpNorm (p := (3 : ℝ≥0∞)) (by fun_prop),
    eLpNorm_map_measure (by fun_prop) (by fun_prop)]
  change (eLpNorm (c • (fun y : ℝ => y)) 3 mu).toReal = _
  rw [eLpNorm_const_smul, ENNReal.toReal_mul, toReal_eLpNorm (by fun_prop)]
  simp [Real.norm_eq_abs]

/-- Quantitative third-moment-root envelope for one Gaussian
keep/innovation step. -/
theorem lpNorm_normalizedGaussianStepLaw_le
    (N : ℕ) (nu : Measure ℝ) [IsProbabilityMeasure nu]
    (hnu3 : Integrable (fun y : ℝ => |y| ^ 3) nu) :
    lpNorm (fun y : ℝ => y) 3 (normalizedGaussianStepLaw N nu) ≤
      normalizedGaussianInnovationCoefficient N *
          lpNorm (fun y : ℝ => y) 3
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
        normalizedGaussianKeepCoefficient N * lpNorm (fun y : ℝ => y) 3 nu := by
  let gamma := NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let gammaScaled := Measure.map
    (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma
  let nuScaled := Measure.map
    (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu
  letI : IsProbabilityMeasure gammaScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure nuScaled := Measure.isProbabilityMeasure_map (by fun_prop)
  have hgammaScaled3 : MemLp (fun y : ℝ => y) 3 gammaScaled :=
    (memLp_id_three_iff_integrable_abs_cube gammaScaled).2
      (integrable_abs_cube_map_mul_real gamma _ integrable_standardNormal_abs_cube)
  have hnuScaled3 : MemLp (fun y : ℝ => y) 3 nuScaled :=
    (memLp_id_three_iff_integrable_abs_cube nuScaled).2
      (integrable_abs_cube_map_mul_real nu _ hnu3)
  change lpNorm (fun y : ℝ => y) 3 (gammaScaled ∗ nuScaled) ≤ _
  calc
    lpNorm (fun y : ℝ => y) 3 (gammaScaled ∗ nuScaled) ≤
        lpNorm (fun y : ℝ => y) 3 gammaScaled +
          lpNorm (fun y : ℝ => y) 3 nuScaled :=
      lpNorm_id_conv_le gammaScaled nuScaled hgammaScaled3 hnuScaled3
    _ = |normalizedGaussianInnovationCoefficient N| *
          lpNorm (fun y : ℝ => y) 3 gamma +
        |normalizedGaussianKeepCoefficient N| * lpNorm (fun y : ℝ => y) 3 nu := by
      rw [lpNorm_id_map_mul_real, lpNorm_id_map_mul_real]
    _ = _ := by
      rw [abs_of_pos (normalizedGaussianInnovationCoefficient_pos N),
        abs_of_pos (normalizedGaussianKeepCoefficient_pos N)]

/-- A real probability law with zero mean, unit second moment, finite third
absolute moment, and a specified `L³` bound.  This is the admissible domain
for moment-sensitive estimates on the Gaussian keep/innovation operator. -/
structure IsStandardizedThirdMomentLaw (nu : Measure ℝ) (B : ℝ) : Prop where
  probability : IsProbabilityMeasure nu
  integrable_id : Integrable (fun y : ℝ => y) nu
  centered : (∫ y : ℝ, y ∂nu) = 0
  integrable_sq : Integrable (fun y : ℝ => y ^ 2) nu
  unit_second_moment : (∫ y : ℝ, y ^ 2 ∂nu) = 1
  integrable_abs_cube : Integrable (fun y : ℝ => |y| ^ 3) nu
  lpNorm_three_le : lpNorm (fun y : ℝ => y) 3 nu ≤ B

/-- The standard-normal law belongs to the bounded standardized-law domain
at its own `L³` norm. -/
theorem standardNormal_isStandardizedThirdMomentLaw :
    IsStandardizedThirdMomentLaw
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      (lpNorm (fun y : ℝ => y) 3
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) := by
  exact ⟨inferInstance, integrable_standardNormal_id, integral_standardNormal_id,
    integrable_standardNormal_sq, integral_standardNormal_sq,
    integrable_standardNormal_abs_cube, le_rfl⟩

/-- The exact bounded standardized-law domain transported by one Gaussian
keep/innovation step. -/
theorem IsStandardizedThirdMomentLaw.normalizedGaussianStepLaw
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B) (N : ℕ) :
    IsStandardizedThirdMomentLaw (normalizedGaussianStepLaw N nu)
      (normalizedGaussianInnovationCoefficient N *
          lpNorm (fun y : ℝ => y) 3
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
        normalizedGaussianKeepCoefficient N * B) := by
  letI : IsProbabilityMeasure nu := h.probability
  refine ⟨inferInstance,
    integrable_normalizedGaussianStepLaw_id N nu h.integrable_id,
    integral_normalizedGaussianStepLaw_id N nu h.integrable_id h.centered,
    integrable_normalizedGaussianStepLaw_sq N nu h.integrable_id h.integrable_sq,
    integral_normalizedGaussianStepLaw_sq N nu h.integrable_id h.integrable_sq
      h.centered h.unit_second_moment,
    integrable_normalizedGaussianStepLaw_abs_cube N nu h.integrable_abs_cube, ?_⟩
  refine (lpNorm_normalizedGaussianStepLaw_le N nu h.integrable_abs_cube).trans ?_
  exact add_le_add_right
    (mul_le_mul_of_nonneg_left h.lpNorm_three_le
      (normalizedGaussianKeepCoefficient_pos N).le) _

/-- The standard normal law is stationary under the precise Gaussian
keep/innovation split in the normalized leave-one-out recurrence. -/
theorem standardNormalLaw_normalizedGaussian_step (N : ℕ) :
    normalizedGaussianStepLaw N
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw =
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  unfold normalizedGaussianStepLaw
  rw [Measure.conv_comm,
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw,
    ProbabilityTheory.gaussianReal_map_const_mul,
    ProbabilityTheory.gaussianReal_map_const_mul,
    ProbabilityTheory.gaussianReal_conv_gaussianReal]
  congr 2
  · ring
  · rw [← NNReal.coe_inj]
    simp only [NNReal.coe_add, NNReal.coe_mk, NNReal.coe_one, mul_one]
    exact normalizedGaussianCoefficients_sq_add N

/-- The affine Gaussian average in the normalized signed recurrence is
exactly one step of the Gaussian-stationary keep/innovation operator. -/
theorem integral_cdfUpperError_normalizedGaussian_affine_eq
    (nu : Measure ℝ) [IsProbabilityMeasure nu] (N : ℕ) (x : ℝ) :
    (∫ y, cdfUpperError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      ((Real.sqrt (N + 1 : ℝ))⁻¹ *
        (x / (Real.sqrt (N + 2 : ℝ))⁻¹ - y))
      ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) =
      cdfUpperError
        (normalizedGaussianStepLaw N nu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x := by
  let gamma := NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  letI : IsProbabilityMeasure gamma := inferInstance
  letI : IsProbabilityMeasure
      (Measure.map (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure
      (Measure.map (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) gamma) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  letI : IsProbabilityMeasure
      (Measure.map (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma) :=
    Measure.isProbabilityMeasure_map (by fun_prop)
  calc
    (∫ y, cdfUpperError nu gamma
        ((Real.sqrt (N + 1 : ℝ))⁻¹ *
          (x / (Real.sqrt (N + 2 : ℝ))⁻¹ - y)) ∂gamma) =
        ∫ y, cdfUpperError nu gamma
          ((x - normalizedGaussianInnovationCoefficient N * y) /
            normalizedGaussianKeepCoefficient N) ∂gamma := by
      apply integral_congr_ae
      filter_upwards [] with y
      congr 1
      unfold normalizedGaussianKeepCoefficient
        normalizedGaussianInnovationCoefficient
      have h1 : Real.sqrt (N + 1 : ℝ) ≠ 0 := by positivity
      have h2 : Real.sqrt (N + 2 : ℝ) ≠ 0 := by positivity
      field_simp
    _ = ∫ y, cdfUpperError
        (Measure.map
          (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu)
        (Measure.map
          (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) gamma)
        (x - normalizedGaussianInnovationCoefficient N * y) ∂gamma := by
      apply integral_congr_ae
      filter_upwards [] with y
      rw [cdfUpperError_map_mul nu gamma
        (normalizedGaussianKeepCoefficient_pos N)]
    _ = ∫ w, cdfUpperError
        (Measure.map
          (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu)
        (Measure.map
          (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) gamma)
        (x - w)
        ∂(Measure.map
          (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma) := by
      have hmeas : Measurable (fun w : ℝ => cdfUpperError
          (Measure.map
            (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu)
          (Measure.map
            (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) gamma)
          (x - w)) := by
        exact ((monotone_cdf _).measurable.comp
          (measurable_const.sub measurable_id)).sub
          ((monotone_cdf _).measurable.comp
            (measurable_const.sub measurable_id))
      rw [integral_map (by fun_prop) hmeas.aestronglyMeasurable]
    _ = cdfUpperError
        (Measure.map
            (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma ∗
          Measure.map
            (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu)
        (Measure.map
            (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma ∗
          Measure.map
            (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) gamma) x := by
      rw [cdfUpperError_conv_left_eq_integral]
    _ = cdfUpperError
        (Measure.map
            (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma ∗
          Measure.map
            (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) nu)
        gamma x := by
      have hstationary :
          Measure.map
              (fun z : ℝ => normalizedGaussianInnovationCoefficient N * z) gamma ∗
            Measure.map
              (fun z : ℝ => normalizedGaussianKeepCoefficient N * z) gamma =
            gamma := by
        simpa only [gamma, normalizedGaussianStepLaw] using
          standardNormalLaw_normalizedGaussian_step N
      rw [hstationary]

/-- Lower signed-error companion to the exact Gaussian keep/innovation
identity. -/
theorem integral_cdfLowerError_normalizedGaussian_affine_eq
    (nu : Measure ℝ) [IsProbabilityMeasure nu] (N : ℕ) (x : ℝ) :
    (∫ y, cdfLowerError nu
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      ((Real.sqrt (N + 1 : ℝ))⁻¹ *
        (x / (Real.sqrt (N + 2 : ℝ))⁻¹ - y))
      ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) =
      cdfLowerError
        (normalizedGaussianStepLaw N nu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x := by
  simp only [cdfLowerError_eq_neg_upper, integral_neg]
  rw [integral_cdfUpperError_normalizedGaussian_affine_eq]

/-- A common convolution factor cannot increase the one-sided upper CDF
distance. -/
theorem upperCDFDistance_conv_left_le
    (mu nu kappa : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    [IsProbabilityMeasure kappa] :
    upperCDFDistance (kappa ∗ mu) (kappa ∗ nu) ≤
      upperCDFDistance mu nu := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  rw [cdfUpperError_conv_left_eq_integral]
  apply integral_cdfUpperError_comp_le
  fun_prop

/-- Lower one-sided companion to `upperCDFDistance_conv_left_le`. -/
theorem lowerCDFDistance_conv_left_le
    (mu nu kappa : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    [IsProbabilityMeasure kappa] :
    lowerCDFDistance (kappa ∗ mu) (kappa ∗ nu) ≤
      lowerCDFDistance mu nu := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  rw [cdfLowerError_conv_left_eq_integral]
  apply integral_cdfLowerError_comp_le
  fun_prop

/-- The exact normalized Gaussian keep/innovation step is nonexpansive for
the upper one-sided Kolmogorov distance from its stationary law. -/
theorem upperCDFDistance_normalizedGaussianStepLaw_le
    (nu : Measure ℝ) [IsProbabilityMeasure nu] (N : ℕ) :
    upperCDFDistance (normalizedGaussianStepLaw N nu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      upperCDFDistance nu
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  rw [← integral_cdfUpperError_normalizedGaussian_affine_eq]
  apply integral_cdfUpperError_comp_le
  fun_prop

/-- Lower one-sided companion to
`upperCDFDistance_normalizedGaussianStepLaw_le`. -/
theorem lowerCDFDistance_normalizedGaussianStepLaw_le
    (nu : Measure ℝ) [IsProbabilityMeasure nu] (N : ℕ) :
    lowerCDFDistance (normalizedGaussianStepLaw N nu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      lowerCDFDistance nu
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨x, rfl⟩
  rw [← integral_cdfLowerError_normalizedGaussian_affine_eq]
  apply integral_cdfLowerError_comp_le
  fun_prop

/-- Kolmogorov nonexpansiveness of one exact normalized Gaussian
keep/innovation step. -/
theorem kolmogorovDistance_normalizedGaussianStepLaw_le
    (nu : Measure ℝ) [IsProbabilityMeasure nu] (N : ℕ) :
    kolmogorovDistance (normalizedGaussianStepLaw N nu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      kolmogorovDistance nu
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  calc
    kolmogorovDistance (normalizedGaussianStepLaw N nu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw =
        max
          (upperCDFDistance (normalizedGaussianStepLaw N nu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
          (lowerCDFDistance (normalizedGaussianStepLaw N nu)
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) :=
      kolmogorovDistance_eq_max_signed _ _
    _ ≤ max
          (upperCDFDistance nu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
          (lowerCDFDistance nu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) :=
      max_le_max
        (upperCDFDistance_normalizedGaussianStepLaw_le nu N)
        (lowerCDFDistance_normalizedGaussianStepLaw_le nu N)
    _ = kolmogorovDistance nu
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw :=
      (kolmogorovDistance_eq_max_signed _ _).symm

/-- Exact signed upper-error leave-one-out recurrence for a raw partial sum.
The first term replaces the newest summand by a standard Gaussian; the
integral retains the preceding signed error instead of taking its absolute
value before averaging. -/
theorem cdfUpperError_sum_range_succ_gaussian_telescope
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, AEMeasurable (X i) mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu) (N : ℕ) (x : ℝ) :
    cdfUpperError
        (Measure.map (∑ i ∈ Finset.range (N + 2), X i) mu)
        (ProbabilityTheory.gaussianReal 0 (N + 2 : ℝ≥0)) x =
      cdfUpperError
          (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu ∗
            Measure.map (X (N + 1)) mu)
          (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu ∗
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) x +
        ∫ y, cdfUpperError
          (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu)
          (ProbabilityTheory.gaussianReal 0 (N + 1 : ℝ≥0)) (x - y)
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  let Sprev : Omega → ℝ := ∑ i ∈ Finset.range (N + 1), X i
  have hSprev : AEMeasurable Sprev mu := by
    dsimp only [Sprev]
    fun_prop
  letI : IsProbabilityMeasure (Measure.map Sprev mu) :=
    Measure.isProbabilityMeasure_map hSprev
  letI : IsProbabilityMeasure (Measure.map (X (N + 1)) mu) :=
    Measure.isProbabilityMeasure_map (hX (N + 1))
  rw [map_sum_range_succ_eq_conv X hX hIndep (N + 1),
    ← gaussianReal_nat_succ_conv_standardNormalLaw N]
  calc
    cdfUpperError
        (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu ∗
          Measure.map (X (N + 1)) mu)
        (ProbabilityTheory.gaussianReal 0 (N + 1 : ℝ≥0) ∗
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) x =
      cdfUpperError
          (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu ∗
            Measure.map (X (N + 1)) mu)
          (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu ∗
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) x +
        cdfUpperError
          (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu ∗
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
          (ProbabilityTheory.gaussianReal 0 (N + 1 : ℝ≥0) ∗
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) x :=
      cdfUpperError_conv_telescope _ _ _ _ x
    _ = _ := by
      congr 1
      rw [Measure.conv_comm
          (Measure.map (∑ i ∈ Finset.range (N + 1), X i) mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw,
        Measure.conv_comm
          (ProbabilityTheory.gaussianReal 0 (N + 1 : ℝ≥0))
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw,
        cdfUpperError_conv_left_eq_integral]

