      berryEsseenConstant *
        (∫ omega, |X 0 omega| ^ 3 ∂mu) /
          Real.sqrt (N + 1 : ℝ) := by
  let rho : ℝ := ∫ omega, |X 0 omega| ^ 3 ∂mu
  let s : ℝ := Real.sqrt (N + 1 : ℝ)
  let M2 : ℝ := gaussianDampedMoment 2
  let M3 : ℝ := gaussianDampedMoment 3
  let K : ℝ := sincFourthShiftedMomentBound
  have hrho : 1 ≤ rho := by
    simpa only [rho] using
      one_le_thirdAbsoluteMoment_of_secondMoment_eq_one (hX 0) hSecond
  have hs : 0 < s := by
    dsimp only [s]
    positivity
  have hn : 0 < (N + 1 : ℝ) := by positivity
  have hsSq : s ^ 2 = (N + 1 : ℝ) := by
    dsimp only [s]
    rw [Real.sq_sqrt hn.le]
  have hsOne : 1 ≤ s := by
    rw [← Real.sqrt_one]
    dsimp only [s]
    exact Real.sqrt_le_sqrt (by exact_mod_cast Nat.le_add_left 1 N)
  have hM2 : 0 ≤ M2 := gaussianDampedMoment_nonneg 2
  have hM3 : 0 ≤ M3 := gaussianDampedMoment_nonneg 3
  have hK : 0 ≤ K := by
    dsimp only [K, sincFourthShiftedMomentBound]
    exact add_nonneg sincFourthTailRadius_pos.le sincFourthFirstMoment_nonneg
  have hInv : 1 / (N + 1 : ℝ) ≤ rho / s := by
    rw [div_le_div_iff₀ hn hs]
    have hs_le_n : s ≤ (N + 1 : ℝ) := by
      rw [← hsSq]
      nlinarith
    have hn_le : (N + 1 : ℝ) ≤ rho * (N + 1 : ℝ) := by
      nlinarith
    simpa only [one_mul] using hs_le_n.trans hn_le
  have hFirst :
      (4 * rho / s) * M2 = (4 * M2) * (rho / s) := by ring
  have hSecondTerm :
      (1 / (4 * (N + 1 : ℝ))) * M3 ≤
        ((1 / 4) * M3) * (rho / s) := by
    calc
      (1 / (4 * (N + 1 : ℝ))) * M3 =
          ((1 / 4) * M3) * (1 / (N + 1 : ℝ)) := by
        field_simp [hn.ne']
      _ ≤ ((1 / 4) * M3) * (rho / s) :=
        mul_le_mul_of_nonneg_left hInv (by positivity)
  have hden : 0 < 1 + 16 * rho := by positivity
  have hdenBound : 1 + 16 * rho ≤ 17 * rho := by nlinarith
  have hSpatial :
      (4 / berryEsseenFrequencyCutoff rho N) * K ≤
        (68 * K) * (rho / s) := by
    have hcut : berryEsseenFrequencyCutoff rho N = s / (1 + 16 * rho) := rfl
    rw [hcut]
    calc
      (4 / (s / (1 + 16 * rho))) * K =
          (4 * K) * ((1 + 16 * rho) / s) := by
        field_simp [hs.ne', hden.ne']
      _ ≤ (4 * K) * ((17 * rho) / s) := by
        exact mul_le_mul_of_nonneg_left
          ((div_le_div_iff_of_pos_right hs).2 hdenBound) (by positivity)
      _ = (68 * K) * (rho / s) := by ring
  have hFourier :
      (2 * Real.pi)⁻¹ *
          ((4 * rho / s) * M2 +
            (1 / (4 * (N + 1 : ℝ))) * M3) +
        (Real.sqrt (2 * Real.pi))⁻¹ *
          ((4 / berryEsseenFrequencyCutoff rho N) * K) ≤
      ((2 * Real.pi)⁻¹ *
          (4 * M2 + (1 / 4) * M3) +
        (Real.sqrt (2 * Real.pi))⁻¹ * (68 * K)) *
        (rho / s) := by
    have hLocalPart :
        (4 * rho / s) * M2 +
            (1 / (4 * (N + 1 : ℝ))) * M3 ≤
          (4 * M2) * (rho / s) +
            ((1 / 4) * M3) * (rho / s) := by
      calc
        (4 * rho / s) * M2 +
            (1 / (4 * (N + 1 : ℝ))) * M3 =
          (4 * M2) * (rho / s) +
            (1 / (4 * (N + 1 : ℝ))) * M3 := by rw [hFirst]
        _ ≤ (4 * M2) * (rho / s) +
            ((1 / 4) * M3) * (rho / s) :=
          add_le_add le_rfl hSecondTerm
    calc
      (2 * Real.pi)⁻¹ *
            ((4 * rho / s) * M2 +
              (1 / (4 * (N + 1 : ℝ))) * M3) +
          (Real.sqrt (2 * Real.pi))⁻¹ *
            ((4 / berryEsseenFrequencyCutoff rho N) * K) ≤
        (2 * Real.pi)⁻¹ *
            ((4 * M2) * (rho / s) +
              ((1 / 4) * M3) * (rho / s)) +
          (Real.sqrt (2 * Real.pi))⁻¹ *
            ((68 * K) * (rho / s)) := by
          exact add_le_add
            (mul_le_mul_of_nonneg_left hLocalPart
              (inv_nonneg.mpr (by positivity)))
            (mul_le_mul_of_nonneg_left hSpatial
              (inv_nonneg.mpr (by positivity)))
      _ = ((2 * Real.pi)⁻¹ *
            (4 * M2 + (1 / 4) * M3) +
          (Real.sqrt (2 * Real.pi))⁻¹ * (68 * K)) *
          (rho / s) := by ring
  have hexplicit :=
    kolmogorovDistance_normalizedCenteredIidSum_le_explicit
      X hX hIndep hIdent hMean hSecond hN
  calc
    kolmogorovDistance
        (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
            X (fun i => (hX i).mono_exponent (by norm_num)) N).aemeasurable)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      ((2 * Real.pi)⁻¹ *
          ((4 * rho / s) * M2 +
            (1 / (4 * (N + 1 : ℝ))) * M3) +
        (Real.sqrt (2 * Real.pi))⁻¹ *
          ((4 / berryEsseenFrequencyCutoff rho N) * K)) /
        (1 - 2 * (1 / 4 : ℝ)) := by
      simpa only [rho, s, M2, M3, K] using hexplicit
    _ = 2 * ((2 * Real.pi)⁻¹ *
          ((4 * rho / s) * M2 +
            (1 / (4 * (N + 1 : ℝ))) * M3) +
        (Real.sqrt (2 * Real.pi))⁻¹ *
          ((4 / berryEsseenFrequencyCutoff rho N) * K)) := by ring
    _ ≤ 2 * (((2 * Real.pi)⁻¹ *
          (4 * M2 + (1 / 4) * M3) +
        (Real.sqrt (2 * Real.pi))⁻¹ * (68 * K)) *
          (rho / s)) := mul_le_mul_of_nonneg_left hFourier (by norm_num)
    _ = berryEsseenConstant * rho / s := by
      unfold berryEsseenConstant
      dsimp only [M2, M3, K]
      ring
    _ = berryEsseenConstant *
        (∫ omega, |X 0 omega| ^ 3 ∂mu) /
          Real.sqrt (N + 1 : ℝ) := rfl

/-- Explicit leave-one-out concentration estimate obtained by inserting the
certified Berry--Esseen bound for the preceding normalized partial sum. -/
theorem concentrationFunction_normalizedCenteredIidSum_succ_le_explicit
    {Ω : Type*} [MeasurableSpace Ω]
    {mu : Measure Ω} [IsProbabilityMeasure mu]
    (X : ℕ → Ω → ℝ) (hX : ∀ i, MemLp (X i) 3 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (hMean : ∫ omega, X 0 omega ∂mu = 0)
    (hSecond : ∫ omega, (X 0 omega) ^ 2 ∂mu = 1)
    (N : ℕ) (hN : 1 ≤ N) {h : ℝ} (hh : 0 ≤ h) :
    concentrationFunction
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X (N + 1)) mu) h ≤
      (Real.sqrt (2 * Real.pi))⁻¹ *
          ((Real.sqrt (N + 1 : ℝ))⁻¹ *
            (h * Real.sqrt (N + 2 : ℝ))) +
        2 * (berryEsseenConstant *
          (∫ omega, |X 0 omega| ^ 3 ∂mu) /
            Real.sqrt (N + 1 : ℝ)) := by
  have hprev :=
    kolmogorovDistance_normalizedCenteredIidSum_le_berryEsseenConstant
      X hX hIndep hIdent hMean hSecond hN
  have hconc :=
    concentrationFunction_normalizedCenteredIidSum_succ_le_gaussian_previous
      X (fun i => (hX i).aemeasurable) hIndep N hh
  calc
    concentrationFunction
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X (N + 1)) mu) h ≤
      (Real.sqrt (2 * Real.pi))⁻¹ *
          ((Real.sqrt (N + 1 : ℝ))⁻¹ *
            (h * Real.sqrt (N + 2 : ℝ))) +
        2 * kolmogorovDistance
          (Measure.map
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N) mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := hconc
    _ ≤ _ := by
      exact add_le_add le_rfl <|
        mul_le_mul_of_nonneg_left
          (by
            simpa [NumStability.HDP.Scalar.LimitTheorems.probabilityLaw] using hprev)
          (by norm_num)

/-- The exact interval rescaling in the normalized leave-one-out recurrence is
uniformly bounded by `sqrt 2`. -/
theorem normalizedCenteredIidSum_succ_intervalScale_le_sqrt_two
    (N : ℕ) {h : ℝ} (hh : 0 ≤ h) :
    (Real.sqrt (N + 1 : ℝ))⁻¹ * (h * Real.sqrt (N + 2 : ℝ)) ≤
      Real.sqrt 2 * h := by
  have hb : 0 < Real.sqrt (N + 1 : ℝ) := by positivity
  have ha_le : Real.sqrt (N + 2 : ℝ) ≤
      Real.sqrt 2 * Real.sqrt (N + 1 : ℝ) := by
    apply (sq_le_sq₀ (Real.sqrt_nonneg _) (mul_nonneg (Real.sqrt_nonneg _) hb.le)).mp
    rw [Real.sq_sqrt (by positivity), mul_pow,
      Real.sq_sqrt (by positivity), Real.sq_sqrt (by positivity)]
    linarith
  rw [inv_mul_eq_div, div_le_iff₀ hb]
  calc
    h * Real.sqrt (N + 2 : ℝ) ≤
        h * (Real.sqrt 2 * Real.sqrt (N + 1 : ℝ)) :=
      mul_le_mul_of_nonneg_left ha_le hh
    _ = (Real.sqrt 2 * h) * Real.sqrt (N + 1 : ℝ) := by ring

/-- A simplified explicit leave-one-out concentration estimate with a
uniform `sqrt 2` normalization factor. -/
theorem concentrationFunction_normalizedCenteredIidSum_succ_le_explicit_sqrt_two
    {Ω : Type*} [MeasurableSpace Ω]
    {mu : Measure Ω} [IsProbabilityMeasure mu]
    (X : ℕ → Ω → ℝ) (hX : ∀ i, MemLp (X i) 3 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (hMean : ∫ omega, X 0 omega ∂mu = 0)
    (hSecond : ∫ omega, (X 0 omega) ^ 2 ∂mu = 1)
    (N : ℕ) (hN : 1 ≤ N) {h : ℝ} (hh : 0 ≤ h) :
    concentrationFunction
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X (N + 1)) mu) h ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * (Real.sqrt 2 * h) +
        2 * (berryEsseenConstant *
          (∫ omega, |X 0 omega| ^ 3 ∂mu) /
            Real.sqrt (N + 1 : ℝ)) := by
  have hbase := concentrationFunction_normalizedCenteredIidSum_succ_le_explicit
    X hX hIndep hIdent hMean hSecond N hN hh
  calc
    concentrationFunction
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X (N + 1)) mu) h ≤
      (Real.sqrt (2 * Real.pi))⁻¹ *
          ((Real.sqrt (N + 1 : ℝ))⁻¹ *
            (h * Real.sqrt (N + 2 : ℝ))) +
        2 * (berryEsseenConstant *
          (∫ omega, |X 0 omega| ^ 3 ∂mu) /
            Real.sqrt (N + 1 : ℝ)) := hbase
    _ ≤ _ := add_le_add
      (mul_le_mul_of_nonneg_left
        (normalizedCenteredIidSum_succ_intervalScale_le_sqrt_two N hh)
        (inv_nonneg.mpr (Real.sqrt_nonneg _))) le_rfl

/-- Closed-upper-tail form of the certified Berry--Esseen estimate for a
centered unit-variance iid family. Unlike a direct CDF rewrite, this remains
valid when the normalized sum has atoms. -/
theorem measureReal_Ici_normalizedCenteredIidSum_gap_le_berryEsseenConstant
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 3 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (hMean : ∫ omega, X 0 omega ∂mu = 0)
    (hSecond : ∫ omega, (X 0 omega) ^ 2 ∂mu = 1)
    {N : ℕ} (hN : 1 ≤ N) (t : ℝ) :
    |(NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
            X (fun i => (hX i).mono_exponent (by norm_num)) N).aemeasurable :
        Measure ℝ).real (Ici t) -
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw.real (Ici t)| ≤
      berryEsseenConstant *
        (∫ omega, |X 0 omega| ^ 3 ∂mu) /
          Real.sqrt (N + 1 : ℝ) := by
  exact (measureReal_Ici_gap_le_kolmogorovDistance _ _ t).trans
    (kolmogorovDistance_normalizedCenteredIidSum_le_berryEsseenConstant
      X hX hIndep hIdent hMean hSecond hN)

/-- Mean/variance-standardized closed-upper-tail Berry--Esseen estimate. This
is the reusable form corresponding to the normalization in Chapter 1. -/
theorem measureReal_Ici_normalizedIidSum_gap_le_berryEsseenConstant
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (m sigma : ℝ) (hsigma : 0 < sigma)
    (hX : ∀ i, MemLp (X i) 3 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (hMean : ∫ omega, X 0 omega ∂mu = m)
    (hVariance : ProbabilityTheory.variance (X 0) mu = sigma ^ 2)
    {N : ℕ} (hN : 1 ≤ N) (t : ℝ) :
    |(NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
          (NumStability.HDP.Scalar.LimitTheorems.normalizedIidSum X m sigma N)
          (NumStability.HDP.Scalar.LimitTheorems.normalizedIidSum_memLp
            X m sigma (fun i => (hX i).mono_exponent (by norm_num)) N).aemeasurable :
        Measure ℝ).real (Ici t) -
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw.real (Ici t)| ≤
      berryEsseenConstant *
        ((∫ omega, |X 0 omega - m| ^ 3 ∂mu) / sigma ^ 3) /
          Real.sqrt (N + 1 : ℝ) := by
  let Y : ℕ → Omega → ℝ := fun i omega => sigma⁻¹ * (X i omega - m)
  have hY : ∀ i, MemLp (Y i) 3 mu := by
    intro i
    exact ((hX i).sub (memLp_const m)).const_mul sigma⁻¹
  have hIndepY : ProbabilityTheory.iIndepFun Y mu := by
    have h := hIndep.comp
      (fun _ (x : ℝ) => sigma⁻¹ * (x - m)) (fun _ => by fun_prop)
    simpa [Y, Function.comp_def] using h
  have hIdentY : ∀ i, ProbabilityTheory.IdentDistrib (Y i) (Y 0) mu mu := by
    intro i
    have h := (hIdent i).comp
      (by fun_prop : Measurable fun x : ℝ => sigma⁻¹ * (x - m))
    simpa [Y, Function.comp_def] using h
  have hMeanY : ∫ omega, Y 0 omega ∂mu = 0 := by
    dsimp [Y]
    rw [integral_const_mul,
      integral_sub ((hX 0).integrable (by norm_num)) (integrable_const m), hMean]
    simp
  have hSecondY : ∫ omega, (Y 0 omega) ^ 2 ∂mu = 1 := by
    have hX2 : MemLp (X 0) 2 mu := (hX 0).mono_exponent (by norm_num)
    have hc : (∫ omega, (X 0 omega - m) ^ 2 ∂mu) = sigma ^ 2 := by
      calc
        (∫ omega, (X 0 omega - m) ^ 2 ∂mu) =
            ProbabilityTheory.variance (X 0) mu := by
          rw [ProbabilityTheory.variance_eq_integral hX2.aemeasurable, hMean]
        _ = sigma ^ 2 := hVariance
    dsimp [Y]
    calc
      (∫ omega, (sigma⁻¹ * (X 0 omega - m)) ^ 2 ∂mu) =
          ∫ omega, sigma⁻¹ ^ 2 * (X 0 omega - m) ^ 2 ∂mu := by
        congr 1
        funext omega
        ring
      _ = sigma⁻¹ ^ 2 * ∫ omega, (X 0 omega - m) ^ 2 ∂mu :=
        integral_const_mul _ _
      _ = 1 := by
        rw [hc]
        field_simp [hsigma.ne']
  have hEq :
      NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum Y N =
        NumStability.HDP.Scalar.LimitTheorems.normalizedIidSum X m sigma N := by
    funext omega
    simp only [NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum,
      NumStability.HDP.Scalar.LimitTheorems.normalizedIidSum, Y]
    rw [← Finset.mul_sum Finset.univ
      (fun i : Fin (N + 1) => X i.1 omega - m) sigma⁻¹]
    rw [← mul_assoc]
    apply congrArg
      (fun c : ℝ => c * ∑ i : Fin (N + 1), (X i.1 omega - m))
    rw [mul_inv_rev]
  have hThirdY :
      (∫ omega, |Y 0 omega| ^ 3 ∂mu) =
        (∫ omega, |X 0 omega - m| ^ 3 ∂mu) / sigma ^ 3 := by
    have hfun : (fun omega => |Y 0 omega| ^ 3) =
        fun omega => sigma⁻¹ ^ 3 * |X 0 omega - m| ^ 3 := by
      funext omega
      dsimp [Y]
      rw [abs_mul, abs_of_pos (inv_pos.mpr hsigma)]
      ring
    rw [hfun, integral_const_mul]
    field_simp [hsigma.ne']
  have htail :=
    measureReal_Ici_normalizedCenteredIidSum_gap_le_berryEsseenConstant
      Y hY hIndepY hIdentY hMeanY hSecondY hN t
  have hLaw :
      (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum Y N)
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
            Y (fun i => (hY i).mono_exponent (by norm_num)) N).aemeasurable :
        Measure ℝ) =
      (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
          (NumStability.HDP.Scalar.LimitTheorems.normalizedIidSum X m sigma N)
          (NumStability.HDP.Scalar.LimitTheorems.normalizedIidSum_memLp
            X m sigma (fun i => (hX i).mono_exponent (by norm_num)) N).aemeasurable :
        Measure ℝ) := by
    change Measure.map
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum Y N) mu =
      Measure.map
        (NumStability.HDP.Scalar.LimitTheorems.normalizedIidSum X m sigma N) mu
    rw [hEq]
  rw [hLaw, hThirdY] at htail
  exact htail

end NumStability.HDP.Scalar.BerryEsseen
