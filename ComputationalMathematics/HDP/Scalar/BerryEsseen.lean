    {σ : ℝ} (hσ : 0 < σ) :
    kolmogorovDistance
        (Measure.map
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum
            X (N + 1)) mu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      ((((3 * (Real.sqrt (2 * Real.pi))⁻¹) / σ ^ 3) / 6 *
          ((∫ omega, |X (N + 1) omega| ^ 3 ∂mu) +
            ∫ y, |y| ^ 3
              ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)) +
        (Real.sqrt (2 * Real.pi))⁻¹ *
          positiveScaledStandardNormalShiftedMomentBound σ) /
        (1 - 2 * (1 / 5)) +
        kolmogorovDistance
          (Measure.map
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
            mu)
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  let Sprev : Omega → ℝ := ∑ i ∈ Finset.range (N + 1), X i
  let lastLaw : Measure ℝ := Measure.map (X (N + 1)) mu
  let previousLaw : Measure ℝ := Measure.map Sprev mu
  have hXAEM : ∀ i, AEMeasurable (X i) mu := fun i => (hX i).aemeasurable
  have hSprev : AEMeasurable Sprev mu := by
    dsimp only [Sprev]
    fun_prop
  letI : IsProbabilityMeasure lastLaw :=
    Measure.isProbabilityMeasure_map (hX (N + 1)).aemeasurable
  letI : IsProbabilityMeasure previousLaw :=
    Measure.isProbabilityMeasure_map hSprev
  have hlast1 : Integrable (fun y : ℝ => y) lastLaw := by
    dsimp only [lastLaw]
    rw [integrable_map_measure (by fun_prop) (hX (N + 1)).aemeasurable]
    exact (hX (N + 1)).integrable (by norm_num)
  have hlast2 : Integrable (fun y : ℝ => y ^ 2) lastLaw := by
    dsimp only [lastLaw]
    rw [integrable_map_measure (by fun_prop) (hX (N + 1)).aemeasurable]
    exact ((hX (N + 1)).mono_exponent
      (by norm_num : (2 : ENNReal) ≤ 3)).integrable_sq
  have hlast3 : Integrable (fun y : ℝ => |y| ^ 3) lastLaw := by
    dsimp only [lastLaw]
    rw [integrable_map_measure (by fun_prop) (hX (N + 1)).aemeasurable]
    simpa only [Function.comp_apply, Real.norm_eq_abs] using
      (hX (N + 1)).integrable_norm_pow (by norm_num)
  have hlastMean : (∫ y, y ∂lastLaw) = 0 := by
    dsimp only [lastLaw]
    rw [integral_map (hX (N + 1)).aemeasurable (by fun_prop)]
    exact hMean
  have hlastSecond : (∫ y, y ^ 2 ∂lastLaw) = 1 := by
    dsimp only [lastLaw]
    rw [integral_map (hX (N + 1)).aemeasurable (by fun_prop)]
    exact hSecond
  have hlastThird :
      (∫ y, |y| ^ 3 ∂lastLaw) =
        ∫ omega, |X (N + 1) omega| ^ 3 ∂mu := by
    dsimp only [lastLaw]
    rw [integral_map (hX (N + 1)).aemeasurable (by fun_prop)]
  have hrec :=
    kolmogorovDistance_normalizedCenteredIidSum_succ_le_unscaledReplacement
      X hXAEM hIndep N
  have hreplace :=
    kolmogorovDistance_conv_le_gaussianSmoothedReplacement_markov_homogeneous
      previousLaw lastLaw hσ hlast1 hlast2 hlastMean hlastSecond hlast3
  rw [hlastThird] at hreplace
  exact hrec.trans (add_le_add hreplace le_rfl)

/-- A probability smoothing measure is band-limited at frequency `T` when
its characteristic function vanishes strictly outside `[-T, T]`. -/
def IsCharFunSupportedInFrequencyWindow (kappa : Measure ℝ) (T : ℝ) : Prop :=
  ∀ t, T < |t| → MeasureTheory.charFun kappa t = 0

/-- A common band-limited convolution turns the locally integrable
characteristic-function discrepancy quotient into a globally integrable one.
Outside the frequency window the common multiplier is exactly zero. -/
theorem integrable_charFunDiscrepancyQuotient_conv_of_bandLimited
    (mu nu kappa : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure nu] [IsProbabilityMeasure kappa]
    (hmu1 : Integrable (fun x : ℝ => |x|) mu)
    (hnu1 : Integrable (fun x : ℝ => |x|) nu)
    {T : ℝ} (hT : 0 ≤ T)
    (hkappa : IsCharFunSupportedInFrequencyWindow kappa T) :
    Integrable (charFunDiscrepancyQuotient
      (kappa ∗ mu) (kappa ∗ nu)) volume := by
  let S : Set ℝ := Icc (-T) T
  let q : ℝ → ℝ := charFunDiscrepancyQuotient mu nu
  have hTorder : -T ≤ T := by linarith
  have hqOn : IntegrableOn q S := by
    dsimp only [q, S]
    exact (intervalIntegrable_iff_integrableOn_Icc_of_le hTorder).mp
      (intervalIntegrable_charFunDiscrepancyQuotient hmu1 hnu1 (-T) T)
  have hmajor : Integrable (S.indicator q) volume :=
    hqOn.integrable_indicator measurableSet_Icc
  refine hmajor.mono'
    (stronglyMeasurable_charFunDiscrepancyQuotient
      (kappa ∗ mu) (kappa ∗ nu)).aestronglyMeasurable
    (ae_of_all volume fun t => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg
    (charFunDiscrepancyQuotient_nonneg (kappa ∗ mu) (kappa ∗ nu) t)]
  by_cases ht : t ∈ S
  · rw [Set.indicator_of_mem ht]
    exact charFunDiscrepancyQuotient_conv_le mu nu kappa t
  · simp only [Set.indicator_apply, ht, if_false]
    have htOutside : T < |t| := by
      by_contra hnot
      have habs : |t| ≤ T := le_of_not_gt hnot
      have hmem : t ∈ Icc (-T) T := (abs_le.mp habs)
      exact ht (by simpa only [S] using hmem)
    have hchar : MeasureTheory.charFun kappa t = 0 := hkappa t htOutside
    unfold charFunDiscrepancyQuotient
    split_ifs
    · rfl
    · rw [MeasureTheory.charFun_conv, MeasureTheory.charFun_conv, hchar]
      simp

/-- Convolution by an absolutely continuous probability kernel gives every
smoothed probability law an absolutely continuous, hence continuous, CDF. -/
theorem continuous_cdf_smoothingKernel_conv
    (mu kappa : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure kappa] (hkappa : kappa ≪ volume) :
    Continuous (cdf (kappa ∗ mu)) := by
  apply continuous_cdf_of_absolutelyContinuous
  rw [Measure.conv_comm]
  exact Measure.conv_absolutelyContinuous hkappa

/-- Fourier inversion for a common absolutely continuous smoothing kernel,
before the exact `-2π` frequency rescaling. -/
theorem cdfGap_smoothingKernel_conv_le_integral_discrepancy
    (mu nu kappa : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure nu] [IsProbabilityMeasure kappa]
    (hmu1 : Integrable (fun x : ℝ => |x|) mu)
    (hnu1 : Integrable (fun x : ℝ => |x|) nu)
    (hkappa1 : Integrable (fun x : ℝ => |x|) kappa)
    (hkappaAC : kappa ≪ volume)
    (hquot : Integrable (charFunDiscrepancyQuotient
      (kappa ∗ mu) (kappa ∗ nu)) volume)
    (x : ℝ) :
    cdfGap (kappa ∗ mu) (kappa ∗ nu) x ≤
      ∫ w : ℝ, charFunDiscrepancyQuotient
        (kappa ∗ mu) (kappa ∗ nu) ((-2 * Real.pi) * w) := by
  have hmuConv1 := integrable_abs_conv_of_firstMoments
    kappa mu hkappa1 hmu1
  have hnuConv1 := integrable_abs_conv_of_firstMoments
    kappa nu hkappa1 hnu1
  let f : ℝ → ℂ := fun y =>
    ((cdf (kappa ∗ mu) y - cdf (kappa ∗ nu) y : ℝ) : ℂ)
  have hf : Integrable f :=
    (integrable_cdf_sub_cdf_of_firstMoments
      (kappa ∗ mu) (kappa ∗ nu) hmuConv1 hnuConv1).ofReal
  have hFourier : Integrable (𝓕 f) := by
    exact integrable_fourier_cdf_sub_cdf_of_integrable_discrepancy
      (kappa ∗ mu) (kappa ∗ nu) hmuConv1 hnuConv1 hquot
  have hcont : Continuous f := by
    apply Complex.continuous_ofReal.comp
    exact (continuous_cdf_smoothingKernel_conv mu kappa hkappaAC).sub
      (continuous_cdf_smoothingKernel_conv nu kappa hkappaAC)
  have hinv : ‖f x‖ ≤ ∫ w : ℝ, ‖𝓕 f w‖ :=
    norm_le_integral_norm_fourier f hf hFourier (x := x) hcont.continuousAt
  calc
    cdfGap (kappa ∗ mu) (kappa ∗ nu) x = ‖f x‖ := by
      simp only [cdfGap, f, Complex.norm_real, Real.norm_eq_abs]
    _ ≤ ∫ w : ℝ, ‖𝓕 f w‖ := hinv
    _ = ∫ w : ℝ, charFunDiscrepancyQuotient
        (kappa ∗ mu) (kappa ∗ nu) ((-2 * Real.pi) * w) := by
      apply integral_congr_ae
      filter_upwards [volume.ae_ne (0 : ℝ)] with w hw
      dsimp only [f]
      convert norm_fourier_cdf_sub_cdf_eq_charFunDiscrepancyQuotient
        (kappa ∗ mu) (kappa ∗ nu) hmuConv1 hnuConv1 hw using 1

/-- The generic common-kernel inversion estimate after the exact `-2π`
change of variables. -/
theorem cdfGap_smoothingKernel_conv_le_integral_discrepancy_scaled
    (mu nu kappa : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure nu] [IsProbabilityMeasure kappa]
    (hmu1 : Integrable (fun x : ℝ => |x|) mu)
    (hnu1 : Integrable (fun x : ℝ => |x|) nu)
    (hkappa1 : Integrable (fun x : ℝ => |x|) kappa)
    (hkappaAC : kappa ≪ volume)
    (hquot : Integrable (charFunDiscrepancyQuotient
      (kappa ∗ mu) (kappa ∗ nu)) volume)
    (x : ℝ) :
    cdfGap (kappa ∗ mu) (kappa ∗ nu) x ≤
      (2 * Real.pi)⁻¹ * ∫ t : ℝ, charFunDiscrepancyQuotient
        (kappa ∗ mu) (kappa ∗ nu) t := by
  calc
    cdfGap (kappa ∗ mu) (kappa ∗ nu) x ≤
      ∫ w : ℝ, charFunDiscrepancyQuotient
        (kappa ∗ mu) (kappa ∗ nu) ((-2 * Real.pi) * w) :=
      cdfGap_smoothingKernel_conv_le_integral_discrepancy
        mu nu kappa hmu1 hnu1 hkappa1 hkappaAC hquot x
    _ = (2 * Real.pi)⁻¹ * ∫ t : ℝ, charFunDiscrepancyQuotient
        (kappa ∗ mu) (kappa ∗ nu) t := by
      rw [Measure.integral_comp_mul_left]
      have hpi : 0 < 2 * Real.pi := mul_pos (by norm_num) Real.pi_pos
      rw [show |(-2 * Real.pi)⁻¹| = (2 * Real.pi)⁻¹ by
        rw [abs_inv, show -2 * Real.pi = -(2 * Real.pi) by ring,
          abs_neg, abs_of_pos hpi]]
      rfl

/-- For a band-limited smoothing kernel, Fourier inversion only sees the
unsmoothed discrepancy quotient on the certified compact frequency window. -/
theorem cdfGap_bandLimitedSmoothingKernel_conv_le_local_discrepancy
    (mu nu kappa : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure nu] [IsProbabilityMeasure kappa]
    (hmu1 : Integrable (fun x : ℝ => |x|) mu)
    (hnu1 : Integrable (fun x : ℝ => |x|) nu)
    (hkappa1 : Integrable (fun x : ℝ => |x|) kappa)
    (hkappaAC : kappa ≪ volume)
    {T : ℝ} (hT : 0 ≤ T)
    (hkappa : IsCharFunSupportedInFrequencyWindow kappa T)
    (x : ℝ) :
    cdfGap (kappa ∗ mu) (kappa ∗ nu) x ≤
      (2 * Real.pi)⁻¹ *
        ∫ t in Icc (-T) T, charFunDiscrepancyQuotient mu nu t := by
  let S : Set ℝ := Icc (-T) T
  let q : ℝ → ℝ := charFunDiscrepancyQuotient mu nu
  let qk : ℝ → ℝ := charFunDiscrepancyQuotient
    (kappa ∗ mu) (kappa ∗ nu)
  have hqk : Integrable qk := by
    simpa only [qk] using
      integrable_charFunDiscrepancyQuotient_conv_of_bandLimited
        mu nu kappa hmu1 hnu1 hT hkappa
  have hTorder : -T ≤ T := by linarith
  have hqOn : IntegrableOn q S := by
    dsimp only [q, S]
    exact (intervalIntegrable_iff_integrableOn_Icc_of_le hTorder).mp
      (intervalIntegrable_charFunDiscrepancyQuotient hmu1 hnu1 (-T) T)
  have hmajor : Integrable (S.indicator q) :=
    hqOn.integrable_indicator measurableSet_Icc
  have hpoint : ∀ t, qk t ≤ S.indicator q t := by
    intro t
    by_cases ht : t ∈ S
    · rw [Set.indicator_of_mem ht]
      exact charFunDiscrepancyQuotient_conv_le mu nu kappa t
    · simp only [Set.indicator_apply, ht, if_false]
      have htOutside : T < |t| := by
        by_contra hnot
        have habs : |t| ≤ T := le_of_not_gt hnot
        have hmem : t ∈ Icc (-T) T := abs_le.mp habs
        exact ht (by simpa only [S] using hmem)
      have hchar : MeasureTheory.charFun kappa t = 0 := hkappa t htOutside
      dsimp only [qk]
      unfold charFunDiscrepancyQuotient
      split_ifs
      · rfl
      · rw [MeasureTheory.charFun_conv, MeasureTheory.charFun_conv, hchar]
        simp
  have hintegral :
      (∫ t, qk t) ≤ ∫ t in S, q t := by
    calc
      (∫ t, qk t) ≤ ∫ t, S.indicator q t :=
        integral_mono hqk hmajor hpoint
      _ = ∫ t in S, q t := integral_indicator measurableSet_Icc
  calc
    cdfGap (kappa ∗ mu) (kappa ∗ nu) x ≤
        (2 * Real.pi)⁻¹ * ∫ t, qk t := by
      exact cdfGap_smoothingKernel_conv_le_integral_discrepancy_scaled
        mu nu kappa hmu1 hnu1 hkappa1 hkappaAC hqk x
    _ ≤ (2 * Real.pi)⁻¹ * ∫ t in S, q t := by
      exact mul_le_mul_of_nonneg_left hintegral (by positivity)
    _ = _ := by rfl

/-- Band-limited Fourier comparison stated directly for the averaged CDFs
used by the deterministic tail-absorption theorem. -/
theorem smoothedCDF_gap_bandLimited_le_local_discrepancy
    (mu nu kappa : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure nu] [IsProbabilityMeasure kappa]
    (hmu1 : Integrable (fun x : ℝ => |x|) mu)
    (hnu1 : Integrable (fun x : ℝ => |x|) nu)
    (hkappa1 : Integrable (fun x : ℝ => |x|) kappa)
    (hkappaAC : kappa ≪ volume)
    {T : ℝ} (hT : 0 ≤ T)
    (hkappa : IsCharFunSupportedInFrequencyWindow kappa T)
    (x : ℝ) :
    |smoothedCDF mu kappa x - smoothedCDF nu kappa x| ≤
      (2 * Real.pi)⁻¹ *
        ∫ t in Icc (-T) T, charFunDiscrepancyQuotient mu nu t := by
  rw [smoothedCDF_eq_cdf_conv, smoothedCDF_eq_cdf_conv]
  exact cdfGap_bandLimitedSmoothingKernel_conv_le_local_discrepancy
    mu nu kappa hmu1 hnu1 hkappa1 hkappaAC hT hkappa x

/-- Complete abstract Esseen smoothing inequality for comparison with the
standard normal law.  All Fourier work is confined to `[-T,T]`; the remaining
kernel obligations are an absolutely continuous band-limited probability law
with finite first moment and two fixed spatial-tail bounds. -/
theorem kolmogorovDistance_standardNormal_le_bandLimitedSmoothingKernel
    (mu kappa : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure kappa]
    (hmu1 : Integrable (fun x : ℝ => |x|) mu)
    (hkappa1 : Integrable (fun x : ℝ => |x|) kappa)
    (hkappaAC : kappa ≪ volume)
    {T a q m : ℝ} (hT : 0 ≤ T) (hq : 2 * q < 1)
    (hkappaFreq : IsCharFunSupportedInFrequencyWindow kappa T)
    (hRightTail : kappa.real (Ioi a) ≤ q)
    (hLeftTail : kappa.real (Iio (-a)) ≤ q)
    (hRightMoment : (∫ y, |a - y| ∂kappa) ≤ m)
    (hLeftMoment : (∫ y, |-a - y| ∂kappa) ≤ m) :
    kolmogorovDistance mu
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      ((2 * Real.pi)⁻¹ *
          (∫ t in Icc (-T) T, charFunDiscrepancyQuotient mu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t) +
        (Real.sqrt (2 * Real.pi))⁻¹ * m) / (1 - 2 * q) := by
  have hkappaId : Integrable (fun y : ℝ => y) kappa := by
    apply hkappa1.mono' (by fun_prop)
    exact ae_of_all kappa fun y => by
      rw [Real.norm_eq_abs]
  apply kolmogorovDistance_le_of_smoothedCDF_with_tails
    mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw kappa
    hkappaId (by positivity) hq hRightTail hLeftTail
    hRightMoment hLeftMoment (fun u v => by
      simpa only using standardNormalCDF_lipschitz v u)
  intro x
  exact smoothedCDF_gap_bandLimited_le_local_discrepancy
    mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw kappa
    hmu1 integrable_abs_standardNormalLaw hkappa1 hkappaAC hT hkappaFreq x

/-- The removable cotangent factor in Prawitz's signed smoothing filter. -/
noncomputable def prawitzCotFactor (t : ℝ) : ℝ :=
  if t = 0 then 1 else Real.pi * t * Real.cot (Real.pi * t)

theorem prawitzCotFactor_zero : prawitzCotFactor 0 = 1 := by
  simp [prawitzCotFactor]

theorem prawitzCotFactor_neg (t : ℝ) :
    prawitzCotFactor (-t) = prawitzCotFactor t := by
  by_cases ht : t = 0
  · subst t
    simp [prawitzCotFactor]
  · rw [prawitzCotFactor, prawitzCotFactor, if_neg ht,
      if_neg (neg_ne_zero.mpr ht), Real.cot_eq_cos_div_sin,
      Real.cot_eq_cos_div_sin]
    have harg : Real.pi * -t = -(Real.pi * t) := by ring
    rw [harg, Real.cos_neg, Real.sin_neg]
    ring

/-- Real specialization of Mathlib's Mittag--Leffler expansion for cotangent
on the open unit interval. -/
theorem real_cot_series_rep
    {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    Real.pi * Real.cot (Real.pi * u) - 1 / u =
      ∑' n : ℕ,
        (1 / (u - ((n : ℝ) + 1)) + 1 / (u + ((n : ℝ) + 1))) := by
  have huC : (u : ℂ) ∈ Complex.integerComplement := by
    rw [Complex.mem_integerComplement_iff]
    rintro ⟨n, hn⟩
    apply_fun Complex.re at hn
    have hn' : (n : ℝ) = u := by simpa using hn
    have hn0 : (0 : ℤ) < n := by exact_mod_cast (hn' ▸ hu0)
    have hn1 : n < (1 : ℤ) := by exact_mod_cast (hn' ▸ hu1)
    omega
  have hc := cot_series_rep' huC
  have hs := summable_cotTerm huC
  have hre := congrArg Complex.re hc
  have hmap := (RCLike.reCLM : ℂ →L[ℝ] ℝ).map_tsum hs
  change
      (∑' n : ℕ,
        (1 / ((u : ℂ) - ((n : ℂ) + 1)) +
          1 / ((u : ℂ) + ((n : ℂ) + 1)))).re =
        ∑' n : ℕ,
          (1 / ((u : ℂ) - ((n : ℂ) + 1)) +
            1 / ((u : ℂ) + ((n : ℂ) + 1))).re at hmap
  rw [hmap] at hre
  have hcot :
      (Complex.cot ((Real.pi : ℂ) * (u : ℂ))).re =
        Real.cot (Real.pi * u) := by
    rw [← Complex.ofReal_mul]
    apply Complex.ofReal_injective
    rw [Complex.ofReal_cot_ofReal_re, Complex.ofReal_cot]
  simpa [Complex.mul_re, Complex.sub_re, hcot, Complex.div_re,
    Complex.normSq_apply] using hre

theorem summable_real_cot_series
    {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    Summable (fun n : ℕ =>
      (1 / (u - ((n : ℝ) + 1)) + 1 / (u + ((n : ℝ) + 1)))) := by
  have huC : (u : ℂ) ∈ Complex.integerComplement := by
    rw [Complex.mem_integerComplement_iff]
    rintro ⟨n, hn⟩
    apply_fun Complex.re at hn
    have hn' : (n : ℝ) = u := by simpa using hn
    have hn0 : (0 : ℤ) < n := by exact_mod_cast (hn' ▸ hu0)
    have hn1 : n < (1 : ℤ) := by exact_mod_cast (hn' ▸ hu1)
    omega
  have hs := summable_cotTerm huC
  have hmap := hs.map (RCLike.reCLM : ℂ →L[ℝ] ℝ)
    (RCLike.reCLM : ℂ →L[ℝ] ℝ).continuous
  simpa [Function.comp_def, Complex.div_re, Complex.normSq_apply] using hmap

theorem prawitzCotFactor_eq_one_add_mul_tsum
    {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    prawitzCotFactor u = 1 + u *
      ∑' n : ℕ,
        (1 / (u - ((n : ℝ) + 1)) + 1 / (u + ((n : ℝ) + 1))) := by
  have h := real_cot_series_rep hu0 hu1
  rw [prawitzCotFactor, if_neg hu0.ne']
  rw [show Real.pi * u * Real.cot (Real.pi * u) =
    u * (Real.pi * Real.cot (Real.pi * u)) by ring]
  rw [eq_add_of_sub_eq h]
  field_simp [hu0.ne']
  ring

/-- The positive inverse-square tail occurring in the spatial
Prawitz--Vaaler majorant remainder. -/
noncomputable def prawitzInverseSquareTail (x : ℝ) : ℝ :=
  ∑' n : ℕ, 1 / (x + (n : ℝ) + 1) ^ 2

theorem summable_prawitzInverseSquareTail (x : ℝ) :
    Summable (fun n : ℕ => 1 / (x + (n : ℝ) + 1) ^ 2) := by
  have h := (Real.summable_one_div_nat_add_rpow (x + 1) 2).2 (by norm_num)
  apply h.congr
  intro n
  rw [show (n : ℝ) + (x + 1) = x + (n : ℝ) + 1 by ring]
  simp [sq_abs]

/-- The inverse-cube tail is the derivative coordinate naturally paired
with `prawitzInverseSquareTail` on the positive half-line. -/
noncomputable def prawitzInverseCubeTail (x : ℝ) : ℝ :=
  ∑' n : ℕ, 1 / (x + (n : ℝ) + 1) ^ 3

/-- A summable, spatially uniform inverse-cube majorant for termwise
differentiation on the positive half-line. -/
theorem summable_two_div_nat_add_one_cube :
    Summable (fun n : ℕ => 2 / ((n : ℝ) + 1) ^ 3) := by
  have h := (Real.summable_one_div_nat_add_rpow 1 3).2 (by norm_num)
  have hcubic : Summable (fun n : ℕ => 1 / ((n : ℝ) + 1) ^ 3) := by
    apply h.congr
    intro n
    have hn : 0 ≤ (n : ℝ) + 1 := by positivity
    rw [abs_of_nonneg hn]
    exact congrArg (fun z : ℝ => 1 / z)
      (Real.rpow_natCast ((n : ℝ) + 1) 3)
  simpa [div_eq_mul_inv] using hcubic.mul_left 2

set_option maxHeartbeats 800000 in
/-- On `x > 0`, the inverse-square tail can be differentiated termwise;
its derivative is minus twice the positive inverse-cube tail. -/
theorem hasDerivAt_prawitzInverseSquareTail
    {x : ℝ} (hx : 0 < x) :
    HasDerivAt prawitzInverseSquareTail (-2 * prawitzInverseCubeTail x) x := by
  unfold prawitzInverseSquareTail prawitzInverseCubeTail
  have hg : ∀ n : ℕ, ∀ y : ℝ, y ∈ Ioi (0 : ℝ) →
      HasDerivAt (fun z : ℝ => 1 / (z + (n : ℝ) + 1) ^ 2)
        (-2 / (y + (n : ℝ) + 1) ^ 3) y := by
    intro n y hy
    change 0 < y at hy
    have hlin : HasDerivAt (fun z : ℝ => z + (n : ℝ) + 1) 1 y := by
      simpa using (((hasDerivAt_id y).add_const (n : ℝ)).add_const 1)
    have hden : y + (n : ℝ) + 1 ≠ 0 := by positivity
    have hpow := (hlin.pow 2).inv (pow_ne_zero 2 hden)
    simp only [one_div, Pi.pow_apply] at hpow ⊢
    convert hpow using 1
    field_simp [hden]
    ring
  have hg' : ∀ n : ℕ, ∀ y : ℝ, y ∈ Ioi (0 : ℝ) →
      ‖-2 / (y + (n : ℝ) + 1) ^ 3‖ ≤
        2 / ((n : ℝ) + 1) ^ 3 := by
    intro n y hy
    change 0 < y at hy
    rw [Real.norm_eq_abs, abs_div, abs_neg, abs_of_nonneg (by norm_num),
      abs_pow, abs_of_pos (by positivity)]
    have hbase : (n : ℝ) + 1 ≤ y + (n : ℝ) + 1 := by linarith
    exact div_le_div_of_nonneg_left (by norm_num) (by positivity)
      (pow_le_pow_left₀ (by positivity) hbase 3)
  have hseries : HasDerivAt
      (fun z : ℝ => ∑' n : ℕ, 1 / (z + (n : ℝ) + 1) ^ 2)
      (∑' n : ℕ, -2 / (x + (n : ℝ) + 1) ^ 3) x :=
    hasDerivAt_tsum_of_isPreconnected
      (u := fun n : ℕ => 2 / ((n : ℝ) + 1) ^ 3)
      (g := fun (n : ℕ) (y : ℝ) => 1 / (y + (n : ℝ) + 1) ^ 2)
      (g' := fun (n : ℕ) (y : ℝ) => -2 / (y + (n : ℝ) + 1) ^ 3)
      (t := Ioi (0 : ℝ)) (y₀ := (1 : ℝ))
      summable_two_div_nat_add_one_cube isOpen_Ioi isPreconnected_Ioi
      hg hg' (by norm_num) (summable_prawitzInverseSquareTail 1) hx
  convert hseries using 1
  rw [← tsum_mul_left]
  apply tsum_congr
  intro n
  ring

/-- Integral-test bound for the positive inverse-square tail, proved by a
telescoping majorant. -/
theorem prawitzInverseSquareTail_le_inv
    {x : ℝ} (hx : 0 < x) : prawitzInverseSquareTail x ≤ 1 / x := by
  have hterm (n : ℕ) :
      1 / (x + (n : ℝ) + 1) ^ 2 ≤
        1 / (x + (n : ℝ)) - 1 / (x + (n : ℝ) + 1) := by
    have hxn : 0 < x + (n : ℝ) := by positivity
    have hxns : 0 < x + (n : ℝ) + 1 := by positivity
    field_simp [hxn.ne', hxns.ne']
    nlinarith
  have hsum (N : ℕ) :
      (∑ n ∈ Finset.range N, 1 / (x + (n : ℝ) + 1) ^ 2) ≤ 1 / x := by
    calc
      _ ≤ ∑ n ∈ Finset.range N,
          (1 / (x + (n : ℝ)) - 1 / (x + (n : ℝ) + 1)) := by
        exact Finset.sum_le_sum fun n _ => hterm n
      _ = 1 / x - 1 / (x + (N : ℝ)) := by
        induction N with
        | zero => simp
        | succ N ih =>
            rw [Finset.sum_range_succ, ih]
            norm_num [Nat.cast_add, Nat.cast_one]
            ring
      _ ≤ 1 / x := sub_le_self _ (by positivity)
  unfold prawitzInverseSquareTail
  exact Real.tsum_le_of_sum_range_le
    (fun n => by positivity) (by simpa only [Finset.sum_range] using hsum)

/-- The initial inverse-square term together with the positive tail also
dominates `1 / x`. This is the complementary telescoping estimate needed on
the reflected spatial half-line. -/
theorem inv_le_inv_sq_add_prawitzInverseSquareTail
    {x : ℝ} (hx : 0 < x) :
    1 / x ≤ 1 / x ^ 2 + prawitzInverseSquareTail x := by
  let f : ℕ → ℝ := fun n => 1 / (x + (n : ℝ)) ^ 2
  have hsum : Summable f := by
    have h := summable_prawitzInverseSquareTail (x - 1)
    apply h.congr
    intro n
    dsimp only [f]
    congr 2
    ring
  have hterm (n : ℕ) :
      1 / (x + (n : ℝ)) - 1 / (x + (n : ℝ) + 1) ≤ f n := by
    have hxn : 0 < x + (n : ℝ) := by positivity
    have hxns : 0 < x + (n : ℝ) + 1 := by positivity
    dsimp only [f]
    field_simp [hxn.ne', hxns.ne']
    nlinarith
  have hfinite (N : ℕ) :
      1 / x - 1 / (x + (N : ℝ)) ≤
        ∑ n ∈ Finset.range N, f n := by
    calc
      _ = ∑ n ∈ Finset.range N,
          (1 / (x + (n : ℝ)) - 1 / (x + (n : ℝ) + 1)) := by
        induction N with
        | zero => simp
        | succ N ih =>
            rw [Finset.sum_range_succ, ← ih]
            norm_num [Nat.cast_add, Nat.cast_one]
            ring
      _ ≤ ∑ n ∈ Finset.range N, f n := by
        exact Finset.sum_le_sum fun n _ => hterm n
  have hle (N : ℕ) :
      1 / x - 1 / (x + (N : ℝ)) ≤ ∑' n, f n := by
    exact (hfinite N).trans
      (hsum.sum_le_tsum (Finset.range N)
        (fun n _ => by dsimp only [f]; positivity))
  have hden : Tendsto (fun N : ℕ => x + (N : ℝ)) atTop atTop := by
    exact tendsto_atTop.2 fun b =>
      (tendsto_natCast_atTop_atTop.eventually
        (eventually_ge_atTop (b - x))).mono (by
          intro N hN
          linarith)
  have hlim : Tendsto (fun N : ℕ => 1 / x - 1 / (x + (N : ℝ)))
      atTop (nhds (1 / x)) := by
    have hinv : Tendsto (fun N : ℕ => (x + (N : ℝ))⁻¹) atTop (nhds 0) :=
      tendsto_inv_atTop_zero.comp hden
    simpa only [one_div, sub_zero] using
      (tendsto_const_nhds.sub hinv :
        Tendsto (fun N : ℕ => x⁻¹ - (x + (N : ℝ))⁻¹) atTop
          (nhds (x⁻¹ - 0)))
  have hfull : 1 / x ≤ ∑' n, f n :=
    le_of_tendsto hlim (Filter.Eventually.of_forall hle)
  have hsplit := hsum.sum_add_tsum_nat_add 1
  have htail : (∑' n : ℕ, f (n + 1)) = prawitzInverseSquareTail x := by
    unfold prawitzInverseSquareTail
    apply tsum_congr
    intro n
    dsimp only [f]
    congr 2
    push_cast
    ring
  calc
    1 / x ≤ ∑' n, f n := hfull
    _ = f 0 + ∑' n : ℕ, f (n + 1) := by simpa using hsplit.symm
    _ = 1 / x ^ 2 + prawitzInverseSquareTail x := by rw [htail]; simp [f]

/-- Manifestly nonnegative spatial remainder in the Prawitz--Vaaler
majorant on the positive half-line. -/
noncomputable def prawitzVaalerPositiveRemainder (x : ℝ) : ℝ :=
  2 * (Real.sin (Real.pi * x) / Real.pi) ^ 2 *
    (1 / x - prawitzInverseSquareTail x)

theorem prawitzVaalerPositiveRemainder_nonneg
    {x : ℝ} (hx : 0 < x) :
    0 ≤ prawitzVaalerPositiveRemainder x := by
  unfold prawitzVaalerPositiveRemainder
  exact mul_nonneg (mul_nonneg (by norm_num) (sq_nonneg _))
    (sub_nonneg.mpr (prawitzInverseSquareTail_le_inv hx))

/-- Manifestly nonnegative spatial remainder in the reflected
Prawitz--Vaaler majorant on the negative half-line. -/
noncomputable def prawitzVaalerNegativeRemainder (x : ℝ) : ℝ :=
  2 * (Real.sin (Real.pi * x) / Real.pi) ^ 2 *
    (1 / x ^ 2 + prawitzInverseSquareTail x - 1 / x)

theorem prawitzVaalerNegativeRemainder_nonneg
    {x : ℝ} (hx : 0 < x) :
    0 ≤ prawitzVaalerNegativeRemainder x := by
  unfold prawitzVaalerNegativeRemainder
  exact mul_nonneg (mul_nonneg (by norm_num) (sq_nonneg _))
    (sub_nonneg.mpr (inv_le_inv_sq_add_prawitzInverseSquareTail hx))

/-- The two spatial remainders add to the Fejér kernel at scale `π`. -/
theorem prawitzVaalerPositiveRemainder_add_negative
    {x : ℝ} (hx : x ≠ 0) :
    prawitzVaalerPositiveRemainder x +
        prawitzVaalerNegativeRemainder x =
      2 * (Real.sin (Real.pi * x) / (Real.pi * x)) ^ 2 := by
  unfold prawitzVaalerPositiveRemainder prawitzVaalerNegativeRemainder
  field_simp [Real.pi_ne_zero, hx]
  ring

/-- The right-continuous centered half-line step `2 * 1_[0,∞) - 1`. -/
noncomputable def centeredHalfLineStep (x : ℝ) : ℝ :=
  if x < 0 then -1 else 1

theorem centeredHalfLineStep_eq_indicator (x : ℝ) :
    centeredHalfLineStep x =
      2 * (Ici (0 : ℝ)).indicator (fun _ : ℝ => (1 : ℝ)) x - 1 := by
  by_cases hx : x < 0
  · simp [centeredHalfLineStep, hx, not_le.mpr hx]
  · simp [centeredHalfLineStep, hx, le_of_not_gt hx]
    norm_num

/-- Piecewise spatial form of the Beurling--Selberg majorant associated to
Prawitz's signed smoothing filter. -/
noncomputable def prawitzVaalerMajorant (x : ℝ) : ℝ :=
  if 0 < x then 1 + prawitzVaalerPositiveRemainder x
  else if x < 0 then -1 + prawitzVaalerNegativeRemainder (-x)
  else 1

/-- The explicit spatial Prawitz--Vaaler function majorizes the centered
right-continuous half-line step. -/
theorem centeredHalfLineStep_le_prawitzVaalerMajorant (x : ℝ) :
    centeredHalfLineStep x ≤ prawitzVaalerMajorant x := by
  by_cases hxpos : 0 < x
  · rw [centeredHalfLineStep, prawitzVaalerMajorant,
      if_pos hxpos, if_neg (not_lt_of_ge hxpos.le)]
    linarith [prawitzVaalerPositiveRemainder_nonneg hxpos]
  · by_cases hxneg : x < 0
    · rw [centeredHalfLineStep, prawitzVaalerMajorant,
        if_neg hxpos, if_pos hxneg, if_pos hxneg]
      linarith [prawitzVaalerNegativeRemainder_nonneg (neg_pos.mpr hxneg)]
    · have hx : x = 0 := by linarith
      subst x
      simp [centeredHalfLineStep, prawitzVaalerMajorant]

theorem measurable_prawitzCotFactor : Measurable prawitzCotFactor := by
  unfold prawitzCotFactor
  apply Measurable.ite (measurableSet_singleton 0) measurable_const
  simp_rw [Real.cot_eq_cos_div_sin]
  fun_prop

/-- The endpoint weight cancels the cotangent singularity uniformly on the
positive half of Prawitz's unit frequency window. -/
theorem abs_one_sub_mul_prawitzCotFactor_le_two
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    |(1 - u) * prawitzCotFactor u| ≤ 2 := by
  rcases hu0.eq_or_lt with rfl | hu0
  · simp [prawitzCotFactor]
  have hu0' : u ≠ 0 := hu0.ne'
  have hOne : 0 ≤ 1 - u := sub_nonneg.mpr hu1.le
  have hArg0 : 0 < Real.pi * u := mul_pos Real.pi_pos hu0
  have hArgPi : Real.pi * u < Real.pi := by
    nlinarith [mul_pos Real.pi_pos (sub_pos.mpr hu1)]
  have hSin : 0 < Real.sin (Real.pi * u) :=
    Real.sin_pos_of_pos_of_lt_pi hArg0 hArgPi
  rw [prawitzCotFactor, if_neg hu0', Real.cot_eq_cos_div_sin]
  have hFormula :
      |(1 - u) * (Real.pi * u *
          (Real.cos (Real.pi * u) / Real.sin (Real.pi * u)))| =
        (1 - u) * Real.pi * u * |Real.cos (Real.pi * u)| /
          Real.sin (Real.pi * u) := by
    rw [abs_mul, abs_mul, abs_div, abs_of_nonneg hOne,
      abs_of_pos hArg0, abs_of_pos hSin]
    ring
  rw [hFormula]
  apply (div_le_iff₀ hSin).2
  have hCos : |Real.cos (Real.pi * u)| ≤ 1 := Real.abs_cos_le_one _
  have hWeighted :
      (1 - u) * Real.pi * u * |Real.cos (Real.pi * u)| ≤
        (1 - u) * Real.pi * u := by
    simpa only [mul_one] using
      mul_le_mul_of_nonneg_left hCos
        (mul_nonneg (mul_nonneg hOne Real.pi_pos.le) hu0.le)
  apply hWeighted.trans
  by_cases huHalf : u ≤ 1 / 2
  · have hArgHalf : Real.pi * u ≤ Real.pi / 2 := by
      nlinarith [Real.pi_pos]
    have hJordan : 2 * u ≤ Real.sin (Real.pi * u) := by
      have := Real.mul_le_sin hArg0.le hArgHalf
      convert this using 1; field_simp [Real.pi_ne_zero]
    have hNum : (1 - u) * Real.pi * u ≤ 4 * u := by
      calc
        (1 - u) * Real.pi * u = (1 - u) * (Real.pi * u) := by ring
        _ ≤ 1 * (Real.pi * u) :=
          mul_le_mul_of_nonneg_right (by linarith) hArg0.le
        _ = Real.pi * u := by ring
        _ ≤ 4 * u := mul_le_mul_of_nonneg_right Real.pi_le_four hu0.le
    nlinarith
  · have huHalf' : 1 / 2 ≤ u := le_of_not_ge huHalf
    have hOneHalf : 1 - u ≤ 1 / 2 := by linarith
    have hArgHalf : Real.pi * (1 - u) ≤ Real.pi / 2 := by
      nlinarith [Real.pi_pos]
    have hJordan' : 2 * (1 - u) ≤ Real.sin (Real.pi * u) := by
      have hj := Real.mul_le_sin
        (mul_nonneg Real.pi_pos.le hOne) hArgHalf
      have hSinEq : Real.sin (Real.pi * (1 - u)) =
          Real.sin (Real.pi * u) := by
        rw [show Real.pi * (1 - u) = Real.pi - Real.pi * u by ring,
          Real.sin_pi_sub]
      rw [hSinEq] at hj
      convert hj using 1; field_simp [Real.pi_ne_zero]
    have hPiU : Real.pi * u ≤ 4 := by
      calc
        Real.pi * u ≤ Real.pi * 1 :=
          mul_le_mul_of_nonneg_left hu1.le Real.pi_pos.le
        _ ≤ 4 := by simpa using Real.pi_le_four
    have hNum : (1 - u) * Real.pi * u ≤ 4 * (1 - u) := by
      nlinarith
    nlinarith

/-- Prawitz's compactly supported signed smoothing filter. Its real part is
even, its imaginary part is odd, and the value at zero is supplied by the
removable limit of the cotangent factor. -/
noncomputable def prawitzSmoothingFilter (t : ℝ) : ℂ :=
  if |t| < 1 then
    (((1 - |t|) * prawitzCotFactor t + |t| : ℝ) : ℂ) -
      (((1 - |t|) * Real.pi * t : ℝ) : ℂ) * Complex.I
  else 0

theorem prawitzSmoothingFilter_zero : prawitzSmoothingFilter 0 = 1 := by
  simp [prawitzSmoothingFilter, prawitzCotFactor]

theorem prawitzSmoothingFilter_eq_zero_of_one_le_abs
    {t : ℝ} (ht : 1 ≤ |t|) :
    prawitzSmoothingFilter t = 0 := by
  simp [prawitzSmoothingFilter, not_lt.mpr ht]

theorem prawitzSmoothingFilter_neg (t : ℝ) :
    prawitzSmoothingFilter (-t) =
      (starRingEnd ℂ) (prawitzSmoothingFilter t) := by
  by_cases ht : |t| < 1
  · rw [prawitzSmoothingFilter, prawitzSmoothingFilter,
      if_pos ht, if_pos (by simpa only [abs_neg] using ht),
      abs_neg, prawitzCotFactor_neg]
    apply Complex.ext <;> simp
  · have ht' : ¬ |-t| < 1 := by simpa only [abs_neg] using ht
    rw [prawitzSmoothingFilter, prawitzSmoothingFilter,
      if_neg ht, if_neg ht']
    simp

theorem measurable_prawitzSmoothingFilter :
    Measurable prawitzSmoothingFilter := by
  have habs : Measurable fun t : ℝ => |t| := by fun_prop
  have hre : Measurable fun t : ℝ =>
      (1 - |t|) * prawitzCotFactor t + |t| :=
    ((measurable_const.sub habs).mul measurable_prawitzCotFactor).add habs
  have him : Measurable fun t : ℝ =>
      (1 - |t|) * Real.pi * t :=
    ((measurable_const.sub habs).mul measurable_const).mul measurable_id
  unfold prawitzSmoothingFilter
  apply Measurable.ite (measurableSet_lt habs measurable_const)
  · exact (Complex.continuous_ofReal.measurable.comp hre).sub
      ((Complex.continuous_ofReal.measurable.comp him).mul measurable_const)
  · exact measurable_const

/-- Exact real part of the Prawitz filter on the positive unit window. -/
theorem prawitzSmoothingFilter_re_of_mem_Ico
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    (prawitzSmoothingFilter u).re =
      (1 - u) * prawitzCotFactor u + u := by
  rw [prawitzSmoothingFilter, if_pos (by simpa [abs_of_nonneg hu0] using hu1),
    abs_of_nonneg hu0]
  simp

/-- Exact imaginary part of the Prawitz filter on the positive unit window. -/
theorem prawitzSmoothingFilter_im_of_mem_Ico
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    (prawitzSmoothingFilter u).im =
      -((1 - u) * Real.pi * u) := by
  rw [prawitzSmoothingFilter, if_pos (by simpa [abs_of_nonneg hu0] using hu1),
    abs_of_nonneg hu0]
  simp

/-- Exact squared norm of the Prawitz filter on the positive unit window. -/
theorem sq_norm_prawitzSmoothingFilter_of_mem_Ico
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    ‖prawitzSmoothingFilter u‖ ^ 2 =
      ((1 - u) * prawitzCotFactor u + u) ^ 2 +
        ((1 - u) * Real.pi * u) ^ 2 := by
  rw [Complex.sq_norm, Complex.normSq_apply,
    prawitzSmoothingFilter_re_of_mem_Ico hu0 hu1,
    prawitzSmoothingFilter_im_of_mem_Ico hu0 hu1]
  ring

/-- Exact norm of the Prawitz filter on the positive unit window. -/
theorem norm_prawitzSmoothingFilter_of_mem_Ico
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    ‖prawitzSmoothingFilter u‖ =
      Real.sqrt (((1 - u) * prawitzCotFactor u + u) ^ 2 +
        ((1 - u) * Real.pi * u) ^ 2) := by
  rw [Complex.norm_def, Complex.normSq_apply,
    prawitzSmoothingFilter_re_of_mem_Ico hu0 hu1,
    prawitzSmoothingFilter_im_of_mem_Ico hu0 hu1]
  congr 1
  ring

/-- The cotangent factor is nonnegative on the first half of the positive
unit window. -/
theorem prawitzCotFactor_nonneg_of_mem_Ioc_half
    {u : ℝ} (hu0 : 0 < u) (huHalf : u ≤ 1 / 2) :
    0 ≤ prawitzCotFactor u := by
  have hx0 : 0 < Real.pi * u := mul_pos Real.pi_pos hu0
  have hxHalf : Real.pi * u ≤ Real.pi / 2 := by
    nlinarith [Real.pi_pos]
  have hsin : 0 < Real.sin (Real.pi * u) := by
    apply Real.sin_pos_of_pos_of_lt_pi hx0
    nlinarith [Real.pi_pos]
  have hcos : 0 ≤ Real.cos (Real.pi * u) :=
    Real.cos_nonneg_of_neg_pi_div_two_le_of_le (by linarith [Real.pi_pos]) hxHalf
  rw [prawitzCotFactor, if_neg hu0.ne', Real.cot_eq_cos_div_sin]
  positivity

/-- The positive first-half cotangent factor is at most its removable value
at zero. -/
theorem prawitzCotFactor_le_one_of_mem_Ioo_half
    {u : ℝ} (hu0 : 0 < u) (huHalf : u < 1 / 2) :
    prawitzCotFactor u ≤ 1 := by
  have hx0 : 0 < Real.pi * u := mul_pos Real.pi_pos hu0
  have hxHalf : Real.pi * u < Real.pi / 2 := by
    nlinarith [Real.pi_pos]
  have htanPos := Real.tan_pos_of_pos_of_lt_pi_div_two hx0 hxHalf
  have htan := Real.le_tan hx0.le hxHalf
  rw [prawitzCotFactor, if_neg hu0.ne', ← Real.tan_inv_eq_cot,
    ← div_eq_mul_inv, div_le_one htanPos]
  exact htan

/-- The positive first-half cotangent factor is at most one, including the
midpoint endpoint. -/
theorem prawitzCotFactor_le_one_of_mem_Ioc_half
    {u : ℝ} (hu0 : 0 < u) (huHalf : u ≤ 1 / 2) :
    prawitzCotFactor u ≤ 1 := by
  rcases huHalf.eq_or_lt with rfl | huHalf
  · rw [prawitzCotFactor, if_neg (by norm_num : (1 / 2 : ℝ) ≠ 0)]
    rw [show Real.pi * (1 / 2 : ℝ) = Real.pi / 2 by ring,
      Real.cot_eq_cos_div_sin]
    simp
  · exact prawitzCotFactor_le_one_of_mem_Ioo_half hu0 huHalf

/-- On the positive first half-window the cotangent factor dominates the
corresponding cosine. -/
theorem cos_pi_mul_le_prawitzCotFactor_of_mem_Ioc_half
    {u : ℝ} (hu0 : 0 < u) (huHalf : u ≤ 1 / 2) :
    Real.cos (Real.pi * u) ≤ prawitzCotFactor u := by
  have hx0 : 0 < Real.pi * u := mul_pos Real.pi_pos hu0
  have hxHalf : Real.pi * u ≤ Real.pi / 2 := by
    nlinarith [Real.pi_pos]
  have hsin : 0 < Real.sin (Real.pi * u) := by
    apply Real.sin_pos_of_pos_of_lt_pi hx0
    nlinarith [Real.pi_pos]
  have hcos : 0 ≤ Real.cos (Real.pi * u) :=
    Real.cos_nonneg_of_neg_pi_div_two_le_of_le
      (by linarith [Real.pi_pos]) hxHalf
  have hsinx : Real.sin (Real.pi * u) ≤ Real.pi * u :=
    Real.sin_le hx0.le
  rw [prawitzCotFactor, if_neg hu0.ne', Real.cot_eq_cos_div_sin]
  rw [show Real.pi * u *
      (Real.cos (Real.pi * u) / Real.sin (Real.pi * u)) =
      (Real.pi * u * Real.cos (Real.pi * u)) /
        Real.sin (Real.pi * u) by ring]
  exact (le_div_iff₀ hsin).2
    (by simpa only [mul_comm] using
      mul_le_mul_of_nonneg_right hsinx hcos)

/-- The cotangent factor is nonpositive on the second half of the positive
unit window. -/
theorem prawitzCotFactor_nonpos_of_half_le
    {u : ℝ} (huHalf : 1 / 2 ≤ u) (hu1 : u < 1) :
    prawitzCotFactor u ≤ 0 := by
  have hu0 : 0 < u := by linarith
  have hx0 : 0 < Real.pi * u := mul_pos Real.pi_pos hu0
  have hxPi : Real.pi * u < Real.pi := by
    nlinarith [Real.pi_pos]
  have hxHalf : Real.pi / 2 ≤ Real.pi * u := by
    nlinarith [Real.pi_pos]
  have hsin : 0 < Real.sin (Real.pi * u) :=
    Real.sin_pos_of_pos_of_lt_pi hx0 hxPi
  have hcos : Real.cos (Real.pi * u) ≤ 0 :=
    Real.cos_nonpos_of_pi_div_two_le_of_le hxHalf (by linarith [Real.pi_pos])
  rw [prawitzCotFactor, if_neg hu0.ne', Real.cot_eq_cos_div_sin]
  exact mul_nonpos_of_nonneg_of_nonpos hx0.le
    (div_nonpos_of_nonpos_of_nonneg hcos hsin.le)

/-- Reflection through the midpoint exchanges the weighted cotangent terms. -/
theorem one_sub_mul_prawitzCotFactor_eq
    {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    (1 - u) * prawitzCotFactor u =
      -u * prawitzCotFactor (1 - u) := by
  have hOne : 1 - u ≠ 0 := sub_ne_zero.mpr hu1.ne'
  rw [prawitzCotFactor, if_neg hu0.ne', prawitzCotFactor, if_neg hOne]
  have hcot : Real.cot (Real.pi * (1 - u)) =
      -Real.cot (Real.pi * u) := by
    rw [show Real.pi * (1 - u) = Real.pi - Real.pi * u by ring,
      Real.cot_eq_cos_div_sin, Real.cot_eq_cos_div_sin,
      Real.cos_pi_sub, Real.sin_pi_sub]
    ring
  rw [hcot]
  ring

/-- The real part of the positive-window Prawitz filter is nonnegative. -/
theorem prawitzSmoothingFilter_re_nonneg_of_mem_Ico
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    0 ≤ (prawitzSmoothingFilter u).re := by
  rw [prawitzSmoothingFilter_re_of_mem_Ico hu0 hu1]
  rcases hu0.eq_or_lt with rfl | hu0
  · simp [prawitzCotFactor]
  by_cases huHalf : u ≤ 1 / 2
  · have hcot := prawitzCotFactor_nonneg_of_mem_Ioc_half hu0 huHalf
    have hOne : 0 ≤ 1 - u := sub_nonneg.mpr hu1.le
    nlinarith [mul_nonneg hOne hcot]
  · have hOne0 : 0 < 1 - u := sub_pos.mpr hu1
    have hOneHalf : 1 - u < 1 / 2 := by linarith [lt_of_not_ge huHalf]
    have hcot := prawitzCotFactor_le_one_of_mem_Ioo_half hOne0 hOneHalf
    rw [one_sub_mul_prawitzCotFactor_eq hu0 hu1]
    nlinarith

/-- The real part of the positive-window Prawitz filter is at most one. -/
theorem prawitzSmoothingFilter_re_le_one_of_mem_Ico
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    (prawitzSmoothingFilter u).re ≤ 1 := by
  rw [prawitzSmoothingFilter_re_of_mem_Ico hu0 hu1]
  rcases hu0.eq_or_lt with rfl | hu0
  · simp [prawitzCotFactor]
  by_cases huHalf : u < 1 / 2
  · have hcot := prawitzCotFactor_le_one_of_mem_Ioo_half hu0 huHalf
    have hOne : 0 ≤ 1 - u := sub_nonneg.mpr hu1.le
    nlinarith
  · have hcot := prawitzCotFactor_nonpos_of_half_le (le_of_not_gt huHalf) hu1
    have hOne : 0 ≤ 1 - u := sub_nonneg.mpr hu1.le
    nlinarith

/-- The exact imaginary part and the unit bound on the real part give a
square-root norm majorant. -/
theorem norm_prawitzSmoothingFilter_le_sqrt_one_add_sq
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    ‖prawitzSmoothingFilter u‖ ≤
      Real.sqrt (1 + ((1 - u) * Real.pi * u) ^ 2) := by
  rw [norm_prawitzSmoothingFilter_of_mem_Ico hu0 hu1]
  apply Real.sqrt_le_sqrt
  have hre0 := prawitzSmoothingFilter_re_nonneg_of_mem_Ico hu0 hu1
  have hre1 := prawitzSmoothingFilter_re_le_one_of_mem_Ico hu0 hu1
  rw [prawitzSmoothingFilter_re_of_mem_Ico hu0 hu1] at hre0 hre1
  nlinarith

/-- Elementary polynomial majorant for `sqrt (1 + x^2)`. -/
theorem sqrt_one_add_sq_le_one_add_half_sq (x : ℝ) :
    Real.sqrt (1 + x ^ 2) ≤ 1 + x ^ 2 / 2 := by
  rw [Real.sqrt_le_iff]
  constructor
  · positivity
  · nlinarith [sq_nonneg (x ^ 2)]

/-- Polynomial positive-window majorant for the Prawitz filter norm. -/
theorem norm_prawitzSmoothingFilter_le_one_add_half_im_sq
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    ‖prawitzSmoothingFilter u‖ ≤
      1 + ((1 - u) * Real.pi * u) ^ 2 / 2 :=
  (norm_prawitzSmoothingFilter_le_sqrt_one_add_sq hu0 hu1).trans
    (sqrt_one_add_sq_le_one_add_half_sq _)

/-- Uniform consequence of the polynomial norm majorant on the positive unit
window. -/
theorem norm_prawitzSmoothingFilter_le_one_add_pi_sq_div_thirtytwo
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    ‖prawitzSmoothingFilter u‖ ≤ 1 + Real.pi ^ 2 / 32 := by
  have hprod0 : 0 ≤ (1 - u) * u :=
    mul_nonneg (sub_nonneg.mpr hu1.le) hu0
  have hprod : (1 - u) * u ≤ 1 / 4 := by
    nlinarith [sq_nonneg (u - 1 / 2)]
  have hb0 : 0 ≤ (1 - u) * Real.pi * u := by
    rw [show (1 - u) * Real.pi * u = Real.pi * ((1 - u) * u) by ring]
    exact mul_nonneg Real.pi_pos.le hprod0
  have hb : (1 - u) * Real.pi * u ≤ Real.pi / 4 := by
    calc
      (1 - u) * Real.pi * u = Real.pi * ((1 - u) * u) := by ring
      _ ≤ Real.pi * (1 / 4) :=
        mul_le_mul_of_nonneg_left hprod Real.pi_pos.le
      _ = Real.pi / 4 := by ring
  have hbSq := mul_self_le_mul_self hb0 hb
  calc
    ‖prawitzSmoothingFilter u‖ ≤
        1 + ((1 - u) * Real.pi * u) ^ 2 / 2 :=
      norm_prawitzSmoothingFilter_le_one_add_half_im_sq hu0 hu1
    _ ≤ 1 + Real.pi ^ 2 / 32 := by
      rw [pow_two, pow_two]
      nlinarith [hbSq]

/-- The Prawitz filter vanishes linearly at the upper endpoint of its positive
unit window. -/
theorem norm_prawitzSmoothingFilter_le_endpoint_linear
    {u : ℝ} (huHalf : 1 / 2 ≤ u) (hu1 : u < 1) :
    ‖prawitzSmoothingFilter u‖ ≤
      (Real.pi ^ 2 / 2 + Real.pi) * (1 - u) := by
  let v : ℝ := 1 - u
  have hu0 : 0 < u := by linarith
  have huOne : u ≤ 1 := hu1.le
  have hv0 : 0 < v := by dsimp only [v]; linarith
  have hvHalf : v ≤ 1 / 2 := by dsimp only [v]; linarith
  have hvOne : v ≤ 1 := hvHalf.trans (by norm_num)
  have hcot1 : prawitzCotFactor v ≤ 1 :=
    prawitzCotFactor_le_one_of_mem_Ioc_half hv0 hvHalf
  have hcosCot : Real.cos (Real.pi * v) ≤ prawitzCotFactor v :=
    cos_pi_mul_le_prawitzCotFactor_of_mem_Ioc_half hv0 hvHalf
  have hcosTaylor := Real.one_sub_sq_div_two_le_cos (x := Real.pi * v)
  have hfactor0 : 0 ≤ 1 - prawitzCotFactor v := by linarith
  have hfactor : 1 - prawitzCotFactor v ≤ (Real.pi * v) ^ 2 / 2 := by
    linarith
  have hvSq : v ^ 2 ≤ v := by
    nlinarith [mul_nonneg hv0.le (sub_nonneg.mpr hvOne)]
  have hreEq : (prawitzSmoothingFilter u).re =
      u * (1 - prawitzCotFactor v) := by
    rw [prawitzSmoothingFilter_re_of_mem_Ico hu0.le hu1,
      one_sub_mul_prawitzCotFactor_eq hu0 hu1]
    dsimp only [v]
    ring
  have hre0 : 0 ≤ (prawitzSmoothingFilter u).re := by
    rw [hreEq]
    positivity
  have hre : (prawitzSmoothingFilter u).re ≤
      Real.pi ^ 2 / 2 * v := by
    rw [hreEq]
    calc
      u * (1 - prawitzCotFactor v) ≤ 1 * ((Real.pi * v) ^ 2 / 2) :=
        mul_le_mul huOne hfactor hfactor0 (by positivity)
      _ ≤ Real.pi ^ 2 / 2 * v := by
        nlinarith [sq_nonneg Real.pi, hvSq]
  have himEq : (prawitzSmoothingFilter u).im = -(v * Real.pi * u) := by
    rw [prawitzSmoothingFilter_im_of_mem_Ico hu0.le hu1]
  have him : |(prawitzSmoothingFilter u).im| ≤ Real.pi * v := by
    rw [himEq, abs_neg, abs_of_nonneg (by positivity : 0 ≤ v * Real.pi * u)]
    nlinarith [mul_nonneg Real.pi_pos.le hv0.le]
  calc
    ‖prawitzSmoothingFilter u‖ ≤
        |(prawitzSmoothingFilter u).re| +
          |(prawitzSmoothingFilter u).im| :=
      Complex.norm_le_abs_re_add_abs_im _
    _ = (prawitzSmoothingFilter u).re +
          |(prawitzSmoothingFilter u).im| := by rw [abs_of_nonneg hre0]
    _ ≤ Real.pi ^ 2 / 2 * v + Real.pi * v := add_le_add hre him
    _ = (Real.pi ^ 2 / 2 + Real.pi) * (1 - u) := by
      dsimp only [v]
      ring

/-- A coarse uniform norm bound for the Prawitz filter on the positive unit
window. The constant is chosen for a robust integrability majorant. -/
theorem norm_prawitzSmoothingFilter_le_seven
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    ‖prawitzSmoothingFilter u‖ ≤ 7 := by
  have habs : |u| = u := abs_of_nonneg hu0
  rw [prawitzSmoothingFilter, if_pos (by simpa [habs] using hu1), habs]
  let a : ℝ := (1 - u) * prawitzCotFactor u + u
  let b : ℝ := (1 - u) * Real.pi * u
  have ha : |a| ≤ 3 := by
    calc
      |a| ≤ |(1 - u) * prawitzCotFactor u| + |u| := by
        dsimp only [a]
        exact abs_add_le _ _
      _ ≤ 2 + u := by
        gcongr
        · exact abs_one_sub_mul_prawitzCotFactor_le_two hu0 hu1
        · exact habs.le
      _ ≤ 3 := by linarith
  have hb : |b| ≤ 4 := by
    have hOne : 0 ≤ 1 - u := sub_nonneg.mpr hu1.le
    have hb0 : 0 ≤ b := by dsimp only [b]; positivity
    rw [abs_of_nonneg hb0]
    calc
      b ≤ Real.pi * u := by
        dsimp only [b]
        nlinarith [mul_nonneg Real.pi_pos.le hu0]
      _ ≤ 4 * u := mul_le_mul_of_nonneg_right Real.pi_le_four hu0
      _ ≤ 4 := by linarith
  change ‖(a : ℂ) - (b : ℂ) * Complex.I‖ ≤ 7
  calc
    ‖(a : ℂ) - (b : ℂ) * Complex.I‖ ≤
        ‖(a : ℂ)‖ + ‖(b : ℂ) * Complex.I‖ := norm_sub_le _ _
    _ = |a| + |b| := by
      rw [norm_mul, Complex.norm_real, Complex.norm_real,
        Complex.norm_I, mul_one, Real.norm_eq_abs, Real.norm_eq_abs]
    _ ≤ 7 := by linarith

/-- The odd imaginary part of the Prawitz filter vanishes linearly at zero. -/
theorem abs_im_prawitzSmoothingFilter_le
    {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    |(prawitzSmoothingFilter u).im| ≤ Real.pi * u := by
  have habs : |u| = u := abs_of_nonneg hu0
  rw [prawitzSmoothingFilter, if_pos (by simpa [habs] using hu1), habs]
  simp only [Complex.sub_im, Complex.ofReal_im, Complex.mul_im,
    Complex.ofReal_re, Complex.I_im, Complex.I_re, zero_mul, mul_one,
    zero_sub, abs_neg, add_zero]
  have hOne : 0 ≤ 1 - u := sub_nonneg.mpr hu1.le
  rw [abs_of_nonneg (mul_nonneg (mul_nonneg hOne Real.pi_pos.le) hu0)]
  nlinarith [mul_nonneg Real.pi_pos.le hu0]

/-- Frequency dilation of the Prawitz filter to the symmetric window
`[-T,T]`. -/
noncomputable def scaledPrawitzSmoothingFilter (T t : ℝ) : ℂ :=
  prawitzSmoothingFilter (t / T)

theorem scaledPrawitzSmoothingFilter_re_of_mem_Ico
    {T t : ℝ} (hT : 0 < T) (ht0 : 0 ≤ t) (htT : t < T) :
    (scaledPrawitzSmoothingFilter T t).re =
      (1 - t / T) * prawitzCotFactor (t / T) + t / T := by
  unfold scaledPrawitzSmoothingFilter
  exact prawitzSmoothingFilter_re_of_mem_Ico
    (div_nonneg ht0 hT.le) ((div_lt_one hT).2 htT)

theorem scaledPrawitzSmoothingFilter_im_of_mem_Ico
    {T t : ℝ} (hT : 0 < T) (ht0 : 0 ≤ t) (htT : t < T) :
    (scaledPrawitzSmoothingFilter T t).im =
      -((1 - t / T) * Real.pi * (t / T)) := by
  unfold scaledPrawitzSmoothingFilter
  exact prawitzSmoothingFilter_im_of_mem_Ico
    (div_nonneg ht0 hT.le) ((div_lt_one hT).2 htT)

/-- Exact norm of the scaled Prawitz filter inside a positive frequency
window. -/
theorem norm_scaledPrawitzSmoothingFilter_of_mem_Ico
    {T t : ℝ} (hT : 0 < T) (ht0 : 0 ≤ t) (htT : t < T) :
    ‖scaledPrawitzSmoothingFilter T t‖ =
      Real.sqrt
        (((1 - t / T) * prawitzCotFactor (t / T) + t / T) ^ 2 +
          ((1 - t / T) * Real.pi * (t / T)) ^ 2) := by
  rw [scaledPrawitzSmoothingFilter,
    norm_prawitzSmoothingFilter_of_mem_Ico
      (div_nonneg ht0 hT.le) ((div_lt_one hT).2 htT)]

/-- Square-root majorant for the scaled Prawitz filter norm inside a positive
frequency window. -/
theorem norm_scaledPrawitzSmoothingFilter_le_sqrt_one_add_sq
    {T t : ℝ} (hT : 0 < T) (ht0 : 0 ≤ t) (htT : t < T) :
    ‖scaledPrawitzSmoothingFilter T t‖ ≤
      Real.sqrt (1 + ((1 - t / T) * Real.pi * (t / T)) ^ 2) := by
  unfold scaledPrawitzSmoothingFilter
  exact norm_prawitzSmoothingFilter_le_sqrt_one_add_sq
    (div_nonneg ht0 hT.le) ((div_lt_one hT).2 htT)

/-- Polynomial majorant for the scaled Prawitz filter norm inside a positive
frequency window. -/
theorem norm_scaledPrawitzSmoothingFilter_le_one_add_half_im_sq
    {T t : ℝ} (hT : 0 < T) (ht0 : 0 ≤ t) (htT : t < T) :
    ‖scaledPrawitzSmoothingFilter T t‖ ≤
      1 + ((1 - t / T) * Real.pi * (t / T)) ^ 2 / 2 := by
  unfold scaledPrawitzSmoothingFilter
  exact norm_prawitzSmoothingFilter_le_one_add_half_im_sq
    (div_nonneg ht0 hT.le) ((div_lt_one hT).2 htT)

/-- Uniform scaled-window form of the positive Prawitz filter norm bound. -/
theorem norm_scaledPrawitzSmoothingFilter_le_one_add_pi_sq_div_thirtytwo
    {T t : ℝ} (hT : 0 < T) (ht0 : 0 ≤ t) (htT : t < T) :
    ‖scaledPrawitzSmoothingFilter T t‖ ≤ 1 + Real.pi ^ 2 / 32 := by
  unfold scaledPrawitzSmoothingFilter
  exact norm_prawitzSmoothingFilter_le_one_add_pi_sq_div_thirtytwo
    (div_nonneg ht0 hT.le) ((div_lt_one hT).2 htT)

theorem scaledPrawitzSmoothingFilter_zero (T : ℝ) :
    scaledPrawitzSmoothingFilter T 0 = 1 := by
  simp [scaledPrawitzSmoothingFilter, prawitzSmoothingFilter_zero]

theorem scaledPrawitzSmoothingFilter_eq_zero_of_abs_ge
    {T t : ℝ} (hT : 0 < T) (ht : T ≤ |t|) :
    scaledPrawitzSmoothingFilter T t = 0 := by
  apply prawitzSmoothingFilter_eq_zero_of_one_le_abs
  rw [abs_div, abs_of_pos hT]
  exact (le_div_iff₀ hT).2 (by simpa only [one_mul] using ht)

theorem scaledPrawitzSmoothingFilter_neg (T t : ℝ) :
    scaledPrawitzSmoothingFilter T (-t) =
      (starRingEnd ℂ) (scaledPrawitzSmoothingFilter T t) := by
  rw [scaledPrawitzSmoothingFilter, scaledPrawitzSmoothingFilter,
    neg_div, prawitzSmoothingFilter_neg]

theorem measurable_scaledPrawitzSmoothingFilter (T : ℝ) :
    Measurable (scaledPrawitzSmoothingFilter T) := by
  exact measurable_prawitzSmoothingFilter.comp (by fun_prop)

/-- Multiplying a characteristic function by a spatial Fourier phase retains
the first-moment linear modulus at frequency zero. -/
theorem norm_phase_mul_charFun_sub_one_le_firstMoment
    {mu : Measure ℝ} [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu) (x t : ℝ) :
    ‖Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun mu t - 1‖ ≤
      |t| * (|x| + ∫ y, |y| ∂mu) := by
  let e : ℂ := Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I)
  have he : ‖e‖ = 1 := by
    dsimp only [e]
    rw [Complex.norm_exp_ofReal_mul_I]
  calc
    ‖e * MeasureTheory.charFun mu t - 1‖ =
        ‖e * (MeasureTheory.charFun mu t - 1) + (e - 1)‖ := by
      congr 1
      ring
    _ ≤ ‖e * (MeasureTheory.charFun mu t - 1)‖ + ‖e - 1‖ :=
      norm_add_le _ _
    _ = ‖MeasureTheory.charFun mu t - 1‖ + ‖e - 1‖ := by
      rw [norm_mul, he, one_mul]
    _ ≤ |t| * (∫ y, |y| ∂mu) + |t * x| := by
      apply add_le_add (norm_charFun_sub_one_le_firstMoment hmu1 t)
      dsimp only [e]
      simpa only [mul_comm Complex.I, Real.norm_eq_abs, abs_neg] using
        (Real.norm_exp_I_mul_ofReal_sub_one_le (x := -(t * x)))
    _ = |t| * (|x| + ∫ y, |y| ∂mu) := by
      rw [abs_mul]
      ring

/-- Conjugation symmetry required of a Fourier--Stieltjes transform of a real
measure. -/
def IsHermitianFrequencyFunction (f : ℝ → ℂ) : Prop :=
  ∀ t, f (-t) = (starRingEnd ℂ) (f t)

theorem isHermitianFrequencyFunction_charFun (mu : Measure ℝ) :
    IsHermitianFrequencyFunction (MeasureTheory.charFun mu) := by
  intro t
  exact MeasureTheory.charFun_neg t

/-- The nonsingular numerator of the Prawitz principal-value integrand. -/
noncomputable def prawitzPVNumerator
    (T : ℝ) (f : ℝ → ℂ) (x t : ℝ) : ℂ :=
  Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
    scaledPrawitzSmoothingFilter T t * f t

/-- The singular integrand in the Prawitz principal-value inversion formula. -/
noncomputable def prawitzPVIntegrand
    (T : ℝ) (f : ℝ → ℂ) (x t : ℝ) : ℂ :=
  prawitzPVNumerator T f x t / (t : ℂ)

theorem prawitzPVNumerator_sub (T : ℝ) (f g : ℝ → ℂ) (x t : ℝ) :
    prawitzPVNumerator T f x t - prawitzPVNumerator T g x t =
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
        scaledPrawitzSmoothingFilter T t * (f t - g t) := by
  unfold prawitzPVNumerator
  ring

theorem measurable_prawitzPVNumerator
    {T : ℝ} {f : ℝ → ℂ} (hf : Measurable f) (x : ℝ) :
    Measurable (prawitzPVNumerator T f x) := by
  unfold prawitzPVNumerator
  have hphase : Measurable (fun t : ℝ =>
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I)) := by
    fun_prop
  exact (hphase.mul (measurable_scaledPrawitzSmoothingFilter T)).mul hf

/-- A finite first absolute moment makes the imaginary part of the Prawitz
numerator vanish linearly at zero, uniformly over its full positive window. -/
theorem abs_im_prawitzPVNumerator_charFun_le
    {mu : Measure ℝ} [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) {t : ℝ} (ht : t ∈ Ioc 0 T) :
    |(prawitzPVNumerator T (MeasureTheory.charFun mu) x t).im| ≤
      (7 * (|x| + ∫ y, |y| ∂mu) + Real.pi / T) * t := by
  have hMoment : 0 ≤ ∫ y, |y| ∂mu := integral_nonneg fun _ => abs_nonneg _
  have hD : 0 ≤ |x| + ∫ y, |y| ∂mu := add_nonneg (abs_nonneg x) hMoment
  rcases ht.2.eq_or_lt with htEq | htT
  · subst t
    have hFilter : scaledPrawitzSmoothingFilter T T = 0 := by
      rw [scaledPrawitzSmoothingFilter, div_self hT.ne',
        prawitzSmoothingFilter]
      norm_num
    rw [prawitzPVNumerator, hFilter, mul_zero, zero_mul,
      Complex.zero_im, abs_zero]
    exact mul_nonneg
      (add_nonneg (mul_nonneg (by norm_num) hD)
        (div_nonneg Real.pi_pos.le hT.le)) hT.le
  let u : ℝ := t / T
  let M : ℂ := prawitzSmoothingFilter u
  let q : ℂ := Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
    MeasureTheory.charFun mu t
  have hu0 : 0 ≤ u := div_nonneg ht.1.le hT.le
  have hu1 : u < 1 := (div_lt_one hT).2 htT
  have hMNorm : ‖M‖ ≤ 7 :=
    norm_prawitzSmoothingFilter_le_seven hu0 hu1
  have hMIm : |M.im| ≤ Real.pi * u :=
    abs_im_prawitzSmoothingFilter_le hu0 hu1
  have hq : ‖q - 1‖ ≤ t * (|x| + ∫ y, |y| ∂mu) := by
    simpa only [q, abs_of_pos ht.1] using
      norm_phase_mul_charFun_sub_one_le_firstMoment hmu1 x t
  have hNumerator :
      prawitzPVNumerator T (MeasureTheory.charFun mu) x t = M * q := by
    dsimp only [prawitzPVNumerator, M, q, scaledPrawitzSmoothingFilter, u]
    ring
  rw [hNumerator]
  have hDecomp : M * q = M * (q - 1) + M := by ring
  rw [hDecomp]
  calc
    |(M * (q - 1) + M).im| ≤
        |(M * (q - 1)).im| + |M.im| := by
      simpa only [Complex.add_im] using
        abs_add_le (M * (q - 1)).im M.im
    _ ≤ ‖M * (q - 1)‖ + |M.im| :=
      add_le_add (Complex.abs_im_le_norm _) le_rfl
    _ = ‖M‖ * ‖q - 1‖ + |M.im| := by rw [norm_mul]
    _ ≤ 7 * (t * (|x| + ∫ y, |y| ∂mu)) + Real.pi * u := by
      apply add_le_add
      · exact mul_le_mul hMNorm hq (norm_nonneg _) (by norm_num)
      · exact hMIm
    _ = (7 * (|x| + ∫ y, |y| ∂mu) + Real.pi / T) * t := by
      dsimp only [u]
      ring

theorem measurable_prawitzPVIntegrand
    {T : ℝ} {f : ℝ → ℂ} (hf : Measurable f) (x : ℝ) :
    Measurable (prawitzPVIntegrand T f x) := by
  unfold prawitzPVIntegrand
  exact (measurable_prawitzPVNumerator hf x).div
    (Complex.continuous_ofReal.measurable.comp measurable_id)

theorem prawitzPVIntegrand_neg
    {T : ℝ} {f : ℝ → ℂ} (hf : IsHermitianFrequencyFunction f)
    (x : ℝ) {t : ℝ} (ht : t ≠ 0) :
    prawitzPVIntegrand T f x (-t) =
      -(starRingEnd ℂ) (prawitzPVIntegrand T f x t) := by
  have hexp :
      Complex.exp (((-((-t) * x) : ℝ) : ℂ) * Complex.I) =
        (starRingEnd ℂ)
          (Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I)) := by
    have harg :
        (((-((-t) * x) : ℝ) : ℂ) * Complex.I) =
          (starRingEnd ℂ) (((-(t * x) : ℝ) : ℂ) * Complex.I) := by
      apply Complex.ext <;> simp
    rw [harg, Complex.exp_conj]
  rw [prawitzPVIntegrand, prawitzPVIntegrand,
    prawitzPVNumerator, prawitzPVNumerator, hexp,
    scaledPrawitzSmoothingFilter_neg, hf]
  simp only [map_div₀, map_mul, Complex.conj_ofReal, Complex.ofReal_neg]
  rw [div_neg]

/-- Pairing positive and negative frequencies removes the principal-value
singularity algebraically. -/
noncomputable def symmetricPrawitzPVIntegrand
    (T : ℝ) (f : ℝ → ℂ) (x t : ℝ) : ℂ :=
  prawitzPVIntegrand T f x t + prawitzPVIntegrand T f x (-t)

theorem measurable_symmetricPrawitzPVIntegrand
    {T : ℝ} {f : ℝ → ℂ} (hf : Measurable f) (x : ℝ) :
    Measurable (symmetricPrawitzPVIntegrand T f x) := by
  exact (measurable_prawitzPVIntegrand hf x).add
    ((measurable_prawitzPVIntegrand hf x).comp measurable_neg)

/-- Pairing converts the norm of the principal-value integrand to the
imaginary part of its nonsingular positive-frequency numerator. -/
theorem norm_symmetricPrawitzPVIntegrand
    {T : ℝ} {f : ℝ → ℂ} (hf : IsHermitianFrequencyFunction f)
    (x : ℝ) {t : ℝ} (ht : t ≠ 0) :
    ‖symmetricPrawitzPVIntegrand T f x t‖ =
      2 * |(prawitzPVNumerator T f x t).im| / |t| := by
  rw [symmetricPrawitzPVIntegrand, prawitzPVIntegrand_neg hf x ht,
    ← sub_eq_add_neg, Complex.sub_conj, norm_mul, Complex.norm_real,
    Complex.norm_I, mul_one, Real.norm_eq_abs, abs_mul,
    abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
  rw [prawitzPVIntegrand, Complex.div_ofReal_im, abs_div]
  ring

/-- Exact signed form of the paired Prawitz integrand at nonzero frequency. -/
theorem symmetricPrawitzPVIntegrand_eq_two_mul_im
    {T : ℝ} {f : ℝ → ℂ} (hf : IsHermitianFrequencyFunction f)
    (x : ℝ) {t : ℝ} (ht : t ≠ 0) :
    symmetricPrawitzPVIntegrand T f x t =
      ((2 * (prawitzPVNumerator T f x t).im / t : ℝ) : ℂ) * Complex.I := by
  rw [symmetricPrawitzPVIntegrand, prawitzPVIntegrand_neg hf x ht,
    ← sub_eq_add_neg, Complex.sub_conj, prawitzPVIntegrand,
    Complex.div_ofReal_im]
  push_cast
  ring

/-- Real part of a signed difference of paired Prawitz integrands, expressed
without complex norms through the positive-frequency numerators. -/
theorem re_prawitzCoefficient_mul_symmetric_sub
    {T : ℝ} {f g : ℝ → ℂ}
    (hf : IsHermitianFrequencyFunction f)
    (hg : IsHermitianFrequencyFunction g)
    (x : ℝ) {t : ℝ} (ht : t ≠ 0) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
        (symmetricPrawitzPVIntegrand T f x t -
          symmetricPrawitzPVIntegrand T g x t)).re =
      -((prawitzPVNumerator T f x t).im -
          (prawitzPVNumerator T g x t).im) /
        (Real.pi * t) := by
  have hcoef :
      Complex.I / (2 * Real.pi : ℝ) =
        (((2 * Real.pi)⁻¹ : ℝ) : ℂ) * Complex.I := by
    rw [div_eq_mul_inv, ← Complex.ofReal_inv]
    ring
  rw [symmetricPrawitzPVIntegrand_eq_two_mul_im hf x ht,
    symmetricPrawitzPVIntegrand_eq_two_mul_im hg x ht, hcoef]
  change (((((2 * Real.pi)⁻¹ : ℝ) : ℂ) * Complex.I) *
      ((((2 * (prawitzPVNumerator T f x t).im / t : ℝ) : ℂ) * Complex.I) -
        (((2 * (prawitzPVNumerator T g x t).im / t : ℝ) : ℂ) *
          Complex.I))).re = _
  simp only [Complex.I_re, Complex.I_im, Complex.ofReal_re,
    Complex.ofReal_im, Complex.mul_re, Complex.mul_im, Complex.sub_re,
    Complex.sub_im, zero_mul, mul_one, sub_zero, add_zero]
  field_simp [Real.pi_ne_zero, ht]
  ring

/-- A linear bound on the imaginary part of the paired numerator removes the
Prawitz singularity and supplies absolute integrability on a finite window. -/
theorem integrableOn_symmetricPrawitzPVIntegrand_of_im_le
    {T C : ℝ} {f : ℝ → ℂ} (hT : 0 ≤ T) (hC : 0 ≤ C)
    (hfHermitian : IsHermitianFrequencyFunction f) (hfMeasurable : Measurable f)
    (hIm : ∀ t ∈ Ioc 0 T,
      |(prawitzPVNumerator T f x t).im| ≤ C * t) :
    IntegrableOn (symmetricPrawitzPVIntegrand T f x) (Icc 0 T) := by
  apply Measure.integrableOn_of_bounded
      (μ := volume) (s := Icc 0 T) (M := 2 * C)
  · simp [Real.volume_Icc]
  · exact Measurable.aestronglyMeasurable
      (measurable_symmetricPrawitzPVIntegrand hfMeasurable x)
  · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    rcases eq_or_lt_of_le ht.1 with rfl | ht0
    · simpa [symmetricPrawitzPVIntegrand, prawitzPVIntegrand] using hC
    rw [norm_symmetricPrawitzPVIntegrand hfHermitian x ht0.ne']
    rw [abs_of_pos ht0]
    calc
      2 * |(prawitzPVNumerator T f x t).im| / t ≤
          2 * (C * t) / t :=
        div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_left (hIm t ⟨ht0, ht.2⟩) (by norm_num)) ht0.le
      _ = 2 * C := by field_simp

/-- The paired Prawitz principal-value integrand of any probability law with
a finite first absolute moment is absolutely integrable on every positive
frequency window. -/
theorem integrableOn_symmetricPrawitzPVIntegrand_charFun
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    IntegrableOn
      (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x)
      (Icc 0 T) := by
  let C : ℝ := 7 * (|x| + ∫ y, |y| ∂mu) + Real.pi / T
  have hMoment : 0 ≤ ∫ y, |y| ∂mu := integral_nonneg fun _ => abs_nonneg _
  have hC : 0 ≤ C := by
    dsimp only [C]
    positivity
  apply integrableOn_symmetricPrawitzPVIntegrand_of_im_le
    hT.le hC (isHermitianFrequencyFunction_charFun mu)
    MeasureTheory.measurable_charFun
  intro t ht
  exact abs_im_prawitzPVNumerator_charFun_le hmu1 hT x ht

theorem star_symmetricPrawitzPVIntegrand
    {T : ℝ} {f : ℝ → ℂ} (hf : IsHermitianFrequencyFunction f)
    (x : ℝ) {t : ℝ} (ht : t ≠ 0) :
    (starRingEnd ℂ) (symmetricPrawitzPVIntegrand T f x t) =
      -symmetricPrawitzPVIntegrand T f x t := by
  rw [symmetricPrawitzPVIntegrand, map_add,
    prawitzPVIntegrand_neg hf x ht]
  simp

/-- Symmetrically truncated Prawitz inversion functional. The eventual
principal value is obtained by sending `epsilon` to zero. -/
noncomputable def truncatedPrawitzInversion
    (T epsilon : ℝ) (f : ℝ → ℂ) (x : ℝ) : ℂ :=
  (Complex.I / (2 * Real.pi : ℝ)) *
    ∫ t in Icc epsilon T, symmetricPrawitzPVIntegrand T f x t

theorem star_truncatedPrawitzInversion
    {T epsilon : ℝ} {f : ℝ → ℂ}
    (hf : IsHermitianFrequencyFunction f) (hepsilon : 0 < epsilon)
    (x : ℝ) :
    (starRingEnd ℂ) (truncatedPrawitzInversion T epsilon f x) =
      truncatedPrawitzInversion T epsilon f x := by
  have hstar : ∀ t ∈ Icc epsilon T,
      (starRingEnd ℂ) (symmetricPrawitzPVIntegrand T f x t) =
        -symmetricPrawitzPVIntegrand T f x t := by
    intro t ht
    exact star_symmetricPrawitzPVIntegrand hf x (ne_of_gt (hepsilon.trans_le ht.1))
  rw [truncatedPrawitzInversion, map_mul, map_div₀,
    Complex.conj_I, Complex.conj_ofReal]
  have hInt :
      (∫ t in Icc epsilon T,
          (starRingEnd ℂ) (symmetricPrawitzPVIntegrand T f x t)) =
        -(∫ t in Icc epsilon T,
          symmetricPrawitzPVIntegrand T f x t) := by
    rw [← integral_neg]
    apply integral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    exact hstar t ht
  have hConj :
      (starRingEnd ℂ) (∫ t in Icc epsilon T,
          symmetricPrawitzPVIntegrand T f x t) =
        ∫ t in Icc epsilon T,
          (starRingEnd ℂ) (symmetricPrawitzPVIntegrand T f x t) := by
    exact (integral_conj
      (μ := volume.restrict (Icc epsilon T))
      (f := fun t => symmetricPrawitzPVIntegrand T f x t)).symm
  rw [hConj, hInt]
  ring

theorem truncatedPrawitzInversion_im_eq_zero
    {T epsilon : ℝ} {f : ℝ → ℂ}
    (hf : IsHermitianFrequencyFunction f) (hepsilon : 0 < epsilon)
    (x : ℝ) :
    (truncatedPrawitzInversion T epsilon f x).im = 0 := by
  have hstar := star_truncatedPrawitzInversion (T := T) hf hepsilon x
  apply_fun Complex.im at hstar
  simp only [Complex.conj_im] at hstar
  linarith

/-- The full paired Prawitz inversion functional, defined when the removable
singularity at zero is integrable. -/
noncomputable def prawitzInversion
    (T : ℝ) (f : ℝ → ℂ) (x : ℝ) : ℂ :=
  (Complex.I / (2 * Real.pi : ℝ)) *
    ∫ t in Icc 0 T, symmetricPrawitzPVIntegrand T f x t

/-- Hermitian frequency symmetry makes the full paired Prawitz inversion
functional real-valued. -/
theorem star_prawitzInversion
    {T : ℝ} {f : ℝ → ℂ} (hf : IsHermitianFrequencyFunction f) (x : ℝ) :
    (starRingEnd ℂ) (prawitzInversion T f x) = prawitzInversion T f x := by
  have hstar : ∀ t ∈ Icc 0 T,
      (starRingEnd ℂ) (symmetricPrawitzPVIntegrand T f x t) =
        -symmetricPrawitzPVIntegrand T f x t := by
    intro t ht
    by_cases ht0 : t = 0
    · subst t
      simp [symmetricPrawitzPVIntegrand, prawitzPVIntegrand]
    · exact star_symmetricPrawitzPVIntegrand hf x ht0
  rw [prawitzInversion, map_mul, map_div₀,
    Complex.conj_I, Complex.conj_ofReal]
  have hInt :
      (∫ t in Icc 0 T,
          (starRingEnd ℂ) (symmetricPrawitzPVIntegrand T f x t)) =
        -(∫ t in Icc 0 T,
          symmetricPrawitzPVIntegrand T f x t) := by
    rw [← integral_neg]
    apply integral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    exact hstar t ht
  have hConj :
      (starRingEnd ℂ) (∫ t in Icc 0 T,
          symmetricPrawitzPVIntegrand T f x t) =
        ∫ t in Icc 0 T,
          (starRingEnd ℂ) (symmetricPrawitzPVIntegrand T f x t) := by
    exact (integral_conj
      (μ := volume.restrict (Icc 0 T))
      (f := fun t => symmetricPrawitzPVIntegrand T f x t)).symm
  rw [hConj, hInt]
  ring

theorem prawitzInversion_im_eq_zero
    {T : ℝ} {f : ℝ → ℂ} (hf : IsHermitianFrequencyFunction f) (x : ℝ) :
    (prawitzInversion T f x).im = 0 := by
  have hstar := star_prawitzInversion (T := T) hf x
  apply_fun Complex.im at hstar
  simp only [Complex.conj_im] at hstar
  linarith

/-- Translating a point mass and its evaluation point by the same amount does
not change the Prawitz principal-value integrand. -/
theorem prawitzPVIntegrand_charFun_dirac_translate
    (T x y t : ℝ) :
    prawitzPVIntegrand T (MeasureTheory.charFun (Measure.dirac y)) x t =
      prawitzPVIntegrand T
        (MeasureTheory.charFun (Measure.dirac (y - x))) 0 t := by
  unfold prawitzPVIntegrand prawitzPVNumerator
  rw [MeasureTheory.charFun_dirac, MeasureTheory.charFun_dirac]
  rw [show inner ℝ y t = y * t by
        change t * y = y * t
        ring,
      show inner ℝ (y - x) t = (y - x) * t by
        change t * (y - x) = (y - x) * t
        ring]
  simp only [mul_zero, neg_zero]
  have hExp :
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
          Complex.exp ((((y * t : ℝ) : ℂ)) * Complex.I) =
        Complex.exp (((((y - x) * t : ℝ) : ℂ)) * Complex.I) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [show Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
          scaledPrawitzSmoothingFilter T t *
            Complex.exp ((((y * t : ℝ) : ℂ)) * Complex.I) =
        scaledPrawitzSmoothingFilter T t *
          (Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
            Complex.exp ((((y * t : ℝ) : ℂ)) * Complex.I)) by ring,
    hExp]
  simp

theorem symmetricPrawitzPVIntegrand_charFun_dirac_translate
    (T x y t : ℝ) :
    symmetricPrawitzPVIntegrand T
        (MeasureTheory.charFun (Measure.dirac y)) x t =
      symmetricPrawitzPVIntegrand T
        (MeasureTheory.charFun (Measure.dirac (y - x))) 0 t := by
  unfold symmetricPrawitzPVIntegrand
  exact congrArg₂ (· + ·)
    (prawitzPVIntegrand_charFun_dirac_translate T x y t)
    (prawitzPVIntegrand_charFun_dirac_translate T x y (-t))

theorem prawitzInversion_charFun_dirac_translate (T x y : ℝ) :
    prawitzInversion T (MeasureTheory.charFun (Measure.dirac y)) x =
      prawitzInversion T
        (MeasureTheory.charFun (Measure.dirac (y - x))) 0 := by
  unfold prawitzInversion
  congr 1
  apply integral_congr_ae
  exact ae_of_all _ fun t =>
    symmetricPrawitzPVIntegrand_charFun_dirac_translate T x y t

/-- The deterministic Prawitz point kernel, normalized so its argument is the
displacement from the CDF evaluation point. -/
noncomputable def prawitzPointKernel (T z : ℝ) : ℝ :=
  (prawitzInversion T
    (MeasureTheory.charFun (Measure.dirac z)) 0).re

theorem prawitzInversion_charFun_dirac_eq_pointKernel (T x y : ℝ) :
    prawitzInversion T (MeasureTheory.charFun (Measure.dirac y)) x =
      (prawitzPointKernel T (y - x) : ℂ) := by
  rw [prawitzInversion_charFun_dirac_translate]
  apply Complex.ext
  · rfl
  · simpa only [Complex.ofReal_im] using
      prawitzInversion_im_eq_zero
        (T := T) (isHermitianFrequencyFunction_charFun (Measure.dirac (y - x))) 0

/-- Positive dilation of the frequency window reduces a point-mass Prawitz
integrand to the unit window with the reciprocal Jacobian factor. -/
theorem prawitzPVIntegrand_charFun_dirac_scale
    {T : ℝ} (hT : 0 < T) (z u : ℝ) :
    prawitzPVIntegrand T (MeasureTheory.charFun (Measure.dirac z)) 0 (T * u) =
      ((T : ℂ)⁻¹) * prawitzPVIntegrand 1
        (MeasureTheory.charFun (Measure.dirac (T * z))) 0 u := by
  by_cases hu : u = 0
  · subst u
    simp [prawitzPVIntegrand]
  unfold prawitzPVIntegrand prawitzPVNumerator
  rw [MeasureTheory.charFun_dirac, MeasureTheory.charFun_dirac]
  rw [show inner ℝ z (T * u) = z * (T * u) by
        change (T * u) * z = z * (T * u)
        ring,
      show inner ℝ (T * z) u = (T * z) * u by
        change u * (T * z) = (T * z) * u
        ring]
  simp only [mul_zero, neg_zero,
    scaledPrawitzSmoothingFilter]
  rw [mul_div_cancel_left₀ u hT.ne', div_one]
  have hphase : z * (T * u) = (T * z) * u := by ring
  rw [hphase]
  push_cast
  field_simp

theorem symmetricPrawitzPVIntegrand_charFun_dirac_scale
    {T : ℝ} (hT : 0 < T) (z u : ℝ) :
    symmetricPrawitzPVIntegrand T
        (MeasureTheory.charFun (Measure.dirac z)) 0 (T * u) =
      ((T : ℂ)⁻¹) * symmetricPrawitzPVIntegrand 1
        (MeasureTheory.charFun (Measure.dirac (T * z))) 0 u := by
  unfold symmetricPrawitzPVIntegrand
  rw [prawitzPVIntegrand_charFun_dirac_scale hT z u,
    show -(T * u) = T * (-u) by ring,
    prawitzPVIntegrand_charFun_dirac_scale hT z (-u)]
  ring

theorem prawitzInversion_charFun_dirac_scale
    {T : ℝ} (hT : 0 < T) (z : ℝ) :
    prawitzInversion T (MeasureTheory.charFun (Measure.dirac z)) 0 =
      prawitzInversion 1
        (MeasureTheory.charFun (Measure.dirac (T * z))) 0 := by
  let gT : ℝ → ℂ := fun t => symmetricPrawitzPVIntegrand T
    (MeasureTheory.charFun (Measure.dirac z)) 0 t
  let g1 : ℝ → ℂ := fun u => symmetricPrawitzPVIntegrand 1
    (MeasureTheory.charFun (Measure.dirac (T * z))) 0 u
  have hsetT : (∫ t in Icc 0 T, gT t) = ∫ t in 0..T, gT t := by
    rw [integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le hT.le]
  have hset1 : (∫ u in Icc (0 : ℝ) 1, g1 u) = ∫ u in 0..1, g1 u := by
    rw [integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  have hchange :
      (∫ t in 0..T, gT t) = T • ∫ u in 0..1, gT (T * u) := by
    symm
    simpa only [mul_zero, mul_one] using
      (intervalIntegral.smul_integral_comp_mul_left
        (f := gT) (a := 0) (b := 1) T)
  have hpoint : ∀ u, gT (T * u) = ((T : ℂ)⁻¹) * g1 u := by
    intro u
    exact symmetricPrawitzPVIntegrand_charFun_dirac_scale hT z u
  have hintegral : (∫ t in Icc 0 T, gT t) = ∫ u in Icc (0 : ℝ) 1, g1 u := by
    rw [hsetT, hset1, hchange]
    have hcongr :
        (∫ u in 0..1, gT (T * u)) =
          ∫ u in 0..1, ((T : ℂ)⁻¹) * g1 u := by
      apply intervalIntegral.integral_congr
      intro u hu
      exact hpoint u
    have hconst :
        (∫ u in 0..1, ((T : ℂ)⁻¹) * g1 u) =
          ((T : ℂ)⁻¹) * ∫ u in 0..1, g1 u :=
      intervalIntegral.integral_const_mul (T : ℂ)⁻¹ g1
    rw [hcongr, hconst, Complex.real_smul]
    change (T : ℂ) * ((T : ℂ)⁻¹ * ∫ u in 0..1, g1 u) =
      ∫ u in 0..1, g1 u
    have hTC : (T : ℂ) ≠ 0 := by exact_mod_cast hT.ne'
    field_simp [hTC]
  unfold prawitzInversion
  change (Complex.I / (2 * Real.pi : ℝ)) * (∫ t in Icc 0 T, gT t) =
    (Complex.I / (2 * Real.pi : ℝ)) * (∫ u in Icc 0 1, g1 u)
  rw [hintegral]

theorem prawitzPointKernel_scale
    {T : ℝ} (hT : 0 < T) (z : ℝ) :
    prawitzPointKernel T z = prawitzPointKernel 1 (T * z) := by
  unfold prawitzPointKernel
  rw [prawitzInversion_charFun_dirac_scale hT z]

/-- The real unit-window integrand whose integral is the deterministic
Prawitz point kernel. -/
noncomputable def prawitzUnitPointIntegrand (z u : ℝ) : ℝ :=
  ((Complex.I / (2 * Real.pi : ℝ)) *
    symmetricPrawitzPVIntegrand 1
      (MeasureTheory.charFun (Measure.dirac z)) 0 u).re

/-- Away from the removable endpoint, the real point integrand is the
negative imaginary part of the nonsingular numerator divided by `πu`. -/
theorem prawitzUnitPointIntegrand_eq_neg_im_div
    (z : ℝ) {u : ℝ} (hu : u ≠ 0) :
    prawitzUnitPointIntegrand z u =
      -(prawitzPVNumerator 1
          (MeasureTheory.charFun (Measure.dirac z)) 0 u).im /
        (Real.pi * u) := by
  have hcomplex (a : ℝ) :
      (Complex.I / (2 * Real.pi : ℝ)) *
          (((2 * a : ℝ) : ℂ) * Complex.I) =
        ((-a / Real.pi : ℝ) : ℂ) := by
    apply Complex.ext <;>
      simp [Complex.div_re, Complex.div_im, Complex.normSq_apply]
    field_simp [Real.pi_ne_zero]
  rw [prawitzUnitPointIntegrand, symmetricPrawitzPVIntegrand,
    prawitzPVIntegrand_neg
      (isHermitianFrequencyFunction_charFun (Measure.dirac z)) 0 hu,
    ← sub_eq_add_neg, Complex.sub_conj, prawitzPVIntegrand,
    Complex.div_ofReal_im, hcomplex]
  simp only [Complex.ofReal_re]
  field_simp [Real.pi_ne_zero, hu]

/-- Explicit real trigonometric form of the unit-window Prawitz point
integrand on the open positive frequency window. -/
theorem prawitzUnitPointIntegrand_eq_explicit
    (z : ℝ) {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    prawitzUnitPointIntegrand z u =
      (1 - u) * Real.cos (z * u) -
        (((1 - u) * prawitzCotFactor u + u) * Real.sin (z * u)) /
          (Real.pi * u) := by
  rw [prawitzUnitPointIntegrand_eq_neg_im_div z hu0.ne']
  unfold prawitzPVNumerator scaledPrawitzSmoothingFilter
  simp only [div_one]
  rw [MeasureTheory.charFun_dirac]
  rw [show inner ℝ z u = z * u by
    change u * z = z * u
    ring]
  simp only [mul_zero, neg_zero, Complex.ofReal_zero, zero_mul,
    Complex.exp_zero, one_mul]
  rw [prawitzSmoothingFilter,
    if_pos (by simpa [abs_of_pos hu0] using hu1), abs_of_pos hu0,
    Complex.exp_ofReal_mul_I]
  simp only [Complex.mul_im, Complex.sub_re, Complex.ofReal_re,
    Complex.mul_re, Complex.I_re, mul_zero, Complex.I_im, mul_one,
    add_zero, Complex.sub_im, Complex.ofReal_im, zero_sub,
    Complex.add_re, Complex.add_im]
  field_simp [Real.pi_ne_zero, hu0.ne']
  ring

/-- The only non-elementary spatial term left by the explicit Prawitz point
integrand on the positive frequency window. -/
noncomputable def prawitzCotangentSineIntegrand (x u : ℝ) : ℝ :=
  (1 - u) * Real.cot (Real.pi * u) * Real.sin (2 * Real.pi * x * u)

/-- At spatial argument `-2πx`, the Prawitz point integrand splits into an
elementary cosine term, an elementary sine term, and the cotangent term. -/
theorem prawitzUnitPointIntegrand_neg_two_pi_eq
    (x : ℝ) {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    prawitzUnitPointIntegrand (-2 * Real.pi * x) u =
      (1 - u) * Real.cos (2 * Real.pi * x * u) +
        Real.sin (2 * Real.pi * x * u) / Real.pi +
          prawitzCotangentSineIntegrand x u := by
  rw [prawitzUnitPointIntegrand_eq_explicit (-2 * Real.pi * x) hu0 hu1]
  rw [show -2 * Real.pi * x * u = -(2 * Real.pi * x * u) by ring,
    Real.cos_neg, Real.sin_neg]
  rw [prawitzCotFactor, if_neg hu0.ne']
  unfold prawitzCotangentSineIntegrand
  field_simp [Real.pi_ne_zero, hu0.ne']
  ring

/-- Endpoint-regularized terms in the real cotangent expansion. The zeroth
term is algebraically canceled at `u = 1`; later terms retain the symmetric
partial-fraction form. -/
noncomputable def prawitzCotSeriesTerm (x : ℝ) : ℕ → ℝ → ℝ
  | 0, u => (-2 * u / (Real.pi * (u + 1))) *
      Real.sin (2 * Real.pi * x * u)
  | n + 1, u => ((1 - u) / Real.pi) *
      (1 / (u - ((n : ℝ) + 2)) + 1 / (u + ((n : ℝ) + 2))) *
        Real.sin (2 * Real.pi * x * u)

theorem prawitzCotSeriesTerm_eq
    (x : ℝ) (n : ℕ) {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    prawitzCotSeriesTerm x n u =
      ((1 - u) / Real.pi) *
        (1 / (u - ((n : ℝ) + 1)) + 1 / (u + ((n : ℝ) + 1))) *
          Real.sin (2 * Real.pi * x * u) := by
  cases n with
  | zero =>
      simp only [prawitzCotSeriesTerm, Nat.cast_zero, zero_add]
      have hu1ne : u - 1 ≠ 0 := sub_ne_zero.mpr hu1.ne
      have hupne : u + 1 ≠ 0 := by positivity
      field_simp [Real.pi_ne_zero, hu0.ne', hu1ne, hupne]
      ring
  | succ n =>
      simp only [prawitzCotSeriesTerm, Nat.cast_add, Nat.cast_one]
      congr 3 <;> ring

theorem summable_prawitzCotSeriesTerm
    (x : ℝ) {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    Summable (fun n => prawitzCotSeriesTerm x n u) := by
  have hs := (summable_real_cot_series hu0 hu1).mul_left
    (((1 - u) / Real.pi) * Real.sin (2 * Real.pi * x * u))
  apply hs.congr
  intro n
  rw [prawitzCotSeriesTerm_eq x n hu0 hu1]
  ring

/-- The removable `1/u` term separated from the real cotangent series. -/
noncomputable def prawitzCotBaseIntegrand (x u : ℝ) : ℝ :=
  (1 - u) * Real.sin (2 * Real.pi * x * u) / (Real.pi * u)

/-- Pointwise Mittag--Leffler expansion of the cotangent--sine integrand on
the open unit interval, with the endpoint-regularized series terms. -/
theorem prawitzCotangentSineIntegrand_eq_base_add_tsum
    (x : ℝ) {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    prawitzCotangentSineIntegrand x u =
      prawitzCotBaseIntegrand x u + ∑' n, prawitzCotSeriesTerm x n u := by
  have hcot := real_cot_series_rep hu0 hu1
  have htsum :
      (∑' n, prawitzCotSeriesTerm x n u) =
        (((1 - u) / Real.pi) * Real.sin (2 * Real.pi * x * u)) *
          ∑' n : ℕ,
            (1 / (u - ((n : ℝ) + 1)) +
              1 / (u + ((n : ℝ) + 1))) := by
    rw [← tsum_mul_left]
    apply tsum_congr
    intro n
    rw [prawitzCotSeriesTerm_eq x n hu0 hu1]
    ring
  rw [htsum]
  unfold prawitzCotangentSineIntegrand prawitzCotBaseIntegrand
  rw [← hcot]
  field_simp [Real.pi_ne_zero, hu0.ne']
  ring

/-- Uniform inverse-square bound for the endpoint-regularized cotangent
series on the closed unit interval. -/
theorem abs_prawitzCotSeriesTerm_le
    (x : ℝ) (n : ℕ) {u : ℝ} (hu : u ∈ Icc (0 : ℝ) 1) :
    |prawitzCotSeriesTerm x n u| ≤ 4 / ((n : ℝ) + 1) ^ 2 := by
  cases n with
  | zero =>
      simp only [prawitzCotSeriesTerm, Nat.cast_zero, zero_add, one_pow,
        div_one]
      have hup : 0 < u + 1 := by linarith [hu.1]
      have hden : 0 < Real.pi * (u + 1) := mul_pos Real.pi_pos hup
      have hcoef : 2 * u / (Real.pi * (u + 1)) ≤ 4 := by
        apply (div_le_iff₀ hden).2
        nlinarith [Real.two_le_pi]
      calc
        |(-2 * u / (Real.pi * (u + 1))) *
            Real.sin (2 * Real.pi * x * u)| =
            (2 * u / (Real.pi * (u + 1))) *
              |Real.sin (2 * Real.pi * x * u)| := by
          rw [abs_mul, abs_div,
            abs_of_nonpos (by linarith [hu.1] : -2 * u ≤ 0),
            abs_of_pos hden]
          ring
        _ ≤ (2 * u / (Real.pi * (u + 1))) * 1 := by
          exact mul_le_mul_of_nonneg_left (Real.abs_sin_le_one _)
            (div_nonneg (mul_nonneg (by norm_num) hu.1) hden.le)
        _ ≤ 4 := by simpa using hcoef
  | succ n =>
      let m : ℝ := (n : ℝ) + 2
      have hm : 2 ≤ m := by
        dsimp [m]
        exact le_add_of_nonneg_left (Nat.cast_nonneg n)
      have hum : u - m < 0 := by linarith [hu.2]
      have hup : 0 < u + m := by linarith [hu.1]
      have hden : 0 < m ^ 2 - u ^ 2 := by
        nlinarith [sq_nonneg (m - u)]
      have hqeq :
          1 / (u - m) + 1 / (u + m) = -2 * u / (m ^ 2 - u ^ 2) := by
        field_simp [hum.ne, hup.ne']
        ring
      have hqabs :
          |1 / (u - m) + 1 / (u + m)| =
            2 * u / (m ^ 2 - u ^ 2) := by
        rw [hqeq, abs_div,
          abs_of_nonpos (by linarith [hu.1] : -2 * u ≤ 0),
          abs_of_pos hden]
        ring
      have hq :
          |1 / (u - m) + 1 / (u + m)| ≤ 4 / m ^ 2 := by
        rw [hqabs]
        have hmpos : 0 < m ^ 2 := sq_pos_of_pos (by linarith : 0 < m)
        apply (div_le_div_iff₀ hden hmpos).2
        have hu_mul : 0 ≤ u * (1 - u) :=
          mul_nonneg hu.1 (sub_nonneg.mpr hu.2)
        have hu_sq : u ^ 2 ≤ 1 := by nlinarith
        have hm_sq : 4 ≤ m ^ 2 := by nlinarith [sq_nonneg (m - 2)]
        have hleft : 2 * u * m ^ 2 ≤ 2 * m ^ 2 := by
          exact mul_le_mul_of_nonneg_right
            (by linarith [hu.2] : 2 * u ≤ 2) (sq_nonneg m)
        have hright : 2 * m ^ 2 ≤ 4 * (m ^ 2 - u ^ 2) := by
          nlinarith
        exact hleft.trans hright
      have hfac : |(1 - u) / Real.pi| ≤ 1 := by
        rw [abs_div, abs_of_nonneg (by linarith [hu.2] : 0 ≤ 1 - u),
          abs_of_pos Real.pi_pos]
        apply (div_le_one Real.pi_pos).2
        linarith [Real.two_le_pi, hu.1]
      simp only [prawitzCotSeriesTerm, Nat.cast_add, Nat.cast_one]
      rw [show (n : ℝ) + 1 + 1 = (n : ℝ) + 2 by ring]
      change |((1 - u) / Real.pi) *
          (1 / (u - m) + 1 / (u + m)) *
            Real.sin (2 * Real.pi * x * u)| ≤ 4 / m ^ 2
      rw [abs_mul, abs_mul]
      calc
        |(1 - u) / Real.pi| *
              |1 / (u - m) + 1 / (u + m)| *
            |Real.sin (2 * Real.pi * x * u)| ≤
            |(1 - u) / Real.pi| *
              |1 / (u - m) + 1 / (u + m)| * 1 := by
          exact mul_le_mul_of_nonneg_left (Real.abs_sin_le_one _) (by positivity)
        _ ≤ |1 / (u - m) + 1 / (u + m)| := by
          simpa only [mul_one] using
            (mul_le_of_le_one_left (abs_nonneg _) hfac)
        _ ≤ 4 / m ^ 2 := hq

theorem integrableOn_prawitzCotSeriesTerm (x : ℝ) (n : ℕ) :
    IntegrableOn (prawitzCotSeriesTerm x n) (Icc 0 1) := by
  have hmeas : AEStronglyMeasurable (prawitzCotSeriesTerm x n)
      (volume.restrict (Icc (0 : ℝ) 1)) := by
    apply Measurable.aestronglyMeasurable
    cases n with
    | zero =>
        change Measurable (fun u : ℝ =>
          (-2 * u / (Real.pi * (u + 1))) *
            Real.sin (2 * Real.pi * x * u))
        fun_prop
    | succ n =>
        change Measurable (fun u : ℝ => ((1 - u) / Real.pi) *
          (1 / (u - ((n : ℝ) + 2)) + 1 / (u + ((n : ℝ) + 2))) *
            Real.sin (2 * Real.pi * x * u))
        fun_prop
  apply (integrable_const (4 / ((n : ℝ) + 1) ^ 2 : ℝ)).mono' hmeas
  filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
  rw [Real.norm_eq_abs]
  exact abs_prawitzCotSeriesTerm_le x n hu

theorem integral_norm_prawitzCotSeriesTerm_le (x : ℝ) (n : ℕ) :
    (∫ u in Icc (0 : ℝ) 1, ‖prawitzCotSeriesTerm x n u‖) ≤
      4 / ((n : ℝ) + 1) ^ 2 := by
  calc
    _ ≤ ∫ _u in Icc (0 : ℝ) 1, (4 / ((n : ℝ) + 1) ^ 2 : ℝ) := by
      exact MeasureTheory.integral_mono_ae
        (integrableOn_prawitzCotSeriesTerm x n).norm
        (integrable_const _) (by
          filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
          rw [Real.norm_eq_abs]
          exact abs_prawitzCotSeriesTerm_le x n hu)
    _ = 4 / ((n : ℝ) + 1) ^ 2 := by simp

theorem summable_integral_norm_prawitzCotSeriesTerm (x : ℝ) :
    Summable (fun n : ℕ =>
      ∫ u in Icc (0 : ℝ) 1, ‖prawitzCotSeriesTerm x n u‖) := by
  have hs : Summable (fun n : ℕ => 4 / ((n : ℝ) + 1) ^ 2) := by
    have h := (summable_prawitzInverseSquareTail (0 : ℝ)).mul_left 4
    simpa using h
  exact Summable.of_nonneg_of_le
    (fun n => integral_nonneg fun _ => norm_nonneg _)
    (fun n => integral_norm_prawitzCotSeriesTerm_le x n) hs

/-- The endpoint-regularized cotangent series may be integrated term by
term on the unit interval. -/
theorem integral_tsum_prawitzCotSeriesTerm (x : ℝ) :
    (∫ u : ℝ in 0..1, ∑' n, prawitzCotSeriesTerm x n u) =
      ∑' n, ∫ u : ℝ in 0..1, prawitzCotSeriesTerm x n u := by
  have hset := (MeasureTheory.integral_tsum_of_summable_integral_norm
    (fun n => integrableOn_prawitzCotSeriesTerm x n)
    (summable_integral_norm_prawitzCotSeriesTerm x)).symm
  change (∫ u in Icc (0 : ℝ) 1, ∑' n, prawitzCotSeriesTerm x n u) =
    ∑' n, ∫ u in Icc (0 : ℝ) 1, prawitzCotSeriesTerm x n u at hset
  simpa only [integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)] using hset

theorem abs_prawitzCotBaseIntegrand_le
    (x : ℝ) {u : ℝ} (hu : u ∈ Icc (0 : ℝ) 1) :
    |prawitzCotBaseIntegrand x u| ≤ 2 * |x| := by
  by_cases hu0 : u = 0
  · subst u
    simp [prawitzCotBaseIntegrand]
  · have habsu : 0 < |u| := abs_pos.mpr hu0
    have hden : 0 < Real.pi * |u| := mul_pos Real.pi_pos habsu
    have hfac : |1 - u| ≤ 1 := by
      rw [abs_of_nonneg (by linarith [hu.2] : 0 ≤ 1 - u)]
      linarith [hu.1]
    unfold prawitzCotBaseIntegrand
    rw [abs_div, abs_mul, abs_mul, abs_of_pos Real.pi_pos]
    calc
      |1 - u| * |Real.sin (2 * Real.pi * x * u)| /
          (Real.pi * |u|) ≤
          |1 - u| * |2 * Real.pi * x * u| /
            (Real.pi * |u|) := by
        apply (div_le_div_iff_of_pos_right hden).2
        exact mul_le_mul_of_nonneg_left
          (Real.abs_sin_le_abs :
            |Real.sin (2 * Real.pi * x * u)| ≤ |2 * Real.pi * x * u|)
          (abs_nonneg _)
      _ = 2 * |1 - u| * |x| := by
        rw [abs_mul, abs_mul, abs_mul,
          abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2),
          abs_of_pos Real.pi_pos]
        field_simp [abs_ne_zero.mpr hu0, Real.pi_ne_zero]
      _ ≤ 2 * |x| := by
        simpa only [mul_one] using
          (mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hfac (by norm_num : (0 : ℝ) ≤ 2))
            (abs_nonneg x))

theorem integrableOn_prawitzCotBaseIntegrand (x : ℝ) :
    IntegrableOn (prawitzCotBaseIntegrand x) (Icc 0 1) := by
  have hmeas : AEStronglyMeasurable (prawitzCotBaseIntegrand x)
      (volume.restrict (Icc (0 : ℝ) 1)) := by
    apply Measurable.aestronglyMeasurable
    unfold prawitzCotBaseIntegrand
    fun_prop
  apply (integrable_const (2 * |x| : ℝ)).mono' hmeas
  filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
  rw [Real.norm_eq_abs]
  exact abs_prawitzCotBaseIntegrand_le x hu

/-- The unit Prawitz point kernel is exactly the interval integral of its
real trigonometric integrand. -/
theorem prawitzPointKernel_eq_integral_unitPointIntegrand (z : ℝ) :
    prawitzPointKernel 1 z =
      ∫ u in Icc (0 : ℝ) 1, prawitzUnitPointIntegrand z u := by
  have hdirac : Integrable (fun y : ℝ => |y|) (Measure.dirac z) :=
    integrable_dirac (by simp)
  have hInt : IntegrableOn
      (symmetricPrawitzPVIntegrand 1
        (MeasureTheory.charFun (Measure.dirac z)) 0) (Icc 0 1) :=
    integrableOn_symmetricPrawitzPVIntegrand_charFun
      (Measure.dirac z) hdirac (by norm_num) 0
  unfold prawitzPointKernel prawitzInversion prawitzUnitPointIntegrand
  symm
  calc
    (∫ u in Icc (0 : ℝ) 1,
        ((Complex.I / (2 * Real.pi : ℝ)) *
          symmetricPrawitzPVIntegrand 1
            (MeasureTheory.charFun (Measure.dirac z)) 0 u).re) =
      (∫ u in Icc (0 : ℝ) 1,
        (Complex.I / (2 * Real.pi : ℝ)) *
          symmetricPrawitzPVIntegrand 1
            (MeasureTheory.charFun (Measure.dirac z)) 0 u).re :=
        integral_re (hInt.const_mul _)
    _ = ((Complex.I / (2 * Real.pi : ℝ)) *
        ∫ u in Icc (0 : ℝ) 1,
          symmetricPrawitzPVIntegrand 1
            (MeasureTheory.charFun (Measure.dirac z)) 0 u).re := by
      exact congrArg Complex.re
        (MeasureTheory.integral_const_mul
          (μ := volume.restrict (Icc (0 : ℝ) 1))
          (Complex.I / (2 * Real.pi : ℝ))
          (symmetricPrawitzPVIntegrand 1
            (MeasureTheory.charFun (Measure.dirac z)) 0))

/-- At zero displacement the paired unit-window point integrand is the
elementary triangular imaginary kernel. -/
theorem symmetricPrawitzPVIntegrand_charFun_dirac_zero
    {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    symmetricPrawitzPVIntegrand 1
        (MeasureTheory.charFun (Measure.dirac 0)) 0 u =
      (((-2 * Real.pi * (1 - u) : ℝ) : ℂ)) * Complex.I := by
  have hnum :
      prawitzPVNumerator 1
          (MeasureTheory.charFun (Measure.dirac 0)) 0 u =
        prawitzSmoothingFilter u := by
    unfold prawitzPVNumerator scaledPrawitzSmoothingFilter
    rw [MeasureTheory.charFun_dirac]
    simp
  have him : (prawitzSmoothingFilter u).im =
      -(1 - u) * Real.pi * u := by
    rw [prawitzSmoothingFilter, if_pos (by simpa [abs_of_pos hu0] using hu1)]
    simp only [abs_of_pos hu0, Complex.sub_im, Complex.ofReal_im,
      Complex.mul_im, Complex.ofReal_re, Complex.I_im, Complex.I_re,
      zero_mul, mul_one, add_zero, zero_sub]
    ring
  rw [symmetricPrawitzPVIntegrand,
    prawitzPVIntegrand_neg
      (isHermitianFrequencyFunction_charFun (Measure.dirac 0)) 0 hu0.ne',
    ← sub_eq_add_neg, Complex.sub_conj, prawitzPVIntegrand,
    Complex.div_ofReal_im, hnum, him]
  push_cast
  field_simp [hu0.ne']

theorem integral_symmetricPrawitzPVIntegrand_charFun_dirac_zero :
    (∫ u in Icc (0 : ℝ) 1,
      symmetricPrawitzPVIntegrand 1
        (MeasureTheory.charFun (Measure.dirac 0)) 0 u) =
      -Real.pi * Complex.I := by
  have hcongr :
      (∫ u in Icc (0 : ℝ) 1,
        symmetricPrawitzPVIntegrand 1
          (MeasureTheory.charFun (Measure.dirac 0)) 0 u) =
        ∫ u in Icc (0 : ℝ) 1,
          (((-2 * Real.pi * (1 - u) : ℝ) : ℂ)) * Complex.I := by
    apply integral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Icc,
        (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 0,
        (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 1] with u hu hu0 hu1
    exact symmetricPrawitzPVIntegrand_charFun_dirac_zero
      (lt_of_le_of_ne hu.1 (Ne.symm hu0))
      (lt_of_le_of_ne hu.2 hu1)
  rw [hcongr, integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  have hpoly :
      (∫ u : ℝ in 0..1, (((1 - u : ℝ) : ℂ))) = (1 / 2 : ℂ) := by
    rw [intervalIntegral.integral_ofReal]
    have hreal :
        (∫ u : ℝ in 0..1, (1 - u : ℝ)) = (1 / 2 : ℝ) := by
      calc
        _ = (∫ _u : ℝ in 0..1, (1 : ℝ)) -
            (∫ u : ℝ in 0..1, u) :=
          intervalIntegral.integral_sub
            intervalIntegral.intervalIntegrable_const
            intervalIntegral.intervalIntegrable_id
        _ = (1 : ℝ) - 1 / 2 := by
          rw [integral_one, integral_id]
          field_simp
          norm_num
        _ = 1 / 2 := by norm_num
    rw [hreal]
    norm_num
  have hinner :
      (∫ u : ℝ in 0..1, (((1 - u : ℝ) : ℂ)) * Complex.I) =
        (1 / 2 : ℂ) * Complex.I := by
    calc
      _ = (∫ u : ℝ in 0..1, (((1 - u : ℝ) : ℂ))) * Complex.I :=
        intervalIntegral.integral_mul_const Complex.I
          (fun u : ℝ => (((1 - u : ℝ) : ℂ)))
      _ = (1 / 2 : ℂ) * Complex.I := by rw [hpoly]
  have houter :
      (∫ u : ℝ in 0..1,
        (((-2 * Real.pi * (1 - u) : ℝ) : ℂ)) * Complex.I) =
        ((-2 * Real.pi : ℝ) : ℂ) * ((1 / 2 : ℂ) * Complex.I) := by
    rw [show (fun u : ℝ => (((-2 * Real.pi * (1 - u) : ℝ) : ℂ)) *
        Complex.I) = fun u => (((-2 * Real.pi : ℝ) : ℂ) *
          ((((1 - u : ℝ) : ℂ)) * Complex.I)) by
        funext u
        push_cast
        ring]
    calc
      _ = ((-2 * Real.pi : ℝ) : ℂ) *
          (∫ u : ℝ in 0..1, (((1 - u : ℝ) : ℂ)) * Complex.I) :=
        intervalIntegral.integral_const_mul ((-2 * Real.pi : ℝ) : ℂ)
          (fun u : ℝ => (((1 - u : ℝ) : ℂ)) * Complex.I)
      _ = ((-2 * Real.pi : ℝ) : ℂ) *
          ((1 / 2 : ℂ) * Complex.I) := by rw [hinner]
  rw [houter]
  push_cast
  ring

theorem prawitzPointKernel_zero : prawitzPointKernel 1 0 = 1 / 2 := by
  unfold prawitzPointKernel prawitzInversion
  rw [integral_symmetricPrawitzPVIntegrand_charFun_dirac_zero]
  have hcomplex :
      (Complex.I / (2 * Real.pi : ℝ)) * (-Real.pi * Complex.I) =
        (1 / 2 : ℂ) := by
    field_simp [Real.pi_ne_zero]
    rw [pow_two, Complex.I_mul_I]
    push_cast
    ring
  rw [hcomplex]
  norm_num

theorem integrableOn_prawitzUnitPointIntegrand (z : ℝ) :
    IntegrableOn (prawitzUnitPointIntegrand z) (Icc 0 1) := by
  have hdirac : Integrable (fun y : ℝ => |y|) (Measure.dirac z) :=
    integrable_dirac (by simp)
  have hInt : IntegrableOn
      (symmetricPrawitzPVIntegrand 1
        (MeasureTheory.charFun (Measure.dirac z)) 0) (Icc 0 1) :=
    integrableOn_symmetricPrawitzPVIntegrand_charFun
      (Measure.dirac z) hdirac (by norm_num) 0
  unfold prawitzUnitPointIntegrand
  exact (hInt.const_mul _).re

/-- The cotangent--sine term has removable endpoint singularities and is
integrable on the closed unit window. -/
theorem integrableOn_prawitzCotangentSineIntegrand (x : ℝ) :
    IntegrableOn (prawitzCotangentSineIntegrand x) (Icc 0 1) := by
  let e : ℝ → ℝ := fun u =>
    (1 - u) * Real.cos (2 * Real.pi * x * u) +
      Real.sin (2 * Real.pi * x * u) / Real.pi
  have he : IntegrableOn e (Icc 0 1) :=
    (by fun_prop : Continuous e).integrableOn_Icc
  have hp := integrableOn_prawitzUnitPointIntegrand (-2 * Real.pi * x)
  apply (hp.sub he).congr
  filter_upwards [ae_restrict_mem measurableSet_Icc,
      (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 0,
      (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 1] with u hu hu0 hu1
  have hpoint :
      prawitzUnitPointIntegrand (-2 * Real.pi * x) u =
        e u + prawitzCotangentSineIntegrand x u := by
    dsimp only [e]
    exact prawitzUnitPointIntegrand_neg_two_pi_eq x
      (lt_of_le_of_ne hu.1 (Ne.symm hu0))
      (lt_of_le_of_ne hu.2 hu1)
  change prawitzUnitPointIntegrand (-2 * Real.pi * x) u - e u = _
  rw [hpoint]
  ring

theorem integrableOn_tsum_prawitzCotSeriesTerm (x : ℝ) :
    IntegrableOn (fun u => ∑' n, prawitzCotSeriesTerm x n u) (Icc 0 1) := by
  have hcot := integrableOn_prawitzCotangentSineIntegrand x
  have hbase := integrableOn_prawitzCotBaseIntegrand x
  apply (hcot.sub hbase).congr
  filter_upwards [ae_restrict_mem measurableSet_Icc,
      (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 0,
      (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 1] with u hu hu0 hu1
  have hpoint := prawitzCotangentSineIntegrand_eq_base_add_tsum x
    (lt_of_le_of_ne hu.1 (Ne.symm hu0))
    (lt_of_le_of_ne hu.2 hu1)
  change prawitzCotangentSineIntegrand x u -
    prawitzCotBaseIntegrand x u = _
  linarith

/-- Integral form of the Mittag--Leffler expansion: the cotangent integral
is a removable base integral plus the sum of the regularized term integrals. -/
theorem integral_prawitzCotangentSineIntegrand_eq_base_add_tsum (x : ℝ) :
    (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand x u) =
      (∫ u : ℝ in 0..1, prawitzCotBaseIntegrand x u) +
        ∑' n, ∫ u : ℝ in 0..1, prawitzCotSeriesTerm x n u := by
  have hcongr :
      (∫ u in Icc (0 : ℝ) 1, prawitzCotangentSineIntegrand x u) =
        ∫ u in Icc (0 : ℝ) 1,
          (prawitzCotBaseIntegrand x u +
            ∑' n, prawitzCotSeriesTerm x n u) := by
    apply integral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Icc,
        (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 0,
        (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 1] with u hu hu0 hu1
    exact prawitzCotangentSineIntegrand_eq_base_add_tsum x
      (lt_of_le_of_ne hu.1 (Ne.symm hu0))
      (lt_of_le_of_ne hu.2 hu1)
  rw [MeasureTheory.integral_add (integrableOn_prawitzCotBaseIntegrand x)
    (integrableOn_tsum_prawitzCotSeriesTerm x)] at hcongr
  simp_rw [integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)] at hcongr
  rw [hcongr, integral_tsum_prawitzCotSeriesTerm]

/-- Real Riemann--Lebesgue lemma in the sine-transform normalization used by
the Prawitz formulas. -/
theorem tendsto_integral_sin_mul_atTop_of_integrable
    (f : ℝ → ℝ) (hf : Integrable f) :
    Tendsto (fun w : ℝ => ∫ v : ℝ, Real.sin (2 * Real.pi * v * w) * f v)
      atTop (𝓝 0) := by
  let fc : ℝ → ℂ := fun v => (f v : ℂ)
  have hfc : Integrable fc := hf.ofReal
  have hcomplex :=
    (Real.tendsto_integral_exp_smul_cocompact fc).mono_left
      (_root_.atTop_le_cocompact : atTop ≤ cocompact ℝ)
  have him := Complex.continuous_im.continuousAt.tendsto.comp hcomplex
  have hneg := him.neg
  convert hneg using 1
  · funext w
    simp only [Function.comp_apply]
    have hInt : Integrable (fun v : ℝ => 𝐞 (-(v * w)) • fc v) := by
      simpa only [real_inner_comm] using
        ((Real.fourierIntegral_convergent_iff w).2 hfc)
    change (∫ v : ℝ, Real.sin (2 * Real.pi * v * w) * f v) =
      -RCLike.im (∫ v : ℝ, 𝐞 (-(v * w)) • fc v)
    calc
      _ = -∫ v : ℝ, RCLike.im (𝐞 (-(v * w)) • fc v) := by
        rw [← MeasureTheory.integral_neg]
        apply MeasureTheory.integral_congr_ae
        filter_upwards with v
        have hexp :
            (Complex.exp (↑(2 * Real.pi * (-(v * w))) * Complex.I)).im =
              -Real.sin (2 * Real.pi * v * w) := by
          rw [show (↑(2 * Real.pi * (-(v * w))) : ℂ) * Complex.I =
              ((-(2 * Real.pi * v * w) : ℝ) : ℂ) * Complex.I by
                push_cast
                ring,
            Complex.exp_ofReal_mul_I_im, Real.sin_neg]
        rw [Circle.smul_def, Real.fourierChar_apply]
        change Real.sin (2 * Real.pi * v * w) * f v =
          -(Complex.exp (↑(2 * Real.pi * (-(v * w))) * Complex.I) *
            (f v : ℂ)).im
        rw [Complex.mul_im, hexp]
        simp
      _ = _ := congrArg Neg.neg (integral_im hInt)
  · simp

/-- The frequency-independent coefficient of a regularized cotangent-series
term. -/
noncomputable def prawitzCotSeriesWeight : ℕ → ℝ → ℝ
  | 0, u => -2 * u / (Real.pi * (u + 1))
  | n + 1, u => ((1 - u) / Real.pi) *
      (1 / (u - ((n : ℝ) + 2)) + 1 / (u + ((n : ℝ) + 2)))

theorem prawitzCotSeriesTerm_eq_weight_mul (x : ℝ) (n : ℕ) (u : ℝ) :
    prawitzCotSeriesTerm x n u =
      prawitzCotSeriesWeight n u * Real.sin (2 * Real.pi * x * u) := by
  cases n <;> simp [prawitzCotSeriesTerm, prawitzCotSeriesWeight]

theorem abs_prawitzCotSeriesWeight_le
    (n : ℕ) {u : ℝ} (hu : u ∈ Icc (0 : ℝ) 1) :
    |prawitzCotSeriesWeight n u| ≤ 4 / ((n : ℝ) + 1) ^ 2 := by
  cases n with
  | zero =>
      simp only [prawitzCotSeriesWeight, Nat.cast_zero, zero_add,
        one_pow, div_one]
      have hup : 0 < u + 1 := by linarith [hu.1]
      have hden : 0 < Real.pi * (u + 1) := mul_pos Real.pi_pos hup
      rw [abs_div, abs_of_nonpos (by linarith [hu.1] : -2 * u ≤ 0),
        abs_of_pos hden]
      apply (div_le_iff₀ hden).2
      nlinarith [Real.two_le_pi]
  | succ n =>
      let m : ℝ := (n : ℝ) + 2
      have hm : 2 ≤ m := by
        dsimp [m]
        exact le_add_of_nonneg_left (Nat.cast_nonneg n)
      have hum : u - m < 0 := by linarith [hu.2]
      have hup : 0 < u + m := by linarith [hu.1]
      have hden : 0 < m ^ 2 - u ^ 2 := by
        nlinarith [sq_nonneg (m - u)]
      have hqeq :
          1 / (u - m) + 1 / (u + m) = -2 * u / (m ^ 2 - u ^ 2) := by
        field_simp [hum.ne, hup.ne']
        ring
      have hqabs :
          |1 / (u - m) + 1 / (u + m)| =
            2 * u / (m ^ 2 - u ^ 2) := by
        rw [hqeq, abs_div,
          abs_of_nonpos (by linarith [hu.1] : -2 * u ≤ 0),
          abs_of_pos hden]
        ring
      have hq :
          |1 / (u - m) + 1 / (u + m)| ≤ 4 / m ^ 2 := by
        rw [hqabs]
        have hmpos : 0 < m ^ 2 := sq_pos_of_pos (by linarith : 0 < m)
        apply (div_le_div_iff₀ hden hmpos).2
        have hu_sq : u ^ 2 ≤ 1 := by
          nlinarith [sq_nonneg (1 - u), hu.1, hu.2]
        have hm_sq : 4 ≤ m ^ 2 := by nlinarith [sq_nonneg (m - 2)]
        have hleft : 2 * u * m ^ 2 ≤ 2 * m ^ 2 := by
          exact mul_le_mul_of_nonneg_right
            (by linarith [hu.2] : 2 * u ≤ 2) (sq_nonneg m)
        have hright : 2 * m ^ 2 ≤ 4 * (m ^ 2 - u ^ 2) := by
          nlinarith
        exact hleft.trans hright
      have hfac : |(1 - u) / Real.pi| ≤ 1 := by
        rw [abs_div, abs_of_nonneg (by linarith [hu.2] : 0 ≤ 1 - u),
          abs_of_pos Real.pi_pos]
        apply (div_le_one Real.pi_pos).2
        linarith [Real.two_le_pi, hu.1]
      simp only [prawitzCotSeriesWeight, Nat.cast_add, Nat.cast_one]
      rw [show (n : ℝ) + 1 + 1 = (n : ℝ) + 2 by ring]
      change |((1 - u) / Real.pi) *
          (1 / (u - m) + 1 / (u + m))| ≤ 4 / m ^ 2
      rw [abs_mul]
      exact (mul_le_of_le_one_left (abs_nonneg _) hfac).trans hq

theorem integrableOn_prawitzCotSeriesWeight (n : ℕ) :
    IntegrableOn (prawitzCotSeriesWeight n) (Icc 0 1) := by
  have hmeas : AEStronglyMeasurable (prawitzCotSeriesWeight n)
      (volume.restrict (Icc (0 : ℝ) 1)) := by
    apply Measurable.aestronglyMeasurable
    cases n with
    | zero =>
        change Measurable (fun u : ℝ => -2 * u / (Real.pi * (u + 1)))
        fun_prop
    | succ n =>
        change Measurable (fun u : ℝ => ((1 - u) / Real.pi) *
          (1 / (u - ((n : ℝ) + 2)) + 1 / (u + ((n : ℝ) + 2))))
        fun_prop
  apply (integrable_const (4 / ((n : ℝ) + 1) ^ 2 : ℝ)).mono' hmeas
  filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
  rw [Real.norm_eq_abs]
  exact abs_prawitzCotSeriesWeight_le n hu

theorem tendsto_integral_prawitzCotSeriesTerm_atTop (n : ℕ) :
    Tendsto (fun x : ℝ =>
      ∫ u : ℝ in 0..1, prawitzCotSeriesTerm x n u) atTop (𝓝 0) := by
  let f : ℝ → ℝ := (Icc (0 : ℝ) 1).indicator
    (prawitzCotSeriesWeight n)
  have hf : Integrable f :=
    (integrableOn_prawitzCotSeriesWeight n).integrable_indicator measurableSet_Icc
  have hrl := tendsto_integral_sin_mul_atTop_of_integrable f hf
  apply hrl.congr'
  filter_upwards with x
  have hset :
      (∫ u in Icc (0 : ℝ) 1, prawitzCotSeriesTerm x n u) =
        ∫ u : ℝ, Real.sin (2 * Real.pi * u * x) * f u := by
    dsimp only [f]
    rw [show (fun u : ℝ => Real.sin (2 * Real.pi * u * x) *
        (Icc (0 : ℝ) 1).indicator (prawitzCotSeriesWeight n) u) =
      fun u => (Icc (0 : ℝ) 1).indicator (prawitzCotSeriesWeight n) u *
        Real.sin (2 * Real.pi * u * x) by funext u; ring_nf]
    rw [show (fun u : ℝ =>
        (Icc (0 : ℝ) 1).indicator (prawitzCotSeriesWeight n) u *
          Real.sin (2 * Real.pi * u * x)) =
      (Icc (0 : ℝ) 1).indicator (fun u =>
        prawitzCotSeriesWeight n u * Real.sin (2 * Real.pi * u * x)) by
          funext u
          by_cases hu : u ∈ Icc (0 : ℝ) 1 <;> simp [hu]]
    rw [integral_indicator measurableSet_Icc]
    apply MeasureTheory.integral_congr_ae
    filter_upwards with u
    rw [prawitzCotSeriesTerm_eq_weight_mul]
    ring_nf
  simpa only [integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)] using hset.symm

theorem norm_integral_prawitzCotSeriesTerm_le (x : ℝ) (n : ℕ) :
    ‖∫ u : ℝ in 0..1, prawitzCotSeriesTerm x n u‖ ≤
      4 / ((n : ℝ) + 1) ^ 2 := by
  have hEq :
      (∫ u in Icc (0 : ℝ) 1, prawitzCotSeriesTerm x n u) =
        ∫ u : ℝ in 0..1, prawitzCotSeriesTerm x n u := by
    simp only [integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  rw [← hEq]
  exact (norm_integral_le_integral_norm _).trans
    (integral_norm_prawitzCotSeriesTerm_le x n)

/-- The sum of all regularized cotangent-series integrals vanishes at high
spatial frequency. -/
theorem tendsto_tsum_integral_prawitzCotSeriesTerm_atTop :
    Tendsto (fun x : ℝ =>
      ∑' n, ∫ u : ℝ in 0..1, prawitzCotSeriesTerm x n u)
      atTop (𝓝 0) := by
  have hs : Summable (fun n : ℕ => 4 / ((n : ℝ) + 1) ^ 2) := by
    have h := (summable_prawitzInverseSquareTail (0 : ℝ)).mul_left 4
    simpa using h
  have h := tendsto_tsum_of_dominated_convergence hs
    tendsto_integral_prawitzCotSeriesTerm_atTop
    (Eventually.of_forall fun x n => norm_integral_prawitzCotSeriesTerm_le x n)
  simpa using h

/-- The regularized cotangent-series contribution vanishes at high spatial
frequency; only the removable `1/u` base integral survives. -/
theorem tendsto_prawitzCotangentIntegral_sub_base_atTop :
    Tendsto (fun x : ℝ =>
      (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand x u) -
        ∫ u : ℝ in 0..1, prawitzCotBaseIntegrand x u)
      atTop (𝓝 0) := by
  convert tendsto_tsum_integral_prawitzCotSeriesTerm_atTop using 1
  funext x
  rw [integral_prawitzCotangentSineIntegrand_eq_base_add_tsum]
  ring

/-- Reflection cancels the odd cotangent/sine part of the real point
integrand, leaving an elementary Fejér-type cosine kernel. -/
theorem prawitzUnitPointIntegrand_add_neg
    (z : ℝ) {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1) :
    prawitzUnitPointIntegrand z u +
        prawitzUnitPointIntegrand (-z) u =
      2 * (1 - u) * Real.cos (z * u) := by
  rw [prawitzUnitPointIntegrand_eq_explicit z hu0 hu1,
    prawitzUnitPointIntegrand_eq_explicit (-z) hu0 hu1]
  rw [show -z * u = -(z * u) by ring, Real.cos_neg, Real.sin_neg]
  ring

theorem integral_two_mul_one_sub_mul_cos
    {z : ℝ} (hz : z ≠ 0) :
    (∫ u : ℝ in 0..1, 2 * (1 - u) * Real.cos (z * u)) =
      2 * (1 - Real.cos z) / z ^ 2 := by
  let F : ℝ → ℝ := fun u => 2 *
    ((1 - u) * Real.sin (z * u) / z - Real.cos (z * u) / z ^ 2)
  have hF (u : ℝ) :
      HasDerivAt F (2 * (1 - u) * Real.cos (z * u)) u := by
    have hlin : HasDerivAt (fun v : ℝ => 1 - v) (-1) u := by
      convert (hasDerivAt_const u 1).sub (hasDerivAt_id u) using 1; ring
    have harg : HasDerivAt (fun v : ℝ => z * v) z u :=
      by convert (hasDerivAt_id u).const_mul z using 1; simp
    have hsin : HasDerivAt (fun v : ℝ => Real.sin (z * v))
        (Real.cos (z * u) * z) u :=
      (Real.hasDerivAt_sin (z * u)).comp u harg
    have hcos : HasDerivAt (fun v : ℝ => Real.cos (z * v))
        (-Real.sin (z * u) * z) u :=
      (Real.hasDerivAt_cos (z * u)).comp u harg
    have h := ((hlin.mul hsin).div_const z).sub (hcos.div_const (z ^ 2))
    convert h.const_mul 2 using 1
    dsimp only [F]; field_simp [hz]; ring
  have hInt : IntervalIntegrable
      (fun u : ℝ => 2 * (1 - u) * Real.cos (z * u)) volume 0 1 :=
    (by fun_prop : Continuous fun u : ℝ =>
      2 * (1 - u) * Real.cos (z * u)).intervalIntegrable 0 1
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (a := (0 : ℝ)) (b := 1) (f := F)
    (f' := fun u => 2 * (1 - u) * Real.cos (z * u))
    (fun u _ => hF u) hInt
  rw [hFTC]
  dsimp only [F]
  simp only [sub_self, zero_mul, Real.sin_zero, mul_zero, zero_div,
    Real.cos_zero]
  field_simp [hz]
  ring

theorem integral_one_sub_mul_cos
    {a : ℝ} (ha : a ≠ 0) :
    (∫ u : ℝ in 0..1, (1 - u) * Real.cos (a * u)) =
      (1 - Real.cos a) / a ^ 2 := by
  have h := integral_two_mul_one_sub_mul_cos (z := a) ha
  rw [show (fun u : ℝ => 2 * (1 - u) * Real.cos (a * u)) =
      fun u => 2 * ((1 - u) * Real.cos (a * u)) by funext u; ring,
    intervalIntegral.integral_const_mul] at h
  calc
    _ = (2 * (∫ u : ℝ in 0..1, (1 - u) * Real.cos (a * u))) / 2 := by
      ring
    _ = (2 * (1 - Real.cos a) / a ^ 2) / 2 := by rw [h]
    _ = (1 - Real.cos a) / a ^ 2 := by ring

theorem integral_sin_mul_div_pi
    {a : ℝ} (ha : a ≠ 0) :
    (∫ u : ℝ in 0..1, Real.sin (a * u) / Real.pi) =
      (1 - Real.cos a) / (Real.pi * a) := by
  have hchange := intervalIntegral.integral_comp_mul_left
    (f := Real.sin) (a := (0 : ℝ)) (b := 1) ha
  simp only [mul_zero, mul_one] at hchange
  rw [integral_sin] at hchange
  simp only [Real.cos_zero, smul_eq_mul] at hchange
  rw [show (fun u : ℝ => Real.sin (a * u) / Real.pi) =
      fun u => (1 / Real.pi) * Real.sin (a * u) by funext u; ring,
    intervalIntegral.integral_const_mul, hchange]
  field_simp [Real.pi_ne_zero, ha]

/-- Exact reduction of the negative-spatial Prawitz point kernel to two
elementary integrals and one cotangent--sine integral. -/
theorem prawitzPointKernel_neg_two_pi_eq
    {x : ℝ} (hx : x ≠ 0) :
    prawitzPointKernel 1 (-2 * Real.pi * x) =
      (1 - Real.cos (2 * Real.pi * x)) / (2 * Real.pi * x) ^ 2 +
        (1 - Real.cos (2 * Real.pi * x)) /
          (Real.pi * (2 * Real.pi * x)) +
        ∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand x u := by
  rw [prawitzPointKernel_eq_integral_unitPointIntegrand]
  have hcongr :
      (∫ u in Icc (0 : ℝ) 1,
          prawitzUnitPointIntegrand (-2 * Real.pi * x) u) =
        ∫ u in Icc (0 : ℝ) 1,
          ((1 - u) * Real.cos (2 * Real.pi * x * u) +
            Real.sin (2 * Real.pi * x * u) / Real.pi +
              prawitzCotangentSineIntegrand x u) := by
    apply integral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Icc,
        (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 0,
        (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 1] with u hu hu0 hu1
    exact prawitzUnitPointIntegrand_neg_two_pi_eq x
      (lt_of_le_of_ne hu.1 (Ne.symm hu0))
      (lt_of_le_of_ne hu.2 hu1)
  rw [hcongr]
  have hcos : IntegrableOn
      (fun u : ℝ => (1 - u) * Real.cos (2 * Real.pi * x * u))
      (Icc 0 1) := (by fun_prop : Continuous fun u : ℝ =>
        (1 - u) * Real.cos (2 * Real.pi * x * u)).integrableOn_Icc
  have hsin : IntegrableOn
      (fun u : ℝ => Real.sin (2 * Real.pi * x * u) / Real.pi)
      (Icc 0 1) := (by fun_prop : Continuous fun u : ℝ =>
        Real.sin (2 * Real.pi * x * u) / Real.pi).integrableOn_Icc
  have hsplit1 :
      (∫ u in Icc (0 : ℝ) 1,
        ((1 - u) * Real.cos (2 * Real.pi * x * u) +
          Real.sin (2 * Real.pi * x * u) / Real.pi) +
            prawitzCotangentSineIntegrand x u) =
        (∫ u in Icc (0 : ℝ) 1,
          ((1 - u) * Real.cos (2 * Real.pi * x * u) +
            Real.sin (2 * Real.pi * x * u) / Real.pi)) +
          ∫ u in Icc (0 : ℝ) 1, prawitzCotangentSineIntegrand x u :=
    MeasureTheory.integral_add (hcos.add hsin)
      (integrableOn_prawitzCotangentSineIntegrand x)
  have hsplit2 :
      (∫ u in Icc (0 : ℝ) 1,
        ((1 - u) * Real.cos (2 * Real.pi * x * u) +
          Real.sin (2 * Real.pi * x * u) / Real.pi)) =
        (∫ u in Icc (0 : ℝ) 1,
          (1 - u) * Real.cos (2 * Real.pi * x * u)) +
          ∫ u in Icc (0 : ℝ) 1,
            Real.sin (2 * Real.pi * x * u) / Real.pi :=
    MeasureTheory.integral_add hcos hsin
  rw [hsplit1, hsplit2]
  simp_rw [integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  rw [integral_one_sub_mul_cos (mul_ne_zero (mul_ne_zero (by norm_num)
      Real.pi_ne_zero) hx),
    integral_sin_mul_div_pi (mul_ne_zero (mul_ne_zero (by norm_num)
      Real.pi_ne_zero) hx)]

/-- The sole remaining analytic content of the positive-half-line Fourier
identification is an exact cotangent--sine integral. -/
theorem prawitzPointKernel_positive_identity_iff_cotangentIntegral
    {x : ℝ} (hx : 0 < x) :
    (2 * prawitzPointKernel 1 (-2 * Real.pi * x) - 1 =
        prawitzVaalerPositiveRemainder x) ↔
      (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand x u) =
        1 / 2 - (Real.sin (Real.pi * x) / Real.pi) ^ 2 *
          (prawitzInverseSquareTail x + 1 / (2 * x ^ 2)) := by
  rw [prawitzPointKernel_neg_two_pi_eq hx.ne']
  unfold prawitzVaalerPositiveRemainder
  rw [show Real.cos (2 * Real.pi * x) = Real.cos (2 * (Real.pi * x)) by
    congr 1
    ring]
  rw [Real.cos_two_mul]
  rw [show 1 - (2 * Real.cos (Real.pi * x) ^ 2 - 1) =
      2 * Real.sin (Real.pi * x) ^ 2 by rw [Real.sin_sq]; ring]
  field_simp [Real.pi_ne_zero, hx.ne']
  constructor <;> intro h <;> linarith

/-- Shifting the spatial argument by one removes the cotangent singularity
from the difference of the two Prawitz integrands. -/
theorem prawitzCotangentSineIntegrand_add_one_sub (x : ℝ) {u : ℝ}
    (hu0 : 0 < u) (hu1 : u < 1) :
    prawitzCotangentSineIntegrand (x + 1) u -
        prawitzCotangentSineIntegrand x u =
      (1 - u) * (Real.cos (2 * Real.pi * x * u) +
        Real.cos (2 * Real.pi * (x + 1) * u)) := by
  unfold prawitzCotangentSineIntegrand
  rw [Real.cot_eq_cos_div_sin]
  have hsin : Real.sin (Real.pi * u) ≠ 0 := by
    rw [Real.sin_ne_zero_iff]
    intro n hn
    have : u = n := by
      apply (mul_left_cancel₀ Real.pi_ne_zero)
      simpa [mul_comm] using hn.symm
    have hn0 : (0 : ℤ) < n := by exact_mod_cast (this ▸ hu0)
    have hn1 : n < (1 : ℤ) := by exact_mod_cast (this ▸ hu1)
    omega
  have htrig :
      Real.sin (2 * Real.pi * (x + 1) * u) -
          Real.sin (2 * Real.pi * x * u) =
        2 * Real.sin (Real.pi * u) *
          Real.cos (2 * Real.pi * x * u + Real.pi * u) := by
    rw [show 2 * Real.pi * (x + 1) * u =
        (2 * Real.pi * x * u + Real.pi * u) + Real.pi * u by ring,
      show 2 * Real.pi * x * u =
        (2 * Real.pi * x * u + Real.pi * u) - Real.pi * u by ring,
      Real.sin_add, Real.sin_sub]
    norm_num
    ring
  have hcos :
      Real.cos (2 * Real.pi * x * u) +
          Real.cos (2 * Real.pi * (x + 1) * u) =
        2 * Real.cos (Real.pi * u) *
          Real.cos (2 * Real.pi * x * u + Real.pi * u) := by
    rw [Real.two_mul_cos_mul_cos]
    rw [show Real.pi * u - (2 * Real.pi * x * u + Real.pi * u) =
        -(2 * Real.pi * x * u) by ring,
      Real.cos_neg]
    congr 1
    ring_nf
  rw [hcos, ← mul_sub, htrig]
  simp only [div_eq_mul_inv]
  ring_nf
  have hsin' : Real.sin (u * Real.pi) ≠ 0 := by
    simpa [mul_comm] using hsin
  field_simp [hsin']

/-- The interval integral of the shifted cotangent--sine integrand differs by
two elementary cosine integrals. -/
theorem integral_prawitzCotangentSineIntegrand_add_one_sub (x : ℝ) :
    (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand (x + 1) u) -
        (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand x u) =
      ∫ u : ℝ in 0..1, (1 - u) *
        (Real.cos (2 * Real.pi * x * u) +
          Real.cos (2 * Real.pi * (x + 1) * u)) := by
  have hsub :
      (∫ u in Icc (0 : ℝ) 1, prawitzCotangentSineIntegrand (x + 1) u) -
          (∫ u in Icc (0 : ℝ) 1, prawitzCotangentSineIntegrand x u) =
        ∫ u in Icc (0 : ℝ) 1,
          (prawitzCotangentSineIntegrand (x + 1) u -
            prawitzCotangentSineIntegrand x u) := by
    rw [MeasureTheory.integral_sub
      (integrableOn_prawitzCotangentSineIntegrand (x + 1))
      (integrableOn_prawitzCotangentSineIntegrand x)]
  have hcongr :
      (∫ u in Icc (0 : ℝ) 1,
        (prawitzCotangentSineIntegrand (x + 1) u -
          prawitzCotangentSineIntegrand x u)) =
        ∫ u in Icc (0 : ℝ) 1, (1 - u) *
          (Real.cos (2 * Real.pi * x * u) +
            Real.cos (2 * Real.pi * (x + 1) * u)) := by
    apply integral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Icc,
        (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 0,
        (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 1] with u hu hu0 hu1
    exact prawitzCotangentSineIntegrand_add_one_sub x
      (lt_of_le_of_ne hu.1 (Ne.symm hu0)) (lt_of_le_of_ne hu.2 hu1)
  simp_rw [integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)] at hsub hcongr
  rw [hsub, hcongr]

/-- Closed form of the unit-shift recurrence for the cotangent--sine
integral, away from the two removable spatial endpoints. -/
theorem integral_prawitzCotangentSineIntegrand_add_one_sub_closed {x : ℝ}
    (hx : x ≠ 0) (hx1 : x + 1 ≠ 0) :
    (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand (x + 1) u) -
        (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand x u) =
      (1 - Real.cos (2 * Real.pi * x)) / (2 * Real.pi * x) ^ 2 +
        (1 - Real.cos (2 * Real.pi * (x + 1))) /
          (2 * Real.pi * (x + 1)) ^ 2 := by
  rw [integral_prawitzCotangentSineIntegrand_add_one_sub]
  rw [show (fun u : ℝ => (1 - u) *
      (Real.cos (2 * Real.pi * x * u) +
        Real.cos (2 * Real.pi * (x + 1) * u))) =
      fun u => (1 - u) * Real.cos (2 * Real.pi * x * u) +
        (1 - u) * Real.cos (2 * Real.pi * (x + 1) * u) by
      funext u
      ring]
  rw [intervalIntegral.integral_add
    ((by fun_prop : Continuous
      (fun u : ℝ => (1 - u) * Real.cos (2 * Real.pi * x * u))).intervalIntegrable 0 1)
    ((by fun_prop : Continuous
      (fun u : ℝ => (1 - u) * Real.cos
        (2 * Real.pi * (x + 1) * u))).intervalIntegrable 0 1)]
  rw [integral_one_sub_mul_cos
      (mul_ne_zero (mul_ne_zero (by norm_num) Real.pi_ne_zero) hx),
    integral_one_sub_mul_cos
      (mul_ne_zero (mul_ne_zero (by norm_num) Real.pi_ne_zero) hx1)]

/-- The cotangent--sine integral equals one half at the first positive integer. -/
theorem integral_prawitzCotangentSineIntegrand_one :
    (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand 1 u) = 1 / 2 := by
  have h := integral_prawitzCotangentSineIntegrand_add_one_sub (0 : ℝ)
  simp only [zero_add] at h
  have hzero :
      (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand 0 u) = 0 := by
    simp [prawitzCotangentSineIntegrand]
  rw [hzero, sub_zero] at h
  rw [show (fun u : ℝ => (1 - u) *
      (Real.cos (2 * Real.pi * 0 * u) +
        Real.cos (2 * Real.pi * 1 * u))) =
      fun u => (1 - u) + (1 - u) * Real.cos (2 * Real.pi * u) by
      funext u
      simp
      ring] at h
  rw [intervalIntegral.integral_add
    ((by fun_prop : Continuous (fun u : ℝ => 1 - u)).intervalIntegrable 0 1)
    ((by fun_prop : Continuous
      (fun u : ℝ => (1 - u) * Real.cos (2 * Real.pi * u))).intervalIntegrable 0 1)] at h
  have hone : (∫ u : ℝ in 0..1, (1 - u)) = 1 / 2 := by
    calc
      _ = (∫ _u : ℝ in 0..1, (1 : ℝ)) - ∫ u : ℝ in 0..1, u := by
        rw [intervalIntegral.integral_sub
          intervalIntegral.intervalIntegrable_const
          intervalIntegral.intervalIntegrable_id]
      _ = 1 / 2 := by rw [integral_one, integral_id]; norm_num
  rw [hone, integral_one_sub_mul_cos
    (mul_ne_zero (by norm_num) Real.pi_ne_zero), Real.cos_two_pi] at h
  simpa only [sub_self, zero_div, add_zero] using h

/-- At every positive integer, the cotangent--sine integral is exactly one
half.  The shift recurrence makes the induction increments vanish. -/
theorem integral_prawitzCotangentSineIntegrand_nat_succ (n : ℕ) :
    (∫ u : ℝ in 0..1,
      prawitzCotangentSineIntegrand ((n + 1 : ℕ) : ℝ) u) = 1 / 2 := by
  induction n with
  | zero => simpa using integral_prawitzCotangentSineIntegrand_one
  | succ n ih =>
      have hx : ((n + 1 : ℕ) : ℝ) ≠ 0 := by positivity
      have hx1 : ((n + 1 : ℕ) : ℝ) + 1 ≠ 0 := by positivity
      have h := integral_prawitzCotangentSineIntegrand_add_one_sub_closed hx hx1
      have hc0 :
          Real.cos (2 * Real.pi * ((n + 1 : ℕ) : ℝ)) = 1 := by
        rw [show 2 * Real.pi * ((n + 1 : ℕ) : ℝ) =
            ((n + 1 : ℕ) : ℝ) * (2 * Real.pi) by ring,
          Real.cos_nat_mul_two_pi]
      have hc1 :
          Real.cos (2 * Real.pi * (((n + 1 : ℕ) : ℝ) + 1)) = 1 := by
        rw [show 2 * Real.pi * (((n + 1 : ℕ) : ℝ) + 1) =
            ((n + 2 : ℕ) : ℝ) * (2 * Real.pi) by push_cast; ring,
          Real.cos_nat_mul_two_pi]
      rw [hc0, hc1] at h
      simp only [sub_self, zero_div, zero_add] at h
      rw [show ((Nat.succ n + 1 : ℕ) : ℝ) =
          ((n + 1 : ℕ) : ℝ) + 1 by push_cast; ring]
      linarith

/-- The positive-half-line Fourier identity holds on the positive integer
lattice. -/
theorem prawitzPointKernel_positive_identity_nat_succ (n : ℕ) :
    2 * prawitzPointKernel 1
        (-2 * Real.pi * ((n + 1 : ℕ) : ℝ)) - 1 =
      prawitzVaalerPositiveRemainder ((n + 1 : ℕ) : ℝ) := by
  have hx : 0 < ((n + 1 : ℕ) : ℝ) := by positivity
  apply (prawitzPointKernel_positive_identity_iff_cotangentIntegral hx).2
  rw [integral_prawitzCotangentSineIntegrand_nat_succ]
  have hsin :
      Real.sin (Real.pi * ((n + 1 : ℕ) : ℝ)) = 0 := by
    rw [mul_comm, Real.sin_nat_mul_pi]
  rw [hsin]
  ring

/-- Real Riemann--Lebesgue lemma for cosine transforms in the normalization
used by the Prawitz formulas. -/
theorem tendsto_integral_cos_mul_atTop_of_integrable
    (f : ℝ → ℝ) (hf : Integrable f) :
    Tendsto (fun w : ℝ => ∫ v : ℝ, Real.cos (2 * Real.pi * v * w) * f v)
      atTop (𝓝 0) := by
  let fc : ℝ → ℂ := fun v => (f v : ℂ)
  have hfc : Integrable fc := hf.ofReal
  have hcomplex :=
    (Real.tendsto_integral_exp_smul_cocompact fc).mono_left
      (_root_.atTop_le_cocompact : atTop ≤ cocompact ℝ)
  have hre := Complex.continuous_re.continuousAt.tendsto.comp hcomplex
  convert hre using 1
  funext w
  simp only [Function.comp_apply]
  have hInt : Integrable (fun v : ℝ => 𝐞 (-(v * w)) • fc v) := by
    simpa only [real_inner_comm] using
      ((Real.fourierIntegral_convergent_iff w).2 hfc)
  change (∫ v : ℝ, Real.cos (2 * Real.pi * v * w) * f v) =
    RCLike.re (∫ v : ℝ, 𝐞 (-(v * w)) • fc v)
  calc
    _ = ∫ v : ℝ, RCLike.re (𝐞 (-(v * w)) • fc v) := by
      apply MeasureTheory.integral_congr_ae
      filter_upwards with v
      have hexp :
          (Complex.exp (↑(2 * Real.pi * (-(v * w))) * Complex.I)).re =
            Real.cos (2 * Real.pi * v * w) := by
        rw [show (↑(2 * Real.pi * (-(v * w))) : ℂ) * Complex.I =
            ((-(2 * Real.pi * v * w) : ℝ) : ℂ) * Complex.I by
              push_cast
              ring,
          Complex.exp_ofReal_mul_I_re, Real.cos_neg]
      rw [Circle.smul_def, Real.fourierChar_apply]
      change Real.cos (2 * Real.pi * v * w) * f v =
        (Complex.exp (↑(2 * Real.pi * (-(v * w))) * Complex.I) *
          (f v : ℂ)).re
      rw [Complex.mul_re, hexp]
      simp
    _ = _ := integral_re hInt

/-- Continuity of a complex Fourier integral in the unnormalized phase
`exp (-i t x)`.  The explicit normalization bridge keeps later Prawitz
arguments independent of the library's `2 * pi` Fourier convention. -/
theorem continuous_integral_cexp_neg_mul_I_mul
    (f : ℝ → ℂ) (hf : Integrable f) :
    Continuous (fun x : ℝ => ∫ t : ℝ,
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) * f t) := by
  have hFourier : Continuous
      (VectorFourier.fourierIntegral 𝐞 volume
        (LinearMap.mul ℝ ℝ) f) :=
    VectorFourier.fourierIntegral_continuous
      Real.continuous_fourierChar (by fun_prop) hf
  have h := hFourier.comp
    (by fun_prop : Continuous (fun x : ℝ => (2 * Real.pi)⁻¹ * x))
  convert h using 1
  funext x
  apply integral_congr_ae
  filter_upwards with t
  rw [Circle.smul_def, Real.fourierChar_apply]
  simp only [LinearMap.mul_apply']
  congr 1
  push_cast
  field_simp [Real.pi_ne_zero]

/-- Complex Riemann--Lebesgue decay in the positive spatial tail, written
with the unnormalized phase used by the signed Prawitz formulas. -/
theorem tendsto_integral_cexp_neg_mul_I_mul_atTop (f : ℝ → ℂ) :
    Tendsto (fun x : ℝ => ∫ t : ℝ,
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) * f t)
      atTop (𝓝 0) := by
  have hscale :
      Tendsto (fun x : ℝ => (2 * Real.pi)⁻¹ * x) atTop atTop :=
    tendsto_id.const_mul_atTop
      (inv_pos.mpr (mul_pos (by norm_num) Real.pi_pos))
  have hrl :=
    (Real.tendsto_integral_exp_smul_cocompact f).mono_left
      (_root_.atTop_le_cocompact : atTop ≤ cocompact ℝ)
  have h := hrl.comp hscale
  convert h using 1
  funext x
  apply integral_congr_ae
  filter_upwards with t
  rw [Circle.smul_def, Real.fourierChar_apply]
  congr 1
  push_cast
  field_simp [Real.pi_ne_zero]

/-- Complex Riemann--Lebesgue decay in the negative spatial tail, written
with the unnormalized phase used by the signed Prawitz formulas. -/
theorem tendsto_integral_cexp_neg_mul_I_mul_atBot (f : ℝ → ℂ) :
    Tendsto (fun x : ℝ => ∫ t : ℝ,
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) * f t)
      atBot (𝓝 0) := by
  have hscale :
      Tendsto (fun x : ℝ => (2 * Real.pi)⁻¹ * x) atBot atBot :=
    tendsto_id.const_mul_atBot
      (inv_pos.mpr (mul_pos (by norm_num) Real.pi_pos))
  have hrl :=
    (Real.tendsto_integral_exp_smul_cocompact f).mono_left
      (_root_.atBot_le_cocompact : atBot ≤ cocompact ℝ)
  have h := hrl.comp hscale
  convert h using 1
  funext x
  apply integral_congr_ae
  filter_upwards with t
  rw [Circle.smul_def, Real.fourierChar_apply]
  congr 1
  push_cast
  field_simp [Real.pi_ne_zero]

/-- The removable coefficient in the difference of two shifted base
integrands. -/
noncomputable def prawitzCotBaseShiftWeight (x u : ℝ) : ℝ :=
  2 * prawitzCotBaseIntegrand (x / 2) u

theorem abs_prawitzCotBaseShiftWeight_le
    (x : ℝ) {u : ℝ} (hu : u ∈ Icc (0 : ℝ) 1) :
    |prawitzCotBaseShiftWeight x u| ≤ 2 * |x| := by
  unfold prawitzCotBaseShiftWeight
  rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
  calc
    2 * |prawitzCotBaseIntegrand (x / 2) u| ≤
        2 * (2 * |x / 2|) :=
      mul_le_mul_of_nonneg_left (abs_prawitzCotBaseIntegrand_le (x / 2) hu)
        (by norm_num)
    _ = 2 * |x| := by rw [abs_div]; norm_num; ring

theorem integrableOn_prawitzCotBaseShiftWeight (x : ℝ) :
    IntegrableOn (prawitzCotBaseShiftWeight x) (Icc 0 1) := by
  unfold prawitzCotBaseShiftWeight
  exact (integrableOn_prawitzCotBaseIntegrand (x / 2)).const_mul 2

theorem prawitzCotBaseIntegrand_add_sub (w x u : ℝ) :
    prawitzCotBaseIntegrand (w + x) u - prawitzCotBaseIntegrand w u =
      Real.cos (2 * Real.pi * u * (w + x / 2)) *
        prawitzCotBaseShiftWeight x u := by
  have htrig :
      Real.sin (2 * Real.pi * (w + x) * u) -
          Real.sin (2 * Real.pi * w * u) =
        2 * Real.sin (Real.pi * x * u) *
          Real.cos (2 * Real.pi * u * (w + x / 2)) := by
    rw [show 2 * Real.pi * (w + x) * u =
        (2 * Real.pi * u * (w + x / 2)) + Real.pi * x * u by ring,
      show 2 * Real.pi * w * u =
        (2 * Real.pi * u * (w + x / 2)) - Real.pi * x * u by ring,
      Real.sin_add, Real.sin_sub]
    ring
  simp only [prawitzCotBaseIntegrand, prawitzCotBaseShiftWeight]
  rw [show 2 * Real.pi * (x / 2) * u = Real.pi * x * u by ring,
    ← sub_div, ← mul_sub, htrig]
  ring

theorem integral_prawitzCotBaseIntegrand_add_sub (w x : ℝ) :
    (∫ u : ℝ in 0..1, prawitzCotBaseIntegrand (w + x) u) -
        (∫ u : ℝ in 0..1, prawitzCotBaseIntegrand w u) =
      ∫ u : ℝ in 0..1,
        Real.cos (2 * Real.pi * u * (w + x / 2)) *
          prawitzCotBaseShiftWeight x u := by
  have hsub :
      (∫ u in Icc (0 : ℝ) 1, prawitzCotBaseIntegrand (w + x) u) -
          (∫ u in Icc (0 : ℝ) 1, prawitzCotBaseIntegrand w u) =
        ∫ u in Icc (0 : ℝ) 1,
          (prawitzCotBaseIntegrand (w + x) u -
            prawitzCotBaseIntegrand w u) := by
    rw [MeasureTheory.integral_sub
      (integrableOn_prawitzCotBaseIntegrand (w + x))
      (integrableOn_prawitzCotBaseIntegrand w)]
  have hcongr :
      (∫ u in Icc (0 : ℝ) 1,
        (prawitzCotBaseIntegrand (w + x) u -
          prawitzCotBaseIntegrand w u)) =
        ∫ u in Icc (0 : ℝ) 1,
          Real.cos (2 * Real.pi * u * (w + x / 2)) *
            prawitzCotBaseShiftWeight x u := by
    apply MeasureTheory.integral_congr_ae
    filter_upwards with u
    exact prawitzCotBaseIntegrand_add_sub w x u
  simp_rw [integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)] at hsub hcongr
  rw [hsub, hcongr]

theorem tendsto_integral_prawitzCotBaseIntegrand_add_sub_atTop (x : ℝ) :
    Tendsto (fun w : ℝ =>
      (∫ u : ℝ in 0..1, prawitzCotBaseIntegrand (w + x) u) -
        ∫ u : ℝ in 0..1, prawitzCotBaseIntegrand w u)
      atTop (𝓝 0) := by
  let f : ℝ → ℝ := (Icc (0 : ℝ) 1).indicator (prawitzCotBaseShiftWeight x)
  have hf : Integrable f :=
    (integrableOn_prawitzCotBaseShiftWeight x).integrable_indicator measurableSet_Icc
  have hrl := (tendsto_integral_cos_mul_atTop_of_integrable f hf).comp
    (tendsto_atTop_add_const_right atTop (x / 2) tendsto_id)
  apply hrl.congr'
  filter_upwards with w
  rw [integral_prawitzCotBaseIntegrand_add_sub]
  have hset :
      (∫ u in Icc (0 : ℝ) 1,
        Real.cos (2 * Real.pi * u * (w + x / 2)) *
          prawitzCotBaseShiftWeight x u) =
        ∫ u : ℝ, Real.cos (2 * Real.pi * u * (w + x / 2)) * f u := by
    dsimp only [f]
    rw [show (fun u : ℝ => Real.cos (2 * Real.pi * u * (w + x / 2)) *
        (Icc (0 : ℝ) 1).indicator (prawitzCotBaseShiftWeight x) u) =
      (Icc (0 : ℝ) 1).indicator (fun u =>
        Real.cos (2 * Real.pi * u * (w + x / 2)) *
          prawitzCotBaseShiftWeight x u) by
          funext u
          by_cases hu : u ∈ Icc (0 : ℝ) 1 <;> simp [hu]]
    rw [integral_indicator measurableSet_Icc]
  simpa only [integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)] using hset.symm

/-- The removable base integral converges to one half along the positive
integer lattice, anchored by the exact lattice cotangent identity. -/
theorem tendsto_integral_prawitzCotBaseIntegrand_nat_succ :
    Tendsto (fun n : ℕ =>
      ∫ u : ℝ in 0..1,
        prawitzCotBaseIntegrand ((n + 1 : ℕ) : ℝ) u)
      atTop (𝓝 (1 / 2)) := by
  have hcast : Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.comp (tendsto_add_atTop_nat 1)
  have hrem := tendsto_prawitzCotangentIntegral_sub_base_atTop.comp hcast
  have hconst : Tendsto (fun _n : ℕ => (1 / 2 : ℝ)) atTop (𝓝 (1 / 2)) :=
    tendsto_const_nhds
  have h := hconst.sub hrem
  convert h using 1
  · funext n
    simp only [Function.comp_apply]
    rw [integral_prawitzCotangentSineIntegrand_nat_succ]
    linarith
  · ring_nf

theorem tendsto_integral_prawitzCotBaseIntegrand_nat_succ_add (x : ℝ) :
    Tendsto (fun n : ℕ =>
      ∫ u : ℝ in 0..1,
        prawitzCotBaseIntegrand (((n + 1 : ℕ) : ℝ) + x) u)
      atTop (𝓝 (1 / 2)) := by
  have hcast : Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.comp (tendsto_add_atTop_nat 1)
  have hdiff :=
    (tendsto_integral_prawitzCotBaseIntegrand_add_sub_atTop x).comp hcast
  have h := hdiff.add tendsto_integral_prawitzCotBaseIntegrand_nat_succ
  convert h using 1
  · funext n
    simp only [Function.comp_apply]
    ring_nf
  · ring_nf

/-- Every fixed translate of the cotangent--sine integral tends to one half
along the positive integer lattice. -/
theorem tendsto_integral_prawitzCotangentSineIntegrand_nat_succ_add (x : ℝ) :
    Tendsto (fun n : ℕ =>
      ∫ u : ℝ in 0..1,
        prawitzCotangentSineIntegrand (((n + 1 : ℕ) : ℝ) + x) u)
      atTop (𝓝 (1 / 2)) := by
  have hcast : Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.comp (tendsto_add_atTop_nat 1)
  have hshift :
      Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ℝ) + x) atTop atTop :=
    tendsto_atTop_add_const_right atTop x hcast
  have hrem := tendsto_prawitzCotangentIntegral_sub_base_atTop.comp hshift
  have h := hrem.add (tendsto_integral_prawitzCotBaseIntegrand_nat_succ_add x)
  convert h using 1
  · funext n
    simp only [Function.comp_apply]
    ring_nf
  · ring_nf

theorem prawitzInverseSquareTail_nonneg (x : ℝ) :
    0 ≤ prawitzInverseSquareTail x := by
  unfold prawitzInverseSquareTail
  exact tsum_nonneg fun _n => by positivity

/-- Removing the first inverse-square summand shifts the spatial tail by one. -/
theorem prawitzInverseSquareTail_eq_inv_add (x : ℝ) :
    prawitzInverseSquareTail x =
      1 / (x + 1) ^ 2 + prawitzInverseSquareTail (x + 1) := by
  let f : ℕ → ℝ := fun n => 1 / (x + (n : ℝ) + 1) ^ 2
  have hs : Summable f := summable_prawitzInverseSquareTail x
  unfold prawitzInverseSquareTail
  change (∑' n, f n) = _
  rw [hs.tsum_eq_zero_add]
  congr 1
  · simp [f]
  · apply tsum_congr
    intro n
    dsimp only [f]
    congr 2
    push_cast
    ring

/-- The apparent singularity of the inverse-square tail at zero is absent:
shifting its first summand expresses a neighborhood of zero through the
smooth positive-half-line series at one. -/
theorem continuousAt_prawitzInverseSquareTail_zero :
    ContinuousAt prawitzInverseSquareTail 0 := by
  have htailOne : ContinuousAt prawitzInverseSquareTail 1 :=
    (hasDerivAt_prawitzInverseSquareTail (by norm_num)).continuousAt
  have hshift : ContinuousAt
      (fun x : ℝ => prawitzInverseSquareTail (x + 1)) 0 := by
    have hadd : ContinuousAt (fun x : ℝ => x + 1) 0 :=
      continuousAt_id.add continuousAt_const
    have htailOne' :
        ContinuousAt prawitzInverseSquareTail ((0 : ℝ) + 1) := by
      simpa using htailOne
    exact ContinuousAt.comp' (f := fun x : ℝ => x + 1) htailOne' hadd
  have hinv : ContinuousAt (fun x : ℝ => 1 / (x + 1) ^ 2) 0 := by
    exact continuousAt_const.div
      ((continuousAt_id.add continuousAt_const).pow 2) (by norm_num)
  rw [show prawitzInverseSquareTail = fun x : ℝ =>
      1 / (x + 1) ^ 2 + prawitzInverseSquareTail (x + 1) by
    funext x
    exact prawitzInverseSquareTail_eq_inv_add x]
  exact hinv.add hshift

/-- Closed form predicted for the positive cotangent--sine integral. -/
noncomputable def prawitzCotangentIntegralTarget (x : ℝ) : ℝ :=
  1 / 2 - (Real.sin (Real.pi * x) / Real.pi) ^ 2 *
    (prawitzInverseSquareTail x + 1 / (2 * x ^ 2))

theorem prawitzCotangentIntegralTarget_add_one_sub
    {x : ℝ} (hx : x ≠ 0) (hx1 : x + 1 ≠ 0) :
    prawitzCotangentIntegralTarget (x + 1) -
        prawitzCotangentIntegralTarget x =
      (1 - Real.cos (2 * Real.pi * x)) / (2 * Real.pi * x) ^ 2 +
        (1 - Real.cos (2 * Real.pi * (x + 1))) /
          (2 * Real.pi * (x + 1)) ^ 2 := by
  have hsin : Real.sin (Real.pi * (x + 1)) =
      -Real.sin (Real.pi * x) := by
    rw [show Real.pi * (x + 1) = Real.pi * x + Real.pi by ring,
      Real.sin_add, Real.sin_pi, Real.cos_pi]
    ring
  have hcos0 : 1 - Real.cos (2 * Real.pi * x) =
      2 * Real.sin (Real.pi * x) ^ 2 := by
    rw [show 2 * Real.pi * x = 2 * (Real.pi * x) by ring,
      Real.cos_two_mul, Real.sin_sq]
    ring
  have hcos1 : 1 - Real.cos (2 * Real.pi * (x + 1)) =
      2 * Real.sin (Real.pi * (x + 1)) ^ 2 := by
    rw [show 2 * Real.pi * (x + 1) =
        2 * (Real.pi * (x + 1)) by ring,
      Real.cos_two_mul, Real.sin_sq]
    ring
  unfold prawitzCotangentIntegralTarget
  rw [prawitzInverseSquareTail_eq_inv_add x, hcos0, hcos1, hsin]
  field_simp [Real.pi_ne_zero, hx, hx1]
  ring

/-- The cotangent sine integral on `[0, 1]` minus `prawitzCotangentIntegralTarget`. -/
noncomputable def prawitzCotangentIntegralError (x : ℝ) : ℝ :=
  (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand x u) -
    prawitzCotangentIntegralTarget x

theorem prawitzCotangentIntegralError_add_one
    {x : ℝ} (hx : x ≠ 0) (hx1 : x + 1 ≠ 0) :
    prawitzCotangentIntegralError (x + 1) =
      prawitzCotangentIntegralError x := by
  have hJ := integral_prawitzCotangentSineIntegrand_add_one_sub_closed hx hx1
  have hT := prawitzCotangentIntegralTarget_add_one_sub hx hx1
  unfold prawitzCotangentIntegralError
  linarith

theorem prawitzCotangentIntegralTarget_tendsto_nat_succ_add
    {x : ℝ} (hx : 0 < x) :
    Tendsto (fun n : ℕ =>
      prawitzCotangentIntegralTarget (((n + 1 : ℕ) : ℝ) + x))
      atTop (𝓝 (1 / 2)) := by
  let y : ℕ → ℝ := fun n => ((n + 1 : ℕ) : ℝ) + x
  have hcast : Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.comp (tendsto_add_atTop_nat 1)
  have hy : Tendsto y atTop atTop :=
    tendsto_atTop_add_const_right atTop x hcast
  have hbound : Tendsto (fun n => 2 / y n) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hy
  let a : ℕ → ℝ := fun n =>
    prawitzInverseSquareTail (y n) + 1 / (2 * (y n) ^ 2)
  have ha_nonneg (n : ℕ) : 0 ≤ a n := by
    dsimp only [a]
    exact add_nonneg (prawitzInverseSquareTail_nonneg _) (by positivity)
  have ha_le (n : ℕ) : a n ≤ 2 / y n := by
    have hyn : 0 < y n := by
      dsimp only [y]
      positivity
    have hy1 : 1 ≤ y n := by
      dsimp only [y]
      have hn : (1 : ℝ) ≤ ((n + 1 : ℕ) : ℝ) := by
        exact_mod_cast Nat.succ_le_succ (Nat.zero_le n)
      linarith
    have hhalf : 1 / (2 * (y n) ^ 2) ≤ 1 / y n := by
      apply (div_le_div_iff₀ (by positivity : 0 < 2 * (y n) ^ 2) hyn).2
      nlinarith [sq_nonneg (y n - 1)]
    dsimp only [a]
    calc
      _ ≤ 1 / y n + 1 / y n :=
        add_le_add (prawitzInverseSquareTail_le_inv hyn) hhalf
      _ = 2 / y n := by ring
  have ha : Tendsto a atTop (𝓝 0) :=
    squeeze_zero ha_nonneg ha_le hbound
  let q : ℕ → ℝ := fun n =>
    (Real.sin (Real.pi * y n) / Real.pi) ^ 2
  have hq_nonneg (n : ℕ) : 0 ≤ q n := by
    dsimp only [q]
    positivity
  have hq_le (n : ℕ) : q n ≤ 1 := by
    have hratio : |Real.sin (Real.pi * y n) / Real.pi| ≤ 1 := by
      rw [abs_div, abs_of_pos Real.pi_pos]
      exact (div_le_one Real.pi_pos).2
        ((Real.abs_sin_le_one _).trans (by linarith [Real.two_le_pi]))
    dsimp only [q]
    rw [← sq_abs]
    nlinarith [abs_nonneg (Real.sin (Real.pi * y n) / Real.pi)]
  have hqa : Tendsto (fun n => q n * a n) atTop (𝓝 0) :=
    squeeze_zero
      (fun n => mul_nonneg (hq_nonneg n) (ha_nonneg n))
      (fun n => mul_le_of_le_one_left (ha_nonneg n) (hq_le n)) ha
  have h := (tendsto_const_nhds :
    Tendsto (fun _n : ℕ => (1 / 2 : ℝ)) atTop (𝓝 (1 / 2))).sub hqa
  simpa only [prawitzCotangentIntegralTarget, q, a, y, sub_zero] using h

theorem prawitzCotangentIntegralError_nat_add
    {x : ℝ} (hx : 0 < x) (n : ℕ) :
    prawitzCotangentIntegralError (x + n) =
      prawitzCotangentIntegralError x := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [show x + ((Nat.succ n : ℕ) : ℝ) =
        (x + (n : ℝ)) + 1 by push_cast; ring]
      rw [prawitzCotangentIntegralError_add_one (by positivity) (by positivity), ih]

theorem prawitzCotangentIntegralError_eq_zero
    {x : ℝ} (hx : 0 < x) : prawitzCotangentIntegralError x = 0 := by
  have hJ := tendsto_integral_prawitzCotangentSineIntegrand_nat_succ_add x
  have hT := prawitzCotangentIntegralTarget_tendsto_nat_succ_add hx
  have hzero : Tendsto (fun n : ℕ =>
      prawitzCotangentIntegralError (((n + 1 : ℕ) : ℝ) + x))
      atTop (𝓝 0) := by
    have h := hJ.sub hT
    simpa only [prawitzCotangentIntegralError, sub_self] using h
  have heq (n : ℕ) :
      prawitzCotangentIntegralError (((n + 1 : ℕ) : ℝ) + x) =
        prawitzCotangentIntegralError x := by
    rw [add_comm]
    exact prawitzCotangentIntegralError_nat_add hx (n + 1)
  have hconst : Tendsto (fun n : ℕ =>
      prawitzCotangentIntegralError (((n + 1 : ℕ) : ℝ) + x))
      atTop (𝓝 (prawitzCotangentIntegralError x)) := by
    convert (tendsto_const_nhds : Tendsto
      (fun _n : ℕ => prawitzCotangentIntegralError x) atTop
        (𝓝 (prawitzCotangentIntegralError x))) using 1
    funext n
    exact heq n
  exact tendsto_nhds_unique hconst hzero

/-- Exact evaluation of the remaining cotangent--sine integral on the
positive half-line. -/
theorem integral_prawitzCotangentSineIntegrand_eq_target
    {x : ℝ} (hx : 0 < x) :
    (∫ u : ℝ in 0..1, prawitzCotangentSineIntegrand x u) =
      prawitzCotangentIntegralTarget x := by
  have h := prawitzCotangentIntegralError_eq_zero hx
  unfold prawitzCotangentIntegralError at h
  linarith

/-- Exact positive-half-line Fourier identification for the Prawitz point
kernel and the nonnegative Vaaler remainder. -/
theorem prawitzPointKernel_positive_identity {x : ℝ} (hx : 0 < x) :
    2 * prawitzPointKernel 1 (-2 * Real.pi * x) - 1 =
      prawitzVaalerPositiveRemainder x := by
  apply (prawitzPointKernel_positive_identity_iff_cotangentIntegral hx).2
  rw [integral_prawitzCotangentSineIntegrand_eq_target hx]
  rfl

/-- The reflected Prawitz point kernels add to the nonnegative Fejér
kernel, with the removable value `1` at the origin. -/
theorem prawitzPointKernel_add_neg (z : ℝ) :
    prawitzPointKernel 1 z + prawitzPointKernel 1 (-z) =
      if z = 0 then 1 else 2 * (1 - Real.cos z) / z ^ 2 := by
  by_cases hz : z = 0
  · subst z
    rw [if_pos rfl, neg_zero, prawitzPointKernel_zero]
    field_simp
    norm_num
  · rw [if_neg hz, prawitzPointKernel_eq_integral_unitPointIntegrand,
      prawitzPointKernel_eq_integral_unitPointIntegrand]
    rw [← MeasureTheory.integral_add
      (integrableOn_prawitzUnitPointIntegrand z)
      (integrableOn_prawitzUnitPointIntegrand (-z))]
    have hcongr :
        (∫ u in Icc (0 : ℝ) 1,
          (prawitzUnitPointIntegrand z u +
            prawitzUnitPointIntegrand (-z) u)) =
          ∫ u in Icc (0 : ℝ) 1,
            2 * (1 - u) * Real.cos (z * u) := by
      apply integral_congr_ae
      filter_upwards [ae_restrict_mem measurableSet_Icc,
          (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 0,
          (volume.restrict (Icc (0 : ℝ) 1)).ae_ne 1] with u hu hu0 hu1
      exact prawitzUnitPointIntegrand_add_neg z
        (lt_of_le_of_ne hu.1 (Ne.symm hu0))
        (lt_of_le_of_ne hu.2 hu1)
    rw [hcongr, integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1),
      integral_two_mul_one_sub_mul_cos hz]

theorem prawitzPointKernel_add_neg_nonneg (z : ℝ) :
    0 ≤ prawitzPointKernel 1 z + prawitzPointKernel 1 (-z) := by
  rw [prawitzPointKernel_add_neg]
  split_ifs with hz
  · norm_num
  · exact div_nonneg (mul_nonneg (by norm_num)
      (sub_nonneg.mpr (Real.cos_le_one z))) (sq_nonneg z)

/-- The sum of the positive and reflected Prawitz--Vaaler remainders is
exactly twice the reflected Prawitz point-kernel sum. -/
theorem prawitzVaalerPositiveRemainder_add_negative_eq_pointKernel
    {x : ℝ} (hx : 0 < x) :
    prawitzVaalerPositiveRemainder x +
        prawitzVaalerNegativeRemainder x =
      2 * (prawitzPointKernel 1 (-2 * Real.pi * x) +
        prawitzPointKernel 1 (2 * Real.pi * x)) := by
  have hkernel := prawitzPointKernel_add_neg (-2 * Real.pi * x)
  rw [if_neg (by positivity : -2 * Real.pi * x ≠ 0)] at hkernel
  rw [show -(-2 * Real.pi * x) = 2 * Real.pi * x by ring] at hkernel
  rw [hkernel]
  rw [show Real.cos (-2 * Real.pi * x) = Real.cos (2 * (Real.pi * x)) by
    rw [show -2 * Real.pi * x = -(2 * (Real.pi * x)) by ring,
      Real.cos_neg]]
  rw [Real.cos_two_mul]
  rw [prawitzVaalerPositiveRemainder, prawitzVaalerNegativeRemainder]
  field_simp [Real.pi_ne_zero, hx.ne']
  rw [Real.sin_sq]
  ring

/-- The positive-half-line Fourier identification implies its reflected
negative-half-line companion through the exact Fejér reflection identity. -/
theorem prawitzVaalerNegativeRemainder_eq_pointKernel_of_positive
    {x : ℝ} (hx : 0 < x)
    (hpos : 2 * prawitzPointKernel 1 (-2 * Real.pi * x) - 1 =
      prawitzVaalerPositiveRemainder x) :
    2 * prawitzPointKernel 1 (2 * Real.pi * x) + 1 =
      prawitzVaalerNegativeRemainder x := by
  linarith [prawitzVaalerPositiveRemainder_add_negative_eq_pointKernel hx]

/-- Once the positive-half-line Fourier identity is supplied, the entire
piecewise spatial majorant is exactly the scaled Prawitz point kernel. -/
theorem prawitzVaalerMajorant_eq_pointKernel_of_positive
    (hpos : ∀ x : ℝ, 0 < x →
      2 * prawitzPointKernel 1 (-2 * Real.pi * x) - 1 =
        prawitzVaalerPositiveRemainder x) (x : ℝ) :
    prawitzVaalerMajorant x =
      2 * prawitzPointKernel 1 (-2 * Real.pi * x) := by
  by_cases hxpos : 0 < x
  · rw [prawitzVaalerMajorant, if_pos hxpos]
    linarith [hpos x hxpos]
  · by_cases hxneg : x < 0
    · rw [prawitzVaalerMajorant, if_neg hxpos, if_pos hxneg]
      have hy : 0 < -x := neg_pos.mpr hxneg
      have hneg := prawitzVaalerNegativeRemainder_eq_pointKernel_of_positive
        hy (hpos (-x) hy)
      rw [show -2 * Real.pi * x = 2 * Real.pi * (-x) by ring]
      linarith
    · have hx : x = 0 := by linarith
      subst x
      rw [prawitzVaalerMajorant]
      simp [prawitzPointKernel_zero]

/-- The explicit Vaaler majorant is exactly the spatial Prawitz point kernel
on the whole real line. -/
theorem prawitzVaalerMajorant_eq_pointKernel (x : ℝ) :
    prawitzVaalerMajorant x =
      2 * prawitzPointKernel 1 (-2 * Real.pi * x) :=
  prawitzVaalerMajorant_eq_pointKernel_of_positive
    (fun _x hx => prawitzPointKernel_positive_identity hx) x

/-- The unit-window Prawitz point kernel takes the exact upper-step value at
the first negative Fourier lattice point. -/
theorem prawitzPointKernel_neg_two_pi :
    prawitzPointKernel 1 (-2 * Real.pi) = 1 / 2 := by
  have h := prawitzPointKernel_positive_identity
    (x := (1 : ℝ)) (by norm_num)
  simp [prawitzVaalerPositiveRemainder] at h
  rw [show -2 * Real.pi = -(2 * Real.pi) by ring]
  linarith

/-- The reflected unit-window point kernel takes the exact lower-step value
at the first positive Fourier lattice point. -/
theorem prawitzPointKernel_two_pi :
    prawitzPointKernel 1 (2 * Real.pi) = -(1 / 2) := by
  have hpos := prawitzPointKernel_positive_identity
    (x := (1 : ℝ)) (by norm_num)
  have hneg := prawitzVaalerNegativeRemainder_eq_pointKernel_of_positive
    (x := (1 : ℝ)) (by norm_num) hpos
  simp [prawitzVaalerNegativeRemainder] at hneg
  linarith

/-- Positive scaling converts the centered CDF kernel exactly to the spatial
argument used by the Prawitz--Vaaler majorant. -/
theorem centeredHalfLineStep_scaled_eq_cdfKernel
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    centeredHalfLineStep (-T * (y - x) / (2 * Real.pi)) =
      2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1 := by
  by_cases hy : y ≤ x
  · have harg : ¬ -T * (y - x) / (2 * Real.pi) < 0 := by
      have hnum : 0 ≤ -T * (y - x) :=
        mul_nonneg_of_nonpos_of_nonpos (by linarith) (sub_nonpos.mpr hy)
      exact not_lt.mpr (div_nonneg hnum (by positivity))
    rw [centeredHalfLineStep, if_neg harg]
    simp [hy]
    norm_num
  · have hy' : x < y := lt_of_not_ge hy
    have harg : -T * (y - x) / (2 * Real.pi) < 0 := by
      exact div_neg_of_neg_of_pos
        (mul_neg_of_neg_of_pos (by linarith) (sub_pos.mpr hy')) (by positivity)
    rw [centeredHalfLineStep, if_pos harg]
    simp [hy]

/-- The exact Prawitz point kernel majorizes the centered lower-ray
indicator at every positive frequency scale. -/
theorem centeredCDFKernel_le_two_mul_prawitzPointKernel
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1 ≤
      2 * prawitzPointKernel T (y - x) := by
  rw [← centeredHalfLineStep_scaled_eq_cdfKernel hT x y]
  calc
    centeredHalfLineStep (-T * (y - x) / (2 * Real.pi)) ≤
        prawitzVaalerMajorant (-T * (y - x) / (2 * Real.pi)) :=
      centeredHalfLineStep_le_prawitzVaalerMajorant _
    _ = 2 * prawitzPointKernel 1
          (-2 * Real.pi * (-T * (y - x) / (2 * Real.pi))) :=
      prawitzVaalerMajorant_eq_pointKernel _
    _ = 2 * prawitzPointKernel T (y - x) := by
      rw [prawitzPointKernel_scale hT]
      congr 2
      field_simp [Real.pi_ne_zero]

/-- The upper Prawitz point-kernel majorization is sharp on the atom-sensitive
diagonal selected by the right-continuous CDF convention. -/
theorem centeredCDFKernel_eq_two_mul_prawitzPointKernel_diagonal
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) x - 1 =
      2 * prawitzPointKernel T (x - x) := by
  rw [prawitzPointKernel_scale hT]
  simp only [mem_Iic, le_refl, Set.indicator_of_mem, mul_one, sub_self,
    mul_zero, prawitzPointKernel_zero]
  norm_num

/-- No positive uniform constant can be subtracted from the upper Prawitz
point-kernel majorant while retaining all spatial points. -/
theorem not_centeredCDFKernel_le_prawitzPointKernel_sub_pos
    {T : ℝ} (hT : 0 < T) (x : ℝ) {delta : ℝ} (hdelta : 0 < delta) :
    ¬ ∀ y : ℝ,
      2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1 ≤
        2 * prawitzPointKernel T (y - x) - delta := by
  intro h
  have hdiag := h x
  rw [centeredCDFKernel_eq_two_mul_prawitzPointKernel_diagonal
    hT x] at hdiag
  linarith

/-- Reflecting the same majorant gives the corresponding lower envelope,
with the right-continuous endpoint convention valid even at an atom. -/
theorem neg_two_mul_prawitzPointKernel_le_centeredCDFKernel
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    -2 * prawitzPointKernel T (x - y) ≤
      2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1 := by
  have hscale :
      prawitzVaalerMajorant (T * (y - x) / (2 * Real.pi)) =
        2 * prawitzPointKernel T (x - y) := by
    rw [prawitzVaalerMajorant_eq_pointKernel, prawitzPointKernel_scale hT]
    congr 2
    field_simp [Real.pi_ne_zero]
    ring
  rw [show -2 * prawitzPointKernel T (x - y) =
      -(2 * prawitzPointKernel T (x - y)) by ring, ← hscale]
  calc
    -prawitzVaalerMajorant (T * (y - x) / (2 * Real.pi)) ≤
        -centeredHalfLineStep (T * (y - x) / (2 * Real.pi)) :=
      neg_le_neg (centeredHalfLineStep_le_prawitzVaalerMajorant _)
    _ ≤ 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1 := by
      by_cases hylt : y < x
      · have harg : T * (y - x) / (2 * Real.pi) < 0 := by
          exact div_neg_of_neg_of_pos
            (mul_neg_of_pos_of_neg hT (sub_neg.mpr hylt)) (by positivity)
        simp [centeredHalfLineStep, hylt.le, harg]
        norm_num
      · by_cases hy : y = x
        · subst y
          simp [centeredHalfLineStep]
        · have hygt : x < y := lt_of_le_of_ne (le_of_not_gt hylt) (Ne.symm hy)
          have harg : 0 < T * (y - x) / (2 * Real.pi) :=
            div_pos (mul_pos hT (sub_pos.mpr hygt)) (by positivity)
          simp [centeredHalfLineStep,
            not_le.mpr hygt, not_lt.mpr harg.le]

/-- Integrating the centered lower-ray indicator recovers twice the CDF
minus one. -/
theorem integral_centeredCDFKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu] (x : ℝ) :
    (∫ y, 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1 ∂mu) =
      2 * cdf mu x - 1 := by
  have hInd : Integrable
      ((Iic x).indicator (fun _ : ℝ => (1 : ℝ))) mu :=
    (integrable_const (1 : ℝ)).indicator measurableSet_Iic
  have hIntInd :
      (∫ y, (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y ∂mu) =
        mu.real (Iic x) := integral_indicator_one measurableSet_Iic
  rw [integral_sub (hInd.const_mul 2) (integrable_const 1),
    integral_const_mul, hIntInd, integral_const, probReal_univ, one_smul,
    cdf_eq_real]

/-- The Prawitz point-kernel expectation is an upper envelope for the
centered CDF whenever that expectation is integrable. -/
theorem cdf_sub_half_le_integral_prawitzPointKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ)
    (hInt : Integrable (fun y => prawitzPointKernel T (y - x)) mu) :
    cdf mu x - 1 / 2 ≤ ∫ y, prawitzPointKernel T (y - x) ∂mu := by
  have hInd : Integrable
      (fun y => 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1) mu :=
    ((integrable_const (1 : ℝ)).indicator measurableSet_Iic).const_mul 2 |>.sub
      (integrable_const 1)
  have hle :
      (∫ y, 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1 ∂mu) ≤
        ∫ y, 2 * prawitzPointKernel T (y - x) ∂mu := by
    apply integral_mono hInd (hInt.const_mul 2)
    exact centeredCDFKernel_le_two_mul_prawitzPointKernel hT x
  rw [integral_centeredCDFKernel, integral_const_mul] at hle
  linarith

/-- Pointwise surplus in the upper Prawitz majorant.  Its expectation records
exactly how much the integrated envelope exceeds the centered CDF. -/
noncomputable def prawitzUpperSlack (T x y : ℝ) : ℝ :=
  2 * prawitzPointKernel T (y - x) -
    (2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1)

theorem prawitzUpperSlack_nonneg
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    0 ≤ prawitzUpperSlack T x y := by
  exact sub_nonneg.mpr
    (centeredCDFKernel_le_two_mul_prawitzPointKernel hT x y)

theorem integrable_prawitzUpperSlack
    (mu : Measure ℝ) [IsFiniteMeasure mu] {T : ℝ} (x : ℝ)
    (hInt : Integrable (fun y => prawitzPointKernel T (y - x)) mu) :
    Integrable (prawitzUpperSlack T x) mu := by
  have hInd : Integrable
      (fun y => 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1) mu :=
    ((integrable_const (1 : ℝ)).indicator measurableSet_Iic).const_mul 2 |>.sub
      (integrable_const 1)
  exact (hInt.const_mul 2).sub hInd

/-- Half the expected upper slack is the exact gap between the Prawitz
expectation and the centered CDF. -/
theorem half_integral_prawitzUpperSlack_eq_envelope_gap
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (x : ℝ)
    (hInt : Integrable (fun y => prawitzPointKernel T (y - x)) mu) :
    (1 / 2 : ℝ) * ∫ y, prawitzUpperSlack T x y ∂mu =
      (∫ y, prawitzPointKernel T (y - x) ∂mu) - (cdf mu x - 1 / 2) := by
  have hInd : Integrable
      (fun y => 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1) mu :=
    ((integrable_const (1 : ℝ)).indicator measurableSet_Iic).const_mul 2 |>.sub
      (integrable_const 1)
  unfold prawitzUpperSlack
  rw [integral_sub (hInt.const_mul 2) hInd,
    integral_const_mul, integral_centeredCDFKernel]
  ring

/-- Pointwise surplus in the reflected lower Prawitz majorant. -/
noncomputable def prawitzLowerSlack (T x y : ℝ) : ℝ :=
  (2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1) +
    2 * prawitzPointKernel T (x - y)

theorem prawitzLowerSlack_nonneg
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    0 ≤ prawitzLowerSlack T x y := by
  have h := neg_two_mul_prawitzPointKernel_le_centeredCDFKernel hT x y
  unfold prawitzLowerSlack
  linarith

theorem integrable_prawitzLowerSlack
    (mu : Measure ℝ) [IsFiniteMeasure mu] {T : ℝ} (x : ℝ)
    (hInt : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    Integrable (prawitzLowerSlack T x) mu := by
  have hInd : Integrable
      (fun y => 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1) mu :=
    ((integrable_const (1 : ℝ)).indicator measurableSet_Iic).const_mul 2 |>.sub
      (integrable_const 1)
  exact hInd.add (hInt.const_mul 2)

/-- Half the expected lower slack is the exact gap from the reflected Prawitz
envelope to the centered CDF. -/
theorem half_integral_prawitzLowerSlack_eq_envelope_gap
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (x : ℝ)
    (hInt : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    (1 / 2 : ℝ) * ∫ y, prawitzLowerSlack T x y ∂mu =
      (cdf mu x - 1 / 2) -
        (-(∫ y, prawitzPointKernel T (x - y) ∂mu)) := by
  have hInd : Integrable
      (fun y => 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1) mu :=
    ((integrable_const (1 : ℝ)).indicator measurableSet_Iic).const_mul 2 |>.sub
      (integrable_const 1)
  unfold prawitzLowerSlack
  rw [integral_add hInd (hInt.const_mul 2), integral_const_mul,
    integral_centeredCDFKernel]
  ring

/-- Exact two-law forward recentering: the CDF difference is the point-kernel
expectation difference corrected by half the upper-slack difference. -/
theorem cdf_sub_cdf_eq_prawitzUpperRecentered
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {T : ℝ} (x : ℝ)
    (hmu : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hnu : Integrable (fun y => prawitzPointKernel T (y - x)) nu) :
    cdf mu x - cdf nu x =
      ((∫ y, prawitzPointKernel T (y - x) ∂mu) -
          ∫ y, prawitzPointKernel T (y - x) ∂nu) -
        (1 / 2 : ℝ) *
          ((∫ y, prawitzUpperSlack T x y ∂mu) -
            ∫ y, prawitzUpperSlack T x y ∂nu) := by
  have hmuGap := half_integral_prawitzUpperSlack_eq_envelope_gap mu x hmu
  have hnuGap := half_integral_prawitzUpperSlack_eq_envelope_gap nu x hnu
  linarith

/-- Exact two-law reflected recentering using the lower-slack correction. -/
theorem cdf_sub_cdf_eq_prawitzLowerRecentered
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {T : ℝ} (x : ℝ)
    (hmu : Integrable (fun y => prawitzPointKernel T (x - y)) mu)
    (hnu : Integrable (fun y => prawitzPointKernel T (x - y)) nu) :
    cdf mu x - cdf nu x =
      -((∫ y, prawitzPointKernel T (x - y) ∂mu) -
          ∫ y, prawitzPointKernel T (x - y) ∂nu) +
        (1 / 2 : ℝ) *
          ((∫ y, prawitzLowerSlack T x y ∂mu) -
            ∫ y, prawitzLowerSlack T x y ∂nu) := by
  have hmuGap := half_integral_prawitzLowerSlack_eq_envelope_gap mu x hmu
  have hnuGap := half_integral_prawitzLowerSlack_eq_envelope_gap nu x hnu
  linarith

/-- The one-sided Prawitz expectation bound is attained by a Dirac law at
its atom under the right-continuous CDF convention. -/
theorem cdf_dirac_sub_half_eq_integral_prawitzPointKernel
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf (Measure.dirac x) x - 1 / 2 =
      ∫ y, prawitzPointKernel T (y - x) ∂Measure.dirac x := by
  rw [integral_dirac, prawitzPointKernel_scale hT]
  simp only [sub_self, mul_zero, prawitzPointKernel_zero]
  rw [cdf_eq_real, Measure.real_def]
  simp
  norm_num

/-- No positive universal additive improvement of the integrated upper
Prawitz envelope can hold for arbitrary probability laws. -/
theorem not_cdf_dirac_sub_half_le_integral_prawitzPointKernel_sub_pos
    {T : ℝ} (hT : 0 < T) (x : ℝ) {delta : ℝ} (hdelta : 0 < delta) :
    ¬ cdf (Measure.dirac x) x - 1 / 2 ≤
      (∫ y, prawitzPointKernel T (y - x) ∂Measure.dirac x) - delta := by
  rw [cdf_dirac_sub_half_eq_integral_prawitzPointKernel hT x]
  linarith

/-- The reflected Prawitz point-kernel expectation is a lower envelope for
the centered CDF, again without an atomlessness assumption. -/
theorem neg_integral_prawitzPointKernel_le_cdf_sub_half
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ)
    (hInt : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    -(∫ y, prawitzPointKernel T (x - y) ∂mu) ≤ cdf mu x - 1 / 2 := by
  have hInd : Integrable
      (fun y => 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1) mu :=
    ((integrable_const (1 : ℝ)).indicator measurableSet_Iic).const_mul 2 |>.sub
      (integrable_const 1)
  have hle :
      (∫ y, -2 * prawitzPointKernel T (x - y) ∂mu) ≤
        ∫ y, 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1 ∂mu := by
    apply integral_mono (hInt.const_mul (-2)) hInd
    exact neg_two_mul_prawitzPointKernel_le_centeredCDFKernel hT x
  rw [integral_const_mul, integral_centeredCDFKernel] at hle
  linarith

/-- Joint point-mass paired integrand used to exchange spatial expectation
with the finite-frequency Prawitz integral. -/
noncomputable def prawitzDiracPairedIntegrand
    (T x : ℝ) (p : ℝ × ℝ) : ℂ :=
  symmetricPrawitzPVIntegrand T
    (MeasureTheory.charFun (Measure.dirac p.1)) x p.2

theorem measurable_prawitzDiracPairedIntegrand (T x : ℝ) :
    Measurable (prawitzDiracPairedIntegrand T x) := by
  have hphase : Measurable (fun p : ℝ × ℝ =>
      Complex.exp (((-(p.2 * x) : ℝ) : ℂ) * Complex.I)) := by fun_prop
  have hphaseNeg : Measurable (fun p : ℝ × ℝ =>
      Complex.exp (((-((-p.2) * x) : ℝ) : ℂ) * Complex.I)) := by fun_prop
  have hfilter : Measurable (fun p : ℝ × ℝ =>
      scaledPrawitzSmoothingFilter T p.2) :=
    (measurable_scaledPrawitzSmoothingFilter T).comp measurable_snd
  have hfilterNeg : Measurable (fun p : ℝ × ℝ =>
      scaledPrawitzSmoothingFilter T (-p.2)) :=
    (measurable_scaledPrawitzSmoothingFilter T).comp
      (measurable_neg.comp measurable_snd)
  have hchar : Measurable (fun p : ℝ × ℝ =>
      MeasureTheory.charFun (Measure.dirac p.1) p.2) := by
    simp_rw [MeasureTheory.charFun_dirac]
    fun_prop
  have hcharNeg : Measurable (fun p : ℝ × ℝ =>
      MeasureTheory.charFun (Measure.dirac p.1) (-p.2)) := by
    simp_rw [MeasureTheory.charFun_dirac]
    fun_prop
  unfold prawitzDiracPairedIntegrand symmetricPrawitzPVIntegrand
    prawitzPVIntegrand prawitzPVNumerator
  exact (((hphase.mul hfilter).mul hchar).div
      (Complex.continuous_ofReal.measurable.comp measurable_snd)).add
    (((hphaseNeg.mul hfilterNeg).mul hcharNeg).div
      (Complex.continuous_ofReal.measurable.comp
        (measurable_neg.comp measurable_snd)))

/-- The joint point-mass paired integrand has a first-moment majorant uniform
over the closed positive frequency window. -/
theorem norm_prawitzDiracPairedIntegrand_le
    {T : ℝ} (hT : 0 < T) (x y : ℝ) {t : ℝ} (ht : t ∈ Icc 0 T) :
    ‖prawitzDiracPairedIntegrand T x (y, t)‖ ≤
      2 * (7 * (|x| + |y|) + Real.pi / T) := by
  rcases ht.1.eq_or_lt with rfl | ht0
  · simp [prawitzDiracPairedIntegrand, symmetricPrawitzPVIntegrand,
      prawitzPVIntegrand]
    positivity
  have hDirac : Integrable (fun z : ℝ => |z|) (Measure.dirac y) := by
    exact integrable_dirac (by simp)
  have hIm := abs_im_prawitzPVNumerator_charFun_le
    hDirac hT x (show t ∈ Ioc 0 T from ⟨ht0, ht.2⟩)
  simp only [integral_dirac] at hIm
  rw [prawitzDiracPairedIntegrand,
    norm_symmetricPrawitzPVIntegrand
      (isHermitianFrequencyFunction_charFun (Measure.dirac y)) x ht0.ne',
    abs_of_pos ht0]
  calc
    2 * |(prawitzPVNumerator T
        (MeasureTheory.charFun (Measure.dirac y)) x t).im| / t ≤
        2 * ((7 * (|x| + |y|) + Real.pi / T) * t) / t :=
      div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_left hIm (by norm_num)) ht0.le
    _ = 2 * (7 * (|x| + |y|) + Real.pi / T) := by field_simp

/-- A finite first absolute moment makes the point-mass Prawitz integrand
integrable on the spatial-frequency product space, licensing Fubini. -/
theorem integrable_prod_prawitzDiracPairedIntegrand
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    Integrable (prawitzDiracPairedIntegrand T x)
      (mu.prod (volume.restrict (Icc 0 T))) := by
  have hmeas : AEStronglyMeasurable (prawitzDiracPairedIntegrand T x)
      (mu.prod (volume.restrict (Icc 0 T))) :=
    (measurable_prawitzDiracPairedIntegrand T x).aestronglyMeasurable
  rw [integrable_prod_iff hmeas]
  constructor
  · exact ae_of_all mu fun y => by
      have hDirac : Integrable (fun z : ℝ => |z|) (Measure.dirac y) :=
        integrable_dirac (by simp)
      simpa only [prawitzDiracPairedIntegrand] using
        integrableOn_symmetricPrawitzPVIntegrand_charFun
          (Measure.dirac y) hDirac hT x
  · let B : ℝ → ℝ := fun y =>
      T * (2 * (7 * (|x| + |y|) + Real.pi / T))
    have hB : Integrable B mu := by
      have hAbs : Integrable (fun y : ℝ => 14 * T * |y|) mu :=
        hmu1.const_mul (14 * T)
      have hConst : Integrable
          (fun _y : ℝ => 14 * T * |x| + 2 * Real.pi) mu :=
        integrable_const _
      apply (hAbs.add hConst).congr
      filter_upwards with y
      dsimp only [B]
      simp only [Pi.add_apply]
      field_simp [hT.ne']
      ring
    apply hB.mono' hmeas.norm.integral_prod_right'
    filter_upwards with y
    have hSection : Integrable
        (fun t => prawitzDiracPairedIntegrand T x (y, t))
        (volume.restrict (Icc 0 T)) := by
      have hDirac : Integrable (fun z : ℝ => |z|) (Measure.dirac y) :=
        integrable_dirac (by simp)
      simpa only [prawitzDiracPairedIntegrand] using
        integrableOn_symmetricPrawitzPVIntegrand_charFun
          (Measure.dirac y) hDirac hT x
    have hConst : Integrable
        (fun _t : ℝ => 2 * (7 * (|x| + |y|) + Real.pi / T))
        (volume.restrict (Icc 0 T)) := integrable_const _
    have hle :
        (∫ t, ‖prawitzDiracPairedIntegrand T x (y, t)‖
            ∂(volume.restrict (Icc 0 T))) ≤
          ∫ _t, 2 * (7 * (|x| + |y|) + Real.pi / T)
            ∂(volume.restrict (Icc 0 T)) := by
      apply integral_mono_ae hSection.norm hConst
      filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      exact norm_prawitzDiracPairedIntegrand_le hT x y ht
    rw [Real.norm_eq_abs, abs_of_nonneg (integral_nonneg fun _ => norm_nonneg _)]
    calc
      (∫ t, ‖prawitzDiracPairedIntegrand T x (y, t)‖
          ∂(volume.restrict (Icc 0 T))) ≤
          ∫ _t, 2 * (7 * (|x| + |y|) + Real.pi / T)
            ∂(volume.restrict (Icc 0 T)) := hle
      _ = B y := by simp [B, hT.le]

/-- The translated forward Prawitz point kernel is integrable under every
probability law with a finite first absolute moment. -/
theorem integrable_prawitzPointKernel_sub
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    Integrable (fun y => prawitzPointKernel T (y - x)) mu := by
  have hProd := integrable_prod_prawitzDiracPairedIntegrand mu hmu1 hT x
  have hInner : Integrable (fun y =>
      ∫ t, prawitzDiracPairedIntegrand T x (y, t)
        ∂(volume.restrict (Icc 0 T))) mu :=
    hProd.integral_prod_left
  have hScaled : Integrable (fun y =>
      ((Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t, prawitzDiracPairedIntegrand T x (y, t)
          ∂(volume.restrict (Icc 0 T))).re) mu :=
    (hInner.const_mul _).re
  apply hScaled.congr
  filter_upwards with y
  have hDirac := prawitzInversion_charFun_dirac_eq_pointKernel T x y
  apply_fun Complex.re at hDirac
  simpa only [prawitzInversion, prawitzDiracPairedIntegrand,
    Complex.ofReal_re] using hDirac

/-- The reflected translated Prawitz point kernel has the same first-moment
integrability property. -/
theorem integrable_prawitzPointKernel_reflected_sub
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    Integrable (fun y => prawitzPointKernel T (x - y)) mu := by
  let muNeg : Measure ℝ := Measure.map (fun y : ℝ => -y) mu
  letI : IsProbabilityMeasure muNeg :=
    Measure.isProbabilityMeasure_map measurable_neg.aemeasurable
  have hNeg1 : Integrable (fun y : ℝ => |y|) muNeg := by
    dsimp only [muNeg]
    rw [integrable_map_measure (by fun_prop) measurable_neg.aemeasurable]
    change Integrable (fun y : ℝ => |-y|) mu
    simpa only [abs_neg] using hmu1
  have hForward : Integrable
      (fun y => prawitzPointKernel T (y - (-x))) muNeg :=
    integrable_prawitzPointKernel_sub muNeg hNeg1 hT (-x)
  have hComp := (integrable_map_measure hForward.aestronglyMeasurable
    measurable_neg.aemeasurable).mp hForward
  apply hComp.congr
  filter_upwards with y
  dsimp only [Function.comp_apply]
  exact congrArg (prawitzPointKernel T) (by ring)

/-- For fixed frequency, the point-mass Prawitz integrand is integrable in
the spatial point under every finite measure. -/
theorem integrable_prawitzPVIntegrand_charFun_dirac
    (mu : Measure ℝ) [IsFiniteMeasure mu] (T x t : ℝ) :
    Integrable (fun y => prawitzPVIntegrand T
      (MeasureTheory.charFun (Measure.dirac y)) x t) mu := by
  let c : ℂ := Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
    scaledPrawitzSmoothingFilter T t / (t : ℂ)
  have hExp : Integrable (fun y : ℝ =>
      Complex.exp (((inner ℝ y t : ℝ) : ℂ) * Complex.I)) mu := by
    apply Integrable.of_bound (by fun_prop) 1
    exact ae_of_all mu fun y => by
      rw [Complex.norm_exp_ofReal_mul_I]
  have hEq : (fun y => prawitzPVIntegrand T
      (MeasureTheory.charFun (Measure.dirac y)) x t) =
      fun y => c * Complex.exp (((inner ℝ y t : ℝ) : ℂ) * Complex.I) := by
    funext y
    rw [prawitzPVIntegrand, prawitzPVNumerator,
      MeasureTheory.charFun_dirac]
    dsimp only [c]
    ring
  rw [hEq]
  exact hExp.const_mul c

/-- Averaging the fixed-frequency point-mass Prawitz integrand recovers the
Prawitz integrand of the averaged law. -/
theorem integral_prawitzPVIntegrand_charFun_dirac
    (mu : Measure ℝ) [IsFiniteMeasure mu] (T x t : ℝ) :
    (∫ y, prawitzPVIntegrand T
        (MeasureTheory.charFun (Measure.dirac y)) x t ∂mu) =
      prawitzPVIntegrand T (MeasureTheory.charFun mu) x t := by
  let c : ℂ := Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
    scaledPrawitzSmoothingFilter T t / (t : ℂ)
  have hEq : (fun y => prawitzPVIntegrand T
      (MeasureTheory.charFun (Measure.dirac y)) x t) =
      fun y => c * Complex.exp (((inner ℝ y t : ℝ) : ℂ) * Complex.I) := by
    funext y
    rw [prawitzPVIntegrand, prawitzPVNumerator,
      MeasureTheory.charFun_dirac]
    dsimp only [c]
    ring
  rw [hEq]
  calc
    (∫ y, c * Complex.exp (((inner ℝ y t : ℝ) : ℂ) * Complex.I) ∂mu) =
        c * ∫ y, Complex.exp (((inner ℝ y t : ℝ) : ℂ) * Complex.I) ∂mu :=
      integral_const_mul c _
    _ = prawitzPVIntegrand T (MeasureTheory.charFun mu) x t := by
      rw [prawitzPVIntegrand, prawitzPVNumerator,
        MeasureTheory.charFun_apply]
      dsimp only [c]
      ring

/-- The same averaging identity holds for the paired Prawitz integrand. -/
theorem integral_prawitzDiracPairedIntegrand
    (mu : Measure ℝ) [IsFiniteMeasure mu] (T x t : ℝ) :
    (∫ y, prawitzDiracPairedIntegrand T x (y, t) ∂mu) =
      symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t := by
  change (∫ y,
      (prawitzPVIntegrand T (MeasureTheory.charFun (Measure.dirac y)) x t +
        prawitzPVIntegrand T (MeasureTheory.charFun (Measure.dirac y)) x (-t)) ∂mu) =
    prawitzPVIntegrand T (MeasureTheory.charFun mu) x t +
      prawitzPVIntegrand T (MeasureTheory.charFun mu) x (-t)
  rw [integral_add
      (integrable_prawitzPVIntegrand_charFun_dirac mu T x t)
      (integrable_prawitzPVIntegrand_charFun_dirac mu T x (-t)),
    integral_prawitzPVIntegrand_charFun_dirac,
    integral_prawitzPVIntegrand_charFun_dirac]

/-- Fubini identifies the average point-mass Prawitz inversion with the
Prawitz inversion of the averaged probability law. -/
theorem integral_prawitzInversion_charFun_dirac
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, prawitzInversion T
        (MeasureTheory.charFun (Measure.dirac y)) x ∂mu) =
      prawitzInversion T (MeasureTheory.charFun mu) x := by
  have hProd := integrable_prod_prawitzDiracPairedIntegrand mu hmu1 hT x
  have hSwap :
      (∫ y, ∫ t, prawitzDiracPairedIntegrand T x (y, t)
          ∂(volume.restrict (Icc 0 T)) ∂mu) =
        ∫ t, ∫ y, prawitzDiracPairedIntegrand T x (y, t) ∂mu
          ∂(volume.restrict (Icc 0 T)) :=
    integral_integral_swap hProd
  unfold prawitzInversion
  change (∫ y, (Complex.I / (2 * Real.pi : ℝ)) *
      ∫ t, prawitzDiracPairedIntegrand T x (y, t)
        ∂(volume.restrict (Icc 0 T)) ∂mu) =
    (Complex.I / (2 * Real.pi : ℝ)) *
      ∫ t, symmetricPrawitzPVIntegrand T
        (MeasureTheory.charFun mu) x t ∂(volume.restrict (Icc 0 T))
  calc
    (∫ y, (Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t, prawitzDiracPairedIntegrand T x (y, t)
          ∂(volume.restrict (Icc 0 T)) ∂mu) =
        (Complex.I / (2 * Real.pi : ℝ)) *
          ∫ y, ∫ t, prawitzDiracPairedIntegrand T x (y, t)
            ∂(volume.restrict (Icc 0 T)) ∂mu :=
      integral_const_mul _ _
    _ = (Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t, ∫ y, prawitzDiracPairedIntegrand T x (y, t) ∂mu
          ∂(volume.restrict (Icc 0 T)) := by rw [hSwap]
    _ = (Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t, symmetricPrawitzPVIntegrand T
          (MeasureTheory.charFun mu) x t ∂(volume.restrict (Icc 0 T)) := by
      congr 1
      apply integral_congr_ae
      exact ae_of_all _ fun t => integral_prawitzDiracPairedIntegrand mu T x t

/-- The forward Prawitz point-kernel expectation is the real part of the
Prawitz inversion of the law. -/
theorem integral_prawitzPointKernel_sub_eq_re_prawitzInversion
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, prawitzPointKernel T (y - x) ∂mu) =
      (prawitzInversion T (MeasureTheory.charFun mu) x).re := by
  have hProd := integrable_prod_prawitzDiracPairedIntegrand mu hmu1 hT x
  have hInner : Integrable (fun y =>
      ∫ t, prawitzDiracPairedIntegrand T x (y, t)
        ∂(volume.restrict (Icc 0 T))) mu :=
    hProd.integral_prod_left
  have hInv : Integrable (fun y => prawitzInversion T
      (MeasureTheory.charFun (Measure.dirac y)) x) mu := by
    unfold prawitzInversion
    simpa only [prawitzDiracPairedIntegrand] using hInner.const_mul
      (Complex.I / (2 * Real.pi : ℝ))
  calc
    (∫ y, prawitzPointKernel T (y - x) ∂mu) =
        ∫ y, (prawitzInversion T
          (MeasureTheory.charFun (Measure.dirac y)) x).re ∂mu := by
      apply integral_congr_ae
      exact ae_of_all _ fun y => by
        have hDirac := prawitzInversion_charFun_dirac_eq_pointKernel T x y
        apply_fun Complex.re at hDirac
        simpa only [Complex.ofReal_re] using hDirac.symm
    _ = (∫ y, prawitzInversion T
        (MeasureTheory.charFun (Measure.dirac y)) x ∂mu).re :=
      integral_re hInv
    _ = (prawitzInversion T (MeasureTheory.charFun mu) x).re := by
      rw [integral_prawitzInversion_charFun_dirac mu hmu1 hT x]

/-- The exact signed Prawitz inversion is an upper envelope for the centered
CDF. -/
theorem cdf_sub_half_le_re_prawitzInversion
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf mu x - 1 / 2 ≤
      (prawitzInversion T (MeasureTheory.charFun mu) x).re := by
  have h := cdf_sub_half_le_integral_prawitzPointKernel
    mu hT x (integrable_prawitzPointKernel_sub mu hmu1 hT x)
  rwa [integral_prawitzPointKernel_sub_eq_re_prawitzInversion
    mu hmu1 hT x] at h

/-- Exact one-sided signed smoothing inequality, before taking the norm of the
Prawitz inversion difference.  This retains cancellation with the reflected
Fejer remainder. -/
theorem cdf_sub_cdf_le_re_prawitzInversion_sub_add_reflection
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf mu x - cdf nu x ≤
      (prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x).re +
      ∫ y, (prawitzPointKernel T (y - x) +
        prawitzPointKernel T (x - y)) ∂nu := by
  have hMu := cdf_sub_half_le_re_prawitzInversion mu hmu1 hT x
  have hNu := neg_integral_prawitzPointKernel_le_cdf_sub_half
    nu hT x (integrable_prawitzPointKernel_reflected_sub nu hnu1 hT x)
  have hNuForward := integrable_prawitzPointKernel_sub nu hnu1 hT x
  have hNuReflected :=
    integrable_prawitzPointKernel_reflected_sub nu hnu1 hT x
  have hForwardEq :=
    integral_prawitzPointKernel_sub_eq_re_prawitzInversion nu hnu1 hT x
  have hSum :
      (∫ y, (prawitzPointKernel T (y - x) +
          prawitzPointKernel T (x - y)) ∂nu) =
        (∫ y, prawitzPointKernel T (y - x) ∂nu) +
          ∫ y, prawitzPointKernel T (x - y) ∂nu :=
    integral_add hNuForward hNuReflected
  rw [Complex.sub_re, hSum, hForwardEq]
  linarith

/-- One-sided signed smoothing inequality: the CDF discrepancy is bounded by
the finite-frequency Prawitz discrepancy plus the reflected Fejér remainder
of the comparison law. -/
theorem cdf_sub_cdf_le_norm_prawitzInversion_sub_add_reflection
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf mu x - cdf nu x ≤
      ‖prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x‖ +
      ∫ y, (prawitzPointKernel T (y - x) +
        prawitzPointKernel T (x - y)) ∂nu := by
  have hMu := cdf_sub_half_le_re_prawitzInversion mu hmu1 hT x
  have hNu := neg_integral_prawitzPointKernel_le_cdf_sub_half
    nu hT x (integrable_prawitzPointKernel_reflected_sub nu hnu1 hT x)
  have hNuForward := integrable_prawitzPointKernel_sub nu hnu1 hT x
  have hNuReflected :=
    integrable_prawitzPointKernel_reflected_sub nu hnu1 hT x
  have hForwardEq :=
    integral_prawitzPointKernel_sub_eq_re_prawitzInversion nu hnu1 hT x
  have hSum :
      (∫ y, (prawitzPointKernel T (y - x) +
          prawitzPointKernel T (x - y)) ∂nu) =
        (∫ y, prawitzPointKernel T (y - x) ∂nu) +
          ∫ y, prawitzPointKernel T (x - y) ∂nu :=
    integral_add hNuForward hNuReflected
  have hRe :
      (prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x).re ≤
      ‖prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x‖ :=
    Complex.re_le_norm _
  rw [Complex.sub_re] at hRe
  rw [hSum, hForwardEq]
  linarith

/-- Absolute integrability of the paired integrand is exactly the analytic
input needed to remove the symmetric truncation in Prawitz inversion. -/
theorem tendsto_truncatedPrawitzInversion_of_integrableOn
    {T : ℝ} {f : ℝ → ℂ} {x : ℝ} (hT : 0 < T)
    (hInt : IntegrableOn (symmetricPrawitzPVIntegrand T f x) (Icc 0 T)) :
    Tendsto (fun epsilon => truncatedPrawitzInversion T epsilon f x)
      (nhdsWithin (0 : ℝ) (Ioi 0)) (nhds (prawitzInversion T f x)) := by
  let g : ℝ → ℂ := symmetricPrawitzPVIntegrand T f x
  have hMeasure :
      Tendsto (fun epsilon : ℝ => volume (Ico 0 epsilon))
        (nhdsWithin (0 : ℝ) (Ioi 0)) (nhds 0) := by
    simp_rw [Real.volume_Ico, sub_zero]
    have hId : Tendsto (fun epsilon : ℝ => epsilon)
        (nhdsWithin (0 : ℝ) (Ioi 0)) (nhds 0) :=
      tendsto_id.mono_left nhdsWithin_le_nhds
    simpa only [ENNReal.ofReal_zero] using ENNReal.tendsto_ofReal hId
  have hSmall :
      Tendsto (fun epsilon : ℝ =>
          ∫ t in Ico 0 epsilon, (Icc 0 T).indicator g t)
        (nhdsWithin (0 : ℝ) (Ioi 0)) (nhds 0) :=
    Integrable.tendsto_setIntegral_nhds_zero
      (hInt.integrable_indicator measurableSet_Icc) hMeasure
  have hIntegral :
      Tendsto (fun epsilon : ℝ => ∫ t in Icc epsilon T, g t)
        (nhdsWithin (0 : ℝ) (Ioi 0)) (nhds (∫ t in Icc 0 T, g t)) := by
    have hSub : Tendsto (fun epsilon : ℝ =>
          (∫ t in Icc 0 T, g t) -
            ∫ t in Ico 0 epsilon, (Icc 0 T).indicator g t)
        (nhdsWithin (0 : ℝ) (Ioi 0)) (nhds (∫ t in Icc 0 T, g t)) := by
      simpa only [sub_zero] using tendsto_const_nhds.sub hSmall
    refine hSub.congr' ?_
    filter_upwards [self_mem_nhdsWithin,
        (eventually_le_nhds hT).filter_mono nhdsWithin_le_nhds] with
      epsilon hepsilon hepsilonT
    have hsub : Ico 0 epsilon ⊆ Icc 0 T := by
      intro t ht
      exact ⟨ht.1, ht.2.le.trans hepsilonT⟩
    have hdiff : Icc 0 T \ Ico 0 epsilon = Icc epsilon T := by
      ext t
      simp only [mem_diff, mem_Icc, mem_Ico]
      constructor
      · rintro ⟨⟨ht0, htT⟩, ht⟩
        exact ⟨le_of_not_gt fun hte => ht ⟨ht0, hte⟩, htT⟩
      · rintro ⟨hte, htT⟩
        exact ⟨⟨hepsilon.le.trans hte, htT⟩,
          fun ht => (ht.2.trans_le hte).false⟩
    rw [← hdiff, integral_diff measurableSet_Ico hInt hsub]
    rw [setIntegral_indicator measurableSet_Icc,
      inter_eq_left.mpr hsub]
  simpa only [truncatedPrawitzInversion, prawitzInversion, g] using
    hIntegral.const_mul (Complex.I / (2 * Real.pi : ℝ))

/-- For every probability law with a finite first absolute moment, the
symmetrically truncated Prawitz functional converges to its full paired
inversion integral as the truncation is removed. -/
theorem tendsto_truncatedPrawitzInversion_charFun
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    Tendsto (fun epsilon =>
        truncatedPrawitzInversion T epsilon (MeasureTheory.charFun mu) x)
      (nhdsWithin (0 : ℝ) (Ioi 0))
      (nhds (prawitzInversion T (MeasureTheory.charFun mu) x)) :=
  tendsto_truncatedPrawitzInversion_of_integrableOn hT
    (integrableOn_symmetricPrawitzPVIntegrand_charFun mu hmu1 hT x)

/-- At a positive frequency, the difference of two paired Prawitz integrands
is controlled by twice the corresponding positive-frequency difference. -/
theorem norm_symmetricPrawitzPVIntegrand_charFun_sub_le
    (mu nu : Measure ℝ) {T t : ℝ} (ht : 0 < t) (x : ℝ) :
    ‖symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
        symmetricPrawitzPVIntegrand T (MeasureTheory.charFun nu) x t‖ ≤
      2 * ‖prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
        prawitzPVIntegrand T (MeasureTheory.charFun nu) x t‖ := by
  let z : ℂ := prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
    prawitzPVIntegrand T (MeasureTheory.charFun nu) x t
  have hmuNeg := prawitzPVIntegrand_neg (T := T)
    (isHermitianFrequencyFunction_charFun mu) x ht.ne'
  have hnuNeg := prawitzPVIntegrand_neg (T := T)
    (isHermitianFrequencyFunction_charFun nu) x ht.ne'
  have hEq :
      symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
          symmetricPrawitzPVIntegrand T (MeasureTheory.charFun nu) x t =
        z - (starRingEnd ℂ) z := by
    rw [symmetricPrawitzPVIntegrand, symmetricPrawitzPVIntegrand,
      hmuNeg, hnuNeg]
    dsimp only [z]
    simp only [map_sub]
    ring
  rw [hEq]
  calc
    ‖z - (starRingEnd ℂ) z‖ ≤ ‖z‖ + ‖(starRingEnd ℂ) z‖ := norm_sub_le _ _
    _ = 2 * ‖z‖ := by rw [Complex.norm_conj]; ring

/-- The positive-frequency Prawitz integrand difference is exactly the filter
norm times the characteristic-function discrepancy quotient. -/
theorem norm_prawitzPVIntegrand_charFun_sub_eq
    (mu nu : Measure ℝ) {T t : ℝ} (ht : t ≠ 0) (x : ℝ) :
    ‖prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
        prawitzPVIntegrand T (MeasureTheory.charFun nu) x t‖ =
      ‖scaledPrawitzSmoothingFilter T t‖ *
        charFunDiscrepancyQuotient mu nu t := by
  have hEq :
      prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
          prawitzPVIntegrand T (MeasureTheory.charFun nu) x t =
        Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
            scaledPrawitzSmoothingFilter T t *
              (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t) /
                (t : ℂ) := by
    unfold prawitzPVIntegrand prawitzPVNumerator
    ring
  rw [hEq, norm_div, norm_mul, norm_mul,
    Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real,
    Real.norm_eq_abs, charFunDiscrepancyQuotient, if_neg ht]
  ring

/-- The scaled Prawitz filter retains the uniform unit-window bound throughout
its closed positive frequency window. -/
theorem norm_scaledPrawitzSmoothingFilter_le_seven
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Icc 0 T) :
    ‖scaledPrawitzSmoothingFilter T t‖ ≤ 7 := by
  rcases ht.2.eq_or_lt with htEq | htT
  · subst t
    simp [scaledPrawitzSmoothingFilter, hT.ne', prawitzSmoothingFilter]
  · apply norm_prawitzSmoothingFilter_le_seven
    · exact div_nonneg ht.1 hT.le
    · exact (div_lt_one hT).2 htT

/-- The filter-weighted characteristic-function discrepancy is integrable on
every positive Prawitz frequency window. -/
theorem integrableOn_norm_scaledPrawitzSmoothingFilter_mul_discrepancy
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) :
    IntegrableOn (fun t => ‖scaledPrawitzSmoothingFilter T t‖ *
      charFunDiscrepancyQuotient mu nu t) (Icc 0 T) := by
  have hq : IntegrableOn (charFunDiscrepancyQuotient mu nu) (Icc 0 T) :=
    (intervalIntegrable_iff_integrableOn_Icc_of_le hT.le).mp
      (intervalIntegrable_charFunDiscrepancyQuotient hmu1 hnu1 0 T)
  apply hq.bdd_mul (c := 7)
  · exact (measurable_scaledPrawitzSmoothingFilter T).norm.aestronglyMeasurable
  · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    simpa only [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)] using
      norm_scaledPrawitzSmoothingFilter_le_seven hT ht

/-- After subtracting two characteristic functions, the positive-frequency
Prawitz integrand has a genuinely removable singularity and is integrable on
the whole closed smoothing window.  This phase-sensitive form is the input
needed to apply Riemann--Lebesgue before taking norms. -/
theorem integrableOn_prawitzPVIntegrand_charFun_sub
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    IntegrableOn (fun t =>
      prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
        prawitzPVIntegrand T (MeasureTheory.charFun nu) x t) (Icc 0 T) := by
  let d : ℝ → ℂ := fun t =>
    prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
      prawitzPVIntegrand T (MeasureTheory.charFun nu) x t
  let q : ℝ → ℝ := fun t =>
    ‖scaledPrawitzSmoothingFilter T t‖ *
      charFunDiscrepancyQuotient mu nu t
  have hq : IntegrableOn q (Icc 0 T) := by
    simpa only [q] using
      integrableOn_norm_scaledPrawitzSmoothingFilter_mul_discrepancy
        mu nu hmu1 hnu1 hT
  have hd : AEStronglyMeasurable d (volume.restrict (Icc 0 T)) := by
    dsimp only [d]
    exact ((measurable_prawitzPVIntegrand
      MeasureTheory.measurable_charFun x).sub
        (measurable_prawitzPVIntegrand
          MeasureTheory.measurable_charFun x)).aestronglyMeasurable
  apply hq.mono' hd
  filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
  rcases ht.1.eq_or_lt with rfl | ht0
  · simp [d, q, prawitzPVIntegrand, prawitzPVNumerator,
      charFunDiscrepancyQuotient]
  · simpa only [d, q] using
      (norm_prawitzPVIntegrand_charFun_sub_eq
        (T := T) mu nu ht0.ne' x).le

/-- The entire spatial dependence of a positive-frequency Prawitz
characteristic-function difference is its unit complex exponential phase. -/
theorem prawitzPVIntegrand_charFun_sub_eq_phase_mul_zero
    (mu nu : Measure ℝ) (T x t : ℝ) :
    prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
        prawitzPVIntegrand T (MeasureTheory.charFun nu) x t =
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
        (prawitzPVIntegrand T (MeasureTheory.charFun mu) 0 t -
          prawitzPVIntegrand T (MeasureTheory.charFun nu) 0 t) := by
  unfold prawitzPVIntegrand prawitzPVNumerator
  simp only [mul_zero, neg_zero, Complex.ofReal_zero, zero_mul,
    Complex.exp_zero, one_mul]
  ring

/-- The phase-preserving positive-frequency Prawitz difference is continuous
in the spatial parameter. -/
theorem continuous_setIntegral_prawitzPVIntegrand_charFun_sub
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) :
    Continuous (fun x : ℝ => ∫ t in Icc (0 : ℝ) T,
      (prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
        prawitzPVIntegrand T (MeasureTheory.charFun nu) x t)) := by
  let a : ℝ → ℂ := fun t =>
    prawitzPVIntegrand T (MeasureTheory.charFun mu) 0 t -
      prawitzPVIntegrand T (MeasureTheory.charFun nu) 0 t
  let f : ℝ → ℂ := (Icc (0 : ℝ) T).indicator a
  have ha : IntegrableOn a (Icc (0 : ℝ) T) := by
    simpa only [a] using
      integrableOn_prawitzPVIntegrand_charFun_sub
        mu nu hmu1 hnu1 hT 0
  have hf : Integrable f := by
    simpa only [f] using ha.integrable_indicator measurableSet_Icc
  have hFourier := continuous_integral_cexp_neg_mul_I_mul f hf
  convert hFourier using 1
  funext x
  rw [← integral_indicator measurableSet_Icc]
  apply integral_congr_ae
  filter_upwards with t
  by_cases ht : t ∈ Icc (0 : ℝ) T
  · simp only [Set.indicator_of_mem ht, f, a]
    exact prawitzPVIntegrand_charFun_sub_eq_phase_mul_zero
      mu nu T x t
  · simp only [Set.indicator_of_notMem ht, f, mul_zero]

/-- The phase-preserving positive-frequency Prawitz difference vanishes in
the positive spatial tail before taking any complex norm. -/
theorem tendsto_setIntegral_prawitzPVIntegrand_charFun_sub_atTop
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) :
    Tendsto (fun x : ℝ => ∫ t in Icc (0 : ℝ) T,
      (prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
        prawitzPVIntegrand T (MeasureTheory.charFun nu) x t))
      atTop (𝓝 0) := by
  let a : ℝ → ℂ := fun t =>
    prawitzPVIntegrand T (MeasureTheory.charFun mu) 0 t -
      prawitzPVIntegrand T (MeasureTheory.charFun nu) 0 t
  let f : ℝ → ℂ := (Icc (0 : ℝ) T).indicator a
  have ha : IntegrableOn a (Icc (0 : ℝ) T) := by
    simpa only [a] using
      integrableOn_prawitzPVIntegrand_charFun_sub
        mu nu hmu1 hnu1 hT 0
  have hf : Integrable f := by
    simpa only [f] using ha.integrable_indicator measurableSet_Icc
  have hrl := tendsto_integral_cexp_neg_mul_I_mul_atTop f
  convert hrl using 1
  funext x
  rw [← integral_indicator measurableSet_Icc]
  apply integral_congr_ae
  filter_upwards with t
  by_cases ht : t ∈ Icc (0 : ℝ) T
  · simp only [Set.indicator_of_mem ht, f, a]
    exact prawitzPVIntegrand_charFun_sub_eq_phase_mul_zero
      mu nu T x t
  · simp only [Set.indicator_of_notMem ht, f, mul_zero]

/-- The phase-preserving positive-frequency Prawitz difference also vanishes
in the negative spatial tail before taking any complex norm. -/
theorem tendsto_setIntegral_prawitzPVIntegrand_charFun_sub_atBot
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) :
    Tendsto (fun x : ℝ => ∫ t in Icc (0 : ℝ) T,
      (prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
        prawitzPVIntegrand T (MeasureTheory.charFun nu) x t))
      atBot (𝓝 0) := by
  let a : ℝ → ℂ := fun t =>
    prawitzPVIntegrand T (MeasureTheory.charFun mu) 0 t -
      prawitzPVIntegrand T (MeasureTheory.charFun nu) 0 t
  let f : ℝ → ℂ := (Icc (0 : ℝ) T).indicator a
  have ha : IntegrableOn a (Icc (0 : ℝ) T) := by
    simpa only [a] using
      integrableOn_prawitzPVIntegrand_charFun_sub
        mu nu hmu1 hnu1 hT 0
  have hf : Integrable f := by
    simpa only [f] using ha.integrable_indicator measurableSet_Icc
  have hrl := tendsto_integral_cexp_neg_mul_I_mul_atBot f
  convert hrl using 1
  funext x
  rw [← integral_indicator measurableSet_Icc]
  apply integral_congr_ae
  filter_upwards with t
  by_cases ht : t ∈ Icc (0 : ℝ) T
  · simp only [Set.indicator_of_mem ht, f, a]
    exact prawitzPVIntegrand_charFun_sub_eq_phase_mul_zero
      mu nu T x t
  · simp only [Set.indicator_of_notMem ht, f, mul_zero]

/-- The structural uniform filter bound reduces the weighted positive-window
discrepancy integral to its unweighted counterpart. -/
theorem integral_norm_scaledPrawitzSmoothingFilter_mul_discrepancy_le_const
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) :
    (∫ t in Icc 0 T, ‖scaledPrawitzSmoothingFilter T t‖ *
        charFunDiscrepancyQuotient mu nu t) ≤
      (1 + Real.pi ^ 2 / 32) *
        ∫ t in Icc 0 T, charFunDiscrepancyQuotient mu nu t := by
  let q : ℝ → ℝ := charFunDiscrepancyQuotient mu nu
  let C : ℝ := 1 + Real.pi ^ 2 / 32
  have hq : IntegrableOn q (Icc 0 T) :=
    (intervalIntegrable_iff_integrableOn_Icc_of_le hT.le).mp
      (intervalIntegrable_charFunDiscrepancyQuotient hmu1 hnu1 0 T)
  have hweighted : IntegrableOn
      (fun t => ‖scaledPrawitzSmoothingFilter T t‖ * q t) (Icc 0 T) := by
    simpa only [q] using
      integrableOn_norm_scaledPrawitzSmoothingFilter_mul_discrepancy
        mu nu hmu1 hnu1 hT
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  change (∫ t in Icc 0 T,
      ‖scaledPrawitzSmoothingFilter T t‖ * q t) ≤
    C * ∫ t in Icc 0 T, q t
  rw [← integral_const_mul]
  apply setIntegral_mono_on hweighted (hq.const_mul C) measurableSet_Icc
  intro s hs
  have hq0 : 0 ≤ q s := charFunDiscrepancyQuotient_nonneg mu nu s
  rcases hs.2.eq_or_lt with hsT | hsT
  · subst s
    rw [scaledPrawitzSmoothingFilter_eq_zero_of_abs_ge hT
        (by rw [abs_of_pos hT])]
    simp only [norm_zero, zero_mul]
    exact mul_nonneg hC hq0
  · exact mul_le_mul_of_nonneg_right
      (norm_scaledPrawitzSmoothingFilter_le_one_add_pi_sq_div_thirtytwo
        hT hs.1 hsT) hq0

/-- Uniform filter reduction on an initial subwindow of a possibly larger
Prawitz smoothing band. -/
theorem integral_norm_scaledPrawitzSmoothingFilter_mul_discrepancy_local_le_const
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T₀ T : ℝ} (hT₀ : 0 ≤ T₀) (hT : 0 < T) (hT₀T : T₀ ≤ T) :
    (∫ t in Icc 0 T₀, ‖scaledPrawitzSmoothingFilter T t‖ *
        charFunDiscrepancyQuotient mu nu t) ≤
      (1 + Real.pi ^ 2 / 32) *
        ∫ t in Icc 0 T₀, charFunDiscrepancyQuotient mu nu t := by
  let q : ℝ → ℝ := charFunDiscrepancyQuotient mu nu
  let C : ℝ := 1 + Real.pi ^ 2 / 32
  have hq : IntegrableOn q (Icc 0 T₀) :=
    (intervalIntegrable_iff_integrableOn_Icc_of_le hT₀).mp
      (intervalIntegrable_charFunDiscrepancyQuotient hmu1 hnu1 0 T₀)
  have hweighted : IntegrableOn
      (fun t => ‖scaledPrawitzSmoothingFilter T t‖ * q t) (Icc 0 T₀) := by
    have hfull :=
      integrableOn_norm_scaledPrawitzSmoothingFilter_mul_discrepancy
        mu nu hmu1 hnu1 hT
    exact hfull.mono_set (Icc_subset_Icc_right hT₀T)
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  change (∫ t in Icc 0 T₀,
      ‖scaledPrawitzSmoothingFilter T t‖ * q t) ≤
    C * ∫ t in Icc 0 T₀, q t
  rw [← integral_const_mul]
  apply setIntegral_mono_on hweighted (hq.const_mul C) measurableSet_Icc
  intro t ht
  have hq0 : 0 ≤ q t := charFunDiscrepancyQuotient_nonneg mu nu t
  by_cases htEq : t = T
  · subst t
    rw [scaledPrawitzSmoothingFilter_eq_zero_of_abs_ge hT
        (by rw [abs_of_pos hT])]
    simp only [norm_zero, zero_mul]
    exact mul_nonneg hC hq0
  · exact mul_le_mul_of_nonneg_right
      (norm_scaledPrawitzSmoothingFilter_le_one_add_pi_sq_div_thirtytwo
        hT ht.1 (lt_of_le_of_ne (ht.2.trans hT₀T) htEq)) hq0

/-- Exact decomposition of a filter-weighted discrepancy integral at an
arbitrary positive inner cutoff. -/
theorem integral_norm_scaledPrawitzSmoothingFilter_mul_discrepancy_split
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T₀ T : ℝ} (hT₀ : 0 < T₀) (hT₀T : T₀ ≤ T) :
    (∫ t in Icc 0 T, ‖scaledPrawitzSmoothingFilter T t‖ *
        charFunDiscrepancyQuotient mu nu t) =
      (∫ t in Icc 0 T₀, ‖scaledPrawitzSmoothingFilter T t‖ *
        charFunDiscrepancyQuotient mu nu t) +
      ∫ t in Ioc T₀ T, ‖scaledPrawitzSmoothingFilter T t‖ *
        charFunDiscrepancyQuotient mu nu t := by
  have hT : 0 < T := hT₀.trans_le hT₀T
  let f : ℝ → ℝ := fun t => ‖scaledPrawitzSmoothingFilter T t‖ *
    charFunDiscrepancyQuotient mu nu t
  have hf : IntegrableOn f (Icc 0 T) := by
    simpa only [f] using
      integrableOn_norm_scaledPrawitzSmoothingFilter_mul_discrepancy
        mu nu hmu1 hnu1 hT
  have hf₀ : IntegrableOn f (Icc 0 T₀) :=
    hf.mono_set (Icc_subset_Icc_right hT₀T)
  have hftail : IntegrableOn f (Ioc T₀ T) := by
    apply hf.mono_set
    intro t ht
    exact ⟨hT₀.le.trans ht.1.le, ht.2⟩
  have hunion : Icc (0 : ℝ) T₀ ∪ Ioc T₀ T = Icc 0 T := by
    ext t
    simp only [mem_union, mem_Icc, mem_Ioc]
    constructor
    · rintro (ht | ht)
      · exact ⟨ht.1, ht.2.trans hT₀T⟩
      · exact ⟨hT₀.le.trans ht.1.le, ht.2⟩
    · intro ht
      by_cases h : t ≤ T₀
      · exact Or.inl ⟨ht.1, h⟩
      · exact Or.inr ⟨lt_of_not_ge h, ht.2⟩
  have hdisjoint : Disjoint (Icc (0 : ℝ) T₀) (Ioc T₀ T) := by
    rw [Set.disjoint_left]
    intro t ht₀ htTail
    exact (not_lt_of_ge ht₀.2) htTail.1
  change (∫ t in Icc 0 T, f t) =
    (∫ t in Icc 0 T₀, f t) + ∫ t in Ioc T₀ T, f t
  rw [← hunion, setIntegral_union hdisjoint measurableSet_Ioc hf₀ hftail]

/-- Two-cutoff Prawitz decomposition.  Frequencies up to `T₀` retain the
exact discrepancy, while the larger smoothing band uses only the universal
`2 / |t|` characteristic-function bound. -/
theorem integral_norm_scaledPrawitzSmoothingFilter_mul_discrepancy_le_twoCutoff
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T₀ T : ℝ} (hT₀ : 0 < T₀) (hT₀T : T₀ ≤ T) :
    (∫ t in Icc 0 T, ‖scaledPrawitzSmoothingFilter T t‖ *
        charFunDiscrepancyQuotient mu nu t) ≤
      (∫ t in Icc 0 T₀, ‖scaledPrawitzSmoothingFilter T t‖ *
        charFunDiscrepancyQuotient mu nu t) +
      ∫ t in Ioc T₀ T, ‖scaledPrawitzSmoothingFilter T t‖ * (2 / |t|) := by
  have hT : 0 < T := hT₀.trans_le hT₀T
  let f : ℝ → ℝ := fun t => ‖scaledPrawitzSmoothingFilter T t‖ *
    charFunDiscrepancyQuotient mu nu t
  let g : ℝ → ℝ := fun t => ‖scaledPrawitzSmoothingFilter T t‖ *
    (2 / |t|)
  have hf : IntegrableOn f (Icc 0 T) := by
    simpa only [f] using
      integrableOn_norm_scaledPrawitzSmoothingFilter_mul_discrepancy
        mu nu hmu1 hnu1 hT
  have hf₀ : IntegrableOn f (Icc 0 T₀) :=
    hf.mono_set (Icc_subset_Icc_right hT₀T)
  have hftail : IntegrableOn f (Ioc T₀ T) := by
    apply hf.mono_set
    intro t ht
    exact ⟨hT₀.le.trans ht.1.le, ht.2⟩
  have hgStrong : StronglyMeasurable g := by
    dsimp only [g]
    exact ((measurable_scaledPrawitzSmoothingFilter T).norm.mul
      (measurable_const.div measurable_abs)).stronglyMeasurable
  have hgTail : IntegrableOn g (Ioc T₀ T) := by
    have hconst : IntegrableOn (fun _ : ℝ => 14 / T₀) (Ioc T₀ T) :=
      integrableOn_const measure_Ioc_lt_top.ne
    apply Integrable.mono' hconst hgStrong.aestronglyMeasurable
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    rw [Real.norm_eq_abs, abs_of_nonneg (by
      dsimp only [g]
      positivity : 0 ≤ g t)]
    have ht0 : 0 < t := hT₀.trans ht.1
    have hfilter : ‖scaledPrawitzSmoothingFilter T t‖ ≤ 7 :=
      norm_scaledPrawitzSmoothingFilter_le_seven hT
        ⟨ht0.le, ht.2⟩
    have hdiv : 2 / |t| ≤ 2 / T₀ := by
      rw [abs_of_pos ht0]
      exact div_le_div_of_nonneg_left (by norm_num) hT₀ ht.1.le
    dsimp only [g]
    have hnonneg : 0 ≤ 2 / |t| := by positivity
    calc
      ‖scaledPrawitzSmoothingFilter T t‖ * (2 / |t|) ≤
          7 * (2 / |t|) := mul_le_mul_of_nonneg_right hfilter hnonneg
      _ ≤ 7 * (2 / T₀) := mul_le_mul_of_nonneg_left hdiv (by norm_num)
      _ = 14 / T₀ := by ring
  have hunion : Icc (0 : ℝ) T₀ ∪ Ioc T₀ T = Icc 0 T := by
    ext t
    simp only [mem_union, mem_Icc, mem_Ioc]
    constructor
    · rintro (ht | ht)
      · exact ⟨ht.1, ht.2.trans hT₀T⟩
      · exact ⟨hT₀.le.trans ht.1.le, ht.2⟩
    · intro ht
      by_cases h : t ≤ T₀
      · exact Or.inl ⟨ht.1, h⟩
      · exact Or.inr ⟨lt_of_not_ge h, ht.2⟩
  have hdisjoint : Disjoint (Icc (0 : ℝ) T₀) (Ioc T₀ T) := by
    rw [Set.disjoint_left]
    intro t ht₀ htTail
    exact (not_lt_of_ge ht₀.2) htTail.1
  have hsplit : (∫ t in Icc 0 T, f t) =
      (∫ t in Icc 0 T₀, f t) + ∫ t in Ioc T₀ T, f t := by
    rw [← hunion, setIntegral_union hdisjoint measurableSet_Ioc hf₀ hftail]
  have htail : (∫ t in Ioc T₀ T, f t) ≤ ∫ t in Ioc T₀ T, g t := by
    apply integral_mono hftail hgTail
    intro t
    exact mul_le_mul_of_nonneg_left
      (charFunDiscrepancyQuotient_le_two_div_abs mu nu t) (norm_nonneg _)
  change (∫ t in Icc 0 T, f t) ≤
    (∫ t in Icc 0 T₀, f t) + ∫ t in Ioc T₀ T, g t
  rw [hsplit]
  simpa only [add_comm] using
    add_le_add_left htail (∫ t in Icc 0 T₀, f t)

/-- Scaling the outer Prawitz band to the unit interval removes the smoothing
bandwidth from its universal discrepancy majorant. -/
theorem integral_norm_scaledPrawitzSmoothingFilter_mul_two_div_abs_tail_eq_unit
    {T₀ T : ℝ} (hT₀ : 0 < T₀) (hT₀T : T₀ ≤ T) :
    (∫ t in Ioc T₀ T,
      ‖scaledPrawitzSmoothingFilter T t‖ * (2 / |t|)) =
      ∫ u in Ioc (T₀ / T) 1,
        ‖prawitzSmoothingFilter u‖ * (2 / |u|) := by
  have hT : 0 < T := hT₀.trans_le hT₀T
  have hratio : T₀ / T ≤ 1 := (div_le_one hT).2 hT₀T
  let f : ℝ → ℝ := fun t =>
    ‖scaledPrawitzSmoothingFilter T t‖ * (2 / |t|)
  rw [← intervalIntegral.integral_of_le hT₀T,
    ← intervalIntegral.integral_of_le hratio]
  have hchange := intervalIntegral.smul_integral_comp_mul_left
    (f := f) (a := T₀ / T) (b := 1) T
  calc
    (∫ t in T₀..T, f t) = T * ∫ u in T₀ / T..1, f (T * u) := by
      simpa only [smul_eq_mul, mul_one, mul_div_cancel₀ T₀ hT.ne'] using
        hchange.symm
    _ = ∫ u in T₀ / T..1,
        ‖prawitzSmoothingFilter u‖ * (2 / |u|) := by
      rw [← intervalIntegral.integral_const_mul]
      apply intervalIntegral.integral_congr
      intro u _
      by_cases hu : u = 0
      · subst u
        simp [f, scaledPrawitzSmoothingFilter]
      · dsimp only [f, scaledPrawitzSmoothingFilter]
        rw [mul_div_cancel_left₀ u hT.ne', abs_mul, abs_of_pos hT]
        field_simp

/-- Optimization-ready form of the scaled outer-band identity, with its
universal characteristic-function factor pulled outside the unit integral. -/
theorem integral_norm_scaledPrawitzSmoothingFilter_mul_two_div_abs_tail_eq_two_mul
    {T₀ T : ℝ} (hT₀ : 0 < T₀) (hT₀T : T₀ ≤ T) :
    (∫ t in Ioc T₀ T,
      ‖scaledPrawitzSmoothingFilter T t‖ * (2 / |t|)) =
      2 * ∫ u in Ioc (T₀ / T) 1,
        ‖prawitzSmoothingFilter u‖ / u := by
  rw [integral_norm_scaledPrawitzSmoothingFilter_mul_two_div_abs_tail_eq_unit
    hT₀ hT₀T, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [ae_restrict_mem measurableSet_Ioc] with u hu
  have hT : 0 < T := hT₀.trans_le hT₀T
  have hu0 : 0 < u := (div_pos hT₀ hT).trans hu.1
  rw [abs_of_pos hu0]
  ring

/-- A closed logarithmic upper bound for the dimensionless Prawitz tail. -/
theorem integral_norm_prawitzSmoothingFilter_div_le_log
    {a : ℝ} (ha : 0 < a) (ha1 : a ≤ 1) :
    (∫ u in Ioc a 1, ‖prawitzSmoothingFilter u‖ / u) ≤
      (1 + Real.pi ^ 2 / 32) * Real.log (1 / a) := by
  let g : ℝ → ℝ := fun u => ‖prawitzSmoothingFilter u‖ / u
  let C : ℝ := 1 + Real.pi ^ 2 / 32
  let G : ℝ → ℝ := fun u => C * (1 / u)
  have hgStrong : StronglyMeasurable g := by
    dsimp only [g]
    exact (measurable_prawitzSmoothingFilter.norm.div
      measurable_id).stronglyMeasurable
  have hg : IntegrableOn g (Ioc a 1) := by
    have hconst : IntegrableOn (fun _ : ℝ => 7 / a) (Ioc a 1) :=
      integrableOn_const measure_Ioc_lt_top.ne
    apply Integrable.mono' hconst hgStrong.aestronglyMeasurable
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with u hu
    have hu0 : 0 < u := ha.trans hu.1
    rw [Real.norm_eq_abs, abs_of_nonneg (by
      dsimp only [g]
      positivity : 0 ≤ g u)]
    have hnorm : ‖prawitzSmoothingFilter u‖ ≤ 7 := by
      rcases hu.2.eq_or_lt with rfl | hu1
      · simp [prawitzSmoothingFilter]
      · exact norm_prawitzSmoothingFilter_le_seven hu0.le hu1
    have hdiv : 1 / u ≤ 1 / a := by
      exact one_div_le_one_div_of_le ha hu.1.le
    dsimp only [g]
    calc
      ‖prawitzSmoothingFilter u‖ / u ≤ 7 / u :=
        (div_le_div_iff_of_pos_right hu0).2 hnorm
      _ ≤ 7 / a := by
        exact (div_le_div_iff₀ hu0 ha).2 (by nlinarith [hu.1])
  have hG : IntegrableOn G (Ioc a 1) := by
    have hinv : IntervalIntegrable (fun u : ℝ => 1 / u) volume a 1 :=
      intervalIntegral.intervalIntegrable_one_div
        (f := fun u : ℝ => u)
        (fun u hu => by
          rw [uIcc_of_le ha1] at hu
          exact ne_of_gt (ha.trans_le hu.1)) continuousOn_id
    have hIcc := (intervalIntegrable_iff_integrableOn_Icc_of_le ha1).mp
      (hinv.const_mul C)
    simpa only [G] using hIcc.mono_set Ioc_subset_Icc_self
  have hpoint : ∀ u ∈ Ioc a 1, g u ≤ G u := by
    intro u hu
    have hu0 : 0 < u := ha.trans hu.1
    have hC : 0 ≤ C := by dsimp only [C]; positivity
    have hnorm : ‖prawitzSmoothingFilter u‖ ≤ C := by
      rcases hu.2.eq_or_lt with rfl | hu1
      · dsimp only [C]
        simp [prawitzSmoothingFilter]
        positivity
      · dsimp only [C]
        exact norm_prawitzSmoothingFilter_le_one_add_pi_sq_div_thirtytwo
          hu0.le hu1
    dsimp only [g, G]
    calc
      ‖prawitzSmoothingFilter u‖ / u ≤ C / u :=
        (div_le_div_iff_of_pos_right hu0).2 hnorm
      _ = C * (1 / u) := by ring
  change (∫ u in Ioc a 1, g u) ≤ _
  calc
    (∫ u in Ioc a 1, g u) ≤ ∫ u in Ioc a 1, G u := by
      exact setIntegral_mono_on hg hG measurableSet_Ioc hpoint
    _ = C * Real.log (1 / a) := by
      rw [← intervalIntegral.integral_of_le ha1]
      dsimp only [G]
      rw [intervalIntegral.integral_const_mul,
        integral_one_div_of_pos ha zero_lt_one]
    _ = _ := rfl

/-- Endpoint-sensitive unit-tail bound.  Unlike the uniform logarithmic
estimate, this majorant is quadratic as `a` tends to one. -/
theorem integral_norm_prawitzSmoothingFilter_div_le_endpoint
    {a : ℝ} (haHalf : 1 / 2 ≤ a) (ha1 : a ≤ 1) :
    (∫ u in Ioc a 1, ‖prawitzSmoothingFilter u‖ / u) ≤
      (Real.pi ^ 2 / 2 + Real.pi) *
        (Real.log (1 / a) - (1 - a)) := by
  have ha : 0 < a := lt_of_lt_of_le (by norm_num) haHalf
  let g : ℝ → ℝ := fun u => ‖prawitzSmoothingFilter u‖ / u
  let K : ℝ := Real.pi ^ 2 / 2 + Real.pi
  let G : ℝ → ℝ := fun u => K * ((1 - u) / u)
  have hgStrong : StronglyMeasurable g := by
    dsimp only [g]
    exact (measurable_prawitzSmoothingFilter.norm.div
      measurable_id).stronglyMeasurable
  have hg : IntegrableOn g (Ioc a 1) := by
    have hconst : IntegrableOn (fun _ : ℝ => 7 / a) (Ioc a 1) :=
      integrableOn_const measure_Ioc_lt_top.ne
    apply Integrable.mono' hconst hgStrong.aestronglyMeasurable
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with u hu
    have hu0 : 0 < u := ha.trans hu.1
    rw [Real.norm_eq_abs, abs_of_nonneg (by
      dsimp only [g]
      positivity : 0 ≤ g u)]
    have hnorm : ‖prawitzSmoothingFilter u‖ ≤ 7 := by
      rcases hu.2.eq_or_lt with rfl | hu1
      · simp [prawitzSmoothingFilter]
      · exact norm_prawitzSmoothingFilter_le_seven hu0.le hu1
    dsimp only [g]
    calc
      ‖prawitzSmoothingFilter u‖ / u ≤ 7 / u :=
        (div_le_div_iff_of_pos_right hu0).2 hnorm
      _ ≤ 7 / a := (div_le_div_iff₀ hu0 ha).2 (by nlinarith [hu.1])
  have hG : IntegrableOn G (Ioc a 1) := by
    have hden : ∀ u ∈ Icc a 1, u ≠ 0 := fun u hu =>
      ne_of_gt (ha.trans_le hu.1)
    have hratio : ContinuousOn (fun u : ℝ => (1 - u) / u) (Icc a 1) :=
      (continuousOn_const.sub continuousOn_id).div continuousOn_id hden
    have hcont : ContinuousOn G (Icc a 1) := by
      dsimp only [G]
      exact continuousOn_const.mul hratio
    exact hcont.integrableOn_Icc.mono_set Ioc_subset_Icc_self
  have hpoint : ∀ u ∈ Ioc a 1, g u ≤ G u := by
    intro u hu
    have hu0 : 0 < u := ha.trans hu.1
    rcases hu.2.eq_or_lt with rfl | hu1
    · simp [g, G, prawitzSmoothingFilter]
    · have hnorm := norm_prawitzSmoothingFilter_le_endpoint_linear
        (haHalf.trans hu.1.le) hu1
      dsimp only [g, G, K]
      calc
        ‖prawitzSmoothingFilter u‖ / u ≤
            ((Real.pi ^ 2 / 2 + Real.pi) * (1 - u)) / u :=
          (div_le_div_iff_of_pos_right hu0).2 hnorm
        _ = (Real.pi ^ 2 / 2 + Real.pi) * ((1 - u) / u) := by ring
  change (∫ u in Ioc a 1, g u) ≤ _
  calc
    (∫ u in Ioc a 1, g u) ≤ ∫ u in Ioc a 1, G u := by
      exact setIntegral_mono_on hg hG measurableSet_Ioc hpoint
    _ = K * (Real.log (1 / a) - (1 - a)) := by
      rw [← intervalIntegral.integral_of_le ha1]
      have hinv : IntervalIntegrable (fun u : ℝ => 1 / u) volume a 1 :=
        intervalIntegral.intervalIntegrable_one_div
          (f := fun u : ℝ => u)
          (fun u hu => by
            rw [uIcc_of_le ha1] at hu
            exact ne_of_gt (ha.trans_le hu.1)) continuousOn_id
      dsimp only [G]
      have hcongr : (∫ u in a..1, K * ((1 - u) / u)) =
          ∫ u in a..1, K * (1 / u - 1) := by
        apply intervalIntegral.integral_congr
        intro u hu
        rw [uIcc_of_le ha1] at hu
        have hu0 : u ≠ 0 := ne_of_gt (ha.trans_le hu.1)
        field_simp
      rw [hcongr, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_sub hinv intervalIntegral.intervalIntegrable_const,
        integral_one_div_of_pos ha zero_lt_one,
        integral_one]
    _ = _ := rfl

/-- Closed logarithmic bound for the universal outer band in the original
frequency scale. -/
theorem integral_norm_scaledPrawitzSmoothingFilter_mul_two_div_abs_tail_le_log
    {T₀ T : ℝ} (hT₀ : 0 < T₀) (hT₀T : T₀ ≤ T) :
    (∫ t in Ioc T₀ T,
      ‖scaledPrawitzSmoothingFilter T t‖ * (2 / |t|)) ≤
      2 * (1 + Real.pi ^ 2 / 32) * Real.log (T / T₀) := by
  have hT : 0 < T := hT₀.trans_le hT₀T
  have ha : 0 < T₀ / T := div_pos hT₀ hT
  have ha1 : T₀ / T ≤ 1 := (div_le_one hT).2 hT₀T
  rw [integral_norm_scaledPrawitzSmoothingFilter_mul_two_div_abs_tail_eq_two_mul
    hT₀ hT₀T]
  calc
    2 * (∫ u in Ioc (T₀ / T) 1,
        ‖prawitzSmoothingFilter u‖ / u) ≤
        2 * ((1 + Real.pi ^ 2 / 32) * Real.log (1 / (T₀ / T))) :=
      mul_le_mul_of_nonneg_left
        (integral_norm_prawitzSmoothingFilter_div_le_log ha ha1) (by norm_num)
    _ = 2 * (1 + Real.pi ^ 2 / 32) * Real.log (T / T₀) := by
      have harg : 1 / (T₀ / T) = T / T₀ := by
        field_simp
      rw [harg]
      ring

/-- Endpoint-sensitive scaled outer-band estimate, valid while the smoothing
bandwidth is at most twice the Taylor cutoff. -/
theorem integral_norm_scaledPrawitzSmoothingFilter_mul_two_div_abs_tail_le_endpoint
    {T₀ T : ℝ} (hT₀ : 0 < T₀) (hT₀T : T₀ ≤ T) (hTT₀ : T ≤ 2 * T₀) :
    (∫ t in Ioc T₀ T,
      ‖scaledPrawitzSmoothingFilter T t‖ * (2 / |t|)) ≤
      2 * (Real.pi ^ 2 / 2 + Real.pi) *
        (Real.log (T / T₀) - (1 - T₀ / T)) := by
  have hT : 0 < T := hT₀.trans_le hT₀T
  have haHalf : 1 / 2 ≤ T₀ / T := by
    rw [le_div_iff₀ hT]
    nlinarith
  have ha1 : T₀ / T ≤ 1 := (div_le_one hT).2 hT₀T
  rw [integral_norm_scaledPrawitzSmoothingFilter_mul_two_div_abs_tail_eq_two_mul
    hT₀ hT₀T]
  calc
    2 * (∫ u in Ioc (T₀ / T) 1,
        ‖prawitzSmoothingFilter u‖ / u) ≤
        2 * ((Real.pi ^ 2 / 2 + Real.pi) *
          (Real.log (1 / (T₀ / T)) - (1 - T₀ / T))) :=
      mul_le_mul_of_nonneg_left
        (integral_norm_prawitzSmoothingFilter_div_le_endpoint haHalf ha1)
        (by norm_num)
    _ = 2 * (Real.pi ^ 2 / 2 + Real.pi) *
        (Real.log (T / T₀) - (1 - T₀ / T)) := by
      have harg : 1 / (T₀ / T) = T / T₀ := by field_simp
      rw [harg]
      ring

/-- Exact signed integral representation of the real part of a Prawitz
inversion difference. -/
theorem re_prawitzInversion_charFun_sub_eq_signedIntegral
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x).re =
      ((Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t in Icc 0 T,
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T (MeasureTheory.charFun nu) x t)).re := by
  have hmu := integrableOn_symmetricPrawitzPVIntegrand_charFun
    mu hmu1 hT x
  have hnu := integrableOn_symmetricPrawitzPVIntegrand_charFun
    nu hnu1 hT x
  rw [prawitzInversion, prawitzInversion, ← mul_sub,
    ← integral_sub hmu hnu]

/-- The difference of two full Prawitz inversion functionals is bounded by
the integral norm of their paired-frequency discrepancy. -/
theorem norm_prawitzInversion_charFun_sub_le_symmetricIntegral
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    ‖prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x‖ ≤
      ‖Complex.I / (2 * Real.pi : ℝ)‖ *
        ∫ t in Icc 0 T,
          ‖symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T (MeasureTheory.charFun nu) x t‖ := by
  have hmu := integrableOn_symmetricPrawitzPVIntegrand_charFun
    mu hmu1 hT x
  have hnu := integrableOn_symmetricPrawitzPVIntegrand_charFun
    nu hnu1 hT x
  rw [prawitzInversion, prawitzInversion, ← mul_sub,
    ← integral_sub hmu hnu, norm_mul]
  exact mul_le_mul_of_nonneg_left
    (norm_integral_le_integral_norm _) (norm_nonneg _)

/-- Direct comparison of two Prawitz inversion functionals by their weighted
positive-frequency characteristic-function discrepancy. -/
theorem norm_prawitzInversion_charFun_sub_le_integral_discrepancy
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    ‖prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x‖ ≤
      (1 / Real.pi) * ∫ t in Icc 0 T,
        ‖scaledPrawitzSmoothingFilter T t‖ *
          charFunDiscrepancyQuotient mu nu t := by
  let d : ℝ → ℂ := fun t =>
    symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
      symmetricPrawitzPVIntegrand T (MeasureTheory.charFun nu) x t
  let q : ℝ → ℝ := fun t => ‖scaledPrawitzSmoothingFilter T t‖ *
    charFunDiscrepancyQuotient mu nu t
  have hmu := integrableOn_symmetricPrawitzPVIntegrand_charFun
    mu hmu1 hT x
  have hnu := integrableOn_symmetricPrawitzPVIntegrand_charFun
    nu hnu1 hT x
  have hd : IntegrableOn d (Icc 0 T) := by
    simpa only [d] using hmu.sub hnu
  have hq : IntegrableOn q (Icc 0 T) := by
    simpa only [q] using
      integrableOn_norm_scaledPrawitzSmoothingFilter_mul_discrepancy
        mu nu hmu1 hnu1 hT
  have hpoint : ∀ t ∈ Icc 0 T, ‖d t‖ ≤ 2 * q t := by
    intro t ht
    rcases ht.1.eq_or_lt with rfl | ht0
    · simp [d, q, symmetricPrawitzPVIntegrand, prawitzPVIntegrand,
        charFunDiscrepancyQuotient]
    · calc
        ‖d t‖ ≤ 2 *
            ‖prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
              prawitzPVIntegrand T (MeasureTheory.charFun nu) x t‖ := by
          simpa only [d] using
            norm_symmetricPrawitzPVIntegrand_charFun_sub_le mu nu ht0 x
        _ = 2 * q t := by
          rw [norm_prawitzPVIntegrand_charFun_sub_eq mu nu ht0.ne' x]
  have hIntegral :
      (∫ t in Icc 0 T, ‖d t‖) ≤ 2 * ∫ t in Icc 0 T, q t := by
    calc
      (∫ t in Icc 0 T, ‖d t‖) ≤
          ∫ t in Icc 0 T, 2 * q t := by
        apply integral_mono_ae hd.norm (hq.const_mul 2)
        filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
        exact hpoint t ht
      _ = 2 * ∫ t in Icc 0 T, q t := integral_const_mul 2 q
  calc
    ‖prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x‖ ≤
        ‖Complex.I / (2 * Real.pi : ℝ)‖ * ∫ t in Icc 0 T, ‖d t‖ := by
      simpa only [d] using
        norm_prawitzInversion_charFun_sub_le_symmetricIntegral
          mu nu hmu1 hnu1 hT x
    _ ≤ ‖Complex.I / (2 * Real.pi : ℝ)‖ *
          (2 * ∫ t in Icc 0 T, q t) :=
      mul_le_mul_of_nonneg_left hIntegral (norm_nonneg _)
    _ = (1 / Real.pi) * ∫ t in Icc 0 T, q t := by
      rw [norm_div, Complex.norm_I, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (mul_pos (by norm_num) Real.pi_pos)]
      field_simp [Real.pi_ne_zero]
    _ = (1 / Real.pi) * ∫ t in Icc 0 T,
          ‖scaledPrawitzSmoothingFilter T t‖ *
            charFunDiscrepancyQuotient mu nu t := rfl

/-- The unnormalized spatial density of the concrete Esseen smoothing
kernel.  The fourth power gives a finite first moment while retaining compact
Fourier support. -/
noncomputable def sincFourthWeight (x : ℝ) : ℝ := Real.sinc x ^ 4

theorem sincFourthWeight_nonneg (x : ℝ) : 0 ≤ sincFourthWeight x := by
  unfold sincFourthWeight
  positivity

theorem continuous_sincFourthWeight : Continuous sincFourthWeight := by
  exact Real.continuous_sinc.pow 4

/-- The sinc-fourth kernel density is integrable. -/
theorem integrable_sincFourthWeight : Integrable sincFourthWeight := by
  have hmajor : Integrable (fun x : ℝ => 2 * (1 + x ^ 2)⁻¹) :=
    integrable_inv_one_add_sq.const_mul 2
  apply hmajor.mono' continuous_sincFourthWeight.aestronglyMeasurable
  exact ae_of_all volume fun x => by
    rw [Real.norm_eq_abs, abs_of_nonneg (sincFourthWeight_nonneg x)]
    by_cases hx : |x| ≤ 1
    · have hs : |Real.sinc x| ^ 4 ≤ 1 := by
        exact pow_le_one₀ (abs_nonneg _) (Real.abs_sinc_le_one x)
      have hxSq : x ^ 2 ≤ 1 := by
        rw [← sq_abs]
        nlinarith [abs_nonneg x]
      have hden : 0 < 1 + x ^ 2 := by positivity
      unfold sincFourthWeight
      rw [show Real.sinc x ^ 4 = |Real.sinc x| ^ 4 by
        rw [← abs_pow, abs_of_nonneg (by positivity)]]
      calc
        |Real.sinc x| ^ 4 ≤ 1 := hs
        _ ≤ 2 * (1 + x ^ 2)⁻¹ := by
          rw [← div_eq_mul_inv, le_div_iff₀ hden]
          linarith
    · have hxLarge : 1 < |x| := lt_of_not_ge hx
      have hx0 : x ≠ 0 := by
        intro h
        subst x
        norm_num at hxLarge
      have hsinc := abs_sinc_le_inv_abs hx0
      have hsPow : |Real.sinc x| ^ 4 ≤ |x|⁻¹ ^ 4 :=
        pow_le_pow_left₀ (abs_nonneg _) hsinc 4
      have hxPow : 0 < |x| ^ 4 := pow_pos (abs_pos.mpr hx0) 4
      have hden : 0 < 1 + x ^ 2 := by positivity
      have hfrac : (|x| ^ 4)⁻¹ ≤ 2 * (1 + x ^ 2)⁻¹ := by
        have hxSq : 1 ≤ x ^ 2 := by
          rw [← sq_abs]
          nlinarith
        have hmul : 0 ≤ x ^ 2 * (x ^ 2 - 1) :=
          mul_nonneg (sq_nonneg x) (sub_nonneg.mpr hxSq)
        calc
          (|x| ^ 4)⁻¹ = 1 / (|x| ^ 4) := by rw [one_div]
          _ ≤ 2 / (1 + x ^ 2) := by
            rw [div_le_div_iff₀ hxPow hden]
            rw [show |x| ^ 4 = (x ^ 2) ^ 2 by
              calc
                |x| ^ 4 = (|x| ^ 2) ^ 2 := by ring
                _ = (x ^ 2) ^ 2 := by rw [sq_abs]]
            nlinarith
          _ = 2 * (1 + x ^ 2)⁻¹ := by rw [div_eq_mul_inv]
      unfold sincFourthWeight
      rw [show Real.sinc x ^ 4 = |Real.sinc x| ^ 4 by
        rw [← abs_pow, abs_of_nonneg (by positivity)]]
      calc
        |Real.sinc x| ^ 4 ≤ |x|⁻¹ ^ 4 := hsPow
        _ = (|x| ^ 4)⁻¹ := by rw [inv_pow]
        _ ≤ 2 * (1 + x ^ 2)⁻¹ := hfrac

/-- The sinc-fourth kernel has a finite first absolute moment. -/
theorem integrable_abs_mul_sincFourthWeight :
    Integrable (fun x : ℝ => |x| * sincFourthWeight x) := by
  have hmajor : Integrable (fun x : ℝ => 2 * (1 + x ^ 2)⁻¹) :=
    integrable_inv_one_add_sq.const_mul 2
  apply hmajor.mono' (continuous_abs.mul continuous_sincFourthWeight).aestronglyMeasurable
  exact ae_of_all volume fun x => by
    change ‖|x| * sincFourthWeight x‖ ≤ 2 * (1 + x ^ 2)⁻¹
    rw [Real.norm_eq_abs, abs_of_nonneg
      (mul_nonneg (abs_nonneg x) (sincFourthWeight_nonneg x))]
    by_cases hx : |x| ≤ 1
    · have hs : sincFourthWeight x ≤ 1 := by
        unfold sincFourthWeight
        rw [show Real.sinc x ^ 4 = |Real.sinc x| ^ 4 by
          rw [← abs_pow, abs_of_nonneg (by positivity)]]
        exact pow_le_one₀ (abs_nonneg _) (Real.abs_sinc_le_one x)
      have hprod : |x| * sincFourthWeight x ≤ 1 := by
        nlinarith [sincFourthWeight_nonneg x, abs_nonneg x]
      have hxSq : x ^ 2 ≤ 1 := by
        rw [← sq_abs]
        nlinarith [abs_nonneg x]
      have hden : 0 < 1 + x ^ 2 := by positivity
      calc
        |x| * sincFourthWeight x ≤ 1 := hprod
        _ ≤ 2 * (1 + x ^ 2)⁻¹ := by
          rw [← div_eq_mul_inv, le_div_iff₀ hden]
          linarith
    · have hxLarge : 1 < |x| := lt_of_not_ge hx
      have hx0 : x ≠ 0 := by
        intro h
        subst x
        norm_num at hxLarge
      have hsinc := abs_sinc_le_inv_abs hx0
      have hsPow : |Real.sinc x| ^ 4 ≤ |x|⁻¹ ^ 4 :=
        pow_le_pow_left₀ (abs_nonneg _) hsinc 4
      have hxPow : 0 < |x| ^ 3 := pow_pos (abs_pos.mpr hx0) 3
      have hden : 0 < 1 + x ^ 2 := by positivity
      have hfrac : (|x| ^ 3)⁻¹ ≤ 2 * (1 + x ^ 2)⁻¹ := by
        have hxSq : 1 ≤ |x| ^ 2 := by nlinarith [abs_nonneg x]
        have hmul : 0 ≤ |x| ^ 2 * (|x| - 1) :=
          mul_nonneg (sq_nonneg |x|) (sub_nonneg.mpr hxLarge.le)
        have habsSq : |x| ^ 2 = x ^ 2 := sq_abs x
        calc
          (|x| ^ 3)⁻¹ = 1 / (|x| ^ 3) := by rw [one_div]
          _ ≤ 2 / (1 + x ^ 2) := by
            rw [div_le_div_iff₀ hxPow hden]
            nlinarith [hmul]
          _ = 2 * (1 + x ^ 2)⁻¹ := by rw [div_eq_mul_inv]
      unfold sincFourthWeight
      rw [show Real.sinc x ^ 4 = |Real.sinc x| ^ 4 by
        rw [← abs_pow, abs_of_nonneg (by positivity)]]
      calc
        |x| * |Real.sinc x| ^ 4 ≤ |x| * |x|⁻¹ ^ 4 :=
          mul_le_mul_of_nonneg_left hsPow (abs_nonneg x)
        _ = (|x| ^ 3)⁻¹ := by field_simp [abs_ne_zero.mpr hx0]
        _ ≤ 2 * (1 + x ^ 2)⁻¹ := hfrac

/-- Total mass of the unnormalized sinc-fourth density. -/
noncomputable def sincFourthMass : ℝ := ∫ x : ℝ, sincFourthWeight x

theorem sincFourthMass_pos : 0 < sincFourthMass := by
  unfold sincFourthMass
  exact integral_pos_of_integrable_nonneg_nonzero
    continuous_sincFourthWeight integrable_sincFourthWeight
    sincFourthWeight_nonneg (x := 0) (by norm_num [sincFourthWeight])

/-- The finite measure with density `sincFourthWeight` before normalization. -/
noncomputable def sincFourthBaseMeasure : Measure ℝ :=
  volume.withDensity (fun x => ENNReal.ofReal (sincFourthWeight x))

theorem sincFourthBaseMeasure_univ :
    sincFourthBaseMeasure Set.univ = ENNReal.ofReal sincFourthMass := by
  rw [sincFourthBaseMeasure, withDensity_apply _ MeasurableSet.univ,
    Measure.restrict_univ, ← ofReal_integral_eq_lintegral_ofReal
      integrable_sincFourthWeight
      (ae_of_all volume sincFourthWeight_nonneg)]
  rfl

/-- The normalized sinc-fourth probability kernel at its base spatial scale. -/
noncomputable def sincFourthKernel : Measure ℝ :=
  (sincFourthBaseMeasure Set.univ)⁻¹ • sincFourthBaseMeasure

theorem sincFourthKernel_isProbabilityMeasure :
    IsProbabilityMeasure sincFourthKernel := by
  constructor
  rw [sincFourthKernel, Measure.smul_apply, sincFourthBaseMeasure_univ,
    smul_eq_mul, ENNReal.inv_mul_cancel]
  · exact (ENNReal.ofReal_pos.mpr sincFourthMass_pos).ne'
  · exact ENNReal.ofReal_ne_top

theorem sincFourthBaseMeasure_absolutelyContinuous :
    sincFourthBaseMeasure ≪ volume := by
  exact withDensity_absolutelyContinuous volume _

theorem sincFourthKernel_absolutelyContinuous :
    sincFourthKernel ≪ volume := by
  unfold sincFourthKernel
  exact Measure.smul_absolutelyContinuous.trans
    sincFourthBaseMeasure_absolutelyContinuous

theorem integrable_abs_sincFourthBaseMeasure :
    Integrable (fun x : ℝ => |x|) sincFourthBaseMeasure := by
  rw [sincFourthBaseMeasure,
    integrable_withDensity_iff
      (continuous_sincFourthWeight.measurable.ennreal_ofReal)
      (ae_of_all volume fun _ => ENNReal.ofReal_lt_top)]
  simpa only [ENNReal.toReal_ofReal (sincFourthWeight_nonneg _),
    smul_eq_mul] using integrable_abs_mul_sincFourthWeight

theorem integrable_abs_sincFourthKernel :
    Integrable (fun x : ℝ => |x|) sincFourthKernel := by
  unfold sincFourthKernel
  apply integrable_abs_sincFourthBaseMeasure.smul_measure
  rw [ENNReal.inv_ne_top]
  simpa only [sincFourthBaseMeasure_univ] using
    (ENNReal.ofReal_pos.mpr sincFourthMass_pos).ne'

/-- First absolute moment of the normalized sinc-fourth kernel. -/
noncomputable def sincFourthFirstMoment : ℝ :=
  ∫ x : ℝ, |x| ∂sincFourthKernel

theorem sincFourthFirstMoment_nonneg : 0 ≤ sincFourthFirstMoment := by
  unfold sincFourthFirstMoment
  exact integral_nonneg fun _ => abs_nonneg _

/-- A fixed spatial radius for which each sinc-fourth tail has mass strictly
less than one quarter. -/
noncomputable def sincFourthTailRadius : ℝ :=
  4 * sincFourthFirstMoment + 1

theorem sincFourthTailRadius_pos : 0 < sincFourthTailRadius := by
  unfold sincFourthTailRadius
  exact add_pos_of_nonneg_of_pos
    (mul_nonneg (by norm_num) sincFourthFirstMoment_nonneg) zero_lt_one

theorem sincFourthKernel_rightTail_lt_quarter :
    sincFourthKernel.real (Ioi sincFourthTailRadius) < 1 / 4 := by
  letI : IsProbabilityMeasure sincFourthKernel :=
    sincFourthKernel_isProbabilityMeasure
  let M : ℝ := sincFourthFirstMoment
  let a : ℝ := sincFourthTailRadius
  have hM : 0 ≤ M := sincFourthFirstMoment_nonneg
  have ha : 0 < a := sincFourthTailRadius_pos
  have hMarkov :
      a * sincFourthKernel.real {x : ℝ | a ≤ |x|} ≤ M := by
    simpa only [M, a, sincFourthFirstMoment] using
      mul_meas_ge_le_integral_of_nonneg
        (ae_of_all sincFourthKernel fun x => abs_nonneg x)
        integrable_abs_sincFourthKernel a
  have hratio : M / a < 1 / 4 := by
    rw [div_lt_iff₀ ha]
    dsimp only [a, sincFourthTailRadius, M]
    nlinarith
  have hradial : sincFourthKernel.real {x : ℝ | a ≤ |x|} ≤ M / a := by
    rw [le_div_iff₀ ha]
    simpa only [mul_comm] using hMarkov
  have hsubset : Ioi a ⊆ {x : ℝ | a ≤ |x|} := by
    intro x hx
    exact hx.le.trans (le_abs_self x)
  exact (measureReal_mono hsubset).trans_lt (hradial.trans_lt hratio)

theorem sincFourthKernel_leftTail_lt_quarter :
    sincFourthKernel.real (Iio (-sincFourthTailRadius)) < 1 / 4 := by
  letI : IsProbabilityMeasure sincFourthKernel :=
    sincFourthKernel_isProbabilityMeasure
  let M : ℝ := sincFourthFirstMoment
  let a : ℝ := sincFourthTailRadius
  have hM : 0 ≤ M := sincFourthFirstMoment_nonneg
  have ha : 0 < a := sincFourthTailRadius_pos
  have hMarkov :
      a * sincFourthKernel.real {x : ℝ | a ≤ |x|} ≤ M := by
    simpa only [M, a, sincFourthFirstMoment] using
      mul_meas_ge_le_integral_of_nonneg
        (ae_of_all sincFourthKernel fun x => abs_nonneg x)
        integrable_abs_sincFourthKernel a
  have hratio : M / a < 1 / 4 := by
    rw [div_lt_iff₀ ha]
    dsimp only [a, sincFourthTailRadius, M]
    nlinarith
  have hradial : sincFourthKernel.real {x : ℝ | a ≤ |x|} ≤ M / a := by
    rw [le_div_iff₀ ha]
    simpa only [mul_comm] using hMarkov
  have hsubset : Iio (-a) ⊆ {x : ℝ | a ≤ |x|} := by
    intro x hx
    have hx' : x < -a := hx
    have hxneg : x < 0 := hx.trans_le (neg_nonpos.mpr ha.le)
    change a ≤ |x|
    rw [abs_of_neg hxneg]
    linarith [hx']
  exact (measureReal_mono hsubset).trans_lt (hradial.trans_lt hratio)

/-- Common upper bound for the two shifted first moments used in tail
absorption. -/
noncomputable def sincFourthShiftedMomentBound : ℝ :=
  sincFourthTailRadius + sincFourthFirstMoment

theorem sincFourthKernel_rightShiftedMoment_le :
    (∫ y, |sincFourthTailRadius - y| ∂sincFourthKernel) ≤
      sincFourthShiftedMomentBound := by
  letI : IsProbabilityMeasure sincFourthKernel :=
    sincFourthKernel_isProbabilityMeasure
  have hInt : Integrable (fun y : ℝ =>
      sincFourthTailRadius + |y|) sincFourthKernel :=
    (integrable_const sincFourthTailRadius).add integrable_abs_sincFourthKernel
  calc
    (∫ y, |sincFourthTailRadius - y| ∂sincFourthKernel) ≤
        ∫ y, (sincFourthTailRadius + |y|) ∂sincFourthKernel := by
      apply integral_mono
        ((integrable_const sincFourthTailRadius).sub
          (integrable_abs_sincFourthKernel.mono' (by fun_prop)
            (ae_of_all sincFourthKernel fun y => by
              rw [Real.norm_eq_abs]))).norm hInt
      intro y
      exact (abs_sub _ _).trans_eq <| by
        rw [abs_of_pos sincFourthTailRadius_pos]
    _ = sincFourthShiftedMomentBound := by
      simp [integral_add (integrable_const _) integrable_abs_sincFourthKernel,
        sincFourthShiftedMomentBound, sincFourthFirstMoment]

theorem sincFourthKernel_leftShiftedMoment_le :
    (∫ y, |-sincFourthTailRadius - y| ∂sincFourthKernel) ≤
      sincFourthShiftedMomentBound := by
  letI : IsProbabilityMeasure sincFourthKernel :=
    sincFourthKernel_isProbabilityMeasure
  have hLeftInt : Integrable (fun y : ℝ =>
      |-sincFourthTailRadius - y|) sincFourthKernel :=
    ((integrable_const (-sincFourthTailRadius)).sub
      (integrable_abs_sincFourthKernel.mono' (by fun_prop)
        (ae_of_all sincFourthKernel fun y => by
          rw [Real.norm_eq_abs]))).norm
  have hRightInt : Integrable (fun y : ℝ =>
      sincFourthTailRadius + |y|) sincFourthKernel :=
    (integrable_const sincFourthTailRadius).add integrable_abs_sincFourthKernel
  calc
    (∫ y, |-sincFourthTailRadius - y| ∂sincFourthKernel) ≤
        ∫ y, (sincFourthTailRadius + |y|) ∂sincFourthKernel := by
      apply integral_mono hLeftInt hRightInt
      intro y
      calc
        |-sincFourthTailRadius - y| ≤
            |-sincFourthTailRadius| + |y| := abs_sub _ _
        _ = sincFourthTailRadius + |y| := by
          rw [abs_neg, abs_of_pos sincFourthTailRadius_pos]
    _ = sincFourthShiftedMomentBound := by
      simp [integral_add (integrable_const _) integrable_abs_sincFourthKernel,
        sincFourthShiftedMomentBound, sincFourthFirstMoment]

/-- Convolution adds deterministic spatial support radii. -/
theorem isSupportedInSmoothingWindow_conv
    {κ η : Measure ℝ} {δ ε : ℝ} [SFinite η]
    (hκ : IsSupportedInSmoothingWindow κ δ)
    (hη : IsSupportedInSmoothingWindow η ε) :
    IsSupportedInSmoothingWindow (κ ∗ η) (δ + ε) := by
  unfold IsSupportedInSmoothingWindow at hκ hη ⊢
  unfold Measure.conv
  apply (ae_map_iff (by fun_prop) measurableSet_Icc).2
  refine (Measure.ae_prod_iff_ae_ae
    (measurableSet_Icc.preimage (by fun_prop :
      Measurable fun z : ℝ × ℝ => z.1 + z.2))).2 ?_
  filter_upwards [hκ] with x hx
  filter_upwards [hη] with y hy
  constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

/-- The sum of four independent uniform laws on `[-1,1]`. Its characteristic
function is the sinc-fourth spatial weight, while its spatial support supplies
the dual compact-frequency window for the Esseen kernel. -/
noncomputable def fourfoldUniformKernel : Measure ℝ :=
  let υ := uniformSmoothingKernel 1
  ((υ ∗ υ) ∗ υ) ∗ υ

theorem fourfoldUniformKernel_isProbabilityMeasure :
    IsProbabilityMeasure fourfoldUniformKernel := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel 1) :=
    uniformSmoothingKernel_isProbabilityMeasure (by norm_num)
  unfold fourfoldUniformKernel
  infer_instance

theorem fourfoldUniformKernel_supported :
    IsSupportedInSmoothingWindow fourfoldUniformKernel 4 := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel 1) :=
    uniformSmoothingKernel_isProbabilityMeasure (by norm_num)
  let hυ := uniformSmoothingKernel_supported 1
  unfold fourfoldUniformKernel
  convert isSupportedInSmoothingWindow_conv
    (isSupportedInSmoothingWindow_conv
      (isSupportedInSmoothingWindow_conv hυ hυ) hυ) hυ using 1
  norm_num

theorem charFun_fourfoldUniformKernel (t : ℝ) :
    MeasureTheory.charFun fourfoldUniformKernel t =
      (sincFourthWeight t : ℂ) := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel 1) :=
    uniformSmoothingKernel_isProbabilityMeasure (by norm_num)
  have hchar :
      MeasureTheory.charFun (uniformSmoothingKernel 1) t =
        (Real.sinc t : ℂ) := by
    simpa using charFun_uniformSmoothingKernel (δ := 1) (by norm_num) t
  unfold fourfoldUniformKernel
  rw [MeasureTheory.charFun_conv, MeasureTheory.charFun_conv,
    MeasureTheory.charFun_conv, hchar]
  simp only [sincFourthWeight, Complex.ofReal_pow]
  ring

/-- Lebesgue density of the uniform probability law on `[-1,1]`. -/
noncomputable def uniformUnitDensity (x : ℝ) : ℝ≥0∞ :=
  (Icc (-1 : ℝ) 1).indicator (fun _ => (2 : ℝ≥0∞)⁻¹) x

/-- The triangular density of the sum of two independent uniform laws on
`[-1,1]`, kept in `ℝ≥0∞` form for measure convolution. -/
noncomputable def twofoldUniformDensity (x : ℝ) : ℝ≥0∞ :=
  (2 : ℝ≥0∞)⁻¹ * (2 : ℝ≥0∞)⁻¹ *
    ENNReal.ofReal (max (2 - |x|) 0)

theorem uniformUnitDensity_lconvolution_self (x : ℝ) :
    (uniformUnitDensity ⋆ₗ[volume] uniformUnitDensity) x =
      twofoldUniformDensity x := by
  have hmem (y : ℝ) :
      -y + x ∈ Icc (-1 : ℝ) 1 ↔
        y ∈ Icc (x - 1) (x + 1) := by
    constructor <;> intro h <;> constructor <;> linarith [h.1, h.2]
  have hfun :
      (fun y : ℝ => uniformUnitDensity y * uniformUnitDensity (-y + x)) =
        (Icc (-1 : ℝ) 1 ∩ Icc (x - 1) (x + 1)).indicator
          (fun _ => (2 : ℝ≥0∞)⁻¹ * (2 : ℝ≥0∞)⁻¹) := by
    funext y
    by_cases hy : y ∈ Icc (-1 : ℝ) 1 <;>
      by_cases hxy : y ∈ Icc (x - 1) (x + 1) <;>
      simp [uniformUnitDensity, hy, hxy, hmem y]
  rw [MeasureTheory.lconvolution_def, hfun,
    lintegral_indicator (measurableSet_Icc.inter measurableSet_Icc)]
  simp only [setLIntegral_const, Set.Icc_inter_Icc, Real.volume_Icc]
  unfold twofoldUniformDensity
  congr 1
  by_cases hx0 : x ≤ 0
  · by_cases hxm : x < -2
    · have : x + 1 < -1 := by linarith
      simp [max_eq_left (by linarith : (-1 : ℝ) ≥ x - 1), abs_of_nonpos hx0]
      rw [min_eq_right (by linarith : x + 1 ≤ (1 : ℝ))]
      simp [ENNReal.ofReal_eq_zero.mpr (by linarith : x + 1 + 1 ≤ 0),
        ENNReal.ofReal_eq_zero.mpr (by linarith : 2 + x ≤ 0)]
    · have hx2 : -2 ≤ x := le_of_not_gt hxm
      have hmax : max (-1 : ℝ) (x - 1) = -1 := max_eq_left (by linarith)
      have hmin : min (1 : ℝ) (x + 1) = x + 1 := min_eq_right (by linarith)
      rw [hmax, hmin, abs_of_nonpos hx0]
      congr 1
      rw [max_eq_left (by linarith)]
      ring
  · have hx0' : 0 ≤ x := le_of_not_ge hx0
    by_cases hx2 : 2 < x
    · have : 1 < x - 1 := by linarith
      simp [min_eq_left (by linarith : (1 : ℝ) ≤ x + 1), abs_of_nonneg hx0']
      rw [max_eq_right (by linarith : (-1 : ℝ) ≤ x - 1)]
      simp [ENNReal.ofReal_eq_zero.mpr (by linarith : 1 - (x - 1) ≤ 0),
        ENNReal.ofReal_eq_zero.mpr (by linarith : 2 - x ≤ 0)]
    · have hx2' : x ≤ 2 := le_of_not_gt hx2
      have hmax : max (-1 : ℝ) (x - 1) = x - 1 := max_eq_right (by linarith)
      have hmin : min (1 : ℝ) (x + 1) = 1 := min_eq_left (by linarith)
      rw [hmax, hmin, abs_of_nonneg hx0']
      congr 1
      rw [max_eq_left (by linarith)]
      ring

theorem measurable_uniformUnitDensity : Measurable uniformUnitDensity := by
  exact measurable_const.indicator measurableSet_Icc

theorem uniformSmoothingKernel_one_eq_withDensity :
    uniformSmoothingKernel 1 = volume.withDensity uniformUnitDensity := by
  unfold uniformSmoothingKernel
  calc
    (ENNReal.ofReal (2 * (1 : ℝ)))⁻¹ • volume.restrict (Icc (-1 : ℝ) 1) =
        (ENNReal.ofReal 2)⁻¹ •
          volume.withDensity ((Icc (-1 : ℝ) 1).indicator 1) := by
      rw [withDensity_indicator_one measurableSet_Icc]
      norm_num
    _ = volume.withDensity
        ((ENNReal.ofReal 2)⁻¹ • (Icc (-1 : ℝ) 1).indicator 1) := by
      rw [withDensity_smul]
      exact measurable_const.indicator measurableSet_Icc
    _ = volume.withDensity uniformUnitDensity := by
      congr 1
      funext x
      by_cases hx : x ∈ Icc (-1 : ℝ) 1 <;>
        simp [uniformUnitDensity, Pi.smul_apply, smul_eq_mul, hx]

/-- Real-valued triangular density `max (2 - |x|) 0 / 4`. -/
noncomputable def twofoldUniformDensityReal (x : ℝ) : ℝ :=
  max (2 - |x|) 0 / 4

theorem twofoldUniformDensity_toReal (x : ℝ) :
    (twofoldUniformDensity x).toReal = twofoldUniformDensityReal x := by
  simp only [twofoldUniformDensity, ENNReal.toReal_mul, ENNReal.toReal_inv,
    ENNReal.toReal_ofNat,
    ENNReal.toReal_ofReal (le_max_right (2 - |x|) 0)]
  unfold twofoldUniformDensityReal
  norm_num
  ring

theorem measurable_twofoldUniformDensity :
    Measurable twofoldUniformDensity := by
  unfold twofoldUniformDensity
  fun_prop

theorem continuous_twofoldUniformDensityReal :
    Continuous twofoldUniformDensityReal := by
  unfold twofoldUniformDensityReal
  fun_prop

theorem twofoldUniformDensityReal_nonneg (x : ℝ) :
    0 ≤ twofoldUniformDensityReal x := by
  unfold twofoldUniformDensityReal
  positivity

theorem support_twofoldUniformDensityReal_subset :
    Function.support twofoldUniformDensityReal ⊆ Icc (-2 : ℝ) 2 := by
  intro x hx
  change twofoldUniformDensityReal x ≠ 0 at hx
  constructor
  · by_contra h
    have hlt : x < -2 := lt_of_not_ge h
    have hxneg : x < 0 := by linarith
    have hinner : 2 - |x| ≤ 0 := by rw [abs_of_neg hxneg]; linarith
    simp [twofoldUniformDensityReal, max_eq_right hinner] at hx
  · by_contra h
    have hlt : 2 < x := lt_of_not_ge h
    have hxpos : 0 ≤ x := by linarith
    have hinner : 2 - |x| ≤ 0 := by rw [abs_of_nonneg hxpos]; linarith
    simp [twofoldUniformDensityReal, max_eq_right hinner] at hx

theorem hasCompactSupport_twofoldUniformDensityReal :
    HasCompactSupport twofoldUniformDensityReal :=
  HasCompactSupport.of_support_subset_isCompact isCompact_Icc
    support_twofoldUniformDensityReal_subset

theorem integrable_twofoldUniformDensityReal :
    Integrable twofoldUniformDensityReal :=
  continuous_twofoldUniformDensityReal.integrable_of_hasCompactSupport
    hasCompactSupport_twofoldUniformDensityReal

/-- Continuous compactly supported density of the fourfold uniform sum. -/
noncomputable def fourfoldUniformDensity : ℝ → ℝ :=
  twofoldUniformDensityReal ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] twofoldUniformDensityReal

theorem continuous_fourfoldUniformDensity :
    Continuous fourfoldUniformDensity := by
  unfold fourfoldUniformDensity
  exact hasCompactSupport_twofoldUniformDensityReal.continuous_convolution_right
    (ContinuousLinearMap.mul ℝ ℝ)
    continuous_twofoldUniformDensityReal.locallyIntegrable
    continuous_twofoldUniformDensityReal

theorem integrable_fourfoldUniformDensity :
    Integrable fourfoldUniformDensity := by
  unfold fourfoldUniformDensity
  exact integrable_twofoldUniformDensityReal.integrable_convolution
    (ContinuousLinearMap.mul ℝ ℝ) integrable_twofoldUniformDensityReal

theorem fourfoldUniformDensity_nonneg (x : ℝ) :
    0 ≤ fourfoldUniformDensity x := by
  rw [fourfoldUniformDensity, convolution_mul]
  exact integral_nonneg fun y => mul_nonneg
    (twofoldUniformDensityReal_nonneg y)
    (twofoldUniformDensityReal_nonneg (x - y))

theorem support_fourfoldUniformDensity_subset :
    Function.support fourfoldUniformDensity ⊆ Icc (-4 : ℝ) 4 := by
  refine (support_convolution_subset
    (ContinuousLinearMap.mul ℝ ℝ)).trans ?_
  rintro x ⟨a, ha, b, hb, rfl⟩
  have ha' := support_twofoldUniformDensityReal_subset ha
  have hb' := support_twofoldUniformDensityReal_subset hb
  constructor <;> linarith [ha'.1, ha'.2, hb'.1, hb'.2]

theorem hasCompactSupport_fourfoldUniformDensity :
    HasCompactSupport fourfoldUniformDensity :=
  HasCompactSupport.of_support_subset_isCompact isCompact_Icc
    support_fourfoldUniformDensity_subset

theorem twofoldUniformDensity_lconvolution_self (x : ℝ) :
    (twofoldUniformDensity ⋆ₗ[volume] twofoldUniformDensity) x =
      ENNReal.ofReal (fourfoldUniformDensity x) := by
  have hconv : Integrable (fun y : ℝ =>
      twofoldUniformDensityReal y * twofoldUniformDensityReal (x - y)) :=
    (hasCompactSupport_twofoldUniformDensityReal.convolutionExists_right
      (ContinuousLinearMap.mul ℝ ℝ)
      continuous_twofoldUniformDensityReal.locallyIntegrable
      continuous_twofoldUniformDensityReal x)
  rw [MeasureTheory.lconvolution_def, fourfoldUniformDensity,
    convolution_mul,
    ofReal_integral_eq_lintegral_ofReal hconv
      (ae_of_all volume fun y => mul_nonneg
        (twofoldUniformDensityReal_nonneg y)
        (twofoldUniformDensityReal_nonneg (x - y)))]
  apply lintegral_congr
  intro y
  have harg : -y + x = x - y := by ring
  rw [harg, ← twofoldUniformDensity_toReal,
    ← twofoldUniformDensity_toReal]
  rw [ENNReal.ofReal_mul ENNReal.toReal_nonneg]
  rw [ENNReal.ofReal_toReal (by unfold twofoldUniformDensity; finiteness)]
  rw [ENNReal.ofReal_toReal (by unfold twofoldUniformDensity; finiteness)]

theorem uniformSmoothingKernel_conv_self_eq_withDensity :
    uniformSmoothingKernel 1 ∗ uniformSmoothingKernel 1 =
      volume.withDensity twofoldUniformDensity := by
  rw [uniformSmoothingKernel_one_eq_withDensity,
    conv_withDensity_eq_lconvolution measurable_uniformUnitDensity
      measurable_uniformUnitDensity]
  congr 1
  funext x
  exact uniformUnitDensity_lconvolution_self x

theorem fourfoldUniformKernel_eq_withDensity :
    fourfoldUniformKernel =
      volume.withDensity (fun x => ENNReal.ofReal (fourfoldUniformDensity x)) := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel 1) :=
    uniformSmoothingKernel_isProbabilityMeasure (by norm_num)
  unfold fourfoldUniformKernel
  rw [Measure.conv_assoc, uniformSmoothingKernel_conv_self_eq_withDensity,
    conv_withDensity_eq_lconvolution measurable_twofoldUniformDensity
      measurable_twofoldUniformDensity]
  congr 1
  funext x
  exact twofoldUniformDensity_lconvolution_self x

/-- Complex-valued form of `fourfoldUniformDensity` for Fourier inversion. -/
noncomputable def fourfoldUniformDensityComplex (x : ℝ) : ℂ :=
  fourfoldUniformDensity x

theorem continuous_fourfoldUniformDensityComplex :
    Continuous fourfoldUniformDensityComplex := by
  exact Complex.continuous_ofReal.comp continuous_fourfoldUniformDensity

theorem integrable_fourfoldUniformDensityComplex :
    Integrable fourfoldUniformDensityComplex :=
  integrable_fourfoldUniformDensity.ofReal

theorem sincFourthWeight_eq_fourierInv_fourfoldUniformDensityComplex (t : ℝ) :
    (sincFourthWeight t : ℂ) =
      𝓕⁻ fourfoldUniformDensityComplex (t / (2 * Real.pi)) := by
  letI : IsProbabilityMeasure fourfoldUniformKernel :=
    fourfoldUniformKernel_isProbabilityMeasure
  rw [← charFun_fourfoldUniformKernel t,
    fourfoldUniformKernel_eq_withDensity,
    MeasureTheory.charFun_apply_real,
    integral_withDensity_eq_integral_toReal_smul
      (continuous_fourfoldUniformDensity.measurable.ennreal_ofReal)
      (ae_of_all volume fun _ => ENNReal.ofReal_lt_top)
      (fun x : ℝ => Complex.exp ((t : ℂ) * (x : ℂ) * Complex.I)),
    Real.fourierInv_eq']
  apply integral_congr_ae
  exact ae_of_all volume fun x => by
    dsimp only
    rw [ENNReal.toReal_ofReal (fourfoldUniformDensity_nonneg x)]
    change (fourfoldUniformDensity x : ℂ) *
        Complex.exp ((t : ℂ) * (x : ℂ) * Complex.I) =
      Complex.exp (((2 * Real.pi * inner ℝ x (t / (2 * Real.pi)) : ℝ) : ℂ) *
        Complex.I) * (fourfoldUniformDensity x : ℂ)
    rw [mul_comm]
    congr 2
    congr 1
    norm_cast
    rw [real_inner_eq_re_inner (𝕜 := ℝ)]
    simp only [RCLike.inner_apply, conj_trivial]
    have hre (z : ℝ) : RCLike.re z = z := rfl
    rw [hre]
    field_simp [Real.pi_ne_zero]

theorem fourierInv_fourfoldUniformDensityComplex_eq_sincFourthWeight (w : ℝ) :
    𝓕⁻ fourfoldUniformDensityComplex w =
      (sincFourthWeight ((2 * Real.pi) * w) : ℂ) := by
  rw [sincFourthWeight_eq_fourierInv_fourfoldUniformDensityComplex]
  field_simp [Real.pi_ne_zero]

theorem integrable_fourierInv_fourfoldUniformDensityComplex :
    Integrable (𝓕⁻ fourfoldUniformDensityComplex) := by
  have htwoPi : (2 * Real.pi : ℝ) ≠ 0 :=
    mul_ne_zero (by norm_num) Real.pi_ne_zero
  have hbase : Integrable (fun w : ℝ => (sincFourthWeight w : ℂ)) :=
    integrable_sincFourthWeight.ofReal
  have hscaled : Integrable (fun w : ℝ =>
      (sincFourthWeight ((2 * Real.pi) * w) : ℂ)) :=
    hbase.comp_mul_left' htwoPi
  exact hscaled.congr (ae_of_all volume fun w =>
    (fourierInv_fourfoldUniformDensityComplex_eq_sincFourthWeight w).symm)

theorem fourier_fourfoldUniformDensityComplex_eq_sincFourthWeight (w : ℝ) :
    𝓕 fourfoldUniformDensityComplex w =
      (sincFourthWeight ((-2 * Real.pi) * w) : ℂ) := by
  calc
    𝓕 fourfoldUniformDensityComplex w =
        𝓕⁻ fourfoldUniformDensityComplex (-w) := by
      symm
      simpa using Real.fourierInv_eq_fourier_neg
        fourfoldUniformDensityComplex (-w)
    _ = (sincFourthWeight ((2 * Real.pi) * (-w)) : ℂ) :=
      fourierInv_fourfoldUniformDensityComplex_eq_sincFourthWeight (-w)
    _ = (sincFourthWeight ((-2 * Real.pi) * w) : ℂ) := by
      congr 2
      ring

theorem integrable_fourier_fourfoldUniformDensityComplex :
    Integrable (𝓕 fourfoldUniformDensityComplex) := by
  have hnegTwoPi : (-2 * Real.pi : ℝ) ≠ 0 :=
    mul_ne_zero (by norm_num : (-2 : ℝ) ≠ 0) Real.pi_ne_zero
  have hbase : Integrable (fun w : ℝ => (sincFourthWeight w : ℂ)) :=
    integrable_sincFourthWeight.ofReal
  have hscaled : Integrable (fun w : ℝ =>
      (sincFourthWeight ((-2 * Real.pi) * w) : ℂ)) :=
    hbase.comp_mul_left' hnegTwoPi
  exact hscaled.congr (ae_of_all volume fun w =>
    (fourier_fourfoldUniformDensityComplex_eq_sincFourthWeight w).symm)

theorem fourier_fourierInv_fourfoldUniformDensityComplex :
    𝓕 (𝓕⁻ fourfoldUniformDensityComplex) = fourfoldUniformDensityComplex :=
  continuous_fourfoldUniformDensityComplex.fourier_fourierInv_eq
    integrable_fourfoldUniformDensityComplex
    integrable_fourier_fourfoldUniformDensityComplex

theorem integral_eq_mul_integral_comp_mul_left
    (g : ℝ → ℂ) {a : ℝ} (ha : 0 < a) :
    (∫ x : ℝ, g x) = a • ∫ x : ℝ, g (a * x) := by
  rw [Measure.integral_comp_mul_left g a,
    abs_of_pos (inv_pos.mpr ha)]
  rw [Complex.real_smul]
  have haC : (a : ℂ) ≠ 0 := by
    exact_mod_cast ha.ne'
  change (∫ x : ℝ, g x) =
    (a : ℂ) * ((a⁻¹ : ℝ) • ∫ x : ℝ, g x)
  rw [@Complex.real_smul (a⁻¹) (∫ x : ℝ, g x)]
  rw [← mul_assoc]
  rw [← Complex.ofReal_mul, mul_inv_cancel₀ ha.ne']
  simp

theorem integral_cexp_mul_sincFourthWeight_eq_density (s : ℝ) :
    (∫ x : ℝ, Complex.exp ((s : ℂ) * (x : ℂ) * Complex.I) *
        (sincFourthWeight x : ℂ)) =
      (2 * Real.pi) • (fourfoldUniformDensityComplex (-s)) := by
  let g : ℝ → ℂ := fun x =>
    Complex.exp ((s : ℂ) * (x : ℂ) * Complex.I) *
      (sincFourthWeight x : ℂ)
  calc
    (∫ x : ℝ, Complex.exp ((s : ℂ) * (x : ℂ) * Complex.I) *
        (sincFourthWeight x : ℂ)) = ∫ x : ℝ, g x := rfl
    _ = (2 * Real.pi) • ∫ w : ℝ, g ((2 * Real.pi) * w) :=
      integral_eq_mul_integral_comp_mul_left g Real.two_pi_pos
    _ = (2 * Real.pi) • 𝓕 (𝓕⁻ fourfoldUniformDensityComplex) (-s) := by
      congr 1
      rw [Real.fourier_eq']
      apply integral_congr_ae
      exact ae_of_all volume fun w => by
        dsimp only [g]
        rw [fourierInv_fourfoldUniformDensityComplex_eq_sincFourthWeight]
        congr 1
        congr 1
        congr 1
        norm_cast
        rw [real_inner_eq_re_inner (𝕜 := ℝ)]
        simp only [RCLike.inner_apply, conj_trivial]
        have hre (z : ℝ) : RCLike.re z = z := rfl
        rw [hre]
        norm_num
        ring
    _ = (2 * Real.pi) • fourfoldUniformDensityComplex (-s) := by
      rw [fourier_fourierInv_fourfoldUniformDensityComplex]

theorem charFun_sincFourthKernel (s : ℝ) :
    MeasureTheory.charFun sincFourthKernel s =
      (sincFourthMass⁻¹ : ℝ) •
        ∫ x : ℝ, Complex.exp ((s : ℂ) * (x : ℂ) * Complex.I) *
          (sincFourthWeight x : ℂ) := by
  letI : IsProbabilityMeasure sincFourthKernel :=
    sincFourthKernel_isProbabilityMeasure
  rw [MeasureTheory.charFun_apply_real, sincFourthKernel,
    integral_smul_measure, ENNReal.toReal_inv,
    sincFourthBaseMeasure_univ, ENNReal.toReal_ofReal sincFourthMass_pos.le,
    sincFourthBaseMeasure,
    integral_withDensity_eq_integral_toReal_smul
      (continuous_sincFourthWeight.measurable.ennreal_ofReal)
      (ae_of_all volume fun _ => ENNReal.ofReal_lt_top)
      (fun x : ℝ => Complex.exp ((s : ℂ) * (x : ℂ) * Complex.I))]
  congr 1
  apply integral_congr_ae
  exact ae_of_all volume fun x => by
    dsimp only
    rw [ENNReal.toReal_ofReal (sincFourthWeight_nonneg x)]
    change (sincFourthWeight x : ℂ) *
        Complex.exp ((s : ℂ) * (x : ℂ) * Complex.I) =
      Complex.exp ((s : ℂ) * (x : ℂ) * Complex.I) *
        (sincFourthWeight x : ℂ)
    rw [mul_comm]

theorem charFun_sincFourthKernel_eq_density (s : ℝ) :
    MeasureTheory.charFun sincFourthKernel s =
      (sincFourthMass⁻¹ * (2 * Real.pi)) •
        fourfoldUniformDensityComplex (-s) := by
  rw [charFun_sincFourthKernel,
    integral_cexp_mul_sincFourthWeight_eq_density]
  simp only [Complex.real_smul]
  push_cast
  ring

theorem sincFourthKernel_charFun_supported :
    IsCharFunSupportedInFrequencyWindow sincFourthKernel 4 := by
  intro s hs
  rw [charFun_sincFourthKernel_eq_density]
  have hnot : -s ∉ Icc (-4 : ℝ) 4 := by
    intro h
    have habs : |s| ≤ 4 := (abs_le).2 ⟨by linarith [h.2], by linarith [h.1]⟩
    linarith
  have hzero : fourfoldUniformDensityComplex (-s) = 0 := by
    unfold fourfoldUniformDensityComplex
    norm_cast
    by_contra hne
    exact hnot (support_fourfoldUniformDensity_subset hne)
  rw [hzero]
  simp

/-- The unit-scale reflected Prawitz point kernel is exactly the
sinc-squared Fejér profile. -/
theorem prawitzPointKernel_add_neg_eq_sinc_sq (z : ℝ) :
    prawitzPointKernel 1 z + prawitzPointKernel 1 (-z) =
      Real.sinc (z / 2) ^ 2 := by
  rw [prawitzPointKernel_add_neg]
  by_cases hz : z = 0
  · subst z
    simp [Real.sinc]
  · rw [if_neg hz, Real.sinc, if_neg (div_ne_zero hz (by norm_num))]
    have hrewrite : z = 2 * (z / 2) := by ring
    rw [hrewrite, Real.cos_two_mul]
    field_simp [hz]
    nlinarith [Real.sin_sq_add_cos_sq (z / 2)]

theorem prawitzPointKernel_add_neg_scale_eq_sinc_sq
    {T : ℝ} (hT : 0 < T) (z : ℝ) :
    prawitzPointKernel T z + prawitzPointKernel T (-z) =
      Real.sinc (T * z / 2) ^ 2 := by
  rw [prawitzPointKernel_scale hT, prawitzPointKernel_scale hT,
    show T * -z = -(T * z) by ring,
    prawitzPointKernel_add_neg_eq_sinc_sq]

theorem prawitzPointKernel_reflection_eq_sinc_sq
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    prawitzPointKernel T (y - x) + prawitzPointKernel T (x - y) =
      Real.sinc (T * (y - x) / 2) ^ 2 := by
  rw [show x - y = -(y - x) by ring,
    prawitzPointKernel_add_neg_scale_eq_sinc_sq hT]

/-- The total bidirectional pointwise slack is exactly twice the translated
sinc-squared Fejér profile. -/
theorem prawitzUpperSlack_add_lowerSlack_eq_two_mul_sinc_sq
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    prawitzUpperSlack T x y + prawitzLowerSlack T x y =
      2 * Real.sinc (T * (y - x) / 2) ^ 2 := by
  rw [← prawitzPointKernel_reflection_eq_sinc_sq hT x y]
  unfold prawitzUpperSlack prawitzLowerSlack
  ring

/-- The total expected bidirectional slack is exactly twice the law's
translated sinc-squared mass. -/
theorem integral_prawitzUpperSlack_add_lowerSlack_eq_two_mul_sinc_sq
    (mu : Measure ℝ) [IsFiniteMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ)
    (hForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    (∫ y, prawitzUpperSlack T x y ∂mu) +
        ∫ y, prawitzLowerSlack T x y ∂mu =
      2 * ∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu := by
  have hUpper := integrable_prawitzUpperSlack mu x hForward
  have hLower := integrable_prawitzLowerSlack mu x hReflected
  calc
    _ = ∫ y, prawitzUpperSlack T x y + prawitzLowerSlack T x y ∂mu :=
      (integral_add hUpper hLower).symm
    _ = ∫ y, 2 * Real.sinc (T * (y - x) / 2) ^ 2 ∂mu := by
      apply integral_congr_ae
      exact ae_of_all _
        (prawitzUpperSlack_add_lowerSlack_eq_two_mul_sinc_sq hT x)
    _ = _ := by rw [integral_const_mul]

/-- For two laws, the sum of the two one-sided slack differences is exactly
twice their translated sinc-squared mass difference. -/
theorem prawitzSlackDifference_add_eq_two_mul_sincMassDifference
    (mu nu : Measure ℝ) [IsFiniteMeasure mu] [IsFiniteMeasure nu]
    {T : ℝ} (hT : 0 < T) (x : ℝ)
    (hmuForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hmuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu)
    (hnuForward : Integrable (fun y => prawitzPointKernel T (y - x)) nu)
    (hnuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) nu) :
    ((∫ y, prawitzUpperSlack T x y ∂mu) -
        ∫ y, prawitzUpperSlack T x y ∂nu) +
      ((∫ y, prawitzLowerSlack T x y ∂mu) -
        ∫ y, prawitzLowerSlack T x y ∂nu) =
      2 * ((∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu) -
        ∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂nu) := by
  have hmu :=
    integral_prawitzUpperSlack_add_lowerSlack_eq_two_mul_sinc_sq
      mu hT x hmuForward hmuReflected
  have hnu :=
    integral_prawitzUpperSlack_add_lowerSlack_eq_two_mul_sinc_sq
      nu hT x hnuForward hnuReflected
  linarith

/-- Signed half-difference controlling how the fixed sinc-squared slack mass
is divided between the upper and lower Prawitz bounds. -/
noncomputable def prawitzSlackImbalance (T x y : ℝ) : ℝ :=
  (prawitzUpperSlack T x y - prawitzLowerSlack T x y) / 2

/-- The signed imbalance is exactly the antisymmetric point-kernel component
minus the centered lower-ray step. -/
theorem prawitzSlackImbalance_eq_pointKernel_sub_reflected_sub_centeredStep
    (T x y : ℝ) :
    prawitzSlackImbalance T x y =
      prawitzPointKernel T (y - x) - prawitzPointKernel T (x - y) -
        (2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1) := by
  unfold prawitzSlackImbalance prawitzUpperSlack prawitzLowerSlack
  ring

/-- The slack imbalance depends on the spatial variables only through their
displacement. -/
theorem prawitzSlackImbalance_translate (T x y : ℝ) :
    prawitzSlackImbalance T x y =
      prawitzSlackImbalance T 0 (y - x) := by
  rw [prawitzSlackImbalance_eq_pointKernel_sub_reflected_sub_centeredStep,
    prawitzSlackImbalance_eq_pointKernel_sub_reflected_sub_centeredStep]
  by_cases hy : y ≤ x
  · have hz : y - x ≤ 0 := sub_nonpos.mpr hy
    simp [hy, hz]
  · have hz : ¬y - x ≤ 0 := by linarith
    simp [hy, hz]

/-- Positive frequency scaling reduces the translated imbalance to its
universal unit-window profile. -/
theorem prawitzSlackImbalance_scale
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    prawitzSlackImbalance T x y =
      prawitzSlackImbalance 1 0 (T * (y - x)) := by
  rw [prawitzSlackImbalance_translate T x y,
    prawitzSlackImbalance_eq_pointKernel_sub_reflected_sub_centeredStep,
    prawitzSlackImbalance_eq_pointKernel_sub_reflected_sub_centeredStep,
    prawitzPointKernel_scale hT]
  rw [show 0 - (y - x) = -(y - x) by ring,
    prawitzPointKernel_scale hT]
  rw [show T * (-(y - x)) = -(T * (y - x)) by ring]
  by_cases hz : y - x ≤ 0
  · have hTz : T * (y - x) ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hT.le hz
    simp [hz, hTz]
  · have hzpos : 0 < y - x := lt_of_not_ge hz
    have hTzpos : 0 < T * (y - x) := mul_pos hT hzpos
    simp [not_le.mpr hzpos, not_le.mpr hTzpos]

/-- At the CDF jump itself, the right-continuous convention assigns the full
unit signed imbalance to the lower Prawitz slack. -/
theorem prawitzSlackImbalance_diagonal (T x : ℝ) :
    prawitzSlackImbalance T x x = -1 := by
  rw [prawitzSlackImbalance_eq_pointKernel_sub_reflected_sub_centeredStep]
  simp
  norm_num

/-- To the right of the CDF evaluation point, the imbalance is the
antisymmetric point-kernel component plus one. -/
theorem prawitzSlackImbalance_of_lt
    (T : ℝ) {x y : ℝ} (hxy : x < y) :
    prawitzSlackImbalance T x y =
      prawitzPointKernel T (y - x) - prawitzPointKernel T (x - y) + 1 := by
  rw [prawitzSlackImbalance_eq_pointKernel_sub_reflected_sub_centeredStep]
  simp [not_le.mpr hxy]

/-- On and to the left of the CDF evaluation point, the imbalance is the
antisymmetric point-kernel component minus one. -/
theorem prawitzSlackImbalance_of_le
    (T : ℝ) {x y : ℝ} (hyx : y ≤ x) :
    prawitzSlackImbalance T x y =
      prawitzPointKernel T (y - x) - prawitzPointKernel T (x - y) - 1 := by
  rw [prawitzSlackImbalance_eq_pointKernel_sub_reflected_sub_centeredStep]
  simp [hyx]
  norm_num

/-- The universal imbalance profile vanishes at the first negative Fourier
lattice point. -/
theorem prawitzSlackImbalance_neg_two_pi :
    prawitzSlackImbalance 1 0 (-2 * Real.pi) = 0 := by
  have hle : -2 * Real.pi ≤ 0 := by nlinarith [Real.pi_pos]
  rw [prawitzSlackImbalance_of_le 1 hle, sub_zero, zero_sub]
  rw [show -(-2 * Real.pi) = 2 * Real.pi by ring,
    prawitzPointKernel_neg_two_pi, prawitzPointKernel_two_pi]
  ring

/-- The universal imbalance profile also vanishes at the reflected first
Fourier lattice point. -/
theorem prawitzSlackImbalance_two_pi :
    prawitzSlackImbalance 1 0 (2 * Real.pi) = 0 := by
  have hlt : 0 < 2 * Real.pi := by positivity
  rw [prawitzSlackImbalance_of_lt 1 hlt, sub_zero, zero_sub]
  rw [show -(2 * Real.pi) = -2 * Real.pi by ring,
    prawitzPointKernel_two_pi, prawitzPointKernel_neg_two_pi]
  ring

/-- The three certified values around the CDF jump already contribute two to
the variation of the universal imbalance profile. -/
theorem prawitzSlackImbalance_threePointVariation :
    |prawitzSlackImbalance 1 0 (-2 * Real.pi) -
        prawitzSlackImbalance 1 0 0| +
      |prawitzSlackImbalance 1 0 0 -
        prawitzSlackImbalance 1 0 (2 * Real.pi)| = 2 := by
  rw [prawitzSlackImbalance_neg_two_pi,
    prawitzSlackImbalance_diagonal,
    prawitzSlackImbalance_two_pi]
  norm_num

/-- Consequently, every proposed variation majorant for these three
increments has coefficient at least two. -/
theorem two_le_of_prawitzSlackImbalance_threePointVariation_le
    {C : ℝ}
    (hC : |prawitzSlackImbalance 1 0 (-2 * Real.pi) -
          prawitzSlackImbalance 1 0 0| +
        |prawitzSlackImbalance 1 0 0 -
          prawitzSlackImbalance 1 0 (2 * Real.pi)| ≤ C) :
    2 ≤ C := by
  rw [prawitzSlackImbalance_threePointVariation] at hC
  exact hC

/-- At every positive bandwidth, the imbalance vanishes one first-lattice
spacing to the left of the spatial center. -/
theorem prawitzSlackImbalance_left_latticePoint
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    prawitzSlackImbalance T x (x - 2 * Real.pi / T) = 0 := by
  rw [prawitzSlackImbalance_scale hT]
  convert prawitzSlackImbalance_neg_two_pi using 1
  field_simp [hT.ne']
  ring

/-- At every positive bandwidth, the imbalance vanishes one first-lattice
spacing to the right of the spatial center. -/
theorem prawitzSlackImbalance_right_latticePoint
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    prawitzSlackImbalance T x (x + 2 * Real.pi / T) = 0 := by
  rw [prawitzSlackImbalance_scale hT]
  convert prawitzSlackImbalance_two_pi using 1
  field_simp [hT.ne']
  ring

/-- The coefficient-two variation obstruction is invariant under positive
bandwidth scaling and spatial translation. -/
theorem prawitzSlackImbalance_threePointVariation_scaled
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    |prawitzSlackImbalance T x (x - 2 * Real.pi / T) -
        prawitzSlackImbalance T x x| +
      |prawitzSlackImbalance T x x -
        prawitzSlackImbalance T x (x + 2 * Real.pi / T)| = 2 := by
  rw [prawitzSlackImbalance_left_latticePoint hT,
    prawitzSlackImbalance_diagonal,
    prawitzSlackImbalance_right_latticePoint hT]
  norm_num

/-- No bandwidth-dependent variation majorant for these three increments can
have coefficient strictly below two. -/
theorem two_le_of_prawitzSlackImbalance_threePointVariation_scaled_le
    {T : ℝ} (hT : 0 < T) (x C : ℝ)
    (hC : |prawitzSlackImbalance T x (x - 2 * Real.pi / T) -
          prawitzSlackImbalance T x x| +
        |prawitzSlackImbalance T x x -
          prawitzSlackImbalance T x (x + 2 * Real.pi / T)| ≤ C) :
    2 ≤ C := by
  rw [prawitzSlackImbalance_threePointVariation_scaled hT x] at hC
  exact hC

/-- The off-diagonal imbalance removes only the value at the CDF evaluation
point, leaving the rest of the universal profile unchanged. -/
noncomputable def prawitzSlackImbalanceOffDiagonal (T x y : ℝ) : ℝ :=
  if y = x then 0 else prawitzSlackImbalance T x y

/-- The off-diagonal profile, like the raw imbalance, depends only on spatial
displacement. -/
theorem prawitzSlackImbalanceOffDiagonal_translate (T x y : ℝ) :
    prawitzSlackImbalanceOffDiagonal T x y =
      prawitzSlackImbalanceOffDiagonal T 0 (y - x) := by
  by_cases hy : y = x
  · subst y
    simp [prawitzSlackImbalanceOffDiagonal]
  · have hsub : y - x ≠ 0 := sub_ne_zero.mpr hy
    simp [prawitzSlackImbalanceOffDiagonal, hy, hsub,
      prawitzSlackImbalance_translate]

/-- At positive bandwidth, dilation reduces the off-diagonal profile to the
universal unit-window profile without reintroducing the diagonal atom. -/
theorem prawitzSlackImbalanceOffDiagonal_scale
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    prawitzSlackImbalanceOffDiagonal T x y =
      prawitzSlackImbalanceOffDiagonal 1 0 (T * (y - x)) := by
  by_cases hy : y = x
  · subst y
    simp [prawitzSlackImbalanceOffDiagonal]
  · have hsub : y - x ≠ 0 := sub_ne_zero.mpr hy
    have hscaled : T * (y - x) ≠ 0 := mul_ne_zero hT.ne' hsub
    simp [prawitzSlackImbalanceOffDiagonal, hy, hscaled,
      prawitzSlackImbalance_scale hT]

/-- Removing the exceptional diagonal value restores exact odd symmetry to
the centered imbalance profile. -/
theorem prawitzSlackImbalanceOffDiagonal_neg (T z : ℝ) :
    prawitzSlackImbalanceOffDiagonal T 0 (-z) =
      -prawitzSlackImbalanceOffDiagonal T 0 z := by
  by_cases hz : z = 0
  · subst z
    simp [prawitzSlackImbalanceOffDiagonal]
  · have hneg_ne : -z ≠ 0 := neg_ne_zero.mpr hz
    by_cases hzpos : 0 < z
    · rw [show prawitzSlackImbalanceOffDiagonal T 0 (-z) =
          prawitzSlackImbalance T 0 (-z) by
            simp [prawitzSlackImbalanceOffDiagonal, hneg_ne],
        show prawitzSlackImbalanceOffDiagonal T 0 z =
          prawitzSlackImbalance T 0 z by
            simp [prawitzSlackImbalanceOffDiagonal, hz],
        prawitzSlackImbalance_of_le T (by linarith : -z ≤ 0),
        prawitzSlackImbalance_of_lt T hzpos]
      simp only [sub_zero, zero_sub, neg_neg]
      ring
    · have hzneg : z < 0 := lt_of_le_of_ne (not_lt.mp hzpos) hz
      rw [show prawitzSlackImbalanceOffDiagonal T 0 (-z) =
          prawitzSlackImbalance T 0 (-z) by
            simp [prawitzSlackImbalanceOffDiagonal, hneg_ne],
        show prawitzSlackImbalanceOffDiagonal T 0 z =
          prawitzSlackImbalance T 0 z by
            simp [prawitzSlackImbalanceOffDiagonal, hz],
        prawitzSlackImbalance_of_lt T (neg_pos.mpr hzneg),
        prawitzSlackImbalance_of_le T hzneg.le]
      simp only [sub_zero, zero_sub, neg_neg]
      ring

/-- Around an arbitrary center, the off-diagonal imbalance changes sign
under spatial reflection. -/
theorem prawitzSlackImbalanceOffDiagonal_reflect (T x y : ℝ) :
    prawitzSlackImbalanceOffDiagonal T x (2 * x - y) =
      -prawitzSlackImbalanceOffDiagonal T x y := by
  calc
    prawitzSlackImbalanceOffDiagonal T x (2 * x - y) =
        prawitzSlackImbalanceOffDiagonal T 0 (2 * x - y - x) :=
      prawitzSlackImbalanceOffDiagonal_translate T x (2 * x - y)
    _ = prawitzSlackImbalanceOffDiagonal T 0 (-(y - x)) := by
      congr 1
      ring
    _ = -prawitzSlackImbalanceOffDiagonal T 0 (y - x) :=
      prawitzSlackImbalanceOffDiagonal_neg T (y - x)
    _ = -prawitzSlackImbalanceOffDiagonal T x y := by
      exact congrArg Neg.neg
        (prawitzSlackImbalanceOffDiagonal_translate T x y).symm

/-- On the positive universal half-line, the off-diagonal imbalance is
exactly half the difference of the two nonnegative Prawitz--Vaaler
remainders. -/
theorem prawitzSlackImbalanceOffDiagonal_two_pi_mul
    {a : ℝ} (ha : 0 < a) :
    prawitzSlackImbalanceOffDiagonal 1 0 (2 * Real.pi * a) =
      (prawitzVaalerNegativeRemainder a -
        prawitzVaalerPositiveRemainder a) / 2 := by
  have hz : 2 * Real.pi * a ≠ 0 := by positivity
  rw [show prawitzSlackImbalanceOffDiagonal 1 0 (2 * Real.pi * a) =
      prawitzSlackImbalance 1 0 (2 * Real.pi * a) by
        simp [prawitzSlackImbalanceOffDiagonal, hz],
    prawitzSlackImbalance_of_lt 1 (by positivity)]
  simp only [sub_zero, zero_sub]
  rw [show -(2 * Real.pi * a) = -2 * Real.pi * a by ring]
  have hpos := prawitzPointKernel_positive_identity ha
  have hneg :=
    prawitzVaalerNegativeRemainder_eq_pointKernel_of_positive ha hpos
  linarith

/-- The negative universal half-line has the reflected remainder difference,
as forced by odd symmetry. -/
theorem prawitzSlackImbalanceOffDiagonal_neg_two_pi_mul
    {a : ℝ} (ha : 0 < a) :
    prawitzSlackImbalanceOffDiagonal 1 0 (-2 * Real.pi * a) =
      (prawitzVaalerPositiveRemainder a -
        prawitzVaalerNegativeRemainder a) / 2 := by
  rw [show -2 * Real.pi * a = -(2 * Real.pi * a) by ring,
    prawitzSlackImbalanceOffDiagonal_neg,
    prawitzSlackImbalanceOffDiagonal_two_pi_mul ha]
  ring

/-- Explicit positive-half-line coordinate for the universal off-diagonal
imbalance, with the inverse-square series isolated for differentiation. -/
noncomputable def prawitzOffDiagonalHalfProfile (x : ℝ) : ℝ :=
  (Real.sin (Real.pi * x) / Real.pi) ^ 2 *
    (1 / x ^ 2 + 2 * prawitzInverseSquareTail x - 2 / x)

/-- The universal off-diagonal imbalance is the explicit half-profile after
the natural `2 * π` spatial rescaling. -/
theorem prawitzSlackImbalanceOffDiagonal_two_pi_mul_eq_halfProfile
    {x : ℝ} (hx : 0 < x) :
    prawitzSlackImbalanceOffDiagonal 1 0 (2 * Real.pi * x) =
      prawitzOffDiagonalHalfProfile x := by
  rw [prawitzSlackImbalanceOffDiagonal_two_pi_mul hx]
  unfold prawitzOffDiagonalHalfProfile prawitzVaalerNegativeRemainder
    prawitzVaalerPositiveRemainder
  ring

/-- Exact derivative of the universal positive half-profile. -/
theorem hasDerivAt_prawitzOffDiagonalHalfProfile
    {x : ℝ} (hx : 0 < x) :
    HasDerivAt prawitzOffDiagonalHalfProfile
      (2 * (Real.sin (Real.pi * x) / Real.pi) * Real.cos (Real.pi * x) *
          (1 / x ^ 2 + 2 * prawitzInverseSquareTail x - 2 / x) +
        (Real.sin (Real.pi * x) / Real.pi) ^ 2 *
          (-2 / x ^ 3 - 4 * prawitzInverseCubeTail x + 2 / x ^ 2)) x := by
  have hsinArg : HasDerivAt (fun y : ℝ => Real.sin (Real.pi * y))
      (Real.pi * Real.cos (Real.pi * x)) x := by
    convert (Real.hasDerivAt_sin (Real.pi * x)).comp x
      ((hasDerivAt_const x Real.pi).mul (hasDerivAt_id x)) using 1; ring
  have hsin : HasDerivAt (fun y : ℝ => Real.sin (Real.pi * y) / Real.pi)
      (Real.cos (Real.pi * x)) x := by
    convert hsinArg.div_const Real.pi using 1
    field_simp [Real.pi_ne_zero]
  have hInv : HasDerivAt (fun y : ℝ => 1 / y) (-1 / x ^ 2) x := by
    simpa only [one_div] using (hasDerivAt_id x).inv hx.ne'
  have hInvSq : HasDerivAt (fun y : ℝ => 1 / y ^ 2) (-2 / x ^ 3) x := by
    have h := hInv.pow 2
    convert h using 1
    · funext y
      rw [Pi.pow_apply]
      simp only [one_div]
      exact (inv_pow y 2).symm
    · simp only [Nat.cast_ofNat, Nat.reduceSub, pow_one]
      field_simp [hx.ne']
  have hBracket : HasDerivAt
      (fun y : ℝ => 1 / y ^ 2 + 2 * prawitzInverseSquareTail y - 2 / y)
      (-2 / x ^ 3 - 4 * prawitzInverseCubeTail x + 2 / x ^ 2) x := by
    have h := hInvSq.add
      ((hasDerivAt_prawitzInverseSquareTail hx).const_mul 2) |>.sub
        (hInv.const_mul 2)
    convert h using 1
    · funext y
      change 1 / y ^ 2 + 2 * prawitzInverseSquareTail y - 2 / y =
        (1 / y ^ 2 + 2 * prawitzInverseSquareTail y) - 2 * (1 / y)
      ring
    · ring
  unfold prawitzOffDiagonalHalfProfile
  have h := (hsin.pow 2).mul hBracket
  simp only [Pi.pow_apply] at h
  convert h using 1; ring

/-- A sinc-based continuous extension of the positive half-profile through
the spatial center. -/
noncomputable def prawitzOffDiagonalHalfProfileExtension (x : ℝ) : ℝ :=
  Real.sinc (Real.pi * x) ^ 2 +
    2 * (Real.sin (Real.pi * x) / Real.pi) ^ 2 *
      prawitzInverseSquareTail x -
    2 * x * Real.sinc (Real.pi * x) ^ 2

/-- Away from zero, the sinc extension agrees with the explicit half-profile. -/
theorem prawitzOffDiagonalHalfProfile_eq_extension
    {x : ℝ} (hx : x ≠ 0) :
    prawitzOffDiagonalHalfProfile x =
      prawitzOffDiagonalHalfProfileExtension x := by
  unfold prawitzOffDiagonalHalfProfile
    prawitzOffDiagonalHalfProfileExtension
  rw [Real.sinc_of_ne_zero (mul_ne_zero Real.pi_ne_zero hx)]
  field_simp [Real.pi_ne_zero, hx]

/-- The sinc extension is continuous at the spatial center. -/
theorem continuousAt_prawitzOffDiagonalHalfProfileExtension :
    ContinuousAt prawitzOffDiagonalHalfProfileExtension 0 := by
  have hsinc : ContinuousAt (fun x : ℝ => Real.sinc (Real.pi * x)) 0 := by
    fun_prop
  have hsin : ContinuousAt (fun x : ℝ =>
      Real.sin (Real.pi * x) / Real.pi) 0 := by
    fun_prop
  unfold prawitzOffDiagonalHalfProfileExtension
  exact (hsinc.pow 2).add
    ((continuousAt_const.mul (hsin.pow 2)).mul
      continuousAt_prawitzInverseSquareTail_zero) |>.sub
        ((continuousAt_const.mul continuousAt_id).mul (hsinc.pow 2))

/-- The continuous extension takes the value one at the spatial center. -/
@[simp] theorem prawitzOffDiagonalHalfProfileExtension_zero :
    prawitzOffDiagonalHalfProfileExtension 0 = 1 := by
  simp [prawitzOffDiagonalHalfProfileExtension]

/-- The universal positive half-profile tends to one on approach to its
deleted spatial center. -/
theorem tendsto_prawitzOffDiagonalHalfProfile_right :
    Tendsto prawitzOffDiagonalHalfProfile (nhdsWithin 0 (Ioi 0)) (nhds 1) := by
  have hext : Tendsto prawitzOffDiagonalHalfProfileExtension
      (nhdsWithin 0 (Ioi 0)) (nhds 1) := by
    rw [show (1 : ℝ) = prawitzOffDiagonalHalfProfileExtension 0 by simp]
    exact continuousAt_prawitzOffDiagonalHalfProfileExtension.continuousWithinAt
  apply hext.congr'
  filter_upwards [self_mem_nhdsWithin] with x hx
  exact (prawitzOffDiagonalHalfProfile_eq_extension hx.ne').symm

/-- The off-diagonal imbalance has right-hand limit one at its deleted
center, after the natural `2 * π` rescaling. -/
theorem tendsto_prawitzSlackImbalanceOffDiagonal_positive :
    Tendsto (fun a : ℝ =>
      prawitzSlackImbalanceOffDiagonal 1 0 (2 * Real.pi * a))
      (nhdsWithin 0 (Ioi 0)) (nhds 1) := by
  apply tendsto_prawitzOffDiagonalHalfProfile_right.congr'
  filter_upwards [self_mem_nhdsWithin] with a ha
  exact
    (prawitzSlackImbalanceOffDiagonal_two_pi_mul_eq_halfProfile ha).symm

/-- Odd symmetry gives the corresponding left-hand profile limit minus one. -/
theorem tendsto_prawitzSlackImbalanceOffDiagonal_negative :
    Tendsto (fun a : ℝ =>
      prawitzSlackImbalanceOffDiagonal 1 0 (-2 * Real.pi * a))
      (nhdsWithin 0 (Ioi 0)) (nhds (-1)) := by
  have hneg := tendsto_prawitzSlackImbalanceOffDiagonal_positive.neg
  apply hneg.congr'
  filter_upwards with a
  rw [show -2 * Real.pi * a = -(2 * Real.pi * a) by ring,
    prawitzSlackImbalanceOffDiagonal_neg]

/-- The two increments adjacent to the deleted center tend to total variation
two; removing the diagonal atom therefore does not remove the coefficient-two
variation obstruction. -/
theorem tendsto_prawitzSlackImbalanceOffDiagonal_twoJumpVariation :
    Tendsto (fun a : ℝ =>
      |prawitzSlackImbalanceOffDiagonal 1 0 (-2 * Real.pi * a) -
          prawitzSlackImbalanceOffDiagonal 1 0 0| +
        |prawitzSlackImbalanceOffDiagonal 1 0 0 -
          prawitzSlackImbalanceOffDiagonal 1 0 (2 * Real.pi * a)|)
      (nhdsWithin 0 (Ioi 0)) (nhds 2) := by
  have hconst : Tendsto (fun _a : ℝ => (2 : ℝ))
      (nhdsWithin 0 (Ioi 0)) (nhds 2) := tendsto_const_nhds
  have hlim :=
    hconst.mul tendsto_prawitzSlackImbalanceOffDiagonal_positive.abs
  have htwo : Tendsto (fun a : ℝ =>
      2 * |prawitzSlackImbalanceOffDiagonal 1 0 (2 * Real.pi * a)|)
      (nhdsWithin 0 (Ioi 0)) (nhds 2) := by
    simpa using hlim
  apply htwo.congr'
  filter_upwards with a
  rw [show -2 * Real.pi * a = -(2 * Real.pi * a) by ring,
    prawitzSlackImbalanceOffDiagonal_neg,
    show prawitzSlackImbalanceOffDiagonal 1 0 0 = 0 by
      simp [prawitzSlackImbalanceOffDiagonal]]
  simp only [sub_zero, zero_sub, abs_neg]
  ring

/-- Every uniform upper bound on the two off-diagonal increments adjacent to
the center has coefficient at least two. -/
theorem two_le_of_prawitzSlackImbalanceOffDiagonal_twoJumpVariation_le
    (C : ℝ)
    (hC : ∀ a : ℝ, 0 < a →
      |prawitzSlackImbalanceOffDiagonal 1 0 (-2 * Real.pi * a) -
          prawitzSlackImbalanceOffDiagonal 1 0 0| +
        |prawitzSlackImbalanceOffDiagonal 1 0 0 -
          prawitzSlackImbalanceOffDiagonal 1 0 (2 * Real.pi * a)| ≤ C) :
    2 ≤ C := by
  apply le_of_tendsto
    tendsto_prawitzSlackImbalanceOffDiagonal_twoJumpVariation
  filter_upwards [self_mem_nhdsWithin] with a ha
  exact hC a ha

/-- Removing the diagonal atom sets the spatial center to zero. -/
@[simp] theorem prawitzSlackImbalanceOffDiagonal_self (T x : ℝ) :
    prawitzSlackImbalanceOffDiagonal T x x = 0 := by
  simp [prawitzSlackImbalanceOffDiagonal]

/-- The off-diagonal profile still vanishes at the first Fourier lattice
point to the left of the spatial center. -/
theorem prawitzSlackImbalanceOffDiagonal_left_latticePoint
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    prawitzSlackImbalanceOffDiagonal T x (x - 2 * Real.pi / T) = 0 := by
  have hshift : 0 < 2 * Real.pi / T := div_pos (by positivity) hT
  have hne : x - 2 * Real.pi / T ≠ x := ne_of_lt (sub_lt_self x hshift)
  simp [prawitzSlackImbalanceOffDiagonal, hne,
    prawitzSlackImbalance_left_latticePoint hT]

/-- The reflected first Fourier lattice point also remains a zero of the
off-diagonal profile. -/
theorem prawitzSlackImbalanceOffDiagonal_right_latticePoint
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    prawitzSlackImbalanceOffDiagonal T x (x + 2 * Real.pi / T) = 0 := by
  have hshift : 0 < 2 * Real.pi / T := div_pos (by positivity) hT
  have hne : x + 2 * Real.pi / T ≠ x := ne_of_gt (lt_add_of_pos_right x hshift)
  simp [prawitzSlackImbalanceOffDiagonal, hne,
    prawitzSlackImbalance_right_latticePoint hT]

/-- Once the diagonal atom is removed, the earlier three-point variation
obstruction vanishes exactly. -/
theorem prawitzSlackImbalanceOffDiagonal_threePointVariation
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    |prawitzSlackImbalanceOffDiagonal T x (x - 2 * Real.pi / T) -
        prawitzSlackImbalanceOffDiagonal T x x| +
      |prawitzSlackImbalanceOffDiagonal T x x -
        prawitzSlackImbalanceOffDiagonal T x (x + 2 * Real.pi / T)| = 0 := by
  rw [prawitzSlackImbalanceOffDiagonal_left_latticePoint hT,
    prawitzSlackImbalanceOffDiagonal_self,
    prawitzSlackImbalanceOffDiagonal_right_latticePoint hT]
  simp only [sub_self, abs_zero, add_zero]

/-- The full imbalance is the off-diagonal profile minus the singleton
indicator.  This isolates the atom created by the right-continuous CDF
convention. -/
theorem prawitzSlackImbalance_eq_offDiagonal_sub_singletonIndicator
    (T x y : ℝ) :
    prawitzSlackImbalance T x y =
      prawitzSlackImbalanceOffDiagonal T x y -
        ({x} : Set ℝ).indicator (fun _ : ℝ => (1 : ℝ)) y := by
  by_cases hy : y = x
  · subst y
    simp [prawitzSlackImbalanceOffDiagonal,
      prawitzSlackImbalance_diagonal]
  · simp [prawitzSlackImbalanceOffDiagonal, hy]

/-- Equivalently, the off-diagonal profile restores the singleton indicator
to the full imbalance. -/
theorem prawitzSlackImbalanceOffDiagonal_eq_add_singletonIndicator
    (T x y : ℝ) :
    prawitzSlackImbalanceOffDiagonal T x y =
      prawitzSlackImbalance T x y +
        ({x} : Set ℝ).indicator (fun _ : ℝ => (1 : ℝ)) y := by
  have h :=
    prawitzSlackImbalance_eq_offDiagonal_sub_singletonIndicator T x y
  linarith

/-- Removing the diagonal preserves integrability under the same point-kernel
hypotheses. -/
theorem integrable_prawitzSlackImbalanceOffDiagonal
    (mu : Measure ℝ) [IsFiniteMeasure mu]
    {T : ℝ} (x : ℝ)
    (hForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    Integrable (prawitzSlackImbalanceOffDiagonal T x) mu := by
  have hUpper := integrable_prawitzUpperSlack mu x hForward
  have hLower := integrable_prawitzLowerSlack mu x hReflected
  have hImbalance : Integrable (prawitzSlackImbalance T x) mu := by
    unfold prawitzSlackImbalance
    exact (hUpper.sub hLower).div_const 2
  have hSingleton : Integrable
      (({x} : Set ℝ).indicator (fun _ : ℝ => (1 : ℝ))) mu :=
    (integrable_const (1 : ℝ)).indicator (measurableSet_singleton x)
  have heq : prawitzSlackImbalanceOffDiagonal T x =
      fun y => prawitzSlackImbalance T x y +
        ({x} : Set ℝ).indicator (fun _ : ℝ => (1 : ℝ)) y := by
    funext y
    exact prawitzSlackImbalanceOffDiagonal_eq_add_singletonIndicator T x y
  rw [heq]
  exact hImbalance.add hSingleton

/-- The expected imbalance splits into its off-diagonal expectation minus the
law's atom at the CDF evaluation point. -/
theorem integral_prawitzSlackImbalance_eq_offDiagonal_sub_atom
    (mu : Measure ℝ) [IsFiniteMeasure mu]
    {T : ℝ} (x : ℝ)
    (hForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    (∫ y, prawitzSlackImbalance T x y ∂mu) =
      (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        mu.real {x} := by
  have hOff := integrable_prawitzSlackImbalanceOffDiagonal
    mu x hForward hReflected
  have hSingleton : Integrable
      (({x} : Set ℝ).indicator (fun _ : ℝ => (1 : ℝ))) mu :=
    (integrable_const (1 : ℝ)).indicator (measurableSet_singleton x)
  have hAtom :
      (∫ y, ({x} : Set ℝ).indicator (fun _ : ℝ => (1 : ℝ)) y ∂mu) =
        mu.real {x} := by
    exact integral_indicator_one (μ := mu) (measurableSet_singleton x)
  calc
    (∫ y, prawitzSlackImbalance T x y ∂mu) =
        ∫ y, (prawitzSlackImbalanceOffDiagonal T x y -
          ({x} : Set ℝ).indicator (fun _ : ℝ => (1 : ℝ)) y) ∂mu := by
      apply integral_congr_ae
      exact ae_of_all mu
        (prawitzSlackImbalance_eq_offDiagonal_sub_singletonIndicator T x)
    _ = (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        ∫ y, ({x} : Set ℝ).indicator (fun _ : ℝ => (1 : ℝ)) y ∂mu :=
      integral_sub hOff hSingleton
    _ = _ := by rw [hAtom]

/-- For two laws, the diagonal contribution is exactly their singleton-mass
difference and all remaining imbalance is off-diagonal. -/
theorem integral_prawitzSlackImbalance_sub_eq_offDiagonal_sub_atomDifference
    (mu nu : Measure ℝ) [IsFiniteMeasure mu] [IsFiniteMeasure nu]
    {T : ℝ} (x : ℝ)
    (hmuForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hmuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu)
    (hnuForward : Integrable (fun y => prawitzPointKernel T (y - x)) nu)
    (hnuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) nu) :
    (∫ y, prawitzSlackImbalance T x y ∂mu) -
        (∫ y, prawitzSlackImbalance T x y ∂nu) =
      ((∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        ∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂nu) -
      (mu.real {x} - nu.real {x}) := by
  rw [integral_prawitzSlackImbalance_eq_offDiagonal_sub_atom
      mu x hmuForward hmuReflected,
    integral_prawitzSlackImbalance_eq_offDiagonal_sub_atom
      nu x hnuForward hnuReflected]
  ring

theorem prawitzUpperSlack_eq_sinc_sq_add_imbalance
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    prawitzUpperSlack T x y =
      Real.sinc (T * (y - x) / 2) ^ 2 +
        prawitzSlackImbalance T x y := by
  have hsum := prawitzUpperSlack_add_lowerSlack_eq_two_mul_sinc_sq hT x y
  unfold prawitzSlackImbalance
  linarith

theorem prawitzLowerSlack_eq_sinc_sq_sub_imbalance
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    prawitzLowerSlack T x y =
      Real.sinc (T * (y - x) / 2) ^ 2 -
        prawitzSlackImbalance T x y := by
  have hsum := prawitzUpperSlack_add_lowerSlack_eq_two_mul_sinc_sq hT x y
  unfold prawitzSlackImbalance
  linarith

/-- Nonnegativity of both one-sided slacks bounds their signed imbalance by
the common sinc-squared mass. -/
theorem abs_prawitzSlackImbalance_le_sinc_sq
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    |prawitzSlackImbalance T x y| ≤
      Real.sinc (T * (y - x) / 2) ^ 2 := by
  rw [abs_le]
  constructor
  · have hUpper := prawitzUpperSlack_nonneg hT x y
    rw [prawitzUpperSlack_eq_sinc_sq_add_imbalance hT x y] at hUpper
    linarith
  · have hLower := prawitzLowerSlack_nonneg hT x y
    rw [prawitzLowerSlack_eq_sinc_sq_sub_imbalance hT x y] at hLower
    linarith

theorem integrable_prawitzSlackImbalance
    (mu : Measure ℝ) [IsFiniteMeasure mu]
    {T : ℝ} (x : ℝ)
    (hForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    Integrable (prawitzSlackImbalance T x) mu := by
  have hUpper := integrable_prawitzUpperSlack mu x hForward
  have hLower := integrable_prawitzLowerSlack mu x hReflected
  unfold prawitzSlackImbalance
  exact (hUpper.sub hLower).div_const 2

theorem integral_prawitzSlackImbalance_eq_half_sub
    (mu : Measure ℝ) [IsFiniteMeasure mu]
    {T : ℝ} (x : ℝ)
    (hForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    (∫ y, prawitzSlackImbalance T x y ∂mu) =
      ((∫ y, prawitzUpperSlack T x y ∂mu) -
        ∫ y, prawitzLowerSlack T x y ∂mu) / 2 := by
  have hUpper := integrable_prawitzUpperSlack mu x hForward
  have hLower := integrable_prawitzLowerSlack mu x hReflected
  unfold prawitzSlackImbalance
  rw [integral_div, integral_sub hUpper hLower]

/-- Expectation of the imbalance in spatial point-kernel coordinates. -/
theorem integral_prawitzSlackImbalance_eq_pointKernelDifference_sub_centeredCDF
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (x : ℝ)
    (hForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    (∫ y, prawitzSlackImbalance T x y ∂mu) =
      ((∫ y, prawitzPointKernel T (y - x) ∂mu) -
        ∫ y, prawitzPointKernel T (x - y) ∂mu) -
        (2 * cdf mu x - 1) := by
  have hStep : Integrable
      (fun y => 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1) mu :=
    ((integrable_const (1 : ℝ)).indicator measurableSet_Iic).const_mul 2 |>.sub
      (integrable_const 1)
  calc
    (∫ y, prawitzSlackImbalance T x y ∂mu) =
        ∫ y, (prawitzPointKernel T (y - x) -
            prawitzPointKernel T (x - y)) -
          (2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1) ∂mu := by
      apply integral_congr_ae
      exact ae_of_all mu fun y =>
        prawitzSlackImbalance_eq_pointKernel_sub_reflected_sub_centeredStep
          T x y
    _ = (∫ y, prawitzPointKernel T (y - x) -
          prawitzPointKernel T (x - y) ∂mu) -
        ∫ y, 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1 ∂mu :=
      integral_sub (hForward.sub hReflected) hStep
    _ = ((∫ y, prawitzPointKernel T (y - x) ∂mu) -
          ∫ y, prawitzPointKernel T (x - y) ∂mu) -
        ∫ y, 2 * (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y - 1 ∂mu := by
      rw [integral_sub hForward hReflected]
    _ = ((∫ y, prawitzPointKernel T (y - x) ∂mu) -
          ∫ y, prawitzPointKernel T (x - y) ∂mu) -
        (2 * cdf mu x - 1) := by rw [integral_centeredCDFKernel]

theorem integral_prawitzUpperSlack_eq_sincMass_add_imbalance
    (mu : Measure ℝ) [IsFiniteMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ)
    (hForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    (∫ y, prawitzUpperSlack T x y ∂mu) =
      (∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu) +
        ∫ y, prawitzSlackImbalance T x y ∂mu := by
  have hsum := integral_prawitzUpperSlack_add_lowerSlack_eq_two_mul_sinc_sq
    mu hT x hForward hReflected
  have himb := integral_prawitzSlackImbalance_eq_half_sub
    mu x hForward hReflected
  linarith

theorem integral_prawitzLowerSlack_eq_sincMass_sub_imbalance
    (mu : Measure ℝ) [IsFiniteMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ)
    (hForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu) :
    (∫ y, prawitzLowerSlack T x y ∂mu) =
      (∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu) -
        ∫ y, prawitzSlackImbalance T x y ∂mu := by
  have hsum := integral_prawitzUpperSlack_add_lowerSlack_eq_two_mul_sinc_sq
    mu hT x hForward hReflected
  have himb := integral_prawitzSlackImbalance_eq_half_sub
    mu x hForward hReflected
  linarith

/-- The difference of two upper-slack expectations splits exactly into the
difference of their common sinc-squared masses and the difference of their
signed imbalances. -/
theorem prawitzUpperSlackDifference_eq_sincMassDifference_add_imbalanceDifference
    (mu nu : Measure ℝ) [IsFiniteMeasure mu] [IsFiniteMeasure nu]
    {T : ℝ} (hT : 0 < T) (x : ℝ)
    (hmuForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hmuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu)
    (hnuForward : Integrable (fun y => prawitzPointKernel T (y - x)) nu)
    (hnuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) nu) :
    ((∫ y, prawitzUpperSlack T x y ∂mu) -
        ∫ y, prawitzUpperSlack T x y ∂nu) =
      ((∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu) -
          ∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂nu) +
        ((∫ y, prawitzSlackImbalance T x y ∂mu) -
          ∫ y, prawitzSlackImbalance T x y ∂nu) := by
  have hmu := integral_prawitzUpperSlack_eq_sincMass_add_imbalance
    mu hT x hmuForward hmuReflected
  have hnu := integral_prawitzUpperSlack_eq_sincMass_add_imbalance
    nu hT x hnuForward hnuReflected
  linarith

/-- The corresponding lower-slack difference has the same common-mass
coordinate and the opposite signed-imbalance coordinate. -/
theorem prawitzLowerSlackDifference_eq_sincMassDifference_sub_imbalanceDifference
    (mu nu : Measure ℝ) [IsFiniteMeasure mu] [IsFiniteMeasure nu]
    {T : ℝ} (hT : 0 < T) (x : ℝ)
    (hmuForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hmuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu)
    (hnuForward : Integrable (fun y => prawitzPointKernel T (y - x)) nu)
    (hnuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) nu) :
    ((∫ y, prawitzLowerSlack T x y ∂mu) -
        ∫ y, prawitzLowerSlack T x y ∂nu) =
      ((∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu) -
          ∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂nu) -
        ((∫ y, prawitzSlackImbalance T x y ∂mu) -
          ∫ y, prawitzSlackImbalance T x y ∂nu) := by
  have hmu := integral_prawitzLowerSlack_eq_sincMass_sub_imbalance
    mu hT x hmuForward hmuReflected
  have hnu := integral_prawitzLowerSlack_eq_sincMass_sub_imbalance
    nu hT x hnuForward hnuReflected
  linarith

/-- Forward Prawitz recentering in common-mass and signed-imbalance
coordinates. -/
theorem cdf_sub_cdf_eq_prawitzUpperMassImbalanceRecentered
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {T : ℝ} (hT : 0 < T) (x : ℝ)
    (hmuForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hmuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu)
    (hnuForward : Integrable (fun y => prawitzPointKernel T (y - x)) nu)
    (hnuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) nu) :
    cdf mu x - cdf nu x =
      ((∫ y, prawitzPointKernel T (y - x) ∂mu) -
          ∫ y, prawitzPointKernel T (y - x) ∂nu) -
        (1 / 2 : ℝ) *
          (((∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu) -
              ∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂nu) +
            ((∫ y, prawitzSlackImbalance T x y ∂mu) -
              ∫ y, prawitzSlackImbalance T x y ∂nu)) := by
  rw [cdf_sub_cdf_eq_prawitzUpperRecentered mu nu x hmuForward hnuForward,
    prawitzUpperSlackDifference_eq_sincMassDifference_add_imbalanceDifference
      mu nu hT x hmuForward hmuReflected hnuForward hnuReflected]

/-- Reflected Prawitz recentering in the same coordinates, with the signed
imbalance entering with its opposite sign. -/
theorem cdf_sub_cdf_eq_prawitzLowerMassImbalanceRecentered
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {T : ℝ} (hT : 0 < T) (x : ℝ)
    (hmuForward : Integrable (fun y => prawitzPointKernel T (y - x)) mu)
    (hmuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) mu)
    (hnuForward : Integrable (fun y => prawitzPointKernel T (y - x)) nu)
    (hnuReflected : Integrable (fun y => prawitzPointKernel T (x - y)) nu) :
    cdf mu x - cdf nu x =
      -((∫ y, prawitzPointKernel T (x - y) ∂mu) -
          ∫ y, prawitzPointKernel T (x - y) ∂nu) +
        (1 / 2 : ℝ) *
          (((∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu) -
              ∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂nu) -
            ((∫ y, prawitzSlackImbalance T x y ∂mu) -
              ∫ y, prawitzSlackImbalance T x y ∂nu)) := by
  rw [cdf_sub_cdf_eq_prawitzLowerRecentered mu nu x hmuReflected hnuReflected,
    prawitzLowerSlackDifference_eq_sincMassDifference_sub_imbalanceDifference
      mu nu hT x hmuForward hmuReflected hnuForward hnuReflected]

/-- The integrable sinc-squared profile underlying the reflected Fejér
remainder. -/
noncomputable def sincSquareWeight (x : ℝ) : ℝ := Real.sinc x ^ 2

theorem sincSquareWeight_nonneg (x : ℝ) : 0 ≤ sincSquareWeight x := by
  unfold sincSquareWeight
  positivity

theorem continuous_sincSquareWeight : Continuous sincSquareWeight := by
  exact Real.continuous_sinc.pow 2

theorem integrable_sincSquareWeight : Integrable sincSquareWeight := by
  have hmajor : Integrable (fun x : ℝ => 2 * (1 + x ^ 2)⁻¹) :=
    integrable_inv_one_add_sq.const_mul 2
  apply hmajor.mono' continuous_sincSquareWeight.aestronglyMeasurable
  exact ae_of_all volume fun x => by
    rw [Real.norm_eq_abs, abs_of_nonneg (sincSquareWeight_nonneg x)]
    by_cases hx : |x| ≤ 1
    · have hs : |Real.sinc x| ^ 2 ≤ 1 :=
        pow_le_one₀ (abs_nonneg _) (Real.abs_sinc_le_one x)
      have hxSq : x ^ 2 ≤ 1 := by
        rw [← sq_abs]
        nlinarith [abs_nonneg x]
      have hden : 0 < 1 + x ^ 2 := by positivity
      unfold sincSquareWeight
      rw [show Real.sinc x ^ 2 = |Real.sinc x| ^ 2 by
        rw [← abs_pow, abs_of_nonneg (by positivity)]]
      calc
        |Real.sinc x| ^ 2 ≤ 1 := hs
        _ ≤ 2 * (1 + x ^ 2)⁻¹ := by
          rw [← div_eq_mul_inv, le_div_iff₀ hden]
          linarith
    · have hxLarge : 1 < |x| := lt_of_not_ge hx
      have hx0 : x ≠ 0 := by
        intro h
        subst x
        norm_num at hxLarge
      have hsinc := abs_sinc_le_inv_abs hx0
      have hsPow : |Real.sinc x| ^ 2 ≤ |x|⁻¹ ^ 2 :=
        pow_le_pow_left₀ (abs_nonneg _) hsinc 2
      have hxPow : 0 < |x| ^ 2 := pow_pos (abs_pos.mpr hx0) 2
      have hden : 0 < 1 + x ^ 2 := by positivity
      have hfrac : (|x| ^ 2)⁻¹ ≤ 2 * (1 + x ^ 2)⁻¹ := by
        have hxSq : 1 ≤ x ^ 2 := by
          rw [← sq_abs]
          nlinarith
        calc
          (|x| ^ 2)⁻¹ = 1 / (|x| ^ 2) := by rw [one_div]
          _ ≤ 2 / (1 + x ^ 2) := by
            rw [div_le_div_iff₀ hxPow hden]
            rw [sq_abs]
            nlinarith
          _ = 2 * (1 + x ^ 2)⁻¹ := by rw [div_eq_mul_inv]
      unfold sincSquareWeight
      rw [show Real.sinc x ^ 2 = |Real.sinc x| ^ 2 by
        rw [← abs_pow, abs_of_nonneg (by positivity)]]
      calc
        |Real.sinc x| ^ 2 ≤ |x|⁻¹ ^ 2 := hsPow
        _ = (|x| ^ 2)⁻¹ := by rw [inv_pow]
        _ ≤ 2 * (1 + x ^ 2)⁻¹ := hfrac

/-- Sum of two independent uniform laws on `[-1,1]`. -/
noncomputable def twofoldUniformKernel : Measure ℝ :=
  uniformSmoothingKernel 1 ∗ uniformSmoothingKernel 1

theorem twofoldUniformKernel_isProbabilityMeasure :
    IsProbabilityMeasure twofoldUniformKernel := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel 1) :=
    uniformSmoothingKernel_isProbabilityMeasure (by norm_num)
  unfold twofoldUniformKernel
  infer_instance

theorem twofoldUniformKernel_supported :
    IsSupportedInSmoothingWindow twofoldUniformKernel 2 := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel 1) :=
    uniformSmoothingKernel_isProbabilityMeasure (by norm_num)
  let hUniform := uniformSmoothingKernel_supported 1
  unfold twofoldUniformKernel
  convert isSupportedInSmoothingWindow_conv hUniform hUniform using 1
  norm_num

theorem charFun_twofoldUniformKernel (t : ℝ) :
    MeasureTheory.charFun twofoldUniformKernel t =
      (sincSquareWeight t : ℂ) := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel 1) :=
    uniformSmoothingKernel_isProbabilityMeasure (by norm_num)
  have hchar :
      MeasureTheory.charFun (uniformSmoothingKernel 1) t =
        (Real.sinc t : ℂ) := by
    simpa using charFun_uniformSmoothingKernel (δ := 1) (by norm_num) t
  unfold twofoldUniformKernel
  rw [MeasureTheory.charFun_conv, hchar]
  simp only [sincSquareWeight, Complex.ofReal_pow]
  ring

theorem twofoldUniformKernel_eq_withDensity :
    twofoldUniformKernel = volume.withDensity twofoldUniformDensity := by
  exact uniformSmoothingKernel_conv_self_eq_withDensity

/-- Integration against the twofold uniform kernel in terms of its real
triangular Lebesgue density. -/
theorem integral_twofoldUniformKernel_eq_integral_density
    (f : ℝ → ℂ) :
    (∫ z, f z ∂twofoldUniformKernel) =
      ∫ z, (twofoldUniformDensityReal z : ℂ) * f z := by
  rw [twofoldUniformKernel_eq_withDensity,
    integral_withDensity_eq_integral_toReal_smul
      measurable_twofoldUniformDensity
      (ae_of_all volume fun x => by unfold twofoldUniformDensity; finiteness)
      f]
  apply integral_congr_ae
  exact ae_of_all volume fun z => by
    change (twofoldUniformDensity z).toReal • f z =
      (twofoldUniformDensityReal z : ℂ) * f z
    rw [twofoldUniformDensity_toReal]
    rw [Complex.real_smul]

/-- Complex-valued form of `twofoldUniformDensityReal` for Fourier inversion. -/
noncomputable def twofoldUniformDensityComplex (x : ℝ) : ℂ :=
  twofoldUniformDensityReal x

theorem continuous_twofoldUniformDensityComplex :
    Continuous twofoldUniformDensityComplex := by
  exact Complex.continuous_ofReal.comp continuous_twofoldUniformDensityReal

theorem integrable_twofoldUniformDensityComplex :
    Integrable twofoldUniformDensityComplex :=
  integrable_twofoldUniformDensityReal.ofReal

theorem sincSquareWeight_eq_fourierInv_twofoldUniformDensityComplex (t : ℝ) :
    (sincSquareWeight t : ℂ) =
      𝓕⁻ twofoldUniformDensityComplex (t / (2 * Real.pi)) := by
  letI : IsProbabilityMeasure twofoldUniformKernel :=
    twofoldUniformKernel_isProbabilityMeasure
  rw [← charFun_twofoldUniformKernel t,
    twofoldUniformKernel_eq_withDensity,
    MeasureTheory.charFun_apply_real,
    integral_withDensity_eq_integral_toReal_smul
      measurable_twofoldUniformDensity
      (ae_of_all volume fun x => by unfold twofoldUniformDensity; finiteness)
      (fun x : ℝ => Complex.exp ((t : ℂ) * (x : ℂ) * Complex.I)),
    Real.fourierInv_eq']
  apply integral_congr_ae
  exact ae_of_all volume fun x => by
    dsimp only
    rw [twofoldUniformDensity_toReal]
    change (twofoldUniformDensityReal x : ℂ) *
        Complex.exp ((t : ℂ) * (x : ℂ) * Complex.I) =
      Complex.exp (((2 * Real.pi * inner ℝ x (t / (2 * Real.pi)) : ℝ) : ℂ) *
        Complex.I) * (twofoldUniformDensityReal x : ℂ)
    rw [mul_comm]
    congr 2
    congr 1
    norm_cast
    rw [real_inner_eq_re_inner (𝕜 := ℝ)]
    simp only [RCLike.inner_apply, conj_trivial]
    have hre (z : ℝ) : RCLike.re z = z := rfl
    rw [hre]
    field_simp [Real.pi_ne_zero]

theorem fourierInv_twofoldUniformDensityComplex_eq_sincSquareWeight (w : ℝ) :
    𝓕⁻ twofoldUniformDensityComplex w =
      (sincSquareWeight ((2 * Real.pi) * w) : ℂ) := by
  rw [sincSquareWeight_eq_fourierInv_twofoldUniformDensityComplex]
  field_simp [Real.pi_ne_zero]

theorem integrable_fourierInv_twofoldUniformDensityComplex :
    Integrable (𝓕⁻ twofoldUniformDensityComplex) := by
  have htwoPi : (2 * Real.pi : ℝ) ≠ 0 :=
    mul_ne_zero (by norm_num) Real.pi_ne_zero
  have hbase : Integrable (fun w : ℝ => (sincSquareWeight w : ℂ)) :=
    integrable_sincSquareWeight.ofReal
  have hscaled : Integrable (fun w : ℝ =>
      (sincSquareWeight ((2 * Real.pi) * w) : ℂ)) :=
    hbase.comp_mul_left' htwoPi
  exact hscaled.congr (ae_of_all volume fun w =>
    (fourierInv_twofoldUniformDensityComplex_eq_sincSquareWeight w).symm)

theorem fourier_twofoldUniformDensityComplex_eq_sincSquareWeight (w : ℝ) :
    𝓕 twofoldUniformDensityComplex w =
      (sincSquareWeight ((-2 * Real.pi) * w) : ℂ) := by
  calc
    𝓕 twofoldUniformDensityComplex w =
        𝓕⁻ twofoldUniformDensityComplex (-w) := by
      symm
      simpa using Real.fourierInv_eq_fourier_neg
        twofoldUniformDensityComplex (-w)
    _ = (sincSquareWeight ((2 * Real.pi) * (-w)) : ℂ) :=
      fourierInv_twofoldUniformDensityComplex_eq_sincSquareWeight (-w)
    _ = (sincSquareWeight ((-2 * Real.pi) * w) : ℂ) := by
      congr 2
      ring

theorem integrable_fourier_twofoldUniformDensityComplex :
    Integrable (𝓕 twofoldUniformDensityComplex) := by
  have hnegTwoPi : (-2 * Real.pi : ℝ) ≠ 0 :=
    mul_ne_zero (by norm_num : (-2 : ℝ) ≠ 0) Real.pi_ne_zero
  have hbase : Integrable (fun w : ℝ => (sincSquareWeight w : ℂ)) :=
    integrable_sincSquareWeight.ofReal
  have hscaled : Integrable (fun w : ℝ =>
      (sincSquareWeight ((-2 * Real.pi) * w) : ℂ)) :=
    hbase.comp_mul_left' hnegTwoPi
  exact hscaled.congr (ae_of_all volume fun w =>
    (fourier_twofoldUniformDensityComplex_eq_sincSquareWeight w).symm)

theorem fourier_fourierInv_twofoldUniformDensityComplex :
    𝓕 (𝓕⁻ twofoldUniformDensityComplex) = twofoldUniformDensityComplex :=
  continuous_twofoldUniformDensityComplex.fourier_fourierInv_eq
    integrable_twofoldUniformDensityComplex
    integrable_fourier_twofoldUniformDensityComplex

theorem integral_cexp_mul_sincSquareWeight_eq_density (s : ℝ) :
    (∫ x : ℝ, Complex.exp ((s : ℂ) * (x : ℂ) * Complex.I) *
        (sincSquareWeight x : ℂ)) =
      (2 * Real.pi) • (twofoldUniformDensityComplex (-s)) := by
  let g : ℝ → ℂ := fun x =>
    Complex.exp ((s : ℂ) * (x : ℂ) * Complex.I) *
      (sincSquareWeight x : ℂ)
  calc
    (∫ x : ℝ, Complex.exp ((s : ℂ) * (x : ℂ) * Complex.I) *
        (sincSquareWeight x : ℂ)) = ∫ x : ℝ, g x := rfl
    _ = (2 * Real.pi) • ∫ w : ℝ, g ((2 * Real.pi) * w) :=
      integral_eq_mul_integral_comp_mul_left g Real.two_pi_pos
    _ = (2 * Real.pi) • 𝓕 (𝓕⁻ twofoldUniformDensityComplex) (-s) := by
      congr 1
      rw [Real.fourier_eq']
      apply integral_congr_ae
      exact ae_of_all volume fun w => by
        dsimp only [g]
        rw [fourierInv_twofoldUniformDensityComplex_eq_sincSquareWeight]
        congr 1
        congr 1
        congr 1
        norm_cast
        rw [real_inner_eq_re_inner (𝕜 := ℝ)]
        simp only [RCLike.inner_apply, conj_trivial]
        have hre (z : ℝ) : RCLike.re z = z := rfl
        rw [hre]
        norm_num
        ring
    _ = (2 * Real.pi) • twofoldUniformDensityComplex (-s) := by
      rw [fourier_fourierInv_twofoldUniformDensityComplex]

/-- The exact Lebesgue mass of the sinc-squared Fejér profile. -/
theorem integral_sincSquareWeight :
    (∫ x : ℝ, sincSquareWeight x) = Real.pi := by
  have h := integral_cexp_mul_sincSquareWeight_eq_density 0
  simp only [Complex.ofReal_zero, zero_mul, Complex.exp_zero, one_mul,
    neg_zero, twofoldUniformDensityComplex, twofoldUniformDensityReal,
    abs_zero, sub_zero, max_eq_left (by norm_num : (0 : ℝ) ≤ 2),
    Complex.real_smul] at h
  have hOfReal :
      (∫ x : ℝ, (sincSquareWeight x : ℂ)) =
        Complex.ofReal (∫ x : ℝ, sincSquareWeight x) :=
    integral_complex_ofReal
  rw [hOfReal] at h
  apply_fun Complex.re at h
  norm_num at h
  calc
    (∫ x : ℝ, sincSquareWeight x) = 2 * Real.pi * (1 / 2 : ℝ) := h
    _ = Real.pi := by ring

/-- The sinc-squared profile is exactly the characteristic-function integral
of the twofold uniform kernel. -/
theorem sincSquareWeight_eq_integral_twofoldUniformKernel (s : ℝ) :
    (sincSquareWeight s : ℂ) =
      ∫ z, Complex.exp (((s * z : ℝ) : ℂ) * Complex.I)
        ∂twofoldUniformKernel := by
  rw [← charFun_twofoldUniformKernel s,
    MeasureTheory.charFun_apply_real]
  apply integral_congr_ae
  exact ae_of_all twofoldUniformKernel fun z => by
    push_cast
    ring

/-- The bounded joint phase occurring when the Fejer profile is averaged
against a probability law is integrable on the product space. -/
theorem integrable_prod_prawitzReflectionFourierPhase
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (T x : ℝ) :
    Integrable (fun p : ℝ × ℝ =>
      Complex.exp ((((T * (p.1 - x) / 2) * p.2 : ℝ) : ℂ) * Complex.I))
      (mu.prod twofoldUniformKernel) := by
  letI : IsProbabilityMeasure twofoldUniformKernel :=
    twofoldUniformKernel_isProbabilityMeasure
  have hmeas : AEStronglyMeasurable (fun p : ℝ × ℝ =>
      Complex.exp ((((T * (p.1 - x) / 2) * p.2 : ℝ) : ℂ) * Complex.I))
      (mu.prod twofoldUniformKernel) := by
    fun_prop
  apply (integrable_const (1 : ℝ)).mono' hmeas
  exact ae_of_all (mu.prod twofoldUniformKernel) fun p => by
    rw [Complex.norm_exp_ofReal_mul_I]

/-- Averaging a translated and scaled Fejer profile is exactly a compact
frequency integral involving the characteristic function of the law. -/
theorem integral_sincSquareWeight_eq_re_frequencyIntegral
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (T x : ℝ) :
    (∫ y, sincSquareWeight (T * (y - x) / 2) ∂mu) =
      (∫ z,
        Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu (T * z / 2)
        ∂twofoldUniformKernel).re := by
  letI : IsProbabilityMeasure twofoldUniformKernel :=
    twofoldUniformKernel_isProbabilityMeasure
  have hProd := integrable_prod_prawitzReflectionFourierPhase mu T x
  have hComplex :
      (∫ y, (sincSquareWeight (T * (y - x) / 2) : ℂ) ∂mu) =
        ∫ z,
          Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu (T * z / 2)
          ∂twofoldUniformKernel := by
    simp_rw [sincSquareWeight_eq_integral_twofoldUniformKernel]
    rw [integral_integral_swap hProd]
    apply integral_congr_ae
    exact ae_of_all twofoldUniformKernel fun z => by
      change (∫ y,
          Complex.exp ((((T * (y - x) / 2) * z : ℝ) : ℂ) * Complex.I) ∂mu) =
        Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu (T * z / 2)
      rw [MeasureTheory.charFun_apply_real]
      calc
        (∫ y,
            Complex.exp ((((T * (y - x) / 2) * z : ℝ) : ℂ) * Complex.I) ∂mu) =
            ∫ y,
              Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
                Complex.exp (((T * z / 2 : ℝ) : ℂ) * (y : ℂ) * Complex.I)
              ∂mu := by
          apply integral_congr_ae
          exact ae_of_all mu fun y => by
            change Complex.exp
                ((((T * (y - x) / 2) * z : ℝ) : ℂ) * Complex.I) =
              Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
                Complex.exp (((T * z / 2 : ℝ) : ℂ) * (y : ℂ) * Complex.I)
            rw [← Complex.exp_add]
            congr 1
            push_cast
            ring
        _ = Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
              ∫ y, Complex.exp (((T * z / 2 : ℝ) : ℂ) * (y : ℂ) * Complex.I)
                ∂mu := integral_const_mul _ _
  have hReal := congrArg Complex.re hComplex
  have hOfReal :
      (∫ y, (sincSquareWeight (T * (y - x) / 2) : ℂ) ∂mu) =
        Complex.ofReal (∫ y, sincSquareWeight (T * (y - x) / 2) ∂mu) :=
    integral_complex_ofReal
  rw [hOfReal] at hReal
  simpa using hReal

/-- The difference of two translated sinc-squared masses is controlled by a
compact twofold-uniform average of the corresponding characteristic-function
discrepancy. -/
theorem abs_sincMassDifference_le_integral_charFunDiscrepancy
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (T x : ℝ) :
    |(∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu) -
        ∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂nu| ≤
      ∫ z, ‖MeasureTheory.charFun mu (T * z / 2) -
        MeasureTheory.charFun nu (T * z / 2)‖ ∂twofoldUniformKernel := by
  letI : IsProbabilityMeasure twofoldUniformKernel :=
    twofoldUniformKernel_isProbabilityMeasure
  have hmu : Integrable (fun z =>
      Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun mu (T * z / 2)) twofoldUniformKernel := by
    apply (integrable_const (1 : ℝ)).mono'
    · fun_prop
    · exact ae_of_all twofoldUniformKernel fun z => by
        rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
        exact MeasureTheory.norm_charFun_le_one _
  have hnu : Integrable (fun z =>
      Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun nu (T * z / 2)) twofoldUniformKernel := by
    apply (integrable_const (1 : ℝ)).mono'
    · fun_prop
    · exact ae_of_all twofoldUniformKernel fun z => by
        rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
        exact MeasureTheory.norm_charFun_le_one _
  rw [show (fun y => Real.sinc (T * (y - x) / 2) ^ 2) =
      fun y => sincSquareWeight (T * (y - x) / 2) by rfl,
    integral_sincSquareWeight_eq_re_frequencyIntegral mu T x,
    integral_sincSquareWeight_eq_re_frequencyIntegral nu T x,
    ← Complex.sub_re]
  calc
    |((∫ z,
          Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu (T * z / 2)
          ∂twofoldUniformKernel) -
        ∫ z,
          Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun nu (T * z / 2)
          ∂twofoldUniformKernel).re| ≤
        ‖(∫ z,
            Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu (T * z / 2)
            ∂twofoldUniformKernel) -
          ∫ z,
            Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun nu (T * z / 2)
            ∂twofoldUniformKernel‖ := Complex.abs_re_le_norm _
    _ = ‖∫ z,
          Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
            (MeasureTheory.charFun mu (T * z / 2) -
              MeasureTheory.charFun nu (T * z / 2))
          ∂twofoldUniformKernel‖ := by
      rw [← integral_sub hmu hnu]
      congr 1
      apply integral_congr_ae
      exact ae_of_all twofoldUniformKernel fun z => by ring
    _ ≤ ∫ z, ‖Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
          (MeasureTheory.charFun mu (T * z / 2) -
            MeasureTheory.charFun nu (T * z / 2))‖
        ∂twofoldUniformKernel := norm_integral_le_integral_norm _
    _ = ∫ z, ‖MeasureTheory.charFun mu (T * z / 2) -
          MeasureTheory.charFun nu (T * z / 2)‖
        ∂twofoldUniformKernel := by
      apply integral_congr_ae
      exact ae_of_all twofoldUniformKernel fun z => by
        change ‖Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
            (MeasureTheory.charFun mu (T * z / 2) -
              MeasureTheory.charFun nu (T * z / 2))‖ =
          ‖MeasureTheory.charFun mu (T * z / 2) -
            MeasureTheory.charFun nu (T * z / 2)‖
        rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]

/-- A uniform characteristic-function discrepancy bound on the support of the
twofold-uniform kernel gives the same uniform bound for every translated
sinc-squared mass difference. -/
theorem abs_sincMassDifference_le_of_charFunDiscrepancy_le
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (T x C : ℝ)
    (hC : ∀ z ∈ Icc (-2 : ℝ) 2,
      ‖MeasureTheory.charFun mu (T * z / 2) -
        MeasureTheory.charFun nu (T * z / 2)‖ ≤ C) :
    |(∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu) -
        ∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂nu| ≤ C := by
  letI : IsProbabilityMeasure twofoldUniformKernel :=
    twofoldUniformKernel_isProbabilityMeasure
  have hInt : Integrable (fun z =>
      ‖MeasureTheory.charFun mu (T * z / 2) -
        MeasureTheory.charFun nu (T * z / 2)‖) twofoldUniformKernel := by
    apply (integrable_const (2 : ℝ)).mono'
    · fun_prop
    · exact ae_of_all twofoldUniformKernel fun z => by
        rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
        calc
          ‖MeasureTheory.charFun mu (T * z / 2) -
              MeasureTheory.charFun nu (T * z / 2)‖ ≤
              ‖MeasureTheory.charFun mu (T * z / 2)‖ +
                ‖MeasureTheory.charFun nu (T * z / 2)‖ := norm_sub_le _ _
          _ ≤ 2 := by
            linarith [MeasureTheory.norm_charFun_le_one
              (μ := mu) (T * z / 2),
              MeasureTheory.norm_charFun_le_one
                (μ := nu) (T * z / 2)]
  have hIntegral :
      (∫ z, ‖MeasureTheory.charFun mu (T * z / 2) -
          MeasureTheory.charFun nu (T * z / 2)‖ ∂twofoldUniformKernel) ≤ C := by
    calc
      (∫ z, ‖MeasureTheory.charFun mu (T * z / 2) -
          MeasureTheory.charFun nu (T * z / 2)‖ ∂twofoldUniformKernel) ≤
          ∫ _z : ℝ, C ∂twofoldUniformKernel := by
        apply integral_mono_ae hInt (integrable_const C)
        filter_upwards [twofoldUniformKernel_supported] with z hz
        exact hC z hz
      _ = C := by simp
  exact (abs_sincMassDifference_le_integral_charFunDiscrepancy
    mu nu T x).trans hIntegral

/-- Window form of the preceding estimate: only frequencies of magnitude at
most the nonnegative scale `T` are needed. -/
theorem abs_sincMassDifference_le_of_charFunDiscrepancy_le_on_window
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {T : ℝ} (hT : 0 ≤ T) (x C : ℝ)
    (hC : ∀ t, |t| ≤ T →
      ‖MeasureTheory.charFun mu t - MeasureTheory.charFun nu t‖ ≤ C) :
    |(∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂mu) -
        ∫ y, Real.sinc (T * (y - x) / 2) ^ 2 ∂nu| ≤ C := by
  apply abs_sincMassDifference_le_of_charFunDiscrepancy_le mu nu T x C
  intro z hz
  apply hC
  have hzAbs : |z| ≤ 2 := (abs_le).2 hz
  calc
    |T * z / 2| = T * |z| / 2 := by
      rw [abs_div, abs_mul, abs_of_nonneg hT]
      norm_num
    _ ≤ T * 2 / 2 := by gcongr
    _ = T := by ring

/-- Quantitative sinc-mass comparison between a normalized centered i.i.d.
sum and the standard normal on any window contained in the one-step Taylor
regime. -/
theorem abs_sincMassDifference_normalizedCenteredIidSum_le
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 3 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (hMean : ∫ omega, X 0 omega ∂mu = 0)
    (hSecond : ∫ omega, (X 0 omega) ^ 2 ∂mu = 1)
    (N : ℕ) {T : ℝ} (hT : 0 ≤ T)
    (hWindow : T / Real.sqrt (N + 1 : ℝ) ≤ 1) (x : ℝ) :
    |(∫ y, Real.sinc (T * (y - x) / 2) ^ 2
          ∂NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
              X (fun i => (hX i).mono_exponent (by norm_num)) N).aemeasurable) -
        ∫ y, Real.sinc (T * (y - x) / 2) ^ 2
          ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw| ≤
      ((N + 1 : ℕ) : ℝ) *
          (4 * (T / Real.sqrt (N + 1 : ℝ)) ^ 3 *
            ∫ omega, |X 0 omega| ^ 3 ∂mu) +
        ((N + 1 : ℕ) : ℝ) *
          ((T / Real.sqrt (N + 1 : ℝ)) ^ 4 / 4) := by
  apply abs_sincMassDifference_le_of_charFunDiscrepancy_le_on_window
    (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
      (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
      (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
        X (fun i => (hX i).mono_exponent (by norm_num)) N).aemeasurable)
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hT x _
  intro t ht
  have hsqrt : 0 < Real.sqrt (N + 1 : ℝ) := by positivity
  have htScale : |t / Real.sqrt (N + 1 : ℝ)| ≤
      T / Real.sqrt (N + 1 : ℝ) := by
    rw [abs_div, abs_of_pos hsqrt]
    exact (div_le_div_iff_of_pos_right hsqrt).2 ht
  have hlocal : |t / Real.sqrt (N + 1 : ℝ)| ≤ 1 :=
    htScale.trans hWindow
  have hbase := norm_charFun_normalizedCenteredIidSum_sub_standardNormalLaw_le
    X hX hIndep hIdent hMean hSecond N hlocal
  have hrho : 0 ≤ ∫ omega, |X 0 omega| ^ 3 ∂mu :=
    integral_nonneg fun omega => by positivity
  calc
    _ ≤ ((N + 1 : ℕ) : ℝ) *
          (4 * |t / Real.sqrt (N + 1 : ℝ)| ^ 3 *
            ∫ omega, |X 0 omega| ^ 3 ∂mu) +
        ((N + 1 : ℕ) : ℝ) *
          (|t / Real.sqrt (N + 1 : ℝ)| ^ 4 / 4) := hbase
    _ ≤ ((N + 1 : ℕ) : ℝ) *
          (4 * (T / Real.sqrt (N + 1 : ℝ)) ^ 3 *
            ∫ omega, |X 0 omega| ^ 3 ∂mu) +
        ((N + 1 : ℕ) : ℝ) *
          ((T / Real.sqrt (N + 1 : ℝ)) ^ 4 / 4) := by
      gcongr

/-- The compact twofold-uniform frequency integral in the Prawitz remainder,
rescaled to the same real frequency variable used by the inversion integral. -/
theorem integral_prawitzReflectionFrequency_eq_scaledDensity
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ z,
        Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu (T * z / 2)
        ∂twofoldUniformKernel) =
      (2 / T : ℝ) •
        ∫ t,
          (twofoldUniformDensityReal (2 * t / T) : ℂ) *
            (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu t) := by
  rw [integral_twofoldUniformKernel_eq_integral_density]
  let g : ℝ → ℂ := fun t =>
    (twofoldUniformDensityReal (2 * t / T) : ℂ) *
      (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun mu t)
  have hcomp := Measure.integral_comp_mul_left g (T / 2)
  rw [abs_of_pos (inv_pos.mpr (div_pos hT (by norm_num)))] at hcomp
  have hfun :
      (fun z : ℝ => (twofoldUniformDensityReal z : ℂ) *
        (Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu (T * z / 2))) =
        fun z => g ((T / 2) * z) := by
    funext z
    dsimp only [g]
    congr 3 <;> try ring
    field_simp [hT.ne']
  rw [hfun, hcomp]
  congr 1
  field_simp [hT.ne']

/-- The triangular frequency weight obtained by rescaling the density of the
sum of two independent uniform variables. -/
noncomputable def prawitzFejerFrequencyWeight (T t : ℝ) : ℝ :=
  max (1 - |t| / T) 0 / T

theorem prawitzFejerFrequencyWeight_of_mem_Icc
    {T t : ℝ} (hT : 0 < T) (ht0 : 0 ≤ t) (htT : t ≤ T) :
    prawitzFejerFrequencyWeight T t = (1 - t / T) / T := by
  have hratio : t / T ≤ 1 := (div_le_one hT).2 htT
  unfold prawitzFejerFrequencyWeight
  rw [abs_of_nonneg ht0, max_eq_left (sub_nonneg.mpr hratio)]

/-- Coefficient of the signed imaginary characteristic-function discrepancy
after expanding the real part of the Prawitz filter. -/
noncomputable def prawitzCotangentFrequencyCoefficient (T t : ℝ) : ℝ :=
  ((1 - t / T) * prawitzCotFactor (t / T) + t / T) /
    (Real.pi * t)

theorem prawitzFejerFrequencyWeight_nonneg
    {T : ℝ} (hT : 0 < T) (t : ℝ) :
    0 ≤ prawitzFejerFrequencyWeight T t := by
  unfold prawitzFejerFrequencyWeight
  exact div_nonneg (le_max_right _ _) hT.le

theorem prawitzFejerFrequencyWeight_le_inv
    {T t : ℝ} (hT : 0 < T) (ht0 : 0 ≤ t) :
    prawitzFejerFrequencyWeight T t ≤ 1 / T := by
  have hratio0 : 0 ≤ |t| / T := div_nonneg (abs_nonneg t) hT.le
  unfold prawitzFejerFrequencyWeight
  rw [div_le_div_iff_of_pos_right hT]
  exact max_le (by linarith) (by norm_num)

theorem prawitzCotangentFrequencyCoefficient_nonneg
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) :
    0 ≤ prawitzCotangentFrequencyCoefficient T t := by
  unfold prawitzCotangentFrequencyCoefficient
  apply div_nonneg
  · rw [← scaledPrawitzSmoothingFilter_re_of_mem_Ico hT ht.1.le ht.2]
    unfold scaledPrawitzSmoothingFilter
    exact prawitzSmoothingFilter_re_nonneg_of_mem_Ico
      (div_nonneg ht.1.le hT.le) ((div_lt_one hT).2 ht.2)
  · exact mul_nonneg Real.pi_pos.le ht.1.le

theorem prawitzCotangentFrequencyCoefficient_le_inv
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) :
    prawitzCotangentFrequencyCoefficient T t ≤ 1 / (Real.pi * t) := by
  unfold prawitzCotangentFrequencyCoefficient
  have hden : 0 < Real.pi * t := mul_pos Real.pi_pos ht.1
  rw [div_le_div_iff_of_pos_right hden]
  rw [← scaledPrawitzSmoothingFilter_re_of_mem_Ico hT ht.1.le ht.2]
  unfold scaledPrawitzSmoothingFilter
  exact prawitzSmoothingFilter_re_le_one_of_mem_Ico
    (div_nonneg ht.1.le hT.le) ((div_lt_one hT).2 ht.2)

/-- Inside the positive Prawitz window, the surviving imaginary-filter
coefficient is exactly twice the triangular Fejer weight. -/
theorem neg_two_mul_scaledPrawitzSmoothingFilter_im_div_pi
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) (q : ℝ) :
    (-2 * (scaledPrawitzSmoothingFilter T t).im * q / t) / Real.pi =
      2 * prawitzFejerFrequencyWeight T t * q := by
  rw [scaledPrawitzSmoothingFilter_im_of_mem_Ico hT ht.1.le ht.2,
    prawitzFejerFrequencyWeight_of_mem_Icc hT ht.1.le ht.2.le]
  field_simp [hT.ne', ht.1.ne', Real.pi_ne_zero]

/-- Inside the positive Prawitz window, the surviving real-filter coefficient
is exactly twice the cotangent frequency coefficient. -/
theorem two_mul_scaledPrawitzSmoothingFilter_re_div_pi
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) (q : ℝ) :
    (2 * (scaledPrawitzSmoothingFilter T t).re * q / t) / Real.pi =
      2 * prawitzCotangentFrequencyCoefficient T t * q := by
  rw [scaledPrawitzSmoothingFilter_re_of_mem_Ico hT ht.1.le ht.2]
  unfold prawitzCotangentFrequencyCoefficient
  field_simp [ht.1.ne', Real.pi_ne_zero]

theorem two_div_mul_twofoldUniformDensityReal_scaled
    {T : ℝ} (hT : 0 < T) (t : ℝ) :
    (2 / T) * twofoldUniformDensityReal (2 * t / T) =
      prawitzFejerFrequencyWeight T t := by
  unfold twofoldUniformDensityReal prawitzFejerFrequencyWeight
  rw [abs_div, abs_of_pos hT, abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
  by_cases ht : |t| ≤ T
  · have hratio : |t| / T ≤ 1 := (div_le_one hT).2 ht
    have hleft : 0 ≤ 2 - 2 * |t| / T := by
      calc
        0 ≤ 2 * (1 - |t| / T) :=
          mul_nonneg (by norm_num) (sub_nonneg.mpr hratio)
        _ = 2 - 2 * |t| / T := by ring
    have hright : 0 ≤ 1 - |t| / T := by
      linarith
    rw [max_eq_left hleft, max_eq_left hright]
    field_simp [hT.ne']
    ring
  · have ht' : T < |t| := lt_of_not_ge ht
    have hratio : 1 < |t| / T := (one_lt_div hT).2 ht'
    have hleft : 2 - 2 * |t| / T ≤ 0 := by
      calc
        2 - 2 * |t| / T = 2 * (1 - |t| / T) := by ring
        _ ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (by norm_num)
          (sub_nonpos.mpr hratio.le)
    have hright : 1 - |t| / T ≤ 0 := by
      linarith
    rw [max_eq_right hleft, max_eq_right hright]
    ring

theorem integrable_prawitzFejerFrequencyWeight
    {T : ℝ} (hT : 0 < T) :
    Integrable (prawitzFejerFrequencyWeight T) := by
  have hscale : (2 / T : ℝ) ≠ 0 := div_ne_zero (by norm_num) hT.ne'
  have hdensity : Integrable (fun t : ℝ =>
      twofoldUniformDensityReal ((2 / T) * t)) :=
    integrable_twofoldUniformDensityReal.comp_mul_left' hscale
  have hscaled := hdensity.const_mul (2 / T)
  apply hscaled.congr
  exact ae_of_all volume fun t => by
    dsimp only [Function.comp_apply]
    rw [show (2 / T) * t = 2 * t / T by ring,
      two_div_mul_twofoldUniformDensityReal_scaled hT]

theorem prawitzFejerFrequencyWeight_eq_zero_of_not_mem_Icc
    {T : ℝ} (hT : 0 < T) {t : ℝ} (ht : t ∉ Icc (-T) T) :
    prawitzFejerFrequencyWeight T t = 0 := by
  have habs : T < |t| := by
    by_contra h
    have hle : |t| ≤ T := le_of_not_gt h
    exact ht (abs_le.mp hle)
  have hratio : 1 < |t| / T := (one_lt_div hT).2 habs
  unfold prawitzFejerFrequencyWeight
  rw [max_eq_right (sub_nonpos.mpr hratio.le)]
  simp

theorem prawitzFejerFrequencyWeight_neg (T t : ℝ) :
    prawitzFejerFrequencyWeight T (-t) =
      prawitzFejerFrequencyWeight T t := by
  simp only [prawitzFejerFrequencyWeight, abs_neg]

/-- Pair an integrable function on a symmetric closed window into its positive
and reflected positive-frequency sections. -/
theorem integral_Icc_neg_eq_integral_Icc_add_reflection
    (f : ℝ → ℂ) (hf : Integrable f) {T : ℝ} (hT : 0 ≤ T) :
    (∫ t in Icc (-T) T, f t) =
      ∫ t in Icc 0 T, (f (-t) + f t) := by
  have hfNeg : Integrable (fun t => f (-t)) := hf.comp_neg
  have hFull :
      (∫ t in Icc (-T) T, f t) = ∫ t in (-T)..T, f t := by
    rw [integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le (neg_le_self hT)]
  have hPos :
      (∫ t in Icc 0 T, (f (-t) + f t)) =
        ∫ t in 0..T, (f (-t) + f t) := by
    rw [integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le hT]
  calc
    (∫ t in Icc (-T) T, f t) = ∫ t in (-T)..T, f t := hFull
    _ = (∫ t in (-T)..0, f t) + ∫ t in 0..T, f t :=
      (intervalIntegral.integral_add_adjacent_intervals
        hf.intervalIntegrable hf.intervalIntegrable).symm
    _ = (∫ t in 0..T, f (-t)) + ∫ t in 0..T, f t := by
      rw [intervalIntegral.integral_comp_neg]
      simp
    _ = ∫ t in 0..T, (f (-t) + f t) :=
      (intervalIntegral.integral_add
        hfNeg.intervalIntegrable hf.intervalIntegrable).symm
    _ = ∫ t in Icc 0 T, (f (-t) + f t) := hPos.symm

theorem const_mul_setIntegral_add_setIntegral_eq_integral_add
    (f g : ℝ → ℂ) (s : Set ℝ)
    (hf : IntegrableOn f s) (hg : IntegrableOn g s) (c : ℂ) :
    c * (∫ t in s, f t) + (∫ t in s, g t) =
      ∫ t in s, (c * f t + g t) := by
  calc
    c * (∫ t in s, f t) + (∫ t in s, g t) =
        (∫ t in s, c * f t) + (∫ t in s, g t) := by
      congr 1
      exact (integral_const_mul
        (μ := volume.restrict s) c f).symm
    _ = ∫ t in s, (c * f t + g t) :=
      (integral_add (hf.const_mul c) hg).symm

theorem integrable_prawitzFejerFrequencyIntegrand
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    Integrable (fun t =>
      (prawitzFejerFrequencyWeight T t : ℂ) *
        (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu t)) := by
  have h : Integrable (fun t =>
      (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu t) *
        (prawitzFejerFrequencyWeight T t : ℂ)) := by
    apply (integrable_prawitzFejerFrequencyWeight hT).ofReal.bdd_mul (c := 1)
    · fun_prop
    · exact ae_of_all volume fun t => by
        rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
        exact MeasureTheory.norm_charFun_le_one t
  apply h.congr
  exact ae_of_all volume fun t => by ring

/-- The Prawitz reflection frequency integral with its exact triangular
Lebesgue weight on the whole real line. -/
theorem integral_prawitzReflectionFrequency_eq_triangularIntegral
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ z,
        Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu (T * z / 2)
        ∂twofoldUniformKernel) =
      ∫ t,
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu t) := by
  rw [integral_prawitzReflectionFrequency_eq_scaledDensity mu hT x,
    Complex.real_smul]
  calc
    ((2 / T : ℝ) : ℂ) *
        (∫ t,
          (twofoldUniformDensityReal (2 * t / T) : ℂ) *
            (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu t)) =
        ∫ t, ((2 / T : ℝ) : ℂ) *
          ((twofoldUniformDensityReal (2 * t / T) : ℂ) *
            (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu t)) :=
      (integral_const_mul _ _).symm
    _ = ∫ t,
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu t) := by
      apply integral_congr_ae
      exact ae_of_all volume fun t => by
        change ((2 / T : ℝ) : ℂ) *
              ((twofoldUniformDensityReal (2 * t / T) : ℂ) *
                (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
                  MeasureTheory.charFun mu t)) =
          (prawitzFejerFrequencyWeight T t : ℂ) *
            (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu t)
        rw [← mul_assoc, ← Complex.ofReal_mul,
          two_div_mul_twofoldUniformDensityReal_scaled hT]

/-- The triangular weight vanishes off `[-T,T]`, so the reflection frequency
integral is exactly supported on the Prawitz window. -/
theorem integral_prawitzReflectionFrequency_eq_triangularIntegral_Icc
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ z,
        Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu (T * z / 2)
        ∂twofoldUniformKernel) =
      ∫ t in Icc (-T) T,
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu t) := by
  rw [integral_prawitzReflectionFrequency_eq_triangularIntegral mu hT x,
    ← integral_indicator measurableSet_Icc]
  apply integral_congr_ae
  exact ae_of_all volume fun t => by
    by_cases ht : t ∈ Icc (-T) T
    · simp only [Set.indicator_of_mem ht]
    · rw [Set.indicator_of_notMem ht]
      change (prawitzFejerFrequencyWeight T t : ℂ) *
        (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu t) = 0
      rw [prawitzFejerFrequencyWeight_eq_zero_of_not_mem_Icc hT ht]
      simp only [Complex.ofReal_zero, zero_mul]

/-- Positive-frequency pairing of the exact Prawitz reflection remainder. -/
theorem integral_prawitzReflectionFrequency_eq_pairedTriangularIntegral
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ z,
        Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu (T * z / 2)
        ∂twofoldUniformKernel) =
      ∫ t in Icc 0 T,
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu t) := by
  rw [integral_prawitzReflectionFrequency_eq_triangularIntegral_Icc mu hT x]
  let f : ℝ → ℂ := fun t =>
    (prawitzFejerFrequencyWeight T t : ℂ) *
      (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun mu t)
  have hf : Integrable f := by
    simpa only [f] using integrable_prawitzFejerFrequencyIntegrand mu hT x
  rw [integral_Icc_neg_eq_integral_Icc_add_reflection f hf hT.le]
  apply integral_congr_ae
  filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
  dsimp only [f]
  rw [prawitzFejerFrequencyWeight_neg]
  rw [show -(x * -t) = x * t by ring]
  ring

theorem integrable_pairedPrawitzReflectionFrequencyIntegrand
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    Integrable (fun t =>
      (prawitzFejerFrequencyWeight T t : ℂ) *
        (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu (-t) +
          Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu t)) := by
  let r : ℝ → ℂ := fun t =>
    (prawitzFejerFrequencyWeight T t : ℂ) *
      (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun mu t)
  have hr : Integrable r := by
    simpa only [r] using
      integrable_prawitzFejerFrequencyIntegrand mu hT x
  apply (hr.comp_neg.add hr).congr
  exact ae_of_all volume fun t => by
    simp only [Pi.add_apply]
    dsimp only [r]
    rw [prawitzFejerFrequencyWeight_neg,
      show -(x * -t) = x * t by ring]
    ring

/-- For an arbitrary probability law, the real part of the paired triangular
reflection integrand is twice its positive-frequency phase coordinate. -/
theorem re_pairedPrawitzReflectionFrequencyIntegrand_charFun
    (mu : Measure ℝ) (T x t : ℝ) :
    ((prawitzFejerFrequencyWeight T t : ℂ) *
        (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu (-t) +
          Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu t)).re =
      2 * prawitzFejerFrequencyWeight T t *
        (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu t).re := by
  rw [MeasureTheory.charFun_neg]
  simp only [Complex.mul_re, Complex.add_re, Complex.ofReal_re,
    Complex.ofReal_im, Complex.exp_ofReal_mul_I_re,
    Complex.exp_ofReal_mul_I_im, Real.cos_neg, Real.sin_neg,
    Complex.conj_re, Complex.conj_im]
  ring

/-- The positive-frequency Fejér phase integral is exactly one half of a
translated sinc-squared average against the probability law. -/
theorem two_mul_integral_prawitzFejer_phase_re_eq_sincSquare
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    2 * (∫ t in Icc (0 : ℝ) T,
      prawitzFejerFrequencyWeight T t *
        (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu t).re) =
      ∫ y, sincSquareWeight (T * (y - x) / 2) ∂mu := by
  have hsinc := integral_sincSquareWeight_eq_re_frequencyIntegral mu T x
  rw [integral_prawitzReflectionFrequency_eq_pairedTriangularIntegral
    mu hT x] at hsinc
  have hpair : IntegrableOn (fun t =>
      (prawitzFejerFrequencyWeight T t : ℂ) *
        (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu (-t) +
          Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu t)) (Icc (0 : ℝ) T) :=
    (integrable_pairedPrawitzReflectionFrequencyIntegrand mu hT x).integrableOn
  calc
    2 * (∫ t in Icc (0 : ℝ) T,
        prawitzFejerFrequencyWeight T t *
          (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu t).re) =
      ∫ t in Icc (0 : ℝ) T,
        2 * (prawitzFejerFrequencyWeight T t *
          (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu t).re) := by
          rw [integral_const_mul]
    _ = ∫ t in Icc (0 : ℝ) T,
        ((prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu t)).re := by
      apply integral_congr_ae
      filter_upwards with t
      symm
      simpa only [mul_assoc] using
        re_pairedPrawitzReflectionFrequencyIntegrand_charFun mu T x t
    _ = (∫ t in Icc (0 : ℝ) T,
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun mu t)).re := integral_re hpair
    _ = _ := hsinc.symm

/-- The real positive-frequency Fejér phase integral is nonnegative for
every probability law. -/
theorem integral_prawitzFejer_phase_re_nonneg
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    0 ≤ ∫ t in Icc (0 : ℝ) T,
      prawitzFejerFrequencyWeight T t *
        (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun mu t).re := by
  have hsinc : 0 ≤ ∫ y, sincSquareWeight (T * (y - x) / 2) ∂mu := by
    exact integral_nonneg fun y => sincSquareWeight_nonneg _
  have heq := two_mul_integral_prawitzFejer_phase_re_eq_sincSquare
    mu hT x
  nlinarith

/-- The standard-normal characteristic function after multiplication by the
negative spatial phase has the expected Gaussian cosine real part. -/
theorem standardNormal_negativePhase_charFun_re (x t : ℝ) :
    (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
      MeasureTheory.charFun
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t).re =
      Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_charFun]
  have hpos :
      -((t : ℂ) ^ 2) / 2 = (((-(t ^ 2) / 2 : ℝ) : ℂ)) := by
    push_cast
    ring_nf
  rw [hpos, ← Complex.ofReal_exp]
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im,
    Real.cos_neg, Real.sin_neg]
  ring_nf

/-- Exact real part of the paired triangular reflection integrand for the
standard normal target. -/
theorem re_pairedPrawitzReflectionFrequencyIntegrand_standardNormal
    (T x t : ℝ) :
    ((prawitzFejerFrequencyWeight T t : ℂ) *
        (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
          Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re =
      2 * prawitzFejerFrequencyWeight T t *
        Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_charFun,
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_charFun]
  have hneg :
      -(((-t : ℝ) : ℂ) ^ 2) / 2 = (((-(t ^ 2) / 2 : ℝ) : ℂ)) := by
    push_cast
    ring
  have hpos :
      -((t : ℂ) ^ 2) / 2 = (((-(t ^ 2) / 2 : ℝ) : ℂ)) := by
    push_cast
    ring
  rw [hneg, hpos, ← Complex.ofReal_exp]
  simp only [Complex.mul_re, Complex.add_re, Complex.ofReal_re,
    Complex.ofReal_im, Complex.exp_ofReal_mul_I_re, zero_mul, sub_zero, mul_zero]
  rw [Real.cos_neg]
  ring

/-- The exact Gaussian part of the paired positive-frequency Prawitz
integrand, before replacing its oscillatory cosine by the bound one. -/
noncomputable def prawitzGaussianCosineRemainder (T x : ℝ) : ℝ :=
  ∫ t in Icc (0 : ℝ) T,
    2 * prawitzFejerFrequencyWeight T t *
      Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)

/-- The signed Fejér part of the exact bidirectional law-phase envelope. -/
noncomputable def prawitzLawPhaseFejerIntegral
    (mu : Measure ℝ) (T x : ℝ) : ℝ :=
  ∫ t in Icc (0 : ℝ) T,
    let d : ℂ := MeasureTheory.charFun mu t -
      MeasureTheory.charFun
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t
    let q : ℂ := Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) * d
    prawitzFejerFrequencyWeight T t *
      (q.re + 2 * Real.exp (-(t ^ 2) / 2) * Real.cos (x * t))

/-- The signed cotangent part of the exact bidirectional law-phase
envelope. -/
noncomputable def prawitzLawPhaseCotangentIntegral
    (mu : Measure ℝ) (T x : ℝ) : ℝ :=
  ∫ t in Icc (0 : ℝ) T,
    let d : ℂ := MeasureTheory.charFun mu t -
      MeasureTheory.charFun
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t
    let q : ℂ := Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) * d
    (-prawitzCotangentFrequencyCoefficient T t * q.im)

/-- The exact bidirectional law-phase envelope: its signed Fejér coordinate
plus the absolute value of its signed cotangent coordinate. -/
noncomputable def prawitzLawPhaseEnvelope
    (mu : Measure ℝ) (T x : ℝ) : ℝ :=
  prawitzLawPhaseFejerIntegral mu T x +
    |prawitzLawPhaseCotangentIntegral mu T x|

/-- Half of the exact Gaussian cosine remainder is a lower bound on the Fejér
part of the bidirectional law-phase envelope. -/
theorem half_prawitzGaussianCosineRemainder_le_lawPhaseFejerIntegral
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (1 / 2 : ℝ) * prawitzGaussianCosineRemainder T x ≤
      prawitzLawPhaseFejerIntegral mu T x := by
  unfold prawitzLawPhaseFejerIntegral
  let fmu : ℝ → ℝ := fun t =>
    prawitzFejerFrequencyWeight T t *
      (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun mu t).re
  let fnormal : ℝ → ℝ := fun t =>
    prawitzFejerFrequencyWeight T t *
      (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t).re
  have hfmu : IntegrableOn fmu (Icc (0 : ℝ) T) := by
    have h : IntegrableOn (fun t =>
        ((prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu t)).re) (Icc (0 : ℝ) T) :=
      (integrable_prawitzFejerFrequencyIntegrand mu hT x).re.integrableOn
    simpa only [fmu, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      zero_mul, sub_zero] using h
  have hfnormal : IntegrableOn fnormal (Icc (0 : ℝ) T) := by
    have h : IntegrableOn (fun t =>
        ((prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re)
        (Icc (0 : ℝ) T) :=
      (integrable_prawitzFejerFrequencyIntegrand
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hT x).re.integrableOn
    simpa only [fnormal, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      zero_mul, sub_zero] using h
  have hfmu0 : 0 ≤ ∫ t in Icc (0 : ℝ) T, fmu t := by
    simpa only [fmu] using integral_prawitzFejer_phase_re_nonneg mu hT x
  have htarget :
      (∫ t in Icc (0 : ℝ) T,
        let d : ℂ := MeasureTheory.charFun mu t -
          MeasureTheory.charFun
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t
        let q : ℂ := Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) * d
        prawitzFejerFrequencyWeight T t *
          (q.re + 2 * Real.exp (-(t ^ 2) / 2) * Real.cos (x * t))) =
        (∫ t in Icc (0 : ℝ) T, fmu t) +
          ∫ t in Icc (0 : ℝ) T, fnormal t := by
    rw [← integral_add hfmu hfnormal]
    apply integral_congr_ae
    filter_upwards with t
    dsimp only [fmu, fnormal]
    rw [mul_sub, Complex.sub_re, mul_comm t x,
      standardNormal_negativePhase_charFun_re]
    ring
  have hgauss :
      (1 / 2 : ℝ) * prawitzGaussianCosineRemainder T x =
        ∫ t in Icc (0 : ℝ) T, fnormal t := by
    unfold prawitzGaussianCosineRemainder
    rw [show (fun t : ℝ =>
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)) =
        fun t => 2 * fnormal t by
      funext t
      dsimp only [fnormal]
      rw [standardNormal_negativePhase_charFun_re]
      ring,
      integral_const_mul]
    ring
  rw [htarget, hgauss]
  linarith

/-- Twice the Fejér coordinate of the exact law-phase envelope is the sum of
the translated sinc-squared smoothing masses of the law and the standard
normal. -/
theorem two_mul_prawitzLawPhaseFejerIntegral_eq_sincSquare_add
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    2 * prawitzLawPhaseFejerIntegral mu T x =
      (∫ y, sincSquareWeight (T * (y - x) / 2) ∂mu) +
      ∫ y, sincSquareWeight (T * (y - x) / 2)
        ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  let fmu : ℝ → ℝ := fun t =>
    prawitzFejerFrequencyWeight T t *
      (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun mu t).re
  let fnormal : ℝ → ℝ := fun t =>
    prawitzFejerFrequencyWeight T t *
      (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t).re
  have hfmu : IntegrableOn fmu (Icc (0 : ℝ) T) := by
    have h : IntegrableOn (fun t =>
        ((prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun mu t)).re) (Icc (0 : ℝ) T) :=
      (integrable_prawitzFejerFrequencyIntegrand mu hT x).re.integrableOn
    simpa only [fmu, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      zero_mul, sub_zero] using h
  have hfnormal : IntegrableOn fnormal (Icc (0 : ℝ) T) := by
    have h : IntegrableOn (fun t =>
        ((prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re)
        (Icc (0 : ℝ) T) :=
      (integrable_prawitzFejerFrequencyIntegrand
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hT x).re.integrableOn
    simpa only [fnormal, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      zero_mul, sub_zero] using h
  have hsplit : prawitzLawPhaseFejerIntegral mu T x =
      (∫ t in Icc (0 : ℝ) T, fmu t) +
        ∫ t in Icc (0 : ℝ) T, fnormal t := by
    unfold prawitzLawPhaseFejerIntegral
    rw [← integral_add hfmu hfnormal]
    apply integral_congr_ae
    filter_upwards with t
    dsimp only [fmu, fnormal]
    rw [mul_sub, Complex.sub_re, mul_comm t x,
      standardNormal_negativePhase_charFun_re]
    ring
  rw [hsplit]
  calc
    2 * ((∫ t in Icc (0 : ℝ) T, fmu t) +
        ∫ t in Icc (0 : ℝ) T, fnormal t) =
        2 * (∫ t in Icc (0 : ℝ) T, fmu t) +
          2 * (∫ t in Icc (0 : ℝ) T, fnormal t) := by ring
    _ = _ := by
      rw [show 2 * (∫ t in Icc (0 : ℝ) T, fmu t) =
          ∫ y, sincSquareWeight (T * (y - x) / 2) ∂mu by
        simpa only [fmu] using
          two_mul_integral_prawitzFejer_phase_re_eq_sincSquare mu hT x,
        show 2 * (∫ t in Icc (0 : ℝ) T, fnormal t) =
          ∫ y, sincSquareWeight (T * (y - x) / 2)
            ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw by
        simpa only [fnormal] using
          two_mul_integral_prawitzFejer_phase_re_eq_sincSquare
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hT x]

/-- For every fixed cutoff, the exact Gaussian cosine remainder is continuous
in the spatial parameter. -/
theorem continuous_prawitzGaussianCosineRemainder (T : ℝ) :
    Continuous (prawitzGaussianCosineRemainder T) := by
  unfold prawitzGaussianCosineRemainder
  apply continuous_parametric_integral_of_continuous
  · unfold prawitzFejerFrequencyWeight
    fun_prop
  · exact isCompact_Icc

/-- On every nonempty compact spatial interval, the exact Gaussian cosine
remainder attains its maximum. -/
theorem exists_prawitzGaussianCosineRemainder_isMaxOn_Icc
    (T : ℝ) {a b : ℝ} (hab : a ≤ b) :
    ∃ x ∈ Icc a b, ∀ y ∈ Icc a b,
      prawitzGaussianCosineRemainder T y ≤
        prawitzGaussianCosineRemainder T x := by
  simpa only [IsMaxOn] using
    isCompact_Icc.exists_isMaxOn (nonempty_Icc.mpr hab)
      (continuous_prawitzGaussianCosineRemainder T).continuousOn

/-- For a fixed Prawitz window, the exact Gaussian cosine remainder vanishes
in the positive spatial tail.  Thus the obstruction at `x = 0` is not a
uniform spatial floor; a sharper comparison may localize the remaining joint
frequency/spatial estimate to a bounded `x`-region. -/
theorem tendsto_prawitzGaussianCosineRemainder_atTop
    (T : ℝ) :
    Tendsto (prawitzGaussianCosineRemainder T) atTop (𝓝 0) := by
  let f : ℝ → ℝ := (Icc (0 : ℝ) T).indicator fun t =>
    2 * prawitzFejerFrequencyWeight T t * Real.exp (-(t ^ 2) / 2)
  have hf : Integrable f := by
    have hamp : IntegrableOn (fun t : ℝ =>
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2)) (Icc (0 : ℝ) T) := by
      apply Continuous.integrableOn_Icc
      unfold prawitzFejerFrequencyWeight
      fun_prop
    exact hamp.integrable_indicator measurableSet_Icc
  have hscale :
      Tendsto (fun x : ℝ => (2 * Real.pi)⁻¹ * x) atTop atTop :=
    tendsto_id.const_mul_atTop
      (inv_pos.mpr (mul_pos (by norm_num) Real.pi_pos))
  have hrl :=
    (tendsto_integral_cos_mul_atTop_of_integrable f hf).comp hscale
  convert hrl using 1
  funext x
  unfold prawitzGaussianCosineRemainder
  rw [← integral_indicator measurableSet_Icc]
  apply integral_congr_ae
  filter_upwards with t
  by_cases ht : t ∈ Icc (0 : ℝ) T
  · rw [Set.indicator_of_mem ht]
    simp only [f, Set.indicator_of_mem ht]
    have harg :
        2 * Real.pi * t * ((2 * Real.pi)⁻¹ * x) = x * t := by
      field_simp [Real.pi_ne_zero]
    rw [harg]
    ring
  · simp only [Set.indicator_of_notMem ht, f, mul_zero]

/-- The exact Gaussian cosine remainder is even in the spatial parameter. -/
theorem prawitzGaussianCosineRemainder_neg (T x : ℝ) :
    prawitzGaussianCosineRemainder T (-x) =
      prawitzGaussianCosineRemainder T x := by
  unfold prawitzGaussianCosineRemainder
  apply integral_congr_ae
  filter_upwards with t
  rw [neg_mul, Real.cos_neg]

/-- For a fixed Prawitz window, the exact Gaussian cosine remainder also
vanishes in the negative spatial tail. -/
theorem tendsto_prawitzGaussianCosineRemainder_atBot
    (T : ℝ) :
    Tendsto (prawitzGaussianCosineRemainder T) atBot (𝓝 0) := by
  have h := (tendsto_prawitzGaussianCosineRemainder_atTop T).comp
    tendsto_neg_atBot_atTop
  refine Tendsto.congr' ?_ h
  filter_upwards with x
  simpa only [Function.comp_apply] using
    prawitzGaussianCosineRemainder_neg T x

/-- The forward Prawitz error with its characteristic-function phase and the
exact Gaussian cosine term kept together. -/
noncomputable def prawitzPhasePreservingRemainder
    (mu : Measure ℝ) (T x : ℝ) : ℝ :=
  ((Complex.I / (Real.pi : ℝ)) *
      (∫ t in Icc (0 : ℝ) T,
        (prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
          prawitzPVIntegrand T
            (MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
            x t))).re +
    prawitzGaussianCosineRemainder T x

/-- The zero-spatial positive-frequency amplitude of a Prawitz difference. -/
noncomputable def prawitzZeroPhaseDifference
    (mu nu : Measure ℝ) (T t : ℝ) : ℂ :=
  prawitzPVIntegrand T (MeasureTheory.charFun mu) 0 t -
    prawitzPVIntegrand T (MeasureTheory.charFun nu) 0 t

/-- Real coordinate of the zero-phase Prawitz amplitude, retaining the real
and imaginary filter/discrepancy interaction exactly. -/
theorem prawitzZeroPhaseDifference_re
    (mu nu : Measure ℝ) (T t : ℝ) :
    (prawitzZeroPhaseDifference mu nu T t).re =
      ((scaledPrawitzSmoothingFilter T t).re *
          (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t).re -
        (scaledPrawitzSmoothingFilter T t).im *
          (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t).im) / t := by
  unfold prawitzZeroPhaseDifference prawitzPVIntegrand prawitzPVNumerator
  simp only [mul_zero, neg_zero, Complex.ofReal_zero, zero_mul,
    Complex.exp_zero, one_mul]
  rw [← sub_div, ← mul_sub]
  rw [Complex.div_ofReal_re, Complex.mul_re]

/-- Imaginary coordinate of the zero-phase Prawitz amplitude, retaining the
real and imaginary filter/discrepancy interaction exactly. -/
theorem prawitzZeroPhaseDifference_im
    (mu nu : Measure ℝ) (T t : ℝ) :
    (prawitzZeroPhaseDifference mu nu T t).im =
      ((scaledPrawitzSmoothingFilter T t).re *
          (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t).im +
        (scaledPrawitzSmoothingFilter T t).im *
          (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t).re) / t := by
  unfold prawitzZeroPhaseDifference prawitzPVIntegrand prawitzPVNumerator
  simp only [mul_zero, neg_zero, Complex.ofReal_zero, zero_mul,
    Complex.exp_zero, one_mul]
  rw [← sub_div, ← mul_sub]
  rw [Complex.div_ofReal_im, Complex.mul_im]

/-- Interior-window real coordinate after substituting the exact cotangent
and triangular coordinates of the scaled Prawitz filter. -/
theorem prawitzZeroPhaseDifference_re_of_mem_Ioo
    (mu nu : Measure ℝ) {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) :
    (prawitzZeroPhaseDifference mu nu T t).re =
      (((1 - t / T) * prawitzCotFactor (t / T) + t / T) *
          (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t).re +
        ((1 - t / T) * Real.pi * (t / T)) *
          (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t).im) / t := by
  rw [prawitzZeroPhaseDifference_re mu nu T t,
    scaledPrawitzSmoothingFilter_re_of_mem_Ico hT ht.1.le ht.2,
    scaledPrawitzSmoothingFilter_im_of_mem_Ico hT ht.1.le ht.2]
  ring

/-- Interior-window imaginary coordinate after substituting the exact
cotangent and triangular coordinates of the scaled Prawitz filter. -/
theorem prawitzZeroPhaseDifference_im_of_mem_Ioo
    (mu nu : Measure ℝ) {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) :
    (prawitzZeroPhaseDifference mu nu T t).im =
      (((1 - t / T) * prawitzCotFactor (t / T) + t / T) *
          (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t).im -
        ((1 - t / T) * Real.pi * (t / T)) *
          (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t).re) / t := by
  rw [prawitzZeroPhaseDifference_im mu nu T t,
    scaledPrawitzSmoothingFilter_re_of_mem_Ico hT ht.1.le ht.2,
    scaledPrawitzSmoothingFilter_im_of_mem_Ico hT ht.1.le ht.2]
  ring

/-- Exact normalized-iid characteristic-function discrepancy as the power of
the common summand characteristic function minus the real Gaussian factor. -/
theorem charFun_normalizedCenteredIidSum_sub_standardNormalLaw_eq_pow
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) (t : ℝ) :
    MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
              X hX N).aemeasurable : Measure ℝ) t -
        MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t =
      (MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            (X 0) (hX 0).aemeasurable : Measure ℝ)
          (t / Real.sqrt (N + 1 : ℝ))) ^ (N + 1) -
        ((Real.exp (-(t ^ 2) / 2) : ℝ) : ℂ) := by
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_charFun,
    NumStability.HDP.Scalar.LimitTheorems.charFun_probabilityLaw_normalizedCenteredIidSum
      X hX hIndep hIdent N t]
  have hcf := NumStability.HDP.Scalar.LimitTheorems.charFun_probabilityLaw
    (X 0) (hX 0).aemeasurable (t / Real.sqrt (N + 1 : ℝ))
  rw [hcf]
  congr 2
  · apply integral_congr_ae
    filter_upwards with omega
    congr 1
    push_cast
    ring
  · rw [Complex.ofReal_exp]
    congr 1
    push_cast
    ring

/-- The zero-phase Prawitz difference is the scaled filter times the raw
characteristic-function discrepancy, divided by the real frequency. -/
theorem prawitzZeroPhaseDifference_eq_filter_mul_charFun_sub
    (mu nu : Measure ℝ) (T t : ℝ) :
    prawitzZeroPhaseDifference mu nu T t =
      scaledPrawitzSmoothingFilter T t *
        (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t) / t := by
  unfold prawitzZeroPhaseDifference prawitzPVIntegrand prawitzPVNumerator
  simp only [mul_zero, neg_zero, Complex.ofReal_zero, zero_mul,
    Complex.exp_zero, one_mul]
  rw [← sub_div, ← mul_sub]

/-- Exact normalized-iid discrepancy factorization into the one-step Taylor
residual, its full complex geometric coefficient, and the real Gaussian-proxy
correction. -/
theorem charFun_normalizedCenteredIidSum_sub_standardNormalLaw_eq_taylorGeomSum
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) (t : ℝ) :
    MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
              X hX N).aemeasurable : Measure ℝ) t -
        MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t =
      (MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            (X 0) (hX 0).aemeasurable : Measure ℝ)
          (t / Real.sqrt (N + 1 : ℝ)) -
        ((1 - (t / Real.sqrt (N + 1 : ℝ)) ^ 2 / 2 : ℝ) : ℂ)) *
        complexPowerRealBaselineGeomSum
          (MeasureTheory.charFun
            (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
              (X 0) (hX 0).aemeasurable : Measure ℝ)
            (t / Real.sqrt (N + 1 : ℝ)))
          (1 - (t / Real.sqrt (N + 1 : ℝ)) ^ 2 / 2) (N + 1) +
        ((((1 - (t / Real.sqrt (N + 1 : ℝ)) ^ 2 / 2) ^ (N + 1) -
          Real.exp (-(t ^ 2) / 2) : ℝ)) : ℂ) := by
  rw [charFun_normalizedCenteredIidSum_sub_standardNormalLaw_eq_pow
    X hX hIndep hIdent N t]
  exact complex_pow_sub_real_eq_taylorGeomSum _ _ _ _

/-- Exact Taylor-product factorization inside the zero-phase Prawitz amplitude
for a normalized centered iid sum. No absolute value or complex norm is taken. -/
theorem prawitzZeroPhaseDifference_normalizedCenteredIidSum_eq_taylorGeomSum
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) (T t : ℝ) :
    prawitzZeroPhaseDifference
        (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
            X hX N).aemeasurable)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw T t =
      scaledPrawitzSmoothingFilter T t *
        ((MeasureTheory.charFun
            (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
              (X 0) (hX 0).aemeasurable : Measure ℝ)
            (t / Real.sqrt (N + 1 : ℝ)) -
          ((1 - (t / Real.sqrt (N + 1 : ℝ)) ^ 2 / 2 : ℝ) : ℂ)) *
          complexPowerRealBaselineGeomSum
            (MeasureTheory.charFun
              (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
                (X 0) (hX 0).aemeasurable : Measure ℝ)
              (t / Real.sqrt (N + 1 : ℝ)))
            (1 - (t / Real.sqrt (N + 1 : ℝ)) ^ 2 / 2) (N + 1) +
          ((((1 - (t / Real.sqrt (N + 1 : ℝ)) ^ 2 / 2) ^ (N + 1) -
            Real.exp (-(t ^ 2) / 2) : ℝ)) : ℂ)) / t := by
  rw [prawitzZeroPhaseDifference_eq_filter_mul_charFun_sub,
    charFun_normalizedCenteredIidSum_sub_standardNormalLaw_eq_taylorGeomSum
      X hX hIndep hIdent N t]

/-- Real coordinate of a filtered complex Taylor residual times its geometric
coefficient, with a separate real correction and real frequency divisor. -/
theorem complex_mul_taylorProduct_div_re
    (k r s : ℂ) (c t : ℝ) :
    (k * (r * s + (c : ℂ)) / t).re =
      (k.re * (r.re * s.re - r.im * s.im + c) -
        k.im * (r.re * s.im + r.im * s.re)) / t := by
  rw [Complex.div_ofReal_re]
  simp only [Complex.mul_re, Complex.mul_im, Complex.add_re, Complex.add_im,
    Complex.ofReal_re, Complex.ofReal_im]
  ring

/-- Imaginary coordinate of a filtered complex Taylor residual times its
geometric coefficient, with a separate real correction and real frequency
divisor. -/
theorem complex_mul_taylorProduct_div_im
    (k r s : ℂ) (c t : ℝ) :
    (k * (r * s + (c : ℂ)) / t).im =
      (k.re * (r.re * s.im + r.im * s.re) +
        k.im * (r.re * s.re - r.im * s.im + c)) / t := by
  rw [Complex.div_ofReal_im]
  simp only [Complex.mul_re, Complex.mul_im, Complex.add_re, Complex.add_im,
    Complex.ofReal_re, Complex.ofReal_im]
  ring

/-- Real coordinate of a filtered conjugated complex Taylor residual times
its geometric coefficient, with a separate real correction and divisor. -/
theorem complex_mul_conj_taylorProduct_div_re
    (k r s : ℂ) (c t : ℝ) :
    (k * (starRingEnd ℂ) (r * s + (c : ℂ)) / t).re =
      (k.re * (r.re * s.re - r.im * s.im + c) +
        k.im * (r.re * s.im + r.im * s.re)) / t := by
  rw [Complex.div_ofReal_re]
  simp only [Complex.mul_re, Complex.mul_im, map_add, map_mul,
    Complex.conj_re, Complex.conj_im, Complex.add_re, Complex.add_im,
    Complex.ofReal_re, Complex.ofReal_im]
  ring

/-- Imaginary coordinate of a filtered conjugated complex Taylor residual
times its geometric coefficient, with a separate real correction and divisor. -/
theorem complex_mul_conj_taylorProduct_div_im
    (k r s : ℂ) (c t : ℝ) :
    (k * (starRingEnd ℂ) (r * s + (c : ℂ)) / t).im =
      (-k.re * (r.re * s.im + r.im * s.re) +
        k.im * (r.re * s.re - r.im * s.im + c)) / t := by
  rw [Complex.div_ofReal_im]
  simp only [Complex.mul_im, map_add, map_mul,
    Complex.conj_re, Complex.conj_im, Complex.add_re, Complex.add_im,
    Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im]
  ring

/-- Adding the forward and reflected Taylor phases cancels every real-filter
contribution, leaving only the imaginary filter coordinate. -/
theorem prawitzTaylorPhaseCoordinates_add
    (k r s : ℂ) (c t theta : ℝ) :
    (Real.sin theta *
          ((k.re * (r.re * s.re - r.im * s.im + c) -
              k.im * (r.re * s.im + r.im * s.re)) / t) -
        Real.cos theta *
          ((k.re * (r.re * s.im + r.im * s.re) +
              k.im * (r.re * s.re - r.im * s.im + c)) / t)) +
      (-Real.sin theta *
          ((k.re * (r.re * s.re - r.im * s.im + c) +
              k.im * (r.re * s.im + r.im * s.re)) / t) -
        Real.cos theta *
          ((-k.re * (r.re * s.im + r.im * s.re) +
              k.im * (r.re * s.re - r.im * s.im + c)) / t)) =
      -2 * k.im *
        (Real.sin theta * (r.re * s.im + r.im * s.re) +
          Real.cos theta * (r.re * s.re - r.im * s.im + c)) / t := by
  ring

/-- Subtracting the reflected Taylor phase from the forward phase cancels
every imaginary-filter contribution, leaving only the real filter coordinate. -/
theorem prawitzTaylorPhaseCoordinates_sub
    (k r s : ℂ) (c t theta : ℝ) :
    (Real.sin theta *
          ((k.re * (r.re * s.re - r.im * s.im + c) -
              k.im * (r.re * s.im + r.im * s.re)) / t) -
        Real.cos theta *
          ((k.re * (r.re * s.im + r.im * s.re) +
              k.im * (r.re * s.re - r.im * s.im + c)) / t)) -
      (-Real.sin theta *
          ((k.re * (r.re * s.re - r.im * s.im + c) +
              k.im * (r.re * s.im + r.im * s.re)) / t) -
        Real.cos theta *
          ((-k.re * (r.re * s.im + r.im * s.re) +
              k.im * (r.re * s.re - r.im * s.im + c)) / t)) =
      2 * k.re *
        (Real.sin theta * (r.re * s.re - r.im * s.im + c) -
          Real.cos theta * (r.re * s.im + r.im * s.re)) / t := by
  ring

/-- Exact real coordinate of the normalized-iid Prawitz Taylor-product
amplitude. The filter, residual, geometric coefficient, and real correction
remain separately visible. -/
theorem prawitzZeroPhaseDifference_normalizedCenteredIidSum_re_eq_taylorCoordinates
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) (T t : ℝ) :
    let u : ℝ := t / Real.sqrt (N + 1 : ℝ)
    let phi : ℂ := MeasureTheory.charFun
      (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (X 0) (hX 0).aemeasurable : Measure ℝ) u
    let a : ℝ := 1 - u ^ 2 / 2
    let r : ℂ := phi - (a : ℂ)
    let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
    let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
    (prawitzZeroPhaseDifference
        (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
            X hX N).aemeasurable)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw T t).re =
      ((scaledPrawitzSmoothingFilter T t).re *
          (r.re * s.re - r.im * s.im + c) -
        (scaledPrawitzSmoothingFilter T t).im *
          (r.re * s.im + r.im * s.re)) / t := by
  dsimp only
  rw [prawitzZeroPhaseDifference_normalizedCenteredIidSum_eq_taylorGeomSum
    X hX hIndep hIdent N T t]
  exact complex_mul_taylorProduct_div_re _ _ _ _ _

/-- Exact imaginary coordinate of the normalized-iid Prawitz Taylor-product
amplitude. The filter, residual, geometric coefficient, and real correction
remain separately visible. -/
theorem prawitzZeroPhaseDifference_normalizedCenteredIidSum_im_eq_taylorCoordinates
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) (T t : ℝ) :
    let u : ℝ := t / Real.sqrt (N + 1 : ℝ)
    let phi : ℂ := MeasureTheory.charFun
      (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (X 0) (hX 0).aemeasurable : Measure ℝ) u
    let a : ℝ := 1 - u ^ 2 / 2
    let r : ℂ := phi - (a : ℂ)
    let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
    let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
    (prawitzZeroPhaseDifference
        (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
          (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
            X hX N).aemeasurable)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw T t).im =
      ((scaledPrawitzSmoothingFilter T t).re *
          (r.re * s.im + r.im * s.re) +
        (scaledPrawitzSmoothingFilter T t).im *
          (r.re * s.re - r.im * s.im + c)) / t := by
  dsimp only
  rw [prawitzZeroPhaseDifference_normalizedCenteredIidSum_eq_taylorGeomSum
    X hX hIndep hIdent N T t]
  exact complex_mul_taylorProduct_div_im _ _ _ _ _

/-- Real coordinate of the exact normalized-iid characteristic-function
discrepancy. -/
theorem charFun_normalizedCenteredIidSum_sub_standardNormalLaw_re
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) (t : ℝ) :
    (MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
            (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
              X hX N).aemeasurable : Measure ℝ) t -
        MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t).re =
