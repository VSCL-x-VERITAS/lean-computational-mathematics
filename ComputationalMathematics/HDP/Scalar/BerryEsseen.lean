        (Real.sqrt (2 * Real.pi))⁻¹)) *
          kolmogorovDistance nu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
        (Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹) *
          ((R ^ 2)⁻¹ * (((∫ y, |y| ^ 3 ∂nu) +
            4 * (Real.sqrt (2 * Real.pi))⁻¹) / 3)) := by
  calc
    kolmogorovDistance
        (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
        (Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹) *
          (2 * R * kolmogorovDistance nu
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
            (R ^ 2)⁻¹ * (((∫ y, |y| ^ 3 ∂nu) +
              4 * (Real.sqrt (2 * Real.pi))⁻¹) / 3)) :=
      h.kolmogorovDistance_normalizedGaussianStepLaw_le_central_tail N hR
    _ = _ := by ring

/-- The usable one-step estimate is the minimum of exact norm-one
nonexpansiveness and the quantitative central/tail smoothing branch. -/
theorem IsStandardizedThirdMomentLaw.kolmogorovDistance_normalizedGaussianStepLaw_le_min_central_tail
    {nu : Measure ℝ} {B R : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (N : ℕ) (hR : 0 < R) :
    kolmogorovDistance
      (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      min
        (kolmogorovDistance nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
        ((Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹) *
          (2 * R * kolmogorovDistance nu
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
            (R ^ 2)⁻¹ * (((∫ y, |y| ^ 3 ∂nu) +
              4 * (Real.sqrt (2 * Real.pi))⁻¹) / 3))) := by
  letI : IsProbabilityMeasure nu := h.probability
  apply le_min
  · exact kolmogorovDistance_normalizedGaussianStepLaw_le nu N
  · exact h.kolmogorovDistance_normalizedGaussianStepLaw_le_central_tail N hR

/-- Mechanical comparison of all three certified Gaussian-step branches:
norm-one transport, density-peak plus central/tail splitting, and the
second-order two-cancellation remainder. -/
theorem IsStandardizedThirdMomentLaw.kolmogorovDistance_normalizedGaussianStepLaw_le_min_three
    {nu : Measure ℝ} {B R : ℝ} (h : IsStandardizedThirdMomentLaw nu B)
    (N : ℕ) (hR : 0 < R) :
    kolmogorovDistance
      (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      min
        (kolmogorovDistance nu
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
        (min
          ((Real.sqrt (N + 1 : ℝ) * (Real.sqrt (2 * Real.pi))⁻¹) *
            (2 * R * kolmogorovDistance nu
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw +
              (R ^ 2)⁻¹ * (((∫ y, |y| ^ 3 ∂nu) +
                4 * (Real.sqrt (2 * Real.pi))⁻¹) / 3)))
          ((((3 * (Real.sqrt (2 * Real.pi))⁻¹) / 2) *
              (Real.sqrt (N + 1 : ℝ)) ^ 3) *
            (((∫ y, |y| ^ 3 ∂nu) +
              4 * (Real.sqrt (2 * Real.pi))⁻¹) / 3))) := by
  letI : IsProbabilityMeasure nu := h.probability
  apply le_min
  · exact kolmogorovDistance_normalizedGaussianStepLaw_le nu N
  · apply le_min
    · exact h.kolmogorovDistance_normalizedGaussianStepLaw_le_central_tail N hR
    · exact h.kolmogorovDistance_normalizedGaussianStepLaw_le_cancellation N

/-- The exact `L³` norm of the identity under the standard-normal law. -/
theorem lpNorm_id_standardNormal_three :
    lpNorm (fun y : ℝ => y) (3 : ℝ≥0∞)
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw =
      (4 * (Real.sqrt (2 * Real.pi))⁻¹) ^ ((3 : ℝ)⁻¹) := by
  rw [lpNorm_eq_integral_norm_rpow_toReal (p := (3 : ℝ≥0∞))
    (by norm_num) (by norm_num) (by fun_prop)]
  calc
    (∫ x : ℝ, ‖x‖ ^ ENNReal.toReal 3
        ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) ^
        (ENNReal.toReal 3)⁻¹ =
      (∫ x : ℝ, |x| ^ (3 : ℕ)
        ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) ^
        ((3 : ℝ)⁻¹) := by
          congr 1
          apply integral_congr_ae
          filter_upwards [] with x
          rw [Real.norm_eq_abs]
          norm_num
    _ = _ := congrArg (fun r : ℝ => r ^ ((3 : ℝ)⁻¹))
      integral_standardNormal_abs_cube

/-- Explicit quantitative third-moment-root envelope for one Gaussian
keep/innovation step. -/
theorem lpNorm_normalizedGaussianStepLaw_le_explicit
    (N : ℕ) (nu : Measure ℝ) [IsProbabilityMeasure nu]
    (hnu3 : Integrable (fun y : ℝ => |y| ^ 3) nu) :
    lpNorm (fun y : ℝ => y) 3 (normalizedGaussianStepLaw N nu) ≤
      normalizedGaussianInnovationCoefficient N *
          (4 * (Real.sqrt (2 * Real.pi))⁻¹) ^ ((3 : ℝ)⁻¹) +
        normalizedGaussianKeepCoefficient N * lpNorm (fun y : ℝ => y) 3 nu := by
  simpa only [lpNorm_id_standardNormal_three] using
    lpNorm_normalizedGaussianStepLaw_le N nu hnu3

/-- Explicit bounded standardized-law transport using the exact
standard-normal third-moment root. -/
theorem IsStandardizedThirdMomentLaw.normalizedGaussianStepLaw_explicit
    {nu : Measure ℝ} {B : ℝ} (h : IsStandardizedThirdMomentLaw nu B) (N : ℕ) :
    IsStandardizedThirdMomentLaw
      (NumStability.HDP.Scalar.BerryEsseen.normalizedGaussianStepLaw N nu)
      (normalizedGaussianInnovationCoefficient N *
          (4 * (Real.sqrt (2 * Real.pi))⁻¹) ^ ((3 : ℝ)⁻¹) +
        normalizedGaussianKeepCoefficient N * B) := by
  simpa only [lpNorm_id_standardNormal_three] using
    IsStandardizedThirdMomentLaw.normalizedGaussianStepLaw h N

/-- Complete uniform-smoothing reduction for comparison with the standard
normal law. The only remaining quantitative input is the integral of the
smoothed characteristic-function discrepancy quotient. -/
theorem kolmogorovDistance_standardNormal_le_uniformSmoothing
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun x : ℝ => |x|) mu)
    {delta : ℝ} (hdelta : 0 < delta) :
    kolmogorovDistance mu
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ≤
      (2 * Real.pi)⁻¹ * (∫ t : ℝ, charFunDiscrepancyQuotient
        (uniformSmoothingKernel delta ∗ mu)
        (uniformSmoothingKernel delta ∗
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) t) +
        (Real.sqrt (2 * Real.pi))⁻¹ * (2 * delta) := by
  letI : IsProbabilityMeasure (uniformSmoothingKernel delta) :=
    uniformSmoothingKernel_isProbabilityMeasure hdelta
  apply kolmogorovDistance_standardNormal_le_of_smoothing_approximation
    mu hdelta.le
    (uniformSmoothedCDF_isSmoothingApproximation mu hdelta)
    (uniformSmoothedCDF_isSmoothingApproximation
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hdelta)
  intro x
  rw [smoothedCDF_eq_cdf_conv, smoothedCDF_eq_cdf_conv]
  exact cdfGap_uniformSmoothingKernel_conv_le_integral_discrepancy_scaled
    mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
    hmu1 integrable_abs_standardNormalLaw hdelta x

/-- Sharp global cubic remainder for the imaginary-axis exponential. Two
applications of the fundamental theorem of calculus preserve the optimal
Taylor coefficient because `x ↦ exp (i x)` has unit speed. -/
theorem norm_cexp_mul_I_sub_quadratic_le_sharp (y : ℝ) :
    ‖Complex.exp ((y : ℂ) * Complex.I) - 1 - (y : ℂ) * Complex.I +
        (((y ^ 2 : ℝ) : ℂ) / 2)‖ ≤ |y| ^ 3 / 6 := by
  let f : ℝ → ℂ := fun x => Complex.exp ((x : ℂ) * Complex.I)
  let f2 : ℝ → ℂ := fun x => -f x + 1
  let f1 : ℝ → ℂ := fun x => f x * Complex.I - Complex.I + x
  let R : ℝ → ℂ := fun x =>
    f x - 1 - x * Complex.I + (((x ^ 2 : ℝ) : ℂ) / 2)
  have hf (x : ℝ) : HasDerivAt f (f x * Complex.I) x := by
    convert
      ((Complex.ofRealCLM.hasDerivAt (x := x)).mul_const Complex.I).cexp
        using 1
    change Complex.exp ((x : ℂ) * Complex.I) * Complex.I =
      Complex.exp ((x : ℂ) * Complex.I) * ((1 : ℂ) * Complex.I)
    norm_num
  have hf2 (x : ℝ) : HasDerivAt f1 (f2 x) x := by
    have hfi : HasDerivAt (fun z => f z * Complex.I) (-f x) x := by
      convert (hf x).mul_const Complex.I using 1
      rw [mul_assoc, Complex.I_mul_I]
      ring
    have hone : HasDerivAt (fun z : ℝ => (z : ℂ)) 1 x := by
      convert Complex.ofRealCLM.hasDerivAt (x := x) using 1
    convert (hfi.sub_const Complex.I).add hone using 1
  have hR (x : ℝ) : HasDerivAt R (f1 x) x := by
    have hxi : HasDerivAt (fun z : ℝ => (z : ℂ) * Complex.I) Complex.I x := by
      convert (Complex.ofRealCLM.hasDerivAt (x := x)).mul_const Complex.I using 1
      change Complex.I = Complex.ofRealCLM 1 * Complex.I
      rw [Complex.ofRealCLM_apply]
      norm_num
    have hx2 : HasDerivAt
        (fun z : ℝ => (((z ^ 2 : ℝ) : ℂ) / 2)) (x : ℂ) x := by
      convert (((hasDerivAt_id x).pow 2).ofReal_comp).div_const 2 using 1
      norm_num
    convert (((hf x).sub_const 1).sub hxi).add hx2 using 1
  have hf2cont : Continuous f2 := by
    dsimp only [f2, f]
    fun_prop
  have hf1cont : Continuous f1 := by
    dsimp only [f1, f]
    fun_prop
  have hpos : ∀ x : ℝ, 0 ≤ x → ‖R x‖ ≤ x ^ 3 / 6 := by
    intro x hx
    have hnorm2 : ∀ z ∈ Icc (0 : ℝ) x, ‖f2 z‖ ≤ z := by
      intro z hz
      dsimp only [f2, f]
      calc
        ‖-Complex.exp ((z : ℂ) * Complex.I) + 1‖ =
            ‖Complex.exp ((z : ℂ) * Complex.I) - 1‖ := by
          rw [← norm_neg]
          congr 1
          ring
        _ ≤ z := by
          simpa only [mul_comm, Real.norm_eq_abs, abs_of_nonneg hz.1] using
            (Real.norm_exp_I_mul_ofReal_sub_one_le (x := z))
    have hnorm1 : ∀ z ∈ Icc (0 : ℝ) x, ‖f1 z‖ ≤ z ^ 2 / 2 := by
      intro z hz
      have hFTCz : (∫ w in (0 : ℝ)..z, f2 w) = f1 z := by
        have h := intervalIntegral.integral_eq_sub_of_hasDerivAt
          (a := (0 : ℝ)) (b := z) (f := f1) (f' := f2)
          (fun w _ => hf2 w) (hf2cont.intervalIntegrable (a := 0) (b := z))
        simpa [f1, f] using h
      rw [← hFTCz]
      calc
        ‖∫ w in (0 : ℝ)..z, f2 w‖ ≤ ∫ w in (0 : ℝ)..z, w := by
          apply intervalIntegral.norm_integral_le_of_norm_le hz.1
          · exact ae_of_all volume fun w hw =>
              hnorm2 w ⟨hw.1.le, hw.2.trans hz.2⟩
          · exact continuous_id.intervalIntegrable (a := 0) (b := z)
        _ = z ^ 2 / 2 := by norm_num
    have hFTCR : (∫ z in (0 : ℝ)..x, f1 z) = R x := by
      have h := intervalIntegral.integral_eq_sub_of_hasDerivAt
        (a := (0 : ℝ)) (b := x) (f := R) (f' := f1)
        (fun z _ => hR z) (hf1cont.intervalIntegrable (a := 0) (b := x))
      simpa [R, f] using h
    rw [← hFTCR]
    calc
      ‖∫ z in (0 : ℝ)..x, f1 z‖ ≤ ∫ z in (0 : ℝ)..x, z ^ 2 / 2 := by
        apply intervalIntegral.norm_integral_le_of_norm_le hx
        · exact ae_of_all volume fun z hz => hnorm1 z ⟨hz.1.le, hz.2⟩
        · exact (by fun_prop : Continuous fun z : ℝ => z ^ 2 / 2) |>.intervalIntegrable
            (a := 0) (b := x)
      _ = x ^ 3 / 6 := by norm_num; ring
  change ‖R y‖ ≤ |y| ^ 3 / 6
  by_cases hy : 0 ≤ y
  · simpa only [abs_of_nonneg hy] using hpos y hy
  · have hneg : 0 ≤ -y := le_of_lt (neg_pos.mpr (lt_of_not_ge hy))
    have hsymmetric : ‖R y‖ = ‖R (-y)‖ := by
      rw [← Complex.norm_conj]
      congr 1
      dsimp only [R, f]
      simp only [map_add, map_sub, map_mul, map_div₀,
        Complex.conj_ofReal, Complex.conj_I, map_ofNat]
      rw [← Complex.exp_conj]
      simp [map_mul, Complex.conj_ofReal, Complex.conj_I]
    rw [hsymmetric]
    simpa only [abs_of_neg (lt_of_not_ge hy)] using hpos (-y) hneg

/-- A global cubic remainder bound for the imaginary-axis exponential.

The constant is deliberately nonoptimal. Its global form is the useful point:
after substituting `y = u * X`, a finite third absolute moment supplies an
integrable majorant without any boundedness assumption on `X`. -/
theorem norm_cexp_mul_I_sub_quadratic_le (y : ℝ) :
    ‖Complex.exp ((y : ℂ) * Complex.I) - 1 - (y : ℂ) * Complex.I +
        (((y ^ 2 : ℝ) : ℂ) / 2)‖ ≤
      4 * |y| ^ 3 := by
  by_cases hy : |y| ≤ 1
  · have hz : ‖(y : ℂ) * Complex.I‖ ≤ 1 := by
      simpa [Complex.norm_mul, Real.norm_eq_abs] using hy
    calc
      ‖Complex.exp ((y : ℂ) * Complex.I) - 1 - (y : ℂ) * Complex.I +
          (((y ^ 2 : ℝ) : ℂ) / 2)‖ =
          ‖Complex.exp ((y : ℂ) * Complex.I) -
            ∑ m ∈ Finset.range 3,
              (((y : ℂ) * Complex.I) ^ m / m.factorial)‖ := by
            congr 1
            simp [Finset.sum_range_succ, Nat.factorial]
            ring_nf
            rw [Complex.I_sq]
            ring
      _ ≤ ‖(y : ℂ) * Complex.I‖ ^ 3 *
          ((Nat.succ 3 : ℝ) * ((Nat.factorial 3) * (3 : ℕ) : ℝ)⁻¹) :=
        Complex.exp_bound hz (by decide)
      _ ≤ 4 * |y| ^ 3 := by
        simp [Real.norm_eq_abs, Nat.factorial]
        nlinarith [pow_nonneg (abs_nonneg y) 3]
  · have hy1 : 1 < |y| := lt_of_not_ge hy
    have hy1' : 1 ≤ |y| := hy1.le
    have hy_sq : |y| ≤ |y| ^ 2 := by
      nlinarith [mul_nonneg (abs_nonneg y) (sub_nonneg.mpr hy1')]
    have hy_cube : |y| ^ 2 ≤ |y| ^ 3 := by
      nlinarith [mul_nonneg (sq_nonneg |y|) (sub_nonneg.mpr hy1')]
    have hone_cube : 1 ≤ |y| ^ 3 :=
      hy1'.trans (hy_sq.trans hy_cube)
    calc
      ‖Complex.exp ((y : ℂ) * Complex.I) - 1 - (y : ℂ) * Complex.I +
          (((y ^ 2 : ℝ) : ℂ) / 2)‖ ≤
          ‖Complex.exp ((y : ℂ) * Complex.I)‖ + ‖(1 : ℂ)‖ +
            ‖(y : ℂ) * Complex.I‖ + ‖(((y ^ 2 : ℝ) : ℂ) / 2)‖ := by
              calc
                _ ≤ ‖Complex.exp ((y : ℂ) * Complex.I) - 1 -
                    (y : ℂ) * Complex.I‖ + ‖(((y ^ 2 : ℝ) : ℂ) / 2)‖ :=
                  norm_add_le _ _
                _ ≤ (‖Complex.exp ((y : ℂ) * Complex.I) - 1‖ +
                    ‖(y : ℂ) * Complex.I‖) +
                    ‖(((y ^ 2 : ℝ) : ℂ) / 2)‖ := by
                  gcongr
                  exact norm_sub_le _ _
                _ ≤ (‖Complex.exp ((y : ℂ) * Complex.I)‖ + ‖(1 : ℂ)‖ +
                    ‖(y : ℂ) * Complex.I‖) +
                    ‖(((y ^ 2 : ℝ) : ℂ) / 2)‖ := by
                  gcongr
                  exact norm_sub_le _ _
                _ = _ := by ring
      _ = 2 + |y| + |y| ^ 2 / 2 := by
        norm_num [Complex.norm_exp_ofReal_mul_I, Complex.norm_mul,
          Complex.norm_div, Real.norm_eq_abs, sq_abs]
      _ ≤ 4 * |y| ^ 3 := by
        nlinarith [hy_sq.trans hy_cube, hone_cube]

/-- The cubic exponential remainder passes through expectation under a finite
third absolute moment. This is the quantitative Taylor input used in the
characteristic-function half of Berry--Esseen. -/
theorem norm_integral_cexp_mul_I_sub_quadratic_le_sharp
    {Omega : Type*} [MeasurableSpace Omega] {mu : Measure Omega}
    (X : Omega → ℝ) (hX3 : Integrable (fun omega => |X omega| ^ 3) mu) (u : ℝ) :
    ‖∫ omega,
        (Complex.exp (((u * X omega : ℝ) : ℂ) * Complex.I) - 1 -
          ((u * X omega : ℝ) : ℂ) * Complex.I +
          ((((u * X omega) ^ 2 : ℝ) : ℂ) / 2)) ∂mu‖ ≤
      (|u| ^ 3 / 6) * ∫ omega, |X omega| ^ 3 ∂mu := by
  have hg : Integrable (fun omega => (|u| ^ 3 / 6) * |X omega| ^ 3) mu :=
    hX3.const_mul (|u| ^ 3 / 6)
  calc
    ‖∫ omega,
        (Complex.exp (((u * X omega : ℝ) : ℂ) * Complex.I) - 1 -
          ((u * X omega : ℝ) : ℂ) * Complex.I +
          ((((u * X omega) ^ 2 : ℝ) : ℂ) / 2)) ∂mu‖ ≤
        ∫ omega, (|u| ^ 3 / 6) * |X omega| ^ 3 ∂mu :=
      norm_integral_le_of_norm_le hg <| ae_of_all mu fun omega => by
        convert norm_cexp_mul_I_sub_quadratic_le_sharp (u * X omega) using 1
        simp only [abs_mul, mul_pow]; ring
    _ = (|u| ^ 3 / 6) * ∫ omega, |X omega| ^ 3 ∂mu := by
      rw [integral_const_mul]

/-- Coarser predecessor retained for compatibility with the already-certified
Berry--Esseen chain while the sharp coefficient is propagated incrementally. -/
theorem norm_integral_cexp_mul_I_sub_quadratic_le
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (X : Ω → ℝ) (hX3 : Integrable (fun ω => |X ω| ^ 3) μ) (u : ℝ) :
    ‖∫ ω,
        (Complex.exp (((u * X ω : ℝ) : ℂ) * Complex.I) - 1 -
          ((u * X ω : ℝ) : ℂ) * Complex.I +
          ((((u * X ω) ^ 2 : ℝ) : ℂ) / 2)) ∂μ‖ ≤
      4 * |u| ^ 3 * ∫ ω, |X ω| ^ 3 ∂μ := by
  have hg : Integrable (fun ω => 4 * |u| ^ 3 * |X ω| ^ 3) μ :=
    hX3.const_mul (4 * |u| ^ 3)
  calc
    ‖∫ ω,
        (Complex.exp (((u * X ω : ℝ) : ℂ) * Complex.I) - 1 -
          ((u * X ω : ℝ) : ℂ) * Complex.I +
          ((((u * X ω) ^ 2 : ℝ) : ℂ) / 2)) ∂μ‖ ≤
        ∫ ω, 4 * |u| ^ 3 * |X ω| ^ 3 ∂μ :=
      norm_integral_le_of_norm_le hg <| ae_of_all μ fun ω => by
        simpa only [abs_mul, mul_pow, mul_assoc] using
          norm_cexp_mul_I_sub_quadratic_le (u * X ω)
    _ = 4 * |u| ^ 3 * ∫ ω, |X ω| ^ 3 ∂μ := by
      rw [integral_const_mul]

/-- A centered unit-second-moment characteristic function differs from its
quadratic Taylor polynomial by at most one sixth of the cubic third-moment
term. This is the sharp Taylor input for the Berry--Esseen chain. -/
theorem norm_charFun_probabilityLaw_sub_quadratic_le_thirdMoment_sharp
    {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ]
    (X : Ω → ℝ) (hX : MemLp X 3 μ)
    (hMean : ∫ ω, X ω ∂μ = 0)
    (hSecond : ∫ ω, (X ω) ^ 2 ∂μ = 1)
    (t : ℝ) :
    ‖MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            X hX.aemeasurable : Measure ℝ) t -
        (1 - (t : ℂ) ^ 2 / 2)‖ ≤
      (|t| ^ 3 / 6) * ∫ ω, |X ω| ^ 3 ∂μ := by
  have hXint : Integrable X μ := hX.integrable (by norm_num)
  have hX2 : Integrable (fun ω => (X ω) ^ 2) μ :=
    (hX.mono_exponent (by norm_num : (2 : ENNReal) ≤ 3)).integrable_sq
  have hX3 : Integrable (fun ω => |X ω| ^ 3) μ := by
    simpa only [Real.norm_eq_abs] using hX.integrable_norm_pow (by norm_num)
  have hExp : Integrable
      (fun ω => Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I)) μ := by
    refine Integrable.of_bound (by fun_prop) 1 ?_
    exact ae_of_all μ fun ω => by
      simp only [Complex.norm_exp_ofReal_mul_I]
      norm_num
  have hOne : Integrable (fun _ : Ω => (1 : ℂ)) μ := integrable_const 1
  have hLin : Integrable
      (fun ω => ((t * X ω : ℝ) : ℂ) * Complex.I) μ :=
    ((hXint.const_mul t).ofReal).mul_const Complex.I
  have hQuadReal : Integrable (fun ω => (t * X ω) ^ 2) μ := by
    simpa only [mul_pow] using hX2.const_mul (t ^ 2)
  have hQuad : Integrable
      (fun ω => ((((t * X ω) ^ 2 : ℝ) : ℂ) / 2)) μ :=
    hQuadReal.ofReal.div_const 2
  have hLinZero :
      (∫ ω, ((t * X ω : ℝ) : ℂ) * Complex.I ∂μ) = 0 := by
    calc
      (∫ ω, ((t * X ω : ℝ) : ℂ) * Complex.I ∂μ) =
          (∫ ω, ((t * X ω : ℝ) : ℂ) ∂μ) * Complex.I :=
        integral_mul_const _ _
      _ = ((∫ ω, t * X ω ∂μ : ℝ) : ℂ) * Complex.I := by
        have hc : (∫ ω, ((t * X ω : ℝ) : ℂ) ∂μ) =
            ((∫ ω, t * X ω ∂μ : ℝ) : ℂ) := integral_complex_ofReal
        rw [hc]
      _ = ((t * ∫ ω, X ω ∂μ : ℝ) : ℂ) * Complex.I := by
        rw [integral_const_mul]
      _ = 0 := by rw [hMean]; simp
  have hQuadIntegral :
      (∫ ω, ((((t * X ω) ^ 2 : ℝ) : ℂ) / 2) ∂μ) =
        (t : ℂ) ^ 2 / 2 := by
    calc
      (∫ ω, ((((t * X ω) ^ 2 : ℝ) : ℂ) / 2) ∂μ) =
          (∫ ω, (((t * X ω) ^ 2 : ℝ) : ℂ) ∂μ) / 2 :=
        integral_div _ _
      _ = ((∫ ω, (t * X ω) ^ 2 ∂μ : ℝ) : ℂ) / 2 := by
        have hc : (∫ ω, (((t * X ω) ^ 2 : ℝ) : ℂ) ∂μ) =
            ((∫ ω, (t * X ω) ^ 2 ∂μ : ℝ) : ℂ) := integral_complex_ofReal
        rw [hc]
      _ = ((t ^ 2 * ∫ ω, (X ω) ^ 2 ∂μ : ℝ) : ℂ) / 2 := by
        congr 2
        simpa only [mul_pow] using
          (integral_const_mul (μ := μ) (t ^ 2) (fun ω => (X ω) ^ 2))
      _ = (t : ℂ) ^ 2 / 2 := by rw [hSecond]; norm_num
  have hsubExp :
      (∫ ω, Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) - 1 ∂μ) =
        (∫ ω, Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) ∂μ) -
          (∫ _ : Ω, (1 : ℂ) ∂μ) :=
    integral_sub hExp hOne
  have hsubLin :
      (∫ ω, Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) - 1 -
        ((t * X ω : ℝ) : ℂ) * Complex.I ∂μ) =
        (∫ ω, Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) - 1 ∂μ) -
          (∫ ω, ((t * X ω : ℝ) : ℂ) * Complex.I ∂μ) :=
    integral_sub (hExp.sub hOne) hLin
  have hRemainderIntegral :
      (∫ ω,
        (Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) - 1 -
          ((t * X ω : ℝ) : ℂ) * Complex.I +
          ((((t * X ω) ^ 2 : ℝ) : ℂ) / 2)) ∂μ) =
        (∫ ω, Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) ∂μ) - 1 +
          (t : ℂ) ^ 2 / 2 := by
    calc
      _ = (∫ ω, Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) - 1 -
            ((t * X ω : ℝ) : ℂ) * Complex.I ∂μ) +
          (∫ ω, ((((t * X ω) ^ 2 : ℝ) : ℂ) / 2) ∂μ) := by
        exact integral_add (hExp.sub hOne |>.sub hLin) hQuad
      _ = ((∫ ω, Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) - 1 ∂μ) -
            (∫ ω, ((t * X ω : ℝ) : ℂ) * Complex.I ∂μ)) +
          (∫ ω, ((((t * X ω) ^ 2 : ℝ) : ℂ) / 2) ∂μ) := by
        rw [hsubLin]
      _ = (((∫ ω, Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) ∂μ) -
            (∫ _ : Ω, (1 : ℂ) ∂μ)) -
            (∫ ω, ((t * X ω : ℝ) : ℂ) * Complex.I ∂μ)) +
          (∫ ω, ((((t * X ω) ^ 2 : ℝ) : ℂ) / 2) ∂μ) := by
        rw [hsubExp]
      _ = _ := by rw [hLinZero, hQuadIntegral]; simp [integral_const]
  rw [NumStability.HDP.Scalar.LimitTheorems.charFun_probabilityLaw]
  simp_rw [← Complex.ofReal_mul]
  calc
    ‖(∫ ω, Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) ∂μ) -
        (1 - (t : ℂ) ^ 2 / 2)‖ =
        ‖∫ ω,
          (Complex.exp (((t * X ω : ℝ) : ℂ) * Complex.I) - 1 -
            ((t * X ω : ℝ) : ℂ) * Complex.I +
            ((((t * X ω) ^ 2 : ℝ) : ℂ) / 2)) ∂μ‖ := by
      rw [hRemainderIntegral]
      congr 1
      ring
    _ ≤ (|t| ^ 3 / 6) * ∫ ω, |X ω| ^ 3 ∂μ :=
      norm_integral_cexp_mul_I_sub_quadratic_le_sharp X hX3 t

/-- Sharp real-coordinate consequence of the cubic characteristic-function
Taylor remainder. -/
theorem abs_charFun_probabilityLaw_re_sub_quadratic_le_thirdMoment_sharp
    {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ]
    (X : Ω → ℝ) (hX : MemLp X 3 μ)
    (hMean : ∫ ω, X ω ∂μ = 0)
    (hSecond : ∫ ω, (X ω) ^ 2 ∂μ = 1)
    (t : ℝ) :
    |(MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            X hX.aemeasurable : Measure ℝ) t).re - (1 - t ^ 2 / 2)| ≤
      (|t| ^ 3 / 6) * ∫ ω, |X ω| ^ 3 ∂μ := by
  let q : ℂ := MeasureTheory.charFun
      (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        X hX.aemeasurable : Measure ℝ) t -
      ((1 - t ^ 2 / 2 : ℝ) : ℂ)
  have hproxy : ((1 - t ^ 2 / 2 : ℝ) : ℂ) =
      1 - (t : ℂ) ^ 2 / 2 := by
    push_cast
    ring
  have hq : ‖q‖ ≤ (|t| ^ 3 / 6) * ∫ ω, |X ω| ^ 3 ∂μ := by
    dsimp only [q]
    rw [hproxy]
    exact norm_charFun_probabilityLaw_sub_quadratic_le_thirdMoment_sharp
      X hX hMean hSecond t
  have hre : q.re =
      (MeasureTheory.charFun
        (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
          X hX.aemeasurable : Measure ℝ) t).re - (1 - t ^ 2 / 2) := by
    simp only [q, Complex.sub_re, Complex.ofReal_re]
  rw [← hre]
  exact (Complex.abs_re_le_norm q).trans hq

/-- Sharp imaginary-coordinate consequence of the cubic characteristic-function
Taylor remainder; centering removes its linear term. -/
theorem abs_charFun_probabilityLaw_im_le_thirdMoment_sharp
    {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ]
    (X : Ω → ℝ) (hX : MemLp X 3 μ)
