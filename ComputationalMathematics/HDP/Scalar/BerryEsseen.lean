/-- Exact sine/cosine coordinate expansion of the forward phase-preserving
Prawitz remainder. -/
theorem prawitzPhasePreservingRemainder_eq_integral_phaseCoordinates
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    prawitzPhasePreservingRemainder mu T x =
      ∫ t in Icc (0 : ℝ) T,
        (Real.sin (t * x) *
              (prawitzZeroPhaseDifference mu
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw T t).re -
            Real.cos (t * x) *
              (prawitzZeroPhaseDifference mu
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw T t).im) /
            Real.pi +
          2 * prawitzFejerFrequencyWeight T t *
            Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  let z : ℝ → ℂ := fun t =>
    prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
      prawitzPVIntegrand T
        (MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) x t
  let P : ℝ → ℂ := fun t => (Complex.I / (Real.pi : ℝ)) * z t
  let G : ℝ → ℝ := fun t =>
    2 * prawitzFejerFrequencyWeight T t *
      Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)
  have hz : IntegrableOn z (Icc (0 : ℝ) T) := by
    simpa only [z] using integrableOn_prawitzPVIntegrand_charFun_sub
      mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      hmu1 integrable_abs_standardNormalLaw hT x
  have hP : IntegrableOn P (Icc (0 : ℝ) T) := by
    simpa only [P] using hz.const_mul (Complex.I / (Real.pi : ℝ))
  have hG : IntegrableOn G (Icc (0 : ℝ) T) := by
    apply Continuous.integrableOn_Icc
    dsimp only [G]
    unfold prawitzFejerFrequencyWeight
    fun_prop
  unfold prawitzPhasePreservingRemainder prawitzGaussianCosineRemainder
  change ((Complex.I / (Real.pi : ℝ)) *
      (∫ t in Icc (0 : ℝ) T, z t)).re +
        ∫ t in Icc (0 : ℝ) T, G t = _
  calc
    ((Complex.I / (Real.pi : ℝ)) *
        (∫ t in Icc (0 : ℝ) T, z t)).re +
          ∫ t in Icc (0 : ℝ) T, G t =
        (∫ t in Icc (0 : ℝ) T, P t).re +
          ∫ t in Icc (0 : ℝ) T, G t := by
      congr 1
      exact congrArg Complex.re
        (integral_const_mul
          (μ := volume.restrict (Icc (0 : ℝ) T))
          (Complex.I / (Real.pi : ℝ)) z).symm
    _ = (∫ t in Icc (0 : ℝ) T, (P t).re) +
          ∫ t in Icc (0 : ℝ) T, G t := by
      exact congrArg (fun z : ℝ =>
        z + ∫ t in Icc (0 : ℝ) T, G t) (integral_re hP).symm
    _ = ∫ t in Icc (0 : ℝ) T, ((P t).re + G t) :=
      (integral_add hP.re hG).symm
    _ = _ := by
      apply integral_congr_ae
      filter_upwards with t
      dsimp only [P, z, G, prawitzZeroPhaseDifference]
      rw [prawitzPVIntegrand_charFun_sub_eq_phase_mul_zero]
      rw [Complex.mul_re, Complex.div_ofReal_re,
        Complex.div_ofReal_im, Complex.mul_re, Complex.mul_im]
      simp only [Complex.I_re, Complex.I_im, zero_div, one_div,
        zero_mul, Complex.exp_ofReal_mul_I_re,
        Complex.exp_ofReal_mul_I_im, Real.cos_neg, Real.sin_neg]
      field_simp [Real.pi_ne_zero]
      ring

/-- The exact forward sine/cosine phase-coordinate integrand is integrable on
the closed Prawitz window. This is the analytic bridge for later signed
coordinate cancellations. -/
theorem integrableOn_prawitzPhaseCoordinateIntegrand
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    IntegrableOn (fun t : ℝ =>
      (Real.sin (t * x) *
            (prawitzZeroPhaseDifference mu
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw T t).re -
          Real.cos (t * x) *
            (prawitzZeroPhaseDifference mu
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw T t).im) /
          Real.pi +
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)) (Icc (0 : ℝ) T) := by
  let z : ℝ → ℂ := fun t =>
    prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
      prawitzPVIntegrand T
        (MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) x t
  let P : ℝ → ℂ := fun t => (Complex.I / (Real.pi : ℝ)) * z t
  let G : ℝ → ℝ := fun t =>
    2 * prawitzFejerFrequencyWeight T t *
      Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)
  have hz : IntegrableOn z (Icc (0 : ℝ) T) := by
    simpa only [z] using integrableOn_prawitzPVIntegrand_charFun_sub
      mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      hmu1 integrable_abs_standardNormalLaw hT x
  have hP : IntegrableOn P (Icc (0 : ℝ) T) := by
    simpa only [P] using hz.const_mul (Complex.I / (Real.pi : ℝ))
  have hG : IntegrableOn G (Icc (0 : ℝ) T) := by
    apply Continuous.integrableOn_Icc
    dsimp only [G]
    unfold prawitzFejerFrequencyWeight
    fun_prop
  apply (hP.re.add hG).congr
  filter_upwards with t
  simp only [Pi.add_apply]
  change Complex.re (P t) + G t = _
  dsimp only [P, z, G, prawitzZeroPhaseDifference]
  rw [prawitzPVIntegrand_charFun_sub_eq_phase_mul_zero]
  rw [Complex.mul_re, Complex.div_ofReal_re,
    Complex.div_ofReal_im, Complex.mul_re, Complex.mul_im]
  simp only [Complex.I_re, Complex.I_im, zero_div, one_div,
    zero_mul, Complex.exp_ofReal_mul_I_re,
    Complex.exp_ofReal_mul_I_im, Real.cos_neg, Real.sin_neg]
  field_simp [Real.pi_ne_zero]
  ring

/-- Exact Taylor-coordinate expansion of the forward phase-preserving Prawitz
remainder for a normalized centered iid sum. Every signed filter, residual,
geometric-coefficient, and real Gaussian-correction term remains visible. -/
theorem prawitzPhasePreservingRemainder_normalizedCenteredIidSum_eq_integral_taylorCoordinates
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) {T : ℝ} (hT : 0 < T) (x : ℝ) :
    let law : Measure ℝ :=
      NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
          X hX N).aemeasurable
    prawitzPhasePreservingRemainder law T x =
      ∫ t in Icc (0 : ℝ) T,
        let u : ℝ := t / Real.sqrt (N + 1 : ℝ)
        let phi : ℂ := MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            (X 0) (hX 0).aemeasurable : Measure ℝ) u
        let a : ℝ := 1 - u ^ 2 / 2
        let r : ℂ := phi - (a : ℂ)
        let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
        let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
        (Real.sin (t * x) *
              (((scaledPrawitzSmoothingFilter T t).re *
                    (r.re * s.re - r.im * s.im + c) -
                  (scaledPrawitzSmoothingFilter T t).im *
                    (r.re * s.im + r.im * s.re)) / t) -
            Real.cos (t * x) *
              (((scaledPrawitzSmoothingFilter T t).re *
                    (r.re * s.im + r.im * s.re) +
                  (scaledPrawitzSmoothingFilter T t).im *
                    (r.re * s.re - r.im * s.im + c)) / t)) /
            Real.pi +
          2 * prawitzFejerFrequencyWeight T t *
            Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  dsimp only
  let Y : Omega → ℝ :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
  have hY : MemLp Y 2 mu :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp X hX N
  let law : Measure ℝ :=
    NumStability.HDP.Scalar.LimitTheorems.probabilityLaw Y hY.aemeasurable
  letI : IsProbabilityMeasure law := inferInstance
  have hLaw1 : Integrable (fun y : ℝ => |y|) law := by
    change Integrable (fun y : ℝ => |y|) (Measure.map Y mu)
    rw [integrable_map_measure (by fun_prop) hY.aemeasurable]
    simpa only [Function.comp_apply, Real.norm_eq_abs] using
      (hY.integrable (by norm_num)).norm
  rw [prawitzPhasePreservingRemainder_eq_integral_phaseCoordinates
    law hLaw1 hT x]
  apply integral_congr_ae
  filter_upwards with t
  rw [prawitzZeroPhaseDifference_normalizedCenteredIidSum_re_eq_taylorCoordinates
      X hX hIndep hIdent N T t,
    prawitzZeroPhaseDifference_normalizedCenteredIidSum_im_eq_taylorCoordinates
      X hX hIndep hIdent N T t]

/-- The phase-preserving forward Prawitz remainder is continuous in the
spatial parameter. -/
theorem continuous_prawitzPhasePreservingRemainder
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) :
    Continuous (prawitzPhasePreservingRemainder mu T) := by
  unfold prawitzPhasePreservingRemainder
  exact (Complex.continuous_re.comp
    (continuous_const.mul
      (continuous_setIntegral_prawitzPVIntegrand_charFun_sub
        mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
        hmu1 integrable_abs_standardNormalLaw hT))).add
    (continuous_prawitzGaussianCosineRemainder T)

/-- The phase-preserving forward Prawitz remainder vanishes in the positive
spatial tail. -/
theorem tendsto_prawitzPhasePreservingRemainder_atTop
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) :
    Tendsto (prawitzPhasePreservingRemainder mu T) atTop (𝓝 0) := by
  have hphase : Tendsto (fun x : ℝ =>
      (Complex.I / (Real.pi : ℝ)) *
        (∫ t in Icc (0 : ℝ) T,
          (prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            prawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t))) atTop (𝓝 0) := by
    simpa only [mul_zero] using
      (tendsto_const_nhds.mul
        (tendsto_setIntegral_prawitzPVIntegrand_charFun_sub_atTop
          mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
          hmu1 integrable_abs_standardNormalLaw hT) :
        Tendsto (fun x : ℝ =>
          (Complex.I / (Real.pi : ℝ)) *
            (∫ t in Icc (0 : ℝ) T,
              (prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
                prawitzPVIntegrand T
                  (MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                  x t))) atTop (𝓝 ((Complex.I / (Real.pi : ℝ)) * 0)))
  have hre := Complex.continuous_re.continuousAt.tendsto.comp hphase
  have hgauss := tendsto_prawitzGaussianCosineRemainder_atTop T
  simpa only [prawitzPhasePreservingRemainder, mul_zero,
    Complex.zero_re, zero_add] using hre.add hgauss

/-- The phase-preserving forward Prawitz remainder also vanishes in the
negative spatial tail. -/
theorem tendsto_prawitzPhasePreservingRemainder_atBot
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) :
    Tendsto (prawitzPhasePreservingRemainder mu T) atBot (𝓝 0) := by
  have hphase : Tendsto (fun x : ℝ =>
      (Complex.I / (Real.pi : ℝ)) *
        (∫ t in Icc (0 : ℝ) T,
          (prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            prawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t))) atBot (𝓝 0) := by
    simpa only [mul_zero] using
      (tendsto_const_nhds.mul
        (tendsto_setIntegral_prawitzPVIntegrand_charFun_sub_atBot
          mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
          hmu1 integrable_abs_standardNormalLaw hT) :
        Tendsto (fun x : ℝ =>
          (Complex.I / (Real.pi : ℝ)) *
            (∫ t in Icc (0 : ℝ) T,
              (prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
                prawitzPVIntegrand T
                  (MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                  x t))) atBot (𝓝 ((Complex.I / (Real.pi : ℝ)) * 0)))
  have hre := Complex.continuous_re.continuousAt.tendsto.comp hphase
  have hgauss := tendsto_prawitzGaussianCosineRemainder_atBot T
  simpa only [prawitzPhasePreservingRemainder, mul_zero,
    Complex.zero_re, zero_add] using hre.add hgauss

/-- A continuous real function vanishing in both tails has an
epsilon-accurate global upper bound given by a maximum on a symmetric compact
interval. -/
theorem exists_compact_max_le_global_max_epsilon_of_tendsto_zero
    (f : ℝ → ℝ) (hf : Continuous f)
    (htop : Tendsto f atTop (𝓝 0))
    (hbot : Tendsto f atBot (𝓝 0))
    {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    ∃ R x : ℝ, 0 ≤ R ∧ x ∈ Icc (-R) R ∧
      (∀ y ∈ Icc (-R) R, f y ≤ f x) ∧
      ∀ y : ℝ, f y ≤ max epsilon (f x) := by
  have htop' : ∀ᶠ y : ℝ in atTop, f y < epsilon := by
    simpa only [sub_pos] using
      ((tendsto_order.1 htop).2 epsilon hepsilon)
  have hbot' : ∀ᶠ y : ℝ in atBot, f y < epsilon := by
    simpa only [sub_pos] using
      ((tendsto_order.1 hbot).2 epsilon hepsilon)
  obtain ⟨a, ha⟩ := eventually_atTop.1 htop'
  obtain ⟨b, hb⟩ := eventually_atBot.1 hbot'
  let R : ℝ := max |a| |b|
  have hR : 0 ≤ R := by
    dsimp only [R]
    exact (abs_nonneg a).trans (le_max_left |a| |b|)
  have hinterval : (-R : ℝ) ≤ R := by linarith
  obtain ⟨x, hx, hmax⟩ :=
    isCompact_Icc.exists_isMaxOn (nonempty_Icc.mpr hinterval)
      hf.continuousOn
  refine ⟨R, x, hR, hx, hmax, ?_⟩
  intro y
  by_cases hy : y ∈ Icc (-R) R
  · exact (hmax hy).trans (le_max_right epsilon (f x))
  by_cases hyleft : y < -R
  · have hnegR_le_b : -R ≤ b := by
      have habs : |b| ≤ R := by
        dsimp only [R]
        exact le_max_right |a| |b|
      exact (neg_le_neg habs).trans (neg_abs_le b)
    exact (hb y ((le_of_lt hyleft).trans hnegR_le_b)).le.trans
      (le_max_left epsilon (f x))
  · have hR_lt_y : R < y := by
      have hnegR_le_y : -R ≤ y := le_of_not_gt hyleft
      exact lt_of_not_ge fun hyR => hy ⟨hnegR_le_y, hyR⟩
    have ha_le_R : a ≤ R := by
      have habs : |a| ≤ R := by
        dsimp only [R]
        exact le_max_left |a| |b|
      exact (le_abs_self a).trans habs
    exact (ha y (ha_le_R.trans (le_of_lt hR_lt_y))).le.trans
      (le_max_left epsilon (f x))

/-- The phase-preserving Prawitz remainder is globally controlled, up to any
positive epsilon, by an attained maximum on a symmetric compact interval. -/
theorem exists_prawitzPhasePreservingRemainder_compact_max_le_global
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T)
    {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    ∃ R x : ℝ, 0 ≤ R ∧ x ∈ Icc (-R) R ∧
      (∀ y ∈ Icc (-R) R,
        prawitzPhasePreservingRemainder mu T y ≤
          prawitzPhasePreservingRemainder mu T x) ∧
      ∀ y : ℝ, prawitzPhasePreservingRemainder mu T y ≤
        max epsilon (prawitzPhasePreservingRemainder mu T x) := by
  exact exists_compact_max_le_global_max_epsilon_of_tendsto_zero
    (prawitzPhasePreservingRemainder mu T)
    (continuous_prawitzPhasePreservingRemainder mu hmu1 hT)
    (tendsto_prawitzPhasePreservingRemainder_atTop mu hmu1 hT)
    (tendsto_prawitzPhasePreservingRemainder_atBot mu hmu1 hT)
    hepsilon

/-- Exact truncation decomposition of the Gaussian Prawitz cosine term.  The
full positive-half-line transform is evaluated, while both the Gaussian tail
and the triangular first-moment correction remain signed. -/
theorem prawitzGaussianCosineRemainder_eq_full_sub_tail_sub_correction
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    prawitzGaussianCosineRemainder T x =
      (Real.sqrt (2 * Real.pi) / T) * Real.exp (-(x ^ 2) / 2) -
        (2 / T) * (∫ t in Ioi T,
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)) -
        (2 / T ^ 2) * (∫ t in Icc (0 : ℝ) T,
          t * (Real.exp (-(t ^ 2) / 2) * Real.cos (x * t))) := by
  let f : ℝ → ℝ := fun t =>
    Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)
  have hgauss : Integrable (fun t : ℝ => Real.exp (-(t ^ 2) / 2)) := by
    have h := integrable_exp_neg_mul_sq (by norm_num : (0 : ℝ) < 1 / 2)
    apply h.congr
    exact ae_of_all _ fun t => by
      ring
  have hf : Integrable f := by
    apply hgauss.mono' (by dsimp only [f]; fun_prop)
    exact ae_of_all _ fun t => by
      dsimp only [f]
      rw [Real.norm_eq_abs, abs_mul, abs_of_pos (Real.exp_pos _)]
      exact mul_le_of_le_one_right (Real.exp_pos _).le
        (Real.abs_cos_le_one _)
  have htf : IntegrableOn (fun t : ℝ => t * f t) (Icc (0 : ℝ) T) := by
    apply Continuous.integrableOn_Icc
    dsimp only [f]
    fun_prop
  have hsplit : (∫ t in Icc (0 : ℝ) T, f t) =
      (Real.sqrt (2 * Real.pi) / 2) * Real.exp (-(x ^ 2) / 2) -
        ∫ t in Ioi T, f t := by
    have hsubset : Ici T ⊆ Ioi (0 : ℝ) := by
      intro t ht
      exact lt_of_lt_of_le hT ht
    have hdiff := integral_diff measurableSet_Ici hf.integrableOn hsubset
    have hset : Ioi (0 : ℝ) \ Ici T = Ioo (0 : ℝ) T := by
      ext t
      simp only [mem_diff, mem_Ioi, mem_Ici, mem_Ioo]
      constructor
      · intro ht
        exact ⟨ht.1, lt_of_not_ge ht.2⟩
      · intro ht
        exact ⟨ht.1, not_le.mpr ht.2⟩
    rw [hset, integral_Ici_eq_integral_Ioi] at hdiff
    rw [integral_Icc_eq_integral_Ioo, hdiff]
    rw [show (∫ t in Ioi (0 : ℝ), f t) =
        (Real.sqrt (2 * Real.pi) / 2) * Real.exp (-(x ^ 2) / 2) by
      simpa only [f] using integral_Ioi_rexp_neg_sq_div_two_mul_cos x]
  have hexpand : prawitzGaussianCosineRemainder T x =
      (2 / T) * (∫ t in Icc (0 : ℝ) T, f t) -
        (2 / T ^ 2) * (∫ t in Icc (0 : ℝ) T, t * f t) := by
    unfold prawitzGaussianCosineRemainder
    rw [integral_Icc_eq_integral_Ioo]
    have hfirst : IntegrableOn (fun t => (2 / T) * f t) (Ioo (0 : ℝ) T) :=
      (hf.const_mul (2 / T)).integrableOn
    have hsecond : IntegrableOn (fun t => (2 / T ^ 2) * (t * f t))
        (Ioo (0 : ℝ) T) :=
      (htf.mono_set Ioo_subset_Icc_self).const_mul (2 / T ^ 2)
    rw [show (∫ t in Ioo (0 : ℝ) T,
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)) =
        ∫ t in Ioo (0 : ℝ) T,
          (2 / T) * f t - (2 / T ^ 2) * (t * f t) by
      apply setIntegral_congr_fun measurableSet_Ioo
      intro t ht
      dsimp only
      rw [prawitzFejerFrequencyWeight_of_mem_Icc hT ht.1.le ht.2.le]
      dsimp only [f]
      field_simp [hT.ne']]
    rw [integral_sub hfirst hsecond, integral_const_mul,
      integral_const_mul]
    rw [← integral_Icc_eq_integral_Ioo]
    rw [show (∫ t in Ioo (0 : ℝ) T, t * f t) =
        ∫ t in Icc (0 : ℝ) T, t * f t by
      exact integral_Icc_eq_integral_Ioo.symm]
  rw [hexpand, hsplit]
  dsimp only [f]
  ring

/-- The finite Gaussian Prawitz cosine remainder is uniformly maximized at
spatial frequency zero. -/
theorem prawitzGaussianCosineRemainder_le_zero
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    prawitzGaussianCosineRemainder T x ≤
      prawitzGaussianCosineRemainder T 0 := by
  unfold prawitzGaussianCosineRemainder
  have hleft : IntegrableOn (fun t : ℝ =>
      2 * prawitzFejerFrequencyWeight T t *
        Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)) (Icc (0 : ℝ) T) := by
    apply Continuous.integrableOn_Icc
    unfold prawitzFejerFrequencyWeight
    fun_prop
  have hright : IntegrableOn (fun t : ℝ =>
      2 * prawitzFejerFrequencyWeight T t *
        Real.exp (-(t ^ 2) / 2) * Real.cos (0 * t)) (Icc (0 : ℝ) T) := by
    apply Continuous.integrableOn_Icc
    unfold prawitzFejerFrequencyWeight
    fun_prop
  apply integral_mono hleft hright
  intro t
  have hcoef : 0 ≤ 2 * prawitzFejerFrequencyWeight T t *
      Real.exp (-(t ^ 2) / 2) := by
    exact mul_nonneg
      (mul_nonneg (by norm_num) (prawitzFejerFrequencyWeight_nonneg hT t))
      (Real.exp_pos _).le
  simpa only [zero_mul, Real.cos_zero, mul_one] using
    mul_le_mul_of_nonneg_left (Real.cos_le_one (x * t)) hcoef

/-- Exact value of the uniform Gaussian Prawitz remainder.  Compared with the
half-line extension, it retains both the missing Gaussian tail and the
strictly positive triangular correction. -/
theorem prawitzGaussianCosineRemainder_zero
    {T : ℝ} (hT : 0 < T) :
    prawitzGaussianCosineRemainder T 0 =
      (2 / T) * (∫ t in Icc (0 : ℝ) T,
        Real.exp (-(t ^ 2) / 2)) -
      (2 / T ^ 2) * (1 - Real.exp (-(T ^ 2) / 2)) := by
  have hdecomp :=
    prawitzGaussianCosineRemainder_eq_full_sub_tail_sub_correction hT 0
  have hgauss : Integrable (fun t : ℝ => Real.exp (-(t ^ 2) / 2)) := by
    have h := integrable_exp_neg_mul_sq (by norm_num : (0 : ℝ) < 1 / 2)
    apply h.congr
    exact ae_of_all _ fun t => by
      ring
  have hsubset : Ici T ⊆ Ioi (0 : ℝ) := by
    intro t ht
    exact lt_of_lt_of_le hT ht
  have hdiff := integral_diff measurableSet_Ici hgauss.integrableOn hsubset
  have hset : Ioi (0 : ℝ) \ Ici T = Ioo (0 : ℝ) T := by
    ext t
    simp only [mem_diff, mem_Ioi, mem_Ici, mem_Ioo]
    constructor
    · intro ht
      exact ⟨ht.1, lt_of_not_ge ht.2⟩
    · intro ht
      exact ⟨ht.1, not_le.mpr ht.2⟩
  rw [hset, integral_Ici_eq_integral_Ioi] at hdiff
  have hmass : (∫ t in Icc (0 : ℝ) T,
      Real.exp (-(t ^ 2) / 2)) =
      Real.sqrt (2 * Real.pi) / 2 -
        ∫ t in Ioi T, Real.exp (-(t ^ 2) / 2) := by
    rw [integral_Icc_eq_integral_Ioo, hdiff]
    rw [show (∫ t in Ioi (0 : ℝ), Real.exp (-(t ^ 2) / 2)) =
        Real.sqrt (2 * Real.pi) / 2 by
      simpa using integral_Ioi_rexp_neg_sq_div_two_mul_cos 0]
  simp only [zero_mul, Real.cos_zero, mul_one] at hdecomp
  have hexpZero : Real.exp (-((0 : ℝ) ^ 2) / 2) = 1 := by
    rw [show -((0 : ℝ) ^ 2) / 2 = 0 by norm_num, Real.exp_zero]
  rw [hexpZero, mul_one] at hdecomp
  rw [integral_Icc_mul_rexp_neg_sq_div_two hT] at hdecomp
  rw [hmass]
  rw [hdecomp]
  ring

/-- For every sufficiently wide window, the exact finite Gaussian remainder
still exceeds the reciprocal cutoff.  This is the rational core of the
coefficient-one obstruction; no numerical Gaussian approximation is used. -/
theorem one_div_lt_prawitzGaussianCosineRemainder_zero
    {T : ℝ} (hT6 : 6 ≤ T) :
    1 / T < prawitzGaussianCosineRemainder T 0 := by
  have hT : 0 < T := lt_of_lt_of_le (by norm_num) hT6
  let f : ℝ → ℝ := fun t => Real.exp (-(t ^ 2) / 2)
  let p : ℝ → ℝ := fun t => 1 - t ^ 2 / 2
  have hp : IntegrableOn p (Icc (0 : ℝ) 1) := by
    apply Continuous.integrableOn_Icc
    dsimp only [p]
    fun_prop
  have hf : IntegrableOn f (Icc (0 : ℝ) T) := by
    apply Continuous.integrableOn_Icc
    dsimp only [f]
    fun_prop
  have hfOne : IntegrableOn f (Icc (0 : ℝ) 1) := by
    apply Continuous.integrableOn_Icc
    dsimp only [f]
    fun_prop
  have hpoint : ∀ t, p t ≤ f t := by
    intro t
    dsimp only [p, f]
    convert Real.add_one_le_exp (-(t ^ 2) / 2) using 1; ring
  have hpoly : (∫ t in Icc (0 : ℝ) 1, p t) = 5 / 6 := by
    have h2 : IntervalIntegrable (fun t : ℝ => t ^ 2) volume 0 1 :=
      (continuous_id.pow 2).intervalIntegrable _ _
    rw [integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)]
    dsimp only [p]
    rw [intervalIntegral.integral_sub
      intervalIntegral.intervalIntegrable_const (h2.div_const 2),
      intervalIntegral.integral_div, integral_one, integral_pow]
    norm_num
  have hsmall : 5 / 6 ≤ ∫ t in Icc (0 : ℝ) 1, f t := by
    rw [← hpoly]
    exact setIntegral_mono hp hfOne hpoint
  have hsubset : Icc (0 : ℝ) 1 ⊆ Icc (0 : ℝ) T := by
    intro t ht
    exact ⟨ht.1, ht.2.trans (by linarith)⟩
  have hmass : 5 / 6 ≤ ∫ t in Icc (0 : ℝ) T, f t := by
    exact hsmall.trans (setIntegral_mono_set hf
      (ae_of_all (volume.restrict (Icc (0 : ℝ) T)) fun t => by
        dsimp only [f]
        positivity)
      hsubset.eventuallyLE)
  have hcorr : 1 - Real.exp (-(T ^ 2) / 2) ≤ 1 := by
    linarith [Real.exp_pos (-(T ^ 2) / 2)]
  rw [prawitzGaussianCosineRemainder_zero hT]
  calc
    1 / T < (2 / T) * (5 / 6) - (2 / T ^ 2) * 1 := by
      field_simp [hT.ne']
      nlinarith
    _ ≤ (2 / T) * (∫ t in Icc (0 : ℝ) T, f t) -
          (2 / T ^ 2) * (1 - Real.exp (-(T ^ 2) / 2)) := by
      exact sub_le_sub
        (mul_le_mul_of_nonneg_left hmass (by positivity))
        (mul_le_mul_of_nonneg_left hcorr (by positivity))
    _ = _ := rfl

/-- For every sufficiently wide window, the exact bidirectional law-phase
envelope has a strict reciprocal-cutoff floor at the spatial origin. -/
theorem one_div_two_mul_lt_prawitzLawPhaseEnvelope_zero
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T : ℝ} (hT6 : 6 ≤ T) :
    1 / (2 * T) < prawitzLawPhaseEnvelope mu T 0 := by
  have hT : 0 < T := lt_of_lt_of_le (by norm_num) hT6
  have hgauss : 1 / T < prawitzGaussianCosineRemainder T 0 :=
    one_div_lt_prawitzGaussianCosineRemainder_zero hT6
  have hhalf :
      (1 / 2 : ℝ) * prawitzGaussianCosineRemainder T 0 ≤
        prawitzLawPhaseFejerIntegral mu T 0 :=
    half_prawitzGaussianCosineRemainder_le_lawPhaseFejerIntegral mu hT 0
  have hstrict :
      (1 / 2 : ℝ) * (1 / T) <
        (1 / 2 : ℝ) * prawitzGaussianCosineRemainder T 0 :=
    mul_lt_mul_of_pos_left hgauss (by norm_num)
  have hscale : 1 / (2 * T) = (1 / 2 : ℝ) * (1 / T) := by
    field_simp
  rw [prawitzLawPhaseEnvelope, hscale]
  exact (hstrict.trans_le hhalf).trans_le
    (le_add_of_nonneg_right (abs_nonneg _))

/-- At unit standardized third moment, every admissible tunable parameter has
large-sample windows on which the exact Gaussian remainder alone exceeds the
coefficient-one Berry scale. -/
theorem inverse_sqrt_lt_prawitzGaussianCosineRemainder_admissible_unit
    {c : ℝ} (hc : 0 < c) {N : ℕ}
    (hcut : 6 ≤ admissibleTunableThirdMomentCutoff c 1 N) :
    1 / Real.sqrt (N + 1 : ℝ) <
      prawitzGaussianCosineRemainder
        (admissibleTunableThirdMomentCutoff c 1 N) 0 := by
  let s : ℝ := Real.sqrt (N + 1 : ℝ)
  let m : ℝ := max 1 c
  let T : ℝ := admissibleTunableThirdMomentCutoff c 1 N
  have hs : 0 < s := by dsimp only [s]; positivity
  have hm : 1 ≤ m := by
    dsimp only [m]
    exact le_max_left 1 c
  have hm0 : 0 < m := lt_of_lt_of_le zero_lt_one hm
  have hT : T = s / m := by
    dsimp only [T, s, m]
    simpa only [mul_one] using
      admissibleTunableThirdMomentCutoff_eq_sqrt_div_max hc
        (by norm_num : (0 : ℝ) < 1) N
  have hinv : 1 / s ≤ 1 / T := by
    rw [hT, show 1 / (s / m) = m / s by field_simp [hs.ne', hm0.ne']]
    exact (div_le_div_iff_of_pos_right hs).2 hm
  simpa only [T, s] using
    hinv.trans_lt (one_div_lt_prawitzGaussianCosineRemainder_zero hcut)

/-- Every positive tunable parameter admits a sample size whose unit-moment
admissible cutoff is at least six. -/
theorem exists_nat_admissibleTunableThirdMomentCutoff_unit_ge_six
    {c : ℝ} (hc : 0 < c) :
    ∃ N : ℕ, 1 ≤ N ∧
      6 ≤ admissibleTunableThirdMomentCutoff c 1 N := by
  let m : ℝ := max 1 c
  have hm : 1 ≤ m := by
    dsimp only [m]
    exact le_max_left 1 c
  have hm0 : 0 < m := lt_of_lt_of_le zero_lt_one hm
  obtain ⟨N, hN⟩ := exists_nat_gt ((6 * m) ^ 2)
  have hNpos : 1 ≤ N := by
    rw [Nat.one_le_iff_ne_zero]
    intro hzero
    subst N
    norm_num at hN
    nlinarith [sq_nonneg (6 * m)]
  have hsquare : (6 * m) ^ 2 ≤ (N + 1 : ℕ) := by
    norm_num [Nat.cast_add, Nat.cast_one] at hN ⊢
    linarith
  refine ⟨N, hNpos, ?_⟩
  rw [admissibleTunableThirdMomentCutoff_eq_sqrt_div_max hc
    (by norm_num : (0 : ℝ) < 1), mul_one]
  rw [le_div_iff₀ hm0]
  exact (Real.le_sqrt (by positivity) (by positivity)).2 (by
    simpa only [Nat.cast_add, Nat.cast_one] using hsquare)

/-- Consequently, for every positive tunable parameter there is a valid
large-sample unit-third-moment regime in which the exact finite Gaussian
remainder alone exceeds the source's coefficient-one Berry scale. -/
theorem exists_inverse_sqrt_lt_prawitzGaussianCosineRemainder_admissible_unit
    {c : ℝ} (hc : 0 < c) :
    ∃ N : ℕ, 1 ≤ N ∧
      1 / Real.sqrt (N + 1 : ℝ) <
        prawitzGaussianCosineRemainder
          (admissibleTunableThirdMomentCutoff c 1 N) 0 := by
  obtain ⟨N, hN, hcut⟩ :=
    exists_nat_admissibleTunableThirdMomentCutoff_unit_ge_six hc
  exact ⟨N, hN,
    inverse_sqrt_lt_prawitzGaussianCosineRemainder_admissible_unit hc hcut⟩

/-- Pointwise real normal form of the forward cancellation-preserving
integrand at positive frequency. -/
theorem re_forwardPrawitzSingleIntegrand_eq
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T t : ℝ} (ht : t ≠ 0) (x : ℝ) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t) +
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re =
      -(Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
          scaledPrawitzSmoothingFilter T t *
            (MeasureTheory.charFun mu t -
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).im /
          (Real.pi * t) +
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  rw [Complex.add_re,
    re_prawitzCoefficient_mul_symmetric_sub
      (isHermitianFrequencyFunction_charFun mu)
      (isHermitianFrequencyFunction_charFun
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) x ht,
    re_pairedPrawitzReflectionFrequencyIntegrand_standardNormal]
  rw [← Complex.sub_im, prawitzPVNumerator_sub]

/-- The real forward integrand equals the real part of the positive-frequency
phase-preserving difference plus the exact Gaussian cosine contribution. -/
theorem re_forwardPrawitzSingleIntegrand_eq_phasePreserving
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T t : ℝ} (ht : t ≠ 0) (x : ℝ) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t) +
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re =
      ((Complex.I / (Real.pi : ℝ)) *
        (prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
          prawitzPVIntegrand T
            (MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
            x t)).re +
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  rw [re_forwardPrawitzSingleIntegrand_eq mu ht x]
  unfold prawitzPVIntegrand
  rw [← sub_div, ← prawitzPVNumerator_sub]
  congr 1
  rw [Complex.mul_re, Complex.div_ofReal_re, Complex.div_ofReal_im,
    Complex.div_ofReal_re, Complex.div_ofReal_im]
  simp only [Complex.I_re, Complex.I_im, zero_div, one_div, zero_mul]
  field_simp [ht, Real.pi_ne_zero]
  ring

/-- Interior-window expansion of the forward signed integrand. It isolates
the cotangent coefficient of the imaginary characteristic-function error and
the triangular coefficient of its real part, while retaining the exact
Gaussian term. -/
theorem re_forwardPrawitzSingleIntegrand_eq_expanded
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) (x : ℝ) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t) +
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re =
      -prawitzCotangentFrequencyCoefficient T t *
          (Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
            (MeasureTheory.charFun mu t -
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).im +
        prawitzFejerFrequencyWeight T t *
          (Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
            (MeasureTheory.charFun mu t -
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re +
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  rw [re_forwardPrawitzSingleIntegrand_eq mu ht.1.ne' x]
  let q : ℂ :=
    Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
      (MeasureTheory.charFun mu t -
        MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)
  have hprod :
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
          scaledPrawitzSmoothingFilter T t *
            (MeasureTheory.charFun mu t -
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t) =
        scaledPrawitzSmoothingFilter T t * q := by
    dsimp only [q]
    ring
  rw [hprod, Complex.mul_im,
    scaledPrawitzSmoothingFilter_re_of_mem_Ico hT ht.1.le ht.2,
    scaledPrawitzSmoothingFilter_im_of_mem_Ico hT ht.1.le ht.2,
    prawitzFejerFrequencyWeight_of_mem_Icc hT ht.1.le ht.2.le]
  change
    -(((1 - t / T) * prawitzCotFactor (t / T) + t / T) * q.im +
        -((1 - t / T) * Real.pi * (t / T)) * q.re) /
          (Real.pi * t) +
        2 * ((1 - t / T) / T) * Real.exp (-(t ^ 2) / 2) *
          Real.cos (x * t) = _
  unfold prawitzCotangentFrequencyCoefficient
  dsimp only [q]
  field_simp [hT.ne', ht.1.ne', Real.pi_ne_zero]
  ring

/-- Pointwise signed majorant which bounds only the characteristic-function
components and keeps the oscillatory Gaussian term exact. -/
theorem re_forwardPrawitzSingleIntegrand_le_with_exactGaussian
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) (x : ℝ) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t) +
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re ≤
      (prawitzCotangentFrequencyCoefficient T t +
          prawitzFejerFrequencyWeight T t) *
        ‖MeasureTheory.charFun mu t -
          MeasureTheory.charFun
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t‖ +
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  rw [re_forwardPrawitzSingleIntegrand_eq_expanded mu hT ht x]
  let q : ℂ :=
    Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
      (MeasureTheory.charFun mu t -
        MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)
  let c := prawitzCotangentFrequencyCoefficient T t
  let w := prawitzFejerFrequencyWeight T t
  have hc : 0 ≤ c := prawitzCotangentFrequencyCoefficient_nonneg hT ht
  have hw : 0 ≤ w := prawitzFejerFrequencyWeight_nonneg hT t
  have hqnorm :
      ‖q‖ = ‖MeasureTheory.charFun mu t -
        MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t‖ := by
    dsimp only [q]
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
  have hIm : -c * q.im ≤ c * ‖q‖ := by
    calc
      -c * q.im = c * (-q.im) := by ring
      _ ≤ c * ‖q‖ := mul_le_mul_of_nonneg_left
        ((neg_le_abs q.im).trans (Complex.abs_im_le_norm q)) hc
  have hRe : w * q.re ≤ w * ‖q‖ :=
    mul_le_mul_of_nonneg_left (Complex.re_le_norm q) hw
  change -c * q.im + w * q.re +
      2 * w * Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) ≤
    (c + w) *
        ‖MeasureTheory.charFun mu t -
          MeasureTheory.charFun
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t‖ +
      2 * w * Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)
  rw [← hqnorm]
  linarith

/-- Pointwise quantitative majorant obtained from the signed normal form. The
two characteristic-function components retain their distinct exact weights;
only the final scalar components are bounded by the discrepancy norm. -/
theorem re_forwardPrawitzSingleIntegrand_le
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) (x : ℝ) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t) +
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re ≤
      (prawitzCotangentFrequencyCoefficient T t +
          prawitzFejerFrequencyWeight T t) *
        ‖MeasureTheory.charFun mu t -
          MeasureTheory.charFun
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t‖ +
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) := by
  rw [re_forwardPrawitzSingleIntegrand_eq_expanded mu hT ht x]
  let q : ℂ :=
    Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
      (MeasureTheory.charFun mu t -
        MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)
  let c := prawitzCotangentFrequencyCoefficient T t
  let w := prawitzFejerFrequencyWeight T t
  have hc : 0 ≤ c := prawitzCotangentFrequencyCoefficient_nonneg hT ht
  have hw : 0 ≤ w := prawitzFejerFrequencyWeight_nonneg hT t
  have hqnorm :
      ‖q‖ = ‖MeasureTheory.charFun mu t -
        MeasureTheory.charFun
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t‖ := by
    dsimp only [q]
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
  have hIm : -c * q.im ≤ c * ‖q‖ := by
    calc
      -c * q.im = c * (-q.im) := by ring
      _ ≤ c * ‖q‖ := mul_le_mul_of_nonneg_left
        ((neg_le_abs q.im).trans (Complex.abs_im_le_norm q)) hc
  have hRe : w * q.re ≤ w * ‖q‖ :=
    mul_le_mul_of_nonneg_left (Complex.re_le_norm q) hw
  have hGauss :
      2 * w * Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) ≤
        2 * w * Real.exp (-(t ^ 2) / 2) := by
    have hcoef : 0 ≤ 2 * w * Real.exp (-(t ^ 2) / 2) := by positivity
    simpa only [mul_one] using
      mul_le_mul_of_nonneg_left (Real.cos_le_one (x * t)) hcoef
  change -c * q.im + w * q.re +
      2 * w * Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) ≤
    (c + w) *
        ‖MeasureTheory.charFun mu t -
          MeasureTheory.charFun
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t‖ +
      2 * w * Real.exp (-(t ^ 2) / 2)
  rw [← hqnorm]
  linarith

/-- Universal coefficient form of the signed pointwise majorant on the open
Prawitz window. -/
theorem re_forwardPrawitzSingleIntegrand_le_discrepancyQuotient
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) (x : ℝ) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t) +
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re ≤
      (1 / Real.pi + t / T) *
          charFunDiscrepancyQuotient mu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t +
        (2 / T) * Real.exp (-(t ^ 2) / 2) := by
  have hbase := re_forwardPrawitzSingleIntegrand_le mu hT ht x
  have hc := prawitzCotangentFrequencyCoefficient_le_inv hT ht
  have hw := prawitzFejerFrequencyWeight_le_inv hT ht.1.le
  have hq := charFunDiscrepancyQuotient_nonneg mu
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t
  have hnorm := norm_charFun_sub_eq_abs_mul_charFunDiscrepancyQuotient
    mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ht.1.ne'
  rw [abs_of_pos ht.1] at hnorm
  rw [hnorm] at hbase
  calc
    ((Complex.I / (2 * Real.pi : ℝ)) *
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t) +
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re ≤
        (prawitzCotangentFrequencyCoefficient T t +
            prawitzFejerFrequencyWeight T t) *
          (t * charFunDiscrepancyQuotient mu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t) +
          2 * prawitzFejerFrequencyWeight T t *
            Real.exp (-(t ^ 2) / 2) := hbase
    _ ≤ (1 / (Real.pi * t) + 1 / T) *
          (t * charFunDiscrepancyQuotient mu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t) +
        2 * (1 / T) * Real.exp (-(t ^ 2) / 2) := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_right (add_le_add hc hw)
          (mul_nonneg ht.1.le hq)
      · exact mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hw (by norm_num))
          (Real.exp_pos _).le
    _ = (1 / Real.pi + t / T) *
          charFunDiscrepancyQuotient mu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t +
        (2 / T) * Real.exp (-(t ^ 2) / 2) := by
      field_simp [Real.pi_ne_zero, hT.ne', ht.1.ne']

/-- Universal coefficient form of the signed majorant with the finite-window
Gaussian cosine contribution left unchanged. -/
theorem re_forwardPrawitzSingleIntegrand_le_discrepancyQuotient_with_exactGaussian
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Ioo 0 T) (x : ℝ) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t) +
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re ≤
      (1 / Real.pi + t / T) *
          charFunDiscrepancyQuotient mu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t +
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  have hbase := re_forwardPrawitzSingleIntegrand_le_with_exactGaussian
    mu hT ht x
  have hc := prawitzCotangentFrequencyCoefficient_le_inv hT ht
  have hw := prawitzFejerFrequencyWeight_le_inv hT ht.1.le
  have hq := charFunDiscrepancyQuotient_nonneg mu
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t
  have hnorm := norm_charFun_sub_eq_abs_mul_charFunDiscrepancyQuotient
    mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw ht.1.ne'
  rw [abs_of_pos ht.1] at hnorm
  rw [hnorm] at hbase
  calc
    ((Complex.I / (2 * Real.pi : ℝ)) *
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t) +
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re ≤
        (prawitzCotangentFrequencyCoefficient T t +
            prawitzFejerFrequencyWeight T t) *
          (t * charFunDiscrepancyQuotient mu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t) +
          2 * prawitzFejerFrequencyWeight T t *
            Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := hbase
    _ ≤ (1 / (Real.pi * t) + 1 / T) *
          (t * charFunDiscrepancyQuotient mu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t) +
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
      exact add_le_add
        (mul_le_mul_of_nonneg_right (add_le_add hc hw)
          (mul_nonneg ht.1.le hq)) le_rfl
    _ = (1 / Real.pi + t / T) *
          charFunDiscrepancyQuotient mu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t +
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
      field_simp [Real.pi_ne_zero, hT.ne', ht.1.ne']

/-- Exact frequency-space form of the standard-normal Fejer remainder in the
Prawitz comparison. -/
theorem integral_prawitzReflection_standardNormal_eq_re_frequencyIntegral
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, (prawitzPointKernel T (y - x) +
        prawitzPointKernel T (x - y))
      ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) =
      (∫ z,
        Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
            (T * z / 2)
        ∂twofoldUniformKernel).re := by
  simp_rw [prawitzPointKernel_reflection_eq_sinc_sq hT]
  change (∫ y, sincSquareWeight (T * (y - x) / 2)
      ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) = _
  exact integral_sincSquareWeight_eq_re_frequencyIntegral
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw T x

/-- Exact mass of every translated, positively scaled Fejér profile. -/
theorem integral_sinc_sq_half_scale {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y : ℝ, Real.sinc (T * (y - x) / 2) ^ 2) =
      2 * Real.pi / T := by
  have hcomp := Measure.integral_comp_mul_left
    (fun z : ℝ => sincSquareWeight z) (T / 2)
  rw [abs_of_pos (inv_pos.mpr (div_pos hT (by norm_num)))] at hcomp
  have htrans :
      (∫ y : ℝ, sincSquareWeight ((T / 2) * (y - x))) =
        ∫ y : ℝ, sincSquareWeight ((T / 2) * y) := by
    simpa only [sub_eq_add_neg, add_comm] using
      (MeasureTheory.integral_add_right_eq_self
        (μ := volume) (fun y : ℝ => sincSquareWeight ((T / 2) * y)) (-x))
  rw [show (fun y : ℝ => Real.sinc (T * (y - x) / 2) ^ 2) =
      fun y => sincSquareWeight ((T / 2) * (y - x)) by
        funext y
        unfold sincSquareWeight
        congr 2
        ring,
    htrans]
  rw [integral_sincSquareWeight] at hcomp
  calc
    (∫ y : ℝ, sincSquareWeight (T / 2 * y)) =
        (T / 2)⁻¹ • Real.pi := hcomp
    _ = 2 * Real.pi / T := by
      simp only [smul_eq_mul]
      field_simp [hT.ne']

/-- Integrability companion to the exact translated Fejér mass. -/
theorem integrable_sinc_sq_half_scale {T : ℝ} (hT : 0 < T) (x : ℝ) :
    Integrable (fun y : ℝ => Real.sinc (T * (y - x) / 2) ^ 2) := by
  have hscale : (T / 2 : ℝ) ≠ 0 := div_ne_zero hT.ne' (by norm_num)
  have hscaled : Integrable
      (fun y : ℝ => sincSquareWeight ((T / 2) * y)) :=
    integrable_sincSquareWeight.comp_mul_left' hscale
  have htranslated :=
    (measurePreserving_add_right volume (-x)).integrable_comp_of_integrable hscaled
  apply htranslated.congr
  filter_upwards with y
  dsimp only [Function.comp_apply, sincSquareWeight]
  congr 2
  ring

/-- The reflected Prawitz remainder against the standard normal is bounded
by the sharp density supremum times the exact Fejér mass. -/
theorem integral_prawitzReflection_standardNormal_le
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, (prawitzPointKernel T (y - x) +
        prawitzPointKernel T (x - y))
      ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * (2 * Real.pi / T) := by
  let k : ℝ → ℝ := fun y => Real.sinc (T * (y - x) / 2) ^ 2
  let c : ℝ := (Real.sqrt (2 * Real.pi))⁻¹
  have hk : Integrable k := by
    simpa only [k] using integrable_sinc_sq_half_scale hT x
  have hkNonneg : ∀ y, 0 ≤ k y := fun y => by dsimp only [k]; positivity
  have hpdf : Integrable (fun y =>
      ProbabilityTheory.gaussianPDFReal 0 1 y * k y) := by
    have hmajor : Integrable (fun y => c * k y) := hk.const_mul c
    apply hmajor.mono' (by fun_prop)
    exact ae_of_all volume fun y => by
      rw [Real.norm_eq_abs, abs_of_nonneg
        (mul_nonneg (ProbabilityTheory.gaussianPDFReal_nonneg 0 1 y)
          (hkNonneg y))]
      have hbound : ProbabilityTheory.gaussianPDFReal 0 1 y ≤ c := by
        rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_pdf]
        have hexp : Real.exp (-(y ^ 2) / 2) ≤ 1 :=
          Real.exp_le_one_iff.mpr (by nlinarith [sq_nonneg y])
        simpa only [mul_one, c] using mul_le_mul_of_nonneg_left hexp
          (inv_nonneg.mpr (Real.sqrt_nonneg (2 * Real.pi)))
      exact mul_le_mul_of_nonneg_right hbound (hkNonneg y)
  have hle :
      (∫ y, ProbabilityTheory.gaussianPDFReal 0 1 y * k y) ≤
        ∫ y, c * k y := by
    apply integral_mono hpdf (hk.const_mul c)
    intro y
    have hbound : ProbabilityTheory.gaussianPDFReal 0 1 y ≤ c := by
      rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw_pdf]
      have hexp : Real.exp (-(y ^ 2) / 2) ≤ 1 :=
        Real.exp_le_one_iff.mpr (by nlinarith [sq_nonneg y])
      simpa only [mul_one, c] using mul_le_mul_of_nonneg_left hexp
        (inv_nonneg.mpr (Real.sqrt_nonneg (2 * Real.pi)))
    exact mul_le_mul_of_nonneg_right hbound (hkNonneg y)
  rw [integral_const_mul, show (∫ y, k y) = 2 * Real.pi / T by
    simpa only [k] using integral_sinc_sq_half_scale hT x] at hle
  simp_rw [prawitzPointKernel_reflection_eq_sinc_sq hT]
  change (∫ y, k y
    ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) ≤
      (Real.sqrt (2 * Real.pi))⁻¹ * (2 * Real.pi / T)
  rw [NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw]
  have hone : (1 : NNReal) ≠ 0 := one_ne_zero
  have hgauss :
      (∫ y, k y ∂ProbabilityTheory.gaussianReal 0 1) =
        ∫ y, ProbabilityTheory.gaussianPDFReal 0 1 y • k y :=
    ProbabilityTheory.integral_gaussianReal_eq_integral_smul hone
  rw [hgauss]
  simpa only [smul_eq_mul, k, c] using hle

/-- One-sided Prawitz comparison against the standard normal with both the
signed frequency integral and reflected Fejer remainder kept exact. -/
theorem cdf_sub_standardNormalCDF_le_prawitz_signed
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf mu x -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x ≤
      ((Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t in Icc 0 T,
          (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              x t)).re +
      ∫ y, (prawitzPointKernel T (y - x) +
          prawitzPointKernel T (x - y))
        ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  have hsigned :=
    cdf_sub_cdf_le_re_prawitzInversion_sub_add_reflection
      mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      hmu1 integrable_abs_standardNormalLaw hT x
  rw [re_prawitzInversion_charFun_sub_eq_signedIntegral
    mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
    hmu1 integrable_abs_standardNormalLaw hT x] at hsigned
  exact hsigned

/-- The forward standard-normal Prawitz comparison with the inversion and
Fejer terms combined inside one real part before any norm estimate. -/
theorem cdf_sub_standardNormalCDF_le_prawitz_signed_frequency
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf mu x -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x ≤
      (((Complex.I / (2 * Real.pi : ℝ)) *
          ∫ t in Icc 0 T,
            (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
              symmetricPrawitzPVIntegrand T
                (MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                x t)) +
        ∫ z,
          Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
              (T * z / 2)
          ∂twofoldUniformKernel).re := by
  have hsigned := cdf_sub_standardNormalCDF_le_prawitz_signed
    mu hmu1 hT x
  rw [integral_prawitzReflection_standardNormal_eq_re_frequencyIntegral
    hT x] at hsigned
  simpa only [Complex.add_re] using hsigned

/-- The forward comparison as one signed positive-frequency integral. This is
the cancellation-preserving form: no norm or pointwise absolute value has yet
separated the Prawitz and Fejer contributions. -/
theorem cdf_sub_standardNormalCDF_le_prawitz_singleSignedIntegral
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf mu x -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x ≤
      (∫ t in Icc 0 T,
        (Complex.I / (2 * Real.pi : ℝ)) *
            (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
              symmetricPrawitzPVIntegrand T
                (MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                x t) +
          (prawitzFejerFrequencyWeight T t : ℂ) *
            (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
                MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
              Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
                MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re := by
  have hsigned := cdf_sub_standardNormalCDF_le_prawitz_signed_frequency
    mu hmu1 hT x
  rw [integral_prawitzReflectionFrequency_eq_pairedTriangularIntegral
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hT x] at hsigned
  have hmu := integrableOn_symmetricPrawitzPVIntegrand_charFun
    mu hmu1 hT x
  have hnormal := integrableOn_symmetricPrawitzPVIntegrand_charFun
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
    integrable_abs_standardNormalLaw hT x
  have hP := (hmu.sub hnormal).const_mul
    (Complex.I / (2 * Real.pi : ℝ))
  have hR : IntegrableOn (fun t =>
      (prawitzFejerFrequencyWeight T t : ℂ) *
        (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
          Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t))
      (Icc 0 T) :=
    (integrable_pairedPrawitzReflectionFrequencyIntegrand
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hT x).integrableOn
  have hcombine :
      (Complex.I / (2 * Real.pi : ℝ)) *
          (∫ t in Icc 0 T,
            (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
              symmetricPrawitzPVIntegrand T
                (MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                x t)) +
        (∫ t in Icc 0 T,
          (prawitzFejerFrequencyWeight T t : ℂ) *
            (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
                MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
              Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
                MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)) =
        ∫ t in Icc 0 T,
          (Complex.I / (2 * Real.pi : ℝ)) *
              (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
                symmetricPrawitzPVIntegrand T
                  (MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                  x t) +
            (prawitzFejerFrequencyWeight T t : ℂ) *
              (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
                  MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
                Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
                  MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t) := by
    calc
      (Complex.I / (2 * Real.pi : ℝ)) *
            (∫ t in Icc 0 T,
              (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
                symmetricPrawitzPVIntegrand T
                  (MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                  x t)) +
          (∫ t in Icc 0 T,
            (prawitzFejerFrequencyWeight T t : ℂ) *
              (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
                  MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
                Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
                  MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)) =
          (∫ t in Icc 0 T,
            (Complex.I / (2 * Real.pi : ℝ)) *
              (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
                symmetricPrawitzPVIntegrand T
                  (MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                  x t)) +
          (∫ t in Icc 0 T,
            (prawitzFejerFrequencyWeight T t : ℂ) *
              (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
                  MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
                Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
                  MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)) := by
        congr 1
        exact (integral_const_mul
          (μ := volume.restrict (Icc 0 T))
          (Complex.I / (2 * Real.pi : ℝ))
          (fun t =>
            symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
              symmetricPrawitzPVIntegrand T
                (MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                x t)).symm
      _ = ∫ t in Icc 0 T,
          (Complex.I / (2 * Real.pi : ℝ)) *
              (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
                symmetricPrawitzPVIntegrand T
                  (MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                  x t) +
            (prawitzFejerFrequencyWeight T t : ℂ) *
              (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
                  MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
                Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
                  MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t) :=
        (integral_add hP hR).symm
  rw [hcombine] at hsigned
  exact hsigned

/-- The forward signed CDF error is bounded by a single remainder that keeps
the characteristic-function phase and exact Gaussian cosine term together.
This is the cancellation-preserving bridge used for the remaining compact
spatial analysis. -/
theorem cdf_sub_standardNormalCDF_le_prawitzPhasePreservingRemainder
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf mu x -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x ≤
      prawitzPhasePreservingRemainder mu T x := by
  have hsigned := cdf_sub_standardNormalCDF_le_prawitz_singleSignedIntegral
    mu hmu1 hT x
  let F : ℝ → ℂ := fun t =>
    (Complex.I / (2 * Real.pi : ℝ)) *
        (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
          symmetricPrawitzPVIntegrand T
            (MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
            x t) +
      (prawitzFejerFrequencyWeight T t : ℂ) *
        (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
          Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)
  let P : ℝ → ℂ := fun t =>
    (Complex.I / (Real.pi : ℝ)) *
      (prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
        prawitzPVIntegrand T
          (MeasureTheory.charFun
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
          x t)
  let G : ℝ → ℝ := fun t =>
    2 * prawitzFejerFrequencyWeight T t *
      Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)
  have hF : IntegrableOn F (Icc (0 : ℝ) T) := by
    have hmu := integrableOn_symmetricPrawitzPVIntegrand_charFun
      mu hmu1 hT x
    have hnormal := integrableOn_symmetricPrawitzPVIntegrand_charFun
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      integrable_abs_standardNormalLaw hT x
    have hP := (hmu.sub hnormal).const_mul
      (Complex.I / (2 * Real.pi : ℝ))
    have hR : IntegrableOn (fun t =>
        (prawitzFejerFrequencyWeight T t : ℂ) *
          (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
            Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
              MeasureTheory.charFun
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t))
        (Icc (0 : ℝ) T) :=
      (integrable_pairedPrawitzReflectionFrequencyIntegrand
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hT x).integrableOn
    simpa only [F] using hP.add hR
  have hP : IntegrableOn P (Icc (0 : ℝ) T) := by
    simpa only [P] using
      (integrableOn_prawitzPVIntegrand_charFun_sub
        mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
        hmu1 integrable_abs_standardNormalLaw hT x).const_mul
          (Complex.I / (Real.pi : ℝ))
  have hG : IntegrableOn G (Icc (0 : ℝ) T) := by
    apply Continuous.integrableOn_Icc
    dsimp only [G]
    unfold prawitzFejerFrequencyWeight
    fun_prop
  have heq : (∫ t in Icc (0 : ℝ) T, F t).re =
      prawitzPhasePreservingRemainder mu T x := by
    calc
      (∫ t in Icc (0 : ℝ) T, F t).re =
          ∫ t in Icc (0 : ℝ) T, (F t).re :=
        (integral_re hF).symm
      _ = ∫ t in Icc (0 : ℝ) T, ((P t).re + G t) := by
        apply integral_congr_ae
        filter_upwards [
          (volume.restrict (Icc (0 : ℝ) T)).ae_ne 0] with t ht
        dsimp only [F, P, G]
        exact re_forwardPrawitzSingleIntegrand_eq_phasePreserving mu ht x
      _ = (∫ t in Icc (0 : ℝ) T, P t).re +
          ∫ t in Icc (0 : ℝ) T, G t := by
        exact (integral_add hP.re hG).trans
          (congrArg (fun z : ℝ =>
            z + ∫ t in Icc (0 : ℝ) T, G t) (integral_re hP))
      _ = prawitzPhasePreservingRemainder mu T x := by
        dsimp only [P, G]
        unfold prawitzPhasePreservingRemainder
          prawitzGaussianCosineRemainder
        congr 1
        exact congrArg Complex.re
          (integral_const_mul
            (μ := volume.restrict (Icc (0 : ℝ) T))
            (Complex.I / (Real.pi : ℝ))
            (fun t =>
              prawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
                prawitzPVIntegrand T
                  (MeasureTheory.charFun
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                  x t))
  simpa only [F] using hsigned.trans_eq heq

/-- One-sided Prawitz smoothing against the standard normal, with exact
frequency coefficient `1/π` and exact Fejér spatial remainder. -/
theorem cdf_sub_standardNormalCDF_le_prawitz
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf mu x -
        cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x ≤
      (1 / Real.pi) * (∫ t in Icc 0 T,
        ‖scaledPrawitzSmoothingFilter T t‖ *
          charFunDiscrepancyQuotient mu
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t) +
      (Real.sqrt (2 * Real.pi))⁻¹ * (2 * Real.pi / T) := by
  have hsigned :=
    cdf_sub_cdf_le_norm_prawitzInversion_sub_add_reflection
      mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      hmu1 integrable_abs_standardNormalLaw hT x
  have hfreq := norm_prawitzInversion_charFun_sub_le_integral_discrepancy
    mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
    hmu1 integrable_abs_standardNormalLaw hT x
  have hreflect := integral_prawitzReflection_standardNormal_le hT x
  exact hsigned.trans (add_le_add hfreq hreflect)

/-- The law obtained by reflecting a real-valued law through the origin. -/
noncomputable def reflectedLaw (mu : Measure ℝ) : Measure ℝ :=
  mu.map ((-1 : ℝ) * ·)

/-- Reflection preserves total probability mass. -/
theorem reflectedLaw_isProbabilityMeasure
    (mu : Measure ℝ) [IsProbabilityMeasure mu] :
    IsProbabilityMeasure (reflectedLaw mu) := by
  unfold reflectedLaw
  exact Measure.isProbabilityMeasure_map (by fun_prop)

/-- Reflection preserves finiteness of the first absolute moment. -/
theorem integrable_abs_reflectedLaw
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu) :
    Integrable (fun y : ℝ => |y|) (reflectedLaw mu) := by
  unfold reflectedLaw
  rw [integrable_map_measure (by fun_prop) (by fun_prop)]
  convert hmu1 using 1
  ext y
  simp

/-- The characteristic function of a reflected law is evaluated at the
opposite frequency. -/
theorem charFun_reflectedLaw (mu : Measure ℝ) (t : ℝ) :
    MeasureTheory.charFun (reflectedLaw mu) t =
      MeasureTheory.charFun mu (-t) := by
  unfold reflectedLaw
  rw [MeasureTheory.charFun_map_mul]
  congr 1
  ring

/-- Simultaneous reflection conjugates the raw characteristic-function
discrepancy while leaving the complex Prawitz filter itself in place. -/
theorem prawitzZeroPhaseDifference_reflectedLaw_eq_filter_mul_conj_charFun_sub
    (mu nu : Measure ℝ) (T t : ℝ) :
    prawitzZeroPhaseDifference (reflectedLaw mu) (reflectedLaw nu) T t =
      scaledPrawitzSmoothingFilter T t *
        (starRingEnd ℂ)
          (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t) / t := by
  rw [prawitzZeroPhaseDifference_eq_filter_mul_charFun_sub,
    charFun_reflectedLaw, charFun_reflectedLaw,
    MeasureTheory.charFun_neg, MeasureTheory.charFun_neg]
  simp only [map_sub]

/-- Exact conjugated Taylor-product factorization of the reflected
normalized-iid zero-phase Prawitz amplitude. -/
theorem prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_eq_conj_taylorGeomSum
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) (T t : ℝ) :
    let law : Measure ℝ :=
      NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
          X hX N).aemeasurable
    let u : ℝ := t / Real.sqrt (N + 1 : ℝ)
    let phi : ℂ := MeasureTheory.charFun
      (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (X 0) (hX 0).aemeasurable : Measure ℝ) u
    let a : ℝ := 1 - u ^ 2 / 2
    let r : ℂ := phi - (a : ℂ)
    let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
    let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
    prawitzZeroPhaseDifference
        (reflectedLaw law)
        (reflectedLaw NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
        T t =
      scaledPrawitzSmoothingFilter T t *
        (starRingEnd ℂ) (r * s + (c : ℂ)) / t := by
  dsimp only
  rw [prawitzZeroPhaseDifference_reflectedLaw_eq_filter_mul_conj_charFun_sub,
    charFun_normalizedCenteredIidSum_sub_standardNormalLaw_eq_taylorGeomSum
      X hX hIndep hIdent N t]

/-- Real coordinate of the exact reflected normalized-iid Prawitz Taylor
product. Reflection changes the discrepancy cross-term signs by conjugation. -/
theorem prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_re_eq_taylorCoordinates
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) (T t : ℝ) :
    let law : Measure ℝ :=
      NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
          X hX N).aemeasurable
    let u : ℝ := t / Real.sqrt (N + 1 : ℝ)
    let phi : ℂ := MeasureTheory.charFun
      (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (X 0) (hX 0).aemeasurable : Measure ℝ) u
    let a : ℝ := 1 - u ^ 2 / 2
    let r : ℂ := phi - (a : ℂ)
    let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
    let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
    (prawitzZeroPhaseDifference
        (reflectedLaw law)
        (reflectedLaw NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
        T t).re =
      ((scaledPrawitzSmoothingFilter T t).re *
          (r.re * s.re - r.im * s.im + c) +
        (scaledPrawitzSmoothingFilter T t).im *
          (r.re * s.im + r.im * s.re)) / t := by
  dsimp only
  rw [prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_eq_conj_taylorGeomSum
    X hX hIndep hIdent N T t]
  exact complex_mul_conj_taylorProduct_div_re _ _ _ _ _

/-- Imaginary coordinate of the exact reflected normalized-iid Prawitz Taylor
product. Reflection changes the discrepancy cross-term signs by conjugation. -/
theorem prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_im_eq_taylorCoordinates
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) (T t : ℝ) :
    let law : Measure ℝ :=
      NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
          X hX N).aemeasurable
    let u : ℝ := t / Real.sqrt (N + 1 : ℝ)
    let phi : ℂ := MeasureTheory.charFun
      (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (X 0) (hX 0).aemeasurable : Measure ℝ) u
    let a : ℝ := 1 - u ^ 2 / 2
    let r : ℂ := phi - (a : ℂ)
    let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
    let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
    (prawitzZeroPhaseDifference
        (reflectedLaw law)
        (reflectedLaw NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
        T t).im =
      (-(scaledPrawitzSmoothingFilter T t).re *
          (r.re * s.im + r.im * s.re) +
        (scaledPrawitzSmoothingFilter T t).im *
          (r.re * s.re - r.im * s.im + c)) / t := by
  dsimp only
  rw [prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_eq_conj_taylorGeomSum
    X hX hIndep hIdent N T t]
  exact complex_mul_conj_taylorProduct_div_im _ _ _ _ _

/-- Simultaneous reflection preserves the characteristic-function discrepancy
quotient. -/
theorem charFunDiscrepancyQuotient_reflectedLaw
    (mu nu : Measure ℝ) (t : ℝ) :
    charFunDiscrepancyQuotient (reflectedLaw mu) (reflectedLaw nu) t =
      charFunDiscrepancyQuotient mu nu t := by
  unfold charFunDiscrepancyQuotient
  by_cases ht : t = 0
  · simp [ht]
  · rw [if_neg ht, if_neg ht, charFun_reflectedLaw, charFun_reflectedLaw,
      MeasureTheory.charFun_neg, MeasureTheory.charFun_neg,
      ← map_sub, Complex.norm_conj]

/-- The reflected translated point-kernel integral is the real part of the
Prawitz inversion functional of the reflected law. -/
theorem integral_prawitzPointKernel_reflected_sub_eq_re_prawitzInversion
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, prawitzPointKernel T (x - y) ∂mu) =
      (prawitzInversion T
        (MeasureTheory.charFun (reflectedLaw mu)) (-x)).re := by
  letI : IsProbabilityMeasure (reflectedLaw mu) :=
    reflectedLaw_isProbabilityMeasure mu
  have hRef1 := integrable_abs_reflectedLaw mu hmu1
  have hForward := integrable_prawitzPointKernel_sub
    (reflectedLaw mu) hRef1 hT (-x)
  have hMap :
      (∫ z, prawitzPointKernel T (z - (-x)) ∂reflectedLaw mu) =
        ∫ y, prawitzPointKernel T (x - y) ∂mu := by
    unfold reflectedLaw
    rw [integral_map (by fun_prop) hForward.aestronglyMeasurable]
    apply integral_congr_ae
    exact ae_of_all mu fun y => congrArg (prawitzPointKernel T) (by ring)
  rw [← hMap]
  exact integral_prawitzPointKernel_sub_eq_re_prawitzInversion
    (reflectedLaw mu) hRef1 hT (-x)

/-- Frequency-space form of the expected signed imbalance.  The centered-CDF
term is retained explicitly, recording the part not supplied by the compact
Prawitz inversion. -/
theorem integral_prawitzSlackImbalance_eq_re_inversions_sub_centeredCDF
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, prawitzSlackImbalance T x y ∂mu) =
      (prawitzInversion T (MeasureTheory.charFun mu) x).re -
        (prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw mu)) (-x)).re -
        (2 * cdf mu x - 1) := by
  rw [integral_prawitzSlackImbalance_eq_pointKernelDifference_sub_centeredCDF
      mu x
      (integrable_prawitzPointKernel_sub mu hmu1 hT x)
      (integrable_prawitzPointKernel_reflected_sub mu hmu1 hT x),
    integral_prawitzPointKernel_sub_eq_re_prawitzInversion mu hmu1 hT x,
    integral_prawitzPointKernel_reflected_sub_eq_re_prawitzInversion
      mu hmu1 hT x]

/-- Exact reverse one-sided CDF comparison, retaining the real part of the
reflected Prawitz inversion difference before taking its norm. -/
theorem cdf_sub_cdf_le_re_reflectedPrawitzInversion_sub_add_reflection
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf nu x - cdf mu x ≤
      (prawitzInversion T (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T (MeasureTheory.charFun (reflectedLaw nu)) (-x)).re +
      ∫ y, (prawitzPointKernel T (y - x) +
        prawitzPointKernel T (x - y)) ∂nu := by
  have hNu := cdf_sub_half_le_integral_prawitzPointKernel nu hT x
    (integrable_prawitzPointKernel_sub nu hnu1 hT x)
  have hMu := neg_integral_prawitzPointKernel_le_cdf_sub_half mu hT x
    (integrable_prawitzPointKernel_reflected_sub mu hmu1 hT x)
  have hNuForward := integrable_prawitzPointKernel_sub nu hnu1 hT x
  have hNuReflected :=
    integrable_prawitzPointKernel_reflected_sub nu hnu1 hT x
  have hMuEq :=
    integral_prawitzPointKernel_reflected_sub_eq_re_prawitzInversion
      mu hmu1 hT x
  have hNuEq :=
    integral_prawitzPointKernel_reflected_sub_eq_re_prawitzInversion
      nu hnu1 hT x
  have hSum :
      (∫ y, (prawitzPointKernel T (y - x) +
          prawitzPointKernel T (x - y)) ∂nu) =
        (∫ y, prawitzPointKernel T (y - x) ∂nu) +
          ∫ y, prawitzPointKernel T (x - y) ∂nu :=
    integral_add hNuForward hNuReflected
  rw [Complex.sub_re, ← hMuEq, ← hNuEq, hSum]
  linarith

/-- The reverse one-sided CDF comparison, expressed through Prawitz inversion
of reflected laws and the same point-kernel reflection remainder. -/
theorem cdf_sub_cdf_le_norm_reflectedPrawitzInversion_sub_add_reflection
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf nu x - cdf mu x ≤
      ‖prawitzInversion T (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T (MeasureTheory.charFun (reflectedLaw nu)) (-x)‖ +
      ∫ y, (prawitzPointKernel T (y - x) +
        prawitzPointKernel T (x - y)) ∂nu := by
  have hNu := cdf_sub_half_le_integral_prawitzPointKernel nu hT x
    (integrable_prawitzPointKernel_sub nu hnu1 hT x)
  have hMu := neg_integral_prawitzPointKernel_le_cdf_sub_half mu hT x
    (integrable_prawitzPointKernel_reflected_sub mu hmu1 hT x)
  have hNuForward := integrable_prawitzPointKernel_sub nu hnu1 hT x
  have hNuReflected :=
    integrable_prawitzPointKernel_reflected_sub nu hnu1 hT x
  have hMuEq :=
    integral_prawitzPointKernel_reflected_sub_eq_re_prawitzInversion
      mu hmu1 hT x
  have hNuEq :=
    integral_prawitzPointKernel_reflected_sub_eq_re_prawitzInversion
      nu hnu1 hT x
  have hSum :
      (∫ y, (prawitzPointKernel T (y - x) +
          prawitzPointKernel T (x - y)) ∂nu) =
        (∫ y, prawitzPointKernel T (y - x) ∂nu) +
          ∫ y, prawitzPointKernel T (x - y) ∂nu :=
    integral_add hNuForward hNuReflected
  have hRe :
      (prawitzInversion T (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T (MeasureTheory.charFun (reflectedLaw nu)) (-x)).re ≤
      ‖prawitzInversion T (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T (MeasureTheory.charFun (reflectedLaw nu)) (-x)‖ :=
    Complex.re_le_norm _
  rw [Complex.sub_re] at hRe
  rw [← hMuEq, ← hNuEq] at hRe
  rw [hSum]
  linarith

/-- Simultaneous reflection leaves the weighted positive-frequency Prawitz
discrepancy estimate unchanged. -/
theorem norm_prawitzInversion_reflectedLaw_sub_le_integral_discrepancy
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    ‖prawitzInversion T (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T (MeasureTheory.charFun (reflectedLaw nu)) (-x)‖ ≤
      (1 / Real.pi) * ∫ t in Icc 0 T,
        ‖scaledPrawitzSmoothingFilter T t‖ *
          charFunDiscrepancyQuotient mu nu t := by
  letI : IsProbabilityMeasure (reflectedLaw mu) :=
    reflectedLaw_isProbabilityMeasure mu
  letI : IsProbabilityMeasure (reflectedLaw nu) :=
    reflectedLaw_isProbabilityMeasure nu
  have hmuRef := integrable_abs_reflectedLaw mu hmu1
  have hnuRef := integrable_abs_reflectedLaw nu hnu1
  have h := norm_prawitzInversion_charFun_sub_le_integral_discrepancy
    (reflectedLaw mu) (reflectedLaw nu) hmuRef hnuRef hT (-x)
  simpa only [charFunDiscrepancyQuotient_reflectedLaw] using h

/-- Subtracting the expected slack imbalances of two laws separates into the
two Prawitz inversion differences and twice their signed CDF difference. -/
theorem integral_prawitzSlackImbalance_sub_eq_re_inversionDifferences_sub_two_mul_cdfDifference
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, prawitzSlackImbalance T x y ∂mu) -
        (∫ y, prawitzSlackImbalance T x y ∂nu) =
      (prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x).re -
      (prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw nu)) (-x)).re -
      2 * (cdf mu x - cdf nu x) := by
  rw [integral_prawitzSlackImbalance_eq_re_inversions_sub_centeredCDF
      mu hmu1 hT x,
    integral_prawitzSlackImbalance_eq_re_inversions_sub_centeredCDF
      nu hnu1 hT x]
  simp only [Complex.sub_re]
  ring

/-- The expected imbalance difference is controlled by the forward and
reflected inversion discrepancies together with twice the CDF gap. -/
theorem abs_integral_prawitzSlackImbalance_sub_le_inversions_add_two_mul_cdfGap
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    |(∫ y, prawitzSlackImbalance T x y ∂mu) -
        (∫ y, prawitzSlackImbalance T x y ∂nu)| ≤
      ‖prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x‖ +
      ‖prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw nu)) (-x)‖ +
      2 * cdfGap mu nu x := by
  rw [integral_prawitzSlackImbalance_sub_eq_re_inversionDifferences_sub_two_mul_cdfDifference
    mu nu hmu1 hnu1 hT x]
  let A : ℂ := prawitzInversion T (MeasureTheory.charFun mu) x -
    prawitzInversion T (MeasureTheory.charFun nu) x
  let B : ℂ := prawitzInversion T
      (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
    prawitzInversion T
      (MeasureTheory.charFun (reflectedLaw nu)) (-x)
  let d : ℝ := cdf mu x - cdf nu x
  change |A.re - B.re - 2 * d| ≤ ‖A‖ + ‖B‖ + 2 * |d|
  calc
    |A.re - B.re - 2 * d| ≤ |A.re - B.re| + |2 * d| := abs_sub _ _
    _ ≤ (|A.re| + |B.re|) + |2 * d| :=
      add_le_add (abs_sub A.re B.re) le_rfl
    _ = |A.re| + |B.re| + 2 * |d| := by
      rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
    _ ≤ ‖A‖ + ‖B‖ + 2 * |d| := by
      gcongr
      · exact Complex.abs_re_le_norm A
      · exact Complex.abs_re_le_norm B

/-- Applying the common positive-frequency discrepancy estimate to both
inversion terms exposes the factor-two CDF-gap feedback in the imbalance
comparison. -/
theorem abs_integral_prawitzSlackImbalance_sub_le_two_mul_discrepancy_add_two_mul_cdfGap
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    |(∫ y, prawitzSlackImbalance T x y ∂mu) -
        (∫ y, prawitzSlackImbalance T x y ∂nu)| ≤
      2 * ((1 / Real.pi) * ∫ t in Icc 0 T,
        ‖scaledPrawitzSmoothingFilter T t‖ *
          charFunDiscrepancyQuotient mu nu t) +
      2 * cdfGap mu nu x := by
  have himbalance :=
    abs_integral_prawitzSlackImbalance_sub_le_inversions_add_two_mul_cdfGap
      mu nu hmu1 hnu1 hT x
  have hforward :=
    norm_prawitzInversion_charFun_sub_le_integral_discrepancy
      mu nu hmu1 hnu1 hT x
  have hreflected :=
    norm_prawitzInversion_reflectedLaw_sub_le_integral_discrepancy
      mu nu hmu1 hnu1 hT x
  linarith

/-- After removing the diagonal atom, the exact two-law imbalance retains one
closed-CDF difference and one strict-lower-tail difference, with their signs
kept explicit. -/
theorem integral_prawitzSlackImbalanceOffDiagonal_sub_eq_re_inversionDifferences_sub_cdf_sub_Iio
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂nu) =
      (prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x).re -
      (prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw nu)) (-x)).re -
      (cdf mu x - cdf nu x) -
      (mu.real (Iio x) - nu.real (Iio x)) := by
  have himbalance :=
    integral_prawitzSlackImbalance_sub_eq_re_inversionDifferences_sub_two_mul_cdfDifference
      mu nu hmu1 hnu1 hT x
  have hsplit :=
    integral_prawitzSlackImbalance_sub_eq_offDiagonal_sub_atomDifference
      mu nu x
      (integrable_prawitzPointKernel_sub mu hmu1 hT x)
      (integrable_prawitzPointKernel_reflected_sub mu hmu1 hT x)
      (integrable_prawitzPointKernel_sub nu hnu1 hT x)
      (integrable_prawitzPointKernel_reflected_sub nu hnu1 hT x)
  have hatom := measureReal_singleton_sub_eq_cdf_sub_sub_Iio mu nu x
  linarith

/-- Midpoint-CDF form of the exact off-diagonal imbalance identity.  The two
CDF-side coordinates combine into twice their atom-symmetric midpoint. -/
theorem integral_prawitzSlackImbalanceOffDiagonal_sub_eq_re_inversionDifferences_sub_two_mul_midpointCDFDifference
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂nu) =
      (prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x).re -
      (prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw nu)) (-x)).re -
      2 * midpointCDFDifference mu nu x := by
  rw [integral_prawitzSlackImbalanceOffDiagonal_sub_eq_re_inversionDifferences_sub_cdf_sub_Iio
    mu nu hmu1 hnu1 hT x, midpointCDFDifference_eq]
  ring

/-- Taking norms in the midpoint-CDF identity keeps the residual CDF term as
one canonical quantity with its exact coefficient two. -/
theorem abs_integral_prawitzSlackImbalanceOffDiagonal_sub_le_inversions_add_two_mul_midpointCDFDifference
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    |(∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂nu)| ≤
      ‖prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x‖ +
      ‖prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw nu)) (-x)‖ +
      2 * |midpointCDFDifference mu nu x| := by
  rw [integral_prawitzSlackImbalanceOffDiagonal_sub_eq_re_inversionDifferences_sub_two_mul_midpointCDFDifference
    mu nu hmu1 hnu1 hT x]
  let A : ℂ := prawitzInversion T (MeasureTheory.charFun mu) x -
    prawitzInversion T (MeasureTheory.charFun nu) x
  let B : ℂ := prawitzInversion T
      (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
    prawitzInversion T
      (MeasureTheory.charFun (reflectedLaw nu)) (-x)
  let d : ℝ := midpointCDFDifference mu nu x
  change |A.re - B.re - 2 * d| ≤ ‖A‖ + ‖B‖ + 2 * |d|
  calc
    |A.re - B.re - 2 * d| ≤ |A.re - B.re| + |2 * d| := abs_sub _ _
    _ ≤ (|A.re| + |B.re|) + |2 * d| :=
      add_le_add (abs_sub A.re B.re) le_rfl
    _ = |A.re| + |B.re| + 2 * |d| := by
      rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
    _ ≤ ‖A‖ + ‖B‖ + 2 * |d| := by
      gcongr
      · exact Complex.abs_re_le_norm A
      · exact Complex.abs_re_le_norm B

/-- The off-diagonal imbalance difference is bounded by both inversion norms
plus its closed and strict-lower CDF coordinates. -/
theorem abs_integral_prawitzSlackImbalanceOffDiagonal_sub_le_inversions_add_cdf_coordinates
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    |(∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂nu)| ≤
      ‖prawitzInversion T (MeasureTheory.charFun mu) x -
        prawitzInversion T (MeasureTheory.charFun nu) x‖ +
      ‖prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T
          (MeasureTheory.charFun (reflectedLaw nu)) (-x)‖ +
      cdfGap mu nu x +
      |mu.real (Iio x) - nu.real (Iio x)| := by
  rw [integral_prawitzSlackImbalanceOffDiagonal_sub_eq_re_inversionDifferences_sub_cdf_sub_Iio
    mu nu hmu1 hnu1 hT x]
  let A : ℂ := prawitzInversion T (MeasureTheory.charFun mu) x -
    prawitzInversion T (MeasureTheory.charFun nu) x
  let B : ℂ := prawitzInversion T
      (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
    prawitzInversion T
      (MeasureTheory.charFun (reflectedLaw nu)) (-x)
  let d : ℝ := cdf mu x - cdf nu x
  let o : ℝ := mu.real (Iio x) - nu.real (Iio x)
  change |A.re - B.re - d - o| ≤ ‖A‖ + ‖B‖ + |d| + |o|
  calc
    |A.re - B.re - d - o| ≤ |A.re - B.re - d| + |o| := abs_sub _ _
    _ ≤ (|A.re - B.re| + |d|) + |o| :=
      add_le_add (abs_sub (A.re - B.re) d) le_rfl
    _ ≤ ((|A.re| + |B.re|) + |d|) + |o| := by
      gcongr
      exact abs_sub A.re B.re
    _ ≤ ‖A‖ + ‖B‖ + |d| + |o| := by
      gcongr
      · exact Complex.abs_re_le_norm A
      · exact Complex.abs_re_le_norm B

/-- Applying the common frequency discrepancy estimate to both inversion
coordinates leaves exactly the two CDF-side coordinates. -/
theorem abs_integral_prawitzSlackImbalanceOffDiagonal_sub_le_two_mul_discrepancy_add_cdf_coordinates
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    |(∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂nu)| ≤
      2 * ((1 / Real.pi) * ∫ t in Icc 0 T,
        ‖scaledPrawitzSmoothingFilter T t‖ *
          charFunDiscrepancyQuotient mu nu t) +
      cdfGap mu nu x +
      |mu.real (Iio x) - nu.real (Iio x)| := by
  have hoff :=
    abs_integral_prawitzSlackImbalanceOffDiagonal_sub_le_inversions_add_cdf_coordinates
      mu nu hmu1 hnu1 hT x
  have hforward :=
    norm_prawitzInversion_charFun_sub_le_integral_discrepancy
      mu nu hmu1 hnu1 hT x
  have hreflected :=
    norm_prawitzInversion_reflectedLaw_sub_le_integral_discrepancy
      mu nu hmu1 hnu1 hT x
  linarith

/-- Fully separating the two CDF coordinates recovers the same coefficient
two in Kolmogorov distance. -/
theorem abs_integral_prawitzSlackImbalanceOffDiagonal_sub_le_two_mul_discrepancy_add_two_mul_kolmogorovDistance
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    |(∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂nu)| ≤
      2 * ((1 / Real.pi) * ∫ t in Icc 0 T,
        ‖scaledPrawitzSmoothingFilter T t‖ *
          charFunDiscrepancyQuotient mu nu t) +
      2 * kolmogorovDistance mu nu := by
  have hoff :=
    abs_integral_prawitzSlackImbalanceOffDiagonal_sub_le_two_mul_discrepancy_add_cdf_coordinates
      mu nu hmu1 hnu1 hT x
  have hClosed := cdfGap_le_kolmogorovDistance mu nu x
  have hOpen := measureReal_Iio_gap_le_kolmogorovDistance mu nu x
  linarith

/-- Exact signed-integral representation for the reflected Prawitz inversion
difference used in the reverse CDF comparison. -/
theorem re_reflectedPrawitzInversion_charFun_sub_eq_signedIntegral
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (prawitzInversion T (MeasureTheory.charFun (reflectedLaw mu)) (-x) -
        prawitzInversion T (MeasureTheory.charFun (reflectedLaw nu)) (-x)).re =
      ((Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t in Icc 0 T,
          (symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun (reflectedLaw nu)) (-x) t)).re := by
  letI : IsProbabilityMeasure (reflectedLaw mu) :=
    reflectedLaw_isProbabilityMeasure mu
  letI : IsProbabilityMeasure (reflectedLaw nu) :=
    reflectedLaw_isProbabilityMeasure nu
  exact re_prawitzInversion_charFun_sub_eq_signedIntegral
    (reflectedLaw mu) (reflectedLaw nu)
    (integrable_abs_reflectedLaw mu hmu1)
    (integrable_abs_reflectedLaw nu hnu1) hT (-x)

/-- The joint positive-frequency integrand that retains the forward,
reflected, and midpoint-CDF coordinates before any triangle inequality. -/
noncomputable def midpointCorrectedPrawitzJointIntegrand
    (mu nu : Measure ℝ) (T x t : ℝ) : ℂ :=
  (symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
      symmetricPrawitzPVIntegrand T (MeasureTheory.charFun nu) x t) -
    (symmetricPrawitzPVIntegrand T
        (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
      symmetricPrawitzPVIntegrand T
        (MeasureTheory.charFun (reflectedLaw nu)) (-x) t) +
    (((4 * Real.pi / T * midpointCDFDifference mu nu x : ℝ) : ℂ) *
      Complex.I)

/-- The joint forward/reflected/midpoint integrand is integrable on every
positive frequency window under finite first moments. -/
theorem integrableOn_midpointCorrectedPrawitzJointIntegrand
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    IntegrableOn (midpointCorrectedPrawitzJointIntegrand mu nu T x)
      (Icc 0 T) := by
  letI : IsProbabilityMeasure (reflectedLaw mu) :=
    reflectedLaw_isProbabilityMeasure mu
  letI : IsProbabilityMeasure (reflectedLaw nu) :=
    reflectedLaw_isProbabilityMeasure nu
  have hForward : IntegrableOn (fun t =>
      symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
        symmetricPrawitzPVIntegrand T (MeasureTheory.charFun nu) x t)
      (Icc 0 T) :=
    (integrableOn_symmetricPrawitzPVIntegrand_charFun mu hmu1 hT x).sub
      (integrableOn_symmetricPrawitzPVIntegrand_charFun nu hnu1 hT x)
  have hReflected : IntegrableOn (fun t =>
      symmetricPrawitzPVIntegrand T
          (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
        symmetricPrawitzPVIntegrand T
          (MeasureTheory.charFun (reflectedLaw nu)) (-x) t)
      (Icc 0 T) :=
    (integrableOn_symmetricPrawitzPVIntegrand_charFun
        (reflectedLaw mu) (integrable_abs_reflectedLaw mu hmu1) hT (-x)).sub
      (integrableOn_symmetricPrawitzPVIntegrand_charFun
        (reflectedLaw nu) (integrable_abs_reflectedLaw nu hnu1) hT (-x))
  have hConstant : IntegrableOn (fun _t : ℝ =>
      (((4 * Real.pi / T * midpointCDFDifference mu nu x : ℝ) : ℂ) *
        Complex.I)) (Icc 0 T) :=
    integrableOn_const (by simp [Real.volume_Icc])
  simpa only [midpointCorrectedPrawitzJointIntegrand] using
    (hForward.sub hReflected).add hConstant

/-- Exact one-integral form of the off-diagonal Prawitz imbalance.  The
constant imaginary correction integrates to the midpoint-CDF term, so all
relative signs remain visible inside one positive-frequency integral. -/
theorem integral_prawitzSlackImbalanceOffDiagonal_sub_eq_re_jointSignedIntegral
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂nu) =
      ((Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t in Icc 0 T,
          midpointCorrectedPrawitzJointIntegrand mu nu T x t).re := by
  letI : IsProbabilityMeasure (reflectedLaw mu) :=
    reflectedLaw_isProbabilityMeasure mu
  letI : IsProbabilityMeasure (reflectedLaw nu) :=
    reflectedLaw_isProbabilityMeasure nu
  let F : ℝ → ℂ := fun t =>
    symmetricPrawitzPVIntegrand T (MeasureTheory.charFun mu) x t -
      symmetricPrawitzPVIntegrand T (MeasureTheory.charFun nu) x t
  let R : ℝ → ℂ := fun t =>
    symmetricPrawitzPVIntegrand T
        (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
      symmetricPrawitzPVIntegrand T
        (MeasureTheory.charFun (reflectedLaw nu)) (-x) t
  let C : ℂ :=
    ((4 * Real.pi / T * midpointCDFDifference mu nu x : ℝ) : ℂ) *
      Complex.I
  have hF : IntegrableOn F (Icc 0 T) :=
    (integrableOn_symmetricPrawitzPVIntegrand_charFun mu hmu1 hT x).sub
      (integrableOn_symmetricPrawitzPVIntegrand_charFun nu hnu1 hT x)
  have hR : IntegrableOn R (Icc 0 T) :=
    (integrableOn_symmetricPrawitzPVIntegrand_charFun
        (reflectedLaw mu) (integrable_abs_reflectedLaw mu hmu1) hT (-x)).sub
      (integrableOn_symmetricPrawitzPVIntegrand_charFun
        (reflectedLaw nu) (integrable_abs_reflectedLaw nu hnu1) hT (-x))
  have hJoint :
      (∫ t in Icc 0 T,
          midpointCorrectedPrawitzJointIntegrand mu nu T x t) =
        (∫ t in Icc 0 T, F t) - (∫ t in Icc 0 T, R t) + T • C := by
    change (∫ t in Icc 0 T, F t - R t + C) = _
    have hC : IntegrableOn (fun _t : ℝ => C) (Icc 0 T) :=
      integrableOn_const (by simp [Real.volume_Icc])
    have hAdd := integral_add (hF.sub hR) hC
    change (∫ t in Icc 0 T, F t - R t + C) =
      (∫ t in Icc 0 T, F t - R t) + (∫ _t in Icc 0 T, C) at hAdd
    rw [hAdd, integral_sub hF hR, setIntegral_const]
    congr 1
    rw [Measure.real, Real.volume_Icc,
      ENNReal.toReal_ofReal (sub_nonneg.mpr hT.le)]
    simp only [sub_zero]
    rfl
  rw [integral_prawitzSlackImbalanceOffDiagonal_sub_eq_re_inversionDifferences_sub_two_mul_midpointCDFDifference
      mu nu hmu1 hnu1 hT x,
    re_prawitzInversion_charFun_sub_eq_signedIntegral mu nu hmu1 hnu1 hT x,
    re_reflectedPrawitzInversion_charFun_sub_eq_signedIntegral
      mu nu hmu1 hnu1 hT x, hJoint]
  change
    ((Complex.I / (2 * Real.pi : ℝ)) * (∫ t in Icc 0 T, F t)).re -
          ((Complex.I / (2 * Real.pi : ℝ)) *
            (∫ t in Icc 0 T, R t)).re -
        2 * midpointCDFDifference mu nu x =
      ((Complex.I / (2 * Real.pi : ℝ)) *
        ((∫ t in Icc 0 T, F t) - (∫ t in Icc 0 T, R t) + T • C)).re
  have hcoef :
      Complex.I / (2 * Real.pi : ℝ) =
        (((2 * Real.pi)⁻¹ : ℝ) : ℂ) * Complex.I := by
    rw [div_eq_mul_inv, ← Complex.ofReal_inv]
    ring
  have hTC :
      T • C =
        (((4 * Real.pi * midpointCDFDifference mu nu x : ℝ) : ℂ) *
          Complex.I) := by
    dsimp only [C]
    change ((T : ℂ) *
      (((4 * Real.pi / T * midpointCDFDifference mu nu x : ℝ) : ℂ) *
        Complex.I)) = _
    push_cast
    field_simp [hT.ne']
  have hCorrection :
      ((Complex.I / (2 * Real.pi : ℝ)) * (T • C)).re =
        -2 * midpointCDFDifference mu nu x := by
    rw [hcoef, hTC]
    simp only [Complex.mul_re, Complex.mul_im, Complex.I_re, Complex.I_im,
      Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero, add_zero,
      mul_one]
    field_simp [hT.ne', Real.pi_ne_zero]
    ring
  rw [mul_add, mul_sub]
  simp only [Complex.add_re, Complex.sub_re, hCorrection]
  ring

/-- Exact real coordinate of the joint signed integrand at nonzero frequency. -/
theorem re_prawitzCoefficient_mul_midpointCorrectedPrawitzJointIntegrand
    (mu nu : Measure ℝ) {T : ℝ} (hT : T ≠ 0) (x : ℝ)
    {t : ℝ} (ht : t ≠ 0) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
        midpointCorrectedPrawitzJointIntegrand mu nu T x t).re =
      -((prawitzPVNumerator T (MeasureTheory.charFun mu) x t).im -
          (prawitzPVNumerator T (MeasureTheory.charFun nu) x t).im) /
          (Real.pi * t) +
        ((prawitzPVNumerator T
            (MeasureTheory.charFun (reflectedLaw mu)) (-x) t).im -
          (prawitzPVNumerator T
            (MeasureTheory.charFun (reflectedLaw nu)) (-x) t).im) /
          (Real.pi * t) -
        2 * midpointCDFDifference mu nu x / T := by
  have hForward := re_prawitzCoefficient_mul_symmetric_sub (T := T)
    (isHermitianFrequencyFunction_charFun mu)
    (isHermitianFrequencyFunction_charFun nu) x ht
  have hReflected := re_prawitzCoefficient_mul_symmetric_sub (T := T)
    (isHermitianFrequencyFunction_charFun (reflectedLaw mu))
    (isHermitianFrequencyFunction_charFun (reflectedLaw nu)) (-x) ht
  have hCorrection :
      ((Complex.I / (2 * Real.pi : ℝ)) *
        (((4 * Real.pi / T * midpointCDFDifference mu nu x : ℝ) : ℂ) *
          Complex.I)).re =
        -2 * midpointCDFDifference mu nu x / T := by
    have hcoef :
        Complex.I / (2 * Real.pi : ℝ) =
          (((2 * Real.pi)⁻¹ : ℝ) : ℂ) * Complex.I := by
      rw [div_eq_mul_inv, ← Complex.ofReal_inv]
      ring
    rw [hcoef]
    simp only [Complex.mul_re, Complex.mul_im, Complex.I_re, Complex.I_im,
      Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero, add_zero,
      mul_one]
    field_simp [hT, Real.pi_ne_zero]
    ring
  rw [midpointCorrectedPrawitzJointIntegrand, mul_add, mul_sub]
  simp only [Complex.add_re, Complex.sub_re, hForward, hReflected,
    hCorrection]
  ring

/-- Simultaneous reflection cancels the imaginary filter coordinate from the
signed difference of forward and reflected Prawitz numerators. -/
theorem reflected_sub_im_sub_forward_eq_filter_re_mul_phase_im
    (mu nu : Measure ℝ) (T x t : ℝ) :
    -((prawitzPVNumerator T (MeasureTheory.charFun mu) x t).im -
        (prawitzPVNumerator T (MeasureTheory.charFun nu) x t).im) +
      ((prawitzPVNumerator T
          (MeasureTheory.charFun (reflectedLaw mu)) (-x) t).im -
        (prawitzPVNumerator T
          (MeasureTheory.charFun (reflectedLaw nu)) (-x) t).im) =
      -2 * (scaledPrawitzSmoothingFilter T t).re *
        (Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
          (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t)).im := by
  let M : ℂ := scaledPrawitzSmoothingFilter T t
  let z : ℂ := Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
    (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t)
  have hForward :
      prawitzPVNumerator T (MeasureTheory.charFun mu) x t -
          prawitzPVNumerator T (MeasureTheory.charFun nu) x t = M * z := by
    rw [prawitzPVNumerator_sub]
    dsimp only [M, z]
    ring
  have hPhase :
      Complex.exp (((-(t * (-x)) : ℝ) : ℂ) * Complex.I) *
          (MeasureTheory.charFun (reflectedLaw mu) t -
            MeasureTheory.charFun (reflectedLaw nu) t) =
        (starRingEnd ℂ) z := by
    dsimp only [z]
    rw [charFun_reflectedLaw, charFun_reflectedLaw,
      MeasureTheory.charFun_neg, MeasureTheory.charFun_neg]
    simp only [map_mul, map_sub]
    rw [← Complex.exp_conj]
    congr 2
    apply Complex.ext <;> simp
  have hReflected :
      prawitzPVNumerator T
          (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
        prawitzPVNumerator T
          (MeasureTheory.charFun (reflectedLaw nu)) (-x) t =
        M * (starRingEnd ℂ) z := by
    rw [prawitzPVNumerator_sub]
    calc
      Complex.exp (((-(t * -x) : ℝ) : ℂ) * Complex.I) *
            scaledPrawitzSmoothingFilter T t *
          (MeasureTheory.charFun (reflectedLaw mu) t -
            MeasureTheory.charFun (reflectedLaw nu) t) =
          M *
            (Complex.exp (((-(t * -x) : ℝ) : ℂ) * Complex.I) *
              (MeasureTheory.charFun (reflectedLaw mu) t -
                MeasureTheory.charFun (reflectedLaw nu) t)) := by
            dsimp only [M]
            ring
      _ = M * (starRingEnd ℂ) z := by rw [hPhase]
  rw [← Complex.sub_im, ← Complex.sub_im, hForward, hReflected]
  dsimp only [M, z]
  simp only [Complex.mul_im, Complex.conj_re, Complex.conj_im]
  ring

/-- The phase-shifted characteristic function has the expected sine
coordinate centered at the spatial point. -/
theorem phase_mul_charFun_im_eq_integral_sin_sub
    (mu : Measure ℝ) [IsProbabilityMeasure mu] (x t : ℝ) :
    (Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
        MeasureTheory.charFun mu t).im =
      ∫ y, Real.sin (t * (y - x)) ∂mu := by
  rw [MeasureTheory.charFun_apply_real]
  have hMul :
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
          (∫ y, Complex.exp ((t : ℂ) * (y : ℂ) * Complex.I) ∂mu) =
        ∫ y, Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
          Complex.exp ((t : ℂ) * (y : ℂ) * Complex.I) ∂mu :=
    (integral_const_mul _ _).symm
  rw [hMul]
  have hInt : Integrable (fun y : ℝ =>
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
        Complex.exp ((t : ℂ) * (y : ℂ) * Complex.I)) mu := by
    refine Integrable.of_bound (by fun_prop) 1 ?_
    exact ae_of_all mu fun y => by
      simp [Complex.norm_exp, Complex.mul_re]
  have hIm :
      (∫ y, Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
        Complex.exp ((t : ℂ) * (y : ℂ) * Complex.I) ∂mu).im =
      ∫ y, (Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
        Complex.exp ((t : ℂ) * (y : ℂ) * Complex.I)).im ∂mu := by
    simpa using (integral_im hInt).symm
  rw [hIm]
  apply integral_congr_ae
  exact ae_of_all mu fun y => by
    change (Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
      Complex.exp ((t : ℂ) * (y : ℂ) * Complex.I)).im =
        Real.sin (t * (y - x))
    rw [← Complex.exp_add]
    have harg :
        (((-(t * x) : ℝ) : ℂ) * Complex.I) +
            ((t : ℂ) * (y : ℂ) * Complex.I) =
          (((t * (y - x) : ℝ) : ℂ) * Complex.I) := by
      push_cast
      ring
    rw [harg, Complex.exp_ofReal_mul_I_im]

/-- The phase-shifted characteristic-function discrepancy is the difference
of centered sine expectations. -/
theorem phase_mul_charFun_sub_im_eq_integral_sin_sub
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (x t : ℝ) :
    (Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
        (MeasureTheory.charFun mu t - MeasureTheory.charFun nu t)).im =
      (∫ y, Real.sin (t * (y - x)) ∂mu) -
        ∫ y, Real.sin (t * (y - x)) ∂nu := by
  rw [mul_sub, Complex.sub_im,
    phase_mul_charFun_im_eq_integral_sin_sub,
    phase_mul_charFun_im_eq_integral_sin_sub]

/-- Atom-symmetric lower-ray kernel: one below the cut, one half at the cut,
and zero above it. -/
noncomputable def midpointRayKernel (x y : ℝ) : ℝ :=
  (((Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y) +
    ((Iio x).indicator (fun _ : ℝ => (1 : ℝ)) y)) / 2

/-- Joint measurability of the atom-symmetric lower-ray kernel in its cut and
evaluation coordinates. -/
theorem measurable_midpointRayKernel_uncurry :
    Measurable (Function.uncurry midpointRayKernel) := by
  change Measurable (fun p : ℝ × ℝ =>
    ((if p.2 ≤ p.1 then (1 : ℝ) else 0) +
      (if p.2 < p.1 then (1 : ℝ) else 0)) / 2)
  apply Measurable.div_const
  apply Measurable.add
  · exact Measurable.ite (measurableSet_le measurable_snd measurable_fst)
      measurable_const measurable_const
  · exact Measurable.ite (measurableSet_lt measurable_snd measurable_fst)
      measurable_const measurable_const

theorem integral_midpointRayKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu] (x : ℝ) :
    ∫ y, midpointRayKernel x y ∂mu = midpointCDF mu x := by
  have hClosed : Integrable
      ((Iic x).indicator (fun _ : ℝ => (1 : ℝ))) mu :=
    (integrable_const (1 : ℝ)).indicator measurableSet_Iic
  have hOpen : Integrable
      ((Iio x).indicator (fun _ : ℝ => (1 : ℝ))) mu :=
    (integrable_const (1 : ℝ)).indicator measurableSet_Iio
  have hClosedInt :
      (∫ y, (Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y ∂mu) =
        mu.real (Iic x) := by
    simpa only [Pi.one_apply] using
      (integral_indicator_one (μ := mu) measurableSet_Iic)
  have hOpenInt :
      (∫ y, (Iio x).indicator (fun _ : ℝ => (1 : ℝ)) y ∂mu) =
        mu.real (Iio x) := by
    simpa only [Pi.one_apply] using
      (integral_indicator_one (μ := mu) measurableSet_Iio)
  change (∫ y, (((Iic x).indicator (fun _ : ℝ => (1 : ℝ)) y) +
    ((Iio x).indicator (fun _ : ℝ => (1 : ℝ)) y)) / 2 ∂mu) = _
  rw [integral_div, integral_add hClosed hOpen,
    hClosedInt, hOpenInt,
    midpointCDF, ProbabilityTheory.cdf_eq_real]

/-- One-law real kernel whose expectation combines the centered sine
coordinate with the atom-symmetric midpoint correction. -/
noncomputable def midpointCorrectedSineKernel
    (T x t y : ℝ) : ℝ :=
  (-2 * (scaledPrawitzSmoothingFilter T t).re /
      (Real.pi * t)) * Real.sin (t * (y - x)) -
    (2 / T) * midpointRayKernel x y

/-- Joint measurability of the midpoint-corrected sine kernel in frequency
and space. -/
theorem measurable_midpointCorrectedSineKernel_uncurry (T x : ℝ) :
    Measurable (fun p : ℝ × ℝ =>
      midpointCorrectedSineKernel T x p.1 p.2) := by
  unfold midpointCorrectedSineKernel
  have hfilter : Measurable (fun p : ℝ × ℝ =>
      scaledPrawitzSmoothingFilter T p.1) :=
    (measurable_scaledPrawitzSmoothingFilter T).comp measurable_fst
  have hray : Measurable (fun p : ℝ × ℝ => midpointRayKernel x p.2) := by
    unfold midpointRayKernel
    exact (((measurable_const.indicator measurableSet_Iic).comp measurable_snd).add
      ((measurable_const.indicator measurableSet_Iio).comp measurable_snd)).div_const 2
  fun_prop

theorem integral_midpointCorrectedSineKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu] (T x t : ℝ) :
    ∫ y, midpointCorrectedSineKernel T x t y ∂mu =
      (-2 * (scaledPrawitzSmoothingFilter T t).re *
          (∫ y, Real.sin (t * (y - x)) ∂mu)) /
        (Real.pi * t) -
      2 * midpointCDF mu x / T := by
  have hSin : Integrable (fun y : ℝ => Real.sin (t * (y - x))) mu := by
    refine Integrable.of_bound (by fun_prop) 1 ?_
    exact ae_of_all mu fun y => by
      simpa only [Real.norm_eq_abs] using Real.abs_sin_le_one (t * (y - x))
  have hMid : Integrable (midpointRayKernel x) mu := by
    unfold midpointRayKernel
    exact (((integrable_const (1 : ℝ)).indicator measurableSet_Iic).add
      ((integrable_const (1 : ℝ)).indicator measurableSet_Iio)).div_const 2
  change (∫ y,
      (-2 * (scaledPrawitzSmoothingFilter T t).re /
          (Real.pi * t)) * Real.sin (t * (y - x)) -
        (2 / T) * midpointRayKernel x y ∂mu) = _
  rw [integral_sub (hSin.const_mul _) (hMid.const_mul _),
    integral_const_mul, integral_const_mul,
    integral_midpointRayKernel]
  ring

theorem midpointRayKernel_of_lt {x y : ℝ} (hyx : y < x) :
    midpointRayKernel x y = 1 := by
  simp [midpointRayKernel, hyx, hyx.le]

@[simp] theorem midpointRayKernel_self (x : ℝ) :
    midpointRayKernel x x = 1 / 2 := by
  simp [midpointRayKernel]

theorem midpointRayKernel_of_lt' {x y : ℝ} (hxy : x < y) :
    midpointRayKernel x y = 0 := by
  simp [midpointRayKernel, hxy.le, not_le_of_gt hxy]

/-- The atom-symmetric lower-ray kernel always takes values in the unit
interval. -/
theorem abs_midpointRayKernel_le_one (x y : ℝ) :
    |midpointRayKernel x y| ≤ 1 := by
  rcases lt_trichotomy y x with hyx | hxy | hxy
  · rw [midpointRayKernel_of_lt hyx]
    norm_num
  · subst y
    rw [midpointRayKernel_self]
    norm_num
  · rw [midpointRayKernel_of_lt' hxy]
    norm_num

theorem midpointCorrectedSineKernel_of_lt
    (T t : ℝ) {x y : ℝ} (hyx : y < x) :
    midpointCorrectedSineKernel T x t y =
      (-2 * (scaledPrawitzSmoothingFilter T t).re /
        (Real.pi * t)) * Real.sin (t * (y - x)) - 2 / T := by
  rw [midpointCorrectedSineKernel, midpointRayKernel_of_lt hyx]
  ring

@[simp] theorem midpointCorrectedSineKernel_self
    (T x t : ℝ) :
    midpointCorrectedSineKernel T x t x = -1 / T := by
  rw [midpointCorrectedSineKernel, midpointRayKernel_self]
  simp only [sub_self, mul_zero, Real.sin_zero, mul_zero, zero_sub]
  ring

theorem midpointCorrectedSineKernel_of_lt'
    (T t : ℝ) {x y : ℝ} (hxy : x < y) :
    midpointCorrectedSineKernel T x t y =
      (-2 * (scaledPrawitzSmoothingFilter T t).re /
        (Real.pi * t)) * Real.sin (t * (y - x)) := by
  rw [midpointCorrectedSineKernel, midpointRayKernel_of_lt' hxy]
  ring

/-- A first-moment-compatible majorant for the midpoint-corrected sine
kernel on the positive Prawitz frequency window.  The apparent singularity
at `t = 0` is removed by `|sin (t z)| ≤ |t z|`. -/
theorem abs_midpointCorrectedSineKernel_le
    {T t : ℝ} (hT : 0 < T) (ht0 : 0 < t) (htT : t ≤ T)
    (x y : ℝ) :
    |midpointCorrectedSineKernel T x t y| ≤
      14 * |y - x| + 2 / T := by
  have hfilter : |(scaledPrawitzSmoothingFilter T t).re| ≤ 7 := by
    exact (Complex.abs_re_le_norm _).trans
      (norm_scaledPrawitzSmoothingFilter_le_seven hT ⟨ht0.le, htT⟩)
  have hsin : |Real.sin (t * (y - x))| ≤ t * |y - x| := by
    calc
      |Real.sin (t * (y - x))| ≤ |t * (y - x)| := Real.abs_sin_le_abs
      _ = t * |y - x| := by rw [abs_mul, abs_of_pos ht0]
  have hpi : 1 ≤ Real.pi := by
    nlinarith [Real.one_le_pi_div_two]
  have hfirst :
      |(-2 * (scaledPrawitzSmoothingFilter T t).re /
          (Real.pi * t)) * Real.sin (t * (y - x))| ≤
        14 * |y - x| := by
    rw [abs_mul, abs_div, abs_mul, abs_neg,
      abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2),
      abs_mul, abs_of_pos Real.pi_pos, abs_of_pos ht0]
    calc
      (2 * |(scaledPrawitzSmoothingFilter T t).re| / (Real.pi * t)) *
          |Real.sin (t * (y - x))| ≤
        (2 * 7 / (Real.pi * t)) * (t * |y - x|) := by
          gcongr
      _ = (14 / Real.pi) * |y - x| := by
        field_simp [ht0.ne', Real.pi_ne_zero]
        ring
      _ ≤ 14 * |y - x| := by
        gcongr
        exact (div_le_iff₀ Real.pi_pos).2 (by nlinarith)
  have hray : |(2 / T) * midpointRayKernel x y| ≤ 2 / T := by
    rw [abs_mul, abs_of_nonneg (div_nonneg (by norm_num) hT.le)]
    exact mul_le_of_le_one_right (div_nonneg (by norm_num) hT.le)
      (abs_midpointRayKernel_le_one x y)
  unfold midpointCorrectedSineKernel
  calc
    |_ - _| ≤
        |(-2 * (scaledPrawitzSmoothingFilter T t).re /
          (Real.pi * t)) * Real.sin (t * (y - x))| +
        |(2 / T) * midpointRayKernel x y| := abs_sub _ _
    _ ≤ 14 * |y - x| + 2 / T := add_le_add hfirst hray

/-- Closed-window form of the first-moment majorant, including the removable
frequency `t = 0`. -/
theorem abs_midpointCorrectedSineKernel_le_of_mem_Icc
    {T t : ℝ} (hT : 0 < T) (ht : t ∈ Icc (0 : ℝ) T)
    (x y : ℝ) :
    |midpointCorrectedSineKernel T x t y| ≤
      14 * |y - x| + 2 / T := by
  rcases ht with ⟨ht0, htT⟩
  rcases ht0.eq_or_lt with rfl | ht0
  · unfold midpointCorrectedSineKernel
    simp only [mul_zero, Real.sin_zero, zero_mul, div_zero,
      zero_sub, abs_neg]
    have hray : |(2 / T) * midpointRayKernel x y| ≤ 2 / T := by
      rw [abs_mul, abs_of_nonneg (div_nonneg (by norm_num) hT.le)]
      exact mul_le_of_le_one_right (div_nonneg (by norm_num) hT.le)
        (abs_midpointRayKernel_le_one x y)
    exact hray.trans
      (le_add_of_nonneg_left (mul_nonneg (by norm_num) (abs_nonneg _)))
  · exact abs_midpointCorrectedSineKernel_le hT ht0 htT x y

/-- Finite first moment makes the midpoint-corrected sine kernel integrable
on the product of its closed frequency window with the probability law. -/
theorem integrable_prod_midpointCorrectedSineKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    Integrable (fun p : ℝ × ℝ =>
      midpointCorrectedSineKernel T x p.1 p.2)
      ((volume.restrict (Icc 0 T)).prod mu) := by
  have hid : Integrable (fun y : ℝ => y) mu := by
    refine (integrable_norm_iff
      (f := fun y : ℝ => y) measurable_id.aestronglyMeasurable).mp ?_
    simpa only [Real.norm_eq_abs] using hmu1
  have hshift : Integrable (fun y : ℝ => y - x) mu :=
    hid.sub (integrable_const x)
  have habs : Integrable (fun y : ℝ => |y - x|) mu := by
    simpa only [Real.norm_eq_abs] using hshift.norm
  have hmajorY : Integrable (fun y : ℝ => 14 * |y - x| + 2 / T) mu :=
    (habs.const_mul 14).add (integrable_const (2 / T))
  have hmajor : Integrable (fun p : ℝ × ℝ =>
      14 * |p.2 - x| + 2 / T) ((volume.restrict (Icc 0 T)).prod mu) :=
    hmajorY.comp_snd (volume.restrict (Icc 0 T))
  apply hmajor.mono'
  · exact (measurable_midpointCorrectedSineKernel_uncurry T x).aestronglyMeasurable
  · have hmem : ∀ᵐ p : ℝ × ℝ ∂((volume.restrict (Icc 0 T)).prod mu),
        p.1 ∈ Icc (0 : ℝ) T := by
      rw [MeasureTheory.Measure.ae_prod_iff_ae_ae
        (measurableSet_Icc.preimage measurable_fst)]
      filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      exact ae_of_all mu fun _ => ht
    filter_upwards [hmem] with p hp
    simpa only [Real.norm_eq_abs] using
      (abs_midpointCorrectedSineKernel_le_of_mem_Icc hT hp x p.2)

/-- Spatial kernel obtained by retaining the signed midpoint-corrected
frequency average over the full Prawitz window. -/
noncomputable def midpointCorrectedSineAveragedKernel
    (T x y : ℝ) : ℝ :=
  ∫ t in Icc 0 T, midpointCorrectedSineKernel T x t y

/-- The averaged kernel retains the centered diagonal value exactly. -/
@[simp] theorem midpointCorrectedSineAveragedKernel_self
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    midpointCorrectedSineAveragedKernel T x x = -1 := by
  unfold midpointCorrectedSineAveragedKernel
  simp_rw [midpointCorrectedSineKernel_self]
  simp [hT.le]
  field_simp [hT.ne']

/-- The frequency-averaged spatial kernel is integrable under every
probability law with a finite first absolute moment. -/
theorem integrable_midpointCorrectedSineAveragedKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    Integrable (midpointCorrectedSineAveragedKernel T x) mu := by
  exact (integrable_prod_midpointCorrectedSineKernel mu hmu1 hT x).integral_prod_right

/-- Fubini identifies the frequency integral of kernel expectations with the
expectation of the signed frequency-averaged spatial kernel. -/
theorem integral_integral_midpointCorrectedSineKernel
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ t in Icc 0 T,
        ∫ y, midpointCorrectedSineKernel T x t y ∂mu) =
      ∫ y, midpointCorrectedSineAveragedKernel T x y ∂mu := by
  exact integral_integral_swap
    (integrable_prod_midpointCorrectedSineKernel mu hmu1 hT x)

/-- One full sine period to the left of the center, the sine coordinate
vanishes and only the lower-ray correction remains. -/
theorem midpointCorrectedSineKernel_left_latticePoint
    {T t : ℝ} (ht : 0 < t) (x : ℝ) :
    midpointCorrectedSineKernel T x t (x - 2 * Real.pi / t) = -2 / T := by
  have hyx : x - 2 * Real.pi / t < x := by
    have hdiv : 0 < 2 * Real.pi / t := div_pos (by positivity) ht
    linarith
  rw [midpointCorrectedSineKernel_of_lt T t hyx]
  have hphase : t * ((x - 2 * Real.pi / t) - x) = -2 * Real.pi := by
    field_simp [ht.ne']
    ring
  rw [hphase, show -2 * Real.pi = -(2 * Real.pi) by ring,
    Real.sin_neg, Real.sin_two_pi]
  ring

/-- One full sine period to the right of the center, both terms in the
midpoint-corrected kernel vanish. -/
theorem midpointCorrectedSineKernel_right_latticePoint
    {T t : ℝ} (ht : 0 < t) (x : ℝ) :
    midpointCorrectedSineKernel T x t (x + 2 * Real.pi / t) = 0 := by
  have hxy : x < x + 2 * Real.pi / t := by
    have hdiv : 0 < 2 * Real.pi / t := div_pos (by positivity) ht
    linarith
  rw [midpointCorrectedSineKernel_of_lt' T t hxy]
  have hphase : t * ((x + 2 * Real.pi / t) - x) = 2 * Real.pi := by
    field_simp [ht.ne']
    ring
  rw [hphase, Real.sin_two_pi]
  ring

/-- Three exact values across the midpoint jump already contribute `2 / T`
to the variation of the pointwise-frequency kernel. -/
theorem midpointCorrectedSineKernel_threePointVariation
    {T t : ℝ} (hT : 0 < T) (ht : 0 < t) (x : ℝ) :
    |midpointCorrectedSineKernel T x t (x - 2 * Real.pi / t) -
        midpointCorrectedSineKernel T x t x| +
      |midpointCorrectedSineKernel T x t x -
        midpointCorrectedSineKernel T x t (x + 2 * Real.pi / t)| = 2 / T := by
  rw [midpointCorrectedSineKernel_left_latticePoint ht,
    midpointCorrectedSineKernel_self,
    midpointCorrectedSineKernel_right_latticePoint ht]
  have hneg1 : -2 / T - (-1 / T) ≤ 0 := by
    have hTinv : 0 ≤ 1 / T := div_nonneg (by norm_num) hT.le
    rw [show -2 / T - (-1 / T) = -(1 / T) by ring]
    exact neg_nonpos.mpr hTinv
  have hneg2 : -1 / T - 0 ≤ 0 := by
    have hTinv : 0 ≤ 1 / T := div_nonneg (by norm_num) hT.le
    rw [show -1 / T - 0 = -(1 / T) by ring]
    exact neg_nonpos.mpr hTinv
  rw [abs_of_nonpos hneg1, abs_of_nonpos hneg2]
  ring

/-- Any `C / T` majorant for these three increments has coefficient at least
two, so the joint signed kernel cannot yield coefficient-one Kolmogorov
control through a plain total-variation estimate. -/
theorem two_le_of_midpointCorrectedSineKernel_threePointVariation_le
    {T t : ℝ} (hT : 0 < T) (ht : 0 < t) (x C : ℝ)
    (hC :
      |midpointCorrectedSineKernel T x t (x - 2 * Real.pi / t) -
          midpointCorrectedSineKernel T x t x| +
        |midpointCorrectedSineKernel T x t x -
          midpointCorrectedSineKernel T x t (x + 2 * Real.pi / t)| ≤ C / T) :
    2 ≤ C := by
  rw [midpointCorrectedSineKernel_threePointVariation hT ht x] at hC
  exact (div_le_div_iff_of_pos_right hT).mp hC

/-- The pointwise joint coordinate depends only on the real Prawitz-filter
coordinate; simultaneous reflection cancels its imaginary coordinate. -/
theorem re_prawitzCoefficient_mul_midpointCorrectedPrawitzJointIntegrand_eq_filter_re
    (mu nu : Measure ℝ) {T : ℝ} (hT : T ≠ 0) (x : ℝ)
    {t : ℝ} (ht : t ≠ 0) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
        midpointCorrectedPrawitzJointIntegrand mu nu T x t).re =
      (-2 * (scaledPrawitzSmoothingFilter T t).re *
          (Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) *
            (MeasureTheory.charFun mu t -
              MeasureTheory.charFun nu t)).im) /
        (Real.pi * t) -
      2 * midpointCDFDifference mu nu x / T := by
  rw [re_prawitzCoefficient_mul_midpointCorrectedPrawitzJointIntegrand
    mu nu hT x ht]
  have hCancel :=
    reflected_sub_im_sub_forward_eq_filter_re_mul_phase_im mu nu T x t
  calc
    -((prawitzPVNumerator T (MeasureTheory.charFun mu) x t).im -
          (prawitzPVNumerator T (MeasureTheory.charFun nu) x t).im) /
          (Real.pi * t) +
        ((prawitzPVNumerator T
            (MeasureTheory.charFun (reflectedLaw mu)) (-x) t).im -
          (prawitzPVNumerator T
            (MeasureTheory.charFun (reflectedLaw nu)) (-x) t).im) /
          (Real.pi * t) -
        2 * midpointCDFDifference mu nu x / T =
      (-((prawitzPVNumerator T (MeasureTheory.charFun mu) x t).im -
          (prawitzPVNumerator T (MeasureTheory.charFun nu) x t).im) +
        ((prawitzPVNumerator T
            (MeasureTheory.charFun (reflectedLaw mu)) (-x) t).im -
          (prawitzPVNumerator T
            (MeasureTheory.charFun (reflectedLaw nu)) (-x) t).im)) /
          (Real.pi * t) -
        2 * midpointCDFDifference mu nu x / T := by ring
    _ = _ := by rw [hCancel]

/-- Real measure-coordinate form of the joint signed integrand.  The frequency
term is the difference of centered sine expectations, kept signed against the
midpoint-CDF correction. -/
theorem re_prawitzCoefficient_mul_midpointCorrectedPrawitzJointIntegrand_eq_sine
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {T : ℝ} (hT : T ≠ 0) (x : ℝ) {t : ℝ} (ht : t ≠ 0) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
        midpointCorrectedPrawitzJointIntegrand mu nu T x t).re =
      (-2 * (scaledPrawitzSmoothingFilter T t).re *
          ((∫ y, Real.sin (t * (y - x)) ∂mu) -
            ∫ y, Real.sin (t * (y - x)) ∂nu)) /
        (Real.pi * t) -
      2 * midpointCDFDifference mu nu x / T := by
  rw [re_prawitzCoefficient_mul_midpointCorrectedPrawitzJointIntegrand_eq_filter_re
    mu nu hT x ht,
    phase_mul_charFun_sub_im_eq_integral_sin_sub]

/-- The joint signed Prawitz coordinate is one real-kernel expectation
difference, before any triangle or variation bound. -/
theorem re_prawitzCoefficient_mul_midpointCorrectedPrawitzJointIntegrand_eq_kernel
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    {T : ℝ} (hT : T ≠ 0) (x : ℝ) {t : ℝ} (ht : t ≠ 0) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
        midpointCorrectedPrawitzJointIntegrand mu nu T x t).re =
      (∫ y, midpointCorrectedSineKernel T x t y ∂mu) -
        ∫ y, midpointCorrectedSineKernel T x t y ∂nu := by
  rw [re_prawitzCoefficient_mul_midpointCorrectedPrawitzJointIntegrand_eq_sine
    mu nu hT x ht,
    integral_midpointCorrectedSineKernel,
    integral_midpointCorrectedSineKernel]
  unfold midpointCDFDifference
  ring

/-- Retaining the signed frequency integral turns the joint Prawitz
coordinate into an integral of real kernel-expectation differences.  This is
the pre-Fubini form needed before constructing an averaged spatial kernel. -/
theorem re_jointSignedIntegral_eq_integral_midpointCorrectedSineKernel_expectation_sub
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t in Icc 0 T,
          midpointCorrectedPrawitzJointIntegrand mu nu T x t).re =
      ∫ t in Icc 0 T,
        ((∫ y, midpointCorrectedSineKernel T x t y ∂mu) -
          ∫ y, midpointCorrectedSineKernel T x t y ∂nu) := by
  have hJoint : IntegrableOn
      (midpointCorrectedPrawitzJointIntegrand mu nu T x) (Icc 0 T) :=
    integrableOn_midpointCorrectedPrawitzJointIntegrand
      mu nu hmu1 hnu1 hT x
  let c : ℂ := Complex.I / (2 * Real.pi : ℝ)
  have hScaled : IntegrableOn (fun t => c *
      midpointCorrectedPrawitzJointIntegrand mu nu T x t) (Icc 0 T) :=
    hJoint.const_mul c
  calc
    (c * ∫ t in Icc 0 T,
        midpointCorrectedPrawitzJointIntegrand mu nu T x t).re =
        (∫ t in Icc 0 T,
          c * midpointCorrectedPrawitzJointIntegrand mu nu T x t).re := by
      congr 1
      exact (integral_const_mul
        (μ := volume.restrict (Icc (0 : ℝ) T)) c
        (midpointCorrectedPrawitzJointIntegrand mu nu T x)).symm
    _ = ∫ t in Icc 0 T,
        (c * midpointCorrectedPrawitzJointIntegrand mu nu T x t).re :=
      (integral_re hScaled).symm
    _ = ∫ t in Icc 0 T,
        ((∫ y, midpointCorrectedSineKernel T x t y ∂mu) -
          ∫ y, midpointCorrectedSineKernel T x t y ∂nu) := by
      apply integral_congr_ae
      filter_upwards [(volume.restrict (Icc (0 : ℝ) T)).ae_ne 0] with t ht
      dsimp only [c]
      exact re_prawitzCoefficient_mul_midpointCorrectedPrawitzJointIntegrand_eq_kernel
        mu nu hT.ne' x ht

/-- Fubini form of the exact joint signed coordinate: it is the difference
of expectations of one frequency-averaged spatial kernel. -/
theorem re_jointSignedIntegral_eq_integral_midpointCorrectedSineAveragedKernel_sub
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t in Icc 0 T,
          midpointCorrectedPrawitzJointIntegrand mu nu T x t).re =
      (∫ y, midpointCorrectedSineAveragedKernel T x y ∂mu) -
        ∫ y, midpointCorrectedSineAveragedKernel T x y ∂nu := by
  rw [re_jointSignedIntegral_eq_integral_midpointCorrectedSineKernel_expectation_sub
    mu nu hmu1 hnu1 hT x]
  have hmuProd := integrable_prod_midpointCorrectedSineKernel mu hmu1 hT x
  have hnuProd := integrable_prod_midpointCorrectedSineKernel nu hnu1 hT x
  rw [integral_sub hmuProd.integral_prod_left hnuProd.integral_prod_left,
    integral_integral_midpointCorrectedSineKernel mu hmu1 hT x,
    integral_integral_midpointCorrectedSineKernel nu hnu1 hT x]

/-- The off-diagonal imbalance difference and the averaged-kernel difference
are the same signed law coordinate. -/
theorem integral_prawitzSlackImbalanceOffDiagonal_sub_eq_integral_midpointCorrectedSineAveragedKernel_sub
    (mu nu : Measure ℝ) [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    (hnu1 : Integrable (fun y : ℝ => |y|) nu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂mu) -
        (∫ y, prawitzSlackImbalanceOffDiagonal T x y ∂nu) =
      (∫ y, midpointCorrectedSineAveragedKernel T x y ∂mu) -
        ∫ y, midpointCorrectedSineAveragedKernel T x y ∂nu := by
  rw [integral_prawitzSlackImbalanceOffDiagonal_sub_eq_re_jointSignedIntegral
    mu nu hmu1 hnu1 hT x,
    re_jointSignedIntegral_eq_integral_midpointCorrectedSineAveragedKernel_sub
      mu nu hmu1 hnu1 hT x]

/-- Pointwise identification of the frequency-averaged kernel: averaging
removes the diagonal atom from the imbalance profile and changes only a
law-independent constant. -/
theorem midpointCorrectedSineAveragedKernel_eq_offDiagonal_sub_one
    {T : ℝ} (hT : 0 < T) (x y : ℝ) :
    midpointCorrectedSineAveragedKernel T x y =
      prawitzSlackImbalanceOffDiagonal T x y - 1 := by
  have hy1 : Integrable (fun z : ℝ => |z|) (Measure.dirac y) :=
    integrable_dirac (by simp)
  have hx1 : Integrable (fun z : ℝ => |z|) (Measure.dirac x) :=
    integrable_dirac (by simp)
  have h :=
    integral_prawitzSlackImbalanceOffDiagonal_sub_eq_integral_midpointCorrectedSineAveragedKernel_sub
      (Measure.dirac y) (Measure.dirac x) hy1 hx1 hT x
  simp only [integral_dirac] at h
  have hOff : prawitzSlackImbalanceOffDiagonal T x x = 0 := by
    simp [prawitzSlackImbalanceOffDiagonal]
  rw [hOff, midpointCorrectedSineAveragedKernel_self hT x] at h
  linarith

/-- Reverse one-sided Prawitz comparison against the standard normal with the
signed reflected-frequency integral and Fejer remainder both kept exact. -/
theorem standardNormalCDF_sub_cdf_le_prawitz_signed
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x - cdf mu x ≤
      ((Complex.I / (2 * Real.pi : ℝ)) *
        ∫ t in Icc 0 T,
          (symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
            symmetricPrawitzPVIntegrand T
              (MeasureTheory.charFun
                (reflectedLaw
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw))
              (-x) t)).re +
      ∫ y, (prawitzPointKernel T (y - x) +
          prawitzPointKernel T (x - y))
        ∂NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw := by
  have hsigned :=
    cdf_sub_cdf_le_re_reflectedPrawitzInversion_sub_add_reflection
      mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
      hmu1 integrable_abs_standardNormalLaw hT x
  rw [re_reflectedPrawitzInversion_charFun_sub_eq_signedIntegral
    mu NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
    hmu1 integrable_abs_standardNormalLaw hT x] at hsigned
  exact hsigned

/-- The reverse standard-normal Prawitz comparison with the reflected
inversion and Fejer terms combined inside one real part. -/
theorem standardNormalCDF_sub_cdf_le_prawitz_signed_frequency
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x - cdf mu x ≤
      (((Complex.I / (2 * Real.pi : ℝ)) *
          ∫ t in Icc 0 T,
            (symmetricPrawitzPVIntegrand T
                (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
              symmetricPrawitzPVIntegrand T
                (MeasureTheory.charFun
                  (reflectedLaw
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw))
                (-x) t)) +
        ∫ z,
          Complex.exp (((-(T * x * z / 2) : ℝ) : ℂ) * Complex.I) *
            MeasureTheory.charFun
              NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
              (T * z / 2)
          ∂twofoldUniformKernel).re := by
  have hsigned := standardNormalCDF_sub_cdf_le_prawitz_signed
    mu hmu1 hT x
  rw [integral_prawitzReflection_standardNormal_eq_re_frequencyIntegral
    hT x] at hsigned
  simpa only [Complex.add_re] using hsigned

/-- The reflected reverse comparison as one signed positive-frequency
integral, preserving pointwise cancellation with the Gaussian Fejer term. -/
theorem standardNormalCDF_sub_cdf_le_prawitz_singleSignedIntegral
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x - cdf mu x ≤
      (∫ t in Icc 0 T,
        (Complex.I / (2 * Real.pi : ℝ)) *
            (symmetricPrawitzPVIntegrand T
                (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
              symmetricPrawitzPVIntegrand T
                (MeasureTheory.charFun
                  (reflectedLaw
                    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw))
                (-x) t) +
          (prawitzFejerFrequencyWeight T t : ℂ) *
            (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
                MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
              Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
                MeasureTheory.charFun
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)).re := by
  have hsigned := standardNormalCDF_sub_cdf_le_prawitz_signed_frequency
    mu hmu1 hT x
  rw [integral_prawitzReflectionFrequency_eq_pairedTriangularIntegral
    NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hT x] at hsigned
  letI : IsProbabilityMeasure (reflectedLaw mu) :=
    reflectedLaw_isProbabilityMeasure mu
  letI : IsProbabilityMeasure
      (reflectedLaw
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) :=
    reflectedLaw_isProbabilityMeasure
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let P : ℝ → ℂ := fun t =>
    symmetricPrawitzPVIntegrand T
        (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
      symmetricPrawitzPVIntegrand T
        (MeasureTheory.charFun
          (reflectedLaw
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw))
        (-x) t
  let R : ℝ → ℂ := fun t =>
    (prawitzFejerFrequencyWeight T t : ℂ) *
      (Complex.exp ((((x * t) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw (-t) +
        Complex.exp (((-(x * t) : ℝ) : ℂ) * Complex.I) *
          MeasureTheory.charFun
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw t)
  have hP : IntegrableOn P (Icc 0 T) := by
    exact (integrableOn_symmetricPrawitzPVIntegrand_charFun
      (reflectedLaw mu) (integrable_abs_reflectedLaw mu hmu1) hT (-x)).sub
      (integrableOn_symmetricPrawitzPVIntegrand_charFun
        (reflectedLaw
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
        (integrable_abs_reflectedLaw
          NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
          integrable_abs_standardNormalLaw) hT (-x))
  have hR : IntegrableOn R (Icc 0 T) := by
    exact (integrable_pairedPrawitzReflectionFrequencyIntegrand
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw hT x).integrableOn
  have hcombine := const_mul_setIntegral_add_setIntegral_eq_integral_add
    P R (Icc 0 T) hP hR (Complex.I / (2 * Real.pi : ℝ))
  change cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x -
      cdf mu x ≤
    ((Complex.I / (2 * Real.pi : ℝ)) * (∫ t in Icc 0 T, P t) +
      ∫ t in Icc 0 T, R t).re at hsigned
  change cdf NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw x -
      cdf mu x ≤
    (∫ t in Icc 0 T,
      ((Complex.I / (2 * Real.pi : ℝ)) * P t + R t)).re
  rw [hcombine] at hsigned
  exact hsigned

/-- Pairing Hermitian positive and negative frequencies has the same real
coefficient as twice the positive-frequency principal-value difference. -/
theorem re_prawitzCoefficient_mul_symmetric_sub_eq_positiveFrequency
    {T : ℝ} {f g : ℝ → ℂ}
    (hf : IsHermitianFrequencyFunction f)
    (hg : IsHermitianFrequencyFunction g)
    (x : ℝ) {t : ℝ} (ht : t ≠ 0) :
    ((Complex.I / (2 * Real.pi : ℝ)) *
        (symmetricPrawitzPVIntegrand T f x t -
          symmetricPrawitzPVIntegrand T g x t)).re =
      ((Complex.I / (Real.pi : ℝ)) *
        (prawitzPVIntegrand T f x t -
          prawitzPVIntegrand T g x t)).re := by
  rw [re_prawitzCoefficient_mul_symmetric_sub hf hg x ht]
  rw [← Complex.sub_im]
  unfold prawitzPVIntegrand
  rw [← sub_div]
  rw [Complex.mul_re, Complex.div_ofReal_re, Complex.div_ofReal_im,
    Complex.div_ofReal_re, Complex.div_ofReal_im]
  simp only [Complex.I_re, Complex.I_im, zero_div, one_div, zero_mul]
  field_simp [ht, Real.pi_ne_zero]
  ring

/-- The reverse Prawitz error keeps the reflected characteristic-function
phase and exact Gaussian cosine term together. -/
noncomputable def reversePrawitzPhasePreservingRemainder
    (mu : Measure ℝ) (T x : ℝ) : ℝ :=
  ((Complex.I / (Real.pi : ℝ)) *
      (∫ t in Icc (0 : ℝ) T,
        (prawitzPVIntegrand T
            (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
          prawitzPVIntegrand T
            (MeasureTheory.charFun
              (reflectedLaw
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw))
            (-x) t))).re +
    prawitzGaussianCosineRemainder T x

/-- Exact sine/cosine coordinate expansion of the reflected reverse
phase-preserving Prawitz remainder. -/
theorem reversePrawitzPhasePreservingRemainder_eq_integral_phaseCoordinates
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    reversePrawitzPhasePreservingRemainder mu T x =
      ∫ t in Icc (0 : ℝ) T,
        (-Real.sin (t * x) *
              (prawitzZeroPhaseDifference (reflectedLaw mu)
                (reflectedLaw
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                T t).re -
            Real.cos (t * x) *
              (prawitzZeroPhaseDifference (reflectedLaw mu)
                (reflectedLaw
                  NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
                T t).im) /
            Real.pi +
          2 * prawitzFejerFrequencyWeight T t *
            Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  letI : IsProbabilityMeasure (reflectedLaw mu) :=
    reflectedLaw_isProbabilityMeasure mu
  letI : IsProbabilityMeasure
      (reflectedLaw
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) :=
    reflectedLaw_isProbabilityMeasure
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let z : ℝ → ℂ := fun t =>
    prawitzPVIntegrand T
        (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
      prawitzPVIntegrand T
        (MeasureTheory.charFun
          (reflectedLaw
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)) (-x) t
  let P : ℝ → ℂ := fun t => (Complex.I / (Real.pi : ℝ)) * z t
  let G : ℝ → ℝ := fun t =>
    2 * prawitzFejerFrequencyWeight T t *
      Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)
  have hz : IntegrableOn z (Icc (0 : ℝ) T) := by
    simpa only [z] using integrableOn_prawitzPVIntegrand_charFun_sub
      (reflectedLaw mu)
      (reflectedLaw NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
      (integrable_abs_reflectedLaw mu hmu1)
      (integrable_abs_reflectedLaw
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
        integrable_abs_standardNormalLaw) hT (-x)
  have hP : IntegrableOn P (Icc (0 : ℝ) T) := by
    simpa only [P] using hz.const_mul (Complex.I / (Real.pi : ℝ))
  have hG : IntegrableOn G (Icc (0 : ℝ) T) := by
    apply Continuous.integrableOn_Icc
    dsimp only [G]
    unfold prawitzFejerFrequencyWeight
    fun_prop
  unfold reversePrawitzPhasePreservingRemainder
    prawitzGaussianCosineRemainder
  change ((Complex.I / (Real.pi : ℝ)) *
      (∫ t in Icc (0 : ℝ) T, z t)).re +
        ∫ t in Icc (0 : ℝ) T, G t = _
  calc
    ((Complex.I / (Real.pi : ℝ)) *
        (∫ t in Icc (0 : ℝ) T, z t)).re +
          ∫ t in Icc (0 : ℝ) T, G t =
        (∫ t in Icc (0 : ℝ) T, P t).re +
          ∫ t in Icc (0 : ℝ) T, G t := by
      congr 1
      exact congrArg Complex.re
        (integral_const_mul
          (μ := volume.restrict (Icc (0 : ℝ) T))
          (Complex.I / (Real.pi : ℝ)) z).symm
    _ = (∫ t in Icc (0 : ℝ) T, (P t).re) +
          ∫ t in Icc (0 : ℝ) T, G t := by
      exact congrArg (fun z : ℝ =>
        z + ∫ t in Icc (0 : ℝ) T, G t) (integral_re hP).symm
    _ = ∫ t in Icc (0 : ℝ) T, ((P t).re + G t) :=
      (integral_add hP.re hG).symm
    _ = _ := by
      apply integral_congr_ae
      filter_upwards with t
      dsimp only [P, z, G, prawitzZeroPhaseDifference]
      rw [prawitzPVIntegrand_charFun_sub_eq_phase_mul_zero]
      rw [Complex.mul_re, Complex.div_ofReal_re,
        Complex.div_ofReal_im, Complex.mul_re, Complex.mul_im]
      simp only [Complex.I_re, Complex.I_im, zero_div, one_div,
        zero_mul, Complex.exp_ofReal_mul_I_re,
        Complex.exp_ofReal_mul_I_im, Real.cos_neg, Real.sin_neg]
      rw [show t * -x = -(t * x) by ring, Real.cos_neg, Real.sin_neg]
      field_simp [Real.pi_ne_zero]
      ring

/-- The exact reflected reverse sine/cosine phase-coordinate integrand is
integrable on the closed Prawitz window. -/
theorem integrableOn_reversePrawitzPhaseCoordinateIntegrand
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    IntegrableOn (fun t : ℝ =>
      (-Real.sin (t * x) *
            (prawitzZeroPhaseDifference (reflectedLaw mu)
              (reflectedLaw
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              T t).re -
          Real.cos (t * x) *
            (prawitzZeroPhaseDifference (reflectedLaw mu)
              (reflectedLaw
                NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
              T t).im) /
          Real.pi +
        2 * prawitzFejerFrequencyWeight T t *
          Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)) (Icc (0 : ℝ) T) := by
  letI : IsProbabilityMeasure (reflectedLaw mu) :=
    reflectedLaw_isProbabilityMeasure mu
  letI : IsProbabilityMeasure
      (reflectedLaw
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) :=
    reflectedLaw_isProbabilityMeasure
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  let z : ℝ → ℂ := fun t =>
    prawitzPVIntegrand T
        (MeasureTheory.charFun (reflectedLaw mu)) (-x) t -
      prawitzPVIntegrand T
        (MeasureTheory.charFun
          (reflectedLaw
            NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)) (-x) t
  let P : ℝ → ℂ := fun t => (Complex.I / (Real.pi : ℝ)) * z t
  let G : ℝ → ℝ := fun t =>
    2 * prawitzFejerFrequencyWeight T t *
      Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)
  have hz : IntegrableOn z (Icc (0 : ℝ) T) := by
    simpa only [z] using integrableOn_prawitzPVIntegrand_charFun_sub
      (reflectedLaw mu)
      (reflectedLaw NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
      (integrable_abs_reflectedLaw mu hmu1)
      (integrable_abs_reflectedLaw
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
        integrable_abs_standardNormalLaw) hT (-x)
  have hP : IntegrableOn P (Icc (0 : ℝ) T) := by
    simpa only [P] using hz.const_mul (Complex.I / (Real.pi : ℝ))
  have hG : IntegrableOn G (Icc (0 : ℝ) T) := by
    apply Continuous.integrableOn_Icc
    dsimp only [G]
    unfold prawitzFejerFrequencyWeight
    fun_prop
  apply (hP.re.add hG).congr
  filter_upwards with t
  simp only [Pi.add_apply]
  change Complex.re (P t) + G t = _
  dsimp only [P, z, G, prawitzZeroPhaseDifference]
  rw [prawitzPVIntegrand_charFun_sub_eq_phase_mul_zero]
  rw [Complex.mul_re, Complex.div_ofReal_re,
    Complex.div_ofReal_im, Complex.mul_re, Complex.mul_im]
  simp only [Complex.I_re, Complex.I_im, zero_div, one_div,
    zero_mul, Complex.exp_ofReal_mul_I_re,
    Complex.exp_ofReal_mul_I_im, Real.cos_neg, Real.sin_neg]
  rw [show t * -x = -(t * x) by ring, Real.cos_neg, Real.sin_neg]
  field_simp [Real.pi_ne_zero]
  ring

/-- Adding the forward and reflected reverse phase-preserving remainders for a
normalized iid sum cancels the real filter coordinate exactly. -/
theorem prawitzPhasePreservingRemainders_normalizedCenteredIidSum_add_eq_integral
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) {T : ℝ} (hT : 0 < T) (x : ℝ) :
    let law : Measure ℝ :=
      NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
          X hX N).aemeasurable
    prawitzPhasePreservingRemainder law T x +
        reversePrawitzPhasePreservingRemainder law T x =
      ∫ t in Icc (0 : ℝ) T,
        let u : ℝ := t / Real.sqrt (N + 1 : ℝ)
        let phi : ℂ := MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            (X 0) (hX 0).aemeasurable : Measure ℝ) u
        let a : ℝ := 1 - u ^ 2 / 2
        let r : ℂ := phi - (a : ℂ)
        let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
        let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
        (-2 * (scaledPrawitzSmoothingFilter T t).im *
              (Real.sin (t * x) * (r.re * s.im + r.im * s.re) +
                Real.cos (t * x) *
                  (r.re * s.re - r.im * s.im + c)) / t) /
            Real.pi +
          4 * prawitzFejerFrequencyWeight T t *
            Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  dsimp only
  let Y : Omega → ℝ :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
  have hY : MemLp Y 2 mu :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp X hX N
  let law : Measure ℝ :=
    NumStability.HDP.Scalar.LimitTheorems.probabilityLaw Y hY.aemeasurable
  letI : IsProbabilityMeasure law := inferInstance
  have hLaw1 : Integrable (fun y : ℝ => |y|) law := by
    change Integrable (fun y : ℝ => |y|) (Measure.map Y mu)
    rw [integrable_map_measure (by fun_prop) hY.aemeasurable]
    simpa only [Function.comp_apply, Real.norm_eq_abs] using
      (hY.integrable (by norm_num)).norm
  rw [prawitzPhasePreservingRemainder_eq_integral_phaseCoordinates
      law hLaw1 hT x,
    reversePrawitzPhasePreservingRemainder_eq_integral_phaseCoordinates
      law hLaw1 hT x]
  rw [← integral_add
    (integrableOn_prawitzPhaseCoordinateIntegrand law hLaw1 hT x)
    (integrableOn_reversePrawitzPhaseCoordinateIntegrand law hLaw1 hT x)]
  apply integral_congr_ae
  filter_upwards with t
  rw [prawitzZeroPhaseDifference_normalizedCenteredIidSum_re_eq_taylorCoordinates
      X hX hIndep hIdent N T t,
    prawitzZeroPhaseDifference_normalizedCenteredIidSum_im_eq_taylorCoordinates
      X hX hIndep hIdent N T t,
    prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_re_eq_taylorCoordinates
      X hX hIndep hIdent N T t,
    prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_im_eq_taylorCoordinates
      X hX hIndep hIdent N T t]
  let u : ℝ := t / Real.sqrt ((N : ℝ) + 1)
  let phi : ℂ := MeasureTheory.charFun
    (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
      (X 0) (hX 0).aemeasurable : Measure ℝ) u
  let a : ℝ := 1 - u ^ 2 / 2
  let r : ℂ := phi - (a : ℂ)
  let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
  let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
  let k : ℂ := scaledPrawitzSmoothingFilter T t
  let g : ℝ := 2 * prawitzFejerFrequencyWeight T t *
    Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)
  have hcancel := prawitzTaylorPhaseCoordinates_add k r s c t (t * x)
  dsimp only [u, phi, a, r, s, c, k, g] at hcancel ⊢
  linear_combination (1 / Real.pi) * hcancel

/-- Subtracting the reflected reverse phase-preserving remainder from the
forward remainder cancels the imaginary filter coordinate and the Gaussian
term exactly. -/
theorem prawitzPhasePreservingRemainders_normalizedCenteredIidSum_sub_eq_integral
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) {T : ℝ} (hT : 0 < T) (x : ℝ) :
    let law : Measure ℝ :=
      NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
          X hX N).aemeasurable
    prawitzPhasePreservingRemainder law T x -
        reversePrawitzPhasePreservingRemainder law T x =
      ∫ t in Icc (0 : ℝ) T,
        let u : ℝ := t / Real.sqrt (N + 1 : ℝ)
        let phi : ℂ := MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            (X 0) (hX 0).aemeasurable : Measure ℝ) u
        let a : ℝ := 1 - u ^ 2 / 2
        let r : ℂ := phi - (a : ℂ)
        let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
        let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
        (2 * (scaledPrawitzSmoothingFilter T t).re *
              (Real.sin (t * x) *
                  (r.re * s.re - r.im * s.im + c) -
                Real.cos (t * x) *
                  (r.re * s.im + r.im * s.re)) / t) /
            Real.pi := by
  dsimp only
  let Y : Omega → ℝ :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
  have hY : MemLp Y 2 mu :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp X hX N
  let law : Measure ℝ :=
    NumStability.HDP.Scalar.LimitTheorems.probabilityLaw Y hY.aemeasurable
  letI : IsProbabilityMeasure law := inferInstance
  have hLaw1 : Integrable (fun y : ℝ => |y|) law := by
    change Integrable (fun y : ℝ => |y|) (Measure.map Y mu)
    rw [integrable_map_measure (by fun_prop) hY.aemeasurable]
    simpa only [Function.comp_apply, Real.norm_eq_abs] using
      (hY.integrable (by norm_num)).norm
  rw [prawitzPhasePreservingRemainder_eq_integral_phaseCoordinates
      law hLaw1 hT x,
    reversePrawitzPhasePreservingRemainder_eq_integral_phaseCoordinates
      law hLaw1 hT x]
  rw [← integral_sub
    (integrableOn_prawitzPhaseCoordinateIntegrand law hLaw1 hT x)
    (integrableOn_reversePrawitzPhaseCoordinateIntegrand law hLaw1 hT x)]
  apply integral_congr_ae
  filter_upwards with t
  rw [prawitzZeroPhaseDifference_normalizedCenteredIidSum_re_eq_taylorCoordinates
      X hX hIndep hIdent N T t,
    prawitzZeroPhaseDifference_normalizedCenteredIidSum_im_eq_taylorCoordinates
      X hX hIndep hIdent N T t,
    prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_re_eq_taylorCoordinates
      X hX hIndep hIdent N T t,
    prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_im_eq_taylorCoordinates
      X hX hIndep hIdent N T t]
  let u : ℝ := t / Real.sqrt ((N : ℝ) + 1)
  let phi : ℂ := MeasureTheory.charFun
    (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
      (X 0) (hX 0).aemeasurable : Measure ℝ) u
  let a : ℝ := 1 - u ^ 2 / 2
  let r : ℂ := phi - (a : ℂ)
  let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
  let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
  let k : ℂ := scaledPrawitzSmoothingFilter T t
  let g : ℝ := 2 * prawitzFejerFrequencyWeight T t *
    Real.exp (-(t ^ 2) / 2) * Real.cos (x * t)
  have hcancel := prawitzTaylorPhaseCoordinates_sub k r s c t (t * x)
  dsimp only [u, phi, a, r, s, c, k, g] at hcancel ⊢
  linear_combination (1 / Real.pi) * hcancel

/-- Exact Taylor-coordinate expansion of the reflected reverse
phase-preserving Prawitz remainder for a normalized centered iid sum. -/
theorem reversePrawitzPhasePreservingRemainder_normalizedCenteredIidSum_eq_integral_taylorCoordinates
    {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega} [IsProbabilityMeasure mu]
    (X : ℕ → Omega → ℝ) (hX : ∀ i, MemLp (X i) 2 mu)
    (hIndep : ProbabilityTheory.iIndepFun X mu)
    (hIdent : ∀ i, ProbabilityTheory.IdentDistrib (X i) (X 0) mu mu)
    (N : ℕ) {T : ℝ} (hT : 0 < T) (x : ℝ) :
    let law : Measure ℝ :=
      NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N)
        (NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp
          X hX N).aemeasurable
    reversePrawitzPhasePreservingRemainder law T x =
      ∫ t in Icc (0 : ℝ) T,
        let u : ℝ := t / Real.sqrt (N + 1 : ℝ)
        let phi : ℂ := MeasureTheory.charFun
          (NumStability.HDP.Scalar.LimitTheorems.probabilityLaw
            (X 0) (hX 0).aemeasurable : Measure ℝ) u
        let a : ℝ := 1 - u ^ 2 / 2
        let r : ℂ := phi - (a : ℂ)
        let s : ℂ := complexPowerRealBaselineGeomSum phi a (N + 1)
        let c : ℝ := a ^ (N + 1) - Real.exp (-(t ^ 2) / 2)
        (-Real.sin (t * x) *
              (((scaledPrawitzSmoothingFilter T t).re *
                    (r.re * s.re - r.im * s.im + c) +
                  (scaledPrawitzSmoothingFilter T t).im *
                    (r.re * s.im + r.im * s.re)) / t) -
            Real.cos (t * x) *
              ((-(scaledPrawitzSmoothingFilter T t).re *
                    (r.re * s.im + r.im * s.re) +
                  (scaledPrawitzSmoothingFilter T t).im *
                    (r.re * s.re - r.im * s.im + c)) / t)) /
            Real.pi +
          2 * prawitzFejerFrequencyWeight T t *
            Real.exp (-(t ^ 2) / 2) * Real.cos (x * t) := by
  dsimp only
  let Y : Omega → ℝ :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum X N
  have hY : MemLp Y 2 mu :=
    NumStability.HDP.Scalar.LimitTheorems.normalizedCenteredIidSum_memLp X hX N
  let law : Measure ℝ :=
    NumStability.HDP.Scalar.LimitTheorems.probabilityLaw Y hY.aemeasurable
  letI : IsProbabilityMeasure law := inferInstance
  have hLaw1 : Integrable (fun y : ℝ => |y|) law := by
    change Integrable (fun y : ℝ => |y|) (Measure.map Y mu)
    rw [integrable_map_measure (by fun_prop) hY.aemeasurable]
    simpa only [Function.comp_apply, Real.norm_eq_abs] using
      (hY.integrable (by norm_num)).norm
  rw [reversePrawitzPhasePreservingRemainder_eq_integral_phaseCoordinates
    law hLaw1 hT x]
  apply integral_congr_ae
  filter_upwards with t
  rw [prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_re_eq_taylorCoordinates
      X hX hIndep hIdent N T t,
    prawitzZeroPhaseDifference_reflected_normalizedCenteredIidSum_im_eq_taylorCoordinates
      X hX hIndep hIdent N T t]

/-- The reflected reverse phase-preserving remainder is continuous in the
spatial parameter. -/
theorem continuous_reversePrawitzPhasePreservingRemainder
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    (hmu1 : Integrable (fun y : ℝ => |y|) mu)
    {T : ℝ} (hT : 0 < T) :
    Continuous (reversePrawitzPhasePreservingRemainder mu T) := by
  letI : IsProbabilityMeasure (reflectedLaw mu) :=
    reflectedLaw_isProbabilityMeasure mu
  letI : IsProbabilityMeasure
      (reflectedLaw
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw) :=
    reflectedLaw_isProbabilityMeasure
      NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
  have hphase :=
    (continuous_setIntegral_prawitzPVIntegrand_charFun_sub
      (reflectedLaw mu)
      (reflectedLaw NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw)
      (integrable_abs_reflectedLaw mu hmu1)
      (integrable_abs_reflectedLaw
        NumStability.HDP.Scalar.LimitTheorems.standardNormalLaw
        integrable_abs_standardNormalLaw) hT).comp continuous_neg
  unfold reversePrawitzPhasePreservingRemainder
  exact (Complex.continuous_re.comp
    (continuous_const.mul hphase)).add
      (continuous_prawitzGaussianCosineRemainder T)

