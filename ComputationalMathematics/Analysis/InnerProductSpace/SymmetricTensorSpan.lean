import Mathlib.LinearAlgebra.PiTensorProduct.Basis
import Mathlib.Data.Complex.Basic
import Mathlib.Data.Fin.Tuple.Sort
import Mathlib.Analysis.SpecialFunctions.Sqrt

/-!
# The span of normalized symmetric tensors

The normalized symmetric tensor product is the actual unsigned sum of
permuted pure tensors with coefficient `1 / sqrt(card ι !)`, packaged as a
multilinear map. Its span is generated by sorted tuples of vectors from any
given basis. This is an algebraic spanning statement: no norm, inner product,
orthonormality, finite-dimensionality, new carrier or dimension formula is
assumed or constructed.
-/

set_option autoImplicit false

noncomputable section

open scoped BigOperators

namespace PiTensorProduct

/-- The normalized unsigned symmetric tensor product as a multilinear map
into the actual tensor quotient. -/
noncomputable def normalizedSymmetricTensor (ι H : Type*) [Fintype ι] [DecidableEq ι]
    [AddCommGroup H] [Module ℂ H] :
    MultilinearMap ℂ (fun _ : ι => H) (PiTensorProduct ℂ (fun _ : ι => H)) :=
  (((Real.sqrt (Nat.factorial (Fintype.card ι) : ℝ))⁻¹ : ℝ) : ℂ) •
    ∑ σ : Equiv.Perm ι, (tprod ℂ).domDomCongr σ

/-- The multilinear map is exactly the inverse-square-root-factorial unsigned
permutation sum; no additional scaling or quotient is hidden. -/
@[simp] theorem normalizedSymmetricTensor_apply
    {ι H : Type*} [Fintype ι] [DecidableEq ι] [AddCommGroup H] [Module ℂ H]
    (x : ι → H) :
    normalizedSymmetricTensor ι H x =
      (((Real.sqrt (Nat.factorial (Fintype.card ι) : ℝ))⁻¹ : ℝ) : ℂ) •
        ∑ σ : Equiv.Perm ι, tprod ℂ (fun i => x (σ i)) := by
  simp [normalizedSymmetricTensor, MultilinearMap.sum_apply,
    MultilinearMap.domDomCongr_apply]

/-- Permuting the input family does not change the actual normalized unsigned
symmetric tensor. -/
theorem normalizedSymmetricTensor_comp_perm
    {ι H : Type*} [Fintype ι] [DecidableEq ι] [AddCommGroup H] [Module ℂ H]
    (x : ι → H) (σ : Equiv.Perm ι) :
    normalizedSymmetricTensor ι H (x ∘ σ) = normalizedSymmetricTensor ι H x := by
  rw [normalizedSymmetricTensor_apply, normalizedSymmetricTensor_apply]
  congr 1
  exact (Group.mulLeft_bijective σ).sum_comp
    (fun τ : Equiv.Perm ι => tprod ℂ (fun i => x (τ i)))

private theorem span_normalizedSymmetricTensor_eq_span_basis
    {k : ℕ} {α H : Type*} [AddCommGroup H] [Module ℂ H]
    (b : Module.Basis α ℂ H) :
    Submodule.span ℂ (Set.range (normalizedSymmetricTensor (Fin k) H)) =
      Submodule.span ℂ (Set.range (fun f : Fin k → α =>
        normalizedSymmetricTensor (Fin k) H (fun i => b (f i)))) := by
  classical
  let F := PiTensorProduct.lift (normalizedSymmetricTensor (Fin k) H)
  let B := Basis.piTensorProduct (fun _ : Fin k => b)
  have hAll : Submodule.span ℂ (Set.range (normalizedSymmetricTensor (Fin k) H)) =
      LinearMap.range F := by
    calc
      _ = Submodule.span ℂ (Set.range (F ∘ (tprod ℂ))) := by
        congr 1
        congr 1
        funext x
        exact (PiTensorProduct.lift.tprod x).symm
      _ = (Submodule.span ℂ (Set.range (tprod ℂ))).map F := by
        rw [Submodule.map_span, ← Set.range_comp]
      _ = (⊤ : Submodule ℂ (PiTensorProduct ℂ (fun _ : Fin k => H))).map F := by
        rw [PiTensorProduct.span_tprod_eq_top]
      _ = LinearMap.range F := Submodule.map_top F
  have hBasis : LinearMap.range F =
      Submodule.span ℂ (Set.range (fun f : Fin k → α =>
        normalizedSymmetricTensor (Fin k) H (fun i => b (f i)))) := by
    rw [← B.constr_self ℂ F, B.constr_range]
    congr 1
    congr 1
    funext f
    simp [B, F, Basis.piTensorProduct_apply]
  exact hAll.trans hBasis

/-- The span of symmetric products of all input tuples is exactly the span
of the symmetric products of nondecreasing tuples from any given basis. The
basis index may be infinite; the tensor degree is finite. -/
theorem span_normalizedSymmetricTensor_eq_span_monotone_basis
    {k : ℕ} {α H : Type*} [LinearOrder α] [AddCommGroup H] [Module ℂ H]
    (b : Module.Basis α ℂ H) :
    Submodule.span ℂ (Set.range (normalizedSymmetricTensor (Fin k) H)) =
      Submodule.span ℂ (Set.range (fun f : {f : Fin k → α // Monotone f} =>
        normalizedSymmetricTensor (Fin k) H (fun i => b (f.1 i)))) := by
  classical
  rw [span_normalizedSymmetricTensor_eq_span_basis b]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨f, rfl⟩
    apply Submodule.subset_span
    refine ⟨⟨f ∘ Tuple.sort f, Tuple.monotone_sort f⟩, ?_⟩
    exact normalizedSymmetricTensor_comp_perm (fun i => b (f i)) (Tuple.sort f)
  · apply Submodule.span_mono
    rintro _ ⟨f, rfl⟩
    exact ⟨f.1, rfl⟩

end PiTensorProduct
