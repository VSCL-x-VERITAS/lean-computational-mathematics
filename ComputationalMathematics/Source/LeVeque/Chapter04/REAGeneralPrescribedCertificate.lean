SPDX-License-Identifier: MIT

General prescribed-certificate REA types and mathematical propositions.
An IVP-relative template supplies no physical authenticity for arbitrary data.
-/
import ComputationalMathematics.Source.LeVeque.Chapter04.REAPrescribedCertificate
import ComputationalMathematics.Source.LeVeque.Chapter04.REAUniformReconstruction

/-!
# LeVeque Chapter 4: prescribed REA certificates

These types and propositions describe reconstruction, evolution and averaging relative to a specified problem and a certificate fixed in advance.
-/

namespace NumStability.REA

open MeasureTheory

/-- A finite-dimensional real state with coordinates indexed by `Fin m`. -/
abbrev State (m : ℕ) := Fin m → ℝ
/-- A spatial profile with finite-dimensional real states. -/
abbrev Profile (m : ℕ) := ℝ → State m
/-- A real space-time field with finite-dimensional real states. -/
abbrev Field (m : ℕ) := ℝ → ℝ → State m

/-- Only actual forward steps are method inputs. A policy is fixed before R/V. -/
structure Input (m : ℕ) where
  /-- The physical grid used for this evolution step. -/
  grid : OneDimensionalFiniteVolumeGrid
  /-- The reconstructed initial profile for this step. -/
  initial : Profile m
  /-- The positive duration of this evolution step. -/
  step : ℝ
  step_pos : 0 < step

/-- A genuine normed quotient of a specified class of actual measured fields.
The map is linear and onto; its kernel is exactly actual ae-zero, not arbitrary
endpoint validity. Nonzero measure and a nonempty domain exclude empty tests.
Its formula and the actual measure remain part of the descriptor's mathematics. -/
structure MeasuredFieldGeometry (α : Type) [MeasurableSpace α] (d : ℕ) (E : Type)
    [NormedAddCommGroup E] [NormedSpace ℝ E] where
  /-- The subset on which the error or residual is measured. -/
  domain : Set α
  domain_nonempty : domain.Nonempty
  /-- The nonzero measure on the prescribed measurement domain. -/
  measure : Measure domain
  measure_ne_zero : measure ≠ 0
  /-- The admissible measurement functions before passage to the normed value space. -/
  raw : Submodule ℝ (domain → State d)
  /-- The linear realization of admissible measurement functions in the normed space. -/
  toValue : raw →ₗ[ℝ] E
  onto : Function.Surjective toValue
  kernel_ae_zero : ∀ e : raw,
    toValue e = 0 ↔ ∀ᵐ x ∂measure, (e : domain → State d) x = 0

/-- Literal measured field membership and actual quotient norm bound. -/
def MeasuredBound {α : Type} [MeasurableSpace α] {d : ℕ} {E : Type}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (G : MeasuredFieldGeometry α d E) (f : α → State d) (budget : ℝ) : Prop :=
  0 ≤ budget ∧ ∃ e : G.raw,
    (∀ x : G.domain, (e : G.domain → State d) x = f x) ∧ ‖G.toValue e‖ ≤ budget

/-- Domain, measure, raw error class, genuine error norm and budget are selected
from inputs by this already fixed policy; there is no endpoint argument. -/
structure ReferencePolicy (m : ℕ) (E : Input m → Type)
    [∀ i, NormedAddCommGroup (E i)] [∀ i, NormedSpace ℝ (E i)] where
  /-- The prescribed geometry used to measure the endpoint error. -/
  geometry : ∀ i : Input m, MeasuredFieldGeometry ℝ m (E i)
  /-- The permitted reference-error norm for each step input. -/
  budget : Input m → ℝ

/-- Agreement with a supplied exact solution up to the prescribed measured error. -/
def ReferenceCertificate {m : ℕ} (problem : Leveque04ForwardIVP m)
    {E : Input m → Type} [∀ i, NormedAddCommGroup (E i)]
    [∀ i, NormedSpace ℝ (E i)] (P : ReferencePolicy m E)
    (i : Input m) (endpoint : Profile m) : Prop :=
  ∃ reference : Field m,
    problem i.initial i.step reference ∧
    MeasuredBound (P.geometry i)
      (fun x => endpoint x - reference x i.step) (P.budget i)

/-- A mathematical presentation of ONE fixed relation on an applicable path
class. This does not label arbitrary supplied data an actual physical PDE.
Physical instances must expose the actual defect expression and relation body.
No exact reference exists by virtue of these fields. -/
structure ResidualPresentation {m : ℕ} (problem : Leveque04ForwardIVP m) where
  /-- The number of real components of the residual. -/
  components : ℕ
  components_pos : 0 < components
  /-- The admissible evolution paths for each step input. -/
  Path : Input m → Type
  /-- The domain indexing equation residuals for each step input. -/
  Index : Input m → Type
  /-- The measurable structure on the residual-index domain. -/
  indexMeasurableSpace : ∀ i, MeasurableSpace (Index i)
  /-- The space-time field represented by an admissible path. -/
  field : ∀ i : Input m, Path i → Field m
  same_initial : ∀ (i : Input m) (w : Path i) (x : ℝ),
    field i w x 0 = i.initial x
  /-- The equation residual generated by an admissible path. -/
  defect : ∀ i : Input m, Path i → Index i → State components
  field_determines_defect : ∀ (i : Input m) (w v : Path i),
    (∀ x, ∀ t ∈ Set.Icc 0 i.step, field i w x t = field i v x t) →
      defect i w = defect i v
  same_equation_on_carrier : ∀ (i : Input m) (w : Path i),
    problem i.initial i.step (field i w) ↔ ∀ ξ, defect i w ξ = 0

/-- An open family of actual residual norms/tests, fixed before execution.
Each test measures the literal defect via a genuine normed quotient.
J is nonempty, so an empty conjunction cannot certify an endpoint. -/
structure ResidualPolicy {m : ℕ} {problem : Leveque04ForwardIVP m}
    (P : ResidualPresentation problem) (J : Input m → Type)
    (E : (i : Input m) → J i → Type)
    [∀ i j, NormedAddCommGroup (E i j)] [∀ i j, NormedSpace ℝ (E i j)] where
  tests_nonempty : ∀ i, Nonempty (J i)
  /-- The prescribed measured realization of the residual for each input and test. -/
  geometry : ∀ (i : Input m) (j : J i),
    letI : MeasurableSpace (P.Index i) := P.indexMeasurableSpace i
    MeasuredFieldGeometry (P.Index i) P.components (E i j)
  /-- The permitted residual norm for each input and test. -/
  budget : ∀ i : Input m, J i → ℝ

/-- The equation-specific residual certificate for a compatible evolution path. -/
def ResidualCertificate {m : ℕ} {problem : Leveque04ForwardIVP m}
    (P : ResidualPresentation problem) {J : Input m → Type}
    {E : (i : Input m) → J i → Type}
    [∀ i j, NormedAddCommGroup (E i j)] [∀ i j, NormedSpace ℝ (E i j)]
    (M : ResidualPolicy P J E) (i : Input m) (endpoint : Profile m) : Prop :=
  letI : MeasurableSpace (P.Index i) := P.indexMeasurableSpace i
  ∃ w : P.Path i,
    (∀ x, P.field i w x i.step = endpoint x) ∧
    ∀ j : J i, MeasuredBound (M.geometry i j) (P.defect i w) (M.budget i j)

/-- Two user-prescribed semantic categories, not a catalogue of two concrete
whole-line/scalar tests. All spaces, norms, domains and presentations vary. -/
inductive Criterion {m : ℕ} (problem : Leveque04ForwardIVP m) : Type 1 where
  | reference {E : Input m → Type}
      [∀ i, NormedAddCommGroup (E i)] [∀ i, NormedSpace ℝ (E i)]
      (policy : ReferencePolicy m E) : Criterion problem
  | residual (presentation : ResidualPresentation problem)
      {J : Input m → Type} {E : (i : Input m) → J i → Type}
      [∀ i j, NormedAddCommGroup (E i j)] [∀ i j, NormedSpace ℝ (E i j)]
      (policy : ResidualPolicy presentation J E) : Criterion problem

/-- The reference-error or residual certificate required by the selected criterion. -/
def Certificate {m : ℕ} {problem : Leveque04ForwardIVP m}
    (criterion : Criterion problem) (i : Input m) (endpoint : Profile m) : Prop :=
  match criterion with
  | @Criterion.reference _ _ E group space policy =>
      @ReferenceCertificate m problem E group space policy i endpoint
  | @Criterion.residual _ _ presentation J E group space policy =>
      @ResidualCertificate m problem presentation J E group space policy i endpoint

/-- An approximate evolution procedure with a criterion fixed before execution. -/
structure Procedure {m : ℕ} (problem : Leveque04ForwardIVP m) where
  /-- The reference-error or residual criterion prescribed for this procedure. -/
  criterion : Criterion problem
  /-- The evolution algorithm on admissible step inputs, allowing execution failure. -/
  execute : Input m → Option (Profile m)

/-- Exact evolution or successful approximate execution with its prescribed certificate. -/
def Endpoint {m : ℕ} (problem : Leveque04ForwardIVP m)
    (method : Option (Procedure problem)) (i : Input m) (endpoint : Profile m) : Prop :=
  (∃ evolved : Field m,
    problem i.initial i.step evolved ∧ ∀ x, endpoint x = evolved x i.step) ∨
  (∃ procedure : Procedure problem,
    method = some procedure ∧ procedure.execute i = some endpoint ∧
      Certificate procedure.criterion i endpoint)

/-- Reconstruct, perform exact or certified approximate evolution, then average. -/
def Stage {m : ℕ} (problem : Leveque04ForwardIVP m)
    (method : Option (Procedure problem)) (grid : OneDimensionalFiniteVolumeGrid)
    (old : ℤ → State m) (step : ℝ) (next : ℤ → State m) : Prop :=
  0 < m ∧ ∃ hstep : 0 < step,
    Leveque04REAGridCoversLine grid ∧
    ∃ reconstructed endpoint : Profile m,
      Leveque04REAReconstruction grid old reconstructed ∧
      (∀ j, IntervalIntegrable endpoint volume (grid.cellLeft j) (grid.cellRight j)) ∧
      Endpoint problem method ⟨grid, reconstructed, step, hstep⟩ endpoint ∧
      ∀ j, next j = oneDimensionalCellAverage endpoint (grid.cellLeft j) (grid.cellRight j)

/-- The generic conditional recipe as an explicit mathematical proposition. -/
def GenericRecipeTarget : Prop :=
  ∀ (m : ℕ) (problem : Leveque04ForwardIVP m)
    (method : Option (Procedure problem)) (grid : OneDimensionalFiniteVolumeGrid)
    (old : ℤ → State m) (step : ℝ) (next : ℤ → State m),
    Stage problem method grid old step next ↔
      0 < m ∧ ∃ hstep : 0 < step,
        Leveque04REAGridCoversLine grid ∧
        ∃ reconstructed endpoint : Profile m,
          ((∀ j component, ∃ polynomial : Polynomial ℝ,
            ∀ x ∈ Set.Ioo (grid.cellLeft j) (grid.cellRight j),
              reconstructed x component = polynomial.eval x) ∧
            (∀ j, IntervalIntegrable reconstructed volume
              (grid.cellLeft j) (grid.cellRight j)) ∧
            ∀ j, oneDimensionalCellAverage reconstructed
              (grid.cellLeft j) (grid.cellRight j) = old j) ∧
          (∀ j, IntervalIntegrable endpoint volume
            (grid.cellLeft j) (grid.cellRight j)) ∧
          ((∃ evolved : Field m, problem reconstructed step evolved ∧
            ∀ x, endpoint x = evolved x step) ∨
            ∃ procedure : Procedure problem,
              method = some procedure ∧
              procedure.execute ⟨grid, reconstructed, step, hstep⟩ = some endpoint ∧
              Certificate procedure.criterion ⟨grid, reconstructed, step, hstep⟩ endpoint) ∧
          ∀ j, next j = oneDimensionalCellAverage endpoint
            (grid.cellLeft j) (grid.cellRight j)

/-- Nonempty positive space/time rectangles in the actual forward strip. -/
structure ForwardRectangle (step : ℝ) where
  /-- The left spatial endpoint of the test rectangle. -/
  left : ℝ
  /-- The right spatial endpoint of the test rectangle. -/
  right : ℝ
  /-- The initial time of the test rectangle. -/
  start : ℝ
  /-- The final time of the test rectangle. -/
  stop : ℝ
  space_pos : left < right
  start_nonneg : 0 ≤ start
  time_pos : start < stop
  stop_le : stop ≤ step

/-- Exactly the integrability and initial data used by the actual rectangle law.
No additional regularity or exact-solution premise is imposed. -/
structure ConservativePath {m : ℕ} (flux : State m → State m) (i : Input m) where
  /-- The space-time field supplied by this conservative path. -/
  field : Field m
  initial : ∀ x, field x 0 = i.initial x
  spatial_integrable : ∀ t ∈ Set.Icc 0 i.step, ∀ a b : ℝ,
    IntervalIntegrable (fun x => field x t) volume a b
  flux_integrable : ∀ x : ℝ,
    IntervalIntegrable (fun t => flux (field x t)) volume 0 i.step

/-- SAME physical flux, with the actual oriented spatial and time integrals. -/
noncomputable def RectangleDefect {m : ℕ}
    (flux : State m → State m) (field : Field m) {step : ℝ}
    (r : ForwardRectangle step) : State m :=
  (∫ x in r.left..r.right, field x r.stop) -
    (∫ x in r.left..r.right, field x r.start) -
      ∫ t in r.start..r.stop, flux (field r.left t) - flux (field r.right t)

/-- Its body is the existing actual forward rectangle conservation predicate. -/
def ConservativeIVP {m : ℕ} (flux : State m → State m) : Leveque04ForwardIVP m :=
  fun initial step field =>
    (∀ x, field x 0 = initial x) ∧
      ∀ left right : ℝ,
        LocalConservationLaw.RectangleReferenceOn field flux left right step

/-- Genuine small bridge obligation: positive rectangles versus the existing
all-oriented/subrectangle quantifiers, with the SAME integrability carrier.
No C1/weak equivalence is asserted or needed here. -/
def PositiveRectangleCompatibility {m : ℕ} (flux : State m → State m) : Prop :=
  ∀ (i : Input m) (w : ConservativePath flux i),
    ConservativeIVP flux i.initial i.step w.field ↔
      ∀ r : ForwardRectangle i.step, RectangleDefect flux w.field r = 0

/-- Actual weak conservative residual certificate. The envelope is prescribed
before execution and is not a criterion chosen from the resulting endpoint. -/
def RectangleCertificate {m : ℕ} (flux : State m → State m)
    (envelope : Input m → ℝ → ℝ) (i : Input m) (endpoint : Profile m) : Prop :=
  IntervalIntegrable (envelope i) volume 0 i.step ∧
    (∀ t ∈ Set.Icc 0 i.step, 0 ≤ envelope i t) ∧
    ∃ w : ConservativePath flux i,
      (∀ x, w.field x i.step = endpoint x) ∧
      ∀ r : ForwardRectangle i.step,
        ‖RectangleDefect flux w.field r‖ ≤
          (r.right - r.left) * ∫ t in r.start..r.stop, envelope i t

/-- Norm-measurement embedding must be provided as actual mathematics; it is not
an opaque Valid predicate and is not asserted proved by this draft. -/
def RectangleCriterionRepresented {m : ℕ} (flux : State m → State m)
    (envelope : Input m → ℝ → ℝ) : Prop :=
  ∃ criterion : Criterion (ConservativeIVP flux),
    ∀ (i : Input m) (endpoint : Profile m),
      Certificate criterion i endpoint ↔ RectangleCertificate flux envelope i endpoint

/-- The actual same-speed Taylor partial procedure, with a criterion already
chosen before it executes. Its formula is not an arbitrary solver callback. -/
noncomputable def ScalarTaylorProcedure (speed : ℝ)
    (criterion : Criterion (ConservativeIVP (fun state : State 1 => speed • state))) :
    Procedure (ConservativeIVP (fun state : State 1 => speed • state)) where
  criterion := criterion
  execute := fun i => some (fun x component => i.initial x component -
    speed * i.step * deriv (fun y => i.initial y component) x)

/-- The actual weak residual content of the nonexact quadratic example, retaining
all old actual data/means and the same positive step and grid scope. -/
def QuadraticWeakRectangleTarget : Prop :=
  ∀ speed curvature linear constant : ℝ,
    ∀ (grid : OneDimensionalFiniteVolumeGrid) (step : ℝ) (hstep : 0 < step),
    let initial := leveque04_quadraticREAReconstruction curvature linear constant
    let endpoint := leveque04_quadraticREAEndpoint speed curvature linear constant step
    let input : Input 1 := ⟨grid, initial, step, hstep⟩
    let envelope : Input 1 → ℝ → ℝ :=
      fun _ t => AdvectionTaylor.residualBudget speed curvature t
    RectangleCertificate (fun state : State 1 => speed • state) envelope input endpoint

/-- Its criterion is fixed once for a and curvature BEFORE the remaining inputs,
then used by the literal Taylor execution and actual physical REA averages. -/
def QuadraticGeneralStageTarget : Prop :=
  ∀ speed curvature : ℝ,
    ∃ criterion : Criterion (ConservativeIVP (fun state : State 1 => speed • state)),
      (∀ (i : Input 1) (endpoint : Profile 1),
        Certificate criterion i endpoint ↔
          RectangleCertificate (fun state : State 1 => speed • state)
            (fun _ t => AdvectionTaylor.residualBudget speed curvature t) i endpoint) ∧
      ∀ (linear constant origin width : ℝ) (hwidth : 0 < width)
        (step : ℝ), 0 < step →
        let grid := leveque04_uniformGrid origin width hwidth
        let old := leveque04_quadraticREAOldMeans curvature linear constant grid
        let next := leveque04_quadraticREANextMeans speed curvature linear constant step grid
        Stage (ConservativeIVP (fun state : State 1 => speed • state))
          (some (ScalarTaylorProcedure speed criterion)) grid old step next

/-- Exact identification obligations, not a new definition of an unrelated PDE. -/
def ActualEquationIdentificationTarget : Prop :=
  (∀ (m : ℕ) (A : Matrix (Fin m) (Fin m) ℝ),
    ConservativeIVP A.mulVec = leveque04_linearREAForwardIVP A) ∧
  (∀ speed : ℝ,
    ConservativeIVP (fun state : State 1 => speed • state) =
      leveque04_scalarAdvectionForwardIVP speed)


/-- Actual all-dimensional exact matrix stage in the GENERAL recipe. -/
def GeneralExactMatrixTarget : Prop :=
  ∀ (m : ℕ), 0 < m →
    ∀ (coefficient : Matrix (Fin m) (Fin m) ℝ),
    IsRealHyperbolicMatrix coefficient →
    ∀ (basis : Module.Basis (Fin m) ℝ (Fin m → ℝ)) (speeds : Fin m → ℝ),
    (∀ k, coefficient.mulVec (basis k) = speeds k • basis k) →
    ∀ (old : ℤ → Fin m → ℝ) (origin width : ℝ) (hwidth : 0 < width)
      (step : ℝ), 0 < step →
    let grid := leveque04_uniformGrid origin width hwidth
    let reconstructed := leveque04_uniformReconstruction origin width old
    let evolved := linearCharacteristicEvolution basis speeds reconstructed
    let endpoint := fun x => evolved x step
    let next := fun j =>
      oneDimensionalCellAverage endpoint (grid.cellLeft j) (grid.cellRight j)
    Leveque04REAGridCoversLine grid ∧
      Leveque04REAReconstruction grid old reconstructed ∧
      leveque04_linearREAForwardIVP coefficient reconstructed step evolved ∧
      Stage (leveque04_linearREAForwardIVP coefficient) none grid old step next

/-- Explicit same-speed rectangle defect of the ACTUAL quadratic Taylor path.
This is derived mathematical support, not a printed universal formula. -/
def QuadraticRectangleFormulaTarget : Prop :=
  ∀ (speed curvature linear constant step : ℝ) (r : ForwardRectangle step),
    RectangleDefect (fun state : State 1 => speed • state)
      (fun x t _ => AdvectionTaylor.quadraticTaylorPath speed curvature linear constant x t) r =
      fun _ => -curvature * speed ^ 2 * (r.right - r.left) *
        (r.stop ^ 2 - r.start ^ 2)

end NumStability.REA
